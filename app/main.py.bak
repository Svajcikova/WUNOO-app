    return {'valid':a['valid'] and f['valid'],'checkpoints':a['entries'],'finalities':f['entries'],'checkpoint_verification':a['verification'],'finality_verification':f['verification']}
def _v104_verify_all(c):
    a=_v108_verify_table(c,'production_global_recovery_finality_chain_checkpoints',_v104_verify_checkpoint)
    f=_v108_verify_table(c,'production_global_recovery_finality_checkpoint_finality',_v104_verify_finality)
    return {'valid':a['valid'] and f['valid'],'checkpoints':a['entries'],'finalities':f['entries'],'checkpoint_verification':a['verification'],'finality_verification':f['verification']}
def _v106_verify_all(c):
    a=_v108_verify_table(c,'production_recovery_finality_chain_checkpoints_v106',_v106_verify_checkpoint)
    f=_v108_verify_table(c,'production_recovery_finality_checkpoint_finality_v106',_v106_verify_finality)
    return {'valid':a['valid'] and f['valid'],'checkpoints':a['entries'],'finalities':f['entries'],'checkpoint_verification':a['verification'],'finality_verification':f['verification']}
def _v108_check(c,name,fn):
    try:
        r=fn(c); return {'check':name,'valid':bool(r.get('valid')),'reason':r.get('reason'),'details':r}
    except Exception as e:return {'check':name,'valid':False,'reason':'V108_CHECK_EXCEPTION','details':str(e)}
def _v108_run(c):
    checks=[
        _v108_check(c,'V101_CHAIN',_v101_verify_chain),
        _v108_check(c,'V102_CHECKPOINTS',lambda x:_v102_verify_all(x)),
