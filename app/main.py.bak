def audit_security_http_event(request, user, event_type, outcome, http_status, resource=None, action=None, metadata=None):
    rid=security_request_id(request)
    with closing(conn()) as c:
        eid,h=append_security_audit(c,event_type=event_type,request_id=rid,outcome=outcome,
            http_status=http_status,actor_id=str(user.get("id")) if user else None,
            actor_role=user.get("role") if user else None,
            tenant_id=str((user or {}).get("tenant_id") or (user or {}).get("merchant_id") or "unknown"),
            resource=resource,action=action,metadata=metadata or {})
        delivery_key=f"{eid}:append_only"
        c.execute("""INSERT OR IGNORE INTO security_event_delivery
            (id,event_id,sink,delivery_key,status,attempts,created_at)
            VALUES (?,?,?,?,?,?,?)""",
            ("sed_"+uuid.uuid4().hex[:12],eid,"append_only",delivery_key,"queued",0,now()))
        c.commit()
    return rid,eid


class SecurityAuditHTTPMiddleware(BaseHTTPMiddleware):
    """Automatically audits security-relevant HTTP outcomes."""
    async def dispatch(self, request: Request, call_next):
        request.state._wunoo_started=time.perf_counter()
        rid=security_request_id(request)
        token=V099_REQUEST_CONTEXT.set(v099_context(
            request_id=rid, method=request.method, path=request.url.path))
        try:
            response=await call_next(request)
        except Exception as exc:
            # Do not leak exception details; audit the server-side failure.
            with closing(conn()) as c:
                migrate_v091(c)
                migrate_v092(c)
                append_security_audit(c,event_type="http.5xx",request_id=rid,
                    outcome="error",http_status=500,
                    metadata={"method":request.method,"path":request.url.path,"exception_type":type(exc).__name__})
                c.commit()
            raise
        if response.status_code in (401,403,429):
            with closing(conn()) as c:
                migrate_v091(c)
                migrate_v092(c)
                event_type={401:"http.401",403:"http.403",429:"http.429"}[response.status_code]
                append_security_audit(c,event_type=event_type,request_id=rid,
                    outcome="denied",http_status=response.status_code,
                    metadata={"method":request.method,"path":request.url.path,
                              "client":request.client.host if request.client else None})
                c.commit()
        response.headers["X-Request-ID"]=rid
        try:
            record_request_metric(request,response,(time.perf_counter()-request.state._wunoo_started)*1000)
        except Exception:
            pass
        try:
            V099_REQUEST_CONTEXT.reset(token)
        except Exception:
            pass
        return response


def migrate_v094(c):
    c.execute("""CREATE TABLE IF NOT EXISTS security_alerts(
        id TEXT PRIMARY KEY, alert_key TEXT NOT NULL UNIQUE, severity TEXT NOT NULL,
        alert_type TEXT NOT NULL, status TEXT NOT NULL, threshold_value REAL,
        observed_value REAL, window_seconds INTEGER NOT NULL, details_json TEXT,
        created_at TEXT NOT NULL, resolved_at TEXT)""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_security_alerts_status ON security_alerts(status,created_at)")
    c.commit()

def security_dashboard_snapshot(c, window_seconds=3600):
    cutoff=(datetime.datetime.now(datetime.timezone.utc)-datetime.timedelta(seconds=window_seconds)).isoformat()
    rows=c.execute("""SELECT event_type,COUNT(*) n FROM security_audit_events
                     WHERE created_at>=? GROUP BY event_type ORDER BY n DESC""",(cutoff,)).fetchall()
    top_paths=c.execute("""SELECT json_extract(metadata_json,'$.path') path,COUNT(*) n
                           FROM security_audit_events
                           WHERE created_at>=? AND path IS NOT NULL
                           GROUP BY path ORDER BY n DESC LIMIT 10""",(cutoff,)).fetchall()
    return {"window_seconds":window_seconds,"event_counts":[dict(x) for x in rows],
            "top_paths":[dict(x) for x in top_paths]}


def migrate_v095(c):
    c.execute("""CREATE TABLE IF NOT EXISTS security_incidents(
        id TEXT PRIMARY KEY, incident_key TEXT NOT NULL UNIQUE, title TEXT NOT NULL,
        severity TEXT NOT NULL, status TEXT NOT NULL, first_seen TEXT NOT NULL,
        last_seen TEXT NOT NULL, acknowledged_at TEXT, acknowledged_by TEXT,
        resolved_at TEXT, resolved_by TEXT, resolution_note TEXT, details_json TEXT)""")
    c.execute("""CREATE TABLE IF NOT EXISTS security_incident_timeline(
        id TEXT PRIMARY KEY, incident_id TEXT NOT NULL, event_type TEXT NOT NULL,
        actor_id TEXT, actor_role TEXT, from_status TEXT, to_status TEXT,
        note TEXT, created_at TEXT NOT NULL)""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_incident_status ON security_incidents(status,severity,last_seen)")
    c.commit()

def incident_transition(c, incident, to_status, actor):
    allowed={"open":{"acknowledged","resolved"},"acknowledged":{"resolved","open"},"resolved":{"open"}}
    current=incident["status"]
    if to_status not in allowed.get(current,set()):
        raise HTTPException(status_code=409,detail=f"Invalid incident transition {current}->{to_status}")
    ts=now(); aid=str(actor.get("id")); role=actor.get("role")
    c.execute("""INSERT INTO security_incident_timeline
        (id,incident_id,event_type,actor_id,actor_role,from_status,to_status,note,created_at)
        VALUES (?,?,?,?,?,?,?,?,?)""",
        ("sit_"+uuid.uuid4().hex[:12],incident["id"],"status_change",aid,role,current,to_status,None,ts))
    if to_status=="acknowledged":
        c.execute("UPDATE security_incidents SET status=?,acknowledged_at=?,acknowledged_by=? WHERE id=?",
                  (to_status,ts,aid,incident["id"]))
    elif to_status=="resolved":
        c.execute("UPDATE security_incidents SET status=?,resolved_at=?,resolved_by=? WHERE id=?",
                  (to_status,ts,aid,incident["id"]))
    else:
        c.execute("UPDATE security_incidents SET status=?,resolved_at=NULL,resolved_by=NULL WHERE id=?",
                  (to_status,incident["id"]))


