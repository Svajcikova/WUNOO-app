@app.post("/api/v065/notifications/preferences")
def v065_set_notification_preferences(body:dict[str,Any], authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization)
    channels=body.get("channels") or {}
    allowed={"in_app","push","email","sms"}
    with core_db_connect() as c:
        for ch,val in channels.items():
            if ch not in allowed: raise HTTPException(400,"Neplatný notification channel")
            c.execute("""INSERT INTO notification_preferences(id,user_id,channel,enabled)
                         VALUES (?,?,?,?)
                         ON CONFLICT(user_id,channel) DO UPDATE SET enabled=excluded.enabled""",
                      ("np_"+uuid.uuid4().hex[:12],u["id"],ch,1 if bool(val) else 0))
        c.commit()
        rows=c.execute("SELECT channel,enabled FROM notification_preferences WHERE user_id=?",(u["id"],)).fetchall()
        return {"preferences":{r["channel"]:bool(r["enabled"]) for r in rows}}

@app.get("/api/v065/notifications/preferences")
def v065_get_notification_preferences(authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization)
    with core_db_connect() as c:
        rows=c.execute("SELECT channel,enabled FROM notification_preferences WHERE user_id=?",(u["id"],)).fetchall()
        prefs={r["channel"]:bool(r["enabled"]) for r in rows}
        for ch in ("in_app","push","email","sms"): prefs.setdefault(ch,True if ch=="in_app" else False)
        return {"preferences":prefs}

@app.post("/api/v065/notifications")
def v065_create_notification(body:dict[str,Any], authorization:str|None=Header(default=None), idempotency_key:str|None=Header(default=None,alias="Idempotency-Key"))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    target_user=str(body.get("user_id","")).strip()
    order_id=body.get("order_id")
    template=str(body.get("template_key","order_update")).strip()
    title=str(body.get("title","WUNOO update")).strip()[:120]
    message=str(body.get("body","")).strip()[:2000]
    channel=str(body.get("channel","in_app")).strip()
    if not target_user or not message: raise HTTPException(400,"user_id a body jsou povinné")
    if channel not in {"in_app","push","email","sms"}: raise HTTPException(400,"Neplatný channel")
    with core_db_connect() as c:
        cached=_v052_guard(c,f"notification:{u['id']}",idempotency_key,{"user_id":target_user,"order_id":order_id,"template_key":template,"channel":channel})
        if cached is not None:return cached
        pref=c.execute("SELECT enabled FROM notification_preferences WHERE user_id=? AND channel=?",(target_user,channel)).fetchone()
        if pref and not pref["enabled"]:
            result={"status":"suppressed","reason":"user_preference","channel":channel}
        else:
            nid="ntf_"+uuid.uuid4().hex[:12]
            c.execute("""INSERT INTO notifications
                         (id,user_id,order_id,channel,template_key,title,body,status,attempts,created_at)
                         VALUES (?,?,?,?,?,?,?,?,?,?)""",
                      (nid,target_user,order_id,channel,template,title,message,"queued",0,now()))
            c.execute("INSERT INTO notification_events VALUES (?,?,?,?,?)",
                      ("nte_"+uuid.uuid4().hex[:12],nid,"queued",json.dumps({"source":"v065"},ensure_ascii=False),now()))
            result={"notification_id":nid,"status":"queued","channel":channel}
        _v052_store(c,f"notification:{u['id']}",idempotency_key,{"user_id":target_user,"order_id":order_id,"template_key":template,"channel":channel},result)
        c.commit();return result

@app.get("/api/v065/notifications")
def v065_list_notifications(authorization:str|None=Header(default=None), order_id:str|None=None)->dict[str,Any]:
    u=current_user(authorization)
    with core_db_connect() as c:
        if order_id:
            rows=c.execute("SELECT * FROM notifications WHERE user_id=? AND order_id=? ORDER BY created_at DESC LIMIT 100",(u["id"],order_id)).fetchall()
        else:
            rows=c.execute("SELECT * FROM notifications WHERE user_id=? ORDER BY created_at DESC LIMIT 100",(u["id"],)).fetchall()
        return {"notifications":[dict(r) for r in rows]}

@app.post("/api/v065/notifications/{notification_id}/dispatch")
def v065_dispatch_notification(notification_id:str, authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    with core_db_connect() as c:
        n=c.execute("SELECT * FROM notifications WHERE id=?",(notification_id,)).fetchone()
        if not n: raise HTTPException(404,"Notification nenalezena")
        if n["status"]=="sent": return {"notification_id":notification_id,"status":"sent","duplicate":True}
        attempts=int(n["attempts"])+1
        # Provider abstraction: deterministic demo adapter. Real provider can replace this boundary.
        provider_ref="demo_msg_"+uuid.uuid4().hex[:10]
        c.execute("UPDATE notifications SET status='sent',attempts=?,provider_ref=?,sent_at=?,last_error=NULL WHERE id=?",(attempts,provider_ref,now(),notification_id))
        c.execute("INSERT INTO notification_events VALUES (?,?,?,?,?)",
                  ("nte_"+uuid.uuid4().hex[:12],notification_id,"sent",json.dumps({"provider_ref":provider_ref},ensure_ascii=False),now()))
        c.commit()
        return {"notification_id":notification_id,"status":"sent","attempts":attempts,"provider_ref":provider_ref}

@app.get("/api/v065/notifications/{notification_id}/timeline")
def v065_notification_timeline(notification_id:str, authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization)
    with core_db_connect() as c:
        n=c.execute("SELECT * FROM notifications WHERE id=?",(notification_id,)).fetchone()
        if not n or n["user_id"]!=u["id"]: raise HTTPException(404,"Notification nenalezena")
        ev=c.execute("SELECT * FROM notification_events WHERE notification_id=? ORDER BY created_at",(notification_id,)).fetchall()
        return {"notification":dict(n),"timeline":[dict(x) for x in ev]}

