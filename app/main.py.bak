@app.get("/api/v050/control-tower")
def v050_control_tower(
    status:str|None=None,
    severity:str|None=None,
    issue:str|None=None,
    authorization:str|None=Header(default=None)
)->dict[str,Any]:
    u=current_user(authorization); require_role(u,"admin","ops_agent")
    with core_db_connect() as c:
        q="""SELECT o.id,o.status,o.merchant_id,o.courier_id,o.total_czk,
                    o.promised_at,o.fulfillment_mode,o.updated_at,
                    m.name merchant_name,
                    cr.name courier_name
             FROM orders o
             JOIN merchants m ON m.id=o.merchant_id
             LEFT JOIN couriers cr ON cr.id=o.courier_id
             WHERE 1=1"""
        args=[]
        if status:
            q+=" AND o.status=?"; args.append(status)
        if issue=="open_incident":
            q+=" AND EXISTS (SELECT 1 FROM reliability_incidents ri WHERE ri.order_id=o.id AND ri.status='open')"
        if issue=="finance_exception":
            q+=" AND EXISTS (SELECT 1 FROM payment_reconciliation pr WHERE pr.order_id=o.id AND pr.status='exception')"
        if issue=="customer_recovery":
            q+=" AND EXISTS (SELECT 1 FROM customer_recovery_actions ra WHERE ra.order_id=o.id AND ra.status='proposed')"
        q+=" ORDER BY o.updated_at DESC LIMIT 500"
        rows=[dict(r) for r in c.execute(q,args).fetchall()]
        incidents=c.execute("SELECT severity,COUNT(*) n FROM reliability_incidents WHERE status='open' GROUP BY severity").fetchall()
        finance=c.execute("SELECT COUNT(*) n FROM payment_reconciliation WHERE status='exception'").fetchone()["n"]
        recovery=c.execute("SELECT COUNT(*) n FROM customer_recovery_actions WHERE status='proposed'").fetchone()["n"]
        dispatch=c.execute("SELECT COUNT(*) n FROM orders WHERE status='dispatch_pending'").fetchone()["n"]
        stuck_cutoff=(datetime.now(timezone.utc)-__import__('datetime').timedelta(minutes=30)).isoformat()
        stuck=c.execute("""SELECT COUNT(*) n FROM orders
                           WHERE status NOT IN ('delivered','cancelled')
                           AND updated_at < ?""",(stuck_cutoff,)).fetchone()["n"]
        captured=c.execute("SELECT COALESCE(SUM(amount_czk),0) n FROM payments WHERE status='captured'").fetchone()["n"]
        return {
            "orders":rows,
            "summary":{
                "open_incidents":sum(int(x["n"]) for x in incidents),
                "p0_incidents":sum(int(x["n"]) for x in incidents if x["severity"]=="P0"),
                "finance_exceptions":int(finance),
                "recovery_pending":int(recovery),
                "dispatch_pending":int(dispatch),
                "stuck_orders":int(stuck),
                "captured_czk":float(captured or 0),
            }
        }


@app.get("/api/v050/orders/{order_id}/360")
def v050_order_360(order_id:str, authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,"admin","ops_agent","merchant","customer","courier")
    with core_db_connect() as c:
        o=c.execute("SELECT * FROM orders WHERE id=?",(order_id,)).fetchone()
        if not o: raise HTTPException(404,"Objednávka nenalezena")
        allowed=(u["role"] in {"admin","ops_agent"} or
                 (u["role"]=="merchant" and o["merchant_id"]==u["merchant_id"]) or
                 (u["role"]=="customer" and o["customer_id"]==u["customer_id"]) or
                 (u["role"]=="courier" and o["courier_id"]==u["courier_id"]))
        if not allowed: raise HTTPException(403,"forbidden")
        events=c.execute("SELECT * FROM events WHERE order_id=? ORDER BY created_at DESC LIMIT 100",(order_id,)).fetchall()
        inc=c.execute("SELECT * FROM reliability_incidents WHERE order_id=? ORDER BY detected_at DESC",(order_id,)).fetchall()
        pay=c.execute("SELECT * FROM payments WHERE order_id=?",(order_id,)).fetchone()
        refunds=c.execute("SELECT * FROM refunds WHERE order_id=? ORDER BY created_at",(order_id,)).fetchall()
        rec=c.execute("SELECT * FROM payment_reconciliation WHERE order_id=? ORDER BY checked_at DESC",(order_id,)).fetchall()
        recovery=c.execute("SELECT * FROM customer_recovery_actions WHERE order_id=? ORDER BY created_at DESC",(order_id,)).fetchall()
        rd=c.execute("SELECT * FROM order_redispatches WHERE order_id=? ORDER BY created_at DESC",(order_id,)).fetchall()
        notifications=c.execute("SELECT * FROM notifications WHERE order_id=? ORDER BY created_at DESC LIMIT 100",(order_id,)).fetchall()
        checkpoints=c.execute("SELECT * FROM delivery_checkpoints WHERE order_id=? ORDER BY created_at",(order_id,)).fetchall()
        return {"order":dict(o),"events":[dict(x) for x in events],"incidents":[dict(x) for x in inc],
                "payment":dict(pay) if pay else None,"refunds":[dict(x) for x in refunds],
                "reconciliation":[dict(x) for x in rec],"recovery":[dict(x) for x in recovery],
                "redispatches":[dict(x) for x in rd],"notifications":[dict(x) for x in notifications],
                "checkpoints":[dict(x) for x in checkpoints]}


