    ("merchant","payments","read","allow"),
    ("merchant","settlements","read","allow"),
    ("courier","orders","read","allow"),
    ("courier","orders","transition","allow"),
    ("courier","payments","read","deny"),
    ("courier","settlements","read","deny"),
    ("ops_agent","orders","read","allow"),
    ("ops_agent","orders","transition","allow"),
    ("ops_agent","payments","read","allow"),
    ("ops_agent","settlements","read","allow"),
    ("admin","orders","read","allow"),
