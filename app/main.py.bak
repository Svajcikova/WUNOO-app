def _v071_enqueue(c, queue_name, job_type, payload, max_attempts=5, available_at=None):
    jid="wj_"+uuid.uuid4().hex[:12]
    c.execute("""INSERT INTO worker_jobs
        (id,queue_name,job_type,payload_json,status,attempts,max_attempts,available_at,created_at)
        VALUES (?,?,?,?,?,?,?,?,?)""",
        (jid,queue_name,job_type,json.dumps(payload,ensure_ascii=False),"queued",0,max_attempts,available_at or now(),now()))
    return jid

@app.post("/api/v071/jobs")
def v071_enqueue_job(body:dict[str,Any], authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    queue=str(body.get("queue_name","default")).strip()
    job_type=str(body.get("job_type","generic")).strip()
    payload=body.get("payload") or {}
    with core_db_connect() as c:
        jid=_v071_enqueue(c,queue,job_type,payload,int(body.get("max_attempts",5)))
        c.commit()
        return {"job_id":jid,"status":"queued"}

@app.post("/api/v071/worker/claim")
def v071_claim_job(body:dict[str,Any], authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    worker_id=str(body.get("worker_id","worker")).strip()
    with core_db_connect() as c:
        job=c.execute("""SELECT * FROM worker_jobs WHERE status='queued' AND available_at<=?
                         ORDER BY created_at LIMIT 1""",(now(),)).fetchone()
        if not job:return {"job":None}
        c.execute("UPDATE worker_jobs SET status='running',locked_at=? WHERE id=? AND status='queued'",(now(),job["id"]))
        c.commit()
        if c.execute("SELECT status FROM worker_jobs WHERE id=?",(job["id"],)).fetchone()["status"]!="running": return {"job":None}
        return {"job":dict(job),"worker_id":worker_id}

@app.post("/api/v071/worker/{job_id}/complete")
def v071_complete_job(job_id:str, authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    with core_db_connect() as c:
        j=c.execute("SELECT * FROM worker_jobs WHERE id=?",(job_id,)).fetchone()
        if not j: raise HTTPException(404,"Job nenalezen")
        c.execute("UPDATE worker_jobs SET status='completed',completed_at=? WHERE id=? AND status='running'",(now(),job_id))
        c.commit()
        return {"job_id":job_id,"status":"completed"}

@app.post("/api/v071/worker/{job_id}/fail")
def v071_fail_job(job_id:str, body:dict[str,Any], authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    error=str(body.get("error","unknown_error"))[:1000]
    with core_db_connect() as c:
        j=c.execute("SELECT * FROM worker_jobs WHERE id=?",(job_id,)).fetchone()
        if not j: raise HTTPException(404,"Job nenalezen")
        attempts=int(j["attempts"])+1
        if attempts>=int(j["max_attempts"]):
            c.execute("""INSERT INTO dead_letter_jobs(id,queue_name,job_type,payload_json,attempts,last_error,status,created_at)
                         VALUES (?,?,?,?,?,?,?,?)""",
                      ("dlq_"+uuid.uuid4().hex[:12],j["queue_name"],j["job_type"],j["payload_json"],attempts,error,"dead",now()))
            c.execute("UPDATE worker_jobs SET status='dead',attempts=?,last_error=? WHERE id=?",(attempts,error,job_id))
            status="dead"
        else:
            c.execute("UPDATE worker_jobs SET status='queued',attempts=?,last_error=?,locked_at=NULL WHERE id=?",(attempts,error,job_id))
            status="queued"
        c.commit()
        return {"job_id":job_id,"status":status,"attempts":attempts}

@app.get("/api/v071/worker/jobs")
def v071_worker_jobs(authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    with core_db_connect() as c:
        rows=c.execute("SELECT * FROM worker_jobs ORDER BY created_at DESC LIMIT 200").fetchall()
        return {"jobs":[dict(x) for x in rows]}

@app.post("/api/v071/startup-check")
def v071_startup_check(authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin"})
    checks=[]
    with core_db_connect() as c:
        for name,fn in [
            ("database",lambda: c.execute("SELECT 1").fetchone() is not None),
            ("orders_table",lambda: c.execute("SELECT 1 FROM orders LIMIT 1").fetchone() is not None or True),
            ("worker_table",lambda: c.execute("SELECT 1 FROM worker_jobs LIMIT 1").fetchone() is not None or True),
        ]:
            try: ok=bool(fn()); detail={"ok":ok}
            except Exception as exc: ok=False; detail={"ok":False,"error":str(exc)}
            checks.append({"name":name,"status":"ok" if ok else "fail","details":detail})
            c.execute("INSERT INTO service_startup_checks VALUES (?,?,?,?,?)",
                      ("ssc_"+uuid.uuid4().hex[:12],name,"ok" if ok else "fail",json.dumps(detail,ensure_ascii=False),now()))
        c.commit()
    return {"status":"ok" if all(x["status"]=="ok" for x in checks) else "fail","checks":checks}

