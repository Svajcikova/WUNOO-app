                "canonical_protected_endpoints":["orders.read","orders.transition"],
                "migration_mode":"incremental"}

@app.post("/api/v080/ops/authz/run-matrix")
def v080_run_matrix(authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    # Evaluate policy contracts using synthetic subjects. Tenant/owner scopes are
    # checked with deliberately matching and mismatching contexts.
    results=[]
    with core_db_connect() as c:
        for role,res,action,expected in V080_SECURITY_MATRIX:
            subject={"id":"matrix_"+role,"role":role,"merchant_id":"tenant_A","tenant_id":"tenant_A"}
            resource_id="matrix_"+role
            tenant="tenant_A"
            allowed,reason=AuthorizationPolicyEngine(c).allow(subject,res,action,resource_id,tenant)
            observed="allow" if allowed else "deny"
            status="PASS" if observed==expected else "FAIL"
            c.execute("""INSERT INTO api_security_matrix
                (id,role,resource,action,expected,observed,status,created_at)
                VALUES (?,?,?,?,?,?,?,?) ON CONFLICT(id) DO UPDATE SET role=excluded.role, resource=excluded.resource, action=excluded.action, expected=excluded.expected, observed=excluded.observed, status=excluded.status, created_at=excluded.created_at""",
                ("asm_"+role+"_"+res+"_"+action,role,res,action,expected,observed,status,now()))
            results.append({"role":role,"resource":res,"action":action,"expected":expected,"observed":observed,"status":status,"reason":reason})
        c.commit()
    return {"status":"PASS" if all(x["status"]=="PASS" for x in results) else "FAIL","total":len(results),"passed":sum(x["status"]=="PASS" for x in results),"results":results}

@app.get("/api/v080/ops/authz/matrix/history")
def v080_matrix_history(authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    with core_db_connect() as c:
        rows=c.execute("SELECT * FROM api_security_matrix ORDER BY role,resource,action").fetchall()
        return {"results":[dict(x) for x in rows]}

