@app.get("/api/v047/notifications")
def v047_notifications(unread_only: bool=False, authorization: str | None=Header(default=None)) -> dict[str,Any]:
    u=current_user(authorization)
    with core_db_connect() as c:
        q="SELECT * FROM notifications WHERE user_id=?"
        args=[u["id"]]
        if unread_only: q+=" AND read_at IS NULL"
        q+=" ORDER BY created_at DESC LIMIT 100"
        rows=c.execute(q,args).fetchall()
        unread=c.execute("SELECT COUNT(*) n FROM notifications WHERE user_id=? AND read_at IS NULL",(u["id"],)).fetchone()["n"]
        return {"unread_count":int(unread),"notifications":[dict(x) for x in rows]}

