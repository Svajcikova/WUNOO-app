@app.post("/api/v054/golden-order/run")
def v054_golden_order_run(body:dict[str,Any], authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    run_id="gor_"+uuid.uuid4().hex[:12]
    started=now()
    with core_db_connect() as c:
        c.execute("""INSERT INTO golden_order_runs
                     (id,status,current_step,started_at)
                     VALUES (?,?,?,?)""",(run_id,"running","preflight",started))
        c.commit()

    steps=[
        "preflight",
        "order_integrity",
        "payment_integrity",
        "promise_integrity",
        "dispatch_integrity",
        "tracking_integrity",
        "delivery_integrity",
        "notification_integrity",
        "reconciliation_integrity",
        "final_invariants"
    ]
    order_id=body.get("order_id")
    results=[]
    failed=None

    with core_db_connect() as c:
        for n,step in enumerate(steps,1):
            try:
                details={}
                if step=="preflight":
                    for table in ("orders","payments","payment_reconciliation","reliability_incidents","notifications","events"):
                        c.execute(f"SELECT 1 FROM {table} LIMIT 1")
                    details["database"]="ok"
                elif step=="order_integrity":
                    if not order_id:
                        row=c.execute("SELECT id FROM orders ORDER BY created_at DESC LIMIT 1").fetchone()
                        order_id=row["id"] if row else None
                    if not order_id: raise ValueError("No order available")
                    o=c.execute("SELECT * FROM orders WHERE id=?",(order_id,)).fetchone()
                    if not o: raise ValueError("Order not found")
                    details={"order_id":order_id,"status":o["status"],"total_czk":o["total_czk"]}
                elif step=="payment_integrity":
                    p=c.execute("SELECT * FROM payments WHERE order_id=?",(order_id,)).fetchone()
                    pi=c.execute("SELECT * FROM payment_intents WHERE order_id=?",(order_id,)).fetchone()
                    details={"payment_intent":bool(pi),"payment":bool(p),
                             "payment_status":p["status"] if p else None}
                elif step=="promise_integrity":
                    o=c.execute("SELECT promised_at FROM orders WHERE id=?",(order_id,)).fetchone()
                    details={"promised_at":o["promised_at"] if o else None,"present":bool(o and o["promised_at"])}
                elif step=="dispatch_integrity":
                    o=c.execute("SELECT courier_id,status FROM orders WHERE id=?",(order_id,)).fetchone()
                    details={"courier_id":o["courier_id"] if o else None,"status":o["status"] if o else None}
                elif step=="tracking_integrity":
                    count=c.execute("SELECT COUNT(*) n FROM courier_locations WHERE order_id=?",(order_id,)).fetchone()["n"]
                    details={"location_points":int(count)}
                elif step=="delivery_integrity":
                    cps=c.execute("SELECT COUNT(*) n FROM delivery_checkpoints WHERE order_id=?",(order_id,)).fetchone()["n"]
                    details={"delivery_checkpoints":int(cps)}
                elif step=="notification_integrity":
                    n=c.execute("SELECT COUNT(*) n FROM notifications WHERE order_id=?",(order_id,)).fetchone()["n"]
                    ev=c.execute("SELECT COUNT(*) n FROM notification_jobs WHERE order_id=?",(order_id,)).fetchone()["n"]
                    details={"notifications":int(n),"notification_jobs":int(ev)}
                elif step=="reconciliation_integrity":
                    rec=c.execute("""SELECT * FROM payment_reconciliation
                                     WHERE order_id=? ORDER BY checked_at DESC LIMIT 1""",(order_id,)).fetchone()
                    details={"status":rec["status"] if rec else "missing",
                             "variance_czk":rec["variance_czk"] if rec else None}
                    if rec and rec["status"]=="exception":
                        raise ValueError(f"Finance reconciliation exception: variance {rec['variance_czk']}")
                elif step=="final_invariants":
                    o=c.execute("SELECT * FROM orders WHERE id=?",(order_id,)).fetchone()
                    assert o is not None
                    if float(o["total_czk"])<0: raise ValueError("Negative order total")
                    details={"order_id":order_id,"invariant":"PASS"}
                _v054_step(c,run_id,n,step,"passed",details)
                results.append({"step":step,"status":"passed","details":details})
            except Exception as exc:
                _v054_step(c,run_id,n,step,"failed",{"error":str(exc)})
                failed=(step,str(exc))
                break
        status="failed" if failed else "passed"
        result={"run_id":run_id,"order_id":order_id,"status":status,"steps":results}
        c.execute("""UPDATE golden_order_runs
                     SET order_id=?,status=?,current_step=?,finished_at=?,failure_step=?,failure_reason=?,result_json=?
                     WHERE id=?""",
                  (order_id,status,results[-1]["step"] if results else "preflight",now(),
                   failed[0] if failed else None,failed[1] if failed else None,
                   json.dumps(result,ensure_ascii=False),run_id))
        _v053_log(c,"info" if not failed else "error","golden_order_completed",run_id,
                  {"order_id":order_id,"status":status,"failure":failed})
        c.commit()
        return result

@app.get("/api/v054/golden-order/{run_id}")
def v054_golden_order_get(run_id:str, authorization:str|None=Header(default=None))->dict[str,Any]:
