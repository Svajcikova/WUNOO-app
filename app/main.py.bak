@app.post("/api/v038/merchant/menu-category")
def v038_create_category(body: dict[str, Any], authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u=current_user(authorization); require_role(u,"merchant")
    with core_db_connect() as _c: migrate_v114(_c)
    name=str(body.get("name","")).strip()
    if not name or len(name)>80: raise HTTPException(400,"Neplatný název kategorie")
    cid="mc_"+uuid.uuid4().hex[:10]
    with core_db_connect() as c:
        max_order=c.execute("SELECT COALESCE(MAX(sort_order),-1) n FROM menu_categories WHERE merchant_id=?",(u["merchant_id"],)).fetchone()["n"]
        c.execute("INSERT INTO menu_categories VALUES (?,?,?,?,?)",(cid,u["merchant_id"],name,int(max_order)+1,1))
        emit(c,None,"menu_category_created",{"merchant_id":u["merchant_id"],"category_id":cid,"name":name},u["id"])
        c.commit()
    return {"id":cid,"name":name,"active":1}


@app.post("/api/v038/merchant/menu-item")
def v038_create_menu_item(body: dict[str, Any], authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u=current_user(authorization); require_role(u,"merchant")
    with core_db_connect() as _c: migrate_v114(_c)
    name=str(body.get("name","")).strip()
    if not name or len(name)>120: raise HTTPException(400,"Neplatný název položky")
    try: price=float(body.get("price_czk"))
    except: raise HTTPException(400,"Neplatná cena")
    if price<0 or price>100000: raise HTTPException(400,"Neplatná cena")
    category_id=body.get("category_id")
    with core_db_connect() as c:
        if category_id:
            ok=c.execute("SELECT 1 FROM menu_categories WHERE id=? AND merchant_id=? AND active=1",(category_id,u["merchant_id"])).fetchone()
            if not ok: raise HTTPException(400,"Kategorie nepatří restauraci")
        iid="mi_"+uuid.uuid4().hex[:10]
        c.execute("INSERT INTO menu_items(id,merchant_id,name,description,price_czk,active,category_id) VALUES (?,?,?,?,?,?,?)",
                  (iid,u["merchant_id"],name,body.get("description"),price,1,category_id))
        emit(c,None,"menu_item_created",{"merchant_id":u["merchant_id"],"menu_item_id":iid,"name":name,"price_czk":price},u["id"])
        c.commit()
    return {"id":iid,"name":name,"price_czk":price,"active":1,"category_id":category_id}


@app.patch("/api/v038/merchant/menu-item/{item_id}")
def v038_update_menu_item(item_id: str, body: dict[str, Any], authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u=current_user(authorization); require_role(u,"merchant")
    allowed={"name","description","price_czk","active","category_id"}
    changes={k:v for k,v in body.items() if k in allowed}
    if "name" in changes and not str(changes["name"]).strip(): raise HTTPException(400,"Neplatný název")
    if "price_czk" in changes:
        try: changes["price_czk"]=float(changes["price_czk"])
        except: raise HTTPException(400,"Neplatná cena")
        if changes["price_czk"]<0: raise HTTPException(400,"Neplatná cena")
    if "active" in changes: changes["active"]=1 if changes["active"] else 0
    with core_db_connect() as c:
        old=c.execute("SELECT * FROM menu_items WHERE id=? AND merchant_id=?",(item_id,u["merchant_id"])).fetchone()
        if not old: raise HTTPException(404,"Položka nenalezena")
        if "category_id" in changes and changes["category_id"]:
            ok=c.execute("SELECT 1 FROM menu_categories WHERE id=? AND merchant_id=? AND active=1",(changes["category_id"],u["merchant_id"])).fetchone()
            if not ok: raise HTTPException(400,"Neplatná kategorie")
        if changes:
            sets=", ".join(f"{k}=?" for k in changes)
            vals=list(changes.values())+[item_id,u["merchant_id"]]
            c.execute(f"UPDATE menu_items SET {sets} WHERE id=? AND merchant_id=?",vals)
            emit(c,None,"menu_item_updated",{"merchant_id":u["merchant_id"],"menu_item_id":item_id,"changes":changes},u["id"])
        c.commit()
        cur=c.execute("SELECT id,merchant_id,name,description,price_czk,active,category_id FROM menu_items WHERE id=?",(item_id,)).fetchone()
        return dict(cur)


@app.delete("/api/v038/merchant/menu-item/{item_id}")
def v038_delete_menu_item(item_id: str, authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u=current_user(authorization); require_role(u,"merchant")
    with core_db_connect() as c:
        old=c.execute("SELECT id FROM menu_items WHERE id=? AND merchant_id=?",(item_id,u["merchant_id"])).fetchone()
        if not old: raise HTTPException(404,"Položka nenalezena")
        # Soft delete so historical order snapshots stay intact.
        c.execute("UPDATE menu_items SET active=0 WHERE id=? AND merchant_id=?",(item_id,u["merchant_id"]))
        emit(c,None,"menu_item_archived",{"merchant_id":u["merchant_id"],"menu_item_id":item_id},u["id"])
        c.commit()
    return {"id":item_id,"active":0}


