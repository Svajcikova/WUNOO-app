@app.post("/api/v055/e2e/run")
def v055_e2e_run(body:dict[str,Any], authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    run_id="e2e_"+uuid.uuid4().hex[:12]
    started=now()
    results=[]; entities={}; failure=None
    with core_db_connect() as c:
        c.execute("INSERT INTO e2e_test_runs VALUES (?,?,?,?,?,?)",
                  (run_id,"golden_order_synthetic","running",started,None,None))
        try:
            # Discover a safe existing merchant/customer/courier fixture first.
            merchant=c.execute("SELECT id FROM merchants ORDER BY id LIMIT 1").fetchone()
            customer=c.execute("SELECT id FROM customers ORDER BY id LIMIT 1").fetchone()
            courier=c.execute("SELECT id FROM couriers ORDER BY id LIMIT 1").fetchone()
            if not merchant or not customer:
                raise ValueError("Test fixture requires at least one merchant and customer")
            entities["merchant_id"]=merchant["id"]; entities["customer_id"]=customer["id"]
            if courier: entities["courier_id"]=courier["id"]
            # Reuse the guaranteed demo identities; the order itself remains synthetic and unique.
            entities["merchant_id"]=merchant["id"]; entities["customer_id"]=customer["id"]
            if courier: entities["courier_id"]=courier["id"]
            for k,v in entities.items(): _v055_record_entity(c,run_id,k,v)

            # Synthetic E2E run uses a dedicated test order, never mutating a production order.
            oid="e2e_order_"+uuid.uuid4().hex[:12]
            total=100.0
            c.execute("""INSERT INTO orders
                         (id,customer_id,merchant_id,courier_id,status,total_czk,fulfillment_mode,
                          promised_at,created_at,updated_at)
                         VALUES (?,?,?,?,?,?,?,?,?,?)""",
                      (oid,customer["id"],merchant["id"],courier["id"] if courier else None,
                       "payment_pending",total,"delivery",now(),now(),now()))
            _v055_record_entity(c,run_id,"order_id",oid)
            results.append({"step":"create_order","status":"passed","order_id":oid})

            # Payment intent + capture, then verify.
            pi="pi_"+uuid.uuid4().hex[:12]; provider="e2e_intent_"+uuid.uuid4().hex[:12]
            c.execute("INSERT INTO payment_intents VALUES (?,?,?,?,?,?,?,?,?)",
                      (pi,oid,total,"CZK","succeeded","test",provider,now(),now()))
            pay="pay_"+uuid.uuid4().hex[:10]
            c.execute("INSERT INTO payments VALUES (?,?,?,?,?,?)",(pay,oid,provider,total,"captured",now()))
            results.append({"step":"payment_capture","status":"passed","payment_id":pay})

            # Promise / dispatch / tracking / delivery evidence.
            emit(c,oid,"payment_captured_v055",{"payment_id":pay,"amount_czk":total},u["id"])
            if courier:
                emit(c,oid,"courier_assigned",{"courier_id":courier["id"]},u["id"])
            loc_id="loc_"+uuid.uuid4().hex[:10]
            # Insert only if the existing schema supports the expected columns.
            cols={r["name"] for r in _db_columns(c,"courier_locations")}
            if {"id","order_id","recorded_at"}.issubset(cols):
                fields=["id","order_id","recorded_at"]
                vals=[loc_id,oid,now()]
                for fld,val in [("latitude",49.83),("longitude",18.29),("live_eta_minutes",5),("deviation_ratio",0.0)]:
                    if fld in cols: fields.append(fld);vals.append(val)
                c.execute(f"INSERT INTO courier_locations ({','.join(fields)}) VALUES ({','.join(['?']*len(fields))})",vals)
            emit(c,oid,"out_for_delivery_started",{"e2e":True},u["id"])
            emit(c,oid,"delivery_completed",{"e2e":True},u["id"])
            results.append({"step":"dispatch_tracking_delivery","status":"passed","courier_id":courier["id"] if courier else None})

            # Notification job and processing.
            _v048_enqueue_event(c,oid,"delivery_completed",{"e2e":True})
            _v048_process_jobs(c,100)
            n=c.execute("SELECT COUNT(*) n FROM notifications WHERE order_id=?",(oid,)).fetchone()["n"]
            results.append({"step":"notifications","status":"passed","count":int(n)})

            # Reconciliation must be clean.
            rec=_v049_reconcile_order(c,oid)
            if rec["status"]!="reconciled": raise ValueError("E2E reconciliation exception")
            results.append({"step":"reconciliation","status":"passed","variance_czk":rec["variance_czk"]})

            # Golden Order invariant endpoint logic, condensed into direct DB invariants.
            invariants=[
                ("payment_captured", c.execute("SELECT status FROM payments WHERE order_id=?",(oid,)).fetchone()["status"]=="captured"),
                ("payment_amount_matches", float(c.execute("SELECT amount_czk FROM payments WHERE order_id=?",(oid,)).fetchone()["amount_czk"])==total),
                ("notifications_created", n>0),
                ("reconciliation_clean", rec["status"]=="reconciled" and abs(float(rec["variance_czk"]))<=0.01),
            ]
            bad=[name for name,ok in invariants if not ok]
            if bad: raise ValueError("Failed invariants: "+",".join(bad))
            results.append({"step":"final_invariants","status":"passed","checks":[x[0] for x in invariants]})
            c.execute("UPDATE orders SET status='delivered',updated_at=? WHERE id=?",(now(),oid))
            status="passed"
        except Exception as exc:
            status="failed"; failure=str(exc)
            results.append({"step":"e2e_failure","status":"failed","error":failure})
        result={"run_id":run_id,"status":status,"entities":entities,"results":results,"failure":failure}
        c.execute("UPDATE e2e_test_runs SET status=?,finished_at=?,result_json=? WHERE id=?",
                  (status,now(),json.dumps(result,ensure_ascii=False),run_id))
        _v053_log(c,"info" if status=="passed" else "error","e2e_test_completed",run_id,result)
        c.commit()
        return result

