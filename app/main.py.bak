    version=str(body.get("version","")).strip()
    if not version: raise HTTPException(400,"version je povinná")
    with core_db_connect() as c:
        existing=c.execute("SELECT * FROM db_migrations WHERE version=?",(version,)).fetchone()
        if existing:return {"version":version,"status":"already_applied"}
        c.execute("INSERT INTO db_migrations(version,applied_at) VALUES (?,?)",(version,now()))
        c.commit()
        return {"version":version,"status":"applied"}

