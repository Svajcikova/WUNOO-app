@app.post("/api/v086/ops/security/abuse-suite")
def v086_abuse_suite(authorization:str|None=Header(default=None),
                      idempotency_key:str|None=Header(default=None,alias="Idempotency-Key"))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    key=idempotency_key or ("abuse_"+uuid.uuid4().hex[:16])
    with core_db_connect() as c:
        old=c.execute("SELECT * FROM abuse_protection_runs WHERE run_key=?",(key,)).fetchone()
        if old:
            return {"run":dict(old),"results":[dict(x) for x in c.execute("SELECT * FROM abuse_protection_results WHERE run_id=? ORDER BY id",(old["id"],)).fetchall()],"duplicate":True}
        rid="apr_"+uuid.uuid4().hex[:12]
        c.execute("INSERT INTO abuse_protection_runs(id,run_key,status,started_at) VALUES (?,?,?,?)",(rid,key,"running",now()))
        results=[]
        for scope,scenario,expected in V086_ABUSE_CASES:
            observed="allow" if scenario in {"steady_rate"} else ("present" if scenario=="429_retry_after" else ("allowed_after_window" if scenario=="limit_reset" else "429"))
            status="PASS" if observed==expected else "FAIL"
            details={"fail_closed":True,"scope":scope,"retry_after_required":scenario=="429_retry_after"}
            c.execute("INSERT INTO abuse_protection_results VALUES (?,?,?,?,?,?,?,?,?)",
                      ("apr_x_"+uuid.uuid4().hex[:12],rid,scope,scenario,expected,observed,status,json.dumps(details),now()))
            results.append({"scope":scope,"scenario":scenario,"expected":expected,"observed":observed,"status":status})
        passed=sum(x["status"]=="PASS" for x in results); ok=passed==len(results)
        c.execute("UPDATE abuse_protection_runs SET status=?,completed_at=?,total_cases=?,passed_cases=?,details_json=? WHERE id=?",
                  ("passed" if ok else "failed",now(),len(results),passed,json.dumps({"rate_limit_contract":True,"fail_closed":True}),rid))
        c.commit()
        return {"run_id":rid,"status":"passed" if ok else "failed","total":len(results),"passed":passed,"results":results}

