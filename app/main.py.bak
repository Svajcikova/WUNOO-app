@app.post('/api/v123/ops/incidents')
def v123_open_incident(body:dict[str,Any], authorization:str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    title=str(body.get('title','')).strip(); summary=str(body.get('summary','')).strip(); severity=str(body.get('severity','high')).lower()
    if not title or not summary: raise HTTPException(400,'title a summary jsou povinné')
    if severity not in {'low','medium','high','critical'}: raise HTTPException(400,'Neplatná severity')
    iid='inc23_'+uuid.uuid4().hex[:12]
    with core_db_connect() as c:
        c.execute('INSERT INTO v123_incidents VALUES(?,?,?,?,?,?,?,?,?)',(iid,body.get('alert_id'),severity,'open',title,summary,now(),None,body.get('correlation_id'))); c.commit()
    return {'schema_version':'1.23','incident_id':iid,'status':'open'}


