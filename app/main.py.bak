# ---------------- WUNOO v1.75: Multi-Witness Quorum & Transparency Finality ----------------
def migrate_v175(c):
    c.executescript("""CREATE TABLE IF NOT EXISTS production_release_transparency_finality(
        id TEXT PRIMARY KEY, checkpoint_id TEXT NOT NULL, checkpoint_sha256 TEXT NOT NULL,
        release_version TEXT NOT NULL, quorum_required INTEGER NOT NULL, witness_count INTEGER NOT NULL,
        witness_ids_json TEXT NOT NULL, witness_receipt_hashes_json TEXT NOT NULL,
        proof_json TEXT NOT NULL, proof_sha256 TEXT NOT NULL UNIQUE,
        algorithm TEXT NOT NULL, public_key_b64 TEXT NOT NULL, signature_b64 TEXT NOT NULL,
        status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT
    );
    CREATE UNIQUE INDEX IF NOT EXISTS ux_release_finality_checkpoint_quorum
      ON production_release_transparency_finality(checkpoint_sha256,quorum_required);
    CREATE INDEX IF NOT EXISTS idx_release_finality_created
      ON production_release_transparency_finality(created_at DESC);
    """)
    try: c.commit()
    except Exception: pass

_V175_POLICY={'schema_version':'1.75','format':'wunoo.release.transparency.finality.v1','hash_algorithm':'sha256','signature_algorithm':'Ed25519','default_quorum':2,'distinct_witnesses_required':True,'trusted_witnesses_required':True,'same_checkpoint_required':True,'purpose':'multi_witness_transparency_finality','append_only':True,'fail_closed':True,'automatic_release':False,'finality_is_not_release_authorization':True}
def _v175_hash(payload): return hashlib.sha256(json.dumps(payload,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()).hexdigest()
def _v175_quorum():
    try: return max(1,int(os.getenv('WUNOO_EXTERNAL_WITNESS_QUORUM','2')))
    except Exception: return 2
def _v175_collect_quorum(c,checkpoint_sha256=None,quorum=None):
    q=int(quorum or _v175_quorum())
    if q<1: return {'valid':False,'reason':'INVALID_QUORUM'}
    cps=_v170_row(c,'production_release_transparency_checkpoints',' WHERE checkpoint_sha256=?',(checkpoint_sha256,),'checkpoint_no DESC') if checkpoint_sha256 else _v170_row(c,'production_release_transparency_checkpoints',order='checkpoint_no DESC')
    if not cps: return {'valid':False,'reason':'CHECKPOINT_NOT_FOUND'}
    cp=cps
    logrow=_v170_row(c,'production_release_transparency_log',' WHERE sequence_no=?',(cp['sequence_no'],),'sequence_no DESC')
    if not logrow: return {'valid':False,'reason':'TRANSPARENCY_ENTRY_NOT_FOUND'}
    chain=_v173_verify(_v173_rows(c))
    if not chain['valid']: return {'valid':False,'reason':'CHECKPOINT_CHAIN_INVALID','detail':chain['reason']}
    rows=[r for r in _v174_witness_rows(c) if str(r['checkpoint_sha256'])==str(cp['checkpoint_sha256'])]
    valid=[]; seen=set()
    for r in rows:
        if r['witness_id'] in seen: continue
        rr=_v174_verify_receipt(r,cp)
        if rr['valid'] and _v174_trusted(r['public_key_b64']):
            valid.append(r); seen.add(r['witness_id'])
    if len(valid)<q: return {'valid':False,'reason':'WITNESS_QUORUM_NOT_REACHED','required':q,'trusted_valid_witnesses':len(valid),'checkpoint_sha256':cp['checkpoint_sha256']}
    valid.sort(key=lambda r:(str(r['witness_id']),str(r['receipt_sha256'])))
    return {'valid':True,'reason':'WITNESS_QUORUM_REACHED','checkpoint_id':cp['id'],'checkpoint_sha256':cp['checkpoint_sha256'],'release_version':logrow['release_version'],'required':q,'witness_count':len(valid),'witness_ids':[r['witness_id'] for r in valid[:q]],'witness_receipt_hashes':[r['receipt_sha256'] for r in valid[:q]]}
def _v175_proof_payload(qr):
    return {'format':'wunoo.release.transparency.finality.v1','schema_version':'1.75','checkpoint_id':qr['checkpoint_id'],'checkpoint_sha256':qr['checkpoint_sha256'],'release_version':qr['release_version'],'quorum_required':qr['required'],'witness_ids':list(qr['witness_ids']),'witness_receipt_hashes':list(qr['witness_receipt_hashes'])}
def _v175_verify_row(row):
    try:
        proof=json.loads(row['proof_json'] or '{}'); digest=_v175_hash(proof)
        if digest!=row['proof_sha256']: return {'valid':False,'reason':'FINALITY_HASH_MISMATCH'}
        if proof.get('checkpoint_sha256')!=row['checkpoint_sha256'] or proof.get('release_version')!=row['release_version']: return {'valid':False,'reason':'FINALITY_BINDING_INVALID'}
        if int(proof.get('quorum_required',0))!=int(row['quorum_required']): return {'valid':False,'reason':'FINALITY_QUORUM_INVALID'}
        if int(row['witness_count'])!=len(proof.get('witness_ids',[])) or len(proof.get('witness_ids',[]))<int(row['quorum_required']): return {'valid':False,'reason':'FINALITY_WITNESS_COUNT_INVALID'}
        if len(set(proof.get('witness_ids',[])))!=len(proof.get('witness_ids',[])): return {'valid':False,'reason':'FINALITY_DUPLICATE_WITNESS'}
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto(); Ed25519PublicKey.from_public_bytes(base64.b64decode(row['public_key_b64'])).verify(base64.b64decode(row['signature_b64']),json.dumps(proof,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode())
        return {'valid':True,'reason':'TRANSPARENCY_FINALITY_VERIFIED','proof_sha256':row['proof_sha256']}
    except Exception: return {'valid':False,'reason':'FINALITY_SIGNATURE_INVALID'}

@app.get('/api/v175/ops/transparency-finality/policy')
def v175_policy(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); return _V175_POLICY
@app.post('/api/v175/ops/transparency-finality/finalize')
def v175_finalize(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization); payload=payload or {}; require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        qr=_v175_collect_quorum(c,payload.get('checkpoint_sha256'),payload.get('quorum'))
        if not qr['valid']: raise HTTPException(409,qr['reason'])
        existing=_v170_row(c,'production_release_transparency_finality',' WHERE checkpoint_sha256=? AND quorum_required=?',(qr['checkpoint_sha256'],qr['required']),'created_at DESC')
        if existing:
            vr=_v175_verify_row(existing)
            if not vr['valid']: raise HTTPException(409,vr['reason'])
            return {'schema_version':'1.75','finality_id':existing['id'],'proof_sha256':existing['proof_sha256'],'idempotent':True,'verification':vr,'quorum':qr}
        proof=_v175_proof_payload(qr); digest=_v175_hash(proof); key,pub,keyid=_v169_load_signer(); pub64=base64.b64encode(pub).decode(); sig=base64.b64encode(key.sign(json.dumps(proof,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode())).decode()
        fid='fin_'+uuid.uuid4().hex[:16]; t=now()
        c.execute('INSERT INTO production_release_transparency_finality(id,checkpoint_id,checkpoint_sha256,release_version,quorum_required,witness_count,witness_ids_json,witness_receipt_hashes_json,proof_json,proof_sha256,algorithm,public_key_b64,signature_b64,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(fid,qr['checkpoint_id'],qr['checkpoint_sha256'],qr['release_version'],qr['required'],len(qr['witness_ids']),json.dumps(qr['witness_ids'],sort_keys=True,separators=(',',':')),json.dumps(qr['witness_receipt_hashes'],sort_keys=True,separators=(',',':')),json.dumps(proof,sort_keys=True,separators=(',',':'),ensure_ascii=False),digest,'Ed25519',pub64,sig,'FINALIZED',t,str(u.get('email') or u.get('id') or 'operator'))); c.commit()
        return {'schema_version':'1.75','finality_id':fid,'proof_sha256':digest,'idempotent':False,'quorum':qr,'signer_key_id':keyid,'proof':proof,'verification':_v175_verify_row(_v170_row(c,'production_release_transparency_finality',' WHERE id=?',(fid,),'created_at DESC'))}
@app.post('/api/v175/ops/transparency-finality/verify')
def v175_verify(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization); payload=payload or {}; require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        row=_v170_row(c,'production_release_transparency_finality',' WHERE id=?',(payload['finality_id'],),'created_at DESC') if payload.get('finality_id') else _v170_row(c,'production_release_transparency_finality',order='created_at DESC')
        if not row: raise HTTPException(404,'transparency finality nenalezena')
        vr=_v175_verify_row(row)
        if not vr['valid']: raise HTTPException(409,vr['reason'])
        qr=_v175_collect_quorum(c,row['checkpoint_sha256'],row['quorum_required'])
        if not qr['valid']: raise HTTPException(409,qr['reason'])
        proof=json.loads(row['proof_json'] or '{}')
        if proof.get('witness_receipt_hashes')!=qr['witness_receipt_hashes'] or proof.get('witness_ids')!=qr['witness_ids']: raise HTTPException(409,'WITNESS_QUORUM_CHANGED')
        return {'schema_version':'1.75','verification':{'valid':True,'reason':'TRANSPARENCY_FINALITY_VERIFIED','proof_sha256':row['proof_sha256'],'quorum':qr}}
@app.get('/api/v175/ops/transparency-finality/latest')
def v175_latest(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        row=_v170_row(c,'production_release_transparency_finality',order='created_at DESC')
        if not row: return {'schema_version':'1.75','finality':None}
        return {'schema_version':'1.75','finality':{'finality_id':row['id'],'checkpoint_sha256':row['checkpoint_sha256'],'release_version':row['release_version'],'quorum_required':row['quorum_required'],'witness_count':row['witness_count'],'proof_sha256':row['proof_sha256']},'verification':_v175_verify_row(row)}


# ---------------- WUNOO v1.77: Witness Attestation Policy & Trust Governance ----------------
def migrate_v177(c):
    c.executescript("""CREATE TABLE IF NOT EXISTS production_witness_trust_policies(
        id TEXT PRIMARY KEY, policy_version TEXT NOT NULL UNIQUE, policy_json TEXT NOT NULL,
        policy_sha256 TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT
    );
    CREATE TABLE IF NOT EXISTS production_witness_policy_changes(
        id TEXT PRIMARY KEY, policy_version TEXT NOT NULL, action TEXT NOT NULL,
        witness_id TEXT, policy_sha256 TEXT NOT NULL, change_json TEXT NOT NULL,
        created_at TEXT NOT NULL, operator TEXT
    );
    CREATE INDEX IF NOT EXISTS idx_witness_policy_changes_witness ON production_witness_policy_changes(witness_id,created_at);
    """)

_V177_DEFAULT_POLICY={
    'schema_version':'1.77','format':'wunoo.release.witness.trust.policy.v1','policy_version':'1.77-default',
    'allowed_witness_statuses':['ACTIVE'],'max_key_age_days':365,'min_key_age_days':0,
    'require_registered_system':True,'allowed_witness_systems':[],
    'suspension_is_untrusted':True,'revocation_is_untrusted':True,'fail_closed':True,'no_automatic_release':True
}

def _v177_policy_hash(policy):
    return hashlib.sha256(json.dumps(policy,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()).hexdigest()

def _v177_get_policy(c):
    row=_v170_row(c,'production_witness_trust_policies',order='created_at DESC')
    if not row: return dict(_V177_DEFAULT_POLICY)
    try: return json.loads(row['policy_json'])
    except Exception: return dict(_V177_DEFAULT_POLICY)

def _v177_parse_time(value):
    try:
        return datetime.fromisoformat(str(value).replace('Z','+00:00'))
    except Exception:
        return None

def _v177_evaluate(c,witness_id,policy=None):
    policy=policy or _v177_get_policy(c); row=_v176_registry_row(c,witness_id)
    if not row: return {'valid':False,'reason':'WITNESS_NOT_REGISTERED','witness_id':witness_id}
    reasons=[]; status=str(row['status'] or '')
    if status not in set(policy.get('allowed_witness_statuses') or ['ACTIVE']): reasons.append('WITNESS_STATUS_NOT_ALLOWED')
    system=str(row['witness_system'] or '')
    allowed=policy.get('allowed_witness_systems') or []
    if policy.get('require_registered_system') and allowed and system not in allowed: reasons.append('WITNESS_SYSTEM_NOT_ALLOWED')
    registered=_v177_parse_time(row['registered_at']); now_dt=datetime.now(timezone.utc)
    age_days=None
    if registered:
        if registered.tzinfo is None: registered=registered.replace(tzinfo=timezone.utc)
        age_days=max(0,(now_dt-registered).total_seconds()/86400.0)
        if age_days < float(policy.get('min_key_age_days',0)): reasons.append('WITNESS_KEY_TOO_NEW')
        if age_days > float(policy.get('max_key_age_days',365)): reasons.append('WITNESS_KEY_TOO_OLD')
    else: reasons.append('WITNESS_REGISTRATION_TIME_INVALID')
    if not row['current_key_id'] or not row['current_public_key_b64']: reasons.append('WITNESS_CURRENT_KEY_INVALID')
    return {'valid':not reasons,'reason':'WITNESS_TRUST_POLICY_SATISFIED' if not reasons else reasons[0],
            'witness_id':witness_id,'witness_system':system,'status':status,'current_key_id':row['current_key_id'],
            'key_age_days':round(age_days,6) if age_days is not None else None,'policy_version':policy.get('policy_version'),'reasons':reasons}

@app.get('/api/v177/ops/witness-governance/policy')
def v177_policy(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        p=_v177_get_policy(c); return {'schema_version':'1.77','policy':p,'policy_sha256':_v177_policy_hash(p)}

@app.post('/api/v177/ops/witness-governance/policy')
def v177_set_policy(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin'}); p=dict(_V177_DEFAULT_POLICY); incoming=payload or {}
    for k in ('allowed_witness_statuses','max_key_age_days','min_key_age_days','require_registered_system','allowed_witness_systems'):
        if k in incoming: p[k]=incoming[k]
    p['schema_version']='1.77'; p['format']='wunoo.release.witness.trust.policy.v1'; p['policy_version']=str(incoming.get('policy_version') or '1.77-'+uuid.uuid4().hex[:12])
    if float(p['min_key_age_days'])<0 or float(p['max_key_age_days'])<float(p['min_key_age_days']): raise HTTPException(400,'INVALID_KEY_AGE_POLICY')
    if not isinstance(p['allowed_witness_statuses'],list) or not p['allowed_witness_statuses']: raise HTTPException(400,'INVALID_ALLOWED_STATUSES')
    if not isinstance(p['allowed_witness_systems'],list): raise HTTPException(400,'INVALID_ALLOWED_WITNESS_SYSTEMS')
    digest=_v177_policy_hash(p); t=now(); operator=str(u.get('email') or u.get('id') or 'operator')
    with core_db_connect() as c:
        existing=_v170_row(c,'production_witness_trust_policies',' WHERE policy_version=?',(p['policy_version'],),'created_at DESC')
        if existing and existing['policy_sha256']==digest: return {'idempotent':True,'policy':p,'policy_sha256':digest}
        c.execute("UPDATE production_witness_trust_policies SET status='RETIRED' WHERE status='ACTIVE'")
        c.execute('INSERT INTO production_witness_trust_policies(id,policy_version,policy_json,policy_sha256,status,created_at,operator) VALUES(?,?,?,?,?,?,?)',('wp_'+uuid.uuid4().hex[:16],p['policy_version'],json.dumps(p,sort_keys=True,separators=(',',':'),ensure_ascii=False),digest,'ACTIVE',t,operator))
        c.execute('INSERT INTO production_witness_policy_changes(id,policy_version,action,witness_id,policy_sha256,change_json,created_at,operator) VALUES(?,?,?,?,?,?,?,?)',('wpc_'+uuid.uuid4().hex[:16],p['policy_version'],'POLICY_SET',None,digest,json.dumps(p,sort_keys=True,separators=(',',':'),ensure_ascii=False),t,operator)); c.commit()
    return {'idempotent':False,'policy':p,'policy_sha256':digest}

@app.post('/api/v177/ops/witness-governance/evaluate')
def v177_evaluate(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); wid=str((payload or {}).get('witness_id') or '').strip()
    if not wid: raise HTTPException(400,'witness_id required')
    with core_db_connect() as c: return {'schema_version':'1.77','evaluation':_v177_evaluate(c,wid)}

def _v177_set_status(wid,action,desired,u):
    with core_db_connect() as c:
        row=_v176_registry_row(c,wid)
        if not row: raise HTTPException(404,'WITNESS_NOT_REGISTERED')
        if row['status']==desired: return {'idempotent':True,'witness_id':wid,'status':desired}
        if desired=='SUSPENDED' and row['status']=='REVOKED': raise HTTPException(409,'WITNESS_REVOKED')
        t=now(); p=_v177_get_policy(c); digest=_v177_policy_hash(p); operator=str(u.get('email') or u.get('id') or 'operator')
        c.execute('UPDATE production_external_witness_registry SET status=?,updated_at=? WHERE witness_id=?',(desired,t,wid))
        c.execute("UPDATE production_external_witness_key_history SET status=? WHERE witness_id=? AND status IN ('ACTIVE','SUSPENDED')",(desired,wid))
        change={'schema_version':'1.77','action':action,'witness_id':wid,'from_status':row['status'],'to_status':desired,'policy_sha256':digest}
        c.execute('INSERT INTO production_witness_policy_changes(id,policy_version,action,witness_id,policy_sha256,change_json,created_at,operator) VALUES(?,?,?,?,?,?,?,?)',('wpc_'+uuid.uuid4().hex[:16],p.get('policy_version','1.77-default'),action,wid,digest,json.dumps(change,sort_keys=True,separators=(',',':'),ensure_ascii=False),t,operator)); c.commit()
        return {'idempotent':False,'witness_id':wid,'status':desired,'policy_sha256':digest}

@app.post('/api/v177/ops/witness-governance/suspend')
def v177_suspend(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); wid=str((payload or {}).get('witness_id') or '').strip()
    if not wid: raise HTTPException(400,'witness_id required')
    return _v177_set_status(wid,'WITNESS_SUSPEND','SUSPENDED',u)

@app.post('/api/v177/ops/witness-governance/unsuspend')
def v177_unsuspend(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); wid=str((payload or {}).get('witness_id') or '').strip()
    if not wid: raise HTTPException(400,'witness_id required')
    return _v177_set_status(wid,'WITNESS_UNSUSPEND','ACTIVE',u)

@app.get('/api/v177/ops/witness-governance/history/{witness_id}')
def v177_history(witness_id: str,authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        rows=c.execute('SELECT * FROM production_witness_policy_changes WHERE witness_id=? ORDER BY created_at ASC,id ASC',(witness_id,)).fetchall()
        return {'schema_version':'1.77','witness_id':witness_id,'changes':[dict(x) for x in rows]}


# ---------------- WUNOO v1.78: Witness Policy Consensus & Governance Ledger ----------------
def migrate_v178(c):
    c.executescript("""CREATE TABLE IF NOT EXISTS production_witness_policy_proposals(
        id TEXT PRIMARY KEY, policy_version TEXT NOT NULL UNIQUE, policy_json TEXT NOT NULL,
        policy_sha256 TEXT NOT NULL, required_approvals INTEGER NOT NULL,
        status TEXT NOT NULL, created_at TEXT NOT NULL, finalized_at TEXT, operator TEXT
    );
    CREATE TABLE IF NOT EXISTS production_witness_policy_approvals(
        id TEXT PRIMARY KEY, proposal_id TEXT NOT NULL, policy_version TEXT NOT NULL,
        policy_sha256 TEXT NOT NULL, approver_witness_id TEXT NOT NULL, approver_key_id TEXT NOT NULL,
        public_key_b64 TEXT NOT NULL, signature_b64 TEXT NOT NULL, approval_json TEXT NOT NULL,
        approval_sha256 TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT,
        UNIQUE(proposal_id,approver_witness_id)
    );
    CREATE TABLE IF NOT EXISTS production_witness_governance_ledger(
        id TEXT PRIMARY KEY, sequence_no INTEGER NOT NULL UNIQUE, policy_version TEXT,
        action TEXT NOT NULL, witness_id TEXT, previous_entry_sha256 TEXT NOT NULL,
        entry_sha256 TEXT NOT NULL UNIQUE, entry_json TEXT NOT NULL, status TEXT NOT NULL,
        created_at TEXT NOT NULL, operator TEXT
    );
    CREATE INDEX IF NOT EXISTS idx_witness_policy_proposals_status ON production_witness_policy_proposals(status,created_at);
    CREATE INDEX IF NOT EXISTS idx_witness_policy_approvals_proposal ON production_witness_policy_approvals(proposal_id,created_at);
    CREATE INDEX IF NOT EXISTS idx_witness_governance_ledger_policy ON production_witness_governance_ledger(policy_version,sequence_no);
    """)

_V178_POLICY={
    'schema_version':'1.78','ledger_format':'wunoo.release.witness.governance.entry.v1',
    'approval_format':'wunoo.release.witness.policy.approval.v1',
    'consensus_format':'wunoo.release.witness.policy.consensus.v1','algorithm':'Ed25519',
    'hash':'SHA-256','default_quorum':2,'distinct_approvers_required':True,
    'approvers_must_be_registered_and_trusted':True,'append_only_ledger':True,
    'fail_closed':True,'no_automatic_release':True
}

def _v178_hash(value):
    return hashlib.sha256(json.dumps(value,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()).hexdigest()

def _v178_zero(): return '0'*64

def _v178_quorum(value=None):
    raw=value if value is not None else os.getenv('WUNOO_POLICY_CONSENSUS_QUORUM','2')
    try: q=int(raw)
    except Exception: q=2
    if q<1 or q>100: raise HTTPException(400,'INVALID_POLICY_CONSENSUS_QUORUM')
    return q

def _v178_json(value): return json.dumps(value,sort_keys=True,separators=(',',':'),ensure_ascii=False)

def _v178_ledger_payload(sequence_no,policy_version,action,witness_id,previous_entry_sha256,created_at,details):
    return {'format':_V178_POLICY['ledger_format'],'schema_version':'1.78','sequence_no':sequence_no,
            'policy_version':policy_version,'action':action,'witness_id':witness_id,
            'previous_entry_sha256':previous_entry_sha256,'created_at':created_at,'details':details}

def _v178_append_ledger(c,policy_version,action,witness_id,details,operator,status='RECORDED'):
    last=_v170_row(c,'production_witness_governance_ledger',order='sequence_no DESC')
    seq=int(last['sequence_no'])+1 if last else 1
    prev=str(last['entry_sha256']) if last else _v178_zero()
    t=now(); payload=_v178_ledger_payload(seq,policy_version,action,witness_id,prev,t,details); digest=_v178_hash(payload)
    existing=_v170_row(c,'production_witness_governance_ledger',' WHERE entry_sha256=?',(digest,),'created_at DESC')
    if existing: return dict(existing),True
    lid='wgl_'+uuid.uuid4().hex[:16]
    c.execute('INSERT INTO production_witness_governance_ledger(id,sequence_no,policy_version,action,witness_id,previous_entry_sha256,entry_sha256,entry_json,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?)',
              (lid,seq,policy_version,action,witness_id,prev,digest,_v178_json(payload),status,t,operator))
    return {'id':lid,'sequence_no':seq,'entry_sha256':digest,'previous_entry_sha256':prev,'entry_json':_v178_json(payload),'status':status},False

def _v178_verify_ledger(c):
    rows=c.execute('SELECT * FROM production_witness_governance_ledger ORDER BY sequence_no ASC,id ASC').fetchall()
    previous=_v178_zero(); expected=1
    for row in rows:
        if int(row['sequence_no'])!=expected: return {'valid':False,'reason':'GOVERNANCE_LEDGER_SEQUENCE_INVALID','sequence_no':row['sequence_no']}
        if row['previous_entry_sha256']!=previous: return {'valid':False,'reason':'GOVERNANCE_LEDGER_PREVIOUS_HASH_INVALID','sequence_no':row['sequence_no']}
        try: payload=json.loads(row['entry_json'] or '{}')
        except Exception: return {'valid':False,'reason':'GOVERNANCE_LEDGER_JSON_INVALID','sequence_no':row['sequence_no']}
        if _v178_hash(payload)!=row['entry_sha256']: return {'valid':False,'reason':'GOVERNANCE_LEDGER_ENTRY_HASH_INVALID','sequence_no':row['sequence_no']}
        for k in ('format','schema_version','sequence_no','policy_version','action','witness_id','previous_entry_sha256','created_at','details'):
            if k not in payload: return {'valid':False,'reason':'GOVERNANCE_LEDGER_PAYLOAD_INVALID','sequence_no':row['sequence_no']}
        if payload['sequence_no']!=row['sequence_no'] or payload['previous_entry_sha256']!=row['previous_entry_sha256'] or payload['policy_version']!=row['policy_version'] or payload['action']!=row['action'] or payload['witness_id']!=row['witness_id']:
            return {'valid':False,'reason':'GOVERNANCE_LEDGER_BINDING_INVALID','sequence_no':row['sequence_no']}
        previous=row['entry_sha256']; expected+=1
    return {'valid':True,'reason':'GOVERNANCE_LEDGER_VERIFIED','entries_count':len(rows),'head_sha256':previous if rows else _v178_zero()}

def _v178_approval_payload(proposal_id,policy_version,policy_sha256,approver_witness_id,approver_key_id):
    return {'format':_V178_POLICY['approval_format'],'schema_version':'1.78','proposal_id':proposal_id,
            'policy_version':policy_version,'policy_sha256':policy_sha256,'approver_witness_id':approver_witness_id,
            'approver_key_id':approver_key_id}

def _v178_verify_approval(c,row,proposal):
    try:
        approval=json.loads(row['approval_json'] or '{}')
        if approval!=_v178_approval_payload(proposal['id'],proposal['policy_version'],proposal['policy_sha256'],row['approver_witness_id'],row['approver_key_id']):
            return {'valid':False,'reason':'POLICY_APPROVAL_PAYLOAD_INVALID'}
        if _v178_hash(approval)!=row['approval_sha256']: return {'valid':False,'reason':'POLICY_APPROVAL_HASH_INVALID'}
        pub=base64.b64decode(row['public_key_b64'],validate=True); sig=base64.b64decode(row['signature_b64'],validate=True)
        if len(pub)!=32: return {'valid':False,'reason':'POLICY_APPROVER_PUBLIC_KEY_INVALID'}
        if _v176_key_id(pub)!=row['approver_key_id']: return {'valid':False,'reason':'POLICY_APPROVER_KEY_ID_INVALID'}
        reg=_v176_registry_row(c,row['approver_witness_id'])
        if not reg: return {'valid':False,'reason':'WITNESS_NOT_REGISTERED'}
        if reg['status']!='ACTIVE': return {'valid':False,'reason':'WITNESS_NOT_ACTIVE'}
        if reg['current_key_id']!=row['approver_key_id'] or reg['current_public_key_b64']!=row['public_key_b64']:
            return {'valid':False,'reason':'POLICY_APPROVER_KEY_NOT_CURRENT'}
        trust=_v177_evaluate(c,row['approver_witness_id'])
        if not trust['valid']: return {'valid':False,'reason':trust['reason']}
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto()
        Ed25519PublicKey.from_public_bytes(pub).verify(sig,_v178_json(approval).encode())
        return {'valid':True,'reason':'POLICY_APPROVAL_VERIFIED','approver_witness_id':row['approver_witness_id'],'key_id':row['approver_key_id']}
    except Exception:
        return {'valid':False,'reason':'POLICY_APPROVAL_SIGNATURE_INVALID'}

def _v178_consensus(c,proposal):
    rows=c.execute('SELECT * FROM production_witness_policy_approvals WHERE proposal_id=? ORDER BY approver_witness_id ASC,approval_sha256 ASC',(proposal['id'],)).fetchall()
    verified=[]; invalid=[]; seen=set()
    for row in rows:
        vr=_v178_verify_approval(c,row,proposal)
        if vr['valid'] and row['approver_witness_id'] not in seen:
            seen.add(row['approver_witness_id']); verified.append((row,vr))
        else: invalid.append({'approval_id':row['id'],'reason':vr['reason']})
    q=int(proposal['required_approvals'])
    approvers=[r['approver_witness_id'] for r,_ in verified]
    hashes=[r['approval_sha256'] for r,_ in verified]
    return {'valid':len(verified)>=q,'reason':'POLICY_CONSENSUS_REACHED' if len(verified)>=q else 'POLICY_CONSENSUS_NOT_REACHED',
            'required_approvals':q,'approval_count':len(verified),'approver_ids':approvers,'approval_hashes':hashes,'invalid_approvals':invalid}

def _v178_activate_policy(c,proposal,u,consensus):
    p=json.loads(proposal['policy_json'] or '{}'); digest=proposal['policy_sha256']; operator=str(u.get('email') or u.get('id') or 'operator'); t=now()
    existing=_v170_row(c,'production_witness_trust_policies',' WHERE policy_version=?',(proposal['policy_version'],),'created_at DESC')
    if existing:
        if existing['policy_sha256']!=digest or existing['status']!='ACTIVE': raise HTTPException(409,'POLICY_VERSION_CONFLICT')
        return existing,True
    c.execute("UPDATE production_witness_trust_policies SET status='RETIRED' WHERE status='ACTIVE'")
    pid='wp_'+uuid.uuid4().hex[:16]
    c.execute('INSERT INTO production_witness_trust_policies(id,policy_version,policy_json,policy_sha256,status,created_at,operator) VALUES(?,?,?,?,?,?,?)',(pid,proposal['policy_version'],proposal['policy_json'],digest,'ACTIVE',t,operator))
    change={'schema_version':'1.78','action':'POLICY_CONSENSUS_ACTIVATED','proposal_id':proposal['id'],'policy_version':proposal['policy_version'],'policy_sha256':digest,'consensus':consensus}
    c.execute('INSERT INTO production_witness_policy_changes(id,policy_version,action,witness_id,policy_sha256,change_json,created_at,operator) VALUES(?,?,?,?,?,?,?,?)',('wpc_'+uuid.uuid4().hex[:16],proposal['policy_version'],'POLICY_CONSENSUS_ACTIVATED',None,digest,_v178_json(change),t,operator))
    c.execute("UPDATE production_witness_policy_proposals SET status='ACTIVATED',finalized_at=? WHERE id=?",(t,proposal['id']))
    ledger,_=_v178_append_ledger(c,proposal['policy_version'],'POLICY_ACTIVATED',None,{'proposal_id':proposal['id'],'policy_sha256':digest,'consensus':consensus},operator,'ACTIVATED')
    c.commit()
    return _v170_row(c,'production_witness_trust_policies',' WHERE id=?',(pid,),'created_at DESC'),False

@app.get('/api/v178/ops/witness-governance/policy')
def v178_policy(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); return _V178_POLICY

@app.get('/api/v178/ops/witness-governance/ledger/verify')
def v178_ledger_verify(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c: return {'schema_version':'1.78','verification':_v178_verify_ledger(c)}

@app.get('/api/v178/ops/witness-governance/ledger/latest')
def v178_ledger_latest(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        row=_v170_row(c,'production_witness_governance_ledger',order='sequence_no DESC')
        return {'schema_version':'1.78','entry':dict(row) if row else None,'verification':_v178_verify_ledger(c)}

@app.post('/api/v178/ops/witness-governance/propose')
def v178_propose(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin'}); incoming=payload or {}
    p=dict(_V177_DEFAULT_POLICY)
    for k in ('allowed_witness_statuses','max_key_age_days','min_key_age_days','require_registered_system','allowed_witness_systems'):
        if k in incoming: p[k]=incoming[k]
    p['schema_version']='1.77'; p['format']='wunoo.release.witness.trust.policy.v1'; p['policy_version']=str(incoming.get('policy_version') or '1.78-'+uuid.uuid4().hex[:12])
    if float(p['min_key_age_days'])<0 or float(p['max_key_age_days'])<float(p['min_key_age_days']): raise HTTPException(400,'INVALID_KEY_AGE_POLICY')
    if not isinstance(p['allowed_witness_statuses'],list) or not p['allowed_witness_statuses']: raise HTTPException(400,'INVALID_ALLOWED_STATUSES')
    if not isinstance(p['allowed_witness_systems'],list): raise HTTPException(400,'INVALID_ALLOWED_WITNESS_SYSTEMS')
    q=_v178_quorum(incoming.get('required_approvals')); digest=_v177_policy_hash(p); t=now(); operator=str(u.get('email') or u.get('id') or 'operator')
    with core_db_connect() as c:
        existing=_v170_row(c,'production_witness_policy_proposals',' WHERE policy_version=?',(p['policy_version'],),'created_at DESC')
        if existing:
            if existing['policy_sha256']!=digest or int(existing['required_approvals'])!=q: raise HTTPException(409,'POLICY_PROPOSAL_CONFLICT')
            return {'schema_version':'1.78','idempotent':True,'proposal_id':existing['id'],'policy':p,'policy_sha256':digest,'required_approvals':q,'status':existing['status']}
        pid='wpp_'+uuid.uuid4().hex[:16]
        c.execute('INSERT INTO production_witness_policy_proposals(id,policy_version,policy_json,policy_sha256,required_approvals,status,created_at,finalized_at,operator) VALUES(?,?,?,?,?,?,?,?,?)',(pid,p['policy_version'],_v178_json(p),digest,q,'PROPOSED',t,None,operator))
        ledger,_=_v178_append_ledger(c,p['policy_version'],'POLICY_PROPOSED',None,{'proposal_id':pid,'policy_sha256':digest,'required_approvals':q},operator)
        c.commit()
        return {'schema_version':'1.78','idempotent':False,'proposal_id':pid,'policy':p,'policy_sha256':digest,'required_approvals':q,'status':'PROPOSED','ledger_entry':ledger}

@app.post('/api/v178/ops/witness-governance/approve')
def v178_approve(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); p=payload or {}; proposal_id=str(p.get('proposal_id') or '').strip(); wid=str(p.get('approver_witness_id') or '').strip(); pub=str(p.get('public_key_b64') or '').strip(); sig=str(p.get('signature_b64') or '').strip()
    if not proposal_id or not wid or not pub or not sig: raise HTTPException(400,'proposal_id,approver_witness_id,public_key_b64,signature_b64 required')
    with core_db_connect() as c:
        proposal=_v170_row(c,'production_witness_policy_proposals',' WHERE id=?',(proposal_id,),'created_at DESC')
        if not proposal: raise HTTPException(404,'POLICY_PROPOSAL_NOT_FOUND')
        if proposal['status'] in {'ACTIVATED','REJECTED'}: raise HTTPException(409,'POLICY_PROPOSAL_CLOSED')
        try: keyid=_v176_key_id(base64.b64decode(pub,validate=True))
        except Exception: raise HTTPException(400,'POLICY_APPROVER_PUBLIC_KEY_INVALID')
        approval=_v178_approval_payload(proposal['id'],proposal['policy_version'],proposal['policy_sha256'],wid,keyid); digest=_v178_hash(approval)
        existing=_v170_row(c,'production_witness_policy_approvals',' WHERE proposal_id=? AND approver_witness_id=?',(proposal_id,wid),'created_at DESC')
        if existing:
            if existing['approval_sha256']==digest and existing['signature_b64']==sig and existing['public_key_b64']==pub: return {'schema_version':'1.78','idempotent':True,'approval_id':existing['id'],'approval_sha256':digest,'verification':_v178_verify_approval(c,existing,proposal)}
            raise HTTPException(409,'POLICY_APPROVAL_ALREADY_EXISTS')
        temp={'id':'','proposal_id':proposal_id,'policy_version':proposal['policy_version'],'policy_sha256':proposal['policy_sha256'],'approver_witness_id':wid,'approver_key_id':keyid,'public_key_b64':pub,'signature_b64':sig,'approval_json':_v178_json(approval),'approval_sha256':digest,'status':'RECORDED'}
        # Verify before persistence so malformed or stale witness approvals never enter the ledger.
        vr=_v178_verify_approval(c,temp,proposal)
        if not vr['valid']: raise HTTPException(409,vr['reason'])
        aid='wpa_'+uuid.uuid4().hex[:16]; t=now(); operator=str(u.get('email') or u.get('id') or 'operator')
        c.execute('INSERT INTO production_witness_policy_approvals(id,proposal_id,policy_version,policy_sha256,approver_witness_id,approver_key_id,public_key_b64,signature_b64,approval_json,approval_sha256,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?)',(aid,proposal_id,proposal['policy_version'],proposal['policy_sha256'],wid,keyid,pub,sig,_v178_json(approval),digest,'VERIFIED',t,operator))
        consensus=_v178_consensus(c,proposal)
        ledger,_=_v178_append_ledger(c,proposal['policy_version'],'POLICY_APPROVED',wid,{'proposal_id':proposal_id,'approval_id':aid,'approval_sha256':digest,'consensus':consensus},operator)
        if consensus['valid'] and proposal['status']=='PROPOSED':
            c.execute("UPDATE production_witness_policy_proposals SET status='CONSENSUS_REACHED' WHERE id=?",(proposal_id,))
        c.commit()
        return {'schema_version':'1.78','idempotent':False,'approval_id':aid,'approval_sha256':digest,'verification':vr,'consensus':consensus,'ledger_entry':ledger}

@app.post('/api/v178/ops/witness-governance/finalize')
def v178_finalize(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin'}); p=payload or {}; proposal_id=str(p.get('proposal_id') or '').strip()
    if not proposal_id: raise HTTPException(400,'proposal_id required')
    with core_db_connect() as c:
        proposal=_v170_row(c,'production_witness_policy_proposals',' WHERE id=?',(proposal_id,),'created_at DESC')
        if not proposal: raise HTTPException(404,'POLICY_PROPOSAL_NOT_FOUND')
        if proposal['status']=='ACTIVATED':
            policy=_v170_row(c,'production_witness_trust_policies',' WHERE policy_version=?',(proposal['policy_version'],),'created_at DESC')
            return {'schema_version':'1.78','idempotent':True,'proposal_id':proposal_id,'status':'ACTIVATED','policy':dict(policy) if policy else None,'consensus':_v178_consensus(c,proposal),'ledger_verification':_v178_verify_ledger(c)}
        consensus=_v178_consensus(c,proposal)
        if not consensus['valid']: raise HTTPException(409,consensus['reason'])
        operator=str(u.get('email') or u.get('id') or 'operator')
        _v178_activate_policy(c,proposal,u,consensus)
        row=_v170_row(c,'production_witness_trust_policies',' WHERE policy_version=?',(proposal['policy_version'],),'created_at DESC')
        return {'schema_version':'1.78','idempotent':False,'proposal_id':proposal_id,'status':'ACTIVATED','policy':dict(row),'consensus':consensus,'ledger_verification':_v178_verify_ledger(c)}

@app.get('/api/v178/ops/witness-governance/proposals/{proposal_id}')
def v178_proposal(proposal_id: str,authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        row=_v170_row(c,'production_witness_policy_proposals',' WHERE id=?',(proposal_id,),'created_at DESC')
        if not row: raise HTTPException(404,'POLICY_PROPOSAL_NOT_FOUND')
        approvals=[dict(x) for x in c.execute('SELECT id,proposal_id,policy_version,policy_sha256,approver_witness_id,approver_key_id,approval_sha256,status,created_at,operator FROM production_witness_policy_approvals WHERE proposal_id=? ORDER BY created_at ASC,id ASC',(proposal_id,)).fetchall()]
        return {'schema_version':'1.78','proposal':dict(row),'approvals':approvals,'consensus':_v178_consensus(c,row)}


# ---------------- WUNOO v1.76: Independent Witness Registry & Key Lifecycle ----------------
def migrate_v176(c):
    c.executescript("""CREATE TABLE IF NOT EXISTS production_external_witness_registry(
        id TEXT PRIMARY KEY, witness_id TEXT NOT NULL UNIQUE, witness_system TEXT NOT NULL,
        status TEXT NOT NULL, current_key_id TEXT NOT NULL, current_public_key_b64 TEXT NOT NULL,
        registered_at TEXT NOT NULL, updated_at TEXT NOT NULL, operator TEXT
    );
    CREATE TABLE IF NOT EXISTS production_external_witness_key_history(
        id TEXT PRIMARY KEY, witness_id TEXT NOT NULL, key_id TEXT NOT NULL,
        public_key_b64 TEXT NOT NULL, status TEXT NOT NULL, valid_from TEXT NOT NULL,
        valid_until TEXT, predecessor_key_id TEXT, transition_sha256 TEXT NOT NULL,
        created_at TEXT NOT NULL, operator TEXT,
        UNIQUE(witness_id,key_id)
    );
    CREATE INDEX IF NOT EXISTS idx_witness_registry_status ON production_external_witness_registry(status);
    CREATE INDEX IF NOT EXISTS idx_witness_key_history_witness ON production_external_witness_key_history(witness_id,valid_from);
    """)

_V176_POLICY={
    'schema_version':'1.76','format':'wunoo.release.witness.registry.v1','algorithm':'Ed25519',
    'hash':'SHA-256','statuses':['ACTIVE','REVOKED','SUSPENDED'],
    'fail_closed':True,'key_rotation_requires_predecessor':True,
    'receipt_verification_requires_active_or_historically_valid_key':True,
    'no_automatic_release':True
}

def _v176_key_id(pub_bytes): return hashlib.sha256(pub_bytes).hexdigest()[:32]
def _v176_transition_hash(payload): return hashlib.sha256(json.dumps(payload,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()).hexdigest()
def _v176_registry_row(c,witness_id): return _v170_row(c,'production_external_witness_registry',' WHERE witness_id=?',(witness_id,),'updated_at DESC')
def _v176_history(c,witness_id,key_id=None):
    if key_id:
        return _v170_row(c,'production_external_witness_key_history',' WHERE witness_id=? AND key_id=?',(witness_id,key_id),'valid_from DESC')
    return c.execute('SELECT * FROM production_external_witness_key_history WHERE witness_id=? ORDER BY valid_from ASC,id ASC',(witness_id,)).fetchall()
def _v176_validate_key(public_key_b64):
    raw=base64.b64decode(public_key_b64,validate=True)
    if len(raw)!=32: raise ValueError('WITNESS_PUBLIC_KEY_INVALID')
    return _v176_key_id(raw)

def _v176_register(c,p,u):
    wid=str(p.get('witness_id') or '').strip(); system=str(p.get('witness_system') or '').strip(); pub=str(p.get('public_key_b64') or '').strip()
    if not wid or not system or not pub: raise HTTPException(400,'witness_id,witness_system,public_key_b64 required')
    keyid=_v176_validate_key(pub); t=now(); existing=_v176_registry_row(c,wid)
    if existing:
        if existing['status']=='REVOKED': raise HTTPException(409,'WITNESS_REVOKED')
        if existing['current_key_id']==keyid and existing['current_public_key_b64']==pub: return {'idempotent':True,'witness_id':wid,'key_id':keyid,'status':existing['status']}
        raise HTTPException(409,'WITNESS_ALREADY_REGISTERED_USE_ROTATE')
    trans={'schema_version':'1.76','action':'REGISTER','witness_id':wid,'witness_system':system,'key_id':keyid,'public_key_b64':pub,'predecessor_key_id':None,'valid_from':t}
    digest=_v176_transition_hash(trans); rid='wit_'+uuid.uuid4().hex[:16]; hid='wkey_'+uuid.uuid4().hex[:16]
    c.execute('INSERT INTO production_external_witness_registry(id,witness_id,witness_system,status,current_key_id,current_public_key_b64,registered_at,updated_at,operator) VALUES(?,?,?,?,?,?,?,?,?)',(rid,wid,system,'ACTIVE',keyid,pub,t,t,str(u.get('email') or u.get('id') or 'operator')))
    c.execute('INSERT INTO production_external_witness_key_history(id,witness_id,key_id,public_key_b64,status,valid_from,valid_until,predecessor_key_id,transition_sha256,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?)',(hid,wid,keyid,pub,'ACTIVE',t,None,None,digest,t,str(u.get('email') or u.get('id') or 'operator'))); c.commit()
    return {'idempotent':False,'witness_id':wid,'key_id':keyid,'status':'ACTIVE','transition_sha256':digest}

@app.get('/api/v176/ops/witness-registry/policy')
def v176_policy(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); return _V176_POLICY

@app.post('/api/v176/ops/witness-registry/register')
def v176_register(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); payload=payload or {}
    with core_db_connect() as c: return _v176_register(c,payload,u)

@app.post('/api/v176/ops/witness-registry/rotate')
def v176_rotate(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); p=payload or {}; wid=str(p.get('witness_id') or '').strip(); pub=str(p.get('new_public_key_b64') or '').strip()
    if not wid or not pub: raise HTTPException(400,'witness_id,new_public_key_b64 required')
    with core_db_connect() as c:
        row=_v176_registry_row(c,wid)
        if not row: raise HTTPException(404,'WITNESS_NOT_REGISTERED')
        if row['status']=='REVOKED': raise HTTPException(409,'WITNESS_REVOKED')
        newkid=_v176_validate_key(pub); oldkid=row['current_key_id']
        if newkid==oldkid: return {'idempotent':True,'witness_id':wid,'key_id':newkid,'status':row['status']}
        t=now(); trans={'schema_version':'1.76','action':'ROTATE','witness_id':wid,'witness_system':row['witness_system'],'key_id':newkid,'public_key_b64':pub,'predecessor_key_id':oldkid,'valid_from':t}; digest=_v176_transition_hash(trans)
        c.execute('UPDATE production_external_witness_key_history SET status=\'RETIRED\',valid_until=? WHERE witness_id=? AND key_id=?',(t,wid,oldkid))
        c.execute('UPDATE production_external_witness_registry SET current_key_id=?,current_public_key_b64=?,updated_at=? WHERE witness_id=?',(newkid,pub,t,wid))
        c.execute('INSERT INTO production_external_witness_key_history(id,witness_id,key_id,public_key_b64,status,valid_from,valid_until,predecessor_key_id,transition_sha256,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?)',('wkey_'+uuid.uuid4().hex[:16],wid,newkid,pub,'ACTIVE',t,None,oldkid,digest,t,str(u.get('email') or u.get('id') or 'operator'))); c.commit()
        return {'idempotent':False,'witness_id':wid,'old_key_id':oldkid,'key_id':newkid,'status':'ACTIVE','transition_sha256':digest}

@app.post('/api/v176/ops/witness-registry/revoke')
def v176_revoke(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); p=payload or {}; wid=str(p.get('witness_id') or '').strip()
    if not wid: raise HTTPException(400,'witness_id required')
    with core_db_connect() as c:
        row=_v176_registry_row(c,wid)
        if not row: raise HTTPException(404,'WITNESS_NOT_REGISTERED')
        if row['status']=='REVOKED': return {'idempotent':True,'witness_id':wid,'status':'REVOKED'}
        t=now(); c.execute('UPDATE production_external_witness_registry SET status=\'REVOKED\',updated_at=? WHERE witness_id=?',(t,wid)); c.execute('UPDATE production_external_witness_key_history SET status=\'REVOKED\',valid_until=? WHERE witness_id=? AND status=\'ACTIVE\'',(t,wid)); c.commit(); return {'idempotent':False,'witness_id':wid,'status':'REVOKED'}

def _v176_receipt_key_check(c,receipt):
    wid=receipt.get('witness_id'); pub=receipt.get('public_key_b64'); kid=_v176_validate_key(pub); row=_v176_registry_row(c,wid)
    if not row: return {'valid':False,'reason':'WITNESS_NOT_REGISTERED'}
    if row['status'] in {'REVOKED','SUSPENDED'}: return {'valid':False,'reason':'WITNESS_NOT_ACTIVE'}
    hist=_v176_history(c,wid,kid)
    if not hist: return {'valid':False,'reason':'WITNESS_KEY_UNKNOWN'}
    if hist['status'] in {'REVOKED','SUSPENDED'}: return {'valid':False,'reason':'WITNESS_KEY_NOT_TRUSTED'}
    return {'valid':True,'reason':'WITNESS_KEY_LIFECYCLE_VERIFIED','key_id':kid}

@app.post('/api/v176/ops/witness-registry/verify-receipt')
def v176_verify_receipt(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); p=payload or {}
    with core_db_connect() as c:
        row=_v170_row(c,'production_release_external_witness_receipts',' WHERE id=?',(p.get('receipt_id'),),'created_at DESC') if p.get('receipt_id') else _v170_row(c,'production_release_external_witness_receipts',order='created_at DESC')
        if not row: raise HTTPException(404,'WITNESS_RECEIPT_NOT_FOUND')
        receipt=json.loads(row['receipt_json'] or '{}'); ck=_v176_receipt_key_check(c,receipt)
        if not ck['valid']: raise HTTPException(409,ck['reason'])
        try:
            _,Ed25519PublicKey,_,_,_,_=_v169_crypto(); signed={k:receipt[k] for k in ('checkpoint_sha256','witness_id','witness_system','witnessed_at')}; Ed25519PublicKey.from_public_bytes(base64.b64decode(receipt['public_key_b64'])).verify(base64.b64decode(receipt['signature_b64']),json.dumps({'format':'wunoo.release.external.witness.receipt.v1','schema_version':'1.74',**signed},sort_keys=True,separators=(',',':'),ensure_ascii=False).encode())
        except Exception: raise HTTPException(409,'WITNESS_RECEIPT_SIGNATURE_INVALID')
        return {'schema_version':'1.76','verification':{'valid':True,'reason':'WITNESS_RECEIPT_LIFECYCLE_VERIFIED','witness_id':row['witness_id'],'key_id':ck['key_id'],'receipt_id':row['id']}}

@app.get('/api/v176/ops/witness-registry/{witness_id}')
def v176_get(witness_id: str,authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        row=_v176_registry_row(c,witness_id)
        if not row: raise HTTPException(404,'WITNESS_NOT_REGISTERED')
        hist=[dict(x) for x in _v176_history(c,witness_id)]
        return {'schema_version':'1.76','witness':dict(row),'key_history':hist}


# ---------------- WUNOO v1.79: Governance Checkpoints & Independent Finality ----------------
def migrate_v179(c):
    c.executescript("""CREATE TABLE IF NOT EXISTS production_witness_governance_checkpoints(
        id TEXT PRIMARY KEY, checkpoint_no INTEGER NOT NULL UNIQUE, ledger_sequence_no INTEGER NOT NULL,
        ledger_head_sha256 TEXT NOT NULL, entries_count INTEGER NOT NULL, checkpoint_sha256 TEXT NOT NULL UNIQUE,
        signer_key_id TEXT NOT NULL, public_key_b64 TEXT NOT NULL, signature_b64 TEXT NOT NULL,
        checkpoint_json TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT
    );
    CREATE TABLE IF NOT EXISTS production_witness_governance_finality(
        id TEXT PRIMARY KEY, checkpoint_id TEXT NOT NULL UNIQUE, checkpoint_sha256 TEXT NOT NULL,
        quorum_required INTEGER NOT NULL, witness_count INTEGER NOT NULL, witness_ids_json TEXT NOT NULL,
        approval_hashes_json TEXT NOT NULL, proof_json TEXT NOT NULL, proof_sha256 TEXT NOT NULL UNIQUE,
        algorithm TEXT NOT NULL, public_key_b64 TEXT NOT NULL, signature_b64 TEXT NOT NULL,
        status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT
    );
    CREATE INDEX IF NOT EXISTS idx_governance_checkpoints_head ON production_witness_governance_checkpoints(ledger_sequence_no,created_at);
    CREATE INDEX IF NOT EXISTS idx_governance_finality_checkpoint ON production_witness_governance_finality(checkpoint_sha256,created_at);
    """)

_V179_POLICY={'schema_version':'1.79','checkpoint_format':'wunoo.release.witness.governance.checkpoint.v1',
 'finality_format':'wunoo.release.witness.governance.finality.v1','algorithm':'Ed25519','hash':'SHA-256',
 'default_quorum':2,'distinct_witnesses_required':True,'requires_verified_governance_ledger':True,
 'requires_active_registered_witnesses':True,'append_only':True,'fail_closed':True,'no_automatic_release':True}

def _v179_hash(v): return hashlib.sha256(json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()).hexdigest()
def _v179_zero(): return '0'*64
def _v179_quorum(v=None):
    raw=v if v is not None else os.getenv('WUNOO_GOVERNANCE_FINALITY_QUORUM','2')
    try:q=int(raw)
    except Exception:q=2
    if q<1 or q>100: raise HTTPException(400,'INVALID_GOVERNANCE_FINALITY_QUORUM')
    return q

def _v179_checkpoint_payload(no,seq,head,count,t):
    return {'format':_V179_POLICY['checkpoint_format'],'schema_version':'1.79','checkpoint_no':no,
            'ledger_sequence_no':seq,'ledger_head_sha256':head,'entries_count':count,'created_at':t}

def _v179_verify_checkpoint(row):
    try:
        payload=json.loads(row['checkpoint_json'] or '{}')
        if _v179_hash(payload)!=row['checkpoint_sha256']: return {'valid':False,'reason':'GOVERNANCE_CHECKPOINT_HASH_INVALID'}
        if payload.get('format')!=_V179_POLICY['checkpoint_format'] or payload.get('schema_version')!='1.79': return {'valid':False,'reason':'GOVERNANCE_CHECKPOINT_FORMAT_INVALID'}
        if int(payload.get('checkpoint_no'))!=int(row['checkpoint_no']) or int(payload.get('ledger_sequence_no'))!=int(row['ledger_sequence_no']) or payload.get('ledger_head_sha256')!=row['ledger_head_sha256'] or int(payload.get('entries_count'))!=int(row['entries_count']): return {'valid':False,'reason':'GOVERNANCE_CHECKPOINT_BINDING_INVALID'}
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto()
        Ed25519PublicKey.from_public_bytes(base64.b64decode(row['public_key_b64'],validate=True)).verify(base64.b64decode(row['signature_b64'],validate=True),json.dumps(payload,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode())
        return {'valid':True,'reason':'GOVERNANCE_CHECKPOINT_VERIFIED'}
    except Exception:return {'valid':False,'reason':'GOVERNANCE_CHECKPOINT_SIGNATURE_INVALID'}

def _v179_finality_payload(checkpoint_sha,q,wids,hashes):
    return {'format':_V179_POLICY['finality_format'],'schema_version':'1.79','checkpoint_sha256':checkpoint_sha,
            'quorum_required':q,'witness_ids':wids,'approval_hashes':hashes}

def _v179_witness_attestation_payload(checkpoint_sha,wid,keyid):
    return {'format':_V179_POLICY['finality_format'],'schema_version':'1.79','checkpoint_sha256':checkpoint_sha,
            'witness_id':wid,'key_id':keyid}

def _v179_verify_attestation(c,att):
    try:
        wid=str(att['witness_id']); keyid=str(att['key_id']); pub=str(att['public_key_b64']); sig=str(att['signature_b64']); cp=str(att['checkpoint_sha256'])
        reg=_v176_registry_row(c,wid)
        if not reg:return {'valid':False,'reason':'WITNESS_NOT_REGISTERED'}
        if reg['status']!='ACTIVE':return {'valid':False,'reason':'WITNESS_NOT_ACTIVE'}
        if reg['current_key_id']!=keyid or reg['current_public_key_b64']!=pub:return {'valid':False,'reason':'WITNESS_KEY_NOT_CURRENT'}
        raw=base64.b64decode(pub,validate=True); actual=_v176_key_id(raw)
        if actual!=keyid:return {'valid':False,'reason':'WITNESS_KEY_ID_INVALID'}
        trust=_v177_evaluate(c,wid)
        if not trust['valid']:return {'valid':False,'reason':trust['reason']}
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto()
        signed=_v179_witness_attestation_payload(cp,wid,keyid)
        Ed25519PublicKey.from_public_bytes(raw).verify(base64.b64decode(sig,validate=True),json.dumps(signed,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode())
        return {'valid':True,'witness_id':wid,'key_id':keyid}
    except Exception:return {'valid':False,'reason':'GOVERNANCE_ATTESTATION_INVALID'}

@app.get('/api/v179/ops/witness-governance/policy')
def v179_policy(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); return _V179_POLICY

@app.post('/api/v179/ops/witness-governance/checkpoint')
def v179_checkpoint(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin'}); operator=str(u.get('email') or u.get('id') or 'operator')
    with core_db_connect() as c:
        lv=_v178_verify_ledger(c)
        if not lv['valid']: raise HTTPException(409,lv['reason'])
        latest=_v170_row(c,'production_witness_governance_checkpoints',order='checkpoint_no DESC')
        if latest and int(latest['ledger_sequence_no'])==int(lv['entries_count']) and latest['ledger_head_sha256']==lv['head_sha256']:
            return {'schema_version':'1.79','idempotent':True,'checkpoint':dict(latest),'verification':_v179_verify_checkpoint(latest)}
        no=int(latest['checkpoint_no'])+1 if latest else 1; t=now(); pl=_v179_checkpoint_payload(no,lv['entries_count'],lv['head_sha256'],lv['entries_count'],t); digest=_v179_hash(pl)
        key,pub,keyid=_v169_load_signer(); sig=base64.b64encode(key.sign(json.dumps(pl,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode())).decode(); pid='gcp_'+uuid.uuid4().hex[:16]
        c.execute('INSERT INTO production_witness_governance_checkpoints(id,checkpoint_no,ledger_sequence_no,ledger_head_sha256,entries_count,checkpoint_sha256,signer_key_id,public_key_b64,signature_b64,checkpoint_json,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?, ?,?)',(pid,no,lv['entries_count'],lv['head_sha256'],lv['entries_count'],digest,keyid,base64.b64encode(pub).decode(),sig,_v178_json(pl),'VERIFIED',t,operator)); c.commit()
        row=_v170_row(c,'production_witness_governance_checkpoints',' WHERE id=?',(pid,),'created_at DESC')
        return {'schema_version':'1.79','idempotent':False,'checkpoint':dict(row),'verification':_v179_verify_checkpoint(row)}

@app.get('/api/v179/ops/witness-governance/checkpoint/verify')
def v179_checkpoint_verify(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        row=_v170_row(c,'production_witness_governance_checkpoints',order='checkpoint_no DESC')
        if not row:return {'schema_version':'1.79','verification':{'valid':False,'reason':'GOVERNANCE_CHECKPOINT_NOT_FOUND'}}
        lv=_v178_verify_ledger(c); cv=_v179_verify_checkpoint(row); bound=lv['valid'] and row['ledger_head_sha256']==lv['head_sha256'] and int(row['ledger_sequence_no'])==int(lv['entries_count'])
        return {'schema_version':'1.79','verification':{'valid':bool(cv['valid'] and bound),'checkpoint':cv,'ledger':lv,'reason':'GOVERNANCE_CHECKPOINT_CHAIN_VERIFIED' if cv['valid'] and bound else 'GOVERNANCE_CHECKPOINT_CHAIN_INVALID'}}

@app.post('/api/v179/ops/witness-governance/finality')
def v179_finality(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin'}); p=payload or {}; operator=str(u.get('email') or u.get('id') or 'operator')
    with core_db_connect() as c:
        cp=_v170_row(c,'production_witness_governance_checkpoints',' WHERE id=?',(p.get('checkpoint_id'),),'created_at DESC') if p.get('checkpoint_id') else _v170_row(c,'production_witness_governance_checkpoints',order='checkpoint_no DESC')
        if not cp:raise HTTPException(404,'GOVERNANCE_CHECKPOINT_NOT_FOUND')
        cv=_v179_verify_checkpoint(cp); lv=_v178_verify_ledger(c)
        if not cv['valid'] or not lv['valid'] or cp['ledger_head_sha256']!=lv['head_sha256']:raise HTTPException(409,'GOVERNANCE_CHECKPOINT_NOT_FINALIZABLE')
        existing=_v170_row(c,'production_witness_governance_finality',' WHERE checkpoint_id=?',(cp['id'],),'created_at DESC')
        if existing:return {'schema_version':'1.79','idempotent':True,'finality':dict(existing)}
        q=_v179_quorum(p.get('quorum_required')); attestations=p.get('attestations') or []
        if not isinstance(attestations,list):raise HTTPException(400,'attestations must be a list')
        verified=[]; seen=set(); invalid=[]
        for a in attestations:
            a=dict(a); a['checkpoint_sha256']=cp['checkpoint_sha256']; vr=_v179_verify_attestation(c,a)
            if vr['valid'] and vr['witness_id'] not in seen:seen.add(vr['witness_id']); verified.append((a,vr))
            else:invalid.append(vr.get('reason','INVALID_ATTESTATION'))
        verified.sort(key=lambda x:(x[1]['witness_id'],x[0]['signature_b64']))
        if len(verified)<q:raise HTTPException(409,'GOVERNANCE_FINALITY_QUORUM_NOT_REACHED')
        chosen=verified[:q]; wids=[x[1]['witness_id'] for x in chosen]; hashes=[_v179_hash({'checkpoint_sha256':cp['checkpoint_sha256'],'witness_id':x[1]['witness_id'],'key_id':x[1]['key_id'],'signature_b64':x[0]['signature_b64']}) for x in chosen]
        proof=_v179_finality_payload(cp['checkpoint_sha256'],q,wids,hashes); ph=_v179_hash(proof); key,pub,keyid=_v169_load_signer(); sig=base64.b64encode(key.sign(json.dumps(proof,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode())).decode(); fid='gfn_'+uuid.uuid4().hex[:16]; t=now()
        c.execute('INSERT INTO production_witness_governance_finality(id,checkpoint_id,checkpoint_sha256,quorum_required,witness_count,witness_ids_json,approval_hashes_json,proof_json,proof_sha256,algorithm,public_key_b64,signature_b64,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(fid,cp['id'],cp['checkpoint_sha256'],q,len(chosen),_v178_json(wids),_v178_json(hashes),_v178_json(proof),ph,'Ed25519',base64.b64encode(pub).decode(),sig,'FINALIZED',t,operator)); c.commit()
        row=_v170_row(c,'production_witness_governance_finality',' WHERE id=?',(fid,),'created_at DESC')
        return {'schema_version':'1.79','idempotent':False,'finality':dict(row),'invalid_attestations':invalid,'status':'FINALIZED'}

@app.get('/api/v179/ops/witness-governance/finality/verify')
def v179_finality_verify(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        row=_v170_row(c,'production_witness_governance_finality',order='created_at DESC')
        if not row:return {'schema_version':'1.79','verification':{'valid':False,'reason':'GOVERNANCE_FINALITY_NOT_FOUND'}}
        try:
            proof=json.loads(row['proof_json'] or '{}'); valid=_v179_hash(proof)==row['proof_sha256'] and proof.get('format')==_V179_POLICY['finality_format'] and int(proof.get('quorum_required'))==int(row['quorum_required']) and json.loads(row['witness_ids_json'])==proof.get('witness_ids') and json.loads(row['approval_hashes_json'])==proof.get('approval_hashes')
            _,Ed25519PublicKey,_,_,_,_=_v169_crypto(); Ed25519PublicKey.from_public_bytes(base64.b64decode(row['public_key_b64'],validate=True)).verify(base64.b64decode(row['signature_b64'],validate=True),json.dumps(proof,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode())
        except Exception: valid=False
        return {'schema_version':'1.79','verification':{'valid':valid,'reason':'GOVERNANCE_FINALITY_VERIFIED' if valid else 'GOVERNANCE_FINALITY_INVALID','finality_id':row['id'],'checkpoint_sha256':row['checkpoint_sha256'],'witness_count':row['witness_count'],'quorum_required':row['quorum_required']}}


# ---------------- WUNOO v1.80: Unified Governance Finality & Cross-Chain Evidence ----------------
def migrate_v180(c):
    c.executescript("""CREATE TABLE IF NOT EXISTS production_unified_governance_release_bindings(
        id TEXT PRIMARY KEY, governance_finality_id TEXT NOT NULL UNIQUE,
        governance_checkpoint_sha256 TEXT NOT NULL, governance_proof_sha256 TEXT NOT NULL,
        release_finality_id TEXT NOT NULL UNIQUE, release_checkpoint_sha256 TEXT NOT NULL,
        release_proof_sha256 TEXT NOT NULL, release_version TEXT NOT NULL,
        binding_sha256 TEXT NOT NULL UNIQUE, binding_json TEXT NOT NULL,
        algorithm TEXT NOT NULL, public_key_b64 TEXT NOT NULL, signature_b64 TEXT NOT NULL,
        status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT
    );
    CREATE TABLE IF NOT EXISTS production_unified_governance_release_attestations(
        id TEXT PRIMARY KEY, binding_id TEXT NOT NULL, binding_sha256 TEXT NOT NULL,
        witness_id TEXT NOT NULL, key_id TEXT NOT NULL, public_key_b64 TEXT NOT NULL,
        signature_b64 TEXT NOT NULL, attestation_json TEXT NOT NULL,
        attestation_sha256 TEXT NOT NULL UNIQUE, status TEXT NOT NULL,
        created_at TEXT NOT NULL, operator TEXT,
        UNIQUE(binding_id,witness_id)
    );
    CREATE TABLE IF NOT EXISTS production_unified_governance_release_finality(
        id TEXT PRIMARY KEY, binding_id TEXT NOT NULL UNIQUE, binding_sha256 TEXT NOT NULL,
        quorum_required INTEGER NOT NULL, witness_count INTEGER NOT NULL,
        witness_ids_json TEXT NOT NULL, attestation_hashes_json TEXT NOT NULL,
        proof_json TEXT NOT NULL, proof_sha256 TEXT NOT NULL UNIQUE,
        algorithm TEXT NOT NULL, public_key_b64 TEXT NOT NULL, signature_b64 TEXT NOT NULL,
        status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT
    );
    CREATE INDEX IF NOT EXISTS idx_unified_binding_release ON production_unified_governance_release_bindings(release_version,created_at);
    CREATE INDEX IF NOT EXISTS idx_unified_attestation_binding ON production_unified_governance_release_attestations(binding_id,created_at);
    CREATE INDEX IF NOT EXISTS idx_unified_finality_binding ON production_unified_governance_release_finality(binding_sha256,created_at);
    """)
    try: c.commit()
    except Exception: pass

_V180_POLICY={
    'schema_version':'1.80',
    'binding_format':'wunoo.release.witness.unified.governance.release.binding.v1',
    'attestation_format':'wunoo.release.witness.unified.governance.release.attestation.v1',
    'finality_format':'wunoo.release.witness.unified.governance.release.finality.v1',
    'hash_algorithm':'SHA-256','signature_algorithm':'Ed25519','default_quorum':2,
    'distinct_witnesses_required':True,'requires_verified_governance_finality':True,
    'requires_verified_release_finality':True,'cross_chain_binding_required':True,
    'append_only':True,'fail_closed':True,'no_automatic_release':True,
    'finality_is_not_release_authorization':True
}

def _v180_hash(value):
    return hashlib.sha256(json.dumps(value,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()).hexdigest()

def _v180_quorum(value=None):
    raw=value if value is not None else os.getenv('WUNOO_UNIFIED_FINALITY_QUORUM','2')
    try: q=int(raw)
    except Exception: q=2
    if q<1 or q>100: raise HTTPException(400,'INVALID_UNIFIED_FINALITY_QUORUM')
    return q

def _v180_json(value): return json.dumps(value,sort_keys=True,separators=(',',':'),ensure_ascii=False)

def _v180_verify_release_finality(c,row):
    try:
        vr=_v175_verify_row(row)
        if not vr['valid']: return vr
        qr=_v175_collect_quorum(c,row['checkpoint_sha256'],row['quorum_required'])
        if not qr['valid']: return {'valid':False,'reason':qr['reason']}
        proof=json.loads(row['proof_json'] or '{}')
        if proof.get('witness_ids')!=qr['witness_ids'] or proof.get('witness_receipt_hashes')!=qr['witness_receipt_hashes']:
            return {'valid':False,'reason':'RELEASE_FINALITY_QUORUM_CHANGED'}
        return {'valid':True,'reason':'RELEASE_FINALITY_VERIFIED','release_version':row['release_version'],'proof_sha256':row['proof_sha256']}
    except Exception: return {'valid':False,'reason':'RELEASE_FINALITY_INVALID'}

def _v180_verify_governance_finality(c,row):
    try:
        proof=json.loads(row['proof_json'] or '{}')
        if _v179_hash(proof)!=row['proof_sha256']: return {'valid':False,'reason':'GOVERNANCE_FINALITY_HASH_INVALID'}
        if proof.get('format')!=_V179_POLICY['finality_format'] or proof.get('schema_version')!='1.79': return {'valid':False,'reason':'GOVERNANCE_FINALITY_FORMAT_INVALID'}
        if int(proof.get('quorum_required',0))!=int(row['quorum_required']): return {'valid':False,'reason':'GOVERNANCE_FINALITY_QUORUM_INVALID'}
        if proof.get('witness_ids')!=json.loads(row['witness_ids_json']): return {'valid':False,'reason':'GOVERNANCE_FINALITY_WITNESS_BINDING_INVALID'}
        if proof.get('approval_hashes')!=json.loads(row['approval_hashes_json']): return {'valid':False,'reason':'GOVERNANCE_FINALITY_APPROVAL_BINDING_INVALID'}
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto()
        Ed25519PublicKey.from_public_bytes(base64.b64decode(row['public_key_b64'],validate=True)).verify(base64.b64decode(row['signature_b64'],validate=True),_v180_json(proof).encode())
        cp=_v170_row(c,'production_witness_governance_checkpoints',' WHERE id=?',(row['checkpoint_id'],),'created_at DESC')
        if not cp: return {'valid':False,'reason':'GOVERNANCE_CHECKPOINT_NOT_FOUND'}
        cv=_v179_verify_checkpoint(cp); lv=_v178_verify_ledger(c)
        if not cv['valid'] or not lv['valid']: return {'valid':False,'reason':'GOVERNANCE_CHAIN_INVALID'}
        if cp['ledger_head_sha256']!=lv['head_sha256']: return {'valid':False,'reason':'GOVERNANCE_CHECKPOINT_HEAD_CHANGED'}
        if row['checkpoint_sha256']!=cp['checkpoint_sha256']: return {'valid':False,'reason':'GOVERNANCE_FINALITY_CHECKPOINT_CHANGED'}
        return {'valid':True,'reason':'GOVERNANCE_FINALITY_VERIFIED','checkpoint_sha256':row['checkpoint_sha256'],'proof_sha256':row['proof_sha256']}
    except Exception: return {'valid':False,'reason':'GOVERNANCE_FINALITY_INVALID'}

def _v180_binding_payload(gf,rf):
    return {'format':_V180_POLICY['binding_format'],'schema_version':'1.80',
            'governance_finality_id':gf['id'],'governance_checkpoint_sha256':gf['checkpoint_sha256'],
            'governance_proof_sha256':gf['proof_sha256'],'release_finality_id':rf['id'],
            'release_checkpoint_sha256':rf['checkpoint_sha256'],'release_proof_sha256':rf['proof_sha256'],
            'release_version':rf['release_version']}

def _v180_attestation_payload(binding,wid,keyid):
    return {'format':_V180_POLICY['attestation_format'],'schema_version':'1.80',
            'binding_sha256':binding['binding_sha256'],'witness_id':wid,'key_id':keyid}

def _v180_verify_attestation(c,row,binding):
    try:
        wid=str(row['witness_id']); keyid=str(row['key_id']); pub=str(row['public_key_b64'])
        obj=json.loads(row['attestation_json'] or '{}')
        expected=_v180_attestation_payload(binding,wid,keyid)
        if obj!=expected:return {'valid':False,'reason':'UNIFIED_ATTESTATION_PAYLOAD_INVALID'}
        if _v180_hash(obj)!=row['attestation_sha256']:return {'valid':False,'reason':'UNIFIED_ATTESTATION_HASH_INVALID'}
        raw=base64.b64decode(pub,validate=True); sig=base64.b64decode(row['signature_b64'],validate=True)
        if _v176_key_id(raw)!=keyid:return {'valid':False,'reason':'UNIFIED_ATTESTATION_KEY_ID_INVALID'}
        reg=_v176_registry_row(c,wid)
        if not reg:return {'valid':False,'reason':'WITNESS_NOT_REGISTERED'}
        if reg['status']!='ACTIVE':return {'valid':False,'reason':'WITNESS_NOT_ACTIVE'}
        if reg['current_key_id']!=keyid or reg['current_public_key_b64']!=pub:return {'valid':False,'reason':'WITNESS_KEY_NOT_CURRENT'}
        trust=_v177_evaluate(c,wid)
        if not trust['valid']:return {'valid':False,'reason':trust['reason']}
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto(); Ed25519PublicKey.from_public_bytes(raw).verify(sig,_v180_json(obj).encode())
        return {'valid':True,'reason':'UNIFIED_ATTESTATION_VERIFIED','witness_id':wid,'key_id':keyid}
    except Exception:return {'valid':False,'reason':'UNIFIED_ATTESTATION_INVALID'}

def _v180_verify_binding(c,row):
    try:
        obj=json.loads(row['binding_json'] or '{}')
        if _v180_hash(obj)!=row['binding_sha256']:return {'valid':False,'reason':'UNIFIED_BINDING_HASH_INVALID'}
        gf=_v170_row(c,'production_witness_governance_finality',' WHERE id=?',(row['governance_finality_id'],),'created_at DESC')
        rf=_v170_row(c,'production_release_transparency_finality',' WHERE id=?',(row['release_finality_id'],),'created_at DESC')
        if not gf or not rf:return {'valid':False,'reason':'UNIFIED_BINDING_SOURCE_NOT_FOUND'}
        gv=_v180_verify_governance_finality(c,gf); rv=_v180_verify_release_finality(c,rf)
        if not gv['valid']:return {'valid':False,'reason':gv['reason']}
        if not rv['valid']:return {'valid':False,'reason':rv['reason']}
        expected=_v180_binding_payload(gf,rf)
        if obj!=expected:return {'valid':False,'reason':'UNIFIED_BINDING_PAYLOAD_INVALID'}
        for col,val in [('governance_checkpoint_sha256',gf['checkpoint_sha256']),('governance_proof_sha256',gf['proof_sha256']),('release_checkpoint_sha256',rf['checkpoint_sha256']),('release_proof_sha256',rf['proof_sha256']),('release_version',rf['release_version'])]:
            if row[col]!=val:return {'valid':False,'reason':'UNIFIED_BINDING_COLUMN_MISMATCH'}
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto(); Ed25519PublicKey.from_public_bytes(base64.b64decode(row['public_key_b64'],validate=True)).verify(base64.b64decode(row['signature_b64'],validate=True),_v180_json(obj).encode())
        return {'valid':True,'reason':'UNIFIED_CROSS_CHAIN_BINDING_VERIFIED','binding_sha256':row['binding_sha256']}
    except Exception:return {'valid':False,'reason':'UNIFIED_BINDING_INVALID'}

def _v180_verify_finality(c,row):
    try:
        binding=_v170_row(c,'production_unified_governance_release_bindings',' WHERE id=?',(row['binding_id'],),'created_at DESC')
        if not binding:return {'valid':False,'reason':'UNIFIED_BINDING_NOT_FOUND'}
        bv=_v180_verify_binding(c,binding)
        if not bv['valid']:return {'valid':False,'reason':bv['reason']}
        proof=json.loads(row['proof_json'] or '{}')
        if _v180_hash(proof)!=row['proof_sha256']:return {'valid':False,'reason':'UNIFIED_FINALITY_HASH_INVALID'}
        if proof.get('format')!=_V180_POLICY['finality_format'] or proof.get('schema_version')!='1.80':return {'valid':False,'reason':'UNIFIED_FINALITY_FORMAT_INVALID'}
        if proof.get('binding_sha256')!=binding['binding_sha256']:return {'valid':False,'reason':'UNIFIED_FINALITY_BINDING_INVALID'}
        if proof.get('witness_ids')!=json.loads(row['witness_ids_json']) or proof.get('attestation_hashes')!=json.loads(row['attestation_hashes_json']):return {'valid':False,'reason':'UNIFIED_FINALITY_WITNESS_BINDING_INVALID'}
        if int(proof.get('quorum_required',0))!=int(row['quorum_required']):return {'valid':False,'reason':'UNIFIED_FINALITY_QUORUM_INVALID'}
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto(); Ed25519PublicKey.from_public_bytes(base64.b64decode(row['public_key_b64'],validate=True)).verify(base64.b64decode(row['signature_b64'],validate=True),_v180_json(proof).encode())
        ats=c.execute('SELECT * FROM production_unified_governance_release_attestations WHERE binding_id=? ORDER BY witness_id ASC,attestation_sha256 ASC',(binding['id'],)).fetchall()
        valid=[];seen=set()
        for a in ats:
            vr=_v180_verify_attestation(c,a,binding)
            if vr['valid'] and a['witness_id'] not in seen:valid.append(a);seen.add(a['witness_id'])
        valid.sort(key=lambda x:(str(x['witness_id']),str(x['attestation_sha256'])))
        chosen=valid[:int(row['quorum_required'])]
        if len(chosen)<int(row['quorum_required']):return {'valid':False,'reason':'UNIFIED_FINALITY_QUORUM_NOT_REACHED'}
        hashes=[x['attestation_sha256'] for x in chosen]
        if hashes!=json.loads(row['attestation_hashes_json']):return {'valid':False,'reason':'UNIFIED_FINALITY_ATTESTATIONS_CHANGED'}
        return {'valid':True,'reason':'UNIFIED_GOVERNANCE_RELEASE_FINALITY_VERIFIED','binding_sha256':binding['binding_sha256'],'proof_sha256':row['proof_sha256'],'witness_count':row['witness_count'],'quorum_required':row['quorum_required'],'release_version':binding['release_version']}
    except Exception:return {'valid':False,'reason':'UNIFIED_FINALITY_INVALID'}

def _v180_finality_payload(binding,q,wids,hashes):
    return {'format':_V180_POLICY['finality_format'],'schema_version':'1.80','binding_sha256':binding['binding_sha256'],
            'governance_finality_id':binding['governance_finality_id'],'release_finality_id':binding['release_finality_id'],
            'release_version':binding['release_version'],'quorum_required':q,'witness_ids':wids,'attestation_hashes':hashes}

@app.get('/api/v180/ops/unified-finality/policy')
def v180_policy(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); return _V180_POLICY

@app.post('/api/v180/ops/unified-finality/bind')
def v180_bind(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin'}); p=payload or {}; operator=str(u.get('email') or u.get('id') or 'operator')
    with core_db_connect() as c:
        gf=_v170_row(c,'production_witness_governance_finality',' WHERE id=?',(p.get('governance_finality_id'),),'created_at DESC') if p.get('governance_finality_id') else _v170_row(c,'production_witness_governance_finality',order='created_at DESC')
        rf=_v170_row(c,'production_release_transparency_finality',' WHERE id=?',(p.get('release_finality_id'),),'created_at DESC') if p.get('release_finality_id') else _v170_row(c,'production_release_transparency_finality',order='created_at DESC')
        if not gf:raise HTTPException(404,'GOVERNANCE_FINALITY_NOT_FOUND')
        if not rf:raise HTTPException(404,'RELEASE_FINALITY_NOT_FOUND')
        gv=_v180_verify_governance_finality(c,gf); rv=_v180_verify_release_finality(c,rf)
        if not gv['valid']:raise HTTPException(409,gv['reason'])
        if not rv['valid']:raise HTTPException(409,rv['reason'])
        existing=_v170_row(c,'production_unified_governance_release_bindings',' WHERE governance_finality_id=?',(gf['id'],),'created_at DESC')
        if existing:
            if existing['release_finality_id']!=rf['id']:raise HTTPException(409,'GOVERNANCE_FINALITY_ALREADY_BOUND')
            return {'schema_version':'1.80','idempotent':True,'binding':dict(existing),'verification':_v180_verify_binding(c,existing)}
        obj=_v180_binding_payload(gf,rf); digest=_v180_hash(obj); key,pub,keyid=_v169_load_signer(); sig=base64.b64encode(key.sign(_v180_json(obj).encode())).decode(); bid='ugb_'+uuid.uuid4().hex[:16]; t=now()
        c.execute('INSERT INTO production_unified_governance_release_bindings(id,governance_finality_id,governance_checkpoint_sha256,governance_proof_sha256,release_finality_id,release_checkpoint_sha256,release_proof_sha256,release_version,binding_sha256,binding_json,algorithm,public_key_b64,signature_b64,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(bid,gf['id'],gf['checkpoint_sha256'],gf['proof_sha256'],rf['id'],rf['checkpoint_sha256'],rf['proof_sha256'],rf['release_version'],digest,_v180_json(obj),'Ed25519',base64.b64encode(pub).decode(),sig,'BOUND',t,operator)); c.commit()
        row=_v170_row(c,'production_unified_governance_release_bindings',' WHERE id=?',(bid,),'created_at DESC')
        return {'schema_version':'1.80','idempotent':False,'binding':dict(row),'signer_key_id':keyid,'verification':_v180_verify_binding(c,row)}

@app.post('/api/v180/ops/unified-finality/attest')
def v180_attest(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); p=payload or {}; bid=str(p.get('binding_id') or '').strip(); wid=str(p.get('witness_id') or '').strip(); pub=str(p.get('public_key_b64') or '').strip(); sig=str(p.get('signature_b64') or '').strip()
    if not bid or not wid or not pub or not sig:raise HTTPException(400,'binding_id,witness_id,public_key_b64,signature_b64 required')
    with core_db_connect() as c:
        binding=_v170_row(c,'production_unified_governance_release_bindings',' WHERE id=?',(bid,),'created_at DESC')
        if not binding:raise HTTPException(404,'UNIFIED_BINDING_NOT_FOUND')
        bv=_v180_verify_binding(c,binding)
        if not bv['valid']:raise HTTPException(409,bv['reason'])
        try:keyid=_v176_key_id(base64.b64decode(pub,validate=True))
        except Exception:raise HTTPException(400,'UNIFIED_ATTESTATION_PUBLIC_KEY_INVALID')
        obj=_v180_attestation_payload(binding,wid,keyid); digest=_v180_hash(obj); existing=_v170_row(c,'production_unified_governance_release_attestations',' WHERE binding_id=? AND witness_id=?',(bid,wid),'created_at DESC')
        if existing:
            if existing['attestation_sha256']==digest and existing['signature_b64']==sig and existing['public_key_b64']==pub:return {'schema_version':'1.80','idempotent':True,'attestation_id':existing['id'],'attestation_sha256':digest,'verification':_v180_verify_attestation(c,existing,binding)}
            raise HTTPException(409,'UNIFIED_ATTESTATION_ALREADY_EXISTS')
        temp={'id':'','binding_id':bid,'binding_sha256':binding['binding_sha256'],'witness_id':wid,'key_id':keyid,'public_key_b64':pub,'signature_b64':sig,'attestation_json':_v180_json(obj),'attestation_sha256':digest,'status':'VERIFIED'}
        vr=_v180_verify_attestation(c,temp,binding)
        if not vr['valid']:raise HTTPException(409,vr['reason'])
        aid='uat_'+uuid.uuid4().hex[:16]; t=now(); operator=str(u.get('email') or u.get('id') or 'operator')
        c.execute('INSERT INTO production_unified_governance_release_attestations(id,binding_id,binding_sha256,witness_id,key_id,public_key_b64,signature_b64,attestation_json,attestation_sha256,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?)',(aid,bid,binding['binding_sha256'],wid,keyid,pub,sig,_v180_json(obj),digest,'VERIFIED',t,operator)); c.commit()
        return {'schema_version':'1.80','idempotent':False,'attestation_id':aid,'attestation_sha256':digest,'verification':vr}

@app.post('/api/v180/ops/unified-finality/finalize')
def v180_finalize(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin'}); p=payload or {}; bid=str(p.get('binding_id') or '').strip()
    with core_db_connect() as c:
        binding=_v170_row(c,'production_unified_governance_release_bindings',' WHERE id=?',(bid,),'created_at DESC') if bid else _v170_row(c,'production_unified_governance_release_bindings',order='created_at DESC')
        if not binding:raise HTTPException(404,'UNIFIED_BINDING_NOT_FOUND')
        bv=_v180_verify_binding(c,binding)
        if not bv['valid']:raise HTTPException(409,bv['reason'])
        existing=_v170_row(c,'production_unified_governance_release_finality',' WHERE binding_id=?',(binding['id'],),'created_at DESC')
        if existing:
            fv=_v180_verify_finality(c,existing)
            if not fv['valid']:raise HTTPException(409,fv['reason'])
            return {'schema_version':'1.80','idempotent':True,'finality':dict(existing),'verification':fv}
        q=_v180_quorum(p.get('quorum_required')); rows=c.execute('SELECT * FROM production_unified_governance_release_attestations WHERE binding_id=? ORDER BY witness_id ASC,attestation_sha256 ASC',(binding['id'],)).fetchall(); valid=[];seen=set();invalid=[]
        for row in rows:
            vr=_v180_verify_attestation(c,row,binding)
            if vr['valid'] and row['witness_id'] not in seen:valid.append(row);seen.add(row['witness_id'])
            else:invalid.append(vr.get('reason','INVALID_ATTESTATION'))
        valid.sort(key=lambda x:(str(x['witness_id']),str(x['attestation_sha256'])))
        if len(valid)<q:raise HTTPException(409,'UNIFIED_FINALITY_QUORUM_NOT_REACHED')
        chosen=valid[:q]; wids=[x['witness_id'] for x in chosen]; hashes=[x['attestation_sha256'] for x in chosen]; proof=_v180_finality_payload(binding,q,wids,hashes); digest=_v180_hash(proof); key,pub,keyid=_v169_load_signer(); sig=base64.b64encode(key.sign(_v180_json(proof).encode())).decode(); fid='ufn_'+uuid.uuid4().hex[:16]; t=now()
        c.execute('INSERT INTO production_unified_governance_release_finality(id,binding_id,binding_sha256,quorum_required,witness_count,witness_ids_json,attestation_hashes_json,proof_json,proof_sha256,algorithm,public_key_b64,signature_b64,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(fid,binding['id'],binding['binding_sha256'],q,len(chosen),_v180_json(wids),_v180_json(hashes),_v180_json(proof),digest,'Ed25519',base64.b64encode(pub).decode(),sig,'FINALIZED',t,str(u.get('email') or u.get('id') or 'operator'))); c.commit(); row=_v170_row(c,'production_unified_governance_release_finality',' WHERE id=?',(fid,),'created_at DESC')
        return {'schema_version':'1.80','idempotent':False,'finality':dict(row),'invalid_attestations':invalid,'signer_key_id':keyid,'verification':_v180_verify_finality(c,row)}

@app.post('/api/v180/ops/unified-finality/verify')
def v180_verify(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); p=payload or {}
    with core_db_connect() as c:
        row=_v170_row(c,'production_unified_governance_release_finality',' WHERE id=?',(p.get('finality_id'),),'created_at DESC') if p.get('finality_id') else _v170_row(c,'production_unified_governance_release_finality',order='created_at DESC')
        if not row:raise HTTPException(404,'UNIFIED_FINALITY_NOT_FOUND')
        vr=_v180_verify_finality(c,row)
        if not vr['valid']:raise HTTPException(409,vr['reason'])
        return {'schema_version':'1.80','verification':vr}

@app.get('/api/v180/ops/unified-finality/latest')
def v180_latest(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        row=_v170_row(c,'production_unified_governance_release_finality',order='created_at DESC')
        if not row:return {'schema_version':'1.80','finality':None}
        return {'schema_version':'1.80','finality':{'finality_id':row['id'],'binding_id':row['binding_id'],'binding_sha256':row['binding_sha256'],'proof_sha256':row['proof_sha256'],'witness_count':row['witness_count'],'quorum_required':row['quorum_required']},'verification':_v180_verify_finality(c,row)}


# ---------------- WUNOO v1.81: Unified Evidence Root & Global Trust Anchor ----------------
def migrate_v181(c):
    c.executescript("""CREATE TABLE IF NOT EXISTS production_global_evidence_roots(
        id TEXT PRIMARY KEY, root_no INTEGER NOT NULL UNIQUE, release_version TEXT NOT NULL,
        active_policy_version TEXT, active_policy_sha256 TEXT, governance_finality_id TEXT,
        governance_proof_sha256 TEXT, unified_finality_id TEXT, unified_proof_sha256 TEXT,
        witness_state_sha256 TEXT NOT NULL, root_payload_json TEXT NOT NULL, root_sha256 TEXT NOT NULL UNIQUE,
        algorithm TEXT NOT NULL, signer_key_id TEXT NOT NULL, public_key_b64 TEXT NOT NULL,
        signature_b64 TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT
    );
    CREATE TABLE IF NOT EXISTS production_global_evidence_attestations(
        id TEXT PRIMARY KEY, root_id TEXT NOT NULL, root_sha256 TEXT NOT NULL,
        witness_id TEXT NOT NULL, key_id TEXT NOT NULL, public_key_b64 TEXT NOT NULL,
        signature_b64 TEXT NOT NULL, attestation_json TEXT NOT NULL, attestation_sha256 TEXT NOT NULL UNIQUE,
        status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT,
        UNIQUE(root_id,witness_id)
    );
    CREATE TABLE IF NOT EXISTS production_global_evidence_finality(
        id TEXT PRIMARY KEY, root_id TEXT NOT NULL UNIQUE, root_sha256 TEXT NOT NULL,
        quorum_required INTEGER NOT NULL, witness_count INTEGER NOT NULL, witness_ids_json TEXT NOT NULL,
        attestation_hashes_json TEXT NOT NULL, proof_json TEXT NOT NULL, proof_sha256 TEXT NOT NULL UNIQUE,
        algorithm TEXT NOT NULL, signer_key_id TEXT NOT NULL, public_key_b64 TEXT NOT NULL,
        signature_b64 TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT
    );
    CREATE INDEX IF NOT EXISTS idx_global_evidence_roots_release ON production_global_evidence_roots(release_version,created_at);
    CREATE INDEX IF NOT EXISTS idx_global_evidence_attestations_root ON production_global_evidence_attestations(root_id,created_at);
    """)

_V181_POLICY={'schema_version':'1.81','root_format':'wunoo.release.global.evidence.root.v1',
 'attestation_format':'wunoo.release.global.evidence.attestation.v1','finality_format':'wunoo.release.global.evidence.finality.v1',
 'algorithm':'Ed25519','hash':'SHA-256','default_quorum':2,'distinct_witnesses_required':True,
 'binds_active_policy':True,'binds_governance_finality':True,'binds_unified_finality':True,
 'binds_witness_registry_state':True,'recomputable_root':True,'fail_closed':True,'no_automatic_release':True}

def _v181_hash(v): return hashlib.sha256(json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()).hexdigest()
def _v181_json(v): return json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False)
def _v181_zero(): return '0'*64
def _v181_quorum(v=None):
    raw=v if v is not None else os.getenv('WUNOO_GLOBAL_EVIDENCE_QUORUM','2')
    try:q=int(raw)
    except Exception:q=2
    if q<1 or q>100: raise HTTPException(400,'INVALID_GLOBAL_EVIDENCE_QUORUM')
    return q

def _v181_witness_state(c):
    rows=c.execute("SELECT witness_id,witness_system,status,current_key_id,current_public_key_b64,registered_at,updated_at FROM production_external_witness_registry ORDER BY witness_id ASC").fetchall()
    state=[]
    for r in rows:
        state.append({'witness_id':r['witness_id'],'witness_system':r['witness_system'],'status':r['status'],
                      'current_key_id':r['current_key_id'],'current_public_key_b64':r['current_public_key_b64'],
                      'registered_at':r['registered_at'],'updated_at':r['updated_at']})
    return state,_v181_hash(state)

def _v181_snapshot(c):
    policy=_v170_row(c,'production_witness_trust_policies',' WHERE status=?',('ACTIVE',),'created_at DESC')
    gf=_v170_row(c,'production_witness_governance_finality',order='created_at DESC')
    uf=_v170_row(c,'production_unified_governance_release_finality',order='created_at DESC')
    if not policy:return {'valid':False,'reason':'GLOBAL_ROOT_ACTIVE_POLICY_NOT_FOUND'}
    if not gf:return {'valid':False,'reason':'GLOBAL_ROOT_GOVERNANCE_FINALITY_NOT_FOUND'}
    if not uf:return {'valid':False,'reason':'GLOBAL_ROOT_UNIFIED_FINALITY_NOT_FOUND'}
    # Both upstream finalities must be cryptographically valid and current before a global root can exist.
    try:
        proof=json.loads(gf['proof_json'] or '{}'); _,Ed25519PublicKey,_,_,_,_=_v169_crypto()
        Ed25519PublicKey.from_public_bytes(base64.b64decode(gf['public_key_b64'],validate=True)).verify(base64.b64decode(gf['signature_b64'],validate=True),_v181_json(proof).encode())
        gv={'valid':_v179_hash(proof)==gf['proof_sha256'] and proof.get('format')==_V179_POLICY['finality_format'] and int(proof.get('quorum_required'))==int(gf['quorum_required']) and proof.get('witness_ids')==json.loads(gf['witness_ids_json']) and proof.get('approval_hashes')==json.loads(gf['approval_hashes_json'])}
    except Exception: gv={'valid':False}
    uv=_v180_verify_finality(c,uf)
    if not gv.get('valid'):return {'valid':False,'reason':'GLOBAL_ROOT_GOVERNANCE_FINALITY_INVALID'}
    if not uv.get('valid'):return {'valid':False,'reason':'GLOBAL_ROOT_UNIFIED_FINALITY_INVALID'}
    state,state_sha=_v181_witness_state(c)
    release_version=str(uf['proof_json'] and json.loads(uf['proof_json']).get('release_version') or '')
    if not release_version: release_version=str(uf.get('release_version') or '')
    payload={'release_version':release_version,'active_policy_version':policy['policy_version'],'active_policy_sha256':policy['policy_sha256'],
             'governance_finality_id':gf['id'],'governance_proof_sha256':gf['proof_sha256'],
             'unified_finality_id':uf['id'],'unified_proof_sha256':uf['proof_sha256'],'witness_state_sha256':state_sha,
             'witness_state':state}
    return {'valid':True,'payload':payload,'policy':policy,'governance_finality':gf,'unified_finality':uf}

def _v181_root_payload(no,snapshot,t):
    return {'format':_V181_POLICY['root_format'],'schema_version':'1.81','root_no':no,'created_at':t,'snapshot':snapshot['payload']}

def _v181_verify_root(c,row):
    try:
        payload=json.loads(row['root_payload_json'] or '{}')
        if _v181_hash(payload)!=row['root_sha256']:return {'valid':False,'reason':'GLOBAL_ROOT_HASH_INVALID'}
        if payload.get('format')!=_V181_POLICY['root_format'] or payload.get('schema_version')!='1.81':return {'valid':False,'reason':'GLOBAL_ROOT_FORMAT_INVALID'}
        if int(payload.get('root_no'))!=int(row['root_no']):return {'valid':False,'reason':'GLOBAL_ROOT_SEQUENCE_INVALID'}
        snap=_v181_snapshot(c)
        if not snap['valid']:return {'valid':False,'reason':snap['reason']}
        if payload.get('snapshot')!=snap['payload']:return {'valid':False,'reason':'GLOBAL_ROOT_CURRENT_STATE_MISMATCH'}
        if row['active_policy_version']!=snap['payload']['active_policy_version'] or row['active_policy_sha256']!=snap['payload']['active_policy_sha256'] or row['governance_finality_id']!=snap['payload']['governance_finality_id'] or row['governance_proof_sha256']!=snap['payload']['governance_proof_sha256'] or row['unified_finality_id']!=snap['payload']['unified_finality_id'] or row['unified_proof_sha256']!=snap['payload']['unified_proof_sha256'] or row['witness_state_sha256']!=snap['payload']['witness_state_sha256']:
            return {'valid':False,'reason':'GLOBAL_ROOT_BINDING_INVALID'}
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto(); Ed25519PublicKey.from_public_bytes(base64.b64decode(row['public_key_b64'],validate=True)).verify(base64.b64decode(row['signature_b64'],validate=True),_v181_json(payload).encode())
        return {'valid':True,'reason':'GLOBAL_ROOT_VERIFIED'}
    except Exception:return {'valid':False,'reason':'GLOBAL_ROOT_SIGNATURE_INVALID'}

def _v181_attestation_payload(root,wid,keyid):
    return {'format':_V181_POLICY['attestation_format'],'schema_version':'1.81','root_sha256':root['root_sha256'],'witness_id':wid,'key_id':keyid}

def _v181_verify_attestation(c,row,root):
    try:
        wid=str(row['witness_id']); keyid=str(row['key_id']); pub=str(row['public_key_b64']); sig=str(row['signature_b64'])
        obj=json.loads(row['attestation_json'] or '{}'); expected=_v181_attestation_payload(root,wid,keyid)
        if obj!=expected:return {'valid':False,'reason':'GLOBAL_ATTESTATION_PAYLOAD_INVALID'}
        if _v181_hash(obj)!=row['attestation_sha256']:return {'valid':False,'reason':'GLOBAL_ATTESTATION_HASH_INVALID'}
        raw=base64.b64decode(pub,validate=True)
        if _v176_key_id(raw)!=keyid:return {'valid':False,'reason':'GLOBAL_ATTESTATION_KEY_ID_INVALID'}
        reg=_v176_registry_row(c,wid)
        if not reg:return {'valid':False,'reason':'WITNESS_NOT_REGISTERED'}
        if reg['status']!='ACTIVE':return {'valid':False,'reason':'WITNESS_NOT_ACTIVE'}
        if reg['current_key_id']!=keyid or reg['current_public_key_b64']!=pub:return {'valid':False,'reason':'GLOBAL_ATTESTATION_KEY_NOT_CURRENT'}
        trust=_v177_evaluate(c,wid)
        if not trust['valid']:return {'valid':False,'reason':trust['reason']}
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto(); Ed25519PublicKey.from_public_bytes(raw).verify(base64.b64decode(sig,validate=True),_v181_json(obj).encode())
        return {'valid':True,'witness_id':wid,'key_id':keyid}
    except Exception:return {'valid':False,'reason':'GLOBAL_ATTESTATION_INVALID'}

def _v181_finality_payload(root,q,wids,hashes):
    return {'format':_V181_POLICY['finality_format'],'schema_version':'1.81','root_sha256':root['root_sha256'],'quorum_required':q,'witness_ids':wids,'attestation_hashes':hashes}

def _v181_verify_finality(c,row):
    try:
        root=_v170_row(c,'production_global_evidence_roots',' WHERE id=?',(row['root_id'],),'created_at DESC')
        if not root:return {'valid':False,'reason':'GLOBAL_ROOT_NOT_FOUND'}
        rv=_v181_verify_root(c,root)
        if not rv['valid']:return {'valid':False,'reason':rv['reason']}
        proof=json.loads(row['proof_json'] or '{}')
        if _v181_hash(proof)!=row['proof_sha256'] or proof.get('format')!=_V181_POLICY['finality_format'] or int(proof.get('quorum_required'))!=int(row['quorum_required']) or proof.get('witness_ids')!=json.loads(row['witness_ids_json']) or proof.get('attestation_hashes')!=json.loads(row['attestation_hashes_json']):return {'valid':False,'reason':'GLOBAL_FINALITY_PROOF_INVALID'}
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto(); Ed25519PublicKey.from_public_bytes(base64.b64decode(row['public_key_b64'],validate=True)).verify(base64.b64decode(row['signature_b64'],validate=True),_v181_json(proof).encode())
        for aid in json.loads(row['attestation_hashes_json']):
            a=_v170_row(c,'production_global_evidence_attestations',' WHERE attestation_sha256=?',(aid,),'created_at DESC')
            if not a:return {'valid':False,'reason':'GLOBAL_ATTESTATION_NOT_FOUND'}
            av=_v181_verify_attestation(c,a,root)
            if not av['valid']:return {'valid':False,'reason':av['reason']}
        return {'valid':True,'reason':'GLOBAL_FINALITY_VERIFIED'}
    except Exception:return {'valid':False,'reason':'GLOBAL_FINALITY_INVALID'}

@app.get('/api/v181/ops/global-evidence/policy')
def v181_policy(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); return _V181_POLICY

@app.post('/api/v181/ops/global-evidence/root')
def v181_root(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin'}); operator=str(u.get('email') or u.get('id') or 'operator')
    with core_db_connect() as c:
        snap=_v181_snapshot(c)
        if not snap['valid']:raise HTTPException(409,snap['reason'])
        latest=_v170_row(c,'production_global_evidence_roots',order='root_no DESC')
        if latest:
            vr=_v181_verify_root(c,latest)
            if vr['valid']:return {'schema_version':'1.81','idempotent':True,'root':dict(latest),'verification':vr}
        no=int(latest['root_no'])+1 if latest else 1; t=now(); pl=_v181_root_payload(no,snap,t); digest=_v181_hash(pl); key,pub,keyid=_v169_load_signer(); sig=base64.b64encode(key.sign(_v181_json(pl).encode())).decode(); rid='ger_'+uuid.uuid4().hex[:16]
        c.execute('INSERT INTO production_global_evidence_roots(id,root_no,release_version,active_policy_version,active_policy_sha256,governance_finality_id,governance_proof_sha256,unified_finality_id,unified_proof_sha256,witness_state_sha256,root_payload_json,root_sha256,algorithm,signer_key_id,public_key_b64,signature_b64,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(rid,no,pl['snapshot']['release_version'],pl['snapshot']['active_policy_version'],pl['snapshot']['active_policy_sha256'],pl['snapshot']['governance_finality_id'],pl['snapshot']['governance_proof_sha256'],pl['snapshot']['unified_finality_id'],pl['snapshot']['unified_proof_sha256'],pl['snapshot']['witness_state_sha256'],_v181_json(pl),digest,'Ed25519',keyid,base64.b64encode(pub).decode(),sig,'SEALED',t,operator)); c.commit()
        row=_v170_row(c,'production_global_evidence_roots',' WHERE id=?',(rid,),'created_at DESC'); return {'schema_version':'1.81','idempotent':False,'root':dict(row),'verification':_v181_verify_root(c,row)}

@app.get('/api/v181/ops/global-evidence/root/verify')
def v181_root_verify(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        row=_v170_row(c,'production_global_evidence_roots',order='root_no DESC')
        if not row:return {'schema_version':'1.81','verification':{'valid':False,'reason':'GLOBAL_ROOT_NOT_FOUND'}}
        return {'schema_version':'1.81','verification':_v181_verify_root(c,row)}

@app.post('/api/v181/ops/global-evidence/attest')
def v181_attest(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); p=payload or {}; root_id=str(p.get('root_id') or '').strip(); wid=str(p.get('witness_id') or '').strip(); pub=str(p.get('public_key_b64') or '').strip(); sig=str(p.get('signature_b64') or '').strip()
    if not root_id or not wid or not pub or not sig:raise HTTPException(400,'root_id,witness_id,public_key_b64,signature_b64 required')
    with core_db_connect() as c:
        root=_v170_row(c,'production_global_evidence_roots',' WHERE id=?',(root_id,),'created_at DESC')
        if not root:raise HTTPException(404,'GLOBAL_ROOT_NOT_FOUND')
        rv=_v181_verify_root(c,root)
        if not rv['valid']:raise HTTPException(409,'GLOBAL_ROOT_NOT_VERIFIABLE')
        try:keyid=_v176_key_id(base64.b64decode(pub,validate=True))
        except Exception:raise HTTPException(400,'GLOBAL_ATTESTATION_PUBLIC_KEY_INVALID')
        obj=_v181_attestation_payload(root,wid,keyid); digest=_v181_hash(obj); existing=_v170_row(c,'production_global_evidence_attestations',' WHERE root_id=? AND witness_id=?',(root_id,wid),'created_at DESC')
        if existing:
            if existing['attestation_sha256']==digest and existing['signature_b64']==sig and existing['public_key_b64']==pub:return {'schema_version':'1.81','idempotent':True,'attestation_id':existing['id'],'attestation_sha256':digest,'verification':_v181_verify_attestation(c,existing,root)}
            raise HTTPException(409,'GLOBAL_ATTESTATION_ALREADY_EXISTS')
        temp={'id':'','root_id':root_id,'root_sha256':root['root_sha256'],'witness_id':wid,'key_id':keyid,'public_key_b64':pub,'signature_b64':sig,'attestation_json':_v181_json(obj),'attestation_sha256':digest,'status':'VERIFIED'}; vr=_v181_verify_attestation(c,temp,root)
        if not vr['valid']:raise HTTPException(409,vr['reason'])
        aid='gea_'+uuid.uuid4().hex[:16]; t=now(); operator=str(u.get('email') or u.get('id') or 'operator')
        c.execute('INSERT INTO production_global_evidence_attestations(id,root_id,root_sha256,witness_id,key_id,public_key_b64,signature_b64,attestation_json,attestation_sha256,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?)',(aid,root_id,root['root_sha256'],wid,keyid,pub,sig,_v181_json(obj),digest,'VERIFIED',t,operator)); c.commit()
        return {'schema_version':'1.81','idempotent':False,'attestation_id':aid,'attestation_sha256':digest,'verification':vr}

@app.post('/api/v181/ops/global-evidence/finality')
def v181_finality(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin'}); p=payload or {}; operator=str(u.get('email') or u.get('id') or 'operator')
    with core_db_connect() as c:
        root=_v170_row(c,'production_global_evidence_roots',' WHERE id=?',(p.get('root_id'),),'created_at DESC') if p.get('root_id') else _v170_row(c,'production_global_evidence_roots',order='root_no DESC')
        if not root:raise HTTPException(404,'GLOBAL_ROOT_NOT_FOUND')
        rv=_v181_verify_root(c,root)
        if not rv['valid']:raise HTTPException(409,'GLOBAL_ROOT_NOT_FINALIZABLE')
        existing=_v170_row(c,'production_global_evidence_finality',' WHERE root_id=?',(root['id'],),'created_at DESC')
        if existing:return {'schema_version':'1.81','idempotent':True,'finality':dict(existing),'verification':_v181_verify_finality(c,existing)}
        q=_v181_quorum(p.get('quorum_required')); rows=c.execute('SELECT * FROM production_global_evidence_attestations WHERE root_id=? ORDER BY witness_id ASC,attestation_sha256 ASC',(root['id'],)).fetchall(); valid=[];seen=set();invalid=[]
        for row in rows:
            vr=_v181_verify_attestation(c,row,root)
            if vr['valid'] and vr['witness_id'] not in seen:seen.add(vr['witness_id']);valid.append((row,vr))
            else:invalid.append({'attestation_id':row['id'],'reason':vr.get('reason','INVALID_ATTESTATION')})
        valid.sort(key=lambda x:(x[1]['witness_id'],x[0]['attestation_sha256']))
        if len(valid)<q:raise HTTPException(409,'GLOBAL_EVIDENCE_QUORUM_NOT_REACHED')
        chosen=valid[:q]; wids=[x[1]['witness_id'] for x in chosen]; hashes=[x[0]['attestation_sha256'] for x in chosen]; proof=_v181_finality_payload(root,q,wids,hashes); ph=_v181_hash(proof); key,pub,keyid=_v169_load_signer(); sig=base64.b64encode(key.sign(_v181_json(proof).encode())).decode(); fid='gef_'+uuid.uuid4().hex[:16]; t=now()
        c.execute('INSERT INTO production_global_evidence_finality(id,root_id,root_sha256,quorum_required,witness_count,witness_ids_json,attestation_hashes_json,proof_json,proof_sha256,algorithm,signer_key_id,public_key_b64,signature_b64,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(fid,root['id'],root['root_sha256'],q,len(chosen),_v181_json(wids),_v181_json(hashes),_v181_json(proof),ph,'Ed25519',keyid,base64.b64encode(pub).decode(),sig,'FINALIZED',t,operator)); c.commit()
        row=_v170_row(c,'production_global_evidence_finality',' WHERE id=?',(fid,),'created_at DESC'); return {'schema_version':'1.81','idempotent':False,'finality':dict(row),'invalid_attestations':invalid,'verification':_v181_verify_finality(c,row)}

@app.get('/api/v181/ops/global-evidence/finality/verify')
def v181_finality_verify(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        row=_v170_row(c,'production_global_evidence_finality',order='created_at DESC')
        if not row:return {'schema_version':'1.81','verification':{'valid':False,'reason':'GLOBAL_FINALITY_NOT_FOUND'}}
        return {'schema_version':'1.81','verification':_v181_verify_finality(c,row),'finality_id':row['id']}

# ---------------- WUNOO v1.82: Global Evidence Root Chain & Historical Trust Continuity ----------------
def migrate_v182(c):
    c.executescript("""CREATE TABLE IF NOT EXISTS production_global_evidence_root_chain(
        id TEXT PRIMARY KEY, sequence_no INTEGER NOT NULL UNIQUE, root_id TEXT NOT NULL UNIQUE,
        root_sha256 TEXT NOT NULL, previous_root_sha256 TEXT NOT NULL, entry_json TEXT NOT NULL,
        entry_sha256 TEXT NOT NULL UNIQUE, status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT
    );
    CREATE INDEX IF NOT EXISTS idx_global_evidence_root_chain_seq ON production_global_evidence_root_chain(sequence_no);""")

_V182_POLICY={'schema_version':'1.82','entry_format':'wunoo.release.global.evidence.root.chain.entry.v1',
 'hash':'SHA-256','genesis':'0'*64,'append_only':True,'historical_verification':True,
 'deterministic_entry':True,'root_continuity_required':True,'fail_closed':True,'no_automatic_release':True}

def _v182_hash(v): return hashlib.sha256(json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()).hexdigest()
def _v182_json(v): return json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False)
def _v182_entry(seq,root,prev,t):
    return {'format':_V182_POLICY['entry_format'],'schema_version':'1.82','sequence_no':seq,'root_id':root['id'],'root_sha256':root['root_sha256'],'previous_root_sha256':prev,'created_at':t}
def _v182_verify_entry(row,prev_seq=None,prev_hash=None):
    try:
        obj=json.loads(row['entry_json'] or '{}')
        if obj.get('format')!=_V182_POLICY['entry_format'] or obj.get('schema_version')!='1.82': return {'valid':False,'reason':'GLOBAL_CHAIN_ENTRY_FORMAT_INVALID'}
        if int(obj.get('sequence_no'))!=int(row['sequence_no']) or obj.get('root_id')!=row['root_id'] or obj.get('root_sha256')!=row['root_sha256'] or obj.get('previous_root_sha256')!=row['previous_root_sha256']: return {'valid':False,'reason':'GLOBAL_CHAIN_ENTRY_BINDING_INVALID'}
        if prev_seq is not None and int(row['sequence_no'])!=prev_seq+1: return {'valid':False,'reason':'GLOBAL_CHAIN_SEQUENCE_BROKEN'}
        if prev_hash is not None and row['previous_root_sha256']!=prev_hash: return {'valid':False,'reason':'GLOBAL_CHAIN_LINK_BROKEN'}
        if _v182_hash(obj)!=row['entry_sha256']: return {'valid':False,'reason':'GLOBAL_CHAIN_ENTRY_HASH_INVALID'}
        return {'valid':True,'reason':'GLOBAL_CHAIN_ENTRY_VERIFIED'}
    except Exception:return {'valid':False,'reason':'GLOBAL_CHAIN_ENTRY_INVALID'}

def _v182_verify_chain(c):
    rows=c.execute('SELECT * FROM production_global_evidence_root_chain ORDER BY sequence_no ASC').fetchall(); prev_seq=None; prev_hash=_V182_POLICY['genesis']; checked=0
    for row in rows:
        vr=_v182_verify_entry(row,prev_seq,prev_hash)
        if not vr['valid']: return {'valid':False,'reason':vr['reason'],'checked':checked,'chain_length':len(rows)}
        root=_v170_row(c,'production_global_evidence_roots',' WHERE id=?',(row['root_id'],),'created_at DESC')
        if not root or root['root_sha256']!=row['root_sha256']: return {'valid':False,'reason':'GLOBAL_CHAIN_ROOT_MISSING_OR_CHANGED','checked':checked,'chain_length':len(rows)}
        try:
            payload=json.loads(root['root_payload_json'] or '{}')
            if _v181_hash(payload)!=root['root_sha256']: return {'valid':False,'reason':'GLOBAL_CHAIN_ROOT_HASH_INVALID','checked':checked,'chain_length':len(rows)}
            _,Ed25519PublicKey,_,_,_,_=_v169_crypto(); Ed25519PublicKey.from_public_bytes(base64.b64decode(root['public_key_b64'],validate=True)).verify(base64.b64decode(root['signature_b64'],validate=True),_v181_json(payload).encode())
        except Exception:return {'valid':False,'reason':'GLOBAL_CHAIN_ROOT_SIGNATURE_INVALID','checked':checked,'chain_length':len(rows)}
        checked+=1; prev_seq=int(row['sequence_no']); prev_hash=row['root_sha256']
    return {'valid':True,'reason':'GLOBAL_ROOT_CHAIN_VERIFIED','checked':checked,'chain_length':len(rows),'head_root_sha256':prev_hash,'head_sequence_no':prev_seq or 0}

@app.get('/api/v182/ops/global-evidence-chain/policy')
def v182_policy(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); return _V182_POLICY

@app.post('/api/v182/ops/global-evidence-chain/append')
def v182_append(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin'}); p=payload or {}; operator=str(u.get('email') or u.get('id') or 'operator')
    with core_db_connect() as c:
        root=_v170_row(c,'production_global_evidence_roots',' WHERE id=?',(p.get('root_id'),),'created_at DESC') if p.get('root_id') else _v170_row(c,'production_global_evidence_roots',order='root_no DESC')
        if not root: raise HTTPException(404,'GLOBAL_ROOT_NOT_FOUND')
        existing=_v170_row(c,'production_global_evidence_root_chain',' WHERE root_id=?',(root['id'],),'created_at DESC')
        if existing:
            vr=_v182_verify_chain(c)
            if existing['root_sha256']==root['root_sha256'] and vr['valid']: return {'schema_version':'1.82','idempotent':True,'entry':dict(existing),'verification':vr}
            raise HTTPException(409,'GLOBAL_ROOT_ALREADY_CHAINED_OR_CHAIN_INVALID')
        cv=_v182_verify_chain(c)
        if not cv['valid']: raise HTTPException(409,cv['reason'])
        seq=(cv['head_sequence_no'] or 0)+1; prev=cv['head_root_sha256'] or _V182_POLICY['genesis']; t=now(); obj=_v182_entry(seq,root,prev,t); digest=_v182_hash(obj); eid='gerc_'+uuid.uuid4().hex[:16]
        c.execute('INSERT INTO production_global_evidence_root_chain(id,sequence_no,root_id,root_sha256,previous_root_sha256,entry_json,entry_sha256,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?)',(eid,seq,root['id'],root['root_sha256'],prev,_v182_json(obj),digest,'SEALED',t,operator)); c.commit(); row=_v170_row(c,'production_global_evidence_root_chain',' WHERE id=?',(eid,),'created_at DESC')
        return {'schema_version':'1.82','idempotent':False,'entry':dict(row),'verification':_v182_verify_chain(c)}

@app.get('/api/v182/ops/global-evidence-chain/verify')
def v182_verify(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c: return {'schema_version':'1.82','verification':_v182_verify_chain(c)}

@app.get('/api/v182/ops/global-evidence-chain/latest')
def v182_latest(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        row=_v170_row(c,'production_global_evidence_root_chain',order='sequence_no DESC')
        return {'schema_version':'1.82','entry':dict(row) if row else None,'verification':_v182_verify_chain(c)}

# ---------------- WUNOO v1.83: Global Root Checkpoints & Historical Finality ----------------
def migrate_v183(c):
    c.executescript("""CREATE TABLE IF NOT EXISTS production_global_evidence_checkpoints(
        id TEXT PRIMARY KEY, checkpoint_no INTEGER NOT NULL UNIQUE, sequence_no INTEGER NOT NULL,
        head_entry_sha256 TEXT NOT NULL, head_root_sha256 TEXT NOT NULL, chain_length INTEGER NOT NULL,
        checkpoint_json TEXT NOT NULL, checkpoint_sha256 TEXT NOT NULL UNIQUE, algorithm TEXT NOT NULL,
        signer_key_id TEXT NOT NULL, public_key_b64 TEXT NOT NULL, signature_b64 TEXT NOT NULL,
        status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT
    );
    CREATE INDEX IF NOT EXISTS idx_global_evidence_checkpoints_seq ON production_global_evidence_checkpoints(sequence_no);
    CREATE TABLE IF NOT EXISTS production_global_evidence_checkpoint_attestations(
        id TEXT PRIMARY KEY, checkpoint_id TEXT NOT NULL, checkpoint_sha256 TEXT NOT NULL,
        witness_id TEXT NOT NULL, key_id TEXT NOT NULL, public_key_b64 TEXT NOT NULL,
        signature_b64 TEXT NOT NULL, attestation_json TEXT NOT NULL, attestation_sha256 TEXT NOT NULL UNIQUE,
        status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT,
        UNIQUE(checkpoint_id,witness_id)
    );
    CREATE INDEX IF NOT EXISTS idx_global_evidence_checkpoint_attestations ON production_global_evidence_checkpoint_attestations(checkpoint_id,witness_id);
    CREATE TABLE IF NOT EXISTS production_global_evidence_checkpoint_finality(
        id TEXT PRIMARY KEY, checkpoint_id TEXT NOT NULL, checkpoint_sha256 TEXT NOT NULL,
        quorum_required INTEGER NOT NULL, witness_count INTEGER NOT NULL, witness_ids_json TEXT NOT NULL,
        attestation_hashes_json TEXT NOT NULL, proof_json TEXT NOT NULL, proof_sha256 TEXT NOT NULL UNIQUE,
        algorithm TEXT NOT NULL, signer_key_id TEXT NOT NULL, public_key_b64 TEXT NOT NULL,
        signature_b64 TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT,
        UNIQUE(checkpoint_id,quorum_required)
    );""")

_V183_POLICY={'schema_version':'1.83','checkpoint_format':'wunoo.release.global.evidence.checkpoint.v1',
 'attestation_format':'wunoo.release.global.evidence.checkpoint.attestation.v1',
 'finality_format':'wunoo.release.global.evidence.checkpoint.finality.v1','hash':'SHA-256','algorithm':'Ed25519',
 'default_quorum':2,'distinct_witnesses':True,'append_only':True,'historical_finality':True,'fail_closed':True,'no_automatic_release':True}
def _v183_hash(v): return hashlib.sha256(json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()).hexdigest()
def _v183_json(v): return json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False)
def _v183_signer(): return _v169_load_signer()
def _v183_ckpt_payload(seq,entry_hash,root_hash,length,t): return {'format':_V183_POLICY['checkpoint_format'],'schema_version':'1.83','sequence_no':seq,'head_entry_sha256':entry_hash,'head_root_sha256':root_hash,'chain_length':length,'created_at':t}
def _v183_verify_checkpoint(c,row):
    try:
        obj=json.loads(row['checkpoint_json'] or '{}')
        if obj.get('format')!=_V183_POLICY['checkpoint_format'] or obj.get('schema_version')!='1.83': return {'valid':False,'reason':'GLOBAL_CHECKPOINT_FORMAT_INVALID'}
        for k in ('sequence_no','head_entry_sha256','head_root_sha256','chain_length'):
            if str(obj.get(k))!=str(row[k]): return {'valid':False,'reason':'GLOBAL_CHECKPOINT_BINDING_INVALID'}
        if _v183_hash(obj)!=row['checkpoint_sha256']: return {'valid':False,'reason':'GLOBAL_CHECKPOINT_HASH_INVALID'}
        if int(row['sequence_no'])!=int(row['chain_length']): return {'valid':False,'reason':'GLOBAL_CHECKPOINT_LENGTH_INVALID'}
        head=_v170_row(c,'production_global_evidence_root_chain',' WHERE sequence_no=?',(row['sequence_no'],),'created_at DESC')
        if not head or head['entry_sha256']!=row['head_entry_sha256'] or head['root_sha256']!=row['head_root_sha256']: return {'valid':False,'reason':'GLOBAL_CHECKPOINT_HEAD_CHANGED'}
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto(); Ed25519PublicKey.from_public_bytes(base64.b64decode(row['public_key_b64'],validate=True)).verify(base64.b64decode(row['signature_b64'],validate=True),_v183_json(obj).encode())
        return {'valid':True,'reason':'GLOBAL_CHECKPOINT_VERIFIED'}
    except Exception:return {'valid':False,'reason':'GLOBAL_CHECKPOINT_SIGNATURE_INVALID'}
def _v183_ckpt_rows(c): return c.execute('SELECT * FROM production_global_evidence_checkpoints ORDER BY checkpoint_no ASC').fetchall()
def _v183_verify_checkpoints(c):
    rows=_v183_ckpt_rows(c); prev=0
    for row in rows:
        if int(row['checkpoint_no'])!=prev+1:return {'valid':False,'reason':'GLOBAL_CHECKPOINT_SEQUENCE_BROKEN','checked':prev,'count':len(rows)}
        vr=_v183_verify_checkpoint(c,row)
        if not vr['valid']: return {'valid':False,'reason':vr['reason'],'checked':prev,'count':len(rows)}
        prev=int(row['checkpoint_no'])
    return {'valid':True,'reason':'GLOBAL_CHECKPOINTS_VERIFIED','checked':len(rows),'count':len(rows)}
def _v183_quorum(v):
    try:q=int(v or os.getenv('WUNOO_GLOBAL_CHECKPOINT_QUORUM','2'))
    except:q=2
    if q<1:return 2
    return q
def _v183_attestation_payload(cp,wid,keyid): return {'format':_V183_POLICY['attestation_format'],'schema_version':'1.83','checkpoint_sha256':cp['checkpoint_sha256'],'witness_id':wid,'key_id':keyid}
def _v183_verify_attestation(c,row):
    try:
        reg=_v170_row(c,'production_external_witness_registry',' WHERE witness_id=?',(row['witness_id'],),'updated_at DESC')
        if not reg or reg['status']!='ACTIVE' or reg['current_key_id']!=row['key_id'] or reg['current_public_key_b64']!=row['public_key_b64']: return {'valid':False,'reason':'WITNESS_NOT_ACTIVE_OR_KEY_CHANGED'}
        cp=_v170_row(c,'production_global_evidence_checkpoints',' WHERE id=?',(row['checkpoint_id'],),'created_at DESC')
        if not cp or cp['checkpoint_sha256']!=row['checkpoint_sha256']:return {'valid':False,'reason':'GLOBAL_CHECKPOINT_NOT_FOUND_OR_CHANGED'}
        obj=json.loads(row['attestation_json'] or '{}'); expected=_v183_attestation_payload(cp,row['witness_id'],row['key_id'])
        if obj!=expected or _v183_hash(obj)!=row['attestation_sha256']:return {'valid':False,'reason':'GLOBAL_CHECKPOINT_ATTESTATION_BINDING_INVALID'}
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto(); Ed25519PublicKey.from_public_bytes(base64.b64decode(row['public_key_b64'],validate=True)).verify(base64.b64decode(row['signature_b64'],validate=True),_v183_json(obj).encode())
        return {'valid':True,'reason':'GLOBAL_CHECKPOINT_ATTESTATION_VERIFIED'}
    except Exception:return {'valid':False,'reason':'GLOBAL_CHECKPOINT_ATTESTATION_INVALID'}
def _v183_verify_finality(c,row):
    try:
        cp=_v170_row(c,'production_global_evidence_checkpoints',' WHERE id=?',(row['checkpoint_id'],),'created_at DESC')
        if not cp or cp['checkpoint_sha256']!=row['checkpoint_sha256']:return {'valid':False,'reason':'GLOBAL_CHECKPOINT_NOT_FOUND'}
        cv=_v183_verify_checkpoint(c,cp)
        if not cv['valid']:return cv
        ids=json.loads(row['witness_ids_json'] or '[]'); hashes=json.loads(row['attestation_hashes_json'] or '[]')
        if len(ids)!=int(row['witness_count']) or len(ids)<int(row['quorum_required']) or len(set(ids))!=len(ids):return {'valid':False,'reason':'GLOBAL_CHECKPOINT_QUORUM_INVALID'}
        rows=c.execute('SELECT * FROM production_global_evidence_checkpoint_attestations WHERE checkpoint_id=? ORDER BY witness_id ASC,attestation_sha256 ASC',(cp['id'],)).fetchall(); valid={}
        for a in rows:
            va=_v183_verify_attestation(c,a)
            if va['valid']:valid[a['witness_id']]=a
        chosen=[valid[x] for x in ids if x in valid]
        if len(chosen)!=len(ids) or [x['attestation_sha256'] for x in chosen]!=hashes:return {'valid':False,'reason':'GLOBAL_CHECKPOINT_ATTESTATIONS_CHANGED'}
        proof=json.loads(row['proof_json'] or '{}')
        if proof.get('format')!=_V183_POLICY['finality_format'] or proof.get('schema_version')!='1.83' or proof.get('checkpoint_sha256')!=cp['checkpoint_sha256'] or proof.get('witness_ids')!=ids or proof.get('attestation_hashes')!=hashes:return {'valid':False,'reason':'GLOBAL_CHECKPOINT_FINALITY_PROOF_INVALID'}
        if _v183_hash(proof)!=row['proof_sha256']:return {'valid':False,'reason':'GLOBAL_CHECKPOINT_FINALITY_HASH_INVALID'}
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto(); Ed25519PublicKey.from_public_bytes(base64.b64decode(row['public_key_b64'],validate=True)).verify(base64.b64decode(row['signature_b64'],validate=True),_v183_json(proof).encode())
        return {'valid':True,'reason':'GLOBAL_CHECKPOINT_FINALITY_VERIFIED','witness_count':len(chosen)}
    except Exception:return {'valid':False,'reason':'GLOBAL_CHECKPOINT_FINALITY_INVALID'}

@app.get('/api/v183/ops/global-evidence-checkpoints/policy')
def v183_policy(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); return _V183_POLICY
@app.post('/api/v183/ops/global-evidence-checkpoints/issue')
def v183_issue(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin'}); p=payload or {}; operator=str(u.get('email') or u.get('id') or 'operator')
    with core_db_connect() as c:
        chain=_v182_verify_chain(c)
        if not chain['valid']:raise HTTPException(409,chain['reason'])
        if not chain['checked']:raise HTTPException(409,'GLOBAL_CHAIN_EMPTY')
        head=_v170_row(c,'production_global_evidence_root_chain',order='sequence_no DESC'); existing=_v170_row(c,'production_global_evidence_checkpoints',' WHERE sequence_no=?',(head['sequence_no'],),'created_at DESC')
        if existing:return {'schema_version':'1.83','idempotent':True,'checkpoint':dict(existing),'verification':_v183_verify_checkpoint(c,existing)}
        last=_v170_row(c,'production_global_evidence_checkpoints',order='checkpoint_no DESC'); no=(int(last['checkpoint_no']) if last else 0)+1; t=now(); obj=_v183_ckpt_payload(int(head['sequence_no']),head['entry_sha256'],head['root_sha256'],int(chain['chain_length']),t); digest=_v183_hash(obj); signer,pub,keyid=_v183_signer(); sig=base64.b64encode(signer.sign(_v183_json(obj).encode())).decode(); cid='gcp_'+uuid.uuid4().hex[:16]
        c.execute('INSERT INTO production_global_evidence_checkpoints(id,checkpoint_no,sequence_no,head_entry_sha256,head_root_sha256,chain_length,checkpoint_json,checkpoint_sha256,algorithm,signer_key_id,public_key_b64,signature_b64,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(cid,no,obj['sequence_no'],obj['head_entry_sha256'],obj['head_root_sha256'],obj['chain_length'],_v183_json(obj),digest,'Ed25519',keyid,base64.b64encode(pub).decode(),sig,'SEALED',t,operator));c.commit();row=_v170_row(c,'production_global_evidence_checkpoints',' WHERE id=?',(cid,),'created_at DESC');return {'schema_version':'1.83','idempotent':False,'checkpoint':dict(row),'verification':_v183_verify_checkpoint(c,row)}
@app.post('/api/v183/ops/global-evidence-checkpoints/attest')
def v183_attest(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin'});p=payload or {};operator=str(u.get('email') or u.get('id') or 'operator')
    with core_db_connect() as c:
        cp=_v170_row(c,'production_global_evidence_checkpoints',' WHERE id=?',(p.get('checkpoint_id'),),'created_at DESC');
        if not cp:raise HTTPException(404,'GLOBAL_CHECKPOINT_NOT_FOUND')
        wid=str(p.get('witness_id') or ''); pb=str(p.get('public_key_b64') or ''); sig=str(p.get('signature_b64') or '');
        if not wid or not pb or not sig:raise HTTPException(400,'WITNESS_ID_PUBLIC_KEY_SIGNATURE_REQUIRED')
