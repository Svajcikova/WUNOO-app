@app.get("/api/v096/ops/metrics")
def v096_metrics(authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    with core_db_connect() as c:
        metrics_cutoff=(datetime.now(timezone.utc)-__import__('datetime').timedelta(hours=1)).isoformat()
        rows=c.execute("""SELECT status_code,COUNT(*) n,AVG(duration_ms) avg_ms
                          FROM observability_request_metrics
                          WHERE created_at>=?
                          GROUP BY status_code ORDER BY status_code""",(metrics_cutoff,)).fetchall()
        slow=c.execute("""SELECT path,COUNT(*) n,AVG(duration_ms) avg_ms
                          FROM observability_request_metrics
                          WHERE created_at>=?
                          GROUP BY path ORDER BY avg_ms DESC LIMIT 10""",(metrics_cutoff,)).fetchall()
    return {"window":"1h","status_counts":[dict(x) for x in rows],
            "slowest_paths":[dict(x) for x in slow]}

