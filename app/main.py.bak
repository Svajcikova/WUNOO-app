        aid='fea_'+uuid.uuid4().hex[:16];t=now();c.execute('INSERT INTO production_federation_epoch_attestations(id,epoch_id,epoch_no,epoch_sha256,witness_id,key_id,public_key_b64,signature_b64,attestation_json,attestation_sha256,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?)',(aid,epoch['id'],epoch['epoch_no'],epoch['epoch_sha256'],wid,kid,pb,sig,_v186_json(obj),digest,'VERIFIED',t,operator));c.commit();r=c.execute('SELECT * FROM production_federation_epoch_attestations WHERE id=?',(aid,)).fetchone();return {'schema_version':'1.86','idempotent':False,'attestation':dict(r),'verification':_v186_verify_attestation(c,r)}
