        chk('REFUND_BOUND',int(bad)==0,None if int(bad)==0 else 'REFUND_EXCEEDS_CAPTURED',{'violations':int(bad)})
    except Exception as e: chk('REFUND_BOUND',False,'QUERY_EXCEPTION',str(e))
    return {'valid':all(x['valid'] for x in checks),'checks':checks,'integrity_state':'WEBHOOK_RACE_AND_REFUND_RECONCILIATION_PROTECTED'}
def _v112_payload(no,result): return {'format':_V112_POLICY['format'],'schema_version':'1.112','gate_no':int(no),'checks':result['checks'],'overall_valid':bool(result['valid']),'integrity_state':result['integrity_state']}
def _v112_verify(c,row):
    try:
        if not row:return {'valid':False,'reason':'NO_GATE'}
        obj=json.loads(row['gate_json'] or '{}')
        if obj.get('format')!=_V112_POLICY['format'] or obj.get('schema_version')!='1.112': return {'valid':False,'reason':'V112_FORMAT_INVALID'}
        if _v112_hash(obj)!=row['gate_sha256']: return {'valid':False,'reason':'V112_HASH_INVALID'}
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto(); pub=base64.b64decode(row['public_key_b64'],validate=True); Ed25519PublicKey.from_public_bytes(pub).verify(base64.b64decode(row['signature_b64'],validate=True),_v112_json(obj).encode())
        if _v176_key_id(pub)!=row['signer_key_id']: return {'valid':False,'reason':'V112_SIGNER_KEY_ID_INVALID'}
        if int(row['gate_no'])!=int(obj.get('gate_no',-1)) or (row['status']=='VALID')!=bool(obj.get('overall_valid')): return {'valid':False,'reason':'V112_METADATA_INVALID'}
        return {'valid':True,'gate_no':int(row['gate_no']),'overall_valid':bool(obj.get('overall_valid'))}
    except Exception:return {'valid':False,'reason':'V112_GATE_INVALID'}
