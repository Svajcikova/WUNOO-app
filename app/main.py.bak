@app.post("/api/v049/orders/{order_id}/payment-intent")
def v049_payment_intent(order_id:str, authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,"customer")
    with core_db_connect() as c:
        o=c.execute("SELECT * FROM orders WHERE id=?",(order_id,)).fetchone()
        if not o or o["customer_id"]!=u["customer_id"]: raise HTTPException(404,"Objednávka nenalezena")
        existing=c.execute("SELECT * FROM payment_intents WHERE order_id=?",(order_id,)).fetchone()
        if existing:
            return {"payment_intent_id":existing["id"],"provider_intent_id":existing["provider_intent_id"],"status":existing["status"],"amount_czk":existing["amount_czk"],"idempotent":True}
        intent_id="pi_"+uuid.uuid4().hex[:12]
        provider_intent="test_intent_"+uuid.uuid4().hex[:12]
        c.execute("INSERT INTO payment_intents VALUES (?,?,?,?,?,?,?,?,?)",
                  (intent_id,order_id,float(o["total_czk"]),"CZK","requires_payment_method","test",provider_intent,now(),now()))
        c.commit()
        return {"payment_intent_id":intent_id,"provider_intent_id":provider_intent,"status":"requires_payment_method","amount_czk":o["total_czk"],"idempotent":False}


@app.post("/api/v049/orders/{order_id}/capture")
def v049_capture(order_id:str, authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,"customer")
    with core_db_connect() as c:
        o=c.execute("SELECT * FROM orders WHERE id=?",(order_id,)).fetchone()
        if not o or o["customer_id"]!=u["customer_id"]: raise HTTPException(404,"Objednávka nenalezena")
        p=c.execute("SELECT * FROM payments WHERE order_id=?",(order_id,)).fetchone()
        if p:
            return {"payment_id":p["id"],"status":p["status"],"amount_czk":p["amount_czk"],"idempotent":True}
        intent=c.execute("SELECT * FROM payment_intents WHERE order_id=?",(order_id,)).fetchone()
        if not intent: raise HTTPException(409,"Neexistuje payment intent")
        payment_id="pay_"+uuid.uuid4().hex[:10]
        c.execute("INSERT INTO payments VALUES (?,?,?,?,?,?)",
                  (payment_id,order_id,intent["provider_intent_id"],intent["amount_czk"],"captured",now()))
        c.execute("UPDATE payment_intents SET status='succeeded',updated_at=? WHERE id=?",(now(),intent["id"]))
        if o["status"]=="payment_pending":
            transition(c,order_id,"payment_pending","merchant_pending",u,"payment_captured_v049",{"payment_id":payment_id,"amount_czk":intent["amount_czk"]})
        reconcile=_v049_reconcile_order(c,order_id)
        c.commit()
        return {"payment_id":payment_id,"status":"captured","amount_czk":intent["amount_czk"],"reconciliation":reconcile,"idempotent":False}


def _process_v049_payment_webhook(provider:str, body:dict[str,Any])->dict[str,Any]:
    event_id=str(body.get("id","")).strip()
    event_type=str(body.get("type","")).strip()
    if not event_id or not event_type: raise HTTPException(400,"Webhook id/type jsou povinné")
    with closing(conn()) as c:
        c.execute("BEGIN")
        existing=c.execute("SELECT * FROM payment_webhook_events WHERE provider_event_id=?",(event_id,)).fetchone()
        if existing: return {"event_id":event_id,"status":existing["status"],"idempotent":True}
        wid="wh_"+uuid.uuid4().hex[:10]
        c.execute("""INSERT INTO payment_webhook_events
            (id, provider_event_id, event_type, payment_intent_id, payload_json, status, processed_at, created_at)
            VALUES (?,?,?,?,?,?,?,?)""",
            (wid, event_id, event_type, body.get("payment_intent_id"), json.dumps(body,ensure_ascii=False), "pending", None, now()))
        order_id=body.get("order_id")
        if event_type in {"payment_succeeded","charge_succeeded"} and order_id:
            o=c.execute("SELECT * FROM orders WHERE id=?",(order_id,)).fetchone()
            if o and not c.execute("SELECT 1 FROM payments WHERE order_id=?",(order_id,)).fetchone():
                payment_id="pay_"+uuid.uuid4().hex[:10]
                try:
                    amount=float(body.get("amount_czk",o["total_czk"]))
                except (TypeError, ValueError):
                    raise HTTPException(400,"amount_czk je neplatná")
                expected=float(o["total_czk"])
                if abs(amount-expected)>0.01:
                    raise HTTPException(409,"Částka webhooku neodpovídá objednávce")
                c.execute("INSERT INTO payments VALUES (?,?,?,?,?,?)",(payment_id,order_id,event_id,amount,"captured",now()))
                transition(c, order_id, "payment_pending", "merchant_pending", {"id":"system:payment_webhook"}, "payment_webhook_succeeded", {"payment_id":payment_id,"amount_czk":amount})
        c.execute("UPDATE payment_webhook_events SET status='processed',processed_at=? WHERE id=?",(now(),wid))
        c.commit()
        return {"event_id":event_id,"status":"processed","idempotent":False}

@app.post("/api/v049/webhooks/{provider}")
async def v049_payment_webhook(provider:str, request:Request,
                               x_wunoo_signature:str|None=Header(default=None, alias="X-WUNOO-Signature"))->dict[str,Any]:
    raw=await request.body()
    _verify_webhook_signature(raw, x_wunoo_signature, required=True)
    try:
        body=json.loads(raw.decode("utf-8"))
    except Exception:
        raise HTTPException(400,"Neplatné JSON tělo webhooku")
    return _process_v049_payment_webhook(provider, body)


@app.post("/api/v049/orders/{order_id}/partial-refund")
def v049_partial_refund(order_id:str, body:dict[str,Any], authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,"admin")
    amount=round(float(body.get("amount_czk",0)),2)
    if amount<=0: raise HTTPException(400,"Částka musí být > 0")
    with core_db_connect() as c:
        c.execute("BEGIN")
        p=c.execute("SELECT * FROM payments WHERE order_id=?",(order_id,)).fetchone()
        if not p or p["status"] not in {"captured","refunded"}: raise HTTPException(409,"Captured payment neexistuje")
        refunded=float(c.execute("SELECT COALESCE(SUM(amount_czk),0) x FROM refunds WHERE order_id=? AND status='succeeded'",(order_id,)).fetchone()["x"])
        remaining=round(float(p["amount_czk"])-refunded,2)
        if amount>remaining: raise HTTPException(409,"Refund převyšuje zbývající částku")
        rid="re_"+uuid.uuid4().hex[:10]; pref="rf_test_"+uuid.uuid4().hex[:12]
        insert_refund(c, rid, order_id, p["id"], amount, "admin_partial_refund", "succeeded", pref)
        if amount==remaining: c.execute("UPDATE payments SET status='refunded' WHERE order_id=?",(order_id,))
        recon=_v049_reconcile_order(c,order_id)
        emit(c,order_id,"refund_completed",{"refund_id":rid,"amount_czk":amount,"partial":amount<remaining},u["id"])
        c.commit()
        return {"refund_id":rid,"amount_czk":amount,"status":"succeeded","remaining_refundable_czk":round(remaining-amount,2),"reconciliation":recon}


