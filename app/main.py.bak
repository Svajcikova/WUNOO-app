@app.post("/api/v050/orders/{order_id}/operator-action")
def v050_operator_action(order_id:str, body:dict[str,Any], authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,"admin","ops_agent")
    action=str(body.get("action","")).strip()
    allowed={"refresh_promise","reliability_sweep","redispatch","notify_customer"}
    if action not in allowed: raise HTTPException(400,"Neplatná operator action")
    result={"order_id":order_id,"action":action}
    if action=="refresh_promise":
        result=v042_refresh_promise(order_id,authorization)
    elif action=="redispatch":
        result=v046_redispatch(order_id,authorization)
    elif action=="reliability_sweep":
        result=v046_reliability_sweep(authorization)
    elif action=="notify_customer":
        result=v047_notify_event(order_id,{"event_type":"operator_update","payload":{}},authorization)
    with core_db_connect() as c:
        _v050_audit(c,u["id"],action,"order",order_id,result); c.commit()
    return result


