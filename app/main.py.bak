@app.post("/api/orders/{order_id}/auto-reassign")
def auto_reassign(order_id: str, authorization: str | None = Header(default=None)):
    u=current_user(authorization); require_role(u,"admin")
    with core_db_connect() as c:
        o=c.execute("SELECT * FROM orders WHERE id=?",(order_id,)).fetchone()
        if not o: raise HTTPException(404,"Objednávka nenalezena")
        if o["status"] not in {"assigned","picked_up","out_for_delivery","delayed"}: raise HTTPException(409,"Objednávka není připravená na reassignment")
        loc=c.execute("SELECT * FROM courier_locations WHERE order_id=? ORDER BY recorded_at DESC LIMIT 1",(order_id,)).fetchone() if o["courier_id"] else None
        decision=_recovery_decision(dict(o),dict(loc) if loc else None)
        if decision["action"] not in {"REASSIGN","REASSIGN_OR_NOTIFY","REASSIGN_OR_VERIFY"}:
            return {"ok":True,"reassigned":False,"reason":"recovery_not_triggered"}
        previous=o["courier_id"]
        emit(c,order_id,"reassignment_initiated",{"reason":decision["reason"],"previous_courier_id":previous},u["id"])
        c.execute("UPDATE orders SET courier_id=NULL,status='dispatch_pending',updated_at=? WHERE id=? AND status IN ('assigned','picked_up','out_for_delivery','delayed')",(now(),order_id))
        emit(c,order_id,"returned_to_dispatch",{"reason":decision["reason"]},u["id"])
        c.commit()
    return {"ok":True,"reassigned":True,"order_id":order_id,"status":"dispatch_pending","previous_courier_id":previous,"reason":decision["reason"]}

