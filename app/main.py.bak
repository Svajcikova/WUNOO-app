@app.get("/api/v070/ops/postgresql")
def v070_postgresql_status(authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    backend=configured_db_backend()
    dsn_set=bool(os.getenv("WUNOO_DATABASE_URL") or os.getenv("DATABASE_URL"))
    result={"configured_backend":backend,"dsn_configured":dsn_set,"adapter_available":True,"live_check":False}
    if backend=="postgresql" and dsn_set:
        try:
            result["live_check"]=PostgreSQLAdapter(os.getenv("WUNOO_DATABASE_URL") or os.getenv("DATABASE_URL")).healthcheck()
        except Exception as exc:
            result["live_error"]=str(exc)
    return result

