@app.get("/api/v035/discovery")
def v035_discovery(
    lat: float | None = None,
    lon: float | None = None,
    q: str | None = None,
    open_now: bool = True,
    max_delivery_fee_czk: float | None = None,
    sort: str = "relevance",
    authorization: str | None = Header(default=None),
) -> dict[str, Any]:
    u=current_user(authorization); require_role(u,"customer")
    from datetime import datetime
    with core_db_connect() as c:
        rows=c.execute("""
            SELECT m.id,m.name,m.prep_minutes,m.active,m.lat,m.lon,
                   COALESCE(mp.category,'Bistro') category,
                   COALESCE(mp.cuisine,'Moderní česká') cuisine,
                   COALESCE(mp.min_order_czk,0) min_order_czk,
                   COALESCE(mp.rating_avg,0) rating_avg,
                   COALESCE(mp.rating_count,0) rating_count,
                   COALESCE(mp.opening_hours_json,'{}') opening_hours_json
            FROM merchants m LEFT JOIN merchant_profiles mp ON mp.merchant_id=m.id
            WHERE m.active=1
        """).fetchall()
        out=[]
        for r in rows:
            x=dict(r)
            hours=json.loads(x.pop("opening_hours_json") or "{}")
            x["open_now"]=_v035_is_open_now(hours, datetime.now())
            if open_now and not x["open_now"]:
                continue
            if q:
                ql=q.lower()
                hit=(ql in x["name"].lower() or ql in x["category"].lower() or ql in x["cuisine"].lower())
                if not hit:
                    mi=c.execute("SELECT 1 FROM menu_items WHERE merchant_id=? AND active=1 AND lower(name) LIKE ? LIMIT 1",
                                 (x["id"],"%"+ql+"%")).fetchone()
                    if not mi: continue
            if lat is None or lon is None:
                # Without customer GPS, do not invent distance. Keep discovery usable but explicitly mark it unknown.
                x["distance_km"]=None
                x["delivery_fee_czk"]=None
                x["delivery_available"]=True
                x["eta_minutes"]=x["prep_minutes"]+15
            else:
                distance=_v035_haversine(float(lat),float(lon),float(x["lat"]),float(x["lon"]))
                fee=_v035_delivery_fee(distance)
                zone=c.execute("SELECT 1 FROM merchant_delivery_zones WHERE merchant_id=? AND ? BETWEEN 0 AND radius_km",
                                (x["id"],distance)).fetchone()
                x["distance_km"]=round(distance,2)
                x["delivery_fee_czk"]=fee
                x["delivery_available"]=bool(zone and fee is not None)
                x["eta_minutes"]=round(float(x["prep_minutes"])+max(10,distance/0.4))
                if not x["delivery_available"]: continue
                if max_delivery_fee_czk is not None and fee > max_delivery_fee_czk: continue
            x["score"]=round(x["rating_avg"]*10 + max(0,40-x["eta_minutes"]) + (8 if x["open_now"] else 0),2)
            out.append(x)
        if sort=="distance":
            out.sort(key=lambda z:(float(z["distance_km"]) if z["distance_km"] is not None else 9999,-z["rating_avg"],z["name"]))
        elif sort=="eta":
            out.sort(key=lambda z:(z["eta_minutes"],-z["rating_avg"],z["name"]))
        elif sort=="rating":
            out.sort(key=lambda z:(-z["rating_avg"],z["eta_minutes"],z["name"]))
        else:
            out.sort(key=lambda z:(-z["score"],z["name"]))
        return {"restaurants":out,"location_used":lat is not None and lon is not None}


