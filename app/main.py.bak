@app.get("/api/orders/{order_id}/price-snapshot")
def order_price_snapshot(order_id: str, authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u = current_user(authorization)
    with core_db_connect() as c:
        o = c.execute("SELECT * FROM orders WHERE id=?", (order_id,)).fetchone()
        if not o:
            raise HTTPException(404, "Objednávka nenalezena")
        if u["role"] == "customer" and o["customer_id"] != u["customer_id"]:
            raise HTTPException(403, "Objednávka není vaše")
        if u["role"] == "merchant" and o["merchant_id"] != u["merchant_id"]:
            raise HTTPException(403, "Objednávka není dostupná")
        return {
            "order_id": order_id,
            "pricing_version": o["pricing_version"],
            "snapshot": {
                "subtotal_czk": o["subtotal_czk"],
                "delivery_fee_czk": o["delivery_fee_czk"],
                "service_fee_czk": o["service_fee_czk"],
                "pro_discount_czk": o["pro_discount_czk"],
                "total_czk": o["total_czk"]
            }
        }


@app.get("/api/admin/control-tower")
def admin_control_tower(authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u = current_user(authorization); require_role(u, "admin")
    with core_db_connect() as c:
        total = c.execute("SELECT COUNT(*) AS n FROM orders").fetchone()["n"]
        active = c.execute("SELECT COUNT(*) AS n FROM orders WHERE status NOT IN ('delivered','cancelled')").fetchone()["n"]
        delivered = c.execute("SELECT COUNT(*) AS n FROM orders WHERE status='delivered'").fetchone()["n"]
        captured = c.execute("SELECT COALESCE(SUM(amount_czk),0) AS n FROM payments WHERE status='captured'").fetchone()["n"]
        settlements = c.execute("SELECT COALESCE(SUM(variance_czk),0) AS n FROM settlements").fetchone()["n"]
        online_couriers = c.execute("SELECT COUNT(*) AS n FROM couriers WHERE status='online' AND verified=1").fetchone()["n"]
        active_merchants = c.execute("SELECT COUNT(*) AS n FROM merchants WHERE active=1").fetchone()["n"]
        p0_finance = c.execute(
            "SELECT COUNT(*) AS n FROM settlements WHERE ABS(variance_czk) > 0.01"
        ).fetchone()["n"]
        return {
            "orders_today": total,
            "total_orders": total,
            "in_progress": active,
            "delivered": delivered,
            "captured_czk": float(captured or 0),
            "settlement_variance": float(settlements or 0),
            "online_couriers": online_couriers,
            "active_merchants": active_merchants,
            "p0_finance_exceptions": p0_finance,
            "priority_order": [
                "P0 incidents",
                "finance exceptions",
                "stuck orders",
                "dispatch failures",
                "customer recovery",
                "fraud/trust",
                "marketplace liquidity"
            ]
        }


