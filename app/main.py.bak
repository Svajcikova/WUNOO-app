class PostgreSQLAdapter:
    """Production adapter contract. Requires psycopg/psycopg_pool at deployment time."""
    placeholder = "%s"
    backend = "postgresql"

    def __init__(self, dsn:str):
        self.dsn=dsn
        self._pool=None

    def connect(self):
        try:
            import psycopg
            return psycopg.connect(self.dsn)
        except ImportError as exc:
            raise RuntimeError("Install psycopg[binary] for PostgreSQL runtime") from exc

    def healthcheck(self):
        with self.connect() as c:
            with c.cursor() as cur:
                cur.execute("SELECT 1")
                cur.fetchone()
        return True


class DBNeutralConnection:
    """DB-neutral connection facade for the core persistence cutover.

    SQLite keeps its native connection. PostgreSQL uses psycopg when explicitly
    selected. The facade normalizes parameter placeholders and row access so
    core request paths can move without changing business logic.
    """
    def __init__(self, raw, backend: str):
        self.raw = raw
        self.backend = backend
        self._cursor = None

    def _sql(self, sql: str) -> str:
        return sql.replace("?", "%s") if self.backend == "postgresql" else sql

    def execute(self, sql, args=()):
        if self.backend == "sqlite":
            return self.raw.execute(sql, args)
        cur = self.raw.cursor(row_factory=None)
        cur.execute(self._sql(sql), args)
        self._cursor = cur
        return DBNeutralCursor(cur)

    def commit(self):
        return self.raw.commit()

    def rollback(self):
        return self.raw.rollback()

    def close(self):
        return self.raw.close()

    def __enter__(self):
        return self

    def __exit__(self, exc_type, exc, tb):
        self.close()


class DBNeutralCursor:
    def __init__(self, cur):
        self.cur = cur
        self.description = cur.description
        self.rowcount = cur.rowcount

    def _dict_row(self, row):
        if row is None:
            return None
        names = [d.name if hasattr(d, "name") else d[0] for d in self.description]
        return {k: v for k, v in zip(names, row)}

    def fetchone(self):
        return self._dict_row(self.cur.fetchone())

    def fetchall(self):
        return [self._dict_row(r) for r in self.cur.fetchall()]


def core_db_connect() -> DBNeutralConnection:
    backend = configured_db_backend()
    if backend == "sqlite":
        return DBNeutralConnection(conn(), "sqlite")
    dsn = os.getenv("WUNOO_DATABASE_URL") or os.getenv("DATABASE_URL")
    if not dsn:
        raise RuntimeError("PostgreSQL backend selected without DATABASE_URL")
    return DBNeutralConnection(PostgreSQLAdapter(dsn).connect(), "postgresql")

def configured_db_backend():
    """Return one canonical backend setting for runtime configuration.

    WUNOO_DATABASE_URL is the authoritative production DSN flag; DATABASE_URL is
    accepted for compatibility with the repository adapter. A PostgreSQL mode
    must never silently fall back to the SQLite request path.
    """
    raw = os.getenv("WUNOO_DB_BACKEND", "") .strip().lower()
    dsn = os.getenv("WUNOO_DATABASE_URL") or os.getenv("DATABASE_URL")
    if raw in {"postgres", "postgresql"} or (dsn and dsn.startswith(("postgresql://", "postgres://"))):
        return "postgresql"
    return "sqlite"


def enforce_database_runtime_guard() -> None:
    """Fail closed on production database misconfiguration; never split-brain SQLite/PG."""
    backend = configured_db_backend()
    env = os.getenv("WUNOO_ENV", "development").strip().lower()
    if env in {"prod", "production", "staging"} and backend != "postgresql":
        raise RuntimeError(
            "Production WUNOO requires PostgreSQL; refusing to start with the SQLite fallback."
        )


def _v142_postgresql_migration_files():
    root = BASE.parent / "migrations" / "postgresql"
    return sorted(root.glob("*.sql"), key=lambda p: p.name)

def _v142_bootstrap_postgresql() -> dict[str, Any]:
    """Apply the repository's idempotent PostgreSQL migration artifacts at startup.

    PostgreSQL startup deliberately does NOT execute the historical SQLite migration
    chain. The canonical SQL artifacts are the only schema source for the PG runtime.
    """
    dsn = os.getenv("WUNOO_DATABASE_URL") or os.getenv("DATABASE_URL")
    if not dsn:
        raise RuntimeError("PostgreSQL backend selected without DATABASE_URL")
    try:
        import psycopg
    except ImportError as exc:
        raise RuntimeError("Install psycopg[binary] for PostgreSQL runtime") from exc
    from datetime import datetime, timezone
    files = _v142_postgresql_migration_files()
    if not files:
        raise RuntimeError("No PostgreSQL migration artifacts found")
    with psycopg.connect(dsn, autocommit=True) as pg:
        with pg.cursor() as cur:
            cur.execute("CREATE TABLE IF NOT EXISTS schema_migrations (version TEXT PRIMARY KEY, checksum TEXT NOT NULL, description TEXT NOT NULL, applied_at TEXT NOT NULL, status TEXT NOT NULL)")
            applied=[]
            for path in files:
                version = "pg." + path.stem
                checksum = hashlib.sha256(path.read_bytes()).hexdigest()
                row = cur.execute("SELECT checksum,status FROM schema_migrations WHERE version=%s", (version,)).fetchone()
                if row and row[0] == checksum and row[1] == "applied":
                    applied.append({"version":version,"status":"already_applied"})
                    continue
                sql = path.read_text(encoding="utf-8")
                try:
                    cur.execute(sql)
                    cur.execute("INSERT INTO schema_migrations(version,checksum,description,applied_at,status) VALUES(%s,%s,%s,%s,%s) ON CONFLICT(version) DO UPDATE SET checksum=EXCLUDED.checksum,description=EXCLUDED.description,applied_at=EXCLUDED.applied_at,status=EXCLUDED.status", (version,checksum,path.name,datetime.now(timezone.utc).isoformat(),"applied"))
                except Exception:
                    cur.execute("INSERT INTO schema_migrations(version,checksum,description,applied_at,status) VALUES(%s,%s,%s,%s,%s) ON CONFLICT(version) DO UPDATE SET checksum=EXCLUDED.checksum,description=EXCLUDED.description,applied_at=EXCLUDED.applied_at,status=EXCLUDED.status", (version,checksum,path.name,datetime.now(timezone.utc).isoformat(),"failed"))
                    raise
                applied.append({"version":version,"status":"applied"})
    return {"migration_count":len(files),"applied":applied}



