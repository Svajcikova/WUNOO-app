# ---------------- v1.45 Final Production Hardening ----------------
def migrate_v145(c):
    c.execute("""CREATE TABLE IF NOT EXISTS production_hardening_checks(
        id TEXT PRIMARY KEY, check_name TEXT NOT NULL, status TEXT NOT NULL,
        details_json TEXT NOT NULL DEFAULT '{}', checked_at TEXT NOT NULL
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_prod_hardening_checked ON production_hardening_checks(check_name,checked_at DESC)")
    c.commit()

def _v145_production_env():
    return os.getenv('WUNOO_ENV','development').strip().lower() in {'prod','production','staging'}

def _v145_config_scan():
    env=_v145_production_env()
    secret=os.getenv('WUNOO_SECRET_KEY','')
    dsn=os.getenv('WUNOO_DATABASE_URL') or os.getenv('DATABASE_URL')
    cors=[x.strip() for x in os.getenv('WUNOO_CORS_ORIGINS','').split(',') if x.strip()]
    allowed_hosts=[x.strip() for x in os.getenv('WUNOO_ALLOWED_HOSTS','').split(',') if x.strip()]
    redis_url=os.getenv('WUNOO_REDIS_URL','').strip()
    log_sink=os.getenv('WUNOO_LOG_SINK_URL','').strip()
    webhook_secret=os.getenv('WUNOO_PAYMENT_WEBHOOK_SECRET','').strip()
    checks={
        'postgres_backend': configured_db_backend()=='postgresql' if env else True,
        'dsn_present': bool(dsn) if env else True,
        'secret_present': bool(secret) if env else True,
        'secret_length': len(secret)>=32 if env else True,
        'payment_webhook_secret_present': bool(webhook_secret) if env else True,
        'allowed_hosts_present': bool(allowed_hosts) if env else True,
        'cors_not_wildcard': '*' not in cors if env else True,
        'debug_disabled': os.getenv('WUNOO_DEBUG','').strip().lower() not in {'1','true','yes','on'} if env else True,
        'redis_url_valid': bool(redis_url) and redis_url.startswith(('redis://','rediss://')) if env else True,
        'log_sink_url_valid': bool(log_sink) and log_sink.startswith(('http://','https://')) if env else True,
        'launcher_not_implicit_demo': 'WUNOO_ENV:-demo' not in (Path(__file__).resolve().parent.parent/'START_WUNOO.sh').read_text(errors='ignore') if env else True,
    }
    return {'production':env,'checks':checks,'cors_origins':cors,'passed':all(checks.values())}

def _v145_source_hardening_scan():
    source=Path(__file__).read_text(encoding='utf-8')
    required=(
        'enforce_database_runtime_guard','_v142_bootstrap_postgresql',
        '_v143_live_pg_gate','_v144_release_candidate_scan',
        'production_hardening_checks','backup_restore_contract',
    )
    symbols={x:(x in source) for x in required}
    return {'required_symbols':symbols,'passed':all(symbols.values())}

def _v145_migration_integrity():
    files=_v142_postgresql_migration_files()
    names=[p.name for p in files]
    checksums=[hashlib.sha256(p.read_bytes()).hexdigest() for p in files]
    return {'file_count':len(files),'unique_names':len(names)==len(set(names)),'nonempty':all(p.stat().st_size>0 for p in files),'checksums_sha256':checksums,'passed':bool(files) and len(names)==len(set(names)) and all(p.stat().st_size>0 for p in files)}

def _v145_backup_restore_contract():
    return {'backup_required':True,'restore_test_required':True,'rpo_minutes':15,'rto_minutes':60,'required_artifacts':['logical_or_managed_postgresql_backup','encrypted_backup_storage','restore_runbook','periodic_restore_verification'],'passed':True}

def _v145_hardening_gate():
    cfg=_v145_config_scan(); src=_v145_source_hardening_scan(); mig=_v145_migration_integrity(); br=_v145_backup_restore_contract()
    return {'schema_version':'1.45','config':cfg,'source_hardening':src,'migration_integrity':mig,'backup_restore_contract':br,'passed':bool(cfg['passed'] and src['passed'] and mig['passed'] and br['passed'])}

@app.get('/api/v145/ops/production-hardening')
def v145_production_hardening(authorization: str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    gate=_v145_hardening_gate(); env=_v145_production_env(); backend=configured_db_backend()
    pg=_v143_live_pg_gate() if backend=='postgresql' else {'executed':False,'passed':False,'reason':'NOT_POSTGRES'}
    final=bool(gate['passed'] and (not env or (backend=='postgresql' and pg.get('passed') is True)))
    blockers=[]
    if not gate['config']['passed']: blockers.append('production_config')
    if not gate['source_hardening']['passed']: blockers.append('source_hardening')
    if not gate['migration_integrity']['passed']: blockers.append('migration_integrity')
    if env and not pg.get('passed'): blockers.append('live_postgresql_gate')
    return {'schema_version':'1.45','gate':'final_production_hardening','production_environment':env,'configured_backend':backend,'passed':final,'blocking_reasons':blockers,'static':gate,'live_postgresql':pg}

@app.get('/api/v145/ops/backup-restore-contract')
def v145_backup_restore_contract(authorization: str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    return {'schema_version':'1.45','contract':_v145_backup_restore_contract(),'operational_rule':'A release is not production-complete until a real PostgreSQL backup has been restored successfully in a disposable environment.'}

# ---------------- v1.47 Release Readiness & Disaster Recovery ----------------
def _v147_external_evidence() -> dict[str, Any]:
    # External evidence must be explicit and structured. A boolean environment
    # variable is not sufficient evidence because it can be asserted without
    # the underlying run artifacts.
    pg = _v146_live_postgresql_preflight() if configured_db_backend() == 'postgresql' else {
        'executed': False, 'passed': False, 'reason': 'NOT_POSTGRES'
    }

    evidence_path = os.getenv('WUNOO_V147_EVIDENCE_JSON','').strip()
    loaded = None
    evidence_error = None
    if evidence_path:
        try:
            ep = Path(evidence_path).expanduser()
            if not ep.is_file():
                raise FileNotFoundError(str(ep))
            loaded = json.loads(ep.read_text(encoding='utf-8'))
            if not isinstance(loaded, dict):
                raise ValueError('evidence root must be an object')
        except Exception as exc:
            evidence_error = f'{type(exc).__name__}: {exc}'

    def evidence_block(name: str, required_fields: tuple[str, ...]) -> dict[str, Any]:
        raw = loaded.get(name) if isinstance(loaded, dict) else None
        if not isinstance(raw, dict):
            return {'executed': False, 'passed': False, 'reason': 'MISSING_EVIDENCE', 'required_fields': list(required_fields)}
        missing = [k for k in required_fields if not raw.get(k)]
        passed = bool(raw.get('executed') is True and raw.get('passed') is True and not missing)
        return {
            'executed': bool(raw.get('executed') is True),
            'passed': passed,
            'reason': 'EVIDENCE_FILE' if passed else ('MISSING_FIELDS' if missing else 'NOT_PASSED'),
            'missing_fields': missing,
            'evidence': raw,
        }

    concurrency = evidence_block(
        'concurrency',
        ('runner','run_id','started_at','completed_at','test_count','passed_tests'),
    )
    restore = evidence_block(
        'backup_restore',
        ('backup_identifier','restore_target','restore_started_at','restore_completed_at','smoke_test_result'),
    )
    return {
        'postgresql': pg,
        'concurrency': concurrency,
        'backup_restore': restore,
        'evidence_file': evidence_path or None,
        'evidence_file_error': evidence_error,
        'evidence_file_loaded': loaded is not None,
    }

def _v147_release_readiness() -> dict[str, Any]:
    deployment = _v146_deployment_gate()
    hardening = _v145_hardening_gate()
    artifacts = _v146_release_artifacts()
    evidence = _v147_external_evidence()
    blockers=[]
    if not hardening['passed']: blockers.append('static_hardening')
    if not artifacts['passed']: blockers.append('release_artifacts')
    if not deployment['live_postgresql'].get('passed'): blockers.append('live_postgresql')
    if not evidence['concurrency']['passed']: blockers.append('live_concurrency')
    if not evidence['backup_restore']['passed']: blockers.append('backup_restore_drill')
    production_env=_v146_production_env()
    passed=not blockers and production_env and configured_db_backend()=='postgresql'
    return {
        'schema_version':'1.47',
        'gate':'release_readiness',
        'production_environment':production_env,
        'configured_backend':configured_db_backend(),
        'passed':passed,
        'blocking_reasons':blockers,
        'static':{'hardening':hardening,'artifacts':artifacts},
        'external_evidence':evidence,
        'signoff_rule':'PASS requires real target PostgreSQL, concurrency evidence and a successful disposable restore smoke test.'
    }

def _v147_backup_restore_readiness() -> dict[str, Any]:
    e=_v147_external_evidence()['backup_restore']
    return {'schema_version':'1.47','gate':'backup_restore_readiness','passed':bool(e['passed']),'evidence':e,
            'rpo_minutes':15,'rto_minutes':60}

@app.get('/api/v147/ops/release-readiness')
def v147_release_readiness(authorization: str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u, {'admin','ops_agent'})
    return _v147_release_readiness()

@app.get('/api/v147/ops/backup-restore-readiness')
def v147_backup_restore_readiness(authorization: str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u, {'admin','ops_agent'})
    return _v147_backup_restore_readiness()

# ---------------- v1.48 Immutable Release Evidence & Artifact Integrity ----------------
def migrate_v148(c):
    c.execute("""CREATE TABLE IF NOT EXISTS release_artifact_attestations(
        id TEXT PRIMARY KEY, release_version TEXT NOT NULL, manifest_sha256 TEXT NOT NULL,
        evidence_json TEXT NOT NULL DEFAULT '{}', attested_by TEXT NOT NULL, created_at TEXT NOT NULL
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_release_attestations_version_time ON release_artifact_attestations(release_version, created_at DESC)")
    try: c.commit()
    except Exception: pass

def _v148_release_root() -> Path: return BASE.parent

def _v148_manifest_scope(rel: str) -> bool:
    if rel.startswith(('.git/','__pycache__/','.pytest_cache/','logs/')): return False
    if rel in {'wunoo.db'} or rel.endswith(('.db','.db-wal','.db-shm')): return False
    if rel.endswith('.zip') or rel.endswith('.sha256'): return False
    if rel.startswith('release_evidence/') or rel.startswith('runtime_evidence/'): return False
    return True

def _v148_manifest() -> dict[str, Any]:
    root=_v148_release_root(); files=[]
    for path in sorted(root.rglob('*')):
        if not path.is_file(): continue
        rel=path.relative_to(root).as_posix()
        if not _v148_manifest_scope(rel): continue
        data=path.read_bytes(); files.append({'path':rel,'size':len(data),'sha256':hashlib.sha256(data).hexdigest()})
    payload={'schema_version':'1.48','algorithm':'sha256','scope':'release-source-v1','file_count':len(files),'files':files}
    payload['manifest_sha256']=hashlib.sha256(json.dumps(payload,sort_keys=True,separators=(',',':')).encode()).hexdigest()
    return payload

def _v148_required_artifacts() -> tuple[str,...]:
    return ('app/main.py','app/repository.py','requirements-production.txt','Dockerfile','docker-compose.production.yml','RUN_V143_PG_CONCURRENCY_GATE.py','RUN_V146_PRODUCTION_PREFLIGHT.py','RUN_V147_RELEASE_READINESS.py')

def _v148_artifact_integrity() -> dict[str,Any]:
    root=_v148_release_root(); missing=[x for x in _v148_required_artifacts() if not (root/x).is_file()]; m=_v148_manifest()
    return {'required_artifacts':list(_v148_required_artifacts()),'missing':missing,'manifest_sha256':m['manifest_sha256'],'file_count':m['file_count'],'scope':m['scope'],'passed':bool(m['file_count'] and not missing)}

def _v148_latest_attestation(manifest_sha256: str|None=None) -> dict[str,Any]:
    try:
        with core_db_connect() as db:
            row=db.execute("SELECT id,release_version,manifest_sha256,evidence_json,attested_by,created_at FROM release_artifact_attestations WHERE release_version=? ORDER BY created_at DESC LIMIT 1",('1.48',)).fetchone()
        if not row: return {'present':False,'passed':False,'reason':'ATTESTATION_MISSING'}
        evidence=json.loads(row[3] or '{}')
        sig=str(evidence.get('signature') or '')
        expected_manifest=manifest_sha256 or str(row[2])
        secret=os.getenv('WUNOO_RELEASE_ATTESTATION_SECRET','').strip()
        expected_sig=hmac.new(secret.encode(),expected_manifest.encode(),hashlib.sha256).hexdigest() if secret else ''
        valid=bool(secret and row[2]==expected_manifest and evidence.get('manifest_sha256')==expected_manifest and hmac.compare_digest(sig,expected_sig))
        return {'present':True,'passed':valid,'attestation_id':str(row[0]),'release_version':str(row[1]),'manifest_sha256':str(row[2]),'attested_by':str(row[4]),'created_at':str(row[5]),'signature_valid':valid}
    except Exception as exc:
        return {'present':False,'passed':False,'reason':'ATTESTATION_LOOKUP_FAILED','error':str(exc)[:300]}

def _v148_integrity_gate() -> dict[str,Any]:
    a=_v148_artifact_integrity(); secret=bool(os.getenv('WUNOO_RELEASE_ATTESTATION_SECRET','').strip()); m=_v148_manifest()
    att=_v148_latest_attestation(m['manifest_sha256']) if secret else {'present':False,'passed':False,'reason':'ATTESTATION_SECRET_MISSING'}
    passed=bool(a['passed'] and secret and att.get('passed'))
    return {'schema_version':'1.48','gate':'immutable_release_integrity','artifact_integrity':a,'attestation_secret_configured':secret,'latest_attestation':att,'passed':passed,'rule':'Release sign-off requires the current release manifest plus a valid HMAC attestation whose stored manifest hash exactly matches the current manifest.'}

@app.get('/api/v148/ops/release-manifest')
def v148_release_manifest(authorization: str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u, {'admin','ops_agent'}); return {'schema_version':'1.48','manifest':_v148_manifest()}

@app.get('/api/v148/ops/integrity-gate')
def v148_integrity_gate(authorization: str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u, {'admin','ops_agent'}); return _v148_integrity_gate()

@app.post('/api/v148/ops/attest-release')
def v148_attest_release(authorization: str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u, {'admin','ops_agent'})
    secret=os.getenv('WUNOO_RELEASE_ATTESTATION_SECRET','').strip()
    if not secret: raise HTTPException(status_code=503, detail='Release attestation secret is not configured')
    m=_v148_manifest(); sig=hmac.new(secret.encode(),m['manifest_sha256'].encode(),hashlib.sha256).hexdigest()
    evidence=json.dumps({'manifest_sha256':m['manifest_sha256'],'signature':sig,'artifact_file_count':m['file_count'],'scope':m['scope']},sort_keys=True)
    with core_db_connect() as db:
        db.execute("INSERT INTO release_artifact_attestations(id,release_version,manifest_sha256,evidence_json,attested_by,created_at) VALUES(?,?,?,?,?,?)",('att_'+uuid.uuid4().hex[:16],'1.48',m['manifest_sha256'],evidence,str(u.get('email') or u.get('id') or 'operator'),now())); db.commit()
    return {'schema_version':'1.48','attested':True,'release_version':'1.48','manifest_sha256':m['manifest_sha256'],'artifact_file_count':m['file_count'],'signature_stored':True}

# ---------------- v1.46 Production Deployment Verification ----------------
def _v146_production_env() -> bool:
    return os.getenv('WUNOO_ENV','development').strip().lower() in {'prod','production','staging'}

def _v146_required_tables() -> tuple[str, ...]:
    return tuple(_V142_REQUIRED_TABLES)

def _v146_migration_head() -> str:
    files = _v142_postgresql_migration_files()
    return files[-1].stem if files else ''

def _v146_live_postgresql_preflight() -> dict[str, Any]:
    dsn = os.getenv('WUNOO_DATABASE_URL') or os.getenv('DATABASE_URL')
    if not dsn:
        return {'executed': False, 'passed': False, 'reason': 'POSTGRES_DSN_MISSING'}
    try:
        import psycopg
    except ImportError:
        return {'executed': False, 'passed': False, 'reason': 'POSTGRES_DRIVER_MISSING'}

    local_migrations = _v142_postgresql_migration_files()
    expected = {}
    for path in local_migrations:
        expected['pg.' + path.stem] = hashlib.sha256(path.read_bytes()).hexdigest()

    try:
        with psycopg.connect(dsn, autocommit=False) as pg:
            with pg.cursor() as cur:
                cur.execute("SELECT current_database(), current_setting('transaction_isolation'), current_setting('server_version_num')")
                database, isolation, server_version_num = cur.fetchone()
                cur.execute("SELECT version, checksum, status FROM schema_migrations ORDER BY version")
                migrations = cur.fetchall()
                cur.execute("SELECT table_name FROM information_schema.tables WHERE table_schema='public'")
                tables = {r[0] for r in cur.fetchall()}
                required = set(_v146_required_tables())
                missing = sorted(required - tables)
                actual = {str(version): {'checksum': str(checksum), 'status': str(status)} for version, checksum, status in migrations}
                expected_versions = set(expected)
                actual_versions = set(actual)
                missing_migrations = sorted(expected_versions - actual_versions)
                unexpected_migrations = sorted(actual_versions - expected_versions)
                checksum_mismatches = sorted(
                    version for version in (expected_versions & actual_versions)
                    if actual[version]['checksum'] != expected[version]
                )
                status_mismatches = sorted(
                    version for version in expected_versions
                    if version in actual and actual[version]['status'] != 'applied'
                )
                head = ('pg.' + _v146_migration_head()) if _v146_migration_head() else ''
                head_applied = str(migrations[-1][0]) if migrations else None
                cur.execute("SELECT 1")
                roundtrip = cur.fetchone()[0] == 1
                cur.execute("SELECT to_regclass('public.production_deployments')")
                deployment_table = cur.fetchone()[0] is not None
            pg.rollback()

        migration_integrity = bool(
            expected_versions
            and actual_versions == expected_versions
            and not checksum_mismatches
            and not status_mismatches
            and not missing_migrations
            and not unexpected_migrations
        )
        passed = bool(roundtrip and not missing and deployment_table and migration_integrity and head_applied == head)
        return {
            'executed': True,
            'passed': passed,
            'database': database,
            'transaction_isolation': isolation,
            'server_version_num': str(server_version_num),
            'migration_count': len(migrations),
            'expected_migration_count': len(expected),
            'applied_migrations': sum(1 for row in migrations if str(row[2]) == 'applied'),
            'migration_head_expected': head,
            'migration_head_applied': head_applied,
            'missing_migrations': missing_migrations,
            'unexpected_migrations': unexpected_migrations,
            'checksum_mismatches': checksum_mismatches,
            'status_mismatches': status_mismatches,
            'migration_integrity': migration_integrity,
            'missing_required_tables': missing,
            'deployment_evidence_table': deployment_table,
            'transaction_roundtrip': roundtrip,
        }
    except Exception as exc:
        return {'executed': True, 'passed': False, 'reason': 'POSTGRES_PREFLIGHT_FAILED', 'error': str(exc)[:300]}

def _v146_release_artifacts() -> dict[str, Any]:
    root = BASE.parent
    required = [
        'START_WUNOO.sh', 'START_WUNOO.bat', 'CHECK_WUNOO.sh',
        'migrate_postgresql_v131.py', 'RUN_V143_PG_CONCURRENCY_GATE.py',
        'migrations/postgresql/001_initial_schema.sql',
        'migrations/postgresql/012_production_deployment.sql',
        'TEST_V145.py', 'TEST_V142.py', 'TEST_V143.py',
    ]
    missing = [x for x in required if not (root / x).exists()]
    return {'required_artifacts': required, 'missing': missing, 'passed': not missing}

def _v146_deployment_gate() -> dict[str, Any]:
    env = _v146_production_env()
    backend = configured_db_backend()
    artifacts = _v146_release_artifacts()
    pg = _v146_live_postgresql_preflight() if backend == 'postgresql' else {'executed': False, 'passed': False, 'reason': 'NOT_POSTGRES'}
    static = _v145_hardening_gate()
    production_pass = bool(static['passed'] and artifacts['passed'] and backend == 'postgresql' and pg.get('executed') and pg.get('passed'))
    return {
        'schema_version': '1.46',
        'gate': 'production_deployment_verification',
        'production_environment': env,
        'configured_backend': backend,
        'static_hardening': static,
        'release_artifacts': artifacts,
        'live_postgresql': pg,
        'production_pass': production_pass,
        'blocking_reasons': [] if production_pass else [
            x for x in [
                'static_hardening' if not static['passed'] else None,
                'release_artifacts' if not artifacts['passed'] else None,
                'postgres_backend' if backend != 'postgresql' else None,
                'live_postgresql' if not pg.get('passed') else None,
            ] if x
        ],
        'operator_action': 'Set WUNOO_ENV=production and WUNOO_DATABASE_URL, run the PostgreSQL migration/bootstrap, then execute the live gate and backup/restore verification.'
    }

@app.get('/api/v146/ops/deployment-gate')
def v146_deployment_gate(authorization: str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u, {'admin','ops_agent'})
    return _v146_deployment_gate()

@app.get('/api/v146/ops/deployment-preflight')
def v146_deployment_preflight(authorization: str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u, {'admin','ops_agent'})
    return _v146_live_postgresql_preflight()



# ---------------- v1.50 Production Observability & Rollback Control ----------------
def migrate_v150(c):
    c.execute("""CREATE TABLE IF NOT EXISTS production_health_windows(
        id TEXT PRIMARY KEY, release_version TEXT NOT NULL, status TEXT NOT NULL,
        started_at TEXT NOT NULL, ended_at TEXT, checks_json TEXT NOT NULL DEFAULT '{}',
        failure_count INTEGER NOT NULL DEFAULT 0, rollback_recommended INTEGER NOT NULL DEFAULT 0,
        operator TEXT
    )""")
    c.execute("""CREATE TABLE IF NOT EXISTS rollback_control_records(
        id TEXT PRIMARY KEY, release_version TEXT NOT NULL, action TEXT NOT NULL,
        reason TEXT NOT NULL, evidence_json TEXT NOT NULL DEFAULT '{}', created_at TEXT NOT NULL,
        operator TEXT
    )""")
    c.execute("""CREATE TABLE IF NOT EXISTS migration_rollback_checkpoints(
        id TEXT PRIMARY KEY, release_version TEXT NOT NULL, migration_head TEXT NOT NULL,
        checkpoint_status TEXT NOT NULL, rollback_strategy TEXT NOT NULL,
        destructive_rollback_allowed INTEGER NOT NULL DEFAULT 0, created_at TEXT NOT NULL
    )""")
    try: c.commit()
    except Exception: pass

def _v150_health_checks() -> dict[str, Any]:
    checks={}
    checks['database_roundtrip']=False
    try:
        with core_db_connect() as db:
            row=db.execute('SELECT 1 AS ok').fetchone()
            checks['database_roundtrip']=bool(row and int(row['ok'])==1)
    except Exception:
        checks['database_roundtrip']=False
    checks['production_env']=_v146_production_env()
    checks['backend_postgresql']=configured_db_backend()=='postgresql' if checks['production_env'] else True
    checks['ready_contract']=True
    checks['rollback_is_fail_closed']=True
    return {'passed':all(checks.values()),'checks':checks}

def _v150_migration_rollback_safety() -> dict[str, Any]:
    # Rollback is intentionally non-destructive: schema downgrades are never automated.
    files=sorted((BASE.parent/'migrations'/'postgresql').glob('*.sql'))
    heads=[x.stem for x in files]
    return {
        'passed':bool(files), 'migration_count':len(files), 'migration_head':heads[-1] if heads else None,
        'destructive_rollback_allowed':False,
        'strategy':'forward_fix_or_restore_from_verified_backup',
        'requires_backup_before_migration':True,
    }

def _v150_observability_gate() -> dict[str, Any]:
    v149=_v149_release_ops_gate()
    health=_v150_health_checks()
    rollback=_v150_migration_rollback_safety()
    blockers=[]
    if not v149.get('passed'): blockers.append('v149_release_operations')
    if not health.get('passed'): blockers.append('runtime_health')
    if not rollback.get('passed'): blockers.append('migration_rollback_safety')
    passed=not blockers
    return {'schema_version':'1.50','gate':'production_observability_rollback','decision':'GO' if passed else 'NO-GO',
            'passed':passed,'blocking_reasons':blockers,'release_health':health,'rollback_safety':rollback,
            'rollback_policy':'AUTO-ROLLBACK may only be recommended after health-window failures; schema rollback is never automatic.'}

def _v150_start_health_window(release_version='1.50', operator=None) -> dict[str, Any]:
    gate=_v150_observability_gate()
    wid='hw_'+uuid.uuid4().hex[:16]
    with core_db_connect() as db:
        db.execute('INSERT INTO production_health_windows(id,release_version,status,started_at,checks_json,operator) VALUES(?,?,?,?,?,?)',
                   (wid,release_version,'running',now(),json.dumps(gate,sort_keys=True),operator))
        db.execute('INSERT INTO migration_rollback_checkpoints(id,release_version,migration_head,checkpoint_status,rollback_strategy,destructive_rollback_allowed,created_at) VALUES(?,?,?,?,?,?,?)',
                   ('cp_'+uuid.uuid4().hex[:16],release_version,str(gate['rollback_safety'].get('migration_head') or ''),'recorded',gate['rollback_safety']['strategy'],0,now()))
        db.commit()
    return {'health_window_id':wid,'status':'running','gate':gate}

def _v150_complete_health_window(window_id: str, operator=None) -> dict[str, Any]:
    with core_db_connect() as db:
        row=db.execute('SELECT * FROM production_health_windows WHERE id=?',(window_id,)).fetchone()
        if not row: raise HTTPException(404,'health window nenalezen')
        if row['status']!='running': return dict(row)
        health=_v150_health_checks()
        failures=0 if health['passed'] else 1
        status='healthy' if health['passed'] else 'failed'
        recommend=0 if health['passed'] else 1
        db.execute('UPDATE production_health_windows SET status=?,ended_at=?,checks_json=?,failure_count=?,rollback_recommended=?,operator=? WHERE id=?',
                   (status,now(),json.dumps(health,sort_keys=True),failures,recommend,operator or row.get('operator'),window_id))
        if recommend:
            db.execute('INSERT INTO rollback_control_records(id,release_version,action,reason,evidence_json,created_at,operator) VALUES(?,?,?,?,?,?,?)',
                       ('rb_'+uuid.uuid4().hex[:16],row['release_version'],'RECOMMEND_ROLLBACK','post_deploy_health_failed',json.dumps(health,sort_keys=True),now(),operator))
        db.commit()
        out=dict(row); out.update({'status':status,'ended_at':now(),'failure_count':failures,'rollback_recommended':bool(recommend),'checks':health})
        return out

@app.get('/api/v150/ops/observability-gate')
def v150_observability_gate(authorization: str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u, {'admin','ops_agent'}); return _v150_observability_gate()

@app.post('/api/v150/ops/health-window/start')
def v150_health_window_start(authorization: str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u, {'admin','ops_agent'}); return _v150_start_health_window('1.50',str(u.get('email') or u.get('id') or 'operator'))

@app.post('/api/v150/ops/health-window/{window_id}/complete')
def v150_health_window_complete(window_id: str, authorization: str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u, {'admin','ops_agent'}); return _v150_complete_health_window(window_id,str(u.get('email') or u.get('id') or 'operator'))

# ---------------- v1.49 Release Operations Orchestration ----------------
def migrate_v149(c):
    c.execute("""CREATE TABLE IF NOT EXISTS release_operation_runs(
        id TEXT PRIMARY KEY, release_version TEXT NOT NULL, decision TEXT NOT NULL,
        evidence_json TEXT NOT NULL DEFAULT '{}', evidence_sha256 TEXT NOT NULL DEFAULT '',
        operator TEXT, created_at TEXT NOT NULL
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_release_ops_runs_version_time ON release_operation_runs(release_version, created_at DESC)")
    # Backfill the new column for databases created by the pre-hardened v1.49 schema.
    try: c.execute("ALTER TABLE release_operation_runs ADD COLUMN evidence_sha256 TEXT NOT NULL DEFAULT ''")
    except Exception: pass
    try: c.commit()
    except Exception: pass

def _v149_runtime_checks() -> dict[str, Any]:
    production=_v146_production_env()
    backend=configured_db_backend()
    dsn=bool(os.getenv('WUNOO_DATABASE_URL') or os.getenv('DATABASE_URL'))
    attestation_secret=os.getenv('WUNOO_RELEASE_ATTESTATION_SECRET','').strip()
    checks={
        'production_environment': production,
        'backend_postgresql': backend == 'postgresql' if production else True,
        'dsn_configured': dsn if production else True,
        'attestation_secret_configured': bool(attestation_secret) if production else True,
        'attestation_secret_length': len(attestation_secret) >= 32 if production else True,
        'debug_disabled': os.getenv('WUNOO_DEBUG','').strip().lower() not in {'1','true','yes','on'} if production else True,
    }
    return {'passed': all(checks.values()), 'checks': checks}

def _v149_evidence_binding() -> dict[str, Any]:
    """Bind release operations to the current v1.48 immutable manifest/attestation."""
    try:
        manifest=_v148_manifest()
        integrity=_v148_integrity_gate()
        current_hash=str(manifest.get('manifest_sha256') or '')
        att=integrity.get('latest_attestation') or {}
        return {
            'manifest_sha256': current_hash,
            'manifest_file_count': int(manifest.get('file_count') or 0),
            'attestation_present': bool(att.get('present')),
            'attestation_passed': bool(att.get('passed')),
            'attestation_manifest_sha256': str(att.get('manifest_sha256') or ''),
            'passed': bool(integrity.get('passed') and att.get('manifest_sha256') == current_hash),
        }
    except Exception as exc:
        return {'passed':False,'reason':'EVIDENCE_BINDING_FAILED','error':str(exc)[:300]}

def _v149_release_ops_gate() -> dict[str, Any]:
    v145=_v145_hardening_gate()
    v146=_v146_deployment_gate()
    v147=_v147_release_readiness()
    v148=_v148_integrity_gate()
    runtime=_v149_runtime_checks()
    binding=_v149_evidence_binding()
    blockers=[]
    for key, stage in (
        ('v145_hardening',v145),('v146_deployment',v146),('v147_release_readiness',v147),
        ('v148_integrity',v148),('runtime_configuration',runtime),('release_evidence_binding',binding)):
        if not stage.get('passed'): blockers.append(key)
    passed=not blockers
    gate={
        'schema_version':'1.49','gate':'release_operations','decision':'GO' if passed else 'NO-GO',
        'passed':passed,'blocking_reasons':blockers,
        'stages':{'v145_hardening':v145,'v146_deployment':v146,'v147_release_readiness':v147,'v148_integrity':v148,'runtime':runtime,'evidence_binding':binding},
        'operator_rule':'GO only when every stage passes on the target environment and the immutable release attestation matches the current source manifest. Development/SQLite evidence cannot satisfy production gates.',
    }
    canonical=json.dumps(gate,sort_keys=True,separators=(',',':')).encode()
    gate['evidence_sha256']=hashlib.sha256(canonical).hexdigest()
    return gate

def _v149_release_run(operator: str|None=None) -> dict[str, Any]:
    gate=_v149_release_ops_gate()
    with core_db_connect() as db:
        run_id='run_'+uuid.uuid4().hex[:16]
        db.execute("INSERT INTO release_operation_runs(id,release_version,decision,evidence_json,evidence_sha256,operator,created_at) VALUES(?,?,?,?,?,?,?)",
                   (run_id,'1.49',gate['decision'],json.dumps(gate,sort_keys=True),gate['evidence_sha256'],operator,now()))
        db.commit()
    return {'run_id':run_id,**gate}

@app.get('/api/v149/ops/release-gate')
def v149_release_gate(authorization: str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u, {'admin','ops_agent'})
    return _v149_release_ops_gate()

@app.post('/api/v149/ops/release-run')
def v149_release_run(authorization: str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u, {'admin','ops_agent'})
    return _v149_release_run(str(u.get('email') or u.get('id') or 'operator'))

# ---------------- v1.51 Final Production Launch Control ----------------
def migrate_v151(c):
    c.execute("""CREATE TABLE IF NOT EXISTS production_launch_runs(
        id TEXT PRIMARY KEY, release_version TEXT NOT NULL, decision TEXT NOT NULL,
        evidence_json TEXT NOT NULL DEFAULT '{}', operator TEXT, created_at TEXT NOT NULL
    )""")
    c.execute("""CREATE TABLE IF NOT EXISTS production_launch_evidence(
        id TEXT PRIMARY KEY, release_version TEXT NOT NULL, evidence_type TEXT NOT NULL,
        status TEXT NOT NULL, evidence_json TEXT NOT NULL DEFAULT '{}', created_at TEXT NOT NULL,
        operator TEXT
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_launch_runs_version_time ON production_launch_runs(release_version, created_at DESC)")
    c.execute("CREATE INDEX IF NOT EXISTS idx_launch_evidence_version_time ON production_launch_evidence(release_version, created_at DESC)")
    try: c.commit()
    except Exception: pass

_V151_REQUIRED_EVIDENCE = (
    'postgresql_live', 'concurrency', 'backup_restore', 'post_deploy_smoke'
)
_V151_EVIDENCE_MAX_AGE_SECONDS = 3600
_V151_EVIDENCE_CLOCK_SKEW_SECONDS = 120

def _v151_evidence_canonical(evidence: dict[str, Any]) -> bytes:
    payload={k:evidence.get(k) for k in (
        'schema_version','evidence_id','release_manifest_sha256','issued_at','expires_at',*(_V151_REQUIRED_EVIDENCE)
    )}
    return json.dumps(payload,sort_keys=True,separators=(',',':')).encode()

def _v151_parse_time(value: Any) -> float | None:
    try:
        return datetime.fromisoformat(str(value).replace('Z','+00:00')).timestamp()
    except Exception:
        return None

def _v151_external_evidence() -> dict[str, Any]:
    """Read operator-supplied evidence and, in production, require a fresh HMAC-bound envelope."""
    raw=os.getenv('WUNOO_PRODUCTION_EVIDENCE_JSON','').strip()
    production=_v146_production_env()
    evidence={}
    if raw:
        try:
            parsed=json.loads(raw)
            if isinstance(parsed,dict): evidence=parsed
            else: return {'valid':False,'reason':'EVIDENCE_JSON_NOT_OBJECT','evidence':{}}
        except Exception:
            return {'valid':False,'reason':'EVIDENCE_JSON_INVALID','evidence':{}}
    normalized={k: bool(evidence.get(k) is True) for k in _V151_REQUIRED_EVIDENCE}
    base={
        'valid':True,'evidence':normalized,'all_required_present':all(normalized.values()),
        'source':'WUNOO_PRODUCTION_EVIDENCE_JSON' if raw else 'none',
        'signed':False,'signature_valid':False,'fresh':False,'manifest_bound':False,
    }
    if not production:
        return base

    secret=os.getenv('WUNOO_RELEASE_ATTESTATION_SECRET','').strip()
    manifest=_v148_manifest()
    issued=_v151_parse_time(evidence.get('issued_at'))
    expires=_v151_parse_time(evidence.get('expires_at'))
    now_ts=datetime.now(timezone.utc).timestamp()
    fresh=bool(issued is not None and expires is not None and
               issued <= now_ts + _V151_EVIDENCE_CLOCK_SKEW_SECONDS and
               expires >= now_ts - _V151_EVIDENCE_CLOCK_SKEW_SECONDS and
               expires >= issued and (expires-issued) <= _V151_EVIDENCE_MAX_AGE_SECONDS)
    manifest_bound=bool(evidence.get('release_manifest_sha256')==manifest.get('manifest_sha256'))
    signature=str(evidence.get('signature') or '')
    expected=hmac.new(secret.encode(),_v151_evidence_canonical(evidence),hashlib.sha256).hexdigest() if secret else ''
    signature_valid=bool(secret and signature and hmac.compare_digest(signature,expected))
    signed=bool(secret and evidence.get('schema_version')=='1.51' and evidence.get('evidence_id') and signature)
    base.update({'signed':signed,'signature_valid':signature_valid,'fresh':fresh,'manifest_bound':manifest_bound,
                 'expected_manifest_sha256':manifest.get('manifest_sha256'),'supplied_manifest_sha256':evidence.get('release_manifest_sha256'),
                 'evidence_id':evidence.get('evidence_id'),'issued_at':evidence.get('issued_at'),'expires_at':evidence.get('expires_at')})
    base['all_required_present']=bool(base['all_required_present'] and signed and signature_valid and fresh and manifest_bound)
    return base

def _v151_launch_gate() -> dict[str, Any]:
    v149=_v149_release_ops_gate()
    v150=_v150_observability_gate()
    external=_v151_external_evidence()
    production=bool(_v146_production_env())
    blockers=[]
    if not production: blockers.append('production_environment_required')
    if not v149.get('passed'): blockers.append('release_operations_gate')
    if not v150.get('passed'): blockers.append('observability_rollback_gate')
    if not external.get('all_required_present'): blockers.append('missing_live_evidence')
    passed=not blockers
    return {
        'schema_version':'1.51','gate':'final_production_launch','decision':'GO' if passed else 'NO-GO',
        'passed':passed,'blocking_reasons':blockers,
        'release_operations':v149,'observability_rollback':v150,
        'required_live_evidence':list(_V151_REQUIRED_EVIDENCE),'external_evidence':external,
        'launch_policy':'GO requires target production PostgreSQL, live concurrency proof, verified backup/restore proof and post-deploy smoke proof. Development/SQLite evidence can never satisfy this gate.'
    }

def _v151_record_evidence(evidence_type: str, status: str, evidence: dict[str,Any], operator: str|None=None):
    if evidence_type not in _V151_REQUIRED_EVIDENCE:
        raise HTTPException(400,'unknown evidence_type')
    if status not in {'PASS','FAIL','NOT_RUN'}:
        raise HTTPException(400,'invalid evidence status')
    with core_db_connect() as db:
        db.execute('INSERT INTO production_launch_evidence(id,release_version,evidence_type,status,evidence_json,created_at,operator) VALUES(?,?,?,?,?,?,?)',
                   ('ev_'+uuid.uuid4().hex[:16],'1.51',evidence_type,status,json.dumps(evidence,sort_keys=True),now(),operator))
        db.commit()

def _v151_launch_run(operator: str|None=None) -> dict[str,Any]:
    gate=_v151_launch_gate()
    with core_db_connect() as db:
        run_id='launch_'+uuid.uuid4().hex[:16]
        db.execute('INSERT INTO production_launch_runs(id,release_version,decision,evidence_json,operator,created_at) VALUES(?,?,?,?,?,?)',
                   (run_id,'1.51',gate['decision'],json.dumps(gate,sort_keys=True),operator,now()))
        db.commit()
    return {'run_id':run_id,**gate}

@app.get('/api/v151/ops/launch-gate')
def v151_launch_gate(authorization: str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    return _v151_launch_gate()

@app.post('/api/v151/ops/launch-run')
def v151_launch_run(authorization: str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    return _v151_launch_run(str(u.get('email') or u.get('id') or 'operator'))

@app.post('/api/v151/ops/evidence/{evidence_type}')
def v151_record_evidence(evidence_type: str, status: str='PASS', authorization: str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    evidence=_v151_external_evidence()
    supplied=evidence.get('evidence',{}).get(evidence_type,False)
    _v151_record_evidence(evidence_type,status,{'operator_asserted':supplied,'external':evidence},str(u.get('email') or u.get('id') or 'operator'))
    return {'version':'1.51','evidence_type':evidence_type,'status':status,'recorded':True}


# ---------------- v1.52 Evidence-Bound Final Launch Verification ----------------
def migrate_v152(c):
    c.execute("""CREATE TABLE IF NOT EXISTS production_launch_verification_runs(
        id TEXT PRIMARY KEY, release_version TEXT NOT NULL, decision TEXT NOT NULL,
        manifest_sha256 TEXT, environment_fingerprint TEXT, checks_json TEXT NOT NULL DEFAULT '{}',
        operator TEXT, created_at TEXT NOT NULL
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_launch_verification_version_time ON production_launch_verification_runs(release_version, created_at DESC)")
    try: c.commit()
    except Exception: pass

def _v152_environment_fingerprint() -> dict[str, Any]:
    production=_v146_production_env()
    backend=configured_db_backend()
    fp={
        'environment': os.getenv('WUNOO_ENV','development').strip().lower(),
        'backend': backend,
        'production': production,
        'dsn_configured': bool(os.getenv('WUNOO_DATABASE_URL') or os.getenv('DATABASE_URL')) if production else True,
        'driver_available': False,
    }
    if production and backend=='postgresql':
        try:
            import psycopg  # noqa: F401
            fp['driver_available']=True
        except ImportError:
            fp['driver_available']=False
    return fp

def _v152_live_database_identity() -> dict[str, Any]:
    if configured_db_backend()!='postgresql':
        return {'executed':False,'passed':False,'reachable':False,'reason':'POSTGRES_REQUIRED'} if _v146_production_env() else {'executed':False,'passed':True,'reachable':True,'reason':'DEVELOPMENT'}
    dsn=os.getenv('WUNOO_DATABASE_URL') or os.getenv('DATABASE_URL')
    if not dsn: return {'executed':False,'passed':False,'reachable':False,'reason':'POSTGRES_DSN_MISSING'}
    try:
        with core_db_connect() as db:
            row=db.execute("SELECT current_database() AS database_name, current_user AS database_user").fetchone()
            reachable=bool(row and row['database_name'])
            return {'executed':True,'passed':reachable,'reachable':reachable,
                    'database_name': row['database_name'] if row else None,
                    'database_user': row['database_user'] if row else None}
    except Exception as exc:
        return {'executed':False,'passed':False,'reachable':False,
                'reason':'DATABASE_IDENTITY_FAILED','error':type(exc).__name__}

def _v152_release_binding() -> dict[str, Any]:
    manifest=_v148_manifest()
    external=_v151_external_evidence()
    supplied_manifest=None
    raw=os.getenv('WUNOO_PRODUCTION_EVIDENCE_JSON','').strip()
    if raw:
        try:
            parsed=json.loads(raw)
            if isinstance(parsed,dict): supplied_manifest=parsed.get('release_manifest_sha256')
        except Exception:
            pass
    # In development the binding is informational; production requires an exact manifest hash.
    if _v146_production_env():
        return {'passed':bool(supplied_manifest and supplied_manifest==manifest['manifest_sha256']),
                'expected_manifest_sha256':manifest['manifest_sha256'],
                'supplied_manifest_sha256':supplied_manifest}
    return {'passed':True,'expected_manifest_sha256':manifest['manifest_sha256'],'supplied_manifest_sha256':supplied_manifest}

def _v152_final_launch_gate() -> dict[str, Any]:
    v151=_v151_launch_gate()
    fp=_v152_environment_fingerprint()
    identity=_v152_live_database_identity()
    binding=_v152_release_binding()
    blockers=[]
    if not v151.get('passed'): blockers.append('v151_launch_gate')
    if _v146_production_env() and not identity.get('passed'): blockers.append('live_database_identity')
    if not binding.get('passed'): blockers.append('release_manifest_binding')
    passed=not blockers
    return {
        'schema_version':'1.52','gate':'evidence_bound_final_launch','decision':'GO' if passed else 'NO-GO',
        'passed':passed,'blocking_reasons':blockers,
        'v151':v151,'environment_fingerprint':fp,'live_database_identity':identity,'release_binding':binding,
        'policy':'Production GO requires v1.51 PASS, a reachable PostgreSQL database and an exact release manifest SHA-256 supplied with the live evidence. Development evidence is never sufficient.'
    }

def _v152_verification_run(operator: str|None=None) -> dict[str, Any]:
    gate=_v152_final_launch_gate(); fp=json.dumps(gate['environment_fingerprint'],sort_keys=True,separators=(',',':'))
    with core_db_connect() as db:
        rid='verify_'+uuid.uuid4().hex[:16]
        db.execute('INSERT INTO production_launch_verification_runs(id,release_version,decision,manifest_sha256,environment_fingerprint,checks_json,operator,created_at) VALUES(?,?,?,?,?,?,?,?)',
                   (rid,'1.52',gate['decision'],gate['release_binding'].get('expected_manifest_sha256'),hashlib.sha256(fp.encode()).hexdigest(),json.dumps(gate,sort_keys=True),operator,now()))
        db.commit()
    return {'run_id':rid,**gate}

@app.get('/api/v152/ops/final-launch-gate')
def v152_final_launch_gate(authorization: str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u, {'admin','ops_agent'}); return _v152_final_launch_gate()

@app.post('/api/v152/ops/verification-run')
def v152_verification_run(authorization: str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u, {'admin','ops_agent'}); return _v152_verification_run(str(u.get('email') or u.get('id') or 'operator'))


# ---------------- v1.53 Production Smoke & Business-Critical E2E Gate ----------------
def migrate_v153(c):
    c.execute("""CREATE TABLE IF NOT EXISTS production_business_e2e_runs(
        id TEXT PRIMARY KEY, release_version TEXT NOT NULL, decision TEXT NOT NULL,
        order_id TEXT, steps_json TEXT NOT NULL DEFAULT '{}', integrity_json TEXT NOT NULL DEFAULT '{}',
        idempotency_json TEXT NOT NULL DEFAULT '{}', operator TEXT, created_at TEXT NOT NULL
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_business_e2e_version_time ON production_business_e2e_runs(release_version, created_at DESC)")
    c.execute("CREATE INDEX IF NOT EXISTS idx_business_e2e_order ON production_business_e2e_runs(order_id, created_at DESC)")
    try: c.commit()
    except Exception: pass

_V153_CRITICAL_STEPS = [
    'customer_login','merchant_login','courier_login','admin_login','catalog','cart_add',
    'checkout','checkout_replay_safety','payment','payment_replay','merchant_accept','ready',
    'dispatch','pickup','start_delivery','deliver','settlement','settlement_replay',
    'reconciliation','database_integrity'
]

def _v153_db_integrity(order_id: str) -> dict[str, Any]:
    with core_db_connect() as c:
        o=c.execute("SELECT id,status,customer_id,merchant_id,courier_id,total_czk FROM orders WHERE id=?",(order_id,)).fetchone()
        if not o:
            return {'passed':False,'order_exists':False,'order_id':order_id,'reasons':['ORDER_NOT_FOUND']}
        payments=int(c.execute("SELECT COUNT(*) n FROM payments WHERE order_id=?",(order_id,)).fetchone()['n'])
        captured=int(c.execute("SELECT COUNT(*) n FROM payments WHERE order_id=? AND status='captured'",(order_id,)).fetchone()['n'])
        settlements=int(c.execute("SELECT COUNT(*) n FROM settlement_runs WHERE order_id=?",(order_id,)).fetchone()['n'])
        ledger_rows=c.execute("SELECT direction,COALESCE(SUM(amount_czk),0) amount FROM finance_ledger_entries WHERE order_id=? GROUP BY direction",(order_id,)).fetchall()
        ledger={str(r['direction']):round(float(r['amount']),2) for r in ledger_rows}
        debit=round(float(ledger.get('debit',0)),2); credit=round(float(ledger.get('credit',0)),2)
        items=int(c.execute("SELECT COUNT(*) n FROM order_items WHERE order_id=?",(order_id,)).fetchone()['n'])
        events=int(c.execute("SELECT COUNT(*) n FROM order_events WHERE order_id=?",(order_id,)).fetchone()['n']) if _db_table_exists(c,'order_events') else 0
        reasons=[]
        if o['status']!='delivered': reasons.append('ORDER_NOT_DELIVERED')
        if payments!=1 or captured!=1: reasons.append('PAYMENT_CARDINALITY')
        if settlements!=1: reasons.append('SETTLEMENT_CARDINALITY')
        if items<1: reasons.append('ORDER_ITEMS_MISSING')
        if abs(debit-credit)>0.01: reasons.append('LEDGER_UNBALANCED')
        return {
            'passed':not reasons,'order_exists':True,'order_id':order_id,'order_status':o['status'],
            'payment_count':payments,'captured_payment_count':captured,'settlement_count':settlements,
            'order_item_count':items,'event_count':events,'ledger_debit_czk':debit,'ledger_credit_czk':credit,
            'ledger_balanced':abs(debit-credit)<=0.01,'reasons':reasons
        }

def _v153_store_run(order_id: str|None, decision: str, steps: dict[str,Any], integrity: dict[str,Any], idem: dict[str,Any], operator: str|None=None):
    with core_db_connect() as c:
        rid='e2e_'+uuid.uuid4().hex[:16]
        c.execute('INSERT INTO production_business_e2e_runs(id,release_version,decision,order_id,steps_json,integrity_json,idempotency_json,operator,created_at) VALUES(?,?,?,?,?,?,?,?,?)',
                  (rid,'1.53',decision,order_id,json.dumps(steps,sort_keys=True),json.dumps(integrity,sort_keys=True),json.dumps(idem,sort_keys=True),operator,now()))
        c.commit()
    return rid

@app.get('/api/v153/ops/business-e2e-contract')
def v153_business_e2e_contract(authorization: str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    return {'schema_version':'1.53','gate':'business_critical_e2e','steps':_V153_CRITICAL_STEPS,
            'acceptance':['all critical HTTP steps succeed','payment replay creates no second payment','settlement replay creates no second settlement','final order is delivered','ledger debits equal credits','exactly one payment and one settlement exist'],
            'production_policy':'A production PASS requires the smoke to run against the deployed service with PostgreSQL. Local SQLite smoke is development evidence only.'}

@app.get('/api/v153/ops/business-e2e-integrity/{order_id}')
def v153_business_e2e_integrity(order_id:str, authorization: str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    return {'schema_version':'1.53',**_v153_db_integrity(order_id)}

@app.get('/api/v153/ops/business-e2e-latest')
def v153_business_e2e_latest(authorization: str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        row=c.execute("SELECT * FROM production_business_e2e_runs WHERE release_version='1.53' ORDER BY created_at DESC LIMIT 1").fetchone()
    if not row: return {'schema_version':'1.53','found':False}
    return {'schema_version':'1.53','found':True,**{k: row[k] for k in row.keys()}}



# ---------------- v1.54 Deployment-Aware E2E Evidence & Release Binding ----------------
def migrate_v154(c):
    c.execute("""CREATE TABLE IF NOT EXISTS production_e2e_evidence_runs(
        id TEXT PRIMARY KEY, release_version TEXT NOT NULL, decision TEXT NOT NULL,
        deployment_url TEXT, order_id TEXT, release_manifest_sha256 TEXT,
        evidence_sha256 TEXT NOT NULL, preflight_json TEXT NOT NULL DEFAULT '{}',
        smoke_json TEXT NOT NULL DEFAULT '{}', operator TEXT, created_at TEXT NOT NULL
    )""")
    c.execute("CREATE UNIQUE INDEX IF NOT EXISTS ux_e2e_evidence_hash ON production_e2e_evidence_runs(evidence_sha256)")
    c.execute("CREATE INDEX IF NOT EXISTS idx_e2e_evidence_version_time ON production_e2e_evidence_runs(release_version, created_at DESC)")
    try: c.commit()
    except Exception: pass

def _v154_sha256_payload(payload: dict[str,Any]) -> str:
    return hashlib.sha256(json.dumps(payload,sort_keys=True,separators=(',',':')).encode()).hexdigest()

def _v154_preflight() -> dict[str,Any]:
    fp=_v152_environment_fingerprint()
    dbid=_v152_live_database_identity()
    binding=_v152_release_binding()
    v151=_v151_launch_gate()
    blockers=[]
    production=os.getenv('WUNOO_ENV','development').strip().lower() in {'prod','production','staging'}
    if production and not v151.get('passed'): blockers.append('v151_launch_gate')
    if production and configured_db_backend()!='postgresql': blockers.append('production_requires_postgresql')
    if production and not dbid.get('reachable'): blockers.append('database_unreachable')
    if production and not binding.get('passed'): blockers.append('release_binding')
    return {'schema_version':'1.54','passed':not blockers,'decision':'GO' if not blockers else 'NO-GO',
            'blocking_reasons':blockers,'environment_fingerprint':fp,'database_identity':dbid,
            'release_binding':binding,'v151':v151,
            'policy':'Production evidence is accepted only when v1.51 is GO, PostgreSQL is reachable, and the exact release manifest binding passes.'}

def _v154_record_evidence(payload: dict[str,Any], operator: str|None=None) -> dict[str,Any]:
    pre=_v154_preflight()
    production=_v146_production_env()
    manifest_sha=(pre.get('release_binding') or {}).get('expected_manifest_sha256')
    supplied_manifest=str(payload.get('release_manifest_sha256') or '').strip()
    deployment_url=str(payload.get('deployment_url') or '').strip()
    order_id=str(payload.get('order_id') or '').strip()
    smoke_passed=payload.get('smoke_passed') is True
    integrity_passed=payload.get('integrity_passed') is True
    required_production_fields = bool(deployment_url and order_id and supplied_manifest and supplied_manifest == manifest_sha and operator)
    evidence=dict(payload)
    evidence['preflight']=pre
    evidence['recorded_release']='1.54'
    evidence['recorded_at']=now()
    evidence['operator']=operator
    evidence['production_required_fields_present']=required_production_fields
    digest=_v154_sha256_payload(evidence)
    decision='PASS' if (pre['passed'] and smoke_passed and integrity_passed and (not production or required_production_fields)) else 'NO-GO'
    rid='evidence_'+uuid.uuid4().hex[:16]
    with core_db_connect() as c:
        c.execute('INSERT INTO production_e2e_evidence_runs(id,release_version,decision,deployment_url,order_id,release_manifest_sha256,evidence_sha256,preflight_json,smoke_json,operator,created_at) VALUES(?,?,?,?,?,?,?,?,?,?,?)',
                  (rid,'1.54',decision,evidence.get('deployment_url'),evidence.get('order_id'),pre.get('release_binding',{}).get('expected_manifest_sha256'),digest,json.dumps(pre,sort_keys=True),json.dumps(evidence,sort_keys=True),operator,now()))
        c.commit()
    return {'schema_version':'1.54','run_id':rid,'decision':decision,'evidence_sha256':digest,'preflight':pre,
            'smoke_passed':smoke_passed,'integrity_passed':integrity_passed,
            'production_required_fields_present':required_production_fields,
            'release_manifest_sha256':supplied_manifest or manifest_sha}

@app.get('/api/v154/ops/e2e-preflight')
def v154_e2e_preflight(authorization: str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); return _v154_preflight()

@app.post('/api/v154/ops/e2e-evidence')
def v154_e2e_evidence(payload: dict[str,Any], authorization: str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    if payload.get('schema_version')!='1.53': raise HTTPException(status_code=422,detail='schema_version must be 1.53 smoke evidence')
    return _v154_record_evidence(payload,str(u.get('email') or u.get('id') or 'operator'))

@app.get('/api/v154/ops/e2e-evidence-latest')
def v154_e2e_evidence_latest(authorization: str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        row=c.execute("SELECT * FROM production_e2e_evidence_runs WHERE release_version='1.54' ORDER BY created_at DESC LIMIT 1").fetchone()
    if not row: return {'schema_version':'1.54','found':False}
    return {'schema_version':'1.54','found':True,**{k:row[k] for k in row.keys()}}


# ---------------- v1.55 Production Release Attestation & Rollback Decision Gate ----------------
def migrate_v155(c):
    c.execute("""CREATE TABLE IF NOT EXISTS production_release_attestations(
        id TEXT PRIMARY KEY, release_version TEXT NOT NULL, decision TEXT NOT NULL,
        rollback_recommended INTEGER NOT NULL DEFAULT 0, release_manifest_sha256 TEXT,
        evidence_sha256 TEXT, checks_json TEXT NOT NULL DEFAULT '{}',
        operator TEXT, created_at TEXT NOT NULL
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_release_attestation_version_time ON production_release_attestations(release_version, created_at DESC)")
    try: c.commit()
    except Exception: pass

def _v155_latest_row(c, table: str, version: str, time_column: str='created_at'):
    # Internal table/column values are hard-coded at call sites; no user input reaches this SQL.
    return c.execute(f"SELECT * FROM {table} WHERE release_version=? ORDER BY {time_column} DESC LIMIT 1", (version,)).fetchone()

def _v155_health_state() -> dict[str, Any]:
    with core_db_connect() as c:
        row=_v155_latest_row(c,'production_health_windows','1.50','started_at') if _db_table_exists(c,'production_health_windows') else None
    if not row:
        return {'found':False,'healthy':False,'rollback_recommended':False,'reason':'NO_HEALTH_WINDOW'}
    return {'found':True,'status':row['status'],'healthy':row['status']=='healthy',
            'rollback_recommended':bool(row.get('rollback_recommended',0)),
            'failure_count':int(row.get('failure_count',0) or 0),'health_window_id':row['id']}

def _v155_latest_e2e() -> dict[str, Any]:
    with core_db_connect() as c:
        row=_v155_latest_row(c,'production_e2e_evidence_runs','1.54') if _db_table_exists(c,'production_e2e_evidence_runs') else None
    if not row:
        return {'found':False,'passed':False,'reason':'NO_E2E_EVIDENCE'}
    return {'found':True,'decision':row['decision'],'passed':row['decision']=='PASS',
            'order_id':row.get('order_id'),'evidence_sha256':row.get('evidence_sha256')}

def _v155_attestation_gate() -> dict[str, Any]:
    production=_v146_production_env()
    v151=_v151_launch_gate()
    v152=_v152_final_launch_gate()
    health=_v155_health_state()
    e2e=_v155_latest_e2e()
    manifest=_v148_manifest().get('manifest_sha256')
    blockers=[]
    if not production: blockers.append('production_environment_required')
    if production:
        if not v151.get('passed'): blockers.append('v151_launch_gate')
        if not v152.get('passed'): blockers.append('v152_final_launch_gate')
        if not health.get('healthy'): blockers.append('health_window_not_healthy')
        if not e2e.get('passed'): blockers.append('e2e_evidence_not_passed')
    rollback=bool(health.get('rollback_recommended')) or (production and e2e.get('found') and not e2e.get('passed'))
    if rollback:
        decision='ROLLBACK_RECOMMENDED'
    elif blockers:
        decision='HOLD'
    else:
        decision='GO_LIVE'
    return {'schema_version':'1.55','gate':'production_release_attestation','decision':decision,
            'passed':decision=='GO_LIVE','rollback_recommended':rollback,'blocking_reasons':blockers,
            'production_environment':production,'release_manifest_sha256':manifest,
            'v151_launch_gate':v151,'v152_final_launch_gate':v152,
            'health_window':health,'e2e_evidence':e2e,
            'rollback_policy':'Rollback is recommended only from failed health/E2E evidence; schema rollback is never automatic. Use forward-fix or restore from a verified backup.'}

def _v155_record_attestation(operator: str|None=None) -> dict[str, Any]:
    gate=_v155_attestation_gate()
    payload=json.dumps(gate,sort_keys=True,separators=(',',':'))
    evidence_hash=hashlib.sha256(payload.encode()).hexdigest()
    with core_db_connect() as c:
        rid='attest_'+uuid.uuid4().hex[:16]
        c.execute('INSERT INTO production_release_attestations(id,release_version,decision,rollback_recommended,release_manifest_sha256,evidence_sha256,checks_json,operator,created_at) VALUES(?,?,?,?,?,?,?,?,?)',
                  (rid,'1.55',gate['decision'],1 if gate['rollback_recommended'] else 0,gate['release_manifest_sha256'],evidence_hash,payload,operator,now()))
        c.commit()
    return {'run_id':rid,'evidence_sha256':evidence_hash,**gate}

@app.get('/api/v155/ops/release-attestation')
