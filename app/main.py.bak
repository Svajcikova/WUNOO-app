def _v107_hash(v): return hashlib.sha256(_v107_json(v).encode()).hexdigest()
def _v107_payload(fin,seq,prev):
    return {'format':_V107_POLICY['format'],'schema_version':'1.107','sequence_no':int(seq),'finality_id':fin['id'],'checkpoint_id':fin['checkpoint_id'],'checkpoint_sha256':fin['checkpoint_sha256'],'finality_proof_sha256':fin['proof_sha256'],'previous_entry_sha256':prev,'continuity_state':'RECOVERY_FINALITY_CHECKPOINT_FINALITY_CHAINED'}
def _v107_verify_entry(c,row):
    try:
        if not row:return {'valid':False,'reason':'NO_ENTRY'}
        obj=json.loads(row['entry_json'] or '{}')
        if obj.get('format')!=_V107_POLICY['format'] or obj.get('schema_version')!='1.107':return {'valid':False,'reason':'V107_ENTRY_FORMAT_INVALID'}
        if _v107_hash(obj)!=row['entry_sha256']:return {'valid':False,'reason':'V107_ENTRY_HASH_INVALID'}
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto();Ed25519PublicKey.from_public_bytes(base64.b64decode(row['public_key_b64'],validate=True)).verify(base64.b64decode(row['signature_b64'],validate=True),_v107_json(obj).encode())
        if int(row['sequence_no'])!=int(obj.get('sequence_no',-1)) or row['finality_id']!=obj.get('finality_id') or row['checkpoint_id']!=obj.get('checkpoint_id') or row['checkpoint_sha256']!=obj.get('checkpoint_sha256') or row['finality_proof_sha256']!=obj.get('finality_proof_sha256') or row['previous_entry_sha256']!=obj.get('previous_entry_sha256'):return {'valid':False,'reason':'V107_ENTRY_METADATA_INVALID'}
        fin=c.execute('SELECT * FROM production_recovery_finality_checkpoint_finality_v106 WHERE id=?',(row['finality_id'],)).fetchone()
        if not fin or not _v106_verify_finality(c,fin).get('valid'):return {'valid':False,'reason':'V107_UPSTREAM_FINALITY_NOT_VERIFIABLE'}
        if fin['checkpoint_id']!=row['checkpoint_id'] or fin['checkpoint_sha256']!=row['checkpoint_sha256'] or fin['proof_sha256']!=row['finality_proof_sha256']:return {'valid':False,'reason':'V107_UPSTREAM_BINDING_INVALID'}
        return {'valid':True,'sequence_no':int(row['sequence_no']),'finality_id':row['finality_id']}
    except Exception:return {'valid':False,'reason':'V107_ENTRY_INVALID'}
