        chk('REFUND_NO_DUPLICATES',int(dup)==0,None if int(dup)==0 else 'DUPLICATE_PROVIDER_REFUNDS',{'duplicate_groups':int(dup)})
    except Exception as e: chk('REFUND_NO_DUPLICATES',False,'QUERY_EXCEPTION',str(e))
