def v173_policy(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); return _V173_POLICY
@app.post('/api/v173/ops/transparency-checkpoint/issue')
def v173_issue(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); payload=payload or {}
    with core_db_connect() as c:
        entries=_v172_rows(c); logvr=_v172_verify_entries(entries)
        if not logvr['valid']: raise HTTPException(409,'transparency log invalid: '+logvr['reason'])
        if not entries: raise HTTPException(409,'nelze checkpointovat prazdny transparency log')
