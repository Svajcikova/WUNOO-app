# ---------------- WUNOO v1.74: External Witness Receipts & Cross-System Verification ----------------
def migrate_v174(c):
    c.executescript("""CREATE TABLE IF NOT EXISTS production_release_external_witness_receipts(
        id TEXT PRIMARY KEY, checkpoint_id TEXT NOT NULL, checkpoint_sha256 TEXT NOT NULL,
        witness_id TEXT NOT NULL, witness_system TEXT NOT NULL, witnessed_at TEXT NOT NULL,
        receipt_sha256 TEXT NOT NULL UNIQUE, algorithm TEXT NOT NULL, public_key_b64 TEXT NOT NULL,
        signature_b64 TEXT NOT NULL, receipt_json TEXT NOT NULL, status TEXT NOT NULL,
        created_at TEXT NOT NULL, operator TEXT
    );
    CREATE UNIQUE INDEX IF NOT EXISTS ux_external_witness_checkpoint_witness
      ON production_release_external_witness_receipts(checkpoint_sha256,witness_id);
    CREATE INDEX IF NOT EXISTS idx_external_witness_receipts_checkpoint
      ON production_release_external_witness_receipts(checkpoint_sha256);
    """)
    try: c.commit()
    except Exception: pass

_V174_POLICY={'schema_version':'1.74','format':'wunoo.release.external.witness.receipt.v1','hash_algorithm':'sha256','signature_algorithm':'Ed25519','purpose':'independent_external_witnessing','cross_system_verification':True,'append_only':True,'fail_closed':True,'automatic_release':False,'witness_is_not_release_authorization':True}
def _v174_hash(payload):
    return hashlib.sha256(json.dumps(payload,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()).hexdigest()
def _v174_receipt_payload(checkpoint_sha256,witness_id,witness_system,witnessed_at):
    return {'format':'wunoo.release.external.witness.receipt.v1','schema_version':'1.74','checkpoint_sha256':str(checkpoint_sha256),'witness_id':str(witness_id),'witness_system':str(witness_system),'witnessed_at':str(witnessed_at)}
def _v174_verify_receipt(row,checkpoint=None):
    try:
        payload=json.loads(row['receipt_json'] or '{}')
        if payload.get('checkpoint_sha256')!=row['checkpoint_sha256'] or payload.get('witness_id')!=row['witness_id'] or payload.get('witness_system')!=row['witness_system'] or payload.get('witnessed_at')!=row['witnessed_at']:
            return {'valid':False,'reason':'WITNESS_BINDING_INVALID'}
        digest=_v174_hash(payload)
        if digest!=row['receipt_sha256']: return {'valid':False,'reason':'WITNESS_HASH_MISMATCH'}
        if row['algorithm']!='Ed25519': return {'valid':False,'reason':'WITNESS_ALGORITHM_INVALID'}
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto()
        Ed25519PublicKey.from_public_bytes(base64.b64decode(row['public_key_b64'])).verify(base64.b64decode(row['signature_b64']),json.dumps(payload,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode())
        if checkpoint is not None and row['checkpoint_sha256']!=checkpoint['checkpoint_sha256']:
            return {'valid':False,'reason':'WITNESS_CHECKPOINT_MISMATCH'}
        return {'valid':True,'reason':'EXTERNAL_WITNESS_VERIFIED','receipt_sha256':row['receipt_sha256'],'witness_id':row['witness_id']}
    except Exception:
        return {'valid':False,'reason':'WITNESS_SIGNATURE_INVALID'}
def _v174_witness_rows(c): return c.execute('SELECT * FROM production_release_external_witness_receipts ORDER BY created_at ASC,id ASC').fetchall()
def _v174_trusted(pub_b64):
    allow=[x.strip() for x in str(os.getenv('WUNOO_EXTERNAL_WITNESS_TRUSTED_PUBLIC_KEYS_B64','')).split(',') if x.strip()]
    if allow: return pub_b64 in allow
    return str(os.getenv('WUNOO_ENV','development')).lower() not in {'prod','production','staging'}

def _v174_verify_all(c):
    rows=_v174_witness_rows(c); checked=0
    for r in rows:
        cp=_v170_row(c,'production_release_transparency_checkpoints',' WHERE checkpoint_sha256=?',(r['checkpoint_sha256'],),'checkpoint_no DESC')
        if not cp: return {'valid':False,'reason':'WITNESS_CHECKPOINT_NOT_FOUND','receipt_id':r['id']}
        vr=_v173_verify(_v173_rows(c))
        if not vr['valid']: return {'valid':False,'reason':'CHECKPOINT_CHAIN_INVALID','detail':vr['reason'],'receipt_id':r['id']}
        rr=_v174_verify_receipt(r,cp)
        if not rr['valid']: return {'valid':False,'reason':rr['reason'],'receipt_id':r['id']}
        if not _v174_trusted(r['public_key_b64']): return {'valid':False,'reason':'WITNESS_KEY_NOT_TRUSTED','receipt_id':r['id']}
        checked+=1
    return {'valid':True,'reason':'EXTERNAL_WITNESSES_VERIFIED','receipts':checked}

