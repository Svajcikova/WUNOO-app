        seq=int(chain['next_sequence_no']);prev=chain['head_entry_sha256'];obj=_v101_payload(cons,dec,seq,prev);eh=_v101_hash(obj)
        key,pub,keyid=_v169_load_signer();sig=base64.b64encode(key.sign(_v101_json(obj).encode())).decode();eid='grcc_'+uuid.uuid4().hex[:16];t=now();op=str(u.get('email') or u.get('id') or 'operator')
        c.execute('INSERT INTO production_global_recovery_consensus_chain(id,sequence_no,consensus_id,checkpoint_id,checkpoint_sha256,decision_id,decision_sha256,previous_entry_sha256,entry_json,entry_sha256,algorithm,signer_key_id,public_key_b64,signature_b64,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(eid,seq,cons['id'],cons['checkpoint_id'],cons['checkpoint_sha256'],dec['id'],dec['decision_sha256'],prev,_v101_json(obj),eh,'Ed25519',keyid,base64.b64encode(pub).decode(),sig,'APPENDED',t,op));c.commit();row=c.execute('SELECT * FROM production_global_recovery_consensus_chain WHERE id=?',(eid,)).fetchone();return {'schema_version':'1.101','idempotent':False,'entry':dict(row),'verification':_v101_verify_entry(c,row)}
@app.get('/api/v101/ops/global-recovery-consensus-chain/verify')
def v101_verify(authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:return {'schema_version':'1.101',**_v101_verify_chain(c)}
