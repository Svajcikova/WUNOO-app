    c.commit()

class DistributedRateLimitStore(AtomicRateLimitStore):
    """Backend contract for atomic INCR+EXPIRE semantics; Redis adapter can implement hit()."""
    backend="atomic_adapter"
    def describe(self):
        return {"backend":self.backend,"atomic":True,"multi_instance_ready":False,
                "redis_adapter_contract":True}

DISTRIBUTED_RATE_LIMIT_STORE=DistributedRateLimitStore()

def distributed_rate_limit_check(c, request, route, user=None, limit=60, window_seconds=60):
    return rate_limit_check(c,request,route,user,limit,window_seconds)


class RedisRateLimitAdapter:
    """Redis-compatible adapter contract using atomic INCR + expiry semantics.

    The bundled app does not connect to Redis automatically. A production deployment
    can inject a client exposing `incr` and `expire`/TTL operations.
    """
    backend="redis"
    def __init__(self, client=None, namespace="wunoo"):
        self.client=client
        self.namespace=namespace
    def hit(self,key,limit,window_seconds,now_epoch):
        if self.client is None:
            raise RuntimeError("Redis client is not configured")
        redis_key=f"{self.namespace}:rl:{key}"
        count=self.client.incr(redis_key)
        if count == 1:
            self.client.expire(redis_key,window_seconds)
        ttl=getattr(self.client,"ttl",lambda k: window_seconds)(redis_key)
        allowed=count<=limit
        return allowed,int(count),max(0,int(ttl))

def configure_rate_limit_backend(name="process_local", redis_client=None):
    if name=="redis":
        return RedisRateLimitAdapter(redis_client)
    return DISTRIBUTED_RATE_LIMIT_STORE


class FakeRedis:
    """Deterministic test double for Redis INCR/EXPIRE/TTL semantics."""
    def __init__(self):
        self.data={}
        self.expiry={}
        self._lock=threading.Lock()
    def _purge(self,key,now=None):
        now=time.time() if now is None else now
        if key in self.expiry and self.expiry[key] <= now:
            self.data.pop(key,None); self.expiry.pop(key,None)
    def incr(self,key):
        with self._lock:
            self._purge(key)
            self.data[key]=int(self.data.get(key,0))+1
            return self.data[key]
    def expire(self,key,seconds):
        with self._lock:
            self._purge(key); self.expiry[key]=time.time()+int(seconds); return True
    def ttl(self,key):
        with self._lock:
            self._purge(key)
            if key not in self.data:return -2
            return max(0,int(self.expiry.get(key,time.time())-time.time()))

def redis_rate_limit_hit(adapter,key,limit,window_seconds):
    now_epoch=int(time.time())
    return adapter.hit(key,limit,window_seconds,now_epoch)


