V081_ENDPOINT_MATRIX=[
    ("orders","read",["customer","merchant","courier","ops_agent","admin"]),
    ("orders","transition",["merchant","courier","ops_agent","admin"]),
    ("payments","read",["merchant","ops_agent","admin"]),
    ("settlements","read",["merchant","ops_agent","admin"]),
    ("dispatch","read",["merchant","courier","ops_agent","admin"]),
    ("dispatch","assign",["ops_agent","admin"]),
]

def _v081_permission_for(role,resource,action):
    with_roles=[x for x in V080_SECURITY_MATRIX if x[0]==role and x[1]==resource and x[2]==action]
    return "allow" if with_roles and with_roles[0][3]=="allow" else "deny"

@app.post("/api/v081/ops/authz/migrate")
def v081_run_migration(authorization:str|None=Header(default=None), idempotency_key:str|None=Header(default=None,alias="Idempotency-Key"))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    key=idempotency_key or ("authz_migration_"+uuid.uuid4().hex[:16])
    with core_db_connect() as c:
        old=c.execute("SELECT * FROM authorization_migration_runs WHERE run_key=?",(key,)).fetchone()
        if old:
            rows=c.execute("SELECT * FROM authorization_migration_results WHERE run_id=? ORDER BY resource,action,role",(old["id"],)).fetchall()
            return {"run":dict(old),"results":[dict(x) for x in rows],"duplicate":True}
        rid="amr_"+uuid.uuid4().hex[:12]
        c.execute("INSERT INTO authorization_migration_runs(id,run_key,status,started_at) VALUES (?,?,?,?)",(rid,key,"running",now()))
        results=[]
        try:
            for resource,action,roles in V081_ENDPOINT_MATRIX:
                for role in roles:
                    expected=_v081_permission_for(role,resource,action)
                    subject={"id":"migration_"+role,"role":role,"merchant_id":"tenant_A","tenant_id":"tenant_A"}
                    # Tenant-scoped checks use a matching tenant; owner-scoped customer cases
                    # are intentionally excluded from the migrated mutation surface.
                    allowed,reason=AuthorizationPolicyEngine(c).allow(subject,resource,action,resource_id=None,tenant_id="tenant_A")
                    observed="allow" if allowed else "deny"
                    status="PASS" if observed==expected else "FAIL"
                    details={"reason":reason,"guard":"require_permission","migration_surface":True}
                    c.execute("""INSERT INTO authorization_migration_results
                        (id,run_id,resource,action,role,status,expected,observed,details_json,created_at)
                        VALUES (?,?,?,?,?,?,?,?,?,?)""",
                        ("amg_"+uuid.uuid4().hex[:12],rid,resource,action,role,status,expected,observed,json.dumps(details,ensure_ascii=False),now()))
                    results.append({"resource":resource,"action":action,"role":role,"status":status,"expected":expected,"observed":observed})
            ok=all(x["status"]=="PASS" for x in results)
            c.execute("UPDATE authorization_migration_runs SET status=?,completed_at=?,details_json=? WHERE id=?",
                      ("passed" if ok else "failed",now(),json.dumps({"cases":len(results)},ensure_ascii=False),rid))
            c.commit()
            return {"run_id":rid,"status":"passed" if ok else "failed","cases":len(results),"passed":sum(x["status"]=="PASS" for x in results),"results":results}
        except Exception as exc:
            c.execute("UPDATE authorization_migration_runs SET status=?,completed_at=?,details_json=? WHERE id=?",("failed",now(),json.dumps({"error":str(exc)},ensure_ascii=False),rid))
            c.commit()
            raise

@app.get("/api/v081/ops/authz/migration/history")
def v081_migration_history(authorization:str|None=Header(default=None))->dict[str,Any]:
