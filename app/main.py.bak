    with core_db_connect() as c:
        row=c.execute('SELECT id FROM v124_schedules WHERE job_name=?',(job_name,)).fetchone()
        if not row: raise HTTPException(404,'Scheduler job nenalezen')
        c.execute('UPDATE v124_schedules SET enabled=?,updated_at=? WHERE id=?',(1 if enabled else 0,now(),row['id'])); c.commit()
        return {'schema_version':'1.24','job_name':job_name,'enabled':enabled}


@app.get('/api/v124/orders/{order_id}/recovery')
def v124_order_recovery(order_id:str, authorization:str|None=Header(default=None))->dict[str,Any]:
