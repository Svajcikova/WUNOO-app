# ---------------- WUNOO v1.105: Cross-Federation Checkpoint Finality Chain ----------------
def migrate_v105(c):
    c.executescript("""CREATE TABLE IF NOT EXISTS production_global_recovery_checkpoint_finality_continuity_chain(
        id TEXT PRIMARY KEY, sequence_no INTEGER NOT NULL UNIQUE, checkpoint_finality_id TEXT NOT NULL UNIQUE,
        checkpoint_id TEXT NOT NULL, checkpoint_sha256 TEXT NOT NULL, finality_proof_sha256 TEXT NOT NULL,
        previous_entry_sha256 TEXT NOT NULL, entry_json TEXT NOT NULL, entry_sha256 TEXT NOT NULL UNIQUE,
        algorithm TEXT NOT NULL, signer_key_id TEXT NOT NULL, public_key_b64 TEXT NOT NULL,
        signature_b64 TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT
    );
    CREATE INDEX IF NOT EXISTS idx_v105_recovery_finality_chain_checkpoint
      ON production_global_recovery_checkpoint_finality_continuity_chain(checkpoint_id,sequence_no);
    CREATE INDEX IF NOT EXISTS idx_v105_recovery_finality_chain_finality
      ON production_global_recovery_checkpoint_finality_continuity_chain(checkpoint_finality_id);
    """)

_V105_POLICY={
    'schema_version':'1.105',
    'format':'wunoo.release.global.recovery.checkpoint.finality.continuity.entry.v1',
    'hash':'SHA-256','algorithm':'Ed25519','genesis_hash':'0'*64,
    'requires_verified_v104_finality':True,
    'strict_sequence':True,'previous_entry_required':True,
    'immutable_history':True,'append_only':True,
    'automatic_append':False,'destructive_restore':False,
    'no_chain_mutation':True,'fail_closed':True,'no_automatic_release':True
}
def _v105_json(v): return json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False)
def _v105_hash(v): return hashlib.sha256(_v105_json(v).encode()).hexdigest()
def _v105_payload(fin,seq,prev):
    return {'format':_V105_POLICY['format'],'schema_version':'1.105','sequence_no':int(seq),
            'checkpoint_finality_id':fin['id'],'checkpoint_id':fin['checkpoint_id'],
            'checkpoint_sha256':fin['checkpoint_sha256'],'finality_proof_sha256':fin['proof_sha256'],
            'previous_entry_sha256':prev,'continuity_state':'RECOVERY_CHECKPOINT_FINALITY_CONTINUOUS',
            'no_chain_mutation':True}
def _v105_verify_entry(c,row):
    try:
        fin=c.execute('SELECT * FROM production_global_recovery_finality_checkpoint_finality WHERE id=?',(row['checkpoint_finality_id'],)).fetchone()
        if not fin:return {'valid':False,'reason':'V105_CHECKPOINT_FINALITY_NOT_FOUND'}
        fv=_v104_verify_finality(c,fin)
        if not fv.get('valid'):return {'valid':False,'reason':'V105_UPSTREAM_FINALITY_NOT_VERIFIABLE','detail':fv.get('reason')}
        seq=int(row['sequence_no'])
        prev=_V105_POLICY['genesis_hash'] if seq==1 else None
        if seq>1:
            pr=c.execute('SELECT * FROM production_global_recovery_checkpoint_finality_continuity_chain WHERE sequence_no=?',(seq-1,)).fetchone()
            if not pr:return {'valid':False,'reason':'V105_CHAIN_PREDECESSOR_MISSING'}
            prev=pr['entry_sha256']
        if row['previous_entry_sha256']!=prev:return {'valid':False,'reason':'V105_CHAIN_PREVIOUS_HASH_INVALID'}
        if row['checkpoint_id']!=fin['checkpoint_id'] or row['checkpoint_sha256']!=fin['checkpoint_sha256'] or row['finality_proof_sha256']!=fin['proof_sha256']:
            return {'valid':False,'reason':'V105_UPSTREAM_BINDING_INVALID'}
        obj=json.loads(row['entry_json'] or '{}')
        if obj!=_v105_payload(fin,seq,prev):return {'valid':False,'reason':'V105_ENTRY_PAYLOAD_INVALID'}
        if _v105_hash(obj)!=row['entry_sha256']:return {'valid':False,'reason':'V105_ENTRY_HASH_INVALID'}
        if row['algorithm']!='Ed25519' or row['signer_key_id']=='':return {'valid':False,'reason':'V105_SIGNER_METADATA_INVALID'}
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto()
        raw=base64.b64decode(row['public_key_b64'],validate=True)
        if _v176_key_id(raw)!=row['signer_key_id']:return {'valid':False,'reason':'V105_SIGNER_KEY_ID_INVALID'}
        Ed25519PublicKey.from_public_bytes(raw).verify(base64.b64decode(row['signature_b64'],validate=True),_v105_json(obj).encode())
        return {'valid':True,'sequence_no':seq,'checkpoint_finality_id':fin['id'],'checkpoint_id':fin['checkpoint_id']}
    except Exception:return {'valid':False,'reason':'V105_ENTRY_INVALID'}
def _v105_verify_chain(c):
    rows=c.execute('SELECT * FROM production_global_recovery_checkpoint_finality_continuity_chain ORDER BY sequence_no ASC').fetchall()
    expected=1;prev=_V105_POLICY['genesis_hash']
    for row in rows:
        if int(row['sequence_no'])!=expected:return {'valid':False,'reason':'V105_CHAIN_SEQUENCE_INVALID','checked_entries':expected-1}
        vr=_v105_verify_entry(c,row)
        if not vr.get('valid'):vr['checked_entries']=expected-1;return vr
        prev=row['entry_sha256'];expected+=1
    return {'valid':True,'reason':'GLOBAL_RECOVERY_CHECKPOINT_FINALITY_CHAIN_VERIFIED','entries':len(rows),'head_entry_sha256':prev}

