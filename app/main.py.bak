    c.execute("""CREATE TABLE IF NOT EXISTS release_candidate_gates(
        id TEXT PRIMARY KEY, release_version TEXT NOT NULL, gate_name TEXT NOT NULL,
        status TEXT NOT NULL, details_json TEXT NOT NULL DEFAULT '{}', checked_at TEXT NOT NULL,
