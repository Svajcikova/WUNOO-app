@app.get("/api/v038/merchant/menu-management")
def v038_menu_management(authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u=current_user(authorization); require_role(u,"merchant")
    with core_db_connect() as c:
        migrate_v114(c)
        cats=c.execute("SELECT id,name,sort_order,active FROM menu_categories WHERE merchant_id=? ORDER BY sort_order,name",(u["merchant_id"],)).fetchall()
        items=c.execute("""
            SELECT mi.id,mi.name,mi.description,mi.price_czk,mi.active,mi.category_id,
                   mc.name category_name
            FROM menu_items mi LEFT JOIN menu_categories mc ON mc.id=mi.category_id
            WHERE mi.merchant_id=? ORDER BY COALESCE(mc.sort_order,999),mi.name
        """,(u["merchant_id"],)).fetchall()
