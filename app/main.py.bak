    return out

def _v170_payload(snapshot):
    return {'format':'wunoo.release.certificate.v1','schema_version':'1.70','release_version':snapshot.get('release_version'),
            'manifest':snapshot.get('manifest'),'signature':snapshot.get('signature'),'evidence':snapshot.get('evidence')}

def _v170_eval(snapshot):
    reasons=[]
    m=snapshot.get('manifest') or {}; s=snapshot.get('signature') or {}; e=snapshot.get('evidence') or {}
    mv=m.get('verification') or {}; sv=s.get('verification') or {}; g=e.get('1.67') or {}; p=e.get('1.66') or {}; r=e.get('1.65') or {}; l=e.get('1.63') or {}; rec=e.get('1.64') or {}
    if not mv.get('valid'): reasons.append('manifest_verification')
    if not sv.get('valid'): reasons.append('signature_verification')
    if m.get('format')!='wunoo.release.manifest.v1': reasons.append('manifest_format')
    if g.get('decision')!='GO' or g.get('gate_status')!='READY': reasons.append('1.67_final_gate')
    if p.get('phase')!='COMPLETE' or p.get('decision')!='GO' or float(p.get('promotion_percent') or 0)<100: reasons.append('1.66_promotion')
    if r.get('phase')!='RELEASE' or r.get('decision')!='GO': reasons.append('1.65_revalidation')
    if str(l.get('status') or '').upper()!='HEALTHY': reasons.append('1.63_ledger')
    if not rec.get('id') or str(rec.get('decision') or '').upper() not in ('GO','RELEASE'): reasons.append('1.64_recovery')
    missing=set(snapshot.get('missing') or []); conflicts=snapshot.get('conflicts') or []
    if missing: reasons.append('missing_evidence')
    if conflicts: reasons.append('identity_conflict')
    ok=not reasons
    return {'decision':'GO' if ok else 'HOLD','certificate_status':'CERTIFIED' if ok else 'BLOCKED','certificate_allowed':ok,
            'reason':'release evidence chain is cryptographically and operationally consistent' if ok else 'certificate blocked: '+','.join(reasons)}

