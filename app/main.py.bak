    CREATE INDEX IF NOT EXISTS idx_v194_chain_epoch ON production_federation_finality_gate_chain(epoch_id,sequence_no);
    """)

_V194_POLICY={
    'schema_version':'1.94',
    'entry_format':'wunoo.release.global.checkpoint.federation.finality.gate.chain.entry.v1',
    'hash':'SHA-256','algorithm':'Ed25519','genesis_previous_sha256':'0'*64,
    'requires_gate_verification':True,'requires_epoch_predecessor_continuity':True,
    'requires_same_federation':True,'historical_gate_immutable':True,
    'automatic_chain_append':False,'automatic_finality':False,'fail_closed':True,'no_automatic_release':True
}
def _v194_hash(v): return hashlib.sha256(json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()).hexdigest()
def _v194_json(v): return json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False)
def _v194_entry_payload(seq,gate,epoch,prev):
    return {'format':_V194_POLICY['entry_format'],'schema_version':'1.94','sequence_no':int(seq),
            'gate_id':gate['id'],'gate_sha256':gate['gate_sha256'],'federation_id':gate['federation_id'],
            'epoch_id':epoch['id'],'epoch_no':int(epoch['epoch_no']),'epoch_sha256':epoch['epoch_sha256'],
            'previous_entry_sha256':prev,'continuity_state':'FINALITY_GATE_CHAINED'}
def _v194_verify_entry(c,row,expected_prev=None):
    try:
        obj=json.loads(row['entry_json'] or '{}')
        if _v194_hash(obj)!=row['entry_sha256']: return {'valid':False,'reason':'CHAIN_ENTRY_HASH_INVALID'}
        if expected_prev is not None and row['previous_entry_sha256']!=expected_prev:return {'valid':False,'reason':'CHAIN_PREDECESSOR_HASH_INVALID'}
        gate=c.execute('SELECT * FROM production_federation_reconciled_finality_gates WHERE id=?',(row['gate_id'],)).fetchone()
        epoch=_v186_epoch(c,row['epoch_id'])
        if not gate or not epoch:return {'valid':False,'reason':'CHAIN_REFERENT_MISSING'}
        if gate['gate_sha256']!=row['gate_sha256'] or gate['epoch_id']!=epoch['id'] or gate['federation_id']!=row['federation_id']:return {'valid':False,'reason':'CHAIN_REFERENT_CHANGED'}
        if int(row['epoch_no'])!=int(epoch['epoch_no']) or obj!=_v194_entry_payload(int(row['sequence_no']),gate,epoch,row['previous_entry_sha256']):return {'valid':False,'reason':'CHAIN_PAYLOAD_INVALID'}
        if not _v193_require_finality_gate(c,epoch):return {'valid':False,'reason':'CHAIN_GATE_INVALID'}
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto();Ed25519PublicKey.from_public_bytes(base64.b64decode(row['public_key_b64'],validate=True)).verify(base64.b64decode(row['signature_b64'],validate=True),_v194_json(obj).encode())
        return {'valid':True,'reason':'FINALITY_GATE_CHAIN_ENTRY_VERIFIED'}
    except Exception:return {'valid':False,'reason':'CHAIN_ENTRY_INVALID'}
def _v194_chain(c,federation_id): return c.execute('SELECT * FROM production_federation_finality_gate_chain WHERE federation_id=? ORDER BY sequence_no ASC',(federation_id,)).fetchall()

@app.get('/api/v194/ops/finality-gate-chain/policy')
def v194_policy(authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'});return _V194_POLICY
@app.post('/api/v194/ops/finality-gate-chain/append')
def v194_append(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin'});p=payload or {};operator=str(u.get('email') or u.get('id') or 'operator')
    with core_db_connect() as c:
        gate=c.execute('SELECT * FROM production_federation_reconciled_finality_gates WHERE id=?',(p.get('gate_id'),)).fetchone()
        if not gate: raise HTTPException(404,'GATE_NOT_FOUND')
        epoch=_v186_epoch(c,gate['epoch_id'])
        if not epoch: raise HTTPException(404,'EPOCH_NOT_FOUND')
        if not _v193_require_finality_gate(c,epoch): raise HTTPException(409,'FINALITY_GATE_INVALID')
        fed_id=gate['federation_id'];rows=_v194_chain(c,fed_id);prev=rows[-1] if rows else None
        if prev and prev['gate_sha256']==gate['gate_sha256']:
            return {'schema_version':'1.94','idempotent':True,'entry':dict(prev),'verification':_v194_verify_entry(c,prev,rows[-2]['entry_sha256'] if len(rows)>1 else '0'*64)}
        if prev:
            if epoch['predecessor_epoch_id']!=prev['epoch_id']: raise HTTPException(409,'EPOCH_CONTINUITY_REQUIRED')
            prev_hash=prev['entry_sha256']; seq=int(prev['sequence_no'])+1
        else: prev_hash='0'*64; seq=1
        existing=c.execute('SELECT * FROM production_federation_finality_gate_chain WHERE sequence_no=?',(seq,)).fetchone()
        if existing and existing['federation_id']!=fed_id: raise HTTPException(409,'CHAIN_SEQUENCE_COLLISION')
        obj=_v194_entry_payload(seq,gate,epoch,prev_hash);digest=_v194_hash(obj);ex=c.execute('SELECT * FROM production_federation_finality_gate_chain WHERE entry_sha256=?',(digest,)).fetchone()
        if ex:return {'schema_version':'1.94','idempotent':True,'entry':dict(ex),'verification':_v194_verify_entry(c,ex,prev_hash)}
        signer,pub,keyid=_v169_load_signer();sig=base64.b64encode(signer.sign(_v194_json(obj).encode())).decode();cid='fgc_'+uuid.uuid4().hex[:16];t=now()
        c.execute('INSERT INTO production_federation_finality_gate_chain(id,sequence_no,gate_id,gate_sha256,federation_id,epoch_id,epoch_no,previous_entry_sha256,entry_json,entry_sha256,algorithm,signer_key_id,public_key_b64,signature_b64,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(cid,seq,gate['id'],gate['gate_sha256'],fed_id,epoch['id'],int(epoch['epoch_no']),prev_hash,_v194_json(obj),digest,'Ed25519',keyid,base64.b64encode(pub).decode(),sig,'FINAL',t,operator));c.commit();row=c.execute('SELECT * FROM production_federation_finality_gate_chain WHERE id=?',(cid,)).fetchone();return {'schema_version':'1.94','idempotent':False,'entry':dict(row),'verification':_v194_verify_entry(c,row,prev_hash)}
@app.get('/api/v194/ops/finality-gate-chain/verify')
def v194_verify(authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        fed_ids=[r['federation_id'] for r in c.execute('SELECT DISTINCT federation_id FROM production_federation_finality_gate_chain').fetchall()]
        checked=0
        for fid in fed_ids:
            rows=_v194_chain(c,fid);prev='0'*64;last_epoch_no=0
            for i,row in enumerate(rows,1):
                if int(row['sequence_no'])!=i:return {'schema_version':'1.94','valid':False,'reason':'CHAIN_SEQUENCE_INVALID','checked_entries':checked+1}
                epoch=_v186_epoch(c,row['epoch_id'])
                if epoch and i>1 and int(epoch['epoch_no'])<=last_epoch_no:return {'schema_version':'1.94','valid':False,'reason':'CROSS_EPOCH_ORDER_INVALID','checked_entries':checked+1}
                vr=_v194_verify_entry(c,row,prev)
                if not vr['valid']:return {'schema_version':'1.94','valid':False,'reason':vr['reason'],'checked_entries':checked+1}
                prev=row['entry_sha256'];last_epoch_no=int(epoch['epoch_no']) if epoch else last_epoch_no;checked+=1
        return {'schema_version':'1.94','valid':True,'reason':'FINALITY_GATE_CHAIN_AND_CROSS_EPOCH_CONTINUITY_VERIFIED','chains':len(fed_ids),'entries':checked}


# ---------------- WUNOO v1.95: Cross-Federation Trust Continuity & Global Finality Anchor ----------------
def migrate_v195(c):
    c.executescript("""CREATE TABLE IF NOT EXISTS production_global_federation_trust_anchors(
        id TEXT PRIMARY KEY, anchor_no INTEGER NOT NULL UNIQUE, federation_count INTEGER NOT NULL,
        federation_ids_json TEXT NOT NULL, federation_heads_json TEXT NOT NULL,
        previous_anchor_sha256 TEXT NOT NULL, aggregate_sha256 TEXT NOT NULL,
        anchor_json TEXT NOT NULL, anchor_sha256 TEXT NOT NULL UNIQUE,
        algorithm TEXT NOT NULL, signer_key_id TEXT NOT NULL, public_key_b64 TEXT NOT NULL,
        signature_b64 TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT
    );
    CREATE INDEX IF NOT EXISTS idx_v195_anchor_no ON production_global_federation_trust_anchors(anchor_no);
    """)

_V195_POLICY={
    'schema_version':'1.95',
    'anchor_format':'wunoo.release.global.federation.trust.anchor.v1',
    'hash':'SHA-256','algorithm':'Ed25519','genesis_previous_sha256':'0'*64,
    'requires_verified_v194_chain':True,'requires_verified_v193_gate':True,
    'cross_federation_snapshot':True,'historical_anchor_immutable':True,
    'automatic_anchor_creation':False,'automatic_finality':False,
    'fail_closed':True,'no_automatic_release':True
}
def _v195_hash(v): return hashlib.sha256(json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()).hexdigest()
def _v195_json(v): return json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False)
def _v195_heads(c, federation_ids=None):
    if federation_ids is None:
        federation_ids=sorted({r['federation_id'] for r in c.execute('SELECT DISTINCT federation_id FROM production_federation_finality_gate_chain').fetchall()})
    heads=[]
    for fid in sorted(set(str(x) for x in federation_ids)):
        rows=_v194_chain(c,fid)
        if not rows: raise HTTPException(409,'FEDERATION_CHAIN_REQUIRED')
        vr=_v194_verify_entry(c,rows[-1],rows[-2]['entry_sha256'] if len(rows)>1 else '0'*64)
        if not vr['valid']: raise HTTPException(409,'FEDERATION_CHAIN_INVALID')
        cv=_v184_verify_federation(c,_v170_row(c,'production_global_checkpoint_federations',' WHERE id=?',(fid,),'created_at DESC'))
        if not cv['valid']: raise HTTPException(409,'FEDERATION_INVALID')
        heads.append({'federation_id':fid,'sequence_no':int(rows[-1]['sequence_no']),'entry_sha256':rows[-1]['entry_sha256'],'gate_sha256':rows[-1]['gate_sha256'],'epoch_id':rows[-1]['epoch_id'],'epoch_no':int(rows[-1]['epoch_no'])})
    return heads
def _v195_anchor_payload(no,heads,prev):
    return {'format':_V195_POLICY['anchor_format'],'schema_version':'1.95','anchor_no':int(no),
            'federation_count':len(heads),'federation_heads':heads,'previous_anchor_sha256':prev,
            'continuity_state':'CROSS_FEDERATION_TRUST_ANCHORED'}
def _v195_verify(c,row):
    try:
        obj=json.loads(row['anchor_json'] or '{}')
        if _v195_hash(obj)!=row['anchor_sha256']: return {'valid':False,'reason':'ANCHOR_HASH_INVALID'}
        if int(row['federation_count'])!=len(obj.get('federation_heads',[])): return {'valid':False,'reason':'ANCHOR_FEDERATION_COUNT_INVALID'}
        if obj.get('previous_anchor_sha256')!=row['previous_anchor_sha256']: return {'valid':False,'reason':'ANCHOR_PREDECESSOR_INVALID'}
        expected_heads=_v195_heads(c,[x['federation_id'] for x in obj.get('federation_heads',[])])
        if expected_heads!=obj.get('federation_heads'): return {'valid':False,'reason':'ANCHOR_FEDERATION_HEAD_CHANGED'}
        if _v195_hash(obj.get('federation_heads',[]))!=row['aggregate_sha256']: return {'valid':False,'reason':'ANCHOR_AGGREGATE_INVALID'}
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto();Ed25519PublicKey.from_public_bytes(base64.b64decode(row['public_key_b64'],validate=True)).verify(base64.b64decode(row['signature_b64'],validate=True),_v195_json(obj).encode())
        return {'valid':True,'reason':'CROSS_FEDERATION_TRUST_ANCHOR_VERIFIED','federations':len(expected_heads)}
    except HTTPException as e:return {'valid':False,'reason':str(e.detail)}
    except Exception:return {'valid':False,'reason':'ANCHOR_INVALID'}

@app.get('/api/v195/ops/global-trust-anchor/policy')
def v195_policy(authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'});return _V195_POLICY
@app.post('/api/v195/ops/global-trust-anchor/issue')
def v195_issue(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin'});p=payload or {};operator=str(u.get('email') or u.get('id') or 'operator')
    with core_db_connect() as c:
        fids=p.get('federation_ids')
        heads=_v195_heads(c,fids)
        prevrow=c.execute('SELECT * FROM production_global_federation_trust_anchors ORDER BY anchor_no DESC LIMIT 1').fetchone()
        prev=prevrow['anchor_sha256'] if prevrow else '0'*64;no=(int(prevrow['anchor_no']) if prevrow else 0)+1
        obj=_v195_anchor_payload(no,heads,prev);digest=_v195_hash(obj);agg=_v195_hash(heads)
        ex=c.execute('SELECT * FROM production_global_federation_trust_anchors WHERE anchor_sha256=?',(digest,)).fetchone()
        if ex:return {'schema_version':'1.95','idempotent':True,'anchor':dict(ex),'verification':_v195_verify(c,ex)}
        signer,pub,keyid=_v169_load_signer();sig=base64.b64encode(signer.sign(_v195_json(obj).encode())).decode();aid='gta_'+uuid.uuid4().hex[:16];t=now();ids=_v195_json([x['federation_id'] for x in heads])
        c.execute('INSERT INTO production_global_federation_trust_anchors(id,anchor_no,federation_count,federation_ids_json,federation_heads_json,previous_anchor_sha256,aggregate_sha256,anchor_json,anchor_sha256,algorithm,signer_key_id,public_key_b64,signature_b64,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(aid,no,len(heads),ids,_v195_json(heads),prev,agg,_v195_json(obj),digest,'Ed25519',keyid,base64.b64encode(pub).decode(),sig,'FINAL',t,operator));c.commit();row=c.execute('SELECT * FROM production_global_federation_trust_anchors WHERE id=?',(aid,)).fetchone();return {'schema_version':'1.95','idempotent':False,'anchor':dict(row),'verification':_v195_verify(c,row)}
@app.get('/api/v195/ops/global-trust-anchor/verify')
def v195_verify(authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        rows=c.execute('SELECT * FROM production_global_federation_trust_anchors ORDER BY anchor_no ASC').fetchall();prev='0'*64
        for i,row in enumerate(rows,1):
            if int(row['anchor_no'])!=i:return {'schema_version':'1.95','valid':False,'reason':'ANCHOR_SEQUENCE_INVALID','checked_anchors':i}
            if row['previous_anchor_sha256']!=prev:return {'schema_version':'1.95','valid':False,'reason':'ANCHOR_CHAIN_INVALID','checked_anchors':i}
            vr=_v195_verify(c,row)
            if not vr['valid']:return {'schema_version':'1.95','valid':False,'reason':vr['reason'],'checked_anchors':i}
            prev=row['anchor_sha256']
        return {'schema_version':'1.95','valid':True,'reason':'GLOBAL_CROSS_FEDERATION_TRUST_CONTINUITY_VERIFIED','anchors':len(rows)}
@app.get('/api/v195/ops/global-trust-anchor/latest')
def v195_latest(authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        row=c.execute('SELECT * FROM production_global_federation_trust_anchors ORDER BY anchor_no DESC LIMIT 1').fetchone()
        if not row:return {'schema_version':'1.95','anchor':None,'verification':{'valid':False,'reason':'NO_ANCHOR'}}
        return {'schema_version':'1.95','anchor':dict(row),'verification':_v195_verify(c,row)}


# ---------------- WUNOO v1.96: Global Anchor Quorum & Cross-Federation Finality ----------------
def migrate_v196(c):
    c.executescript("""CREATE TABLE IF NOT EXISTS production_global_anchor_attestations(
        id TEXT PRIMARY KEY, anchor_id TEXT NOT NULL, anchor_sha256 TEXT NOT NULL,
        federation_id TEXT NOT NULL, witness_id TEXT NOT NULL, key_id TEXT NOT NULL,
        public_key_b64 TEXT NOT NULL, signature_b64 TEXT NOT NULL, attestation_json TEXT NOT NULL,
        attestation_sha256 TEXT NOT NULL UNIQUE, status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT,
        UNIQUE(anchor_id,witness_id)
    );
    CREATE TABLE IF NOT EXISTS production_global_anchor_finality(
        id TEXT PRIMARY KEY, anchor_id TEXT NOT NULL UNIQUE, anchor_sha256 TEXT NOT NULL,
        quorum_required INTEGER NOT NULL, federation_count INTEGER NOT NULL, witness_count INTEGER NOT NULL,
        federation_ids_json TEXT NOT NULL, witness_ids_json TEXT NOT NULL, attestation_hashes_json TEXT NOT NULL,
        proof_json TEXT NOT NULL, proof_sha256 TEXT NOT NULL UNIQUE, algorithm TEXT NOT NULL,
        signer_key_id TEXT NOT NULL, public_key_b64 TEXT NOT NULL, signature_b64 TEXT NOT NULL,
        status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT
    );
    CREATE INDEX IF NOT EXISTS idx_v196_attest_anchor ON production_global_anchor_attestations(anchor_id);
    CREATE INDEX IF NOT EXISTS idx_v196_finality_anchor ON production_global_anchor_finality(anchor_id);
    """)

_V196_POLICY={
    'schema_version':'1.96',
    'attestation_format':'wunoo.release.global.federation.trust.anchor.attestation.v1',
    'finality_format':'wunoo.release.global.federation.trust.anchor.finality.v1',
    'hash':'SHA-256','algorithm':'Ed25519',
    'requires_verified_v195_anchor':True,'requires_current_trusted_witness':True,
    'distinct_witness_quorum':True,'cross_federation_finality':True,
    'automatic_attestation':False,'automatic_finality':False,'fail_closed':True,'no_automatic_release':True
}
def _v196_hash(v): return hashlib.sha256(json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()).hexdigest()
def _v196_json(v): return json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False)
def _v196_attestation_payload(anchor,wid,keyid,fid):
    return {'format':_V196_POLICY['attestation_format'],'schema_version':'1.96','anchor_sha256':anchor['anchor_sha256'],'federation_id':fid,'witness_id':wid,'key_id':keyid}
def _v196_verify_attestation(c,row,anchor):
    try:
        obj=json.loads(row['attestation_json'] or '{}')
        if obj!=_v196_attestation_payload(anchor,row['witness_id'],row['key_id'],row['federation_id']): return {'valid':False,'reason':'GLOBAL_ANCHOR_ATTESTATION_PAYLOAD_INVALID'}
        if _v196_hash(obj)!=row['attestation_sha256']: return {'valid':False,'reason':'GLOBAL_ANCHOR_ATTESTATION_HASH_INVALID'}
        raw=base64.b64decode(row['public_key_b64'],validate=True)
        if _v176_key_id(raw)!=row['key_id']: return {'valid':False,'reason':'GLOBAL_ANCHOR_ATTESTATION_KEY_ID_INVALID'}
        reg=_v176_registry_row(c,row['witness_id'])
        if not reg or reg['status']!='ACTIVE': return {'valid':False,'reason':'WITNESS_NOT_ACTIVE'}
        if reg['current_key_id']!=row['key_id'] or reg['current_public_key_b64']!=row['public_key_b64']: return {'valid':False,'reason':'GLOBAL_ANCHOR_ATTESTATION_KEY_NOT_CURRENT'}
        trust=_v177_evaluate(c,row['witness_id'])
        if not trust['valid']: return {'valid':False,'reason':trust['reason']}
        heads=json.loads(anchor['federation_heads_json'] or '[]')
        member={x['federation_id'] for x in heads}
        if row['federation_id'] not in member: return {'valid':False,'reason':'ATTESTATION_FEDERATION_NOT_IN_ANCHOR'}
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto();Ed25519PublicKey.from_public_bytes(raw).verify(base64.b64decode(row['signature_b64'],validate=True),_v196_json(obj).encode())
        return {'valid':True,'witness_id':row['witness_id'],'federation_id':row['federation_id'],'key_id':row['key_id']}
    except Exception:return {'valid':False,'reason':'GLOBAL_ANCHOR_ATTESTATION_INVALID'}
def _v196_quorum(n):
    if n<1: raise HTTPException(409,'NO_FEDERATIONS')
    return (2*n)//3+1 if n>=3 else n
def _v196_finality_payload(anchor,q,fids,wids,hashes):
    return {'format':_V196_POLICY['finality_format'],'schema_version':'1.96','anchor_id':anchor['id'],'anchor_sha256':anchor['anchor_sha256'],'federation_ids':fids,'quorum_required':q,'witness_ids':wids,'attestation_hashes':hashes,'finality_state':'CROSS_FEDERATION_QUORUM_FINAL'}
def _v196_verify_finality(c,row):
    try:
        anchor=c.execute('SELECT * FROM production_global_federation_trust_anchors WHERE id=?',(row['anchor_id'],)).fetchone()
        if not anchor:return {'valid':False,'reason':'GLOBAL_ANCHOR_NOT_FOUND'}
        av=_v195_verify(c,anchor)
        if not av['valid']:return {'valid':False,'reason':av['reason']}
        proof=json.loads(row['proof_json'] or '{}')
        if _v196_hash(proof)!=row['proof_sha256']:return {'valid':False,'reason':'GLOBAL_FINALITY_PROOF_HASH_INVALID'}
        if proof!=_v196_finality_payload(anchor,int(row['quorum_required']),json.loads(row['federation_ids_json']),json.loads(row['witness_ids_json']),json.loads(row['attestation_hashes_json'])):return {'valid':False,'reason':'GLOBAL_FINALITY_PROOF_INVALID'}
        if int(row['federation_count'])!=len(json.loads(row['federation_ids_json'])) or int(row['witness_count'])!=len(json.loads(row['witness_ids_json'])):return {'valid':False,'reason':'GLOBAL_FINALITY_COUNTS_INVALID'}
        if int(row['witness_count'])<int(row['quorum_required']):return {'valid':False,'reason':'GLOBAL_FINALITY_QUORUM_INVALID'}
        seen=set()
        for aid in json.loads(row['attestation_hashes_json']):
            a=c.execute('SELECT * FROM production_global_anchor_attestations WHERE attestation_sha256=?',(aid,)).fetchone()
            if not a:return {'valid':False,'reason':'GLOBAL_ANCHOR_ATTESTATION_NOT_FOUND'}
            vr=_v196_verify_attestation(c,a,anchor)
            if not vr['valid']:return {'valid':False,'reason':vr['reason']}
            if vr['witness_id'] in seen:return {'valid':False,'reason':'GLOBAL_FINALITY_DUPLICATE_WITNESS'}
            seen.add(vr['witness_id'])
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto();Ed25519PublicKey.from_public_bytes(base64.b64decode(row['public_key_b64'],validate=True)).verify(base64.b64decode(row['signature_b64'],validate=True),_v196_json(proof).encode())
        return {'valid':True,'reason':'GLOBAL_ANCHOR_CROSS_FEDERATION_FINALITY_VERIFIED','witness_count':len(seen),'quorum_required':int(row['quorum_required'])}
    except Exception:return {'valid':False,'reason':'GLOBAL_ANCHOR_FINALITY_INVALID'}

@app.get('/api/v196/ops/global-anchor-finality/policy')
def v196_policy(authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'});return _V196_POLICY
@app.post('/api/v196/ops/global-anchor-finality/attest')
def v196_attest(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'});p=payload or {};anchor_id=str(p.get('anchor_id') or '').strip();wid=str(p.get('witness_id') or '').strip();fid=str(p.get('federation_id') or '').strip();pub=str(p.get('public_key_b64') or '').strip();sig=str(p.get('signature_b64') or '').strip()
    if not anchor_id or not wid or not fid or not pub or not sig:raise HTTPException(400,'anchor_id,witness_id,federation_id,public_key_b64,signature_b64 required')
    with core_db_connect() as c:
        anchor=c.execute('SELECT * FROM production_global_federation_trust_anchors WHERE id=?',(anchor_id,)).fetchone()
        if not anchor:raise HTTPException(404,'GLOBAL_ANCHOR_NOT_FOUND')
        av=_v195_verify(c,anchor)
        if not av['valid']:raise HTTPException(409,'GLOBAL_ANCHOR_NOT_VERIFIABLE')
        heads=json.loads(anchor['federation_heads_json'] or '[]')
        if fid not in {x['federation_id'] for x in heads}:raise HTTPException(409,'ATTESTATION_FEDERATION_NOT_IN_ANCHOR')
        try:keyid=_v176_key_id(base64.b64decode(pub,validate=True))
        except Exception:raise HTTPException(400,'GLOBAL_ANCHOR_PUBLIC_KEY_INVALID')
        obj=_v196_attestation_payload(anchor,wid,keyid,fid);digest=_v196_hash(obj);existing=c.execute('SELECT * FROM production_global_anchor_attestations WHERE anchor_id=? AND witness_id=?',(anchor_id,wid)).fetchone()
        if existing:
            if existing['attestation_sha256']==digest and existing['signature_b64']==sig and existing['public_key_b64']==pub:return {'schema_version':'1.96','idempotent':True,'attestation':dict(existing),'verification':_v196_verify_attestation(c,existing,anchor)}
            raise HTTPException(409,'GLOBAL_ANCHOR_ATTESTATION_ALREADY_EXISTS')
        temp={'id':'','anchor_id':anchor_id,'anchor_sha256':anchor['anchor_sha256'],'federation_id':fid,'witness_id':wid,'key_id':keyid,'public_key_b64':pub,'signature_b64':sig,'attestation_json':_v196_json(obj),'attestation_sha256':digest}
        vr=_v196_verify_attestation(c,temp,anchor)
        if not vr['valid']:raise HTTPException(409,vr['reason'])
        aid='gaa_'+uuid.uuid4().hex[:16];t=now();operator=str(u.get('email') or u.get('id') or 'operator')
        c.execute('INSERT INTO production_global_anchor_attestations(id,anchor_id,anchor_sha256,federation_id,witness_id,key_id,public_key_b64,signature_b64,attestation_json,attestation_sha256,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?)',(aid,anchor_id,anchor['anchor_sha256'],fid,wid,keyid,pub,sig,_v196_json(obj),digest,'VERIFIED',t,operator));c.commit();row=c.execute('SELECT * FROM production_global_anchor_attestations WHERE id=?',(aid,)).fetchone();return {'schema_version':'1.96','idempotent':False,'attestation':dict(row),'verification':_v196_verify_attestation(c,row,anchor)}
@app.post('/api/v196/ops/global-anchor-finality/finalize')
def v196_finalize(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin'});p=payload or {};operator=str(u.get('email') or u.get('id') or 'operator')
    with core_db_connect() as c:
        anchor=c.execute('SELECT * FROM production_global_federation_trust_anchors WHERE id=?',(p.get('anchor_id'),)).fetchone() if p.get('anchor_id') else c.execute('SELECT * FROM production_global_federation_trust_anchors ORDER BY anchor_no DESC LIMIT 1').fetchone()
        if not anchor:raise HTTPException(404,'GLOBAL_ANCHOR_NOT_FOUND')
        av=_v195_verify(c,anchor)
        if not av['valid']:raise HTTPException(409,'GLOBAL_ANCHOR_NOT_FINALIZABLE')
        existing=c.execute('SELECT * FROM production_global_anchor_finality WHERE anchor_id=?',(anchor['id'],)).fetchone()
        if existing:return {'schema_version':'1.96','idempotent':True,'finality':dict(existing),'verification':_v196_verify_finality(c,existing)}
        fids=sorted(x['federation_id'] for x in json.loads(anchor['federation_heads_json'] or '[]'));q=int(p.get('quorum_required') or _v196_quorum(len(fids)))
        if q<1 or q>len(fids):raise HTTPException(409,'GLOBAL_FINALITY_QUORUM_INVALID')
        rows=c.execute('SELECT * FROM production_global_anchor_attestations WHERE anchor_id=? ORDER BY witness_id ASC,attestation_sha256 ASC',(anchor['id'],)).fetchall();valid=[];seen=set();covered=set()
        for row in rows:
            vr=_v196_verify_attestation(c,row,anchor)
            if vr['valid'] and vr['witness_id'] not in seen:
                seen.add(vr['witness_id']);covered.add(vr['federation_id']);valid.append((row,vr))
        if len(valid)<q:raise HTTPException(409,'GLOBAL_ANCHOR_QUORUM_NOT_REACHED')
        if len(covered)<q:raise HTTPException(409,'CROSS_FEDERATION_QUORUM_NOT_REACHED')
        chosen=valid[:q];wids=[x[1]['witness_id'] for x in chosen];hashes=[x[0]['attestation_sha256'] for x in chosen];proof=_v196_finality_payload(anchor,q,fids,wids,hashes);ph=_v196_hash(proof);key,pub,keyid=_v169_load_signer();sig=base64.b64encode(key.sign(_v196_json(proof).encode())).decode();fid='gaf_'+uuid.uuid4().hex[:16];t=now()
        c.execute('INSERT INTO production_global_anchor_finality(id,anchor_id,anchor_sha256,quorum_required,federation_count,witness_count,federation_ids_json,witness_ids_json,attestation_hashes_json,proof_json,proof_sha256,algorithm,signer_key_id,public_key_b64,signature_b64,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(fid,anchor['id'],anchor['anchor_sha256'],q,len(fids),len(chosen),_v196_json(fids),_v196_json(wids),_v196_json(hashes),_v196_json(proof),ph,'Ed25519',keyid,base64.b64encode(pub).decode(),sig,'FINALIZED',t,operator));c.commit();row=c.execute('SELECT * FROM production_global_anchor_finality WHERE id=?',(fid,)).fetchone();return {'schema_version':'1.96','idempotent':False,'finality':dict(row),'verification':_v196_verify_finality(c,row)}
@app.get('/api/v196/ops/global-anchor-finality/verify')
def v196_verify(authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        rows=c.execute('SELECT * FROM production_global_anchor_finality ORDER BY created_at,id').fetchall()
        for i,row in enumerate(rows,1):
            vr=_v196_verify_finality(c,row)
            if not vr['valid']:return {'schema_version':'1.96','valid':False,'reason':vr['reason'],'checked_finalities':i}
        return {'schema_version':'1.96','valid':True,'reason':'GLOBAL_ANCHOR_CROSS_FEDERATION_FINALITY_VERIFIED','finalities':len(rows)}


# ---------------- WUNOO v1.97: Global Finality Continuity Chain ----------------
def migrate_v197(c):
    c.executescript("""CREATE TABLE IF NOT EXISTS production_global_finality_chain(
        id TEXT PRIMARY KEY, sequence_no INTEGER NOT NULL UNIQUE, finality_id TEXT NOT NULL UNIQUE,
        anchor_id TEXT NOT NULL, finality_proof_sha256 TEXT NOT NULL,
        previous_entry_sha256 TEXT NOT NULL, entry_json TEXT NOT NULL,
        entry_sha256 TEXT NOT NULL UNIQUE, algorithm TEXT NOT NULL,
        signer_key_id TEXT NOT NULL, public_key_b64 TEXT NOT NULL, signature_b64 TEXT NOT NULL,
        status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT
    );
    CREATE INDEX IF NOT EXISTS idx_v197_chain_finality ON production_global_finality_chain(finality_id);
    CREATE INDEX IF NOT EXISTS idx_v197_chain_anchor ON production_global_finality_chain(anchor_id);
    """)

_V197_POLICY={
    'schema_version':'1.97',
    'format':'wunoo.release.global.finality.continuity.entry.v1',
    'hash':'SHA-256','algorithm':'Ed25519','genesis_hash':'0'*64,
    'requires_verified_v196_finality':True,'strict_sequence':True,
    'requires_previous_entry':True,'immutable_history':True,
    'automatic_append':False,'fail_closed':True,'no_automatic_release':True
}
def _v197_hash(v): return hashlib.sha256(json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()).hexdigest()
def _v197_json(v): return json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False)
def _v197_payload(row,prev):
    return {'format':_V197_POLICY['format'],'schema_version':'1.97','sequence_no':int(row['sequence_no']),
            'finality_id':row['finality_id'],'anchor_id':row['anchor_id'],
            'finality_proof_sha256':row['finality_proof_sha256'],'previous_entry_sha256':prev}
def _v197_verify_entry(c,row):
    try:
        fin=c.execute('SELECT * FROM production_global_anchor_finality WHERE id=?',(row['finality_id'],)).fetchone()
        if not fin:return {'valid':False,'reason':'GLOBAL_FINALITY_NOT_FOUND'}
        fv=_v196_verify_finality(c,fin)
        if not fv['valid']:return {'valid':False,'reason':fv['reason']}
        if row['anchor_id']!=fin['anchor_id'] or row['finality_proof_sha256']!=fin['proof_sha256']:
            return {'valid':False,'reason':'GLOBAL_FINALITY_CHAIN_BINDING_INVALID'}
        seq=int(row['sequence_no'])
        prev=_V197_POLICY['genesis_hash'] if seq==1 else None
        if seq>1:
            pr=c.execute('SELECT * FROM production_global_finality_chain WHERE sequence_no=?',(seq-1,)).fetchone()
            if not pr:return {'valid':False,'reason':'GLOBAL_FINALITY_CHAIN_PREDECESSOR_MISSING'}
            prev=pr['entry_sha256']
        if row['previous_entry_sha256']!=prev:return {'valid':False,'reason':'GLOBAL_FINALITY_CHAIN_PREVIOUS_HASH_INVALID'}
        obj=json.loads(row['entry_json'] or '{}')
        if obj!=_v197_payload(row,prev):return {'valid':False,'reason':'GLOBAL_FINALITY_CHAIN_PAYLOAD_INVALID'}
        if _v197_hash(obj)!=row['entry_sha256']:return {'valid':False,'reason':'GLOBAL_FINALITY_CHAIN_ENTRY_HASH_INVALID'}
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto()
        Ed25519PublicKey.from_public_bytes(base64.b64decode(row['public_key_b64'],validate=True)).verify(base64.b64decode(row['signature_b64'],validate=True),_v197_json(obj).encode())
        return {'valid':True,'sequence_no':seq,'finality_id':row['finality_id'],'anchor_id':row['anchor_id']}
    except Exception:return {'valid':False,'reason':'GLOBAL_FINALITY_CHAIN_ENTRY_INVALID'}
def _v197_verify_chain(c):
    rows=c.execute('SELECT * FROM production_global_finality_chain ORDER BY sequence_no ASC').fetchall()
    expected=1;prev=_V197_POLICY['genesis_hash']
    for row in rows:
        if int(row['sequence_no'])!=expected:return {'valid':False,'reason':'GLOBAL_FINALITY_CHAIN_SEQUENCE_INVALID','checked_entries':expected-1}
        vr=_v197_verify_entry(c,row)
        if not vr['valid']:vr['checked_entries']=expected-1;return vr
        prev=row['entry_sha256'];expected+=1
    return {'valid':True,'entries':len(rows),'head_entry_sha256':prev if rows else _V197_POLICY['genesis_hash']}

@app.get('/api/v197/ops/global-finality-chain/policy')
def v197_policy(authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'});return _V197_POLICY
@app.post('/api/v197/ops/global-finality-chain/append')
def v197_append(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin'});p=payload or {};fid=str(p.get('finality_id') or '').strip()
    if not fid:raise HTTPException(400,'finality_id required')
    with core_db_connect() as c:
        fin=c.execute('SELECT * FROM production_global_anchor_finality WHERE id=?',(fid,)).fetchone()
        if not fin:raise HTTPException(404,'GLOBAL_FINALITY_NOT_FOUND')
        fv=_v196_verify_finality(c,fin)
        if not fv['valid']:raise HTTPException(409,'GLOBAL_FINALITY_NOT_VERIFIABLE')
        existing=c.execute('SELECT * FROM production_global_finality_chain WHERE finality_id=?',(fid,)).fetchone()
        if existing:return {'schema_version':'1.97','idempotent':True,'entry':dict(existing),'verification':_v197_verify_entry(c,existing)}
        last=c.execute('SELECT * FROM production_global_finality_chain ORDER BY sequence_no DESC LIMIT 1').fetchone()
        seq=int(last['sequence_no'])+1 if last else 1;prev=last['entry_sha256'] if last else _V197_POLICY['genesis_hash']
        obj=_v197_payload({'sequence_no':seq,'finality_id':fid,'anchor_id':fin['anchor_id'],'finality_proof_sha256':fin['proof_sha256']},prev);eh=_v197_hash(obj)
        key,pub,keyid=_v169_load_signer();sig=base64.b64encode(key.sign(_v197_json(obj).encode())).decode();eid='gfc_'+uuid.uuid4().hex[:16];t=now();operator=str(u.get('email') or u.get('id') or 'operator')
        c.execute('INSERT INTO production_global_finality_chain(id,sequence_no,finality_id,anchor_id,finality_proof_sha256,previous_entry_sha256,entry_json,entry_sha256,algorithm,signer_key_id,public_key_b64,signature_b64,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(eid,seq,fid,fin['anchor_id'],fin['proof_sha256'],prev,_v197_json(obj),eh,'Ed25519',keyid,base64.b64encode(pub).decode(),sig,'APPENDED',t,operator));c.commit();row=c.execute('SELECT * FROM production_global_finality_chain WHERE id=?',(eid,)).fetchone();return {'schema_version':'1.97','idempotent':False,'entry':dict(row),'verification':_v197_verify_entry(c,row)}
@app.get('/api/v197/ops/global-finality-chain/verify')
def v197_verify(authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:return {'schema_version':'1.97',**_v197_verify_chain(c)}
@app.get('/api/v197/ops/global-finality-chain/latest')
def v197_latest(authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        row=c.execute('SELECT * FROM production_global_finality_chain ORDER BY sequence_no DESC LIMIT 1').fetchone()
        return {'schema_version':'1.97','entry':dict(row) if row else None,'verification':_v197_verify_chain(c)}





# ---------------- WUNOO v1.104: Recovery Finality Chain Checkpoints & Cross-Federation Witness Quorum ----------------
def migrate_v104(c):
    c.executescript("""CREATE TABLE IF NOT EXISTS production_global_recovery_finality_chain_checkpoints(
        id TEXT PRIMARY KEY, checkpoint_no INTEGER NOT NULL UNIQUE, chain_sequence_no INTEGER NOT NULL,
        chain_head_entry_sha256 TEXT NOT NULL, entry_count INTEGER NOT NULL, prefix_manifest_json TEXT NOT NULL,
        checkpoint_json TEXT NOT NULL, checkpoint_sha256 TEXT NOT NULL UNIQUE, algorithm TEXT NOT NULL,
        signer_key_id TEXT NOT NULL, public_key_b64 TEXT NOT NULL, signature_b64 TEXT NOT NULL,
        status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT
    );
    CREATE INDEX IF NOT EXISTS idx_v104_checkpoint_seq ON production_global_recovery_finality_chain_checkpoints(chain_sequence_no);
    CREATE TABLE IF NOT EXISTS production_global_recovery_finality_checkpoint_attestations(
        id TEXT PRIMARY KEY, checkpoint_id TEXT NOT NULL, checkpoint_sha256 TEXT NOT NULL, federation_id TEXT NOT NULL,
        federation_sha256 TEXT NOT NULL, witness_id TEXT NOT NULL, key_id TEXT NOT NULL, public_key_b64 TEXT NOT NULL,
        signature_b64 TEXT NOT NULL, attestation_json TEXT NOT NULL, attestation_sha256 TEXT NOT NULL UNIQUE,
        status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT, UNIQUE(checkpoint_id,federation_id,witness_id)
    );
    CREATE INDEX IF NOT EXISTS idx_v104_att_cp_fed ON production_global_recovery_finality_checkpoint_attestations(checkpoint_id,federation_id);
    CREATE TABLE IF NOT EXISTS production_global_recovery_finality_checkpoint_finality(
        id TEXT PRIMARY KEY, checkpoint_id TEXT NOT NULL, checkpoint_sha256 TEXT NOT NULL, required_federation_quorum INTEGER NOT NULL,
        federation_count INTEGER NOT NULL, federation_ids_json TEXT NOT NULL, witness_ids_json TEXT NOT NULL,
        attestation_hashes_json TEXT NOT NULL, proof_json TEXT NOT NULL, proof_sha256 TEXT NOT NULL UNIQUE,
        algorithm TEXT NOT NULL, signer_key_id TEXT NOT NULL, public_key_b64 TEXT NOT NULL, signature_b64 TEXT NOT NULL,
        status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT
    );
    CREATE INDEX IF NOT EXISTS idx_v104_finality_cp ON production_global_recovery_finality_checkpoint_finality(checkpoint_id);
    """)

_V104_POLICY={'schema_version':'1.104','checkpoint_format':'wunoo.release.global.recovery.finality.chain.checkpoint.v1',
 'attestation_format':'wunoo.release.global.recovery.finality.chain.checkpoint.attestation.v1',
 'finality_format':'wunoo.release.global.recovery.finality.chain.checkpoint.finality.v1',
 'hash':'SHA-256','algorithm':'Ed25519','genesis_hash':'0'*64,'strict_sequence':True,'immutable_history':True,
 'requires_verified_v103_chain':True,'cross_federation_quorum_required':True,'no_automatic_recovery':True,'fail_closed':True,'no_automatic_release':True}
def _v104_json(v): return json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False)
def _v104_hash(v): return hashlib.sha256(_v104_json(v).encode()).hexdigest()
def _v104_quorum(n): return n if n<3 else (2*n)//3+1
def _v104_manifest(c,seq):
    rows=c.execute('SELECT * FROM production_global_recovery_checkpoint_finality_chain WHERE sequence_no<=? ORDER BY sequence_no ASC',(seq,)).fetchall()
    return [{'sequence_no':int(r['sequence_no']),'entry_id':r['id'],'entry_sha256':r['entry_sha256'],'finality_id':r['finality_id'],'checkpoint_id':r['checkpoint_id'],'checkpoint_sha256':r['checkpoint_sha256'],'finality_proof_sha256':r['finality_proof_sha256']} for r in rows]
def _v104_checkpoint_payload(no,seq,head,manifest):
    return {'format':_V104_POLICY['checkpoint_format'],'schema_version':'1.104','checkpoint_no':int(no),'chain_sequence_no':int(seq),'chain_head_entry_sha256':head,'entry_count':len(manifest),'prefix_manifest':manifest,'continuity_state':'GLOBAL_RECOVERY_FINALITY_CHAIN_CHECKPOINTED'}
def _v104_verify_checkpoint(c,row):
    try:
        obj=json.loads(row['checkpoint_json'] or '{}')
        if obj.get('format')!=_V104_POLICY['checkpoint_format'] or obj.get('schema_version')!='1.104': return {'valid':False,'reason':'V104_CHECKPOINT_FORMAT_INVALID'}
        if _v104_hash(obj)!=row['checkpoint_sha256']: return {'valid':False,'reason':'V104_CHECKPOINT_HASH_INVALID'}
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto(); Ed25519PublicKey.from_public_bytes(base64.b64decode(row['public_key_b64'],validate=True)).verify(base64.b64decode(row['signature_b64'],validate=True),_v104_json(obj).encode())
        manifest=obj.get('prefix_manifest') or []
        if int(row['chain_sequence_no'])!=int(obj.get('chain_sequence_no',-1)) or int(row['entry_count'])!=len(manifest) or obj.get('chain_head_entry_sha256')!=row['chain_head_entry_sha256']: return {'valid':False,'reason':'V104_CHECKPOINT_METADATA_INVALID'}
        if int(row['entry_count'])!=int(row['chain_sequence_no']): return {'valid':False,'reason':'V104_CHECKPOINT_SEQUENCE_COUNT_INVALID'}
        chain=_v103_verify_chain(c)
        # Current chain may legitimately have entries after this historical checkpoint. Validate only its prefix.
        prev=_V103_POLICY['genesis_hash']; expected=1
        for m in manifest:
            if int(m['sequence_no'])!=expected:
                return {'valid':False,'reason':'V104_MANIFEST_SEQUENCE_INVALID','sequence_no':expected}
            r=c.execute('SELECT * FROM production_global_recovery_checkpoint_finality_chain WHERE sequence_no=?',(expected,)).fetchone()
            if not r:return {'valid':False,'reason':'V104_CURRENT_CHAIN_MISSING_PREFIX_ENTRY','sequence_no':expected}
            vr=_v103_verify_entry(c,r)
            if not vr.get('valid'):return {'valid':False,'reason':'V104_PREFIX_ENTRY_NOT_VERIFIABLE','sequence_no':expected,'detail':vr.get('reason')}
            if r['entry_sha256']!=m['entry_sha256'] or r['id']!=m['entry_id']:return {'valid':False,'reason':'V104_PREFIX_ENTRY_DIVERGED','sequence_no':expected}
            if r['previous_entry_sha256']!=prev:return {'valid':False,'reason':'V104_PREFIX_LINK_INVALID','sequence_no':expected}
            prev=r['entry_sha256'];expected+=1
        if manifest and prev!=row['chain_head_entry_sha256']:return {'valid':False,'reason':'V104_CHECKPOINT_HEAD_INVALID'}
        return {'valid':True,'checkpoint_no':int(row['checkpoint_no']),'chain_sequence_no':int(row['chain_sequence_no']),'historical_prefix_valid':True,'current_chain_entries':chain.get('entries',0) if chain.get('valid') else None}
    except Exception:return {'valid':False,'reason':'V104_CHECKPOINT_INVALID'}
def _v104_attestation_payload(cp,fed,wid,keyid):
    return {'format':_V104_POLICY['attestation_format'],'schema_version':'1.104','checkpoint_sha256':cp['checkpoint_sha256'],'federation_id':fed['id'],'federation_sha256':fed['federation_sha256'],'witness_id':wid,'key_id':keyid}
def _v104_verify_attestation(c,row,cp,fed):
    try:
        cv=_v104_verify_checkpoint(c,cp)
        if not cv.get('valid'):return {'valid':False,'reason':'V104_CHECKPOINT_NOT_VERIFIABLE','detail':cv.get('reason')}
        fv=_v184_verify_federation(c,fed)
        if not fv.get('valid'):return {'valid':False,'reason':'V184_FEDERATION_NOT_VERIFIABLE','detail':fv.get('reason')}
        members=json.loads(fed['member_witness_ids_json'] or '[]')
        if row['witness_id'] not in members:return {'valid':False,'reason':'V104_WITNESS_NOT_FEDERATION_MEMBER'}
        tr=_v177_evaluate(c,row['witness_id'])
        if not tr.get('valid'):return {'valid':False,'reason':'V104_WITNESS_NOT_TRUSTED','detail':tr.get('reason')}
        if row['key_id']!=tr.get('current_key_id'):return {'valid':False,'reason':'V104_KEY_NOT_CURRENT'}
        obj=json.loads(row['attestation_json'] or '{}'); exp=_v104_attestation_payload(cp,fed,row['witness_id'],row['key_id'])
        if obj!=exp or _v104_hash(obj)!=row['attestation_sha256']:return {'valid':False,'reason':'V104_ATTESTATION_BINDING_INVALID'}
        if row['checkpoint_sha256']!=cp['checkpoint_sha256'] or row['federation_id']!=fed['id']:return {'valid':False,'reason':'V104_ATTESTATION_METADATA_INVALID'}
        raw=base64.b64decode(row['public_key_b64'],validate=True)
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto(); Ed25519PublicKey.from_public_bytes(raw).verify(base64.b64decode(row['signature_b64'],validate=True),_v104_json(obj).encode())
        if _v176_key_id(raw)!=row['key_id']:return {'valid':False,'reason':'V104_KEY_ID_INVALID'}
        return {'valid':True,'witness_id':row['witness_id'],'federation_id':row['federation_id']}
    except Exception:return {'valid':False,'reason':'V104_ATTESTATION_INVALID'}
def _v104_finality_payload(cp,q,fids,wids,ahs):
    return {'format':_V104_POLICY['finality_format'],'schema_version':'1.104','checkpoint_id':cp['id'],'checkpoint_sha256':cp['checkpoint_sha256'],'required_federation_quorum':int(q),'federation_ids':list(fids),'witness_ids':list(wids),'attestation_hashes':list(ahs),'finality_state':'CROSS_FEDERATION_WITNESS_QUORUM_FINALIZED'}
def _v104_verify_finality(c,row):
    try:
        cp=c.execute('SELECT * FROM production_global_recovery_finality_chain_checkpoints WHERE id=?',(row['checkpoint_id'],)).fetchone()
        if not cp:return {'valid':False,'reason':'V104_CHECKPOINT_NOT_FOUND'}
        cv=_v104_verify_checkpoint(c,cp)
        if not cv.get('valid'):return {'valid':False,'reason':'V104_CHECKPOINT_NOT_VERIFIABLE','detail':cv.get('reason')}
        fids=json.loads(row['federation_ids_json'] or '[]');wids=json.loads(row['witness_ids_json'] or '[]');ahs=json.loads(row['attestation_hashes_json'] or '[]');q=int(row['required_federation_quorum'])
        if len(fids)!=int(row['federation_count']) or len(fids)!=len(set(fids)) or len(wids)!=len(set(wids)) or len(ahs)!=len(set(ahs)) or len(fids)<q:return {'valid':False,'reason':'V104_FINALITY_QUORUM_INVALID'}
        if len(fids)!=len(wids) or len(wids)!=len(ahs):return {'valid':False,'reason':'V104_FINALITY_CARDINALITY_INVALID'}
        for fid,wid,ah in zip(fids,wids,ahs):
            a=c.execute('SELECT * FROM production_global_recovery_finality_checkpoint_attestations WHERE attestation_sha256=?',(ah,)).fetchone()
            if not a:return {'valid':False,'reason':'V104_ATTESTATION_NOT_FOUND'}
            fed=c.execute('SELECT * FROM production_global_checkpoint_federations WHERE id=?',(fid,)).fetchone()
            ar=_v104_verify_attestation(c,a,cp,fed)
            if not ar.get('valid'):return {'valid':False,'reason':'V104_ATTESTATION_NOT_VERIFIABLE','detail':ar.get('reason')}
            if a['federation_id']!=fid or a['witness_id']!=wid:return {'valid':False,'reason':'V104_FINALITY_ATTESTATION_BINDING_INVALID'}
        proof=json.loads(row['proof_json'] or '{}'); exp=_v104_finality_payload(cp,q,fids,wids,ahs)
        if proof!=exp or _v104_hash(proof)!=row['proof_sha256']:return {'valid':False,'reason':'V104_FINALITY_PROOF_INVALID'}
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto();Ed25519PublicKey.from_public_bytes(base64.b64decode(row['public_key_b64'],validate=True)).verify(base64.b64decode(row['signature_b64'],validate=True),_v104_json(proof).encode())
        return {'valid':True,'checkpoint_id':cp['id'],'federation_count':len(fids),'required_federation_quorum':q}
    except Exception:return {'valid':False,'reason':'V104_FINALITY_INVALID'}

