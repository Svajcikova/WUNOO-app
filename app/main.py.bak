    with core_db_connect() as c:
        rows=c.execute('SELECT * FROM v123_job_runs ORDER BY started_at DESC,id DESC LIMIT 200').fetchall()
        return {'schema_version':'1.23','count':len(rows),'jobs':[dict(x) for x in rows]}


