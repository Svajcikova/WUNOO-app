@app.post("/api/v095/ops/security/incidents/evaluate")
def v095_incident_evaluate(authorization:str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    with core_db_connect() as c:
        migrate_v095(c)
        alerts=c.execute("SELECT * FROM security_alerts WHERE status='open' ORDER BY created_at").fetchall()
        created=[]
        for a in alerts:
            key=f"alert:{a['alert_key']}"
            existing=c.execute("SELECT * FROM security_incidents WHERE incident_key=?",(key,)).fetchone()
            if existing:
                c.execute("UPDATE security_incidents SET last_seen=? WHERE id=?",(now(),existing["id"])); continue
            iid="inc_"+uuid.uuid4().hex[:12]
            c.execute("""INSERT INTO security_incidents
                (id,incident_key,title,severity,status,first_seen,last_seen,details_json)
                VALUES (?,?,?,?,?,?,?,?)""",
                (iid,key,a["alert_type"],a["severity"],"open",a["created_at"],now(),a["details_json"]))
            c.execute("""INSERT INTO security_incident_timeline
                (id,incident_id,event_type,note,created_at) VALUES (?,?,?,?,?)""",
                ("sit_"+uuid.uuid4().hex[:12],iid,"created","Created from security alert",now()))
            created.append(iid)
        c.commit()
    return {"created":created,"count":len(created)}

