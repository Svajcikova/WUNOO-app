        if not o or (u["role"] == "courier" and o["courier_id"] != u["courier_id"]):
            raise HTTPException(403, "Objednávka není dostupná")
        transition(c, order_id, "picked_up", "out_for_delivery", u, "out_for_delivery_started", {"courier_id": o["courier_id"]})
        c.commit()
        return {"order_id": order_id, "status": "out_for_delivery"}


@app.post("/api/orders/{order_id}/deliver")
def deliver(order_id: str, authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u = current_user(authorization); require_role(u, "courier", "admin")
    with core_db_connect() as c:
        c.execute("BEGIN")
        o = c.execute("SELECT * FROM orders WHERE id=?", (order_id,)).fetchone()
        if not o or (u["role"] == "courier" and o["courier_id"] != u["courier_id"]):
            raise HTTPException(403, "Objednávka není dostupná")
        proof_required = ("delivery_proof_status" in o.keys() and o["delivery_proof_status"] == "required_v044")
        if u["role"] != "admin" and proof_required:
            c.execute("""CREATE TABLE IF NOT EXISTS delivery_proofs(
                id TEXT PRIMARY KEY,
                order_id TEXT NOT NULL UNIQUE,
                method TEXT NOT NULL,
                pin_last4 TEXT,
                note TEXT,
                created_at TEXT NOT NULL
            )""")
            proof=c.execute("SELECT 1 FROM delivery_proofs WHERE order_id=?",(order_id,)).fetchone()
            if not proof:
                raise HTTPException(409, "Před dokončením doručení chybí proof-of-delivery")
        if c.execute("SELECT 1 FROM settlements WHERE order_id=?", (order_id,)).fetchone():
            raise HTTPException(409, "Settlement již existuje")
        current = "out_for_delivery" if o["status"] == "out_for_delivery" else "picked_up"
        transition(c, order_id, current, "delivered", u, "delivery_completed", {"courier_id": o["courier_id"]})
        courier_payout = round(40.0 + 7.0 * float(o["delivery_distance_km"]), 2)
        merchant_amount = round(o["subtotal_czk"], 2)
        platform_amount = round(o["total_czk"] - merchant_amount - courier_payout, 2)
        variance = round(o["total_czk"] - merchant_amount - courier_payout - platform_amount, 2)
        sid = "set_" + uuid.uuid4().hex[:10]
        c.execute("INSERT INTO settlements VALUES (?,?,?,?,?,?,?,?)", (sid, order_id, merchant_amount, courier_payout, platform_amount, variance, "reconciled" if variance == 0 else "exception", now()))
        if o["courier_id"]:
            c.execute("UPDATE couriers SET earnings_czk=earnings_czk+? WHERE id=?", (courier_payout, o["courier_id"]))
        ts = now()
        c.execute("UPDATE orders SET delivered_at=?, updated_at=? WHERE id=?", (ts, ts, order_id))
        emit(c, order_id, "settlement_completed", {"settlement_id": sid, "variance_czk": variance}, u["id"])
        c.commit()
        return {"order_id": order_id, "status": "delivered", "settlement_id": sid, "variance_czk": variance}


def _latest_courier_location(c: sqlite3.Connection, courier_id: str | None) -> dict[str, Any] | None:
    if not courier_id: return None
    row=c.execute("SELECT lat, lon, accuracy_m, recorded_at FROM courier_locations WHERE courier_id=? ORDER BY recorded_at DESC LIMIT 1", (courier_id,)).fetchone()
    return dict(row) if row else None

@app.get("/api/orders/{order_id}/tracking")
def order_tracking(order_id: str, authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u=current_user(authorization)
    with core_db_connect() as c:
        o=c.execute("SELECT o.*, m.name merchant_name, cr.name courier_name FROM orders o JOIN merchants m ON m.id=o.merchant_id LEFT JOIN couriers cr ON cr.id=o.courier_id WHERE o.id=?", (order_id,)).fetchone()
        if not o: raise HTTPException(404, "Objednávka nenalezena")
        if u["role"]=="customer" and o["customer_id"]!=u["customer_id"]: raise HTTPException(403,"Objednávka není vaše")
        if u["role"]=="merchant" and o["merchant_id"]!=u["merchant_id"]: raise HTTPException(403,"Objednávka není vaše restaurace")
        if u["role"]=="courier" and o["courier_id"] not in (u["courier_id"],None): raise HTTPException(403,"Objednávka není přiřazená vám")
        order_states=["payment_pending","merchant_pending","preparing","dispatch_pending","assigned","picked_up","out_for_delivery","delivered"]
        idx=order_states.index(o["status"]) if o["status"] in order_states else -1
        stages=[
            {"key":"merchant_pending","label":"Restaurace přijala","done":idx>=1},
            {"key":"preparing","label":"Připravujeme","done":idx>=2},
            {"key":"dispatch_pending","label":"Hledáme kurýra","done":idx>=3},
            {"key":"assigned","label":"Kurýr převzal","done":idx>=4},
            {"key":"out_for_delivery","label":"Na cestě","done":idx>=5},
            {"key":"delivered","label":"Doručeno","done":idx>=6},
        ]
        loc=_latest_courier_location(c,o["courier_id"])
        stale=True
        if loc:
            age=(datetime.now(timezone.utc)-datetime.fromisoformat(loc["recorded_at"].replace("Z","+00:00"))).total_seconds()
            stale=age>120
        result={"order_id":order_id,"status":o["status"],"delay_level":o["delay_level"],"merchant_name":o["merchant_name"],"courier_name":o["courier_name"],"address":o["address"],"promised_delivery_at":o["promised_delivery_at"],"predicted_delivery_at":o["predicted_delivery_at"],"courier_location":loc,"location_stale":stale,"stages":stages}
        if loc and o["address_id"]:
            addr=c.execute("SELECT lat,lon FROM customer_addresses WHERE id=?",(o["address_id"],)).fetchone()
            if addr:
                rem=haversine_km(loc["lat"],loc["lon"],addr["lat"],addr["lon"])
                result["remaining_distance_km"]=rem
                result["live_eta_minutes"]=max(2, round(rem*4+2))
        return result

@app.get("/api/orders/{order_id}/eta")
def order_eta(order_id: str, authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u = current_user(authorization)
    with core_db_connect() as c:
        o = c.execute("SELECT * FROM orders WHERE id=?", (order_id,)).fetchone()
        if not o: raise HTTPException(404, "Objednávka nenalezena")
        if u["role"] == "customer" and o["customer_id"] != u["customer_id"]: raise HTTPException(403, "Objednávka není vaše")
        if u["role"] == "merchant" and o["merchant_id"] != u["merchant_id"]: raise HTTPException(403, "Objednávka není vaše restaurace")
        return {
            "order_id": order_id, "status": o["status"], "delay_level": o["delay_level"],
            "prep_eta_minutes": o["prep_eta_minutes"],
            "promised_delivery_at": o["promised_delivery_at"],
            "predicted_pickup_at": o["predicted_pickup_at"],
            "predicted_delivery_at": o["predicted_delivery_at"],
            "assigned_at": o["assigned_at"], "picked_up_at": o["picked_up_at"], "delivered_at": o["delivered_at"]
        }


@app.post("/api/orders/{order_id}/timing")
def update_timing(order_id: str, body: TimingIn, authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u = current_user(authorization); require_role(u, "merchant", "admin")
    from datetime import timedelta
    with core_db_connect() as c:
        o = c.execute("SELECT * FROM orders WHERE id=?", (order_id,)).fetchone()
        if not o: raise HTTPException(404, "Objednávka nenalezena")
        if u["role"] == "merchant" and o["merchant_id"] != u["merchant_id"]: raise HTTPException(403, "Objednávka není vaše restaurace")
        old_eta = o["prep_eta_minutes"]
        promised = (datetime.now(timezone.utc) + timedelta(minutes=body.promised_delivery_minutes)).isoformat()
        c.execute("UPDATE orders SET prep_eta_minutes=?, promised_delivery_at=?, updated_at=? WHERE id=?", (body.prep_eta_minutes, promised, now(), order_id))
        emit(c, order_id, "eta_updated", {"old_prep_eta_minutes": old_eta, "new_prep_eta_minutes": body.prep_eta_minutes, "promised_delivery_at": promised}, u["id"])
        c.commit()
        return {"order_id": order_id, "prep_eta_minutes": body.prep_eta_minutes, "promised_delivery_at": promised}


@app.post("/api/orders/{order_id}/timeout-check")
def timeout_check(order_id: str, body: TimeoutIn | None = None, authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u = current_user(authorization); require_role(u, "ops_agent", "admin", "merchant", "customer") if False else None
    # MVP: timeout simulation is available to admin only; customer/merchant cannot force state changes.
    require_role(u, "admin")
    from datetime import timedelta
    with core_db_connect() as c:
        o = c.execute("SELECT * FROM orders WHERE id=?", (order_id,)).fetchone()
        if not o: raise HTTPException(404, "Objednávka nenalezena")
        t = datetime.fromisoformat((body.now_at if body and body.now_at else now()).replace("Z", "+00:00"))
        delay = "NONE"
        action = "NO_ACTION"
        if o["status"] == "merchant_pending":
            created = datetime.fromisoformat(o["created_at"].replace("Z", "+00:00"))
            if (t-created).total_seconds() >= 600:
                delay = "CRITICAL"; action = "MERCHANT_TIMEOUT"
        elif o["predicted_delivery_at"]:
            pred = datetime.fromisoformat(o["predicted_delivery_at"].replace("Z", "+00:00"))
            promised = datetime.fromisoformat(o["promised_delivery_at"].replace("Z", "+00:00")) if o["promised_delivery_at"] else None
            if promised and pred > promised:
                delay = "DELAYED"
                if pred > promised + timedelta(minutes=20): delay = "MATERIAL_DELAY"
                action = "MARK_DELAYED"
        if delay != o["delay_level"]:
            c.execute("UPDATE orders SET delay_level=?, updated_at=? WHERE id=?", (delay, now(), order_id))
            emit(c, order_id, "timeout_checked", {"delay_level": delay, "action": action}, u["id"])
            c.commit()
        return {"order_id": order_id, "delay_level": delay, "action": action}


@app.get("/api/courier/jobs")
def courier_jobs(authorization: str | None = Header(default=None)) -> list[dict[str, Any]]:
    u = current_user(authorization); require_role(u, "courier", "admin")
    with core_db_connect() as c:
        rows = c.execute("SELECT o.*, m.name merchant_name FROM orders o JOIN merchants m ON m.id=o.merchant_id WHERE o.status IN ('dispatch_pending','assigned','out_for_delivery') ORDER BY o.created_at DESC").fetchall()
        result=[]
        for r in rows:
            result.append({"id":r["id"],"status":r["status"],"merchant_name":r["merchant_name"],"address":r["address"],"total_czk":r["total_czk"],"courier_id":r["courier_id"]})
        return result

@app.post("/api/courier/status")
def courier_status(status: str, authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u = current_user(authorization); require_role(u, "courier", "admin")
    if status not in {"online", "offline"}:
        raise HTTPException(400, "Neplatný status kurýra")
    courier_id = u["courier_id"] if u["role"] == "courier" else None
    if not courier_id:
        raise HTTPException(400, "Admin musí řídit status přes backoffice workflow")
    with core_db_connect() as c:
        c.execute("UPDATE couriers SET status=? WHERE id=?", (status, courier_id)); c.commit()
    return {"courier_id": courier_id, "status": status}


@app.post("/api/reset-demo")
def reset_demo() -> dict[str, str]:
    if DB_PATH.exists():
        DB_PATH.unlink()
    init_db()
    with core_db_connect() as c:
        _run_all_migrations(c)
    return {"status": "reset"}


@app.post("/api/courier/location/track")
def courier_location_track(payload: dict, authorization: str | None = Header(default=None)):
    u = current_user(authorization); require_role(u, "courier")
    order_id = payload.get("order_id")
    lat = payload.get("lat")
    lon = payload.get("lon")
    reported_at = payload.get("reported_at") or now()
    accuracy_m = payload.get("accuracy_m")
    if not order_id or lat is None or lon is None:
        raise HTTPException(400, "order_id, lat and lon required")
    with core_db_connect() as c:
        order = c.execute("SELECT * FROM orders WHERE id=?", (order_id,)).fetchone()
        if not order or order["courier_id"] != u["courier_id"]:
            raise HTTPException(404, "Objednávka nenalezena")
        if order["status"] not in {"assigned","picked_up","out_for_delivery","delayed"}:
            raise HTTPException(409, "Objednávka není v delivery stavu")
        prev = c.execute("SELECT recorded_at FROM courier_locations WHERE order_id=? AND courier_id=? ORDER BY recorded_at DESC LIMIT 1", (order_id, u["courier_id"])).fetchone()
        if prev and str(reported_at) < str(prev["recorded_at"]):
            raise HTTPException(409, "Zastaralá poloha")
        addr = c.execute("SELECT lat,lon FROM customer_addresses WHERE id=?", (order["address_id"],)).fetchone() if order["address_id"] else None
        if not addr:
            raise HTTPException(409, "Objednávka nemá platnou cílovou adresu")
        remaining = haversine_km(float(lat), float(lon), float(addr["lat"]), float(addr["lon"]))
        eta = max(2, round(float(remaining) * 4 + 2))
        initial = order["delivery_distance_km"] or remaining
        deviation = round(max(0.0, float(remaining) / max(float(initial), 0.01) - 1.0), 3)
        c.execute("INSERT INTO courier_locations(id,order_id,courier_id,lat,lon,accuracy_m,recorded_at,remaining_distance_km,live_eta_minutes,deviation_ratio) VALUES (?,?,?,?,?,?,?,?,?,?)", (str(uuid.uuid4()),order_id,u["courier_id"],float(lat),float(lon),accuracy_m,reported_at,remaining,eta,deviation))
        predicted = (datetime.fromisoformat(str(reported_at).replace("Z","+00:00")) + __import__('datetime').timedelta(minutes=eta)).isoformat()
        promised = order["promised_delivery_at"]
        delay = _tracking_status(remaining, promised, predicted)
        c.execute("UPDATE orders SET live_eta_minutes=?, predicted_delivery_at=?, delay_level=?, updated_at=? WHERE id=?", (eta,predicted,delay,now(),order_id))
        emit(c,order_id,"courier_location_updated",{"lat":float(lat),"lon":float(lon),"remaining_distance_km":remaining,"live_eta_minutes":eta,"deviation_ratio":deviation,"delay_level":delay},u["id"])
        if delay in {"DELAYED","MATERIAL_DELAY","CRITICAL"}:
            notify_customer(c, order["customer_id"], order_id, "delivery_delay", "Aktualizace doručení", f"Objednávka se zpozdila. Nový odhad: {eta} min.")
            emit(c,order_id,"delivery_delay_detected",{"delay_level":delay,"live_eta_minutes":eta},u["id"])
        c.commit()
        return {"ok":True,"order_id":order_id,"remaining_distance_km":remaining,"live_eta_minutes":eta,"predicted_delivery_at":predicted,"delay_level":delay,"deviation_ratio":deviation,"location_stale":False}


@app.get("/api/orders/{order_id}/tracking/live")
def live_tracking(order_id: str, authorization: str | None = Header(default=None)):
    u = current_user(authorization)
    require_role(u, "customer", "merchant", "courier", "admin")
    with core_db_connect() as c:
        o = c.execute("SELECT o.*, m.name merchant_name, cr.name courier_name FROM orders o JOIN merchants m ON m.id=o.merchant_id LEFT JOIN couriers cr ON cr.id=o.courier_id WHERE o.id=?", (order_id,)).fetchone()
        if not o: raise HTTPException(404, "Objednávka nenalezena")
        if u["role"]=="customer" and o["customer_id"]!=u["customer_id"]: raise HTTPException(403,"Objednávka není vaše")
        if u["role"]=="merchant" and o["merchant_id"]!=u["merchant_id"]: raise HTTPException(403,"Objednávka není vaše restaurace")
        if u["role"]=="courier" and o["courier_id"]!=u["courier_id"]: raise HTTPException(403,"Objednávka není přiřazená vám")
        loc = c.execute("SELECT * FROM courier_locations WHERE order_id=? ORDER BY recorded_at DESC LIMIT 1", (order_id,)).fetchone()
        if not loc:
            return {"order_id":order_id,"tracking_available":False,"status":o["status"],"delay_level":o["delay_level"]}
        age = max(0.0,(datetime.now(timezone.utc)-datetime.fromisoformat(loc["recorded_at"].replace("Z","+00:00"))).total_seconds())
        return {"order_id":order_id,"tracking_available":True,"status":o["status"],"delay_level":o["delay_level"],"courier_id":o["courier_id"],"courier_name":o["courier_name"],"lat":loc["lat"],"lon":loc["lon"],"remaining_distance_km":loc["remaining_distance_km"],"live_eta_minutes":loc["live_eta_minutes"],"deviation_ratio":loc["deviation_ratio"],"location_age_seconds":round(age,1),"location_stale":age>120,"reported_at":loc["recorded_at"]}

@app.get("/track/{order_id}", response_class=HTMLResponse)
def track_page(order_id: int):
    return HTMLResponse(f"""
<!doctype html><html><head><meta name="viewport" content="width=device-width,initial-scale=1">
<title>WUNOO Tracking</title>
<style>
body{{font-family:Inter,system-ui,sans-serif;background:#f5f5f5;margin:0;padding:20px}}
.card{{max-width:720px;margin:auto;background:white;border-radius:18px;padding:24px;box-shadow:0 8px 30px rgba(0,0,0,.08)}}
h1{{margin-top:0}} .pill{{display:inline-block;padding:6px 10px;border-radius:999px;background:#eee}}
.grid{{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-top:18px}}
.kpi{{background:#f7f7f7;padding:14px;border-radius:12px}}
small{{color:#777}} pre{{white-space:pre-wrap;word-break:break-word}}
</style></head><body><div class="card">
<h1>Objednávka #{order_id}</h1>
<div id="state" class="pill">Načítání…</div>
<div class="grid">
<div class="kpi"><small>ETA</small><div id="eta">–</div></div>
<div class="kpi"><small>Zbývá</small><div id="distance">–</div></div>
<div class="kpi"><small>Zpoždění</small><div id="delay">–</div></div>
<div class="kpi"><small>Poloha</small><div id="fresh">–</div></div>
</div>
<p><small>Tracking se aktualizuje automaticky každých 10 s.</small></p>
<pre id="raw"></pre>
</div>
<script>
async function refresh(){{
  try{{
    const r=await fetch('/api/orders/{order_id}/tracking/live');
    const d=await r.json();
    document.getElementById('raw').textContent=JSON.stringify(d,null,2);
    if(!d.tracking_available){{document.getElementById('state').textContent='Kurýr zatím neposlal polohu';return;}}
    document.getElementById('state').textContent=d.delay_level||'ON_TIME';
    document.getElementById('eta').textContent=(d.live_eta_minutes??'–')+' min';
    document.getElementById('distance').textContent=(d.remaining_distance_km??'–')+' km';
    document.getElementById('delay').textContent=d.delay_level||'–';
    document.getElementById('fresh').textContent=d.location_stale?'Zastaralá':'Aktuální';
  }}catch(e){{document.getElementById('state').textContent='Tracking nedostupný';}}
}}
refresh();setInterval(refresh,10000);
</script></body></html>
""")


@app.post("/api/orders/{order_id}/recovery-check")
def recovery_check(order_id: str, authorization: str | None = Header(default=None)):
    u = current_user(authorization); require_role(u, "admin", "courier")
    with core_db_connect() as c:
        o = c.execute("SELECT * FROM orders WHERE id=?", (order_id,)).fetchone()
        if not o: raise HTTPException(404, "Objednávka nenalezena")
        if u["role"]=="courier" and o["courier_id"]!=u["courier_id"]: raise HTTPException(403,"Objednávka není vaše")
        loc = c.execute("SELECT * FROM courier_locations WHERE order_id=? ORDER BY recorded_at DESC LIMIT 1", (order_id,)).fetchone() if o["courier_id"] else None
        latest=dict(loc) if loc else None
        if latest:
            age=max(0.0,(datetime.now(timezone.utc)-datetime.fromisoformat(latest["recorded_at"].replace("Z","+00:00"))).total_seconds())
            latest["location_stale"]=age>120
        decision=_recovery_decision(dict(o),latest)
        if decision["action"] != "MONITOR":
            msg=_safe_recovery_message(decision["action"],o["live_eta_minutes"])
            notify_customer(c,o["customer_id"],order_id,"delivery_recovery","Aktualizace doručení",msg or "Prověřujeme doručení objednávky.")
            emit(c,order_id,"delivery_recovery_triggered",{"action":decision["action"],"reason":decision["reason"],"live_eta_minutes":o["live_eta_minutes"]},u["id"])
            c.commit()
        return {"order_id":order_id,"action":decision["action"],"reason":decision["reason"],"delay_level":o["delay_level"]}




@app.post("/api/ops/recovery-sweep")
def recovery_sweep(authorization: str | None = Header(default=None)):
    u=current_user(authorization); require_role(u,"admin")
    checked=0; triggered=[]
    with core_db_connect() as c:
        rows=c.execute("SELECT * FROM orders WHERE status IN ('assigned','picked_up','out_for_delivery','delayed') ORDER BY updated_at").fetchall()
        checked=len(rows)
        for o in rows:
            loc=c.execute("SELECT * FROM courier_locations WHERE order_id=? ORDER BY recorded_at DESC LIMIT 1",(o["id"],)).fetchone() if o["courier_id"] else None
            latest=dict(loc) if loc else None
            if latest:
                age=max(0.0,(datetime.now(timezone.utc)-datetime.fromisoformat(latest["recorded_at"].replace("Z","+00:00"))).total_seconds())
                latest["location_stale"]=age>120
            decision=_recovery_decision(dict(o),latest)
            if decision["action"]!="MONITOR":
                msg=_safe_recovery_message(decision["action"],o["live_eta_minutes"])
                notify_customer(c,o["customer_id"],o["id"],"delivery_recovery","Aktualizace doručení",msg or "Prověřujeme doručení objednávky.")
                emit(c,o["id"],"recovery_sweep_triggered",{"action":decision["action"],"reason":decision["reason"]},u["id"])
                triggered.append({"order_id":o["id"],"action":decision["action"],"reason":decision["reason"]})
        c.commit()
    return {"checked":checked,"triggered":triggered}


@app.get("/api/customer/notifications")
def customer_notifications(authorization: str | None = Header(default=None)):
