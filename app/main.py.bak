@app.post("/api/v069/orders/{order_id}/atomic-transition")
def v069_atomic_transition(order_id:str, body:dict[str,Any], authorization:str|None=Header(default=None), idempotency_key:str|None=Header(default=None,alias="Idempotency-Key"))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent","merchant"})
    expected=str(body.get("expected_status","")).strip()
    target=str(body.get("target_status","")).strip()
    if not expected or not target: raise HTTPException(400,"expected_status a target_status jsou povinné")
    allowed={
        ("confirmed","preparing"),("confirmed","merchant_rejected"),
        ("preparing","ready_for_pickup"),("ready_for_pickup","cancelled"),
        ("courier_assigned","out_for_delivery"),("out_for_delivery","delivered")
    }
    if (expected,target) not in allowed: raise HTTPException(400,"Transition není povolený")
    with core_db_connect() as c:
        cached=_v052_guard(c,f"atomic-transition:{u['id']}",idempotency_key,{"order_id":order_id,"expected":expected,"target":target})
        if cached is not None:return cached
        o=c.execute("SELECT * FROM orders WHERE id=?",(order_id,)).fetchone()
        if not o: raise HTTPException(404,"Objednávka nenalezena")
        if u["role"]=="merchant" and o["merchant_id"]!=u.get("merchant_id"): raise HTTPException(403,"forbidden")
        service=AtomicOrderTransitionService(c)
        result=service.transition(order_id,expected,target,u["id"],idempotency_key)
        _v052_store(c,f"atomic-transition:{u['id']}",idempotency_key,{"order_id":order_id,"expected":expected,"target":target},result)
        _v052_audit(c,u["id"],"atomic_transition","order",order_id,{"from":expected,"to":target})
        c.commit()
        return result

@app.get("/api/v069/ops/transactional-integrity")
def v069_transactional_integrity(authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    with core_db_connect() as c:
        invalid=int(c.execute("""SELECT COUNT(*) n FROM orders WHERE
            (status='preparing' AND id NOT IN (SELECT order_id FROM merchant_order_actions WHERE action='accept'))
            OR (status='delivered' AND id NOT IN (SELECT order_id FROM dispatch_jobs WHERE status='delivered'))""").fetchone()["n"])
        transitions=int(c.execute("SELECT COUNT(*) n FROM state_transition_audit").fetchone()["n"])
        return {"database":"sqlite","postgresql_contract_ready":True,"invalid_state_records":invalid,"audited_transitions":transitions,"healthy":invalid==0}

