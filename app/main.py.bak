        emit(c, None, "merchant_status_changed", {"merchant_id": u["merchant_id"], "active": active}, u["id"]); c.commit()
    return {"merchant_id": u["merchant_id"], "active": active}

@app.post("/api/merchant/prep-time")
def v20_merchant_prep(body: dict[str, Any], authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u = current_user(authorization); require_role(u, "merchant")
