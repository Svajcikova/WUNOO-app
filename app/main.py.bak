        c.execute("INSERT INTO customer_menu_integrity_audit VALUES (?,?,?,?,?,?,?,?,?)",
                  ('cmi_'+uuid.uuid4().hex[:12],u['customer_id'],str(result.get('merchant_id') or ''),'INTEGRITY_CHECK',result.get('live_publication_no'),result.get('live_snapshot_sha256'), 'PASS' if result['valid'] else 'FAIL', json.dumps(result,ensure_ascii=False),now()))
        c.commit()
        return {'schema_version':'1.138',**result,'policy':_V138_CUSTOMER_MENU_INTEGRITY_POLICY}


@app.post('/api/v138/customer/cart/reconcile')
def v138_customer_cart_reconcile(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,'customer')
    with core_db_connect() as c:
        result=_v138_cart_integrity(c,u['customer_id'])
        if result['valid'] or result['empty']:
            return {'schema_version':'1.138','reconciled':False,'changed':False,**result}
        # Never silently mutate price or availability. The customer must re-add affected items.
        c.execute("INSERT INTO customer_menu_integrity_audit VALUES (?,?,?,?,?,?,?,?,?)",
                  ('cmi_'+uuid.uuid4().hex[:12],u['customer_id'],str(result.get('merchant_id') or ''),'RECONCILE_REQUIRED',result.get('live_publication_no'),result.get('live_snapshot_sha256'),'FAIL',json.dumps({'issues':result['issues']},ensure_ascii=False),now())); c.commit()
        return {'schema_version':'1.138','reconciled':False,'changed':True,'action_required':'REFRESH_CART',**result}


