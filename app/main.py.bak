        c.execute('INSERT INTO production_recovery_finality_checkpoint_finality_continuity_chain_v107(id,sequence_no,finality_id,checkpoint_id,checkpoint_sha256,finality_proof_sha256,previous_entry_sha256,entry_json,entry_sha256,algorithm,signer_key_id,public_key_b64,signature_b64,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(eid,seq,fid,fin['checkpoint_id'],fin['checkpoint_sha256'],fin['proof_sha256'],prev,_v107_json(obj),eh,'Ed25519',keyid,base64.b64encode(pub).decode(),sig,'APPENDED',t,op));c.commit();row=c.execute('SELECT * FROM production_recovery_finality_checkpoint_finality_continuity_chain_v107 WHERE id=?',(eid,)).fetchone();return {'schema_version':'1.107','idempotent':False,'entry':dict(row),'verification':_v107_verify_entry(c,row),'chain_verification':_v107_verify_chain(c)}
@app.get('/api/v107/ops/recovery-finality-checkpoint-continuity-chain/verify')
def v107_verify(authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:return {'schema_version':'1.107',**_v107_verify_chain(c)}
