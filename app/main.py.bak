@app.get("/app/flow/{order_id}", response_class=HTMLResponse)
def integrated_order_flow(order_id: int, user=Depends(current_user)):
    order = db_get_order(order_id)
    if not order:
        raise HTTPException(status_code=404, detail="order not found")
    role = user.get("role")
    allowed = (
        role == "admin"
        or (role == "customer" and order.get("customer_id") == user.get("id"))
        or (role == "merchant" and order.get("merchant_id") == user.get("merchant_id"))
        or (role == "courier" and order.get("courier_id") == user.get("id"))
    )
    if not allowed:
        raise HTTPException(status_code=403, detail="forbidden")
    oid = str(order_id)
    html = """
    <div class="card">
      <span class="pill">WUNOO v0.24</span>
      <h2>Objednávka #OID#</h2>
      <div class="grid">
        <div class="card"><div class="muted">Stav</div><h3 id="state">–</h3></div>
        <div class="card"><div class="muted">Celkem</div><h3 id="total">–</h3></div>
        <div class="card"><div class="muted">Payment</div><h3 id="payment">–</h3></div>
        <div class="card"><div class="muted">ETA / Delay</div><h3 id="eta">–</h3></div>
      </div>
    </div>
    <div class="card">
      <h3>Live tracking</h3>
      <div id="tracking">Načítám…</div>
      <p><a href="/track/OID#">Otevřít tracking</a></p>
    </div>
    <div class="card"><h3>Timeline</h3><div id="timeline">Načítám…</div></div>
    <script>
    async function refresh(){
      const r=await fetch('/api/orders/OID#'); const o=await r.json();
      if(!r.ok){document.getElementById('state').textContent='Order error';return;}
      document.getElementById('state').textContent=o.status||'–';
      document.getElementById('total').textContent=(o.total??o.total_amount??'–')+' Kč';
      document.getElementById('payment').textContent=o.payment_status??'–';
      document.getElementById('eta').textContent=(o.live_eta_minutes??'–')+' min · '+(o.delay_level??'ON_TIME');
      const tr=await fetch('/api/orders/OID#/tracking/live'); const td=await tr.json();
      document.getElementById('tracking').textContent=td.tracking_available ? ((td.live_eta_minutes??'–')+' min · '+(td.remaining_distance_km??'–')+' km · '+(td.location_stale?'stale':'fresh')) : 'Tracking zatím není dostupný';
      const tl=await fetch('/api/orders/OID#/timeline'); const t=await tl.json();
      const ev=t.events||t.timeline||[];
      document.getElementById('timeline').innerHTML=ev.map(function(e){
        return '<div class="card"><b>'+String(e.type||e.event_type||'event')+'</b><div class="muted">'+String(e.created_at||e.timestamp||'')+'</div></div>';
      }).join('');
    }
    refresh(); setInterval(refresh,5000);
    </script>
    """.replace("OID#", oid)
    return HTMLResponse(shell("Integrated Order Flow", html))


@app.post("/api/v024/merchant-next/{order_id}")
def v024_merchant_next(order_id: int, user=Depends(current_user)):
    require_role(user, {"merchant"})
    order = db_get_order(order_id)
    if not order or order.get("merchant_id") != user.get("merchant_id"):
        raise HTTPException(status_code=404, detail="order not found")
    if order["status"] == "merchant_pending":
        return accept_order(order_id, user)
    if order["status"] == "preparing":
        return mark_ready(order_id, user)
    raise HTTPException(status_code=409, detail="not a merchant-advance state")

@app.post("/api/v024/courier-next/{order_id}")
def v024_courier_next(order_id: int, user=Depends(current_user)):
    require_role(user, {"courier"})
    order = db_get_order(order_id)
    if not order or order.get("courier_id") != user.get("id"):
        raise HTTPException(status_code=404, detail="order not found")
    if order["status"] == "assigned":
        return pickup_order(order_id, user)
    if order["status"] == "picked_up":
        return start_delivery(order_id, user)
    if order["status"] == "out_for_delivery":
        return deliver_order(order_id, user)
    raise HTTPException(status_code=409, detail="not a courier-advance state")

