        "/api/orders", "/api/orders/{order_id}", "/api/orders/{order_id}/timeline",
        "/api/orders/{order_id}/courier-candidates", "/api/orders/{order_id}/payment",
        "/api/orders/{order_id}/merchant-accept", "/api/orders/{order_id}/ready",
        "/api/orders/{order_id}/dispatch", "/api/orders/{order_id}/dispatch-offer",
        "/api/orders/{order_id}/deliver", "/api/orders/{order_id}/tracking",
        "/api/orders/{order_id}/eta", "/api/orders/{order_id}/timing",
        "/api/orders/{order_id}/timeout-check", "/api/orders/{order_id}/tracking/live",
        "/api/orders/{order_id}/recovery-check", "/api/orders/{order_id}/auto-reassign",
    }
    remaining_order = [x for x in scan["remaining"] if set(x["routes"]) & order_routes]
