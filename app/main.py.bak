        result=_v129_run(c); no=int(c.execute('SELECT COALESCE(MAX(gate_no),0)+1 n FROM production_dispatch_load_integrity_gates_v129').fetchone()['n']); obj=_v129_payload(no,result); digest=_v129_hash(obj); key,pub,keyid=_v169_load_signer(); sig=base64.b64encode(key.sign(_v129_json(obj).encode())).decode(); gid='dlg129_'+uuid.uuid4().hex[:16]; status='VALID' if result['valid'] else 'INVALID'; c.execute('INSERT INTO production_dispatch_load_integrity_gates_v129 VALUES(?,?,?,?,?,?,?,?,?,?,?)',(gid,no,_v129_json(obj),digest,'Ed25519',keyid,base64.b64encode(pub).decode(),sig,status,now(),op)); c.commit(); row=c.execute('SELECT * FROM production_dispatch_load_integrity_gates_v129 WHERE id=?',(gid,)).fetchone(); return {'schema_version':'1.129','gate':dict(row),'verification':_v129_verify(c,row),'result':result}
@app.get('/api/v129/ops/dispatch-load-integrity-gate/verify')
def v129_verify(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        result=_v129_run(c); rows=c.execute('SELECT * FROM production_dispatch_load_integrity_gates_v129 ORDER BY gate_no').fetchall(); hist=[_v129_verify(c,r) for r in rows]; return {'schema_version':'1.129','valid':result['valid'] and all(x['valid'] for x in hist),'current_result':result,'gates':len(rows),'history_verification':hist}
@app.get('/api/v129/ops/dispatch-load-integrity-gate/latest')
def v129_latest(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        row=c.execute('SELECT * FROM production_dispatch_load_integrity_gates_v129 ORDER BY gate_no DESC LIMIT 1').fetchone(); return {'schema_version':'1.129','gate':dict(row) if row else None,'verification':_v129_verify(c,row) if row else {'valid':True,'reason':'NO_GATES'}}

# ---------------- v1.131 PostgreSQL live cutover & multi-process hardening ----------------
_V131_PG_CUTOVER_POLICY = {
    'schema_version': '1.131',
    'gate': 'postgresql_live_cutover_and_multiprocess_integrity',
    'fail_closed': True,
    'sqlite_never_satisfies_production': True,
    'required_isolation': ['read committed', 'repeatable read', 'serializable'],
    'critical_constraints': ['unique idempotency scope/key', 'conditional state transition', 'atomic courier claim'],
    'max_lock_wait_seconds': 10,
}

def _v131_pg_probe() -> dict[str, Any]:
    dsn = os.getenv('WUNOO_DATABASE_URL') or os.getenv('DATABASE_URL')
    if not dsn:
        return {'executed': False, 'passed': False, 'reason': 'POSTGRES_DSN_MISSING'}
    try:
        import psycopg
    except ImportError:
        return {'executed': False, 'passed': False, 'reason': 'POSTGRES_DRIVER_MISSING'}
    try:
        with psycopg.connect(dsn, autocommit=False) as pg:
            with pg.cursor() as cur:
                cur.execute("SET LOCAL lock_timeout = '10s'")
                cur.execute("SELECT current_setting('transaction_isolation'), current_database(), current_user")
                isolation, database, user = cur.fetchone()
                cur.execute("SELECT to_regclass('public.orders'), to_regclass('public.payments'), to_regclass('public.schema_migrations')")
                orders, payments, migrations = cur.fetchone()
                cur.execute("SELECT COUNT(*) FROM schema_migrations WHERE status='applied'")
                applied = int(cur.fetchone()[0])
                cur.execute('SELECT 1')
                roundtrip = cur.fetchone()[0] == 1
            pg.rollback()
        iso = str(isolation).lower()
        passed = iso in set(_V131_PG_CUTOVER_POLICY['required_isolation']) and bool(orders and payments and migrations) and applied > 0 and roundtrip
        return {'executed': True, 'passed': passed, 'transaction_isolation': isolation, 'database': database, 'user': user, 'required_tables': bool(orders and payments and migrations), 'applied_migrations': applied, 'transaction_roundtrip': roundtrip}
    except Exception as exc:
        return {'executed': True, 'passed': False, 'reason': 'POSTGRES_PROBE_FAILED', 'error': str(exc)[:300]}

def _v131_static_contract_scan() -> dict[str, Any]:
    source = Path(__file__).read_text(encoding='utf-8')
    checks = {
        'postgres_runtime_guard': 'enforce_database_runtime_guard' in source,
        'conditional_order_transition': 'WHERE id=? AND status=?' in source or 'WHERE id=%s AND status=%s' in source,
        'payment_idempotency': 'payment-create:' in source and '_v052_guard' in source,
        'refund_idempotency': 'refund:' in source and '_v052_guard' in source,
        'atomic_courier_claim': 'atomic_transition_any' in source or 'FOR UPDATE' in source,
        'postgres_pool': 'configure_postgres_pool' in source,
        'migration_manifest': 'migrate_postgresql_v131.py' in source,
    }
    return {'checks': checks, 'all_present': all(checks.values())}

@app.get('/api/v131/ops/live-cutover-gate')
def v131_live_cutover_gate(authorization: str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    backend=configured_db_backend()
    static=_v131_static_contract_scan()
    live=_v131_pg_probe() if backend=='postgresql' else {'executed':False,'passed':False,'reason':'NOT_POSTGRES'}
    return {'schema_version':'1.131','policy':_V131_PG_CUTOVER_POLICY,'configured_backend':backend,'static_contract_scan':static,'live_postgresql_probe':live,'ready_for_production':bool(backend=='postgresql' and static['all_present'] and live.get('executed') and live.get('passed'))}

@app.get('/api/v131/ops/live-cutover-policy')
def v131_live_cutover_policy(authorization: str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    return _V131_PG_CUTOVER_POLICY

# ---------------- v1.132 Customer Experience Hub ----------------
_V132_CX_POLICY = {
    'schema_version':'1.132',
    'purpose':'single-request customer marketplace home contract',
    'read_only':True,
    'domains':['restaurants','cart','addresses','orders'],
    'fail_closed':True,
}

@app.get('/api/v132/customer/home')
def v132_customer_home(authorization: str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,'customer')
    try:
        with core_db_connect() as c:
            merchants=c.execute("""
                SELECT m.id,m.name,m.prep_minutes,m.active,
                       COALESCE(mp.category,'Bistro') category,
                       COALESCE(mp.cuisine,'Moderní česká') cuisine,
                       COALESCE(mp.rating_avg,0) rating_avg,
                       COALESCE(mp.rating_count,0) rating_count,
                       COALESCE(mp.min_order_czk,0) min_order_czk
                FROM merchants m LEFT JOIN merchant_profiles mp ON mp.merchant_id=m.id
                WHERE m.active=1 ORDER BY COALESCE(mp.rating_avg,0) DESC,m.name LIMIT 50
            """).fetchall()
            restaurants=[]
            for r in merchants:
                x=dict(r)
                zone=c.execute("SELECT 1 FROM merchant_delivery_zones WHERE merchant_id=? AND city=? LIMIT 1",(x['id'],'Ostrava')).fetchone()
                x['delivery_available']=bool(zone)
                x['menu_preview']=[dict(i) for i in c.execute("SELECT id,name,price_czk FROM menu_items WHERE merchant_id=? AND active=1 ORDER BY name LIMIT 4",(x['id'],)).fetchall()]
                restaurants.append(x)
            cart_rows=c.execute("""
                SELECT ci.menu_item_id,ci.qty,mi.name,mi.price_czk,mi.merchant_id
                FROM cart_items ci JOIN menu_items mi ON mi.id=ci.menu_item_id
                WHERE ci.customer_id=? ORDER BY mi.name
            """,(u['customer_id'],)).fetchall()
            cart=[dict(x) for x in cart_rows]
            cart_total=round(sum(float(x['price_czk'])*int(x['qty']) for x in cart),2)
            addresses=[dict(x) for x in c.execute("SELECT id,label,street,city,postal_code,is_default FROM customer_addresses WHERE customer_id=? ORDER BY is_default DESC,created_at DESC",(u['customer_id'],)).fetchall()]
            orders=[dict(x) for x in c.execute("""
                SELECT o.id,o.status,o.total_czk,o.created_at,o.merchant_id,m.name merchant_name,o.courier_id
                FROM orders o JOIN merchants m ON m.id=o.merchant_id
                WHERE o.customer_id=? ORDER BY o.created_at DESC LIMIT 10
            """,(u['customer_id'],)).fetchall()]
            active=[x for x in orders if x['status'] not in ('delivered','cancelled','merchant_rejected','payment_failed','payment_cancelled')]
            return {'schema_version':'1.132','policy':_V132_CX_POLICY,'customer_id':u['customer_id'],'restaurants':restaurants,'cart':{'items':cart,'total_czk':cart_total,'item_count':sum(int(x['qty']) for x in cart)},'addresses':addresses,'orders':orders,'active_order_count':len(active)}
    except HTTPException:
        raise
    except Exception as exc:
        raise HTTPException(500,{'code':'CUSTOMER_HOME_READ_FAILED','detail':str(exc)[:200]})

@app.get('/api/v132/customer/home/policy')
def v132_customer_home_policy(authorization: str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,'customer')
    return _V132_CX_POLICY

@app.get('/frontend_v029/customer_hub_v132.html')
def v132_customer_hub_page():
    return FileResponse(BASE.parent/'frontend_v029'/'customer_hub_v132.html')

# ---------------- v1.135 Merchant Menu 2.0 ----------------
# This is a contract/UI layer only. It intentionally reuses the existing
# v1.14 catalog model, availability writer and merchant authorization seam.
_V135_MENU_POLICY = {
    'schema_version': '1.135',
    'purpose': 'merchant menu CRUD, ordering, availability and validation',
    'tenant_isolated': True,
    'item_versioning': True,
    'soft_delete_only': True,
    'availability_states': ['AVAILABLE', 'SOLD_OUT'],
    'currency': 'CZK',
    'source_of_truth': 'menu_items + menu_categories + product_availability',
}


def _v135_require_merchant(authorization):
    u = current_user(authorization)
    require_role(u, 'merchant')
    mid = str(u.get('merchant_id') or '')
    if not mid:
        raise HTTPException(403, 'Merchant tenant není dostupný')
    return u, mid


def _v135_validate_category_name(name):
    name = str(name or '').strip()
    if not name or len(name) > 80:
        raise HTTPException(400, 'Neplatný název kategorie')
    return name


def _v135_validate_item_payload(body, partial=True):
    out = {}
    if (not partial) or 'name' in body:
        name = str(body.get('name', '')).strip()
        if not name or len(name) > 120:
            raise HTTPException(400, 'Neplatný název položky')
        out['name'] = name
    if 'description' in body:
        desc = body.get('description')
        if desc is not None and len(str(desc)) > 2000:
            raise HTTPException(400, 'Popis je příliš dlouhý')
        out['description'] = None if desc is None else str(desc)
    if (not partial) or 'price_czk' in body:
        try:
            price = float(body.get('price_czk'))
        except Exception:
            raise HTTPException(400, 'Neplatná cena')
        if not math.isfinite(price) or price < 0 or price > 100000:
            raise HTTPException(400, 'Neplatná cena')
        out['price_czk'] = round(price, 2)
    if 'category_id' in body:
        out['category_id'] = body.get('category_id') or None
    if 'display_order' in body:
        try:
            order = int(body.get('display_order'))
        except Exception:
            raise HTTPException(400, 'Neplatné pořadí')
        if order < 0 or order > 1000000:
            raise HTTPException(400, 'Neplatné pořadí')
        out['display_order'] = order
    if 'active' in body:
        out['active'] = 1 if bool(body.get('active')) else 0
    return out


def _v135_menu_validation(c, merchant_id):
    errors, warnings = [], []
    cats = c.execute(
        'SELECT id FROM menu_categories WHERE merchant_id=? AND active=1',
        (merchant_id,)
    ).fetchall()
    cat_ids = {x['id'] for x in cats}
    items = c.execute('''
        SELECT id,name,price_czk,currency,category_id,display_order,active,version
        FROM menu_items WHERE merchant_id=? ORDER BY category_id,display_order,id
    ''', (merchant_id,)).fetchall()
    seen = set()
    for i in items:
        if int(i['active']) != 1:
            continue
        if not str(i['name'] or '').strip():
            errors.append({'code': 'MISSING_NAME', 'item_id': i['id']})
        if float(i['price_czk']) < 0:
            errors.append({'code': 'NEGATIVE_PRICE', 'item_id': i['id']})
        if str(i['currency'] or '').upper() != 'CZK':
            errors.append({'code': 'INVALID_CURRENCY', 'item_id': i['id']})
        if i['category_id'] and i['category_id'] not in cat_ids:
            errors.append({'code': 'INVALID_CATEGORY', 'item_id': i['id']})
        key = (i['category_id'], int(i['display_order'] or 0))
        if key in seen:
            warnings.append({'code': 'DUPLICATE_DISPLAY_ORDER', 'item_id': i['id'], 'display_order': i['display_order']})
        seen.add(key)
    return {
        'valid': not errors,
        'errors': errors,
        'warnings': warnings,
        'checked_items': len(items),
        'validator_version': '1.135',
    }


@app.get('/api/v135/merchant/menu')
def v135_menu(authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u, mid = _v135_require_merchant(authorization)
    with core_db_connect() as c:
        migrate_v114(c)
        cats = c.execute('''SELECT id,name,sort_order,active FROM menu_categories
                            WHERE merchant_id=? ORDER BY sort_order,name,id''', (mid,)).fetchall()
        rows = c.execute('''SELECT mi.id,mi.merchant_id,mi.name,mi.description,mi.price_czk,mi.currency,
                                   mi.active,mi.category_id,mi.display_order,mi.version,mc.name category_name
                            FROM menu_items mi LEFT JOIN menu_categories mc ON mc.id=mi.category_id
                            WHERE mi.merchant_id=?
                            ORDER BY COALESCE(mc.sort_order,999),mi.display_order,mi.name,mi.id''', (mid,)).fetchall()
        items = []
        for r in rows:
            d = dict(r)
            d['availability'] = _v114_availability(c, r['id'])
            items.append(d)
        return {
            'schema_version': '1.135',
            'policy': _V135_MENU_POLICY,
            'merchant_id': mid,
            'categories': [dict(x) for x in cats],
            'items': items,
            'validation': _v135_menu_validation(c, mid),
        }


@app.post('/api/v135/merchant/categories')
def v135_create_category(body: dict[str, Any], authorization: str | None = Header(default=None), idempotency_key: str | None = Header(default=None, alias='Idempotency-Key')):
    u, mid = _v135_require_merchant(authorization)
    name = _v135_validate_category_name(body.get('name'))
    try:
        requested_order = int(body.get('sort_order')) if body.get('sort_order') is not None else None
    except Exception:
        raise HTTPException(400, 'Neplatné pořadí kategorie')
    if requested_order is not None and requested_order < 0:
        raise HTTPException(400, 'Neplatné pořadí kategorie')
    with core_db_connect() as c:
        migrate_v114(c)
        if c.execute('SELECT 1 FROM menu_categories WHERE merchant_id=? AND LOWER(name)=LOWER(?) AND active=1', (mid, name)).fetchone():
            raise HTTPException(409, 'Kategorie s tímto názvem už existuje')
        max_order = c.execute('SELECT COALESCE(MAX(sort_order),-1) n FROM menu_categories WHERE merchant_id=?', (mid,)).fetchone()['n']
        sort_order = int(max_order) + 1 if requested_order is None else requested_order
        cid = 'mc_' + uuid.uuid4().hex[:12]
        c.execute('INSERT INTO menu_categories(id,merchant_id,name,sort_order,active) VALUES (?,?,?,?,1)', (cid, mid, name, sort_order))
        emit(c, None, 'menu_category_created', {'merchant_id': mid, 'category_id': cid, 'name': name, 'sort_order': sort_order}, u['id'])
        c.commit()
        return {'schema_version': '1.135', 'category': {'id': cid, 'merchant_id': mid, 'name': name, 'sort_order': sort_order, 'active': 1}}


@app.patch('/api/v135/merchant/categories/{category_id}')
def v135_update_category(category_id: str, body: dict[str, Any], authorization: str | None = Header(default=None)):
    u, mid = _v135_require_merchant(authorization)
    changes = {}
    if 'name' in body:
        changes['name'] = _v135_validate_category_name(body.get('name'))
    if 'sort_order' in body:
        try:
            order = int(body.get('sort_order'))
        except Exception:
            raise HTTPException(400, 'Neplatné pořadí kategorie')
        if order < 0:
            raise HTTPException(400, 'Neplatné pořadí kategorie')
        changes['sort_order'] = order
    if 'active' in body:
        changes['active'] = 1 if bool(body.get('active')) else 0
    if not changes:
        raise HTTPException(400, 'Není co měnit')
    with core_db_connect() as c:
        migrate_v114(c)
        old = c.execute('SELECT * FROM menu_categories WHERE id=? AND merchant_id=?', (category_id, mid)).fetchone()
        if not old:
            raise HTTPException(404, 'Kategorie nenalezena')
        if 'name' in changes and c.execute('''SELECT 1 FROM menu_categories
            WHERE merchant_id=? AND id<>? AND LOWER(name)=LOWER(?) AND active=1''', (mid, category_id, changes['name'])).fetchone():
            raise HTTPException(409, 'Kategorie s tímto názvem už existuje')
        sets = ', '.join(f'{k}=?' for k in changes)
        c.execute(f'UPDATE menu_categories SET {sets} WHERE id=? AND merchant_id=?', list(changes.values()) + [category_id, mid])
        emit(c, None, 'menu_category_updated', {'merchant_id': mid, 'category_id': category_id, 'changes': changes}, u['id'])
        c.commit()
        row = c.execute('SELECT id,merchant_id,name,sort_order,active FROM menu_categories WHERE id=?', (category_id,)).fetchone()
        return {'schema_version': '1.135', 'category': dict(row)}


@app.delete('/api/v135/merchant/categories/{category_id}')
def v135_delete_category(category_id: str, authorization: str | None = Header(default=None)):
    u, mid = _v135_require_merchant(authorization)
    with core_db_connect() as c:
        migrate_v114(c)
        old = c.execute('SELECT id,name FROM menu_categories WHERE id=? AND merchant_id=?', (category_id, mid)).fetchone()
        if not old:
            raise HTTPException(404, 'Kategorie nenalezena')
        item_count = c.execute('SELECT COUNT(*) n FROM menu_items WHERE merchant_id=? AND category_id=? AND active=1', (mid, category_id)).fetchone()['n']
        if int(item_count) > 0:
            raise HTTPException(409, 'Kategorie obsahuje aktivní položky; nejdříve je přesuňte nebo deaktivujte')
        c.execute('UPDATE menu_categories SET active=0 WHERE id=? AND merchant_id=?', (category_id, mid))
        emit(c, None, 'menu_category_archived', {'merchant_id': mid, 'category_id': category_id}, u['id'])
        c.commit()
    return {'schema_version': '1.135', 'category_id': category_id, 'active': 0}


@app.post('/api/v135/merchant/categories/reorder')
def v135_reorder_categories(body: dict[str, Any], authorization: str | None = Header(default=None)):
    u, mid = _v135_require_merchant(authorization)
    ids = body.get('category_ids')
    if not isinstance(ids, list) or len(ids) != len(set(ids)):
        raise HTTPException(400, 'category_ids musí být jedinečný seznam')
    with core_db_connect() as c:
        migrate_v114(c)
        rows = c.execute('SELECT id FROM menu_categories WHERE merchant_id=? AND active=1', (mid,)).fetchall()
        known = {r['id'] for r in rows}
        if set(ids) != known:
            raise HTTPException(409, 'Seznam kategorií neodpovídá aktivním kategoriím restaurace')
        for idx, cid in enumerate(ids):
            c.execute('UPDATE menu_categories SET sort_order=? WHERE id=? AND merchant_id=?', (idx, cid, mid))
        emit(c, None, 'menu_category_reordered', {'merchant_id': mid, 'category_ids': ids}, u['id'])
        c.commit()
    return {'schema_version': '1.135', 'category_ids': ids}


@app.post('/api/v135/merchant/items')
def v135_create_item(body: dict[str, Any], authorization: str | None = Header(default=None)):
    u, mid = _v135_require_merchant(authorization)
    data = _v135_validate_item_payload(body, partial=False)
    with core_db_connect() as c:
        migrate_v114(c)
        category_id = data.get('category_id')
        if category_id and not c.execute('SELECT 1 FROM menu_categories WHERE id=? AND merchant_id=? AND active=1', (category_id, mid)).fetchone():
            raise HTTPException(400, 'Kategorie nepatří restauraci')
        if 'display_order' not in data:
            max_order = c.execute('SELECT COALESCE(MAX(display_order),-1) n FROM menu_items WHERE merchant_id=? AND category_id IS ?', (mid, category_id)).fetchone()['n']
            data['display_order'] = int(max_order) + 1
        iid = 'mi_' + uuid.uuid4().hex[:12]
        c.execute('''INSERT INTO menu_items(id,merchant_id,name,description,price_czk,active,category_id,display_order,version,currency)
                     VALUES (?,?,?,?,?,?,?,?,1,?)''',
                  (iid, mid, data['name'], data.get('description'), data['price_czk'], data.get('active', 1), category_id, data['display_order'], 'CZK'))
        emit(c, None, 'menu_item_created', {'merchant_id': mid, 'menu_item_id': iid, 'name': data['name'], 'price_czk': data['price_czk'], 'version': 1}, u['id'])
        c.commit()
        row = _v114_item(c, mid, iid)
        return {'schema_version': '1.135', 'item': {**dict(row), 'availability': _v114_availability(c, iid)}}


@app.patch('/api/v135/merchant/items/{item_id}')
def v135_update_item(item_id: str, body: dict[str, Any], authorization: str | None = Header(default=None)):
    u, mid = _v135_require_merchant(authorization)
    data = _v135_validate_item_payload(body, partial=True)
    expected_version = body.get('expected_version')
    if expected_version is not None:
        try:
            expected_version = int(expected_version)
        except Exception:
            raise HTTPException(400, 'Neplatná expected_version')
    with core_db_connect() as c:
        migrate_v114(c)
        old = _v114_item(c, mid, item_id)
        if not old:
            raise HTTPException(404, 'Položka nenalezena')
        if expected_version is not None and int(old['version']) != expected_version:
            raise HTTPException(409, {'code': 'MENU_ITEM_VERSION_CONFLICT', 'current_version': int(old['version'])})
        if 'category_id' in data and data['category_id'] and not c.execute('SELECT 1 FROM menu_categories WHERE id=? AND merchant_id=? AND active=1', (data['category_id'], mid)).fetchone():
            raise HTTPException(400, 'Neplatná kategorie')
        if 'display_order' in data and int(data['display_order']) < 0:
            raise HTTPException(400, 'Neplatné pořadí')
        if not data:
            raise HTTPException(400, 'Není co měnit')
        data['version'] = int(old['version'] or 1) + 1
        sets = ', '.join(f'{k}=?' for k in data)
        c.execute(f'UPDATE menu_items SET {sets} WHERE id=? AND merchant_id=?', list(data.values()) + [item_id, mid])
        emit(c, None, 'menu_item_updated', {'merchant_id': mid, 'menu_item_id': item_id, 'changes': data, 'version': data['version']}, u['id'])
        c.commit()
        row = _v114_item(c, mid, item_id)
        return {'schema_version': '1.135', 'item': {**dict(row), 'availability': _v114_availability(c, item_id)}}


@app.post('/api/v135/merchant/items/{item_id}/availability')
def v135_set_item_availability(item_id: str, body: dict[str, Any], authorization: str | None = Header(default=None)):
    u, mid = _v135_require_merchant(authorization)
    state = str(body.get('state', '')).upper().strip()
    if state not in {'AVAILABLE', 'SOLD_OUT'}:
        raise HTTPException(400, 'state musí být AVAILABLE nebo SOLD_OUT')
    start_at = body.get('start_at')
    end_at = body.get('end_at')
    if start_at and end_at and str(end_at) < str(start_at):
        raise HTTPException(400, 'end_at musí být po start_at')
    with core_db_connect() as c:
        migrate_v114(c)
        item = _v114_item(c, mid, item_id)
        if not item:
            raise HTTPException(404, 'Položka nenalezena')
        prev = _v114_availability(c, item_id)
        version = int(prev.get('version') or 0) + 1
        aid = 'pa_' + uuid.uuid4().hex[:12]
        c.execute('''INSERT INTO product_availability(id,menu_item_id,state,start_at,end_at,reason,updated_at,version)
                     VALUES (?,?,?,?,?,?,?,?)''', (aid, item_id, state, start_at, end_at, body.get('reason'), now(), version))
        emit(c, None, 'menu_item_availability_changed', {'merchant_id': mid, 'menu_item_id': item_id, 'from': prev['state'], 'to': state, 'version': version}, u['id'])
        c.commit()
        return {'schema_version': '1.135', 'id': aid, 'menu_item_id': item_id, **_v114_availability(c, item_id)}


@app.post('/api/v135/merchant/menu/validate')
def v135_validate_menu(authorization: str | None = Header(default=None)):
    _u, mid = _v135_require_merchant(authorization)
    with core_db_connect() as c:
        migrate_v114(c)
        result = _v135_menu_validation(c, mid)
        return {'schema_version': '1.135', 'merchant_id': mid, **result}


@app.post('/api/v135/merchant/menu/publish-check')
def v135_menu_publish_check(authorization: str | None = Header(default=None)):
    _u, mid = _v135_require_merchant(authorization)
    with core_db_connect() as c:
        migrate_v114(c)
        validation = _v135_menu_validation(c, mid)
        active_categories = c.execute('SELECT COUNT(*) n FROM menu_categories WHERE merchant_id=? AND active=1', (mid,)).fetchone()['n']
        active_items = c.execute('SELECT COUNT(*) n FROM menu_items WHERE merchant_id=? AND active=1', (mid,)).fetchone()['n']
        result = {
            'schema_version': '1.135',
            'merchant_id': mid,
            'publishable': bool(validation['valid'] and active_items > 0),
            'validation': validation,
            'active_categories': int(active_categories),
            'active_items': int(active_items),
            'mode': 'CHECK_ONLY',
        }
        if active_items <= 0:
            result['validation']['errors'].append({'code': 'NO_ACTIVE_ITEMS'})
            result['publishable'] = False
        return result


@app.get('/frontend_v029/merchant_dashboard_v135.html')
def v135_merchant_dashboard_page():
    return FileResponse(BASE.parent/'frontend_v029'/'merchant_dashboard_v135.html')


# ---------------- v1.136 Merchant Menu Publishing ----------------
_V136_PUBLISH_POLICY = {
    'schema_version': '1.136',
    'purpose': 'draft/live menu publication with immutable snapshots and preview diff',
    'draft_source_of_truth': 'menu_items + menu_categories + product_availability',
    'live_source_of_truth': 'merchant_menu_publications.latest(status=LIVE)',
    'immutable_snapshots': True,
    'tenant_isolated': True,
    'publish_requires_valid_menu': True,
}


def _v136_snapshot(c, merchant_id):
    categories = c.execute('''SELECT id,name,sort_order,active FROM menu_categories
                              WHERE merchant_id=? ORDER BY sort_order,name,id''',(merchant_id,)).fetchall()
    items = c.execute('''SELECT id,name,description,price_czk,currency,active,category_id,display_order,version
                         FROM menu_items WHERE merchant_id=? ORDER BY COALESCE(category_id,''),display_order,name,id''',(merchant_id,)).fetchall()
    avails = c.execute('''SELECT pa.menu_item_id,pa.state,pa.start_at,pa.end_at,pa.reason,pa.version
                          FROM product_availability pa
                          JOIN menu_items mi ON mi.id=pa.menu_item_id AND mi.merchant_id=?
                          JOIN (SELECT menu_item_id,MAX(updated_at) max_updated FROM product_availability GROUP BY menu_item_id) latest
                            ON latest.menu_item_id=pa.menu_item_id AND latest.max_updated=pa.updated_at''',(merchant_id,)).fetchall()
    by_item={r['menu_item_id']:dict(r) for r in avails}
    payload={
        'schema_version':'1.136',
        'merchant_id':merchant_id,
        'categories':[dict(x) for x in categories],
        'items':[{**dict(x),'availability':by_item.get(x['id'],{'state':'AVAILABLE','start_at':None,'end_at':None,'reason':None,'version':0})} for x in items if int(x['active'])==1],
    }
    raw=json.dumps(payload,ensure_ascii=False,separators=(',',':'),sort_keys=True)
    return payload, hashlib.sha256(raw.encode()).hexdigest(), raw


def _v136_live_publication(c, merchant_id):
    return c.execute('''SELECT id,merchant_id,publication_no,snapshot_sha256,snapshot_json,status,created_at,actor_user_id
                        FROM merchant_menu_publications WHERE merchant_id=? AND status='LIVE'
                        ORDER BY publication_no DESC,id DESC LIMIT 1''',(merchant_id,)).fetchone()


def _v136_snapshot_diff(old_payload, new_payload):
    old_c={x['id']:x for x in (old_payload or {}).get('categories',[])}
    new_c={x['id']:x for x in (new_payload or {}).get('categories',[])}
    old_i={x['id']:x for x in (old_payload or {}).get('items',[])}
    new_i={x['id']:x for x in (new_payload or {}).get('items',[])}
    def changed(a,b):
        return a!=b
    return {
        'categories_added':sorted(set(new_c)-set(old_c)),
        'categories_removed':sorted(set(old_c)-set(new_c)),
        'categories_changed':sorted(k for k in set(old_c)&set(new_c) if changed(old_c[k],new_c[k])),
        'items_added':sorted(set(new_i)-set(old_i)),
        'items_removed':sorted(set(old_i)-set(new_i)),
        'items_changed':sorted(k for k in set(old_i)&set(new_i) if changed(old_i[k],new_i[k])),
    }


def _v136_validation(c, merchant_id):
    # Reuse v1.135 rules and make publication semantics explicit.
    result=_v135_menu_validation(c,merchant_id)
    active_items=c.execute('SELECT COUNT(*) n FROM menu_items WHERE merchant_id=? AND active=1',(merchant_id,)).fetchone()['n']
    active_categories=c.execute('SELECT COUNT(*) n FROM menu_categories WHERE merchant_id=? AND active=1',(merchant_id,)).fetchone()['n']
    if active_items<=0:
        result['errors'].append({'code':'NO_ACTIVE_ITEMS'})
        result['valid']=False
    if active_categories<=0 and active_items>0:
        result['warnings'].append({'code':'NO_ACTIVE_CATEGORIES'})
    result['validator_version']='1.136'
    result['active_items']=int(active_items)
    result['active_categories']=int(active_categories)
    return result


@app.get('/api/v136/merchant/menu/publication')
def v136_publication_status(authorization: str|None=Header(default=None)):
    u,mid=_v135_require_merchant(authorization)
    with core_db_connect() as c:
        migrate_v136(c)
        live=_v136_live_publication(c,mid)
        payload,sha,raw=_v136_snapshot(c,mid)
        return {'schema_version':'1.136','merchant_id':mid,'draft_sha256':sha,
                'draft_item_count':len(payload['items']),'draft_category_count':len(payload['categories']),
                'live':dict(live) if live else None,
                'live_sha256':live['snapshot_sha256'] if live else None,
                'up_to_date':bool(live and live['snapshot_sha256']==sha)}


@app.get('/api/v136/merchant/menu/preview-diff')
def v136_preview_diff(authorization: str|None=Header(default=None)):
    u,mid=_v135_require_merchant(authorization)
    with core_db_connect() as c:
        migrate_v136(c)
        validation=_v136_validation(c,mid)
        draft,sha,_=_v136_snapshot(c,mid)
        live=_v136_live_publication(c,mid)
        old=json.loads(live['snapshot_json']) if live else {'schema_version':'1.136','merchant_id':mid,'categories':[],'items':[]}
        diff=_v136_snapshot_diff(old,draft)
        return {'schema_version':'1.136','merchant_id':mid,'publishable':bool(validation['valid']),'changed':bool(not live or live['snapshot_sha256']!=sha),'draft_sha256':sha,
                'live_publication_no':int(live['publication_no']) if live else None,'live_sha256':live['snapshot_sha256'] if live else None,
                'diff':diff,'validation':validation}


@app.post('/api/v136/merchant/menu/publish')
def v136_publish_menu(authorization: str|None=Header(default=None), idempotency_key: str|None=Header(default=None,alias='Idempotency-Key')):
    u,mid=_v135_require_merchant(authorization)
    with core_db_connect() as c:
        migrate_v136(c)
        validation=_v136_validation(c,mid)
        if not validation['valid']:
            raise HTTPException(409, {'code':'MENU_NOT_PUBLISHABLE','validation':validation})
        draft,sha,raw=_v136_snapshot(c,mid)
        live=_v136_live_publication(c,mid)
        if live and live['snapshot_sha256']==sha:
            return {'schema_version':'1.136','merchant_id':mid,'status':'LIVE','publication_id':live['id'],
                    'publication_no':int(live['publication_no']),'snapshot_sha256':sha,'idempotent_reuse':True}
        last=c.execute('SELECT COALESCE(MAX(publication_no),0) n FROM merchant_menu_publications WHERE merchant_id=?',(mid,)).fetchone()['n']
        pno=int(last)+1
        # Mark previous live snapshot historical, never mutate its payload.
        c.execute("UPDATE merchant_menu_publications SET status='SUPERSEDED' WHERE merchant_id=? AND status='LIVE'",(mid,))
        pid='pub_'+uuid.uuid4().hex[:12]
        c.execute('''INSERT INTO merchant_menu_publications
                     (id,merchant_id,publication_no,snapshot_sha256,snapshot_json,status,created_at,actor_user_id)
                     VALUES (?,?,?,?,?,?,?,?)''',(pid,mid,pno,sha,raw,'LIVE',now(),u['id']))
        c.execute('''INSERT INTO merchant_menu_publish_audit
                     (id,merchant_id,publication_id,action,snapshot_sha256,actor_user_id,created_at)
                     VALUES (?,?,?,?,?,?,?)''',('mpa_'+uuid.uuid4().hex[:12],mid,pid,'PUBLISH',sha,u['id'],now()))
        emit(c,None,'merchant_menu_published',{'merchant_id':mid,'publication_id':pid,'publication_no':pno,'snapshot_sha256':sha},u['id'])
        c.commit()
        return {'schema_version':'1.136','merchant_id':mid,'status':'LIVE','publication_id':pid,'publication_no':pno,'snapshot_sha256':sha,'idempotent_reuse':False}


@app.post('/api/v136/merchant/menu/publish-check')
