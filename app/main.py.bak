    "cancelled": set(),
}


def now() -> str:
    return datetime.now(timezone.utc).isoformat()


def conn() -> sqlite3.Connection:
    c = sqlite3.connect(DB_PATH)
    c.row_factory = sqlite3.Row
    c.execute("PRAGMA foreign_keys = ON")
    c.execute("PRAGMA busy_timeout = 5000")
    c.execute("PRAGMA journal_mode = WAL")
    c.execute("PRAGMA synchronous = NORMAL")
    return c


def hash_secret(value: str) -> str:
    return hashlib.sha256(value.encode()).hexdigest()


def _columns(c: sqlite3.Connection, table: str) -> set[str]:
    return {row[1] for row in c.execute(f"PRAGMA table_info({table})").fetchall()}

def _db_table_exists(c, table: str) -> bool:
    """Portable table-existence check for request/runtime code."""
    import re
    if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", table):
        raise ValueError("invalid table identifier")
    if getattr(c, "backend", "sqlite") == "postgresql":
        return bool(c.execute("SELECT 1 FROM information_schema.tables WHERE table_schema='public' AND table_name=?", (table,)).fetchone())
    return bool(c.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name=?", (table,)).fetchone())

def _db_columns(c, table: str) -> list[dict[str, Any]]:
    """Portable column metadata with a small common subset used by compatibility flows."""
    import re
    if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", table):
        raise ValueError("invalid table identifier")
    if getattr(c, "backend", "sqlite") == "postgresql":
        rows=c.execute("""SELECT column_name AS name, data_type AS type,
                                CASE WHEN is_nullable='NO' THEN 1 ELSE 0 END AS notnull,
                                column_default AS default_value, 0 AS pk
                         FROM information_schema.columns
                         WHERE table_schema='public' AND table_name=?
                         ORDER BY ordinal_position""", (table,)).fetchall()
        return [dict(r) for r in rows]
    rows=c.execute(f"PRAGMA table_info({table})").fetchall()
    return [{"name":r[1],"type":r[2],"notnull":r[3],"default_value":r[4],"pk":r[5]} for r in rows]


def migrate_db(c: sqlite3.Connection) -> None:
    # Backward-compatible upgrades from v0.7 demo databases.
    mc = _columns(c, "merchants")
    for name, ddl in [("lat", "ALTER TABLE merchants ADD COLUMN lat REAL NOT NULL DEFAULT 49.834"), ("lon", "ALTER TABLE merchants ADD COLUMN lon REAL NOT NULL DEFAULT 18.292")]:
        if name not in mc: c.execute(ddl)
    oc = _columns(c, "orders")
    additions = [
        ("address_id", "ALTER TABLE orders ADD COLUMN address_id TEXT"),
        ("delivery_distance_km", "ALTER TABLE orders ADD COLUMN delivery_distance_km REAL NOT NULL DEFAULT 0"),
        ("service_fee_before_discount_czk", "ALTER TABLE orders ADD COLUMN service_fee_before_discount_czk REAL NOT NULL DEFAULT 0"),
        ("pro_discount_czk", "ALTER TABLE orders ADD COLUMN pro_discount_czk REAL NOT NULL DEFAULT 0"),
        ("pricing_version", "ALTER TABLE orders ADD COLUMN pricing_version TEXT NOT NULL DEFAULT 'v0.8'"),
        ("prep_eta_minutes", "ALTER TABLE orders ADD COLUMN prep_eta_minutes INTEGER NOT NULL DEFAULT 15"),
        ("promised_delivery_at", "ALTER TABLE orders ADD COLUMN promised_delivery_at TEXT"),
        ("predicted_pickup_at", "ALTER TABLE orders ADD COLUMN predicted_pickup_at TEXT"),
        ("predicted_delivery_at", "ALTER TABLE orders ADD COLUMN predicted_delivery_at TEXT"),
        ("assigned_at", "ALTER TABLE orders ADD COLUMN assigned_at TEXT"),
        ("picked_up_at", "ALTER TABLE orders ADD COLUMN picked_up_at TEXT"),
        ("delivered_at", "ALTER TABLE orders ADD COLUMN delivered_at TEXT"),
        ("live_eta_minutes", "ALTER TABLE orders ADD COLUMN live_eta_minutes INTEGER"),
        ("initial_route_distance_km", "ALTER TABLE orders ADD COLUMN initial_route_distance_km REAL"),
        ("delay_level", "ALTER TABLE orders ADD COLUMN delay_level TEXT NOT NULL DEFAULT 'NONE'"),
    ]
    for name, ddl in additions:
        if name not in oc: c.execute(ddl)
    c.execute("CREATE TABLE IF NOT EXISTS customer_addresses(id TEXT PRIMARY KEY, customer_id TEXT NOT NULL REFERENCES customers(id) ON DELETE CASCADE, label TEXT NOT NULL, street TEXT NOT NULL, city TEXT NOT NULL, postal_code TEXT, lat REAL NOT NULL, lon REAL NOT NULL, is_default INTEGER NOT NULL DEFAULT 0, created_at TEXT NOT NULL)")
    c.execute("CREATE TABLE IF NOT EXISTS pro_memberships(customer_id TEXT PRIMARY KEY REFERENCES customers(id) ON DELETE CASCADE, plan TEXT NOT NULL, price_czk REAL NOT NULL, active INTEGER NOT NULL DEFAULT 1, started_at TEXT NOT NULL)")
    c.execute("CREATE TABLE IF NOT EXISTS refunds(id TEXT PRIMARY KEY, order_id TEXT NOT NULL REFERENCES orders(id), provider_refund_id TEXT NOT NULL UNIQUE, amount_czk REAL NOT NULL, reason TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL)")
    c.execute("""CREATE TABLE IF NOT EXISTS courier_offers(
        id TEXT PRIMARY KEY, order_id TEXT NOT NULL REFERENCES orders(id) ON DELETE CASCADE, courier_id TEXT NOT NULL REFERENCES couriers(id),
        algorithm_version TEXT NOT NULL, rank INTEGER NOT NULL, distance_km REAL NOT NULL, pickup_eta_minutes INTEGER NOT NULL,
        predicted_delivery_at TEXT, status TEXT NOT NULL DEFAULT 'offered', offered_at TEXT NOT NULL, responded_at TEXT, response_reason TEXT,
        UNIQUE(order_id, courier_id, offered_at)
    )""")
    # Finance schema required by v0.62/v0.64 on a completely fresh DB.
    c.execute("""CREATE TABLE IF NOT EXISTS settlement_runs(
        id TEXT PRIMARY KEY, order_id TEXT NOT NULL UNIQUE, status TEXT NOT NULL DEFAULT 'pending',
        gross_czk REAL NOT NULL, platform_fee_czk REAL NOT NULL DEFAULT 0, merchant_payout_czk REAL NOT NULL DEFAULT 0,
        courier_payout_czk REAL NOT NULL DEFAULT 0, delivery_fee_czk REAL NOT NULL DEFAULT 0, adjustment_czk REAL NOT NULL DEFAULT 0,
        net_czk REAL NOT NULL DEFAULT 0, created_at TEXT NOT NULL, completed_at TEXT
    )""")
    c.execute("""CREATE TABLE IF NOT EXISTS finance_ledger_entries(
        id TEXT PRIMARY KEY, order_id TEXT NOT NULL, entry_type TEXT NOT NULL, account TEXT NOT NULL, direction TEXT NOT NULL,
        amount_czk REAL NOT NULL, reference TEXT, metadata_json TEXT, created_at TEXT NOT NULL
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_finance_ledger_order ON finance_ledger_entries(order_id,created_at)")
    # Upgrade legacy 7-column refunds table in place for v0.64/v0.79.
    rc = _columns(c, "refunds")
    refund_additions = [
        ("payment_id", "ALTER TABLE refunds ADD COLUMN payment_id TEXT"),
        ("reason_code", "ALTER TABLE refunds ADD COLUMN reason_code TEXT NOT NULL DEFAULT 'customer_request'"),
        ("status", "ALTER TABLE refunds ADD COLUMN status TEXT NOT NULL DEFAULT 'pending'"),
        ("provider_ref", "ALTER TABLE refunds ADD COLUMN provider_ref TEXT"),
        ("processed_at", "ALTER TABLE refunds ADD COLUMN processed_at TEXT"),
    ]
    for name, ddl in refund_additions:
        if name not in rc: c.execute(ddl)
    c.execute("CREATE UNIQUE INDEX IF NOT EXISTS idx_refunds_provider_ref_unique ON refunds(provider_ref) WHERE provider_ref IS NOT NULL")


def init_db() -> None:
    with closing(conn()) as c:
        c.executescript(
            """
            CREATE TABLE IF NOT EXISTS users(
                id TEXT PRIMARY KEY,
                name TEXT NOT NULL,
                email TEXT NOT NULL UNIQUE,
                password_hash TEXT NOT NULL,
                role TEXT NOT NULL,
                merchant_id TEXT,
                courier_id TEXT,
                customer_id TEXT,
                active INTEGER NOT NULL DEFAULT 1,
                created_at TEXT NOT NULL
            );
            CREATE TABLE IF NOT EXISTS sessions(
                token TEXT PRIMARY KEY,
                user_id TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
                created_at TEXT NOT NULL
            );
            CREATE TABLE IF NOT EXISTS refresh_sessions(
                id TEXT PRIMARY KEY,
                user_id TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
                token_hash TEXT NOT NULL UNIQUE,
                expires_at TEXT NOT NULL,
                revoked_at TEXT,
                created_at TEXT NOT NULL,
                last_used_at TEXT
            );
            CREATE TABLE IF NOT EXISTS security_events(
                id TEXT PRIMARY KEY,
                user_id TEXT,
                event_type TEXT NOT NULL,
                ip TEXT,
                metadata_json TEXT,
                created_at TEXT NOT NULL
            );
            CREATE INDEX IF NOT EXISTS idx_refresh_sessions_user ON refresh_sessions(user_id,expires_at);
            CREATE INDEX IF NOT EXISTS idx_security_events_user ON security_events(user_id,created_at);
            CREATE TABLE IF NOT EXISTS merchants(
                id TEXT PRIMARY KEY,
                name TEXT NOT NULL,
                prep_minutes INTEGER NOT NULL DEFAULT 15,
                active INTEGER NOT NULL DEFAULT 1,
                lat REAL NOT NULL DEFAULT 49.834,
                lon REAL NOT NULL DEFAULT 18.292,
                created_at TEXT NOT NULL
            );
            CREATE TABLE IF NOT EXISTS couriers(
                id TEXT PRIMARY KEY,
                name TEXT NOT NULL,
                status TEXT NOT NULL DEFAULT 'offline',
                lat REAL NOT NULL DEFAULT 49.834,
                lon REAL NOT NULL DEFAULT 18.292,
                verified INTEGER NOT NULL DEFAULT 1,
                earnings_czk REAL NOT NULL DEFAULT 0,
                created_at TEXT NOT NULL
            );
            CREATE TABLE IF NOT EXISTS customers(
                id TEXT PRIMARY KEY,
                name TEXT NOT NULL,
                email TEXT NOT NULL,
                created_at TEXT NOT NULL
            );
            CREATE TABLE IF NOT EXISTS customer_addresses(
                id TEXT PRIMARY KEY,
                customer_id TEXT NOT NULL REFERENCES customers(id) ON DELETE CASCADE,
                label TEXT NOT NULL,
                street TEXT NOT NULL,
                city TEXT NOT NULL,
                postal_code TEXT,
                lat REAL NOT NULL,
                lon REAL NOT NULL,
                is_default INTEGER NOT NULL DEFAULT 0,
                created_at TEXT NOT NULL
            );
            CREATE TABLE IF NOT EXISTS pro_memberships(
                customer_id TEXT PRIMARY KEY REFERENCES customers(id) ON DELETE CASCADE,
                plan TEXT NOT NULL,
                price_czk REAL NOT NULL,
                active INTEGER NOT NULL DEFAULT 1,
                started_at TEXT NOT NULL
            );
            CREATE TABLE IF NOT EXISTS menu_items(
                id TEXT PRIMARY KEY,
                merchant_id TEXT NOT NULL REFERENCES merchants(id),
                name TEXT NOT NULL,
                price_czk REAL NOT NULL,
                active INTEGER NOT NULL DEFAULT 1
            );
            CREATE TABLE IF NOT EXISTS cart_items(
                id TEXT PRIMARY KEY,
                customer_id TEXT NOT NULL REFERENCES customers(id) ON DELETE CASCADE,
                merchant_id TEXT NOT NULL REFERENCES merchants(id),
                menu_item_id TEXT NOT NULL REFERENCES menu_items(id),
                qty INTEGER NOT NULL,
                UNIQUE(customer_id, menu_item_id)
            );
                        CREATE TABLE IF NOT EXISTS orders(
                id TEXT PRIMARY KEY,
                customer_id TEXT NOT NULL REFERENCES customers(id),
                merchant_id TEXT NOT NULL REFERENCES merchants(id),
                status TEXT NOT NULL,
                subtotal_czk REAL NOT NULL,
                service_fee_czk REAL NOT NULL,
                delivery_fee_czk REAL NOT NULL,
                total_czk REAL NOT NULL,
                courier_id TEXT REFERENCES couriers(id),
                address TEXT NOT NULL,
                address_id TEXT REFERENCES customer_addresses(id),
                delivery_distance_km REAL NOT NULL DEFAULT 0,
                service_fee_before_discount_czk REAL NOT NULL DEFAULT 0,
                pro_discount_czk REAL NOT NULL DEFAULT 0,
                pricing_version TEXT NOT NULL DEFAULT 'v0.8',
                prep_eta_minutes INTEGER NOT NULL DEFAULT 15,
                promised_delivery_at TEXT,
                predicted_pickup_at TEXT,
                predicted_delivery_at TEXT,
                assigned_at TEXT,
                picked_up_at TEXT,
                delivered_at TEXT,
                delay_level TEXT NOT NULL DEFAULT 'NONE',
                created_at TEXT NOT NULL,
                updated_at TEXT NOT NULL
            );
            CREATE TABLE IF NOT EXISTS order_items(
                id TEXT PRIMARY KEY,
                order_id TEXT NOT NULL REFERENCES orders(id) ON DELETE CASCADE,
                menu_item_id TEXT NOT NULL REFERENCES menu_items(id),
                qty INTEGER NOT NULL,
                unit_price_czk REAL NOT NULL
            );
            CREATE TABLE IF NOT EXISTS payments(
                id TEXT PRIMARY KEY,
                order_id TEXT NOT NULL UNIQUE REFERENCES orders(id),
                provider_payment_id TEXT NOT NULL UNIQUE,
                amount_czk REAL NOT NULL,
                status TEXT NOT NULL,
                created_at TEXT NOT NULL
            );
            CREATE TABLE IF NOT EXISTS events(
                id TEXT PRIMARY KEY,
                order_id TEXT,
                type TEXT NOT NULL,
                actor_user_id TEXT,
                payload TEXT NOT NULL,
                created_at TEXT NOT NULL
            );
            CREATE TABLE IF NOT EXISTS settlements(
                id TEXT PRIMARY KEY,
                order_id TEXT NOT NULL UNIQUE REFERENCES orders(id),
                merchant_czk REAL NOT NULL,
                courier_czk REAL NOT NULL,
                platform_czk REAL NOT NULL,
                variance_czk REAL NOT NULL,
                status TEXT NOT NULL,
                created_at TEXT NOT NULL
            );
            """
        )
        migrate_db(c)
        c.execute("CREATE INDEX IF NOT EXISTS idx_courier_offers_order_status ON courier_offers(order_id, status, offered_at)")
        c.execute("CREATE INDEX IF NOT EXISTS idx_courier_offers_courier_status ON courier_offers(courier_id, status, offered_at)")
        c.execute("CREATE TABLE IF NOT EXISTS courier_locations(id TEXT PRIMARY KEY, order_id TEXT, courier_id TEXT NOT NULL REFERENCES couriers(id) ON DELETE CASCADE, lat REAL NOT NULL, lon REAL NOT NULL, accuracy_m REAL, recorded_at TEXT NOT NULL, remaining_distance_km REAL, live_eta_minutes INTEGER, deviation_ratio REAL)")
        loc_cols = {r[1] for r in c.execute("PRAGMA table_info(courier_locations)").fetchall()}
        for name, typ in [("order_id","TEXT"),("remaining_distance_km","REAL"),("live_eta_minutes","INTEGER"),("deviation_ratio","REAL")]:
            if name not in loc_cols:
                c.execute(f"ALTER TABLE courier_locations ADD COLUMN {name} {typ}")
        c.execute("CREATE INDEX IF NOT EXISTS idx_courier_locations_courier_time ON courier_locations(courier_id, recorded_at DESC)")
        c.execute("CREATE INDEX IF NOT EXISTS idx_courier_locations_order_time ON courier_locations(order_id, recorded_at DESC)")
        c.execute("CREATE TABLE IF NOT EXISTS notifications(id TEXT PRIMARY KEY, customer_id TEXT REFERENCES customers(id) ON DELETE CASCADE, order_id TEXT REFERENCES orders(id) ON DELETE CASCADE, type TEXT NOT NULL, title TEXT NOT NULL, message TEXT NOT NULL, read_at TEXT, created_at TEXT NOT NULL)")
        c.execute("CREATE INDEX IF NOT EXISTS idx_notifications_customer_time ON notifications(customer_id, created_at DESC)")
        merchant = c.execute("SELECT id FROM merchants LIMIT 1").fetchone()
        if not merchant:
            t = now()
