_V106_POLICY={'schema_version':'1.106','checkpoint_format':'wunoo.release.recovery.finality.chain.checkpoint.v1','attestation_format':'wunoo.release.recovery.finality.chain.checkpoint.attestation.v1','finality_format':'wunoo.release.recovery.finality.chain.checkpoint.finality.v1','hash':'SHA-256','algorithm':'Ed25519','genesis_hash':'0'*64,'strict_sequence':True,'immutable_history':True,'requires_verified_v105_chain':True,'cross_federation_quorum_required':True,'no_automatic_recovery':True,'no_chain_mutation':True,'fail_closed':True,'no_automatic_release':True}
