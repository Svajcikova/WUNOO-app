@app.get("/api/v045/orders/{order_id}/tracking")
def v045_tracking(order_id: str, authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u=current_user(authorization)
    with core_db_connect() as c:
        o=c.execute("""SELECT o.*,m.name merchant_name,cr.name courier_name
                       FROM orders o JOIN merchants m ON m.id=o.merchant_id
                       LEFT JOIN couriers cr ON cr.id=o.courier_id WHERE o.id=?""",(order_id,)).fetchone()
        if not o: raise HTTPException(404,"Objednávka nenalezena")
        allowed=(u["role"]=="admin" or
                 (u["role"]=="customer" and o["customer_id"]==u["customer_id"]) or
                 (u["role"]=="merchant" and o["merchant_id"]==u["merchant_id"]) or
                 (u["role"]=="courier" and o["courier_id"]==u["courier_id"]))
        if not allowed: raise HTTPException(403,"forbidden")
        loc=c.execute("""SELECT lat,lon,remaining_distance_km,live_eta_minutes,deviation_ratio,recorded_at
                         FROM courier_locations WHERE order_id=? ORDER BY recorded_at DESC LIMIT 1""",(order_id,)).fetchone()
        events=c.execute("""SELECT type,actor_user_id,payload,created_at FROM events
                            WHERE order_id=? ORDER BY created_at DESC LIMIT 30""",(order_id,)).fetchall()
        ex=c.execute("""SELECT code,note,status,created_at,resolved_at FROM delivery_exceptions
                        WHERE order_id=? ORDER BY created_at DESC""",(order_id,)).fetchall()
        return {
            "order_id":order_id,
            "status":o["status"],
            "merchant_name":o["merchant_name"],
            "courier":{"id":o["courier_id"],"name":o["courier_name"]} if o["courier_id"] else None,
            "promise":{"promised_at":o["promised_at"],"mode":o["promise_mode"]},
            "tracking_available":bool(loc),
            "location":{"lat":loc["lat"],"lon":loc["lon"],"remaining_distance_km":loc["remaining_distance_km"],
                        "live_eta_minutes":loc["live_eta_minutes"],"deviation_ratio":loc["deviation_ratio"],
                        "reported_at":loc["recorded_at"]} if loc else None,
            "timeline":[dict(e) for e in events],
            "exceptions":[dict(e) for e in ex],
        }


@app.get("/api/v045/orders/{order_id}/customer-status")
def v045_customer_status(order_id: str, authorization: str | None = Header(default=None)) -> dict[str, Any]:
    data=v045_tracking(order_id,authorization)
    st=data["status"]
    labels={
        "merchant_pending":"Restaurace přijala objednávku",
        "preparing":"Objednávka se připravuje",
        "dispatch_pending":"Hledáme kurýra",
        "assigned":"Kurýr je přiřazen",
        "picked_up":"Kurýr vyzvedl objednávku",
        "out_for_delivery":"Kurýr je na cestě",
        "delayed":"Doručení má zpoždění",
        "delivered":"Doručeno",
        "cancelled":"Zrušeno",
    }
    data["customer_message"]=labels.get(st,st)
    data["recovery_needed"]=bool(data["exceptions"]) and any(x["status"]=="open" for x in data["exceptions"])
    return data

