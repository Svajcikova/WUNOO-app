        dv=_v100_verify_decision(c,dec)
        if not dv['valid']:raise HTTPException(409,'V101_RECOVERY_DECISION_NOT_VERIFIABLE')
        existing=c.execute('SELECT * FROM production_global_recovery_consensus_chain WHERE consensus_id=?',(cons['id'],)).fetchone()
        if existing:
            ev=_v101_verify_entry(c,existing)
            if not ev['valid']:raise HTTPException(409,'V101_EXISTING_ENTRY_NOT_VERIFIABLE')
            cv=_v101_verify_chain(c)
