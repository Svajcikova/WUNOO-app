@app.post("/api/v047/notifications/preferences")
def v047_set_preferences(body:dict[str,Any], authorization: str | None=Header(default=None)) -> dict[str,Any]:
    u=current_user(authorization)
    with core_db_connect() as c:
        c.execute("""INSERT INTO notification_preferences VALUES (?,?,?,?)
                     ON CONFLICT(user_id) DO UPDATE SET order_updates=excluded.order_updates,operational_alerts=excluded.operational_alerts,marketing=excluded.marketing""",
                  (u["id"],1 if body.get("order_updates",True) else 0,1 if body.get("operational_alerts",True) else 0,1 if body.get("marketing",False) else 0))
        c.commit()
        return {"user_id":u["id"],"order_updates":bool(body.get("order_updates",True)),"operational_alerts":bool(body.get("operational_alerts",True)),"marketing":bool(body.get("marketing",False))}

@app.post("/api/v047/notifications/order/{order_id}/broadcast")
def v047_broadcast_order(order_id:str, body:dict[str,Any], authorization: str | None=Header(default=None)) -> dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent","merchant"})
    msg=str(body.get("body","")).strip()
    if not msg or len(msg)>500: raise HTTPException(400,"Neplatná zpráva")
    with core_db_connect() as c:
        o=c.execute("SELECT * FROM orders WHERE id=?",(order_id,)).fetchone()
        if not o: raise HTTPException(404,"Objednávka nenalezena")
        if u["role"]=="merchant" and o["merchant_id"]!=u["merchant_id"]: raise HTTPException(403,"forbidden")
        users=_v047_users_for_order(c,o)
        for uid in users:
            _v047_notify(c,uid,str(body.get("title","Aktualizace objednávky")),msg,"broadcast",order_id,str(body.get("severity","info")))
        c.commit()
        return {"order_id":order_id,"recipients":len(users)}


@app.post("/api/v047/orders/{order_id}/notify-event")
def v047_notify_event(order_id:str, body:dict[str,Any], authorization: str|None=Header(default=None)) -> dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    typ=str(body.get("event_type",""))
    title,msg=_v047_event_message(typ,body.get("payload") or {})
    with core_db_connect() as c:
        o=c.execute("SELECT * FROM orders WHERE id=?",(order_id,)).fetchone()
        if not o: raise HTTPException(404,"Objednávka nenalezena")
        recipients=_v047_users_for_order(c,o)
        for uid in recipients:
            _v047_notify(c,uid,title,msg,typ,order_id,"warning" if "exception" in typ or "breach" in typ else "info")
        c.commit()
        return {"order_id":order_id,"event_type":typ,"recipients":len(recipients)}

