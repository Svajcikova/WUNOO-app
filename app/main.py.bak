def v107_append(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin'});p=payload or {};fid=p.get('finality_id');op=str(u.get('email') or u.get('id') or 'operator')
