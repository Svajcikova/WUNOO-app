    c.commit()


def _v137_modifier_snapshot(c, merchant_id, item_ids):
    groups_by_item={}
    if not item_ids:
        return groups_by_item
    placeholders=','.join('?' for _ in item_ids)
    rows=c.execute(f"""SELECT mig.menu_item_id,mg.id group_id,mg.name group_name,mg.min_select,mg.max_select,mg.active group_active,
                              mo.id modifier_id,mo.name modifier_name,mo.price_czk,mo.active modifier_active
                       FROM menu_item_modifier_groups mig
                       JOIN modifier_groups mg ON mg.id=mig.group_id AND mg.merchant_id=?
                       LEFT JOIN modifiers mo ON mo.group_id=mg.id
                       WHERE mig.menu_item_id IN ({placeholders})
                       ORDER BY mig.menu_item_id,mg.name,mg.id,mo.name,mo.id""", [merchant_id,*item_ids]).fetchall()
    for r in rows:
        if int(r['group_active'] or 0)!=1: continue
        bucket=groups_by_item.setdefault(r['menu_item_id'],{})
        g=bucket.setdefault(r['group_id'],{'id':r['group_id'],'name':r['group_name'],'min_select':int(r['min_select']),'max_select':int(r['max_select']),'active':1,'modifiers':[]})
        if r['modifier_id'] and int(r['modifier_active'] or 0)==1:
            g['modifiers'].append({'id':r['modifier_id'],'name':r['modifier_name'],'price_czk':float(r['price_czk'])})
    return {iid:list(v.values()) for iid,v in groups_by_item.items()}


def _v137_snapshot(c, merchant_id):
    categories=c.execute("""SELECT id,name,sort_order,active FROM menu_categories
                            WHERE merchant_id=? AND active=1 ORDER BY sort_order,name,id""",(merchant_id,)).fetchall()
    items=c.execute("""SELECT id,name,description,price_czk,currency,active,category_id,display_order,version
                       FROM menu_items WHERE merchant_id=? AND active=1
                       ORDER BY COALESCE(category_id,''),display_order,name,id""",(merchant_id,)).fetchall()
    avails=c.execute("""SELECT pa.menu_item_id,pa.state,pa.start_at,pa.end_at,pa.reason,pa.version
                        FROM product_availability pa JOIN menu_items mi ON mi.id=pa.menu_item_id AND mi.merchant_id=?
                        JOIN (SELECT menu_item_id,MAX(updated_at) max_updated FROM product_availability GROUP BY menu_item_id) latest
                          ON latest.menu_item_id=pa.menu_item_id AND latest.max_updated=pa.updated_at""",(merchant_id,)).fetchall()
    by_item={r['menu_item_id']:dict(r) for r in avails}
    item_ids=[r['id'] for r in items]
    mods=_v137_modifier_snapshot(c,merchant_id,item_ids)
    payload={'schema_version':'1.137','merchant_id':merchant_id,'categories':[dict(x) for x in categories],
             'items':[{**dict(x),'availability':by_item.get(x['id'],{'state':'AVAILABLE','start_at':None,'end_at':None,'reason':None,'version':0}),
                       'modifier_groups':mods.get(x['id'],[])} for x in items]}
    raw=json.dumps(payload,ensure_ascii=False,separators=(',',':'),sort_keys=True)
    return payload,hashlib.sha256(raw.encode()).hexdigest(),raw


def _v137_live_publication(c, merchant_id):
    return c.execute("""SELECT id,merchant_id,publication_no,snapshot_sha256,snapshot_json,status,created_at,actor_user_id
                        FROM merchant_menu_publications WHERE merchant_id=? AND status='LIVE'
                        ORDER BY publication_no DESC,id DESC LIMIT 1""",(merchant_id,)).fetchone()


def _v137_sync_diff(live_payload, current_payload):
    old=live_payload or {}; new=current_payload or {}
    old_i={i['id']:i for i in old.get('items',[])}; new_i={i['id']:i for i in new.get('items',[])}
    fields=('name','description','price_czk','currency','category_id','display_order','active','availability','modifier_groups')
    changed=[]
    for iid in sorted(set(old_i)&set(new_i)):
        if any(old_i[iid].get(k)!=new_i[iid].get(k) for k in fields): changed.append(iid)
    old_c={x['id']:x for x in old.get('categories',[])}; new_c={x['id']:x for x in new.get('categories',[])}
    return {'categories_added':sorted(set(new_c)-set(old_c)),'categories_removed':sorted(set(old_c)-set(new_c)),
            'categories_changed':sorted(k for k in set(old_c)&set(new_c) if old_c[k]!=new_c[k]),
            'items_added':sorted(set(new_i)-set(old_i)),'items_removed':sorted(set(old_i)-set(new_i)),'items_changed':changed}


@app.get('/api/v137/merchant/menu/customer-preview')
def v137_customer_preview(authorization: str|None=Header(default=None)):
    _u,mid=_v135_require_merchant(authorization)
    with core_db_connect() as c:
        migrate_v136(c); migrate_v137(c)
        live=_v137_live_publication(c,mid)
        if not live:
            return {'schema_version':'1.137','merchant_id':mid,'published':False,'publication':None,'customer_projection_exact':False}
        snap=json.loads(live['snapshot_json'])
        return {'schema_version':'1.137','merchant_id':mid,'published':True,
                'customer_projection_exact':snap.get('schema_version')=='1.137' and all('modifier_groups' in i for i in snap.get('items',[])),
                'publication':{'id':live['id'],'publication_no':int(live['publication_no']),'snapshot_sha256':live['snapshot_sha256'],'created_at':live['created_at'],'menu':snap}}

@app.get('/api/v137/merchant/menu/customer-sync')
def v137_customer_sync(authorization: str|None=Header(default=None)):
    _u,mid=_v135_require_merchant(authorization)
    with core_db_connect() as c:
        migrate_v136(c); migrate_v137(c)
        current,sha,_=_v137_snapshot(c,mid); live=_v137_live_publication(c,mid)
        old=json.loads(live['snapshot_json']) if live else {'categories':[],'items':[]}
        exact=bool(live and live['snapshot_sha256']==sha)
        projection_exact=bool(live and old.get('schema_version')=='1.137' and all('modifier_groups' in i for i in old.get('items',[])))
        return {'schema_version':'1.137','merchant_id':mid,'in_sync':exact,'customer_projection_exact':projection_exact,
                'requires_publish':not exact,'draft_sha256':sha,'live_sha256':live['snapshot_sha256'] if live else None,
                'publication_no':int(live['publication_no']) if live else None,'diff':_v137_sync_diff(old,current)}

@app.post('/api/v137/merchant/menu/publish')
def v137_publish_menu(authorization: str|None=Header(default=None), idempotency_key: str|None=Header(default=None,alias='Idempotency-Key')):
    u,mid=_v135_require_merchant(authorization)
    with core_db_connect() as c:
        migrate_v136(c); migrate_v137(c)
        validation=_v136_validation(c,mid)
        if not validation['valid']: raise HTTPException(409,{'code':'MENU_NOT_PUBLISHABLE','validation':validation})
        draft,sha,raw=_v137_snapshot(c,mid); live=_v137_live_publication(c,mid)
        if live and live['snapshot_sha256']==sha and json.loads(live['snapshot_json']).get('schema_version')=='1.137':
            return {'schema_version':'1.137','merchant_id':mid,'status':'LIVE','publication_id':live['id'],'publication_no':int(live['publication_no']),'snapshot_sha256':sha,'idempotent_reuse':True}
        last=c.execute('SELECT COALESCE(MAX(publication_no),0) n FROM merchant_menu_publications WHERE merchant_id=?',(mid,)).fetchone()['n']
        pno=int(last)+1; pid='pub_'+uuid.uuid4().hex[:12]
        c.execute("UPDATE merchant_menu_publications SET status='SUPERSEDED' WHERE merchant_id=? AND status='LIVE'",(mid,))
        c.execute('''INSERT INTO merchant_menu_publications (id,merchant_id,publication_no,snapshot_sha256,snapshot_json,status,created_at,actor_user_id) VALUES (?,?,?,?,?,?,?,?)''',(pid,mid,pno,sha,raw,'LIVE',now(),u['id']))
        c.execute('''INSERT INTO merchant_menu_publish_audit (id,merchant_id,publication_id,action,snapshot_sha256,actor_user_id,created_at) VALUES (?,?,?,?,?,?,?)''',('mpa_'+uuid.uuid4().hex[:12],mid,pid,'PUBLISH_V137',sha,u['id'],now()))
        c.execute('''INSERT INTO merchant_menu_sync_audit (id,merchant_id,publication_id,action,draft_sha256,live_sha256,exact,actor_user_id,created_at) VALUES (?,?,?,?,?,?,?,?,?)''',('msa_'+uuid.uuid4().hex[:12],mid,pid,'CUSTOMER_SYNC_PUBLISH',sha,sha,1,u['id'],now()))
        emit(c,None,'merchant_menu_customer_sync_published',{'merchant_id':mid,'publication_id':pid,'publication_no':pno,'snapshot_sha256':sha},u['id'])
        c.commit()
        return {'schema_version':'1.137','merchant_id':mid,'status':'LIVE','publication_id':pid,'publication_no':pno,'snapshot_sha256':sha,'idempotent_reuse':False}

