@app.post("/api/v056/customer/app-event")
def v056_customer_app_event(body:dict[str,Any], authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,"customer")
    route=str(body.get("route","/")).strip()[:120]
    event=str(body.get("event_name","view")).strip()[:120]
    with core_db_connect() as c:
        _v056_app_event(c,u["id"],route,event,body.get("metadata") or {})
        c.execute("""INSERT INTO customer_app_sessions
                     (id,user_id,last_route,cart_json,updated_at,created_at)
                     VALUES (?,?,?,?,?,?)
                     ON CONFLICT(id) DO UPDATE SET last_route=excluded.last_route,
                     cart_json=excluded.cart_json,updated_at=excluded.updated_at""",
                  ("session_"+u["id"],u["id"],route,json.dumps(body.get("cart") or [],ensure_ascii=False),now(),now()))
        c.commit()
    return {"accepted":True}

