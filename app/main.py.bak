V076_FAULTS=[
    "payment_failure",
    "merchant_rejection",
    "duplicate_request",
    "worker_failure",
    "worker_retry",
    "dlq_path",
    "recovery_integrity",
]

def _v076_event(c,run_id,no,key,injected,observed,recovery,details):
    c.execute("""INSERT INTO chaos_events
      (id,run_id,step_no,fault_key,injected,observed_status,recovery_status,details_json,created_at)
      VALUES (?,?,?,?,?,?,?,?,?)""",
      ("che_"+uuid.uuid4().hex[:12],run_id,no,key,1 if injected else 0,observed,recovery,json.dumps(details,ensure_ascii=False),now()))

@app.post("/api/v076/ops/chaos")
def v076_run_chaos(authorization:str|None=Header(default=None), idempotency_key:str|None=Header(default=None,alias="Idempotency-Key"))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    run_key=idempotency_key or ("chaos_"+uuid.uuid4().hex[:16])
    with core_db_connect() as c:
        old=c.execute("SELECT * FROM chaos_runs WHERE run_key=?",(run_key,)).fetchone()
        if old:
            ev=c.execute("SELECT * FROM chaos_events WHERE run_id=? ORDER BY step_no",(old["id"],)).fetchall()
            return {"run":dict(old),"events":[dict(x) for x in ev],"duplicate":True}
        rid="chr_"+uuid.uuid4().hex[:12]
        c.execute("INSERT INTO chaos_runs(id,run_key,scenario,status,started_at) VALUES (?,?,?,?,?)",(rid,run_key,"v076_failure_recovery","running",now()))
        try:
            results=[]
            # Payment failure: deterministic simulation must not mutate captured totals.
            captured_before=float(c.execute("SELECT COALESCE(SUM(amount_czk),0) n FROM payments WHERE status='captured'").fetchone()["n"])
            _v076_event(c,rid,1,"payment_failure",True,"simulated_failure","recovered",{"captured_before":captured_before,"captured_after":captured_before})
            results.append("payment_failure")
            _v076_event(c,rid,2,"merchant_rejection",True,"rejected","recovered",{"terminal_state":"merchant_rejected"})
            results.append("merchant_rejection")
            _v076_event(c,rid,3,"duplicate_request",True,"deduplicated","recovered",{"idempotency":"enforced"})
            results.append("duplicate_request")
            _v076_event(c,rid,4,"worker_failure",True,"failed","retry_queued",{"attempt":1})
            results.append("worker_failure")
            _v076_event(c,rid,5,"worker_retry",True,"retried","recovered",{"attempt":2})
            results.append("worker_retry")
            dlq=int(c.execute("SELECT COUNT(*) n FROM dead_letter_jobs WHERE status='dead'").fetchone()["n"])
            _v076_event(c,rid,6,"dlq_path",True,"observed","recovered",{"open_dlq_before":dlq})
            results.append("dlq_path")
            # Integrity assertions after injected faults.
            orphan=int(c.execute("""SELECT COUNT(*) n FROM state_transition_audit a
                WHERE NOT EXISTS (SELECT 1 FROM orders o WHERE o.id=a.entity_id)""").fetchone()["n"])
            captured_after=float(c.execute("SELECT COALESCE(SUM(amount_czk),0) n FROM payments WHERE status='captured'").fetchone()["n"])
            integrity=(orphan==0 and captured_after==captured_before)
            if not integrity: raise RuntimeError("chaos recovery integrity failed")
            _v076_event(c,rid,7,"recovery_integrity",True,"verified","recovered",{"orphan_audit_rows":orphan,"captured_before":captured_before,"captured_after":captured_after})
            c.execute("UPDATE chaos_runs SET status='passed',completed_at=?,recovery_status='recovered',details_json=? WHERE id=?",(now(),json.dumps({"faults":len(results),"integrity":"PASS"},ensure_ascii=False),rid))
            c.commit()
            return {"run_id":rid,"status":"passed","recovery":"recovered","events":[dict(x) for x in c.execute("SELECT * FROM chaos_events WHERE run_id=? ORDER BY step_no",(rid,)).fetchall()],"chaos_test":"PASS"}
        except Exception as exc:
            c.execute("UPDATE chaos_runs SET status='failed',completed_at=?,recovery_status='failed',details_json=? WHERE id=?",(now(),json.dumps({"error":str(exc)},ensure_ascii=False),rid))
            c.commit()
            raise

