    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c: row=c.execute('SELECT * FROM production_safety_promotion_runs WHERE id=?',(run_id,)).fetchone()
    if not row: raise HTTPException(404,'promotion run nenalezen')
