            )
            cid = "cust_demo"
            c.execute("INSERT INTO customers VALUES (?,?,?,?)", (cid, "Demo Customer", "demo@wunoo.local", t))
            users = [
                ("u_customer", "Demo Customer", "customer@wunoo.local", "customer", None, None, cid),
                ("u_merchant", "Bistro Operator", "merchant@wunoo.local", "merchant", "m_bistro", None, None),
                ("u_katsu", "Katsu Operator", "katsu@wunoo.local", "merchant", "m_katsu", None, None),
                ("u_pizza", "Pizza Operator", "pizza@wunoo.local", "merchant", "m_pizza", None, None),
                ("u_courier", "Anna Courier", "courier@wunoo.local", "courier", None, "c_anna", None),
                ("u_petr", "Petr Courier", "petr@wunoo.local", "courier", None, "c_petr", None),
                ("u_admin", "WUNOO Admin", "admin@wunoo.local", "admin", None, None, None),
            ]
            for uid, name, email, role, merchant_id, courier_id, customer_id in users:
                c.execute(
                    "INSERT INTO users VALUES (?,?,?,?,?,?,?,?,?,?)",
                    (uid, name, email, hash_secret("demo"), role, merchant_id, courier_id, customer_id, 1, t),
                )
            c.execute("INSERT INTO customer_addresses VALUES (?,?,?,?,?,?,?,?,?,?)", ("addr_demo", cid, "Domů", "Hlavní 1", "Ostrava", "70200", 49.8350, 18.2925, 1, t))
        migrate_db(c)
        migrate_v082(c)
        try:
            migrate_v034(c)
            migrate_v037(c)
            migrate_v038(c)
            migrate_v039(c)
            migrate_v040(c)
            migrate_v041(c)
            migrate_v043(c)
            migrate_v044(c)
        except NameError:
            pass
        try:
            c.execute("ALTER TABLE orders ADD COLUMN note TEXT")
        except sqlite3.OperationalError:
            pass
        try:
            c.execute("ALTER TABLE orders ADD COLUMN payment_method TEXT NOT NULL DEFAULT \"card_demo\"")
        except sqlite3.OperationalError:
            pass
        c.commit()


def notify_customer(c: sqlite3.Connection, customer_id: str, order_id: str | None, typ: str, title: str, message: str) -> None:
    c.execute(
        "INSERT INTO notifications VALUES (?,?,?,?,?,?,?,?)",
        (str(uuid.uuid4()), customer_id, order_id, typ, title, message, None, now())
    )


def emit(c: sqlite3.Connection, order_id: str | None, typ: str, payload: dict[str, Any], actor_user_id: str | None = None) -> None:
    c.execute("INSERT INTO events VALUES (?,?,?,?,?,?)", (str(uuid.uuid4()), order_id, typ, actor_user_id, str(payload), now()))
    # v1.22 event outbox is additive; the helper is defined later in the module.
    try:
        _v122_enqueue_event_outbox(c, order_id, typ, payload, actor_user_id)
    except NameError:
        pass


def _notify_order_status(c: sqlite3.Connection, order_id: str, new_status: str) -> None:
    """Create a customer notification for important lifecycle milestones."""
    messages = {
        "merchant_pending": ("Objednávka přijata", "Objednávka čeká na potvrzení restaurací."),
        "preparing": ("Restaurace připravuje objednávku", "Vaše objednávka se právě připravuje."),
        "dispatch_pending": ("Hledáme kurýra", "Objednávka je připravena k vyzvednutí a hledáme kurýra."),
        "assigned": ("Kurýr přiřazen", "K vaší objednávce byl přiřazen kurýr."),
        "picked_up": ("Objednávka vyzvednuta", "Kurýr právě vyzvedl vaši objednávku."),
        "out_for_delivery": ("Kurýr je na cestě", "Vaše objednávka je na cestě."),
        "delayed": ("Doručení se zpozdilo", "Vaše objednávka má zpoždění. Aktualizujeme odhad doručení."),
        "delivered": ("Objednávka doručena", "Vaše objednávka byla úspěšně doručena."),
        "cancelled": ("Objednávka zrušena", "Vaše objednávka byla zrušena."),
    }
    msg = messages.get(new_status)
    if not msg:
        return
    row = c.execute("SELECT customer_id FROM orders WHERE id=?", (order_id,)).fetchone()
    if row and row["customer_id"]:
        notify_customer(c, row["customer_id"], order_id, "order_status", msg[0], msg[1])


def insert_refund(c: sqlite3.Connection, rid: str, order_id: str, payment_id: str | None, amount: float,
                  reason_code: str, status: str, provider_ref: str) -> None:
    # Compatibility writer for both the original 7-column refund model and the
    # later v0.64 9-column extension. The current table may contain legacy alias
    # columns (provider_refund_id/reason) plus the newer normalized columns.
    created = now()
    # The normalized refund contract is shared by SQLite and PostgreSQL. SQLite
    # keeps legacy alias columns for backwards compatibility; PostgreSQL uses the
    # canonical normalized shape without PRAGMA/introspection in the request path.
    if getattr(c, "backend", "sqlite") == "postgresql":
        c.execute("""INSERT INTO refunds
            (id,order_id,payment_id,amount_czk,reason_code,status,provider_ref,created_at,processed_at)
            VALUES (?,?,?,?,?,?,?,?,?)""",
            (rid, order_id, payment_id, round(amount,2), reason_code, status, provider_ref, created, created))
    else:
        c.execute("""INSERT INTO refunds
            (id,order_id,provider_refund_id,amount_czk,reason,status,created_at,payment_id,reason_code,provider_ref,processed_at)
            VALUES (?,?,?,?,?,?,?,?,?,?,?)""",
            (rid, order_id, provider_ref, round(amount,2), reason_code, status, created,
             payment_id, reason_code, provider_ref, created))


def _db_table_names(c) -> list[str]:
    """Return user tables through backend-neutral catalog queries."""
    if getattr(c, "backend", "sqlite") == "postgresql":
        rows=c.execute("SELECT table_name AS name FROM information_schema.tables WHERE table_schema='public' ORDER BY table_name").fetchall()
    else:
        rows=c.execute("SELECT name FROM sqlite_master WHERE type='table' ORDER BY name").fetchall()
    return [r["name"] for r in rows]

def _db_concurrency_info(c) -> tuple[Any, Any]:
    """Expose SQLite tuning only when SQLite is actually the active backend."""
    if getattr(c, "backend", "sqlite") == "postgresql":
        return None, None
    return c.execute("PRAGMA journal_mode").fetchone()[0], c.execute("PRAGMA busy_timeout").fetchone()[0]

def verify_password(password: str, stored_hash: str) -> bool:
    """Verify credentials against the project's existing password-hash format."""
    return secrets.compare_digest(hash_secret(password), str(stored_hash))


def _issue_access_session(c: sqlite3.Connection, user: sqlite3.Row) -> str:
    """Create an access session compatible with the legacy current_user() path."""
    token = secrets.token_urlsafe(32)
    c.execute("INSERT INTO sessions VALUES (?,?,?)", (token, user["id"], now()))
    return token


def authenticate_user(c: sqlite3.Connection, email: str, password: str) -> bool:
    """Compatibility credential validator for auth/session endpoints."""
    user = c.execute("SELECT password_hash FROM users WHERE LOWER(email)=? AND active=1", (email,)).fetchone()
    return bool(user and verify_password(password, user["password_hash"]))


def current_user(authorization: str | None) -> dict[str, Any]:
    """Resolve the authenticated principal through the DB-neutral repository seam.

    This is intentionally the global compatibility boundary: legacy endpoints can
    keep calling current_user() while authentication itself no longer depends on
    the SQLite-only conn() request path.
    """
    token = v134_token(authorization)
    with core_db_connect() as db:
        return dict(V134AuthRepository(db).resolve(token))


def require_role(user: sqlite3.Row, *roles: str) -> None:
    # Compatibility: historical endpoints pass variadic role strings while newer
    # endpoints sometimes pass a single set/list/tuple of roles. Normalize both.
    allowed = set()
    for role in roles:
        if isinstance(role, (set, list, tuple, frozenset)):
            allowed.update(str(x) for x in role)
        else:
            allowed.add(str(role))
    if user["role"] not in allowed:
        raise HTTPException(403, "Nedostatečné oprávnění")


def atomic_transition_any(
    c: sqlite3.Connection,
    order_id: str,
    expected_states: tuple[str, ...] | list[str] | set[str],
    new_status: str,
    actor: sqlite3.Row,
    typ: str,
    payload: dict[str, Any] | None = None,
) -> tuple[str, str]:
    """Atomically change an order from one of expected_states to new_status.

    Used by legacy/versioned endpoints whose state vocabulary differs from the
    canonical ORDER_STATES map. The expected state is part of the UPDATE WHERE
    clause, preventing a concurrent worker from silently overwriting a newer state.
    """
    expected_states = tuple(dict.fromkeys(str(x) for x in expected_states))
    if not expected_states:
        raise HTTPException(400, "Chybí očekávaný stav")
    o = c.execute("SELECT status FROM orders WHERE id=?", (order_id,)).fetchone()
    if not o:
        raise HTTPException(404, "Objednávka nenalezena")
    current = str(o["status"])
    if current not in expected_states:
        raise HTTPException(409, f"Objednávka je ve stavu {current}, očekává se {expected_states}")
    ts = now()
    placeholders = ",".join("?" for _ in expected_states)
    cur = c.execute(
        f"UPDATE orders SET status=?,updated_at=? WHERE id=? AND status IN ({placeholders})",
        (new_status, ts, order_id, *expected_states),
    )
    if cur.rowcount != 1:
        raise HTTPException(409, "State transition conflict")
    try:
        c.execute(
            "INSERT INTO state_transition_audit VALUES (?,?,?,?,?,?,?,?)",
            ("sta_" + uuid.uuid4().hex[:12], "order", order_id, current, new_status, actor["id"], None, ts),
        )
    except Exception:
        pass
    emit(c, order_id, typ, payload or {"from": current, "to": new_status}, actor["id"])
    _notify_order_status(c, order_id, new_status)
    return current, new_status


def transition(c: sqlite3.Connection, order_id: str, expected: str, new_status: str, actor: sqlite3.Row, typ: str, payload: dict[str, Any] | None = None) -> None:
    """Atomically advance an order state and record an audit event.

    The UPDATE includes the expected state in its WHERE clause so two concurrent
    workers cannot both successfully advance the same order from the same state.
    """
    if new_status not in ORDER_STATES.get(expected, set()):
        raise HTTPException(409, "Neplatný přechod stavu")
    o = c.execute("SELECT status FROM orders WHERE id=?", (order_id,)).fetchone()
    if not o:
        raise HTTPException(404, "Objednávka nenalezena")
    if o["status"] != expected:
        raise HTTPException(409, f"Objednávka je ve stavu {o['status']}, očekává se {expected}")
    ts = now()
    cur = c.execute(
        "UPDATE orders SET status=?, updated_at=? WHERE id=? AND status=?",
        (new_status, ts, order_id, expected),
    )
    if cur.rowcount != 1:
        raise HTTPException(409, "State transition conflict")
    try:
        c.execute(
            "INSERT INTO state_transition_audit VALUES (?,?,?,?,?,?,?,?)",
            ("sta_" + uuid.uuid4().hex[:12], "order", order_id, expected, new_status, actor["id"], None, ts),
        )
    except Exception:
        # Keep legacy/demo databases compatible if the audit table is absent;
        # the atomic state change itself remains authoritative.
        pass
    emit(c, order_id, typ, payload or {}, actor["id"])
    _notify_order_status(c, order_id, new_status)


class LoginIn(BaseModel):
    email: str
    password: str


class OrderItemIn(BaseModel):
    menu_item_id: str
    qty: int = Field(gt=0, le=20)


class OrderIn(BaseModel):
    items: list[OrderItemIn] = Field(default_factory=list)
    address: str = "Ostrava, Czechia"
    address_id: str | None = None
    note: str | None = Field(default=None, max_length=500)
    payment_method: str = Field(default="card_demo", pattern="^(card_demo|cash_demo)$")


class CartItemIn(BaseModel):
    menu_item_id: str
    qty: int = Field(gt=0, le=20)



class CartModifierIn(BaseModel):
    menu_item_id: str
    modifiers: list[dict[str, Any]] = Field(default_factory=list)
    note: str | None = Field(default=None, max_length=500)

class AddressIn(BaseModel):
    label: str = Field(min_length=1, max_length=40)
    street: str = Field(min_length=2, max_length=160)
    city: str = Field(min_length=2, max_length=80)
    postal_code: str | None = Field(default=None, max_length=20)
    lat: float = Field(ge=-90, le=90)
    lon: float = Field(ge=-180, le=180)
    is_default: bool = True

class CheckoutQuoteIn(BaseModel):
    address_id: str

class CustomerProfileIn(BaseModel):
    name: str = Field(min_length=2, max_length=120)
    email: str
    default_address: str = Field(min_length=4, max_length=250)


class TimingIn(BaseModel):
    prep_eta_minutes: int = Field(gt=0, le=180)
    promised_delivery_minutes: int = Field(gt=1, le=240)

class TimeoutIn(BaseModel):
    now_at: str | None = None
    force: bool = False


class MerchantCreateIn(BaseModel):
    name: str = Field(min_length=2, max_length=120)
    prep_minutes: int = Field(default=15, gt=0, le=120)


class CourierLocationIn(BaseModel):
    lat: float = Field(ge=-90, le=90)
    lon: float = Field(ge=-180, le=180)
    accuracy_m: float | None = Field(default=None, ge=0, le=5000)



@app.get("/")
def root() -> FileResponse:
    return FileResponse(BASE / "static" / "index.html")


@app.get("/api/health")
def health() -> dict[str, Any]:
    with core_db_connect() as c:
        count = c.execute("SELECT COUNT(*) n FROM orders").fetchone()["n"]
    return {"status": "ok", "version": app.version, "orders": count}


@app.post("/api/login")
def login(body: LoginIn) -> dict[str, Any]:
    # Legacy route retained for client compatibility, but authentication/session
    # storage is now fully delegated to the DB-neutral v1.34 repository.
    with core_db_connect() as db:
        tx = V132Transaction(db); tx.begin()
        try:
            repo = V134AuthRepository(db)
            user = repo.authenticate(body.email, body.password)
            token, _sid = repo.create_session(user["id"])
            tx.commit()
            return {"token": token, "user": {"id": user["id"], "name": user["name"], "role": user["role"]}}
        except Exception as exc:
            tx.rollback()
            if isinstance(exc, HTTPException):
                raise
            raise HTTPException(500, {"code": "V135_AUTH_REPOSITORY_FAILED"})


@app.post("/api/logout")
def logout(authorization: str | None = Header(default=None)) -> dict[str, str]:
    if authorization and authorization.startswith("Bearer "):
        token = v134_token(authorization)
        with core_db_connect() as db:
            tx = V132Transaction(db); tx.begin()
            try:
                repo = V134AuthRepository(db)
                user = repo.resolve(token)
                repo.revoke(token, user["id"])
                tx.commit()
            except Exception as exc:
                tx.rollback()
                if isinstance(exc, HTTPException):
                    raise
                raise HTTPException(500, {"code": "V135_SESSION_REVOKE_FAILED"})
    return {"status": "ok"}


@app.get("/api/me")
def me(authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u = current_user(authorization)
    return {"id": u["id"], "name": u["name"], "role": u["role"], "merchant_id": u["merchant_id"], "courier_id": u["courier_id"], "customer_id": u["customer_id"]}


@app.get("/api/customer/profile")
def customer_profile(authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u = current_user(authorization); require_role(u, "customer")
    with core_db_connect() as c:
        row = c.execute("SELECT * FROM customers WHERE id=?", (u["customer_id"],)).fetchone()
        return dict(row) if row else {}


@app.put("/api/customer/profile")
def update_customer_profile(body: CustomerProfileIn, authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u = current_user(authorization); require_role(u, "customer")
    with core_db_connect() as c:
        c.execute("UPDATE customers SET name=?, email=? WHERE id=?", (body.name, body.email, u["customer_id"]))
        emit(c, None, "customer_profile_updated", {"customer_id": u["customer_id"], "default_address": body.default_address}, u["id"])
        c.commit()
        return {"customer_id": u["customer_id"], "name": body.name, "email": body.email, "default_address": body.default_address}


@app.get("/api/cart")
def get_cart(authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u = current_user(authorization); require_role(u, "customer")
    with core_db_connect() as c:
        rows = c.execute("""
            SELECT ci.menu_item_id, ci.qty, ci.merchant_id, COALESCE(ci.menu_item_name_snapshot,mi.name) name, COALESCE(ci.unit_price_snapshot_czk,mi.price_czk) price_czk, m.name merchant_name
            FROM cart_items ci JOIN menu_items mi ON mi.id=ci.menu_item_id JOIN merchants m ON m.id=ci.merchant_id
            WHERE ci.customer_id=? ORDER BY mi.name
        """, (u["customer_id"],)).fetchall()
        merchants = {r["merchant_id"] for r in rows}
        if len(merchants) > 1:
            raise HTTPException(409, "Košík nesmí obsahovat více restaurací")
        total = round(sum(r["qty"]*r["price_czk"] for r in rows), 2)
        return {"merchant_id": next(iter(merchants), None), "items": [dict(r) for r in rows], "subtotal_czk": total}


@app.put("/api/cart")
def put_cart(body: CartItemIn, authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u = current_user(authorization); require_role(u, "customer")
    with core_db_connect() as c:
        item = c.execute("SELECT id, merchant_id FROM menu_items WHERE id=? AND active=1", (body.menu_item_id,)).fetchone()
        if not item: raise HTTPException(404, "Položka menu nenalezena")
        live = c.execute("SELECT publication_no,snapshot_sha256,snapshot_json FROM merchant_menu_publications WHERE merchant_id=? AND status='LIVE' ORDER BY publication_no DESC LIMIT 1", (item['merchant_id'],)).fetchone() if _db_table_exists(c,'merchant_menu_publications') else None
        if not live: raise HTTPException(409, "Restaurace zatím nemá publikované menu")
        live_snap=json.loads(live['snapshot_json'])
        live_item=next((x for x in live_snap.get('items',[]) if str(x.get('id'))==str(body.menu_item_id)),None)
        if not live_item: raise HTTPException(409, "Položka není součástí aktuálně publikovaného menu")
        if str((live_item.get('availability') or {}).get('state','AVAILABLE'))=='SOLD_OUT':
            raise HTTPException(409, "Položka je momentálně vyprodaná")
        existing = c.execute("SELECT 1 FROM cart_items WHERE customer_id=? LIMIT 1", (u["customer_id"],)).fetchone()
        if existing:
            mid = c.execute("SELECT merchant_id FROM cart_items WHERE customer_id=? LIMIT 1", (u["customer_id"],)).fetchone()["merchant_id"]
            if mid != item["merchant_id"]:
                raise HTTPException(409, "Košík může obsahovat položky jen z jedné restaurace")
        row = c.execute("SELECT id FROM cart_items WHERE customer_id=? AND menu_item_id=?", (u["customer_id"], body.menu_item_id)).fetchone()
        if row:
            c.execute("UPDATE cart_items SET qty=?,menu_publication_no=?,menu_snapshot_sha256=?,unit_price_snapshot_czk=?,menu_item_name_snapshot=? WHERE id=?",
                      (body.qty,int(live['publication_no']),live['snapshot_sha256'],float(live_item.get('price_czk',0)),live_item.get('name',''),row["id"]))
        else:
            c.execute("INSERT INTO cart_items(id,customer_id,merchant_id,menu_item_id,qty,menu_publication_no,menu_snapshot_sha256,unit_price_snapshot_czk,menu_item_name_snapshot) VALUES (?,?,?,?,?,?,?,?,?)",
                      (str(uuid.uuid4()),u["customer_id"],item["merchant_id"],body.menu_item_id,body.qty,int(live['publication_no']),live['snapshot_sha256'],float(live_item.get('price_czk',0)),live_item.get('name','')))
        c.execute("INSERT INTO customer_menu_integrity_audit VALUES (?,?,?,?,?,?,?,?,?)",
                  ('cmi_'+uuid.uuid4().hex[:12],u['customer_id'],item['merchant_id'],'CART_PINNED',int(live['publication_no']),live['snapshot_sha256'],'PASS',json.dumps({'menu_item_id':body.menu_item_id},ensure_ascii=False),now()))
        c.commit()
    return get_cart(authorization)


@app.delete("/api/cart/{menu_item_id}")
def delete_cart_item(menu_item_id: str, authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u = current_user(authorization); require_role(u, "customer")
    with core_db_connect() as c:
        c.execute("DELETE FROM cart_items WHERE customer_id=? AND menu_item_id=?", (u["customer_id"], menu_item_id)); c.commit()
    return get_cart(authorization)



@app.get("/api/customer/addresses")
def customer_addresses(authorization: str | None = Header(default=None)) -> list[dict[str, Any]]:
    u = current_user(authorization); require_role(u, "customer")
    with core_db_connect() as c:
        return [dict(r) for r in c.execute("SELECT * FROM customer_addresses WHERE customer_id=? ORDER BY is_default DESC, created_at DESC", (u["customer_id"],)).fetchall()]

@app.post("/api/customer/addresses")
def add_customer_address(body: AddressIn, authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u = current_user(authorization); require_role(u, "customer")
    aid="addr_"+uuid.uuid4().hex[:10]
    with core_db_connect() as c:
        if body.is_default:
            c.execute("UPDATE customer_addresses SET is_default=0 WHERE customer_id=?", (u["customer_id"],))
        c.execute("INSERT INTO customer_addresses VALUES (?,?,?,?,?,?,?,?,?,?)", (aid,u["customer_id"],body.label,body.street,body.city,body.postal_code,body.lat,body.lon,int(body.is_default),now()))
        emit(c,None,"customer_address_created",{"address_id":aid,"customer_id":u["customer_id"]},u["id"]); c.commit()
        return dict(c.execute("SELECT * FROM customer_addresses WHERE id=?",(aid,)).fetchone())

@app.put("/api/customer/addresses/{address_id}/default")
def set_customer_default_address(address_id: str, authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u = current_user(authorization); require_role(u, "customer")
    with core_db_connect() as c:
        row = c.execute("SELECT * FROM customer_addresses WHERE id=? AND customer_id=?", (address_id, u["customer_id"])).fetchone()
        if not row:
            raise HTTPException(404, "Adresa nenalezena")
        c.execute("UPDATE customer_addresses SET is_default=0 WHERE customer_id=?", (u["customer_id"],))
        c.execute("UPDATE customer_addresses SET is_default=1 WHERE id=? AND customer_id=?", (address_id, u["customer_id"]))
        emit(c, None, "customer_address_default_changed", {"address_id": address_id, "customer_id": u["customer_id"]}, u["id"]); c.commit()
        return dict(c.execute("SELECT * FROM customer_addresses WHERE id=?", (address_id,)).fetchone())

@app.delete("/api/customer/addresses/{address_id}")
def delete_customer_address(address_id: str, authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u = current_user(authorization); require_role(u, "customer")
    with core_db_connect() as c:
        row = c.execute("SELECT * FROM customer_addresses WHERE id=? AND customer_id=?", (address_id, u["customer_id"])).fetchone()
        if not row:
            raise HTTPException(404, "Adresa nenalezena")
        refs_row = c.execute("SELECT COUNT(*) AS n FROM orders WHERE address_id=?", (address_id,)).fetchone()
        refs = int(refs_row["n"]) if refs_row else 0
        if refs:
            raise HTTPException(409, "Adresu nelze smazat, používá ji existující objednávka")
        was_default = bool(row["is_default"])
        c.execute("DELETE FROM customer_addresses WHERE id=? AND customer_id=?", (address_id, u["customer_id"]))
        if was_default:
            fallback = c.execute("SELECT id FROM customer_addresses WHERE customer_id=? ORDER BY created_at DESC LIMIT 1", (u["customer_id"],)).fetchone()
            if fallback:
                c.execute("UPDATE customer_addresses SET is_default=1 WHERE id=?", (fallback["id"],))
        emit(c, None, "customer_address_deleted", {"address_id": address_id, "customer_id": u["customer_id"]}, u["id"]); c.commit()
        return {"deleted": True, "address_id": address_id}

@app.get("/api/checkout/quote")
def checkout_quote(address_id: str, authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u=current_user(authorization); require_role(u,"customer")
    with core_db_connect() as c:
        rows=c.execute("""SELECT ci.menu_item_id,ci.qty,ci.merchant_id,mi.price_czk,ci.menu_publication_no,ci.menu_snapshot_sha256,ci.unit_price_snapshot_czk
                             FROM cart_items ci JOIN menu_items mi ON mi.id=ci.menu_item_id WHERE ci.customer_id=?""",(u["customer_id"],)).fetchall()
        if not rows: raise HTTPException(400,"Košík je prázdný")
        merchant_ids={r["merchant_id"] for r in rows}
        if len(merchant_ids)!=1: raise HTTPException(409,"Košík může obsahovat jen jednu restauraci")
        merchant_id=next(iter(merchant_ids))
        live=_v138_live_publication(c,merchant_id)
        if not live: raise HTTPException(409,"Restaurace zatím nemá publikované menu")
        snap=json.loads(live["snapshot_json"]); live_items={str(x.get('id')):x for x in snap.get('items',[])}
        issues=[]
        snapshot_rows=[]
        for r in rows:
            li=live_items.get(str(r['menu_item_id']))
            if not li:
                issues.append({'code':'ITEM_REMOVED','menu_item_id':r['menu_item_id']})
                continue
            if str((li.get('availability') or {}).get('state','AVAILABLE'))=='SOLD_OUT':
                issues.append({'code':'ITEM_SOLD_OUT','menu_item_id':r['menu_item_id']})
            if r['menu_publication_no'] is None or int(r['menu_publication_no'])!=int(live['publication_no']) or r['menu_snapshot_sha256']!=live['snapshot_sha256']:
                issues.append({'code':'PUBLICATION_CHANGED','menu_item_id':r['menu_item_id'],'cart_publication_no':r['menu_publication_no'],'live_publication_no':int(live['publication_no'])})
            snapshot_rows.append((float(li.get('price_czk',0)),int(r['qty'])))
        if issues:
            c.execute("INSERT INTO customer_menu_integrity_audit VALUES (?,?,?,?,?,?,?,?,?)",
                      ('cmi_'+uuid.uuid4().hex[:12],u['customer_id'],merchant_id,'QUOTE_BLOCKED',int(live['publication_no']),live['snapshot_sha256'],'FAIL',json.dumps({'issues':issues},ensure_ascii=False),now())); c.commit()
            raise HTTPException(409,{'code':'MENU_CHANGED_REQUOTE','message':'Menu se změnilo. Aktualizujte košík před checkoutem.','issues':issues,'live_publication_no':int(live['publication_no']),'live_snapshot_sha256':live['snapshot_sha256']})
        subtotal=round(sum(price*qty for price,qty in snapshot_rows),2)
        q=pricing_for_cart(c,u['customer_id'],merchant_id,subtotal,address_id)
        q.update({'merchant_id':merchant_id,'address_id':address_id,'menu_publication_no':int(live['publication_no']),'menu_snapshot_sha256':live['snapshot_sha256'],'pricing_consistency':'LIVE_SNAPSHOT_PINNED'})
        c.execute("INSERT INTO customer_menu_integrity_audit VALUES (?,?,?,?,?,?,?,?,?)",
                  ('cmi_'+uuid.uuid4().hex[:12],u['customer_id'],merchant_id,'QUOTE_PINNED',int(live['publication_no']),live['snapshot_sha256'],'PASS',json.dumps({'subtotal_czk':subtotal},ensure_ascii=False),now())); c.commit()
        return q

