# ---------------- v1.40 Payment Intent Lock ----------------
def _v140_get_quote(c, quote_id, customer_id):
    q=c.execute("SELECT * FROM checkout_quotes WHERE id=? AND customer_id=?",(quote_id,customer_id)).fetchone()
    if not q: raise HTTPException(404,"Checkout quote nenalezen")
    if q['status']!='confirmed': raise HTTPException(409,"Quote ještě není potvrzen do objednávky")
    if not q['confirmed_order_id']: raise HTTPException(409,"Quote nemá navázanou objednávku")
    return q

@app.post('/api/v140/payment/intent-lock')
def v140_payment_intent_lock(body:dict[str,Any], authorization:str|None=Header(default=None), idempotency_key:str|None=Header(default=None,alias='Idempotency-Key')):
    u=current_user(authorization); require_role(u,'customer')
    quote_id=str(body.get('quote_id') or '').strip()
    if not quote_id: raise HTTPException(400,'quote_id je povinné')
    with core_db_connect() as c:
        cached=_v052_guard(c,f'payment-intent-v140:{u["id"]}',idempotency_key,{'quote_id':quote_id})
        if cached is not None:
            cached = dict(cached)
            cached['idempotent_reuse']=True
            return cached
        q=_v140_get_quote(c,quote_id,u['customer_id'])
        o=c.execute('SELECT * FROM orders WHERE id=? AND customer_id=?',(q['confirmed_order_id'],u['customer_id'])).fetchone()
        if not o: raise HTTPException(404,'Objednávka nenalezena')
        if round(float(o['total_czk']),2)!=round(float(q['total_czk']),2):
            raise HTTPException(409,{'code':'ORDER_QUOTE_AMOUNT_MISMATCH','message':'Objednávka neodpovídá quote'})
        existing=c.execute('SELECT * FROM payment_intents WHERE order_id=?',(o['id'],)).fetchone()
        if existing:
            # Backfill lock metadata for legacy intent only when exact match is provable.
            locked_amt=existing['locked_amount_czk']
            if locked_amt is not None and round(float(locked_amt),2)!=round(float(q['total_czk']),2):
                raise HTTPException(409,{'code':'PAYMENT_LOCK_MISMATCH','message':'Existující payment intent má jinou částku'})
            result={'schema_version':'1.140','payment_intent_id':existing['id'],'order_id':o['id'],'quote_id':quote_id,
                    'quote_hash':q['quote_hash'],'status':existing['status'],'amount_czk':float(q['total_czk']),'currency':'CZK',
                    'menu_publication_no':int(q['menu_publication_no']),'menu_snapshot_sha256':q['menu_snapshot_sha256'],'idempotent_reuse':True}
            _v052_store(c,f'payment-intent-v140:{u["id"]}',idempotency_key,{'quote_id':quote_id},result); c.commit(); return result
        pid='pi140_'+uuid.uuid4().hex[:12]; provider_id='wunoo_v140_'+uuid.uuid4().hex[:12]
        inserted=False
        try:
            c.execute("SAVEPOINT v140_payment_intent_insert")
            c.execute('''INSERT INTO payment_intents
                (id,order_id,amount_czk,currency,status,provider,provider_intent_id,created_at,updated_at,quote_id,quote_hash,locked_amount_czk,locked_currency,menu_publication_no,menu_snapshot_sha256)
                VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)''',
                (pid,o['id'],q['total_czk'],'CZK','requires_payment_method','demo',provider_id,now(),now(),quote_id,q['quote_hash'],q['total_czk'],'CZK',q['menu_publication_no'],q['menu_snapshot_sha256']))
            c.execute("RELEASE SAVEPOINT v140_payment_intent_insert")
            inserted=True
        except Exception:
            try: c.execute("ROLLBACK TO SAVEPOINT v140_payment_intent_insert")
            finally:
                try: c.execute("RELEASE SAVEPOINT v140_payment_intent_insert")
                except Exception: pass
            # Another request may have won the unique order_id race.
            existing=c.execute('SELECT * FROM payment_intents WHERE order_id=?',(o['id'],)).fetchone()
            if not existing:
                raise
            if existing['quote_id'] and str(existing['quote_id'])!=str(quote_id):
                raise HTTPException(409,{'code':'PAYMENT_ORDER_ALREADY_LOCKED','message':'Objednávka je již svázaná s jiným quote'})
            if round(float(existing['amount_czk']),2)!=round(float(q['total_czk']),2):
                raise HTTPException(409,{'code':'PAYMENT_LOCK_MISMATCH','message':'Existující payment intent má jinou částku'})
            result={'schema_version':'1.140','payment_intent_id':existing['id'],'order_id':o['id'],'quote_id':quote_id,
                    'quote_hash':q['quote_hash'],'status':existing['status'],'amount_czk':float(existing['amount_czk']),'currency':existing['currency'] or 'CZK',
                    'menu_publication_no':int(q['menu_publication_no']),'menu_snapshot_sha256':q['menu_snapshot_sha256'],'idempotent_reuse':True}
            try: _v052_store(c,f'payment-intent-v140:{u["id"]}',idempotency_key,{'quote_id':quote_id},result); c.commit()
            except Exception:
                c.rollback()
            return result
        _v052_audit(c,u['id'],'payment_intent_lock','order',o['id'],{'quote_id':quote_id,'quote_hash':q['quote_hash'],'amount_czk':q['total_czk']})
        emit(c,o['id'],'payment_intent_locked',{'payment_intent_id':pid,'quote_id':quote_id,'quote_hash':q['quote_hash'],'amount_czk':q['total_czk'],'menu_publication_no':q['menu_publication_no']},u['id'])
        result={'schema_version':'1.140','payment_intent_id':pid,'order_id':o['id'],'quote_id':quote_id,'quote_hash':q['quote_hash'],'status':'requires_payment_method','amount_czk':float(q['total_czk']),'currency':'CZK','menu_publication_no':int(q['menu_publication_no']),'menu_snapshot_sha256':q['menu_snapshot_sha256'],'idempotent_reuse':False}
        try:
            _v052_store(c,f'payment-intent-v140:{u["id"]}',idempotency_key,{'quote_id':quote_id},result)
        except sqlite3.IntegrityError:
            # Concurrent identical request won the idempotency row race.
            cached=_v052_guard(c,f'payment-intent-v140:{u["id"]}',idempotency_key,{'quote_id':quote_id})
            if cached is not None:
                result=dict(cached)
                result['idempotent_reuse']=True
            else:
                raise
        c.commit(); return result

@app.post('/api/v140/payment/webhook')
async def v140_payment_webhook(request:Request, x_wunoo_signature:str|None=Header(default=None,alias='X-WUNOO-Signature')):
    raw=await request.body(); _verify_webhook_signature(raw,x_wunoo_signature,required=True)
    try: body=json.loads(raw.decode('utf-8'))
    except Exception: raise HTTPException(400,'Neplatné JSON tělo webhooku')
    provider_event_id=str(body.get('id','')); event_type=str(body.get('type','')); intent_id=str(body.get('payment_intent_id',''))
    provider_amount=body.get('amount_czk',body.get('amount')); provider_currency=str(body.get('currency','CZK'))
    if not provider_event_id or not event_type or not intent_id: raise HTTPException(400,'Webhook id, type a payment_intent_id jsou povinné')
    if event_type not in {'payment_succeeded','payment_failed','payment_cancelled'}: raise HTTPException(400,'Nepodporovaný payment event')
    with core_db_connect() as c:
        exists=c.execute('SELECT * FROM payment_webhook_events WHERE provider_event_id=?',(provider_event_id,)).fetchone()
        if exists:return {'accepted':True,'duplicate':True,'status':exists['status']}
        pi=c.execute('SELECT * FROM payment_intents WHERE id=?',(intent_id,)).fetchone()
        if not pi: raise HTTPException(404,'Payment intent nenalezen')
        locked=float(pi['locked_amount_czk'] if pi['locked_amount_czk'] is not None else pi['amount_czk'])
        currency=pi['locked_currency'] or pi['currency'] or 'CZK'
        if provider_amount is not None and round(float(provider_amount),2)!=round(locked,2):
            raise HTTPException(409,{'code':'PAYMENT_AMOUNT_MISMATCH','message':'Webhook částka neodpovídá locked payment intent','expected_amount_czk':locked,'received_amount_czk':float(provider_amount)})
        if provider_currency!=currency:
            raise HTTPException(409,{'code':'PAYMENT_CURRENCY_MISMATCH','message':'Webhook měna neodpovídá locked payment intent','expected_currency':currency,'received_currency':provider_currency})
        # Ensure quote/order amount has not drifted before accepting terminal success.
        if pi['quote_id']:
            q=c.execute('SELECT * FROM checkout_quotes WHERE id=?',(pi['quote_id'],)).fetchone()
            if not q or round(float(q['total_czk']),2)!=round(locked,2):
                raise HTTPException(409,{'code':'PAYMENT_QUOTE_MISMATCH','message':'Quote částka neodpovídá locked payment intent'})
        wid='pwh140_'+uuid.uuid4().hex[:12]
        c.execute('''INSERT INTO payment_webhook_events
                     (id,provider_event_id,event_type,payload_json,status,processed_at,created_at)
                     VALUES (?,?,?,?,?,?,?)''',(wid,provider_event_id,event_type,json.dumps(body,ensure_ascii=False),'received',None,now()))
        current=str(pi['status'])
        terminal={'payment_succeeded':'succeeded','payment_failed':'failed','payment_cancelled':'cancelled'}[event_type]
        if current=='succeeded' and terminal!='succeeded':
            c.execute('UPDATE payment_webhook_events SET status=?,processed_at=? WHERE id=?',('ignored',now(),wid)); c.commit(); return {'accepted':True,'duplicate':False,'ignored':True,'reason':'ALREADY_SUCCEEDED'}
        c.execute('UPDATE payment_intents SET status=?,updated_at=? WHERE id=?',(terminal,now(),intent_id))
        actor={'id':'system:payment_webhook_v140'}
        if terminal=='succeeded': transition(c,pi['order_id'],'payment_pending','merchant_pending',actor,'payment_succeeded',{'payment_intent_id':intent_id,'quote_hash':pi['quote_hash'],'locked_amount_czk':locked})
        elif terminal=='failed': transition(c,pi['order_id'],'payment_pending','payment_failed',actor,'payment_failed',{'payment_intent_id':intent_id})
        else: transition(c,pi['order_id'],'payment_pending','payment_cancelled',actor,'payment_cancelled',{'payment_intent_id':intent_id})
        c.execute('UPDATE payment_webhook_events SET status=?,processed_at=? WHERE id=?',('processed',now(),wid))
        emit(c,pi['order_id'],'payment_lock_verified',{'payment_intent_id':intent_id,'event_type':event_type,'locked_amount_czk':locked,'currency':currency},actor['id'])
        c.commit(); return {'accepted':True,'duplicate':False,'event_type':event_type,'payment_intent_id':intent_id,'locked_amount_czk':locked,'currency':currency}

@app.get('/api/v140/payment/{payment_intent_id}')
def v140_payment_get(payment_intent_id:str, authorization:str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'customer','admin','ops_agent'})
    with core_db_connect() as c:
        p=c.execute('''SELECT pi.*,o.customer_id,o.total_czk,o.status order_status FROM payment_intents pi JOIN orders o ON o.id=pi.order_id WHERE pi.id=?''',(payment_intent_id,)).fetchone()
        if not p: raise HTTPException(404,'Payment intent nenalezen')
        if u['role']=='customer' and p['customer_id']!=u['customer_id']: raise HTTPException(403,'forbidden')
        return {'schema_version':'1.140','payment':dict(p)}


# ---------------- WUNOO v1.201: Global Release Closure Verification Lock ----------------
def migrate_v201(c):
    c.execute("""CREATE TABLE IF NOT EXISTS production_release_closure_verifications(
        id TEXT PRIMARY KEY, closure_id TEXT NOT NULL, release_version TEXT NOT NULL,
        decision TEXT NOT NULL, gate_status TEXT NOT NULL, verification_json TEXT NOT NULL DEFAULT '{}',
        verification_sha256 TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_v201_closure_time ON production_release_closure_verifications(created_at DESC)")
    c.execute("CREATE INDEX IF NOT EXISTS idx_v201_closure_id ON production_release_closure_verifications(closure_id)")
    try: c.commit()
    except Exception: pass

_V201_POLICY={
    'schema_version':'1.201','purpose':'verify_v1_200_release_closure_is_self_consistent_and_still_current',
    'required_v200_decision':'GO','required_v200_gate_status':'SEALED','require_operator_confirmed':True,
    'require_manifest_current':True,'require_finality_current':True,'fail_closed':True,'automatic_release':False,
}

def _v201_json_hash(obj):
    return hashlib.sha256(json.dumps(obj,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()).hexdigest()

def _v201_reconstruct_v200_evidence(row):
    try: snapshot=json.loads(row['snapshot_json'] or '{}')
    except Exception: return {'valid':False,'reason':'V200_SNAPSHOT_INVALID'}
    evaluation=_v200_evaluate(snapshot)
    body={'snapshot':snapshot,'evaluation':evaluation,'operator':row['operator']}
    expected=_v201_json_hash(body)
    ok=expected==str(row['evidence_sha256'])
    return {'valid':ok,'snapshot':snapshot,'evaluation':evaluation,'recomputed_evidence_sha256':expected,
            'stored_evidence_sha256':row['evidence_sha256'],'reason':None if ok else 'V200_EVIDENCE_HASH_MISMATCH'}

def _v201_verify_latest_closure(c):
    try: closure=c.execute('SELECT * FROM production_release_closure_gates ORDER BY created_at DESC LIMIT 1').fetchone()
    except Exception: return {'valid':False,'reason':'V200_CLOSURE_TABLE_UNAVAILABLE'}
    if not closure: return {'valid':False,'reason':'NO_V200_CLOSURE'}
    r=dict(closure)
    if str(r.get('decision'))!=_V201_POLICY['required_v200_decision']: return {'valid':False,'reason':'V200_DECISION_NOT_GO','closure_id':r.get('id')}
    if str(r.get('gate_status'))!=_V201_POLICY['required_v200_gate_status']: return {'valid':False,'reason':'V200_GATE_NOT_SEALED','closure_id':r.get('id')}
    if int(r.get('operator_confirmed') or 0)!=1: return {'valid':False,'reason':'V200_OPERATOR_NOT_CONFIRMED','closure_id':r.get('id')}
    ev=_v201_reconstruct_v200_evidence(r)
    if not ev['valid']: ev['closure_id']=r.get('id'); return ev
    snap=ev['snapshot']
    if not snap.get('production_environment'): return {'valid':False,'reason':'V200_NOT_PRODUCTION','closure_id':r.get('id')}
    manifest=snap.get('manifest') or {}
    if not manifest.get('valid'): return {'valid':False,'reason':'V200_MANIFEST_INVALID','closure_id':r.get('id')}
    try: current_manifest=c.execute('SELECT id,release_version,manifest_sha256 FROM production_release_manifests ORDER BY created_at DESC LIMIT 1').fetchone()
    except Exception: return {'valid':False,'reason':'MANIFEST_TABLE_UNAVAILABLE','closure_id':r.get('id')}
    if not current_manifest: return {'valid':False,'reason':'NO_CURRENT_MANIFEST','closure_id':r.get('id')}
    if str(current_manifest['id'])!=str(manifest.get('manifest_id')) or str(current_manifest['manifest_sha256'])!=str(manifest.get('manifest_sha256')):
        return {'valid':False,'reason':'MANIFEST_CHANGED_AFTER_CLOSURE','closure_id':r.get('id'),'closure_manifest_id':manifest.get('manifest_id'),'current_manifest_id':current_manifest['id']}
    try: finals=c.execute('SELECT id FROM production_global_finality_checkpoint_federation_finality ORDER BY created_at,id').fetchall()
    except Exception: return {'valid':False,'reason':'V199_FINALITY_TABLE_UNAVAILABLE','closure_id':r.get('id')}
    finality=snap.get('global_finality') or {}
    if not finality.get('valid') or not finals: return {'valid':False,'reason':'GLOBAL_FINALITY_NOT_CURRENT','closure_id':r.get('id')}
    if str(finals[-1]['id'])!=str(finality.get('latest_id')) or len(finals)!=int(finality.get('count') or -1):
        return {'valid':False,'reason':'FINALITY_CHANGED_AFTER_CLOSURE','closure_id':r.get('id'),'closure_latest_id':finality.get('latest_id'),'current_latest_id':finals[-1]['id']}
    return {'valid':True,'closure_id':r.get('id'),'release_version':r.get('release_version'),'evidence_sha256':r.get('evidence_sha256'),
            'manifest_id':manifest.get('manifest_id'),'manifest_sha256':manifest.get('manifest_sha256'),'finality_latest_id':finality.get('latest_id'),
            'finality_count':finality.get('count'),'reconstructed_evaluation':ev['evaluation']}

def _v201_verify_and_record(c, operator='system:v201'):
    result=_v201_verify_latest_closure(c); digest=_v201_json_hash(result)
    if result.get('valid'):
        rid='verify_'+uuid.uuid4().hex[:16]
        c.execute('INSERT INTO production_release_closure_verifications(id,closure_id,release_version,decision,gate_status,verification_json,verification_sha256,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?)',
                  (rid,result['closure_id'],result.get('release_version') or '',_V201_POLICY['required_v200_decision'],_V201_POLICY['required_v200_gate_status'],json.dumps(result,sort_keys=True,separators=(',',':'),ensure_ascii=False),digest,now(),operator)); c.commit()
        result['verification_id']=rid; result['verification_sha256']=digest
    return result

@app.get('/api/v201/ops/release-closure-verification/policy')
def v201_policy(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); return _V201_POLICY

@app.post('/api/v201/ops/release-closure-verification/run')
def v201_run(payload: dict[str,Any]|None=None, authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); operator=str(u.get('email') or u.get('id') or 'operator')
    with core_db_connect() as c: result=_v201_verify_and_record(c,operator)
    if not result.get('valid'): raise HTTPException(409,result.get('reason','V201_VERIFICATION_FAILED'))
    return {'schema_version':'1.201','verification':result}

@app.get('/api/v201/ops/release-closure-verification/latest')
def v201_latest(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c: row=c.execute('SELECT * FROM production_release_closure_verifications ORDER BY created_at DESC LIMIT 1').fetchone()
    if not row: raise HTTPException(404,'v201 verification nenalezena')
    return {'schema_version':'1.201','verification':dict(row),'policy':_V201_POLICY}

# ---------------- WUNOO v1.202: External Release Closure Anchor & Chain Verification ----------------
def migrate_v202(c):
    c.execute("""CREATE TABLE IF NOT EXISTS production_release_closure_anchors(
        id TEXT PRIMARY KEY, closure_id TEXT NOT NULL, verification_id TEXT NOT NULL,
        release_version TEXT NOT NULL, sequence_no INTEGER NOT NULL,
        prior_anchor_sha256 TEXT NOT NULL DEFAULT '', anchor_payload_json TEXT NOT NULL DEFAULT '{}',
        anchor_sha256 TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT
    )""")
    c.execute("CREATE UNIQUE INDEX IF NOT EXISTS ux_v202_anchor_seq ON production_release_closure_anchors(sequence_no)")
    c.execute("CREATE INDEX IF NOT EXISTS idx_v202_anchor_time ON production_release_closure_anchors(created_at DESC)")
    try: c.commit()
    except Exception: pass

_V202_POLICY={
    'schema_version':'1.202','purpose':'append_only_release_closure_anchor_chain_with_external_digest_binding',
    'requires_v201_verification':True,'requires_v201_valid':True,'hash':'SHA-256',
    'sequence_starts_at':1,'fail_closed':True,'external_anchor_env':'WUNOO_V202_EXPECTED_ANCHOR_SHA256',
    'automatic_release':False,
}

def _v202_hash(v):
    return hashlib.sha256(json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()).hexdigest()

def _v202_anchor_payload(verification, sequence_no, prior_anchor_sha256):
    return {'schema_version':'1.202','sequence_no':int(sequence_no),'prior_anchor_sha256':str(prior_anchor_sha256 or ''),
            'verification_id':str(verification.get('verification_id') or ''),'closure_id':str(verification.get('closure_id') or ''),
            'release_version':str(verification.get('release_version') or ''),'verification_sha256':str(verification.get('verification_sha256') or '')}

def _v202_production():
    return os.getenv('WUNOO_ENV','development').strip().lower() in {'prod','production','staging'}

def _v202_verify_chain(c):
    try: rows=c.execute('SELECT * FROM production_release_closure_anchors ORDER BY sequence_no').fetchall()
    except Exception: return {'valid':False,'reason':'V202_ANCHOR_TABLE_UNAVAILABLE'}
    expected_seq=1; prior=''; verified=[]
    for row in rows:
        r=dict(row)
        if int(r.get('sequence_no') or -1)!=expected_seq: return {'valid':False,'reason':'ANCHOR_SEQUENCE_GAP','sequence_no':r.get('sequence_no')}
        try: payload=json.loads(r.get('anchor_payload_json') or '{}')
        except Exception: return {'valid':False,'reason':'ANCHOR_PAYLOAD_INVALID','sequence_no':expected_seq}
        if str(payload.get('prior_anchor_sha256') or '')!=prior: return {'valid':False,'reason':'ANCHOR_PREDECESSOR_MISMATCH','sequence_no':expected_seq}
        digest=_v202_hash(payload)
        if digest!=str(r.get('anchor_sha256') or ''): return {'valid':False,'reason':'ANCHOR_HASH_MISMATCH','sequence_no':expected_seq}
        if str(payload.get('verification_id') or '')!=str(r.get('verification_id') or '') or str(payload.get('closure_id') or '')!=str(r.get('closure_id') or ''):
            return {'valid':False,'reason':'ANCHOR_BINDING_MISMATCH','sequence_no':expected_seq}
        prior=digest; verified.append({'sequence_no':expected_seq,'id':r.get('id'),'anchor_sha256':digest}); expected_seq+=1
    latest=verified[-1] if verified else None; ext=os.getenv(_V202_POLICY['external_anchor_env'],'').strip().lower()
    external_ok=(not _v202_production()) or (bool(ext) and bool(latest) and hmac.compare_digest(ext,str(latest['anchor_sha256']).lower()))
    return {'valid':bool(verified) and external_ok,'count':len(verified),'latest':latest,'external_anchor_configured':bool(ext),'external_anchor_match':external_ok,
            'reason':None if verified and external_ok else ('NO_ANCHOR' if not verified else 'EXTERNAL_ANCHOR_MISMATCH')}

def _v202_latest_v201(c):
    try: row=c.execute('SELECT * FROM production_release_closure_verifications ORDER BY created_at DESC,id DESC LIMIT 1').fetchone()
    except Exception: return {'valid':False,'reason':'V201_TABLE_UNAVAILABLE'}
    if not row: return {'valid':False,'reason':'NO_V201_VERIFICATION'}
    r=dict(row)
    try: detail=json.loads(r.get('verification_json') or '{}')
    except Exception: return {'valid':False,'reason':'V201_VERIFICATION_JSON_INVALID'}
    digest=_v201_json_hash(detail)
    if digest!=str(r.get('verification_sha256') or ''): return {'valid':False,'reason':'V201_VERIFICATION_HASH_MISMATCH'}
    if not detail.get('valid') or str(r.get('decision'))!='GO' or str(r.get('gate_status'))!='SEALED': return {'valid':False,'reason':'V201_NOT_VALID'}
    detail=dict(detail); detail['verification_id']=r.get('id'); detail['verification_sha256']=r.get('verification_sha256'); return {'valid':True,'verification':detail}

def _v202_anchor(c, operator='system:v202'):
    base=_v202_latest_v201(c)
    if not base.get('valid'): return {'valid':False,'reason':base.get('reason')}
    verification=base['verification']; last=c.execute('SELECT sequence_no,anchor_sha256 FROM production_release_closure_anchors ORDER BY sequence_no DESC LIMIT 1').fetchone()
    seq=(int(last['sequence_no'])+1) if last else 1; prior=str(last['anchor_sha256']) if last else ''
    payload=_v202_anchor_payload(verification,seq,prior); digest=_v202_hash(payload); rid='anchor_'+uuid.uuid4().hex[:16]
    c.execute('INSERT INTO production_release_closure_anchors(id,closure_id,verification_id,release_version,sequence_no,prior_anchor_sha256,anchor_payload_json,anchor_sha256,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?)',
              (rid,verification['closure_id'],verification['verification_id'],verification.get('release_version') or '',seq,prior,json.dumps(payload,sort_keys=True,separators=(',',':'),ensure_ascii=False),digest,now(),operator)); c.commit()
    return {'valid':True,'anchor_id':rid,'sequence_no':seq,'anchor_sha256':digest,'prior_anchor_sha256':prior,'verification_id':verification['verification_id'],'closure_id':verification['closure_id'],'release_version':verification.get('release_version')}

# ---------------- WUNOO v1.200: Global Release Closure & Audit Seal ----------------
def migrate_v200(c):
    c.execute("""CREATE TABLE IF NOT EXISTS production_release_closure_gates(
        id TEXT PRIMARY KEY, release_version TEXT NOT NULL, decision TEXT NOT NULL,
        gate_status TEXT NOT NULL, snapshot_json TEXT NOT NULL DEFAULT '{}',
        evidence_sha256 TEXT NOT NULL, operator_confirmed INTEGER NOT NULL DEFAULT 0,
        operator TEXT, created_at TEXT NOT NULL
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_v200_closure_time ON production_release_closure_gates(created_at DESC)")
    c.execute("CREATE INDEX IF NOT EXISTS idx_v200_closure_release ON production_release_closure_gates(release_version,created_at DESC)")
    try: c.commit()
    except Exception: pass

_V200_POLICY={
    'schema_version':'1.200',
    'required_finality_version':'1.99',
    'required_manifest_version':'1.68',
    'required_signing_version':'1.69',
    'hash':'SHA-256',
    'decision_states':['GO','HOLD','BLOCKED'],
    'operator_confirmation_required':True,
    'production_environment_required':True,
    'all_global_finalities_must_verify':True,
    'at_least_one_global_finality_required':True,
    'automatic_release':False,
    'automatic_restore':False,
    'fail_closed':True,
}

def _v200_hash(v):
    return hashlib.sha256(json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()).hexdigest()

def _v200_verify_manifest(c):
    try:
        row=c.execute('SELECT * FROM production_release_manifests ORDER BY created_at DESC LIMIT 1').fetchone()
    except Exception:
        return {'found':False,'valid':False,'reason':'MANIFEST_TABLE_UNAVAILABLE'}
    if not row:
        return {'found':False,'valid':False,'reason':'NO_RELEASE_MANIFEST'}
    try:
        obj=json.loads(row['manifest_json'] or '{}')
        digest=_v168_sha(obj)
        valid=(digest==row['manifest_sha256'])
        return {'found':True,'valid':valid,'release_version':row['release_version'],'manifest_id':row['id'],'manifest_sha256':row['manifest_sha256'],'recomputed_sha256':digest,'reason':None if valid else 'MANIFEST_HASH_MISMATCH'}
    except Exception:
        return {'found':True,'valid':False,'reason':'MANIFEST_INVALID'}

def _v200_verify_global_finality(c):
    try:
        rows=c.execute('SELECT * FROM production_global_finality_checkpoint_federation_finality ORDER BY created_at,id').fetchall()
    except Exception:
        return {'available':False,'valid':False,'count':0,'reason':'V199_FINALITY_TABLE_UNAVAILABLE'}
    if not rows:
        return {'available':True,'valid':False,'count':0,'reason':'NO_GLOBAL_FINALITY'}
    failures=[]
    for row in rows:
        vr=_v199_verify_finality(c,row)
        if not vr.get('valid'): failures.append({'id':row['id'],'reason':vr.get('reason')})
    return {'available':True,'valid':not failures,'count':len(rows),'latest_id':rows[-1]['id'],'failures':failures[:20],
            'reason':None if not failures else 'GLOBAL_FINALITY_VERIFICATION_FAILED'}

def _v200_collect(c, release_version=None):
    version=str(release_version or os.getenv('WUNOO_RELEASE_VERSION') or '1.200')
    prod=_v146_production_env()
    manifest=_v200_verify_manifest(c)
    finality=_v200_verify_global_finality(c)
    blockers=[]
    if prod and not manifest['valid']: blockers.append('manifest_not_verified')
    if not finality['valid']: blockers.append('global_finality_not_verified')
    # The closure gate is deliberately conservative: downstream signing/release automation
    # must never infer GO from a partial chain. The caller must also explicitly confirm.
    return {'schema_version':'1.200','release_version':version,'production_environment':prod,
            'manifest':manifest,'global_finality':finality,'blocking_reasons':blockers}

def _v200_evaluate(snapshot):
    blockers=list(snapshot.get('blocking_reasons') or [])
    if not snapshot.get('production_environment'):
        return {'decision':'HOLD','gate_status':'NON_PRODUCTION','release_allowed':False,'reason':'production environment is required for release closure'}
    if blockers:
        return {'decision':'BLOCKED','gate_status':'INCOMPLETE','release_allowed':False,'reason':';'.join(blockers)}
    return {'decision':'GO','gate_status':'SEALED','release_allowed':True,'reason':'global finality and release manifest integrity verified'}

@app.get('/api/v200/ops/release-closure/policy')
def v200_policy(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); return _V200_POLICY

@app.post('/api/v200/ops/release-closure/evaluate')
def v200_evaluate(payload: dict[str,Any]|None=None, authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); payload=payload or {}
    with core_db_connect() as c:
        snap=_v200_collect(c,payload.get('release_version')); ev=_v200_evaluate(snap)
    return {'schema_version':'1.200','snapshot':snap,'evaluation':ev,'evidence_sha256':_v200_hash({'snapshot':snap,'evaluation':ev})}

@app.post('/api/v200/ops/release-closure/seal')
def v200_seal(payload: dict[str,Any]|None=None, authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin'}); payload=payload or {}; operator=str(u.get('email') or u.get('id') or 'operator')
    if not bool(payload.get('operator_confirmed',False)):
        raise HTTPException(409,'operator confirmation required')
    with core_db_connect() as c:
        snap=_v200_collect(c,payload.get('release_version')); ev=_v200_evaluate(snap)
        body={'snapshot':snap,'evaluation':ev,'operator':operator}
        digest=_v200_hash(body)
        rid='closure_'+uuid.uuid4().hex[:16]
        c.execute('INSERT INTO production_release_closure_gates(id,release_version,decision,gate_status,snapshot_json,evidence_sha256,operator_confirmed,operator,created_at) VALUES(?,?,?,?,?,?,?,?,?)',
                  (rid,snap['release_version'],ev['decision'],ev['gate_status'],json.dumps(snap,sort_keys=True),digest,1,operator,now()))
        c.commit()
    if ev['decision']!='GO':
        raise HTTPException(409,ev['reason'])
    return {'schema_version':'1.200','closure_id':rid,'decision':ev['decision'],'gate_status':ev['gate_status'],'evidence_sha256':digest}

@app.get('/api/v200/ops/release-closure/latest')
def v200_latest(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c: row=c.execute('SELECT * FROM production_release_closure_gates ORDER BY created_at DESC LIMIT 1').fetchone()
    if not row: raise HTTPException(404,'release closure nenalezen')
    return {'schema_version':'1.200','closure':dict(row),'policy':_V200_POLICY}

