@app.post("/api/customer/notifications/{notification_id}/read")
def mark_notification_read(notification_id: str, authorization: str | None = Header(default=None)):
    u=current_user(authorization); require_role(u,"customer")
    with core_db_connect() as c:
        n=c.execute("UPDATE notifications SET read_at=? WHERE id=? AND customer_id=? AND read_at IS NULL",(now(),notification_id,u["customer_id"])).rowcount
