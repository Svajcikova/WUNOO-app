# ---------------- WUNOO v1.94: Finality Gate Chain & Cross-Epoch Trust Continuity ----------------
def migrate_v194(c):
    c.executescript("""CREATE TABLE IF NOT EXISTS production_federation_finality_gate_chain(
        id TEXT PRIMARY KEY, sequence_no INTEGER NOT NULL UNIQUE, gate_id TEXT NOT NULL UNIQUE,
        gate_sha256 TEXT NOT NULL, federation_id TEXT NOT NULL, epoch_id TEXT NOT NULL,
        epoch_no INTEGER NOT NULL, previous_entry_sha256 TEXT NOT NULL, entry_json TEXT NOT NULL,
        entry_sha256 TEXT NOT NULL UNIQUE, algorithm TEXT NOT NULL, signer_key_id TEXT NOT NULL,
        public_key_b64 TEXT NOT NULL, signature_b64 TEXT NOT NULL, status TEXT NOT NULL,
