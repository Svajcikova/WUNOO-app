@app.get("/api/v096/ops/health")
def v096_ops_health(authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    checks={}
    started=time.perf_counter()
    try:
        with core_db_connect() as c:
            c.execute("SELECT 1").fetchone()
        checks["database"]={"status":"healthy","latency_ms":round((time.perf_counter()-started)*1000,3)}
    except Exception as e:
        checks["database"]={"status":"unhealthy","error":type(e).__name__}
    checks["application"]={"status":"healthy"}
    overall="healthy" if all(v["status"]=="healthy" for v in checks.values()) else "degraded"
    return {"status":overall,"checks":checks,"version":"0.96"}

