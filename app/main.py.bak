def _v173_verify(rows):
    expected=1; prev=_v173_zero(); checked=0; last_seq=0
    for r in rows:
        if int(r['checkpoint_no'])!=expected: return {'valid':False,'reason':'CHECKPOINT_SEQUENCE_GAP','expected_checkpoint_no':expected,'actual_checkpoint_no':int(r['checkpoint_no'])}
        payload=json.loads(r['checkpoint_json'] or '{}')
