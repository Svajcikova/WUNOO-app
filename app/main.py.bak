@app.get("/api/orders/{order_id}")
def order_detail(order_id: str, authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u = current_user(authorization)
    with core_db_connect() as c:
        o = c.execute("SELECT o.*, m.name merchant_name, cr.name courier_name FROM orders o JOIN merchants m ON m.id=o.merchant_id LEFT JOIN couriers cr ON cr.id=o.courier_id WHERE o.id=?", (order_id,)).fetchone()
        if not o:
            raise HTTPException(404, "Objednávka nenalezena")
        if u["role"] == "customer" and o["customer_id"] != u["customer_id"]:
            raise HTTPException(403, "Objednávka není vaše")
        if u["role"] == "merchant" and o["merchant_id"] != u["merchant_id"]:
            raise HTTPException(403, "Objednávka není vaše restaurace")
        if u["role"] == "courier" and o["courier_id"] not in (u["courier_id"], None):
            raise HTTPException(403, "Objednávka není přiřazená vám")
        items = c.execute("SELECT oi.*, mi.name FROM order_items oi JOIN menu_items mi ON mi.id=oi.menu_item_id WHERE oi.order_id=?", (order_id,)).fetchall()
        events = c.execute("SELECT type, actor_user_id, payload, created_at FROM events WHERE order_id=? ORDER BY created_at", (order_id,)).fetchall()
        payment = c.execute("SELECT * FROM payments WHERE order_id=?", (order_id,)).fetchone()
        settlement = c.execute("SELECT * FROM settlements WHERE order_id=?", (order_id,)).fetchone()
        refunds = c.execute("SELECT * FROM refunds WHERE order_id=? ORDER BY created_at", (order_id,)).fetchall()
        return {"order": dict(o), "items": [dict(x) for x in items], "events": [dict(x) for x in events], "payment": dict(payment) if payment else None, "refunds": [dict(x) for x in refunds], "settlement": dict(settlement) if settlement else None}


def haversine_km(lat1: float, lon1: float, lat2: float, lon2: float) -> float:
    r = 6371.0
    p1, p2 = math.radians(lat1), math.radians(lat2)
    dp = math.radians(lat2-lat1); dl = math.radians(lon2-lon1)
    a = math.sin(dp/2)**2 + math.cos(p1)*math.cos(p2)*math.sin(dl/2)**2
    return round(2*r*math.asin(math.sqrt(a)), 2)

def service_fee_for_subtotal(subtotal: float) -> float:
    return 9.0 if subtotal < 300 else 15.0 if subtotal < 500 else 21.0

def pricing_for_cart(c, customer_id: str, merchant_id: str, subtotal: float, address_id: str) -> dict[str, Any]:
    address = c.execute("SELECT * FROM customer_addresses WHERE id=? AND customer_id=?", (address_id, customer_id)).fetchone()
    if not address: raise HTTPException(404, "Adresa nenalezena")
    merchant = c.execute("SELECT * FROM merchants WHERE id=? AND active=1", (merchant_id,)).fetchone()
    if not merchant: raise HTTPException(404, "Restaurace nenalezena")
    distance = haversine_km(address["lat"], address["lon"], merchant["lat"], merchant["lon"])
    service_before = service_fee_for_subtotal(subtotal)
    pro = c.execute("SELECT * FROM pro_memberships WHERE customer_id=? AND active=1", (customer_id,)).fetchone()
    pro_discount = 3.0 if pro else 0.0
    service_after = max(0.0, service_before-pro_discount)
    # v0.8 delivery pricing: 49 CZK base + 10 CZK/km, rounded to whole CZK.
    delivery = round(49.0 + 10.0*distance, 0)
    total = round(subtotal + service_after + delivery, 2)
    return {"subtotal_czk":round(subtotal,2),"service_fee_before_discount_czk":service_before,"pro_discount_czk":pro_discount,"service_fee_czk":service_after,"delivery_distance_km":distance,"delivery_fee_czk":delivery,"total_czk":total,"pricing_version":"v0.8","pro_active":bool(pro)}

@app.post("/api/orders")
def create_order(body: OrderIn, authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u = current_user(authorization)
    require_role(u, "customer")
    if not body.items:
        with core_db_connect() as c0:
            cart_rows = c0.execute("SELECT menu_item_id, qty FROM cart_items WHERE customer_id=?", (u["customer_id"],)).fetchall()
        body = OrderIn(items=[OrderItemIn(menu_item_id=r["menu_item_id"], qty=r["qty"]) for r in cart_rows], address=body.address, address_id=body.address_id, note=body.note, payment_method=body.payment_method)
    if not body.items:
        raise HTTPException(400, "Košík je prázdný")
    with core_db_connect() as c:
        placeholders = ",".join("?" for _ in body.items)
        rows = c.execute(f"SELECT id, merchant_id, price_czk FROM menu_items WHERE id IN ({placeholders}) AND active=1", [i.menu_item_id for i in body.items]).fetchall()
        merchant_candidates={r['merchant_id'] for r in rows}
        for live_mid in merchant_candidates:
            live_pub=c.execute("SELECT snapshot_json FROM merchant_menu_publications WHERE merchant_id=? AND status='LIVE' ORDER BY publication_no DESC LIMIT 1",(live_mid,)).fetchone() if _db_table_exists(c,'merchant_menu_publications') else None
            if not live_pub: raise HTTPException(409,"Restaurace zatím nemá publikované menu")
            live_ids={str(x.get('id')) for x in json.loads(live_pub['snapshot_json']).get('items',[])}
            if any(str(i.menu_item_id) not in live_ids for i in body.items): raise HTTPException(409,"Objednávka obsahuje položku mimo aktuálně publikované menu")
        price_map = {r["id"]: r["price_czk"] for r in rows}
        merchants = {r["merchant_id"] for r in rows}
        if len(price_map) != len({i.menu_item_id for i in body.items}) or len(merchants) != 1:
            raise HTTPException(400, "Neplatná nebo smíšená položka menu")
        merchant_id = next(iter(merchants))
        subtotal = round(sum(price_map[i.menu_item_id] * i.qty for i in body.items), 2)
        if body.address_id:
            addr = c.execute("SELECT * FROM customer_addresses WHERE id=? AND customer_id=?", (body.address_id, u["customer_id"])).fetchone()
        else:
            addr = c.execute("SELECT * FROM customer_addresses WHERE customer_id=? AND is_default=1 ORDER BY created_at DESC LIMIT 1", (u["customer_id"],)).fetchone()
        address_id = addr["id"] if addr else None
        if not address_id:
            raise HTTPException(400, "Nejprve nastavte doručovací adresu")
        pricing = pricing_for_cart(c, u["customer_id"], merchant_id, subtotal, address_id)
        oid = "ord_" + uuid.uuid4().hex[:10]
        t = now()
        address_text = f"{addr["street"]}, {addr["city"]} {addr["postal_code"] or ""}".strip()
        merchant = c.execute("SELECT prep_minutes FROM merchants WHERE id=?", (merchant_id,)).fetchone()
        prep_eta = int(merchant["prep_minutes"] if merchant else 15)
        from datetime import timedelta
        promised = (datetime.now(timezone.utc) + timedelta(minutes=prep_eta + 35)).isoformat()
        c.execute(
            "INSERT INTO orders (id,customer_id,merchant_id,status,subtotal_czk,service_fee_czk,delivery_fee_czk,total_czk,courier_id,address,address_id,delivery_distance_km,service_fee_before_discount_czk,pro_discount_czk,pricing_version,prep_eta_minutes,promised_delivery_at,delay_level,note,payment_method,created_at,updated_at) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
            (oid, u["customer_id"], merchant_id, "payment_pending", subtotal, pricing["service_fee_czk"], pricing["delivery_fee_czk"], pricing["total_czk"], None, address_text, address_id, pricing["delivery_distance_km"], pricing["service_fee_before_discount_czk"], pricing["pro_discount_czk"], pricing["pricing_version"], prep_eta, promised, "NONE", body.note, body.payment_method, t, t),
        )
        for item in body.items:
            c.execute("INSERT INTO order_items VALUES (?,?,?,?,?)", (str(uuid.uuid4()), oid, item.menu_item_id, item.qty, price_map[item.menu_item_id]))
        emit(c, oid, "order_created", {"total_czk": pricing["total_czk"], "pricing_version": pricing["pricing_version"]}, u["id"])
        c.execute("DELETE FROM cart_items WHERE customer_id=?", (u["customer_id"],))
        c.commit()
        return {"order_id": oid, **pricing, "status": "payment_pending"}


@app.post("/api/orders/{order_id}/pay")
def pay(order_id: str, authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u = current_user(authorization); require_role(u, "customer")
    with core_db_connect() as c:
        c.execute("BEGIN")
        o = c.execute("SELECT * FROM orders WHERE id=?", (order_id,)).fetchone()
        if not o or o["customer_id"] != u["customer_id"]:
            raise HTTPException(404, "Objednávka nenalezena")
        existing = c.execute("SELECT * FROM payments WHERE order_id=?", (order_id,)).fetchone()
        if existing:
            c.commit()
            return {"payment_id": existing["id"], "provider_payment_id": existing["provider_payment_id"], "status": existing["status"], "idempotent": True}
        if o["status"] != "payment_pending":
            c.rollback()
            raise HTTPException(409, f"Platbu nelze provést ve stavu {o['status']}")
        pid = "pi_test_" + uuid.uuid4().hex[:12]
        payment_id = "pay_" + uuid.uuid4().hex[:10]
        cur = c.execute("INSERT INTO payments VALUES (?,?,?,?,?,?) ON CONFLICT(order_id) DO NOTHING", (payment_id, order_id, pid, o["total_czk"], "captured", now()))
        if getattr(cur, "rowcount", 1) == 0:
            existing = c.execute("SELECT * FROM payments WHERE order_id=?", (order_id,)).fetchone()
            c.commit()
            if existing:
                return {"payment_id": existing["id"], "provider_payment_id": existing["provider_payment_id"], "status": existing["status"], "idempotent": True}
            raise HTTPException(409, "Platbu se nepodařilo bezpečně vytvořit")
        transition(c, order_id, "payment_pending", "merchant_pending", u, "payment_captured", {"provider_payment_id": pid, "amount_czk": o["total_czk"]})
        c.commit()
        return {"payment_id": payment_id, "provider_payment_id": pid, "status": "captured", "idempotent": False}


@app.get("/api/orders/{order_id}/payment")
def payment_detail(order_id: str, authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u = current_user(authorization)
    with core_db_connect() as c:
        o = c.execute("SELECT * FROM orders WHERE id=?", (order_id,)).fetchone()
        if not o:
            raise HTTPException(404, "Objednávka nenalezena")
        if u["role"] == "customer" and o["customer_id"] != u["customer_id"]:
            raise HTTPException(403, "Objednávka není vaše")
        p = c.execute("SELECT * FROM payments WHERE order_id=?", (order_id,)).fetchone()
        refunds = c.execute("SELECT * FROM refunds WHERE order_id=? ORDER BY created_at", (order_id,)).fetchall()
        return {"payment": dict(p) if p else None, "refunds": [dict(r) for r in refunds], "captured_czk": float(p["amount_czk"]) if p and p["status"] == "captured" else 0.0}


@app.post("/api/orders/{order_id}/refund")
def refund(order_id: str, authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u = current_user(authorization); require_role(u, "admin")
    with core_db_connect() as c:
        c.execute("BEGIN")
        o = c.execute("SELECT * FROM orders WHERE id=?", (order_id,)).fetchone()
        if not o: raise HTTPException(404, "Objednávka nenalezena")
        p = c.execute("SELECT * FROM payments WHERE order_id=?", (order_id,)).fetchone()
        if not p or p["status"] != "captured": raise HTTPException(409, "Neexistuje captured payment")
        refunded = c.execute("SELECT COALESCE(SUM(amount_czk),0) x FROM refunds WHERE order_id=? AND status='succeeded'", (order_id,)).fetchone()["x"]
        remaining = round(float(p["amount_czk"]) - float(refunded), 2)
        if remaining <= 0: raise HTTPException(409, "Objednávka je již plně refundována")
        rid = "re_" + uuid.uuid4().hex[:10]
        provider_refund_id = "rf_test_" + uuid.uuid4().hex[:12]
        insert_refund(c, rid, order_id, p["id"], remaining, "admin_refund", "succeeded", provider_refund_id)
        emit(c, order_id, "refund_completed", {"refund_id": rid, "provider_refund_id": provider_refund_id, "amount_czk": remaining}, u["id"])
        c.execute("UPDATE payments SET status='refunded' WHERE order_id=?", (order_id,))
        c.commit()
        return {"refund_id": rid, "provider_refund_id": provider_refund_id, "amount_czk": remaining, "status": "succeeded"}


@app.post("/api/orders/{order_id}/merchant-accept")
def merchant_accept(order_id: str, authorization: str | None = Header(default=None)) -> dict[str, Any]:
