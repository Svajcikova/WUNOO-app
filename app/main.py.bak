@app.post("/api/v043/offers/{offer_id}/respond")
def v043_offer_respond(offer_id:str, response:str, authorization: str | None = Header(default=None)) -> dict[str,Any]:
    u=current_user(authorization); require_role(u,"courier")
    from datetime import datetime, timezone
    if response not in {"accept","decline"}: raise HTTPException(400,"response musí být accept/decline")
    with core_db_connect() as c:
        _v043_expire_offers(c)
        offer=c.execute("SELECT * FROM courier_offers WHERE id=?",(offer_id,)).fetchone()
        if not offer or offer["courier_id"]!=u["courier_id"]: raise HTTPException(404,"Nabídka nenalezena")
        if offer["status"]!="offered": raise HTTPException(409,"Nabídka už není aktivní")
        if offer["expires_at"]:
            exp=datetime.fromisoformat(str(offer["expires_at"]).replace("Z","+00:00"))
            if datetime.now(timezone.utc)>=exp:
                c.execute("UPDATE courier_offers SET status='expired',response_reason='timeout',responded_at=? WHERE id=?",(now(),offer_id))
                c.commit()
                raise HTTPException(409,"Nabídka expirovala")
        if response=="decline":
            c.execute("UPDATE courier_offers SET status='declined',response_reason='courier_decline',responded_at=? WHERE id=?",(now(),offer_id))
            c.execute("""INSERT INTO courier_dispatch_stats(courier_id,offered_count,accepted_count,declined_count,expired_count)
                         VALUES (?,?,0,1,0)
                         ON CONFLICT(courier_id) DO UPDATE SET declined_count=declined_count+1""",(u["courier_id"],1))
            emit(c,offer["order_id"],"courier_offer_declined",{"offer_id":offer_id,"courier_id":u["courier_id"]},u["id"])
            c.commit()
            return {"offer_id":offer_id,"status":"declined","order_id":offer["order_id"]}
        # Atomic single-winner claim: transition the order first, then attach courier metadata.
        ts=now()
        atomic_transition_any(c, offer["order_id"], ("dispatch_pending",), "assigned", u, "courier_assigned", {"courier_id":u["courier_id"],"offer_id":offer_id})
        updated=c.execute("UPDATE orders SET courier_id=?,assigned_at=?,updated_at=? WHERE id=? AND status='assigned' AND courier_id IS NULL",
                          (u["courier_id"],ts,ts,offer["order_id"])).rowcount
        if updated!=1:
            raise HTTPException(409,"Objednávka už byla přiřazena jinému kurýrovi")
        c.execute("UPDATE courier_offers SET status='accepted',responded_at=?,response_reason='courier_accept' WHERE id=?",(ts,offer_id))
        c.execute("""INSERT INTO courier_dispatch_stats(courier_id,offered_count,accepted_count,declined_count,expired_count)
                     VALUES (?,?,1,0,0)
                     ON CONFLICT(courier_id) DO UPDATE SET accepted_count=accepted_count+1""",(u["courier_id"],1))
        # Close all remaining offers for this order as fallback superseded.
        c.execute("UPDATE courier_offers SET status='superseded',fallback_reason='other_courier_accepted' WHERE order_id=? AND status='offered' AND id<>?",(offer["order_id"],offer_id))
        emit(c,offer["order_id"],"courier_assigned",{"courier_id":u["courier_id"],"offer_id":offer_id,"algorithm_version":"v0.43"},u["id"])
        c.commit()
        return {"offer_id":offer_id,"status":"accepted","order_id":offer["order_id"],"courier_id":u["courier_id"]}

@app.post("/api/v043/dispatch/sweep")
def v043_dispatch_sweep(authorization: str | None = Header(default=None)) -> dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    with core_db_connect() as c:
        expired=_v043_expire_offers(c)
        pending=c.execute("SELECT id FROM orders WHERE status='dispatch_pending' ORDER BY created_at").fetchall()
    attempted=[]
    for row in pending:
        try:
            result=v043_dispatch_advance(row["id"],authorization)
            attempted.append(result)
        except HTTPException as exc:
            attempted.append({"order_id":row["id"],"action":"ERROR","detail":exc.detail})
    return {"expired_offers":expired,"processed":attempted}

@app.get("/frontend_v029/dispatch_v043.html")
def v043_dispatch_page():
    return FileResponse(BASE.parent / "frontend_v029" / "dispatch_v043.html")

@app.get("/api/v044/orders/{order_id}/operations")
def v044_operations(order_id:str, authorization: str | None = Header(default=None)) -> dict[str,Any]:
    u=current_user(authorization)
    with core_db_connect() as c:
        o=c.execute("SELECT * FROM orders WHERE id=?",(order_id,)).fetchone()
        if not o: raise HTTPException(404,"Objednávka nenalezena")
        allowed=(u["role"]=="admin" or
                 (u["role"]=="courier" and o["courier_id"]==u["courier_id"]) or
                 (u["role"]=="customer" and o["customer_id"]==u["customer_id"]) or
                 (u["role"]=="merchant" and o["merchant_id"]==u["merchant_id"]))
        if not allowed: raise HTTPException(403,"forbidden")
        ex=c.execute("SELECT id,code,note,status,created_at,resolved_at FROM delivery_exceptions WHERE order_id=? ORDER BY created_at DESC",(order_id,)).fetchall()
        proofs=c.execute("SELECT method,pin_last4,note,created_at FROM delivery_proofs WHERE order_id=?",(order_id,)).fetchall()
        cps=c.execute("SELECT type,lat,lon,created_at FROM delivery_checkpoints WHERE order_id=? ORDER BY created_at",(order_id,)).fetchall()
        return {"order_id":order_id,"status":o["status"],"delivery_proof_status":o["delivery_proof_status"],
                "exceptions":[dict(x) for x in ex],"proofs":[dict(x) for x in proofs],"checkpoints":[dict(x) for x in cps]}


@app.post("/api/v044/orders/{order_id}/checkpoint")
def v044_checkpoint(order_id:str, body:dict[str,Any], authorization: str | None = Header(default=None)) -> dict[str,Any]:
    u=current_user(authorization); require_role(u,"courier","admin")
    typ=str(body.get("type","")).upper()
    if typ not in {"PICKUP","DROP_OFF","CHECKPOINT"}: raise HTTPException(400,"Neplatný checkpoint")
    with core_db_connect() as c:
        o=c.execute("SELECT * FROM orders WHERE id=?",(order_id,)).fetchone()
        if not o or (u["role"]=="courier" and o["courier_id"]!=u["courier_id"]): raise HTTPException(403,"forbidden")
        cid="cp_"+uuid.uuid4().hex[:10]
        c.execute("INSERT INTO delivery_checkpoints VALUES (?,?,?,?,?,?)",
                  (cid,order_id,o["courier_id"],typ,body.get("lat"),body.get("lon"),now()))
        emit(c,order_id,"delivery_checkpoint",{"checkpoint_id":cid,"type":typ,"lat":body.get("lat"),"lon":body.get("lon")},u["id"])
        c.commit()
        return {"checkpoint_id":cid,"order_id":order_id,"type":typ}


@app.post("/api/v044/orders/{order_id}/exception")
def v044_exception(order_id:str, body:dict[str,Any], authorization: str | None = Header(default=None)) -> dict[str,Any]:
    u=current_user(authorization); require_role(u,"courier","admin")
    code=str(body.get("code","")).upper()
    allowed_codes={"CUSTOMER_UNAVAILABLE","WRONG_ADDRESS","ACCESS_BLOCKED","DAMAGED","ORDER_MISSING","LATE","OTHER"}
    if code not in allowed_codes: raise HTTPException(400,"Neplatný exception code")
    with core_db_connect() as c:
        o=c.execute("SELECT * FROM orders WHERE id=?",(order_id,)).fetchone()
        if not o or (u["role"]=="courier" and o["courier_id"]!=u["courier_id"]): raise HTTPException(403,"forbidden")
        eid="ex_"+uuid.uuid4().hex[:10]
        c.execute("INSERT INTO delivery_exceptions VALUES (?,?,?,?,?,?,?,?)",
                  (eid,order_id,o["courier_id"],code,body.get("note"),"open",now(),None))
        emit(c,order_id,"delivery_exception_opened",{"exception_id":eid,"code":code,"note":body.get("note")},u["id"])
        c.commit()
        return {"id":eid,"order_id":order_id,"code":code,"status":"open"}


@app.post("/api/v044/orders/{order_id}/exception/{exception_id}/resolve")
def v044_resolve_exception(order_id:str, exception_id:str, authorization: str | None = Header(default=None)) -> dict[str,Any]:
    u=current_user(authorization); require_role(u,"admin","courier")
    with core_db_connect() as c:
        o=c.execute("SELECT * FROM orders WHERE id=?",(order_id,)).fetchone()
        ex=c.execute("SELECT * FROM delivery_exceptions WHERE id=? AND order_id=?",(exception_id,order_id)).fetchone()
        if not o or not ex: raise HTTPException(404,"Exception nenalezena")
        if u["role"]=="courier" and o["courier_id"]!=u["courier_id"]: raise HTTPException(403,"forbidden")
        if ex["status"]!="open": raise HTTPException(409,"Exception už je vyřešena")
        c.execute("UPDATE delivery_exceptions SET status='resolved',resolved_at=? WHERE id=?",(now(),exception_id))
        emit(c,order_id,"delivery_exception_resolved",{"exception_id":exception_id},u["id"])
        c.commit()
        return {"id":exception_id,"status":"resolved"}


@app.post("/api/v044/orders/{order_id}/proof")
def v044_proof(order_id:str, body:dict[str,Any], authorization: str | None = Header(default=None)) -> dict[str,Any]:
    u=current_user(authorization); require_role(u,"courier","admin")
    method=str(body.get("method","")).lower()
    if method not in {"pin","note","photo"}: raise HTTPException(400,"method musí být pin/note/photo")
    with core_db_connect() as c:
        o=c.execute("SELECT * FROM orders WHERE id=?",(order_id,)).fetchone()
        if not o or (u["role"]=="courier" and o["courier_id"]!=u["courier_id"]): raise HTTPException(403,"forbidden")
        existing=c.execute("SELECT id FROM delivery_proofs WHERE order_id=?",(order_id,)).fetchone()
        if existing: raise HTTPException(409,"Proof už existuje")
        pin=str(body.get("pin",""))
        if method=="pin" and (len(pin)!=4 or not pin.isdigit()):
            raise HTTPException(400,"PIN musí mít 4 číslice")
        pid="proof_"+uuid.uuid4().hex[:10]
        c.execute("INSERT INTO delivery_proofs VALUES (?,?,?,?,?)",(pid,order_id,method,pin[-4:] if pin else None,body.get("note"),now()))
        c.execute("UPDATE orders SET delivery_proof_status='verified',updated_at=? WHERE id=?",(now(),order_id))
        emit(c,order_id,"delivery_proof_captured",{"proof_id":pid,"method":method},u["id"])
        c.commit()
        return {"proof_id":pid,"order_id":order_id,"method":method,"status":"verified"}


@app.post("/api/v043/orders/{order_id}/offer")
def v043_create_offer(order_id:str, authorization: str | None = Header(default=None)) -> dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    from datetime import timedelta
    with core_db_connect() as c:
        _v043_expire_offers(c)
        o=c.execute("SELECT * FROM orders WHERE id=?",(order_id,)).fetchone()
        if not o or o["status"]!="dispatch_pending": raise HTTPException(409,"Objednávka není připravena k dispatchi")
        existing={r["courier_id"] for r in c.execute("SELECT courier_id FROM courier_offers WHERE order_id=? AND status='offered'",(order_id,)).fetchall()}
        candidates=[x for x in _v043_rank_couriers(c,o) if x["courier_id"] not in existing]
        if not candidates: raise HTTPException(409,"Žádný další vhodný kurýr")
        x=candidates[0]
        offered_at=now()
        expires=(datetime.now(timezone.utc)+timedelta(seconds=20)).isoformat()
        predicted=(datetime.now(timezone.utc)+timedelta(minutes=int(x["pickup_eta_minutes"])+30)).isoformat()
        oid="off_"+uuid.uuid4().hex[:10]
        c.execute("""INSERT INTO courier_offers(
            id,order_id,courier_id,algorithm_version,rank,distance_km,pickup_eta_minutes,predicted_delivery_at,status,offered_at,expires_at
        ) VALUES (?,?,?,?,?,?,?,?,?,?,?)""",
                  (oid,order_id,x["courier_id"],"v0.43",x["rank"],x["distance_km"],x["pickup_eta_minutes"],predicted,"offered",offered_at,expires))
        c.execute("""INSERT INTO courier_dispatch_stats(courier_id,offered_count,accepted_count,declined_count,expired_count)
                     VALUES (?,?,0,0,0)
                     ON CONFLICT(courier_id) DO UPDATE SET offered_count=offered_count+1""",(x["courier_id"],1))
        emit(c,order_id,"courier_offer_created",{"offer_id":oid,"courier_id":x["courier_id"],"rank":x["rank"],"final_score":x["final_score"],"expires_at":expires},u["id"])
        c.commit()
        return {"offer_id":oid,"order_id":order_id,"courier_id":x["courier_id"],"status":"offered","expires_at":expires,"candidate":x}


@app.post("/api/v043/dispatch/advance")
def v043_dispatch_advance(order_id:str, authorization: str | None = Header(default=None)) -> dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    from datetime import datetime, timezone
    with core_db_connect() as c:
        _v043_expire_offers(c)
        order=c.execute("SELECT * FROM orders WHERE id=?",(order_id,)).fetchone()
        if not order: raise HTTPException(404,"Objednávka nenalezena")
        if order["status"]!="dispatch_pending":
            return {"order_id":order_id,"action":"NONE","status":order["status"]}
        pending=c.execute("SELECT * FROM courier_offers WHERE order_id=? AND status='offered' ORDER BY offered_at DESC LIMIT 1",(order_id,)).fetchone()
        if pending:
            return {"order_id":order_id,"action":"WAIT","offer_id":pending["id"],"courier_id":pending["courier_id"],"expires_at":pending["expires_at"]}
        # Automatic fallback: offer next ranked courier.
        c.commit()
    return v043_create_offer(order_id,authorization)


