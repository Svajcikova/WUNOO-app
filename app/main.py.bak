@app.get("/api/v072/ops/health")
def v072_health(authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    with core_db_connect() as c:
        req=int(c.execute("SELECT COUNT(*) n FROM request_metrics").fetchone()["n"])
        err=int(c.execute("SELECT COUNT(*) n FROM request_metrics WHERE status_code>=500").fetchone()["n"])
        dlq=int(c.execute("SELECT COUNT(*) n FROM dead_letter_jobs WHERE status='dead'").fetchone()["n"])
        active=int(c.execute("SELECT COUNT(*) n FROM worker_jobs WHERE status IN ('queued','running')").fetchone()["n"])
        return {"api":"ok","database":"ok","requests":req,"server_errors":err,"open_dlq":dlq,"active_jobs":active,
                "healthy":err==0 and dlq==0}

