# ---------------- v1.134 Merchant Dashboard 2.0 ----------------
_V134_MERCHANT_DASHBOARD_POLICY = {
    'schema_version':'1.134',
    'purpose':'merchant operations dashboard with menu, orders, KPIs and controlled actions',
    'domains':['orders','menu','availability','finance_summary'],
    'tenant_isolated':True,
    'mutations_delegate_to_existing_contracts':True,
    'fail_closed':True,
}

_V134_ACTIVE_ORDER_STATES = ('confirmed','preparing','ready_for_pickup','dispatch_pending','assigned','picked_up','out_for_delivery','delayed')

@app.get('/api/v134/merchant/dashboard')
def v134_merchant_dashboard(authorization: str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,'merchant')
    mid=str(u.get('merchant_id') or '')
    if not mid: raise HTTPException(403,'Merchant tenant není dostupný')
    try:
        with core_db_connect() as c:
            merchant=c.execute('SELECT id,name,prep_minutes,active FROM merchants WHERE id=?',(mid,)).fetchone()
            if not merchant: raise HTTPException(404,'Merchant nenalezen')
            stats=c.execute("""SELECT
                COUNT(*) total_orders,
                SUM(CASE WHEN status IN ('confirmed','preparing','ready_for_pickup','dispatch_pending','assigned','picked_up','out_for_delivery','delayed') THEN 1 ELSE 0 END) active_orders,
                SUM(CASE WHEN status='merchant_pending' THEN 1 ELSE 0 END) pending_orders,
                SUM(CASE WHEN status='delivered' THEN 1 ELSE 0 END) delivered_orders,
                COALESCE(SUM(CASE WHEN status='delivered' THEN total_czk ELSE 0 END),0) delivered_gross_czk,
                COALESCE((SELECT SUM(s.merchant_czk) FROM settlements s JOIN orders so ON so.id=s.order_id WHERE so.merchant_id=? AND so.status='delivered'),0) delivered_payout_czk
                FROM orders WHERE merchant_id=?""",(mid,mid)).fetchone()
            orders=c.execute("""SELECT o.id,o.customer_id,o.status,o.subtotal_czk,o.service_fee_czk,o.delivery_fee_czk,o.total_czk,
                                      o.courier_id,o.address,o.created_at,o.updated_at,o.promised_delivery_at
                               FROM orders o WHERE o.merchant_id=?
                               ORDER BY o.created_at DESC LIMIT 100""",(mid,)).fetchall()
            menu=c.execute("""SELECT mi.id,mi.name,mi.description,mi.price_czk,mi.currency,mi.active,mi.category_id,
                                    mi.display_order,mi.version,mc.name category_name
                             FROM menu_items mi LEFT JOIN menu_categories mc ON mc.id=mi.category_id
                             WHERE mi.merchant_id=? ORDER BY COALESCE(mc.sort_order,999),mi.display_order,mi.name,mi.id""",(mid,)).fetchall()
            items=[]
            for r in menu:
                d=dict(r); d['availability']=_v114_availability(c,r['id']); items.append(d)
            categories=[dict(x) for x in c.execute('SELECT id,name,sort_order,active FROM menu_categories WHERE merchant_id=? ORDER BY sort_order,name,id',(mid,)).fetchall()]
            validation_errors=[]; validation_warnings=[]
            active_items=[x for x in items if x['active']]
            seen=set()
            for x in active_items:
                if not str(x['name']).strip(): validation_errors.append({'code':'MISSING_NAME','item_id':x['id']})
                if float(x['price_czk'])<0: validation_errors.append({'code':'NEGATIVE_PRICE','item_id':x['id']})
                if x['currency']!='CZK': validation_errors.append({'code':'INVALID_CURRENCY','item_id':x['id']})
                key=(x['category_id'],x['display_order'])
                if key in seen: validation_warnings.append({'code':'DUPLICATE_DISPLAY_ORDER','item_id':x['id']})
                seen.add(key)
            return {
                'schema_version':'1.134','policy':_V134_MERCHANT_DASHBOARD_POLICY,'merchant':dict(merchant),
                'kpis':dict(stats),'orders':[dict(x) for x in orders],
                'menu':{'categories':categories,'items':items,'active_items':len(active_items),'sold_out_items':sum(1 for x in active_items if x['availability']['state']=='SOLD_OUT')},
                'menu_validation':{'valid':not validation_errors,'errors':validation_errors,'warnings':validation_warnings},
            }
    except HTTPException: raise
    except Exception as exc:
        raise HTTPException(500,{'code':'MERCHANT_DASHBOARD_READ_FAILED','detail':str(exc)[:200]})

@app.post('/api/v134/merchant/orders/{order_id}/action')
def v134_merchant_order_action(order_id:str, body:dict[str,Any], authorization:str|None=Header(default=None), idempotency_key:str|None=Header(default=None,alias='Idempotency-Key'))->dict[str,Any]:
    u=current_user(authorization); require_role(u,'merchant')
    with core_db_connect() as c:
        o=c.execute('SELECT id,merchant_id FROM orders WHERE id=?',(order_id,)).fetchone()
        if not o: raise HTTPException(404,'Objednávka nenalezena')
        if str(o['merchant_id'])!=str(u.get('merchant_id')): raise HTTPException(403,'Objednávka nepatří restauraci')
    # Delegate to the already hardened merchant action contract.
    action=str(body.get('action','')).strip()
    if action not in {'accept','reject','ready'}: raise HTTPException(400,'Neplatná merchant akce')
    return v060_merchant_action(order_id, {'action':action,'metadata':body.get('metadata') or {}}, authorization, idempotency_key)

