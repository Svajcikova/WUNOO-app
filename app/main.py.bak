# ---------------- WUNOO v1.84: Global Checkpoint Witness Federation ----------------
def migrate_v184(c):
    c.executescript("""CREATE TABLE IF NOT EXISTS production_global_checkpoint_federations(
        id TEXT PRIMARY KEY, federation_no INTEGER NOT NULL UNIQUE, federation_version TEXT NOT NULL UNIQUE,
        member_witness_ids_json TEXT NOT NULL, quorum_required INTEGER NOT NULL,
        federation_json TEXT NOT NULL, federation_sha256 TEXT NOT NULL UNIQUE,
        algorithm TEXT NOT NULL, signer_key_id TEXT NOT NULL, public_key_b64 TEXT NOT NULL,
        signature_b64 TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT
    );
    CREATE TABLE IF NOT EXISTS production_global_checkpoint_federation_finality(
        id TEXT PRIMARY KEY, federation_id TEXT NOT NULL, federation_version TEXT NOT NULL,
        federation_sha256 TEXT NOT NULL, checkpoint_id TEXT NOT NULL, checkpoint_sha256 TEXT NOT NULL,
        quorum_required INTEGER NOT NULL, witness_count INTEGER NOT NULL, witness_ids_json TEXT NOT NULL,
        attestation_hashes_json TEXT NOT NULL, proof_json TEXT NOT NULL, proof_sha256 TEXT NOT NULL UNIQUE,
        algorithm TEXT NOT NULL, signer_key_id TEXT NOT NULL, public_key_b64 TEXT NOT NULL,
        signature_b64 TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT,
        UNIQUE(federation_id,checkpoint_id)
    );
    CREATE INDEX IF NOT EXISTS idx_global_checkpoint_federation_finality_checkpoint
      ON production_global_checkpoint_federation_finality(checkpoint_id,created_at);
    """)

_V184_POLICY={'schema_version':'1.84','federation_format':'wunoo.release.global.checkpoint.federation.v1',
 'finality_format':'wunoo.release.global.checkpoint.federation.finality.v1','hash':'SHA-256','algorithm':'Ed25519',
 'default_quorum':2,'distinct_witnesses_required':True,'membership_snapshot':True,'current_key_required':True,
 'active_trust_required':True,'append_only':True,'fail_closed':True,'no_automatic_release':True}
def _v184_hash(v): return hashlib.sha256(json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()).hexdigest()
def _v184_json(v): return json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False)
def _v184_quorum(v=None):
    raw=v if v is not None else os.getenv('WUNOO_GLOBAL_CHECKPOINT_FEDERATION_QUORUM','2')
    try:q=int(raw)
    except Exception:q=2
    if q<1 or q>100: raise HTTPException(400,'INVALID_FEDERATION_QUORUM')
    return q
def _v184_federation_payload(version,members,q,t):
    return {'format':_V184_POLICY['federation_format'],'schema_version':'1.84','federation_version':version,
            'member_witness_ids':members,'quorum_required':q,'created_at':t}
def _v184_verify_federation(c,row):
    try:
        obj=json.loads(row['federation_json'] or '{}')
        if obj.get('format')!=_V184_POLICY['federation_format'] or obj.get('schema_version')!='1.84': return {'valid':False,'reason':'FEDERATION_FORMAT_INVALID'}
        members=json.loads(row['member_witness_ids_json'] or '[]')
        if not isinstance(members,list) or not members or len(members)!=len(set(members)): return {'valid':False,'reason':'FEDERATION_MEMBERS_INVALID'}
        if obj.get('federation_version')!=row['federation_version'] or obj.get('member_witness_ids')!=members or int(obj.get('quorum_required'))!=int(row['quorum_required']): return {'valid':False,'reason':'FEDERATION_BINDING_INVALID'}
        if int(row['quorum_required'])>len(members): return {'valid':False,'reason':'FEDERATION_QUORUM_INVALID'}
        if _v184_hash(obj)!=row['federation_sha256']: return {'valid':False,'reason':'FEDERATION_HASH_INVALID'}
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto(); Ed25519PublicKey.from_public_bytes(base64.b64decode(row['public_key_b64'],validate=True)).verify(base64.b64decode(row['signature_b64'],validate=True),_v184_json(obj).encode())
        # Membership is a live trust gate: every configured member must still be registered, ACTIVE and trusted.
        for wid in members:
            reg=_v176_registry_row(c,wid)
            if not reg:return {'valid':False,'reason':'FEDERATION_MEMBER_NOT_REGISTERED'}
            if reg['status']!='ACTIVE':return {'valid':False,'reason':'FEDERATION_MEMBER_NOT_ACTIVE'}
            tv=_v177_evaluate(c,wid)
            if not tv['valid']:return {'valid':False,'reason':'FEDERATION_MEMBER_NOT_TRUSTED'}
        return {'valid':True,'reason':'FEDERATION_VERIFIED','member_count':len(members)}
    except Exception:return {'valid':False,'reason':'FEDERATION_SIGNATURE_INVALID'}
def _v184_finality_payload(fed,cp,q,wids,hashes):
    return {'format':_V184_POLICY['finality_format'],'schema_version':'1.84','federation_version':fed['federation_version'],
            'federation_sha256':fed['federation_sha256'],'checkpoint_sha256':cp['checkpoint_sha256'],
            'quorum_required':q,'witness_ids':wids,'attestation_hashes':hashes}
def _v184_verify_finality(c,row):
    try:
        fed=_v170_row(c,'production_global_checkpoint_federations',' WHERE id=?',(row['federation_id'],),'created_at DESC')
        cp=_v170_row(c,'production_global_evidence_checkpoints',' WHERE id=?',(row['checkpoint_id'],),'created_at DESC')
        if not fed:return {'valid':False,'reason':'FEDERATION_NOT_FOUND'}
        if not cp:return {'valid':False,'reason':'FEDERATION_CHECKPOINT_NOT_FOUND'}
        fv=_v184_verify_federation(c,fed)
        if not fv['valid']:return fv
        cv=_v183_verify_checkpoint(c,cp)
        if not cv['valid']:return cv
        if row['federation_version']!=fed['federation_version'] or row['federation_sha256']!=fed['federation_sha256'] or row['checkpoint_sha256']!=cp['checkpoint_sha256']:return {'valid':False,'reason':'FEDERATION_FINALITY_BINDING_INVALID'}
        ids=json.loads(row['witness_ids_json'] or '[]'); hashes=json.loads(row['attestation_hashes_json'] or '[]'); members=json.loads(fed['member_witness_ids_json'] or '[]')
        if len(ids)!=int(row['witness_count']) or len(ids)!=len(hashes) or len(ids)<int(row['quorum_required']) or len(set(ids))!=len(ids) or any(x not in members for x in ids):return {'valid':False,'reason':'FEDERATION_FINALITY_QUORUM_INVALID'}
        if int(row['quorum_required'])!=int(fed['quorum_required']):return {'valid':False,'reason':'FEDERATION_QUORUM_CHANGED'}
        rows=c.execute('SELECT * FROM production_global_evidence_checkpoint_attestations WHERE checkpoint_id=? ORDER BY witness_id ASC,attestation_sha256 ASC',(cp['id'],)).fetchall(); amap={}
        for a in rows:
            if a['witness_id'] in members:
                av=_v183_verify_attestation(c,a)
                if av['valid']:amap[a['witness_id']]=a
        chosen=[amap[x] for x in ids if x in amap]
        if len(chosen)!=len(ids) or [x['attestation_sha256'] for x in chosen]!=hashes:return {'valid':False,'reason':'FEDERATION_ATTESTATIONS_CHANGED'}
        proof=json.loads(row['proof_json'] or '{}')
        if proof!=_v184_finality_payload(fed,cp,int(row['quorum_required']),ids,hashes):return {'valid':False,'reason':'FEDERATION_PROOF_INVALID'}
        if _v184_hash(proof)!=row['proof_sha256']:return {'valid':False,'reason':'FEDERATION_PROOF_HASH_INVALID'}
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto();Ed25519PublicKey.from_public_bytes(base64.b64decode(row['public_key_b64'],validate=True)).verify(base64.b64decode(row['signature_b64'],validate=True),_v184_json(proof).encode())
        return {'valid':True,'reason':'FEDERATION_FINALITY_VERIFIED','witness_count':len(chosen)}
    except Exception:return {'valid':False,'reason':'FEDERATION_FINALITY_INVALID'}

@app.get('/api/v184/ops/checkpoint-federation/policy')
def v184_policy(authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'});return _V184_POLICY
@app.post('/api/v184/ops/checkpoint-federation/create')
def v184_create(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin'});p=payload or {};operator=str(u.get('email') or u.get('id') or 'operator')
    members=sorted(set(str(x).strip() for x in (p.get('witness_ids') or []) if str(x).strip()));q=_v184_quorum(p.get('quorum_required'));version=str(p.get('federation_version') or ('1.84-'+uuid.uuid4().hex[:12]));
    if not members:raise HTTPException(400,'witness_ids required')
    if q>len(members):raise HTTPException(400,'FEDERATION_QUORUM_EXCEEDS_MEMBERS')
    with core_db_connect() as c:
        for wid in members:
            reg=_v176_registry_row(c,wid)
            if not reg or reg['status']!='ACTIVE':raise HTTPException(409,'FEDERATION_MEMBER_NOT_ACTIVE')
            tv=_v177_evaluate(c,wid)
            if not tv['valid']:raise HTTPException(409,'FEDERATION_MEMBER_NOT_TRUSTED')
        existing=_v170_row(c,'production_global_checkpoint_federations',' WHERE federation_version=?',(version,),'created_at DESC')
        if existing:
            vr=_v184_verify_federation(c,existing)
            if vr['valid']:return {'schema_version':'1.84','idempotent':True,'federation':dict(existing),'verification':vr}
            raise HTTPException(409,'FEDERATION_EXISTS_BUT_INVALID')
        nrow=c.execute('SELECT COALESCE(MAX(federation_no),0)+1 AS n FROM production_global_checkpoint_federations').fetchone();no=int(nrow['n']);t=now();obj=_v184_federation_payload(version,members,q,t);digest=_v184_hash(obj);signer,pub,keyid=_v169_load_signer();sig=base64.b64encode(signer.sign(_v184_json(obj).encode())).decode();fid='gcf_'+uuid.uuid4().hex[:16]
        c.execute('INSERT INTO production_global_checkpoint_federations(id,federation_no,federation_version,member_witness_ids_json,quorum_required,federation_json,federation_sha256,algorithm,signer_key_id,public_key_b64,signature_b64,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(fid,no,version,_v184_json(members),q,_v184_json(obj),digest,'Ed25519',keyid,base64.b64encode(pub).decode(),sig,'ACTIVE',t,operator));c.commit();row=_v170_row(c,'production_global_checkpoint_federations',' WHERE id=?',(fid,),'created_at DESC');return {'schema_version':'1.84','idempotent':False,'federation':dict(row),'verification':_v184_verify_federation(c,row)}
@app.post('/api/v184/ops/checkpoint-federation/finalize')
def v184_finalize(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin'});p=payload or {};operator=str(u.get('email') or u.get('id') or 'operator')
    with core_db_connect() as c:
        fed=_v170_row(c,'production_global_checkpoint_federations',' WHERE id=?',(p.get('federation_id'),),'created_at DESC') if p.get('federation_id') else _v170_row(c,'production_global_checkpoint_federations',order='federation_no DESC')
        if not fed:raise HTTPException(404,'FEDERATION_NOT_FOUND')
        fv=_v184_verify_federation(c,fed)
        if not fv['valid']:raise HTTPException(409,fv['reason'])
        cp=_v170_row(c,'production_global_evidence_checkpoints',' WHERE id=?',(p.get('checkpoint_id'),),'created_at DESC') if p.get('checkpoint_id') else _v170_row(c,'production_global_evidence_checkpoints',order='checkpoint_no DESC')
        if not cp:raise HTTPException(404,'FEDERATION_CHECKPOINT_NOT_FOUND')
        cv=_v183_verify_checkpoint(c,cp)
        if not cv['valid']:raise HTTPException(409,cv['reason'])
        existing=_v170_row(c,'production_global_checkpoint_federation_finality',' WHERE federation_id=? AND checkpoint_id=?',(fed['id'],cp['id']),'created_at DESC')
        if existing:
            vr=_v184_verify_finality(c,existing)
            if vr['valid']:return {'schema_version':'1.84','idempotent':True,'finality':dict(existing),'verification':vr}
            raise HTTPException(409,'FEDERATION_FINALITY_EXISTS_BUT_INVALID')
        q=int(fed['quorum_required']);members=json.loads(fed['member_witness_ids_json']);rows=c.execute('SELECT * FROM production_global_evidence_checkpoint_attestations WHERE checkpoint_id=? ORDER BY witness_id ASC,attestation_sha256 ASC',(cp['id'],)).fetchall();valid=[]
        for a in rows:
            if a['witness_id'] not in members:continue
            av=_v183_verify_attestation(c,a)
            if av['valid']:valid.append(a)
        valid.sort(key=lambda x:(str(x['witness_id']),str(x['attestation_sha256'])))
        if len(valid)<q:raise HTTPException(409,'FEDERATION_QUORUM_NOT_REACHED')
        chosen=valid[:q];ids=[x['witness_id'] for x in chosen];hashes=[x['attestation_sha256'] for x in chosen];proof=_v184_finality_payload(fed,cp,q,ids,hashes);digest=_v184_hash(proof);signer,pub,keyid=_v169_load_signer();sig=base64.b64encode(signer.sign(_v184_json(proof).encode())).decode();fid='gcf_'+uuid.uuid4().hex[:16];t=now();c.execute('INSERT INTO production_global_checkpoint_federation_finality(id,federation_id,federation_version,federation_sha256,checkpoint_id,checkpoint_sha256,quorum_required,witness_count,witness_ids_json,attestation_hashes_json,proof_json,proof_sha256,algorithm,signer_key_id,public_key_b64,signature_b64,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(fid,fed['id'],fed['federation_version'],fed['federation_sha256'],cp['id'],cp['checkpoint_sha256'],q,len(chosen),_v184_json(ids),_v184_json(hashes),_v184_json(proof),digest,'Ed25519',keyid,base64.b64encode(pub).decode(),sig,'FINALIZED',t,operator));c.commit();row=_v170_row(c,'production_global_checkpoint_federation_finality',' WHERE id=?',(fid,),'created_at DESC');return {'schema_version':'1.84','idempotent':False,'finality':dict(row),'verification':_v184_verify_finality(c,row)}
@app.get('/api/v184/ops/checkpoint-federation/verify')
def v184_verify(authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        fed=_v170_row(c,'production_global_checkpoint_federations',order='federation_no DESC');fin=_v170_row(c,'production_global_checkpoint_federation_finality',order='created_at DESC')
        fv=_v184_verify_federation(c,fed) if fed else {'valid':False,'reason':'FEDERATION_NOT_FOUND'};ff=_v184_verify_finality(c,fin) if fin else {'valid':False,'reason':'FEDERATION_FINALITY_NOT_FOUND'}
        return {'schema_version':'1.84','federation':fv,'finality':ff}


# ---------------- WUNOO v1.85: Federation Epoch & Witness Key Rotation Continuity ----------------
def migrate_v185(c):
    c.executescript("""CREATE TABLE IF NOT EXISTS production_checkpoint_federation_epochs(
        id TEXT PRIMARY KEY, epoch_no INTEGER NOT NULL UNIQUE, federation_id TEXT NOT NULL,
        federation_version TEXT NOT NULL, federation_sha256 TEXT NOT NULL,
        predecessor_epoch_id TEXT, predecessor_epoch_sha256 TEXT NOT NULL,
        member_snapshot_json TEXT NOT NULL, epoch_json TEXT NOT NULL, epoch_sha256 TEXT NOT NULL UNIQUE,
        algorithm TEXT NOT NULL, signer_key_id TEXT NOT NULL, public_key_b64 TEXT NOT NULL,
        signature_b64 TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT
    );
    CREATE TABLE IF NOT EXISTS production_checkpoint_federation_epoch_transitions(
        id TEXT PRIMARY KEY, from_epoch_id TEXT NOT NULL, to_epoch_id TEXT NOT NULL UNIQUE,
        from_epoch_sha256 TEXT NOT NULL, to_epoch_sha256 TEXT NOT NULL,
        transition_json TEXT NOT NULL, transition_sha256 TEXT NOT NULL UNIQUE,
        algorithm TEXT NOT NULL, signer_key_id TEXT NOT NULL, public_key_b64 TEXT NOT NULL,
        signature_b64 TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT
    );
    CREATE INDEX IF NOT EXISTS idx_checkpoint_federation_epochs_federation
      ON production_checkpoint_federation_epochs(federation_id,epoch_no);
    CREATE INDEX IF NOT EXISTS idx_checkpoint_federation_epoch_transitions_from
      ON production_checkpoint_federation_epoch_transitions(from_epoch_id,created_at);
    """)

_V185_POLICY={'schema_version':'1.85','epoch_format':'wunoo.release.global.checkpoint.federation.epoch.v1',
 'transition_format':'wunoo.release.global.checkpoint.federation.epoch.transition.v1','hash':'SHA-256','algorithm':'Ed25519',
 'key_snapshot_required':True,'predecessor_required':True,'current_key_required':True,'active_trust_required':True,
 'append_only':True,'fail_closed':True,'no_automatic_release':True}
def _v185_hash(v): return hashlib.sha256(json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()).hexdigest()
def _v185_json(v): return json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False)
def _v185_members(c, federation):
    out=[]
    for wid in json.loads(federation['member_witness_ids_json'] or '[]'):
        reg=_v176_registry_row(c,wid)
        if not reg or reg['status']!='ACTIVE': raise HTTPException(409,'FEDERATION_MEMBER_NOT_ACTIVE')
        tv=_v177_evaluate(c,wid)
        if not tv['valid']: raise HTTPException(409,'FEDERATION_MEMBER_NOT_TRUSTED')
        out.append({'witness_id':wid,'key_id':reg['current_key_id'],'public_key_b64':reg['current_public_key_b64']})
    return sorted(out,key=lambda x:x['witness_id'])
def _v185_epoch_payload(no,fed,predecessor,members,t):
    return {'format':_V185_POLICY['epoch_format'],'schema_version':'1.85','epoch_no':no,
            'federation_id':fed['id'],'federation_version':fed['federation_version'],'federation_sha256':fed['federation_sha256'],
            'predecessor_epoch_id': predecessor['id'] if predecessor else None,
            'predecessor_epoch_sha256': predecessor['epoch_sha256'] if predecessor else '0'*64,
            'members':members,'created_at':t}
def _v185_verify_epoch(c,row):
    try:
        obj=json.loads(row['epoch_json'] or '{}'); members=json.loads(row['member_snapshot_json'] or '[]')
        if obj.get('format')!=_V185_POLICY['epoch_format'] or obj.get('schema_version')!='1.85': return {'valid':False,'reason':'EPOCH_FORMAT_INVALID'}
        if obj.get('epoch_no')!=int(row['epoch_no']) or obj.get('federation_id')!=row['federation_id'] or obj.get('federation_version')!=row['federation_version'] or obj.get('federation_sha256')!=row['federation_sha256'] or obj.get('members')!=members:return {'valid':False,'reason':'EPOCH_BINDING_INVALID'}
        if obj.get('predecessor_epoch_id')!=row['predecessor_epoch_id'] or obj.get('predecessor_epoch_sha256')!=row['predecessor_epoch_sha256']:return {'valid':False,'reason':'EPOCH_PREDECESSOR_INVALID'}
        if _v185_hash(obj)!=row['epoch_sha256']:return {'valid':False,'reason':'EPOCH_HASH_INVALID'}
        fed=_v170_row(c,'production_global_checkpoint_federations',' WHERE id=?',(row['federation_id'],),'created_at DESC')
        if not fed:return {'valid':False,'reason':'EPOCH_FEDERATION_NOT_FOUND'}
        fobj=json.loads(fed['federation_json'] or '{}')
        if _v184_hash(fobj)!=fed['federation_sha256']:return {'valid':False,'reason':'EPOCH_FEDERATION_HASH_INVALID'}
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto();Ed25519PublicKey.from_public_bytes(base64.b64decode(fed['public_key_b64'],validate=True)).verify(base64.b64decode(fed['signature_b64'],validate=True),_v184_json(fobj).encode())
        current=json.loads(fed['member_witness_ids_json'] or '[]')
        if sorted(x['witness_id'] for x in members)!=sorted(current):return {'valid':False,'reason':'EPOCH_MEMBERSHIP_CHANGED'}
        for m in members:
            reg=_v176_registry_row(c,m['witness_id'])
            if not reg or reg['status']=='REVOKED':return {'valid':False,'reason':'EPOCH_WITNESS_REVOKED'}
            hist=_v176_history(c,m['witness_id'],m['key_id'])
            if not hist:return {'valid':False,'reason':'EPOCH_KEY_UNKNOWN'}
            et=obj.get('created_at') or ''
            if str(hist['valid_from'])>str(et):return {'valid':False,'reason':'EPOCH_KEY_NOT_YET_VALID'}
            if hist['valid_until'] and str(hist['valid_until'])<str(et):return {'valid':False,'reason':'EPOCH_KEY_EXPIRED_AT_EPOCH'}
            if hist['public_key_b64']!=m['public_key_b64']:return {'valid':False,'reason':'EPOCH_KEY_SNAPSHOT_INVALID'}
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto();Ed25519PublicKey.from_public_bytes(base64.b64decode(row['public_key_b64'],validate=True)).verify(base64.b64decode(row['signature_b64'],validate=True),_v185_json(obj).encode())
        if row['predecessor_epoch_id']:
            prev=_v170_row(c,'production_checkpoint_federation_epochs',' WHERE id=?',(row['predecessor_epoch_id'],),'epoch_no DESC')
            if not prev or prev['epoch_sha256']!=row['predecessor_epoch_sha256'] or int(prev['epoch_no'])!=int(row['epoch_no'])-1:return {'valid':False,'reason':'EPOCH_CONTINUITY_BROKEN'}
        return {'valid':True,'reason':'EPOCH_VERIFIED','member_count':len(members)}
    except Exception:return {'valid':False,'reason':'EPOCH_INVALID'}
def _v185_transition_payload(fr,to):
    return {'format':_V185_POLICY['transition_format'],'schema_version':'1.85','from_epoch_id':fr['id'],'from_epoch_sha256':fr['epoch_sha256'],'to_epoch_id':to['id'],'to_epoch_sha256':to['epoch_sha256'],'from_epoch_no':int(fr['epoch_no']),'to_epoch_no':int(to['epoch_no'])}
def _v185_verify_transition(c,row):
    try:
        fr=_v170_row(c,'production_checkpoint_federation_epochs',' WHERE id=?',(row['from_epoch_id'],),'epoch_no DESC');to=_v170_row(c,'production_checkpoint_federation_epochs',' WHERE id=?',(row['to_epoch_id'],),'epoch_no DESC')
        if not fr or not to:return {'valid':False,'reason':'TRANSITION_EPOCH_NOT_FOUND'}
        if row['from_epoch_sha256']!=fr['epoch_sha256'] or row['to_epoch_sha256']!=to['epoch_sha256']:return {'valid':False,'reason':'TRANSITION_BINDING_INVALID'}
        fv=_v185_verify_epoch(c,fr);tv=_v185_verify_epoch(c,to)
        if not fv['valid'] or not tv['valid']:return {'valid':False,'reason':'TRANSITION_EPOCH_INVALID'}
        if int(to['epoch_no'])!=int(fr['epoch_no'])+1:return {'valid':False,'reason':'TRANSITION_SEQUENCE_BROKEN'}
        obj=json.loads(row['transition_json'] or '{}');expected=_v185_transition_payload(fr,to)
        if obj!=expected or _v185_hash(obj)!=row['transition_sha256']:return {'valid':False,'reason':'TRANSITION_HASH_INVALID'}
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto();Ed25519PublicKey.from_public_bytes(base64.b64decode(row['public_key_b64'],validate=True)).verify(base64.b64decode(row['signature_b64'],validate=True),_v185_json(obj).encode())
        return {'valid':True,'reason':'TRANSITION_VERIFIED'}
    except Exception:return {'valid':False,'reason':'TRANSITION_INVALID'}
def _v185_chain(c):
    rows=c.execute('SELECT * FROM production_checkpoint_federation_epochs ORDER BY epoch_no ASC').fetchall();prev=None
    for r in rows:
        vr=_v185_verify_epoch(c,r)
        if not vr['valid']:return {'valid':False,'reason':vr['reason'],'checked':len(rows)}
        if prev and (r['predecessor_epoch_id']!=prev['id'] or r['predecessor_epoch_sha256']!=prev['epoch_sha256']):return {'valid':False,'reason':'EPOCH_CHAIN_BROKEN','checked':int(r['epoch_no'])-1}
        prev=r
    trs=c.execute('SELECT * FROM production_checkpoint_federation_epoch_transitions ORDER BY created_at ASC').fetchall()
    for tr in trs:
        vr=_v185_verify_transition(c,tr)
        if not vr['valid']:return {'valid':False,'reason':vr['reason'],'checked':len(rows)}
    return {'valid':True,'reason':'EPOCH_CHAIN_VERIFIED','checked':len(rows),'count':len(rows),'transitions':len(trs)}

@app.get('/api/v185/ops/federation-epochs/policy')
def v185_policy(authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'});return _V185_POLICY
@app.post('/api/v185/ops/federation-epochs/create')
def v185_create(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin'});p=payload or {};operator=str(u.get('email') or u.get('id') or 'operator')
    with core_db_connect() as c:
        fed=_v170_row(c,'production_global_checkpoint_federations',' WHERE id=?',(p.get('federation_id'),),'created_at DESC') if p.get('federation_id') else _v170_row(c,'production_global_checkpoint_federations',order='federation_no DESC')
        if not fed:raise HTTPException(404,'FEDERATION_NOT_FOUND')
        if not _v184_verify_federation(c,fed)['valid']:raise HTTPException(409,'FEDERATION_INVALID')
        prev=_v170_row(c,'production_checkpoint_federation_epochs',order='epoch_no DESC')
        no=(int(prev['epoch_no']) if prev else 0)+1
        if prev and prev['federation_id']!=fed['id']:raise HTTPException(409,'FEDERATION_EPOCH_FEDERATION_CHANGED')
        existing=_v170_row(c,'production_checkpoint_federation_epochs',' WHERE epoch_no=?',(no,),'epoch_no DESC')
        if existing:return {'schema_version':'1.85','idempotent':True,'epoch':dict(existing),'verification':_v185_verify_epoch(c,existing)}
        members=_v185_members(c,fed);t=now();obj=_v185_epoch_payload(no,fed,prev,members,t);digest=_v185_hash(obj);signer,pub,keyid=_v169_load_signer();sig=base64.b64encode(signer.sign(_v185_json(obj).encode())).decode();eid='gfe_'+uuid.uuid4().hex[:16]
        c.execute('INSERT INTO production_checkpoint_federation_epochs(id,epoch_no,federation_id,federation_version,federation_sha256,predecessor_epoch_id,predecessor_epoch_sha256,member_snapshot_json,epoch_json,epoch_sha256,algorithm,signer_key_id,public_key_b64,signature_b64,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(eid,no,fed['id'],fed['federation_version'],fed['federation_sha256'],prev['id'] if prev else None,prev['epoch_sha256'] if prev else '0'*64,_v185_json(members),_v185_json(obj),digest,'Ed25519',keyid,base64.b64encode(pub).decode(),sig,'SEALED',t,operator));c.commit();row=_v170_row(c,'production_checkpoint_federation_epochs',' WHERE id=?',(eid,),'epoch_no DESC');return {'schema_version':'1.85','idempotent':False,'epoch':dict(row),'verification':_v185_verify_epoch(c,row)}
@app.post('/api/v185/ops/federation-epochs/rotate')
def v185_rotate(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin'});p=payload or {};operator=str(u.get('email') or u.get('id') or 'operator')
    with core_db_connect() as c:
        prev=_v170_row(c,'production_checkpoint_federation_epochs',' WHERE id=?',(p.get('from_epoch_id'),),'epoch_no DESC') if p.get('from_epoch_id') else _v170_row(c,'production_checkpoint_federation_epochs',order='epoch_no DESC')
