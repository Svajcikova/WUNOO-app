    if m.get('sha256')!=s.get('manifest_sha256'): return {'valid':False,'reason':'MANIFEST_SIGNATURE_BINDING_INVALID'}
    if m.get('release_version')!=payload.get('release_version') or s.get('release_version')!=payload.get('release_version'): return {'valid':False,'reason':'RELEASE_IDENTITY_INVALID'}
