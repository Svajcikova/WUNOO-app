        head_sha256 TEXT NOT NULL, entries_count INTEGER NOT NULL, checkpoint_sha256 TEXT NOT NULL UNIQUE,
        signer_key_id TEXT NOT NULL, public_key_b64 TEXT NOT NULL, signature_b64 TEXT NOT NULL,
        checkpoint_json TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT
    );
    CREATE INDEX IF NOT EXISTS idx_transparency_checkpoint_no ON production_release_transparency_checkpoints(checkpoint_no DESC);
