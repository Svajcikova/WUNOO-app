def _v039_parse_hhmm(v):
    if not v: return None
    h,m=v.split(":")
    return int(h)*60+int(m)

def _v039_default_hours(c, merchant_id):
    row=c.execute("SELECT opening_hours_json FROM merchant_profiles WHERE merchant_id=?",(merchant_id,)).fetchone()
    if row and row["opening_hours_json"]:
        try: return json.loads(row["opening_hours_json"])
        except Exception: pass
    return {}

def _v039_availability(c, merchant_id, now_local=None):
    from datetime import datetime
    now_local = now_local or datetime.now()
    date_local=now_local.date().isoformat()
    ex=c.execute("""SELECT status,open_time,close_time,note FROM merchant_hours_exceptions
                    WHERE merchant_id=? AND date_local=? ORDER BY created_at DESC LIMIT 1""",(merchant_id,date_local)).fetchone()
    if ex:
        if ex["status"]=="closed":
            return {"status":"CLOSED","open_now":False,"reason":"exception","note":ex["note"]}
        if ex["status"] in {"open","pre_order"}:
            pair=(ex["open_time"],ex["close_time"])
            cur=now_local.hour*60+now_local.minute
            o,cx=_v039_parse_hhmm(pair[0]),_v039_parse_hhmm(pair[1])
            open_now=(o is not None and cx is not None and (o<=cur<=cx if cx>=o else cur>=o or cur<=cx))
            return {"status":"OPEN" if open_now and ex["status"]=="open" else "PRE_ORDER",
                    "open_now":open_now,"reason":"exception","note":ex["note"],
                    "open_time":pair[0],"close_time":pair[1]}
    hours=_v039_default_hours(c,merchant_id)
    key=now_local.strftime("%a").lower()[:3]
    pair=hours.get(key)
    if not pair: return {"status":"CLOSED","open_now":False,"reason":"schedule"}
    o,cx=_v039_parse_hhmm(pair[0]),_v039_parse_hhmm(pair[1])
    cur=now_local.hour*60+now_local.minute
    open_now=(o<=cur<=cx if cx>=o else cur>=o or cur<=cx)
    return {"status":"OPEN" if open_now else "CLOSED","open_now":open_now,"reason":"schedule","open_time":pair[0],"close_time":pair[1]}



def migrate_v040(c):
    c.execute("""CREATE TABLE IF NOT EXISTS merchant_preorder_settings(
        merchant_id TEXT PRIMARY KEY,
        enabled INTEGER NOT NULL DEFAULT 1,
        slot_minutes INTEGER NOT NULL DEFAULT 30,
        cutoff_minutes INTEGER NOT NULL DEFAULT 30,
        horizon_days INTEGER NOT NULL DEFAULT 3
    )""")
    c.execute("""CREATE TABLE IF NOT EXISTS merchant_preorder_slots(
        id TEXT PRIMARY KEY,
        merchant_id TEXT NOT NULL,
        slot_start TEXT NOT NULL,
        slot_end TEXT NOT NULL,
        capacity INTEGER NOT NULL DEFAULT 5,
        reserved INTEGER NOT NULL DEFAULT 0,
        status TEXT NOT NULL DEFAULT 'open'
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_preorder_slots_merchant_start ON merchant_preorder_slots(merchant_id,slot_start)")
    c.execute("CREATE TABLE IF NOT EXISTS order_preorder_reservations(order_id TEXT PRIMARY KEY,slot_id TEXT NOT NULL,reserved_at TEXT NOT NULL)")
    cols={r[1] for r in c.execute("PRAGMA table_info(orders)").fetchall()}
    if "fulfillment_mode" not in cols:
        c.execute("ALTER TABLE orders ADD COLUMN fulfillment_mode TEXT NOT NULL DEFAULT 'asap'")
    if "scheduled_for" not in cols:
        c.execute("ALTER TABLE orders ADD COLUMN scheduled_for TEXT")
    if "schedule_status" not in cols:
        c.execute("ALTER TABLE orders ADD COLUMN schedule_status TEXT NOT NULL DEFAULT 'none'")
    c.commit()



def _v040_slots(c, merchant_id, days=3):
    from datetime import datetime, timedelta, time
    hours=_v039_default_hours(c,merchant_id)
    settings=c.execute("SELECT * FROM merchant_preorder_settings WHERE merchant_id=?",(merchant_id,)).fetchone()
    if not settings:
        settings={"enabled":1,"slot_minutes":30,"cutoff_minutes":30,"horizon_days":days}
    now_local=datetime.now()
    out=[]
    for d in range(int(settings["horizon_days"])):
        day=now_local.date()+timedelta(days=d)
        key=day.strftime("%a").lower()[:3]
        pair=hours.get(key)
        if not pair: continue
        start_h,start_m=[int(x) for x in pair[0].split(":")]
        end_h,end_m=[int(x) for x in pair[1].split(":")]
        cur=datetime.combine(day,time(start_h,start_m))
        end=datetime.combine(day,time(end_h,end_m))
        if end <= cur: end += timedelta(days=1)
        while cur < end:
            nxt=cur+timedelta(minutes=int(settings["slot_minutes"]))
            if nxt > end: break
            if cur > now_local+timedelta(minutes=int(settings["cutoff_minutes"])):
                sid=f"slot_{merchant_id}_{cur.strftime('%Y%m%d%H%M')}"
                row=c.execute("SELECT * FROM merchant_preorder_slots WHERE id=?",(sid,)).fetchone()
                if row:
                    reserved=int(row["reserved"]); capacity=int(row["capacity"]); status=row["status"]
                else:
                    reserved=0; capacity=5; status="open"
                    c.execute("INSERT OR IGNORE INTO merchant_preorder_slots VALUES (?,?,?,?,?,?,?)",
                              (sid,merchant_id,cur.isoformat(),nxt.isoformat(),capacity,reserved,status))
                if status=="open" and reserved < capacity:
                    out.append({"id":sid,"start":cur.isoformat(),"end":nxt.isoformat(),"capacity":capacity,"reserved":reserved,"available":True})
            cur=nxt
    c.commit()
    return out



def migrate_v041(c):
    c.execute("""CREATE TABLE IF NOT EXISTS merchant_capacity_settings(
        merchant_id TEXT PRIMARY KEY,
        max_parallel_orders INTEGER NOT NULL DEFAULT 8,
        avg_prep_buffer_minutes INTEGER NOT NULL DEFAULT 5,
        courier_buffer_minutes INTEGER NOT NULL DEFAULT 10
    )""")
    cols={r[1] for r in c.execute("PRAGMA table_info(orders)").fetchall()}
    additions={
        "promise_mode":"TEXT NOT NULL DEFAULT 'asap'",
        "promised_at":"TEXT",
        "promise_version":"TEXT",
        "promise_snapshot_json":"TEXT",
    }
    for name,typ in additions.items():
        if name not in cols: c.execute(f"ALTER TABLE orders ADD COLUMN {name} {typ}")
    c.commit()



def _v041_compute_promise(c, merchant_id, fulfillment_mode="asap", scheduled_for=None):
    from datetime import datetime, timedelta
    m=c.execute("SELECT prep_minutes FROM merchants WHERE id=?",(merchant_id,)).fetchone()
    merchant_prep=int(m["prep_minutes"] if m else 20)
    cap=c.execute("SELECT * FROM merchant_capacity_settings WHERE merchant_id=?",(merchant_id,)).fetchone()
    if not cap:
        cap={"max_parallel_orders":8,"avg_prep_buffer_minutes":5,"courier_buffer_minutes":10}
        c.execute("INSERT OR IGNORE INTO merchant_capacity_settings VALUES (?,?,?,?)",
                  (merchant_id,8,5,10))
    active=c.execute("""SELECT COUNT(*) n FROM orders
        WHERE merchant_id=? AND status IN ('merchant_pending','preparing','dispatch_pending','assigned','picked_up','out_for_delivery','delayed')""",
        (merchant_id,)).fetchone()["n"]
    load_factor=max(0,float(active)/max(1,int(cap["max_parallel_orders"])))
    load_buffer=round(load_factor*20)
    if fulfillment_mode=="scheduled" and scheduled_for:
        base=datetime.fromisoformat(str(scheduled_for).replace("Z","+00:00"))
        promised=base
    else:
        promised=datetime.now()+timedelta(minutes=merchant_prep+int(cap["avg_prep_buffer_minutes"])+int(cap["courier_buffer_minutes"])+load_buffer)
    return {
        "promised_at": promised.isoformat(),
        "promise_version":"v041",
        "mode":fulfillment_mode,
        "active_orders":int(active),
        "load_factor":round(load_factor,3),
        "prep_minutes":merchant_prep,
        "prep_buffer_minutes":int(cap["avg_prep_buffer_minutes"]),
        "courier_buffer_minutes":int(cap["courier_buffer_minutes"]),
        "load_buffer_minutes":load_buffer
    }



def _v042_attach_promise(c, order_id, merchant_id, fulfillment_mode="asap", scheduled_for=None):
    snap=_v041_compute_promise(c,merchant_id,fulfillment_mode,scheduled_for)
    c.execute("""UPDATE orders
                 SET promise_mode=?,promised_at=?,promise_version=?,promise_snapshot_json=?,updated_at=?
                 WHERE id=?""",
              (snap["mode"],snap["promised_at"],snap["promise_version"],
               json.dumps(snap,ensure_ascii=False),now(),order_id))
    return snap

def _v042_dispatch_score(c, order):
    # Lower is better: prioritize jobs closest to their promise deadline.
    import datetime
    promised=order["promised_at"]
    if not promised:
        return 10**9
    try:
        p=datetime.datetime.fromisoformat(str(promised).replace("Z","+00:00"))
        n=datetime.datetime.now(p.tzinfo)
        mins=(p-n).total_seconds()/60
    except Exception:
        mins=60
    # Scheduled jobs are intentionally prioritized as their window approaches.
    mode=order["fulfillment_mode"] or "asap"
    if mode=="scheduled" and order["scheduled_for"]:
        try:
            s=datetime.datetime.fromisoformat(str(order["scheduled_for"]).replace("Z","+00:00"))
            mins=(s-n).total_seconds()/60
        except Exception:
            pass
    return round(mins,2)



