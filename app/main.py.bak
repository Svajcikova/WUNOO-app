@app.post("/api/v038/merchant/modifier")
def v038_create_modifier(body: dict[str, Any], authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u=current_user(authorization); require_role(u,"merchant")
    gid=body.get("group_id"); name=str(body.get("name","")).strip()
    if not gid or not name: raise HTTPException(400,"group_id a name jsou povinné")
    price=float(body.get("price_czk",0))
    if price<0: raise HTTPException(400,"Neplatná cena")
    with core_db_connect() as c:
        g=c.execute("SELECT id FROM modifier_groups WHERE id=? AND merchant_id=? AND active=1",(gid,u["merchant_id"])).fetchone()
        if not g: raise HTTPException(404,"Modifier group nenalezena")
        mid="mo_"+uuid.uuid4().hex[:10]
        c.execute("INSERT INTO modifiers VALUES (?,?,?,?,?)",(mid,gid,name,price,1))
        c.commit()
    return {"id":mid,"group_id":gid,"name":name,"price_czk":price,"active":1}

