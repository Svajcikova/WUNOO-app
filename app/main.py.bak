@app.post("/api/v064/orders/{order_id}/cancel")
def v064_cancel_order(order_id:str, body:dict[str,Any], authorization:str|None=Header(default=None), idempotency_key:str|None=Header(default=None,alias="Idempotency-Key"))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"customer","merchant","admin","ops_agent"})
    reason=str(body.get("reason_code","customer_request")).strip()
    allowed={"customer_request","merchant_rejected","payment_failed","courier_failed","duplicate","fraud_review"}
    if reason not in allowed: raise HTTPException(400,"Neplatný reason_code")
    with core_db_connect() as c:
        cached=_v052_guard(c,f"cancel:{u['id']}",idempotency_key,{"order_id":order_id,"reason_code":reason})
        if cached is not None:return cached
        o=c.execute("SELECT * FROM orders WHERE id=?",(order_id,)).fetchone()
        if not o: raise HTTPException(404,"Objednávka nenalezena")
        if u["role"]=="customer" and o["customer_id"]!=u["customer_id"]: raise HTTPException(403,"forbidden")
        if u["role"]=="merchant" and o["merchant_id"]!=u.get("merchant_id"): raise HTTPException(403,"forbidden")
        if o["status"] in ("delivered","merchant_rejected","cancelled","refunded","payment_failed","payment_cancelled"):
            raise HTTPException(409,"Objednávku již nelze zrušit")
        atomic_transition_any(c, order_id, ("payment_pending","merchant_pending","preparing","dispatch_pending","assigned","picked_up","out_for_delivery","confirmed","ready_for_pickup","courier_assigned"), "cancelled", u, "order_cancelled", {"reason_code": reason})
        c.execute("INSERT INTO order_cancellations VALUES (?,?,?,?,?,?)",
                  ("can_"+uuid.uuid4().hex[:12],order_id,u["id"],reason,str(body.get("note",""))[:500],now()))
        emit(c,order_id,"order_cancelled",{"reason_code":reason},u["id"])
        result={"order_id":order_id,"status":"cancelled","reason_code":reason}
        _v052_store(c,f"cancel:{u['id']}",idempotency_key,{"order_id":order_id,"reason_code":reason},result)
        _v052_audit(c,u["id"],"order_cancel","order",order_id,result)
        c.commit();return result

@app.post("/api/v064/refunds")
def v064_create_refund(body:dict[str,Any], authorization:str|None=Header(default=None), idempotency_key:str|None=Header(default=None,alias="Idempotency-Key"))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent","merchant"})
    oid=str(body.get("order_id","")).strip(); amount=float(body.get("amount_czk",0)); reason=str(body.get("reason_code","customer_request")).strip()
    if amount<=0: raise HTTPException(400,"Částka refundu musí být > 0")
    with core_db_connect() as c:
        c.execute("BEGIN")
        cached=_v052_guard(c,f"refund:{u['id']}",idempotency_key,{"order_id":oid,"amount_czk":amount,"reason_code":reason})
        if cached is not None:return cached
        o=c.execute("SELECT * FROM orders WHERE id=?",(oid,)).fetchone()
        if not o: raise HTTPException(404,"Objednávka nenalezena")
        if u["role"]=="merchant" and o["merchant_id"]!=u.get("merchant_id"): raise HTTPException(403,"forbidden")
        paid=c.execute("SELECT COALESCE(SUM(amount_czk),0) n FROM payments WHERE order_id=? AND status='captured'",(oid,)).fetchone()["n"]
        refunded=c.execute("SELECT COALESCE(SUM(amount_czk),0) n FROM refunds WHERE order_id=? AND status IN ('pending','processed')",(oid,)).fetchone()["n"]
        remaining=round(float(paid)-float(refunded),2)
        if amount>remaining+0.01: raise HTTPException(409,f"Refund převyšuje zbývající refundovatelnou částku {remaining:.2f} Kč")
        rid="ref_"+uuid.uuid4().hex[:12]
        payment=c.execute("SELECT id FROM payments WHERE order_id=? AND status='captured' ORDER BY created_at DESC LIMIT 1",(oid,)).fetchone()
        insert_refund(c, rid, oid, payment["id"] if payment else None, amount, reason, "processed", "demo_ref_"+uuid.uuid4().hex[:10])
        emit(c,oid,"refund_processed",{"refund_id":rid,"amount_czk":round(amount,2),"reason_code":reason},u["id"])
        if round(float(refunded)+amount,2)>=round(float(paid),2):
            atomic_transition_any(c, oid, ("cancelled","delivered","merchant_rejected","payment_failed","payment_cancelled","refunded","merchant_pending","preparing","dispatch_pending","assigned","picked_up","out_for_delivery","confirmed","ready_for_pickup","courier_assigned"), "refunded", u, "refund_completed", {"amount_czk": round(amount, 2)})
        _v052_store(c,f"refund:{u['id']}",idempotency_key,{"order_id":oid,"amount_czk":amount,"reason_code":reason},
                    {"refund_id":rid,"order_id":oid,"amount_czk":round(amount,2),"status":"processed"})
        _v052_audit(c,u["id"],"refund","order",oid,{"refund_id":rid,"amount_czk":amount,"reason_code":reason})
        c.commit()
        return {"refund_id":rid,"order_id":oid,"amount_czk":round(amount,2),"status":"processed"}

@app.get("/api/v064/orders/{order_id}/exceptions")
def v064_order_exceptions(order_id:str, authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent","merchant","customer"})
    with core_db_connect() as c:
        o=c.execute("SELECT * FROM orders WHERE id=?",(order_id,)).fetchone()
        if not o: raise HTTPException(404,"Objednávka nenalezena")
        if u["role"]=="customer" and o["customer_id"]!=u["customer_id"]: raise HTTPException(403,"forbidden")
        if u["role"]=="merchant" and o["merchant_id"]!=u.get("merchant_id"): raise HTTPException(403,"forbidden")
        canc=c.execute("SELECT * FROM order_cancellations WHERE order_id=? ORDER BY created_at",(order_id,)).fetchall()
        refs=c.execute("SELECT * FROM refunds WHERE order_id=? ORDER BY created_at",(order_id,)).fetchall()
        return {"order_id":order_id,"cancellations":[dict(x) for x in canc],"refunds":[dict(x) for x in refs]}

