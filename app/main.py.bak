@app.post("/api/v059/payment/create")
def v059_payment_create(body:dict[str,Any], authorization:str|None=Header(default=None), idempotency_key:str|None=Header(default=None,alias="Idempotency-Key"))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"customer"})
    oid=str(body.get("order_id","")).strip()
    if not oid: raise HTTPException(400,"order_id je povinné")
    with core_db_connect() as c:
        cached=_v052_guard(c,f"payment-create:{u['id']}",idempotency_key,{"order_id":oid})
        if cached is not None:return cached
        o=c.execute("SELECT * FROM orders WHERE id=? AND customer_id=?",(oid,u["customer_id"])).fetchone()
        if not o: raise HTTPException(404,"Objednávka nenalezena")
        if o["status"] not in ("payment_pending","pending_payment"): raise HTTPException(409,"Objednávka není ve stavu pro platbu")
        existing=c.execute("SELECT * FROM payment_intents WHERE order_id=? ORDER BY created_at DESC LIMIT 1",(oid,)).fetchone()
        if existing:
            result={"payment_intent_id":existing["id"],"order_id":oid,"status":existing["status"],"amount_czk":existing["amount_czk"]}
        else:
            pid="pi_"+uuid.uuid4().hex[:12]
            provider="wunoo_demo_"+uuid.uuid4().hex[:12]
            c.execute("INSERT INTO payment_intents VALUES (?,?,?,?,?,?,?,?,?)",
                      (pid,oid,o["total_czk"],"CZK","requires_payment_method","demo",provider,now(),now()))
            result={"payment_intent_id":pid,"order_id":oid,"status":"requires_payment_method","amount_czk":o["total_czk"],"currency":"CZK"}
        _v052_store(c,f"payment-create:{u['id']}",idempotency_key,{"order_id":oid},result)
        _v052_audit(c,u["id"],"payment_create","order",oid,{"amount_czk":o["total_czk"]})
        c.commit()
        return result

@app.post("/api/v059/payment/webhook")
async def v059_payment_webhook(
    request: Request,
    x_wunoo_signature: str | None = Header(default=None, alias="X-WUNOO-Signature"),
)->dict[str,Any]:
    raw=await request.body()
    _verify_webhook_signature(raw, x_wunoo_signature, required=True)
    try:
        body=json.loads(raw.decode("utf-8"))
    except Exception:
        raise HTTPException(400, "Neplatné JSON tělo webhooku")
    return _process_v059_payment_webhook(body)

def _process_v059_payment_webhook(body:dict[str,Any])->dict[str,Any]:
    provider_event_id=str(body.get("id",""))
    event_type=str(body.get("type",""))
    intent_id=str(body.get("payment_intent_id",""))
    if not provider_event_id or not event_type: raise HTTPException(400,"Webhook id a type jsou povinné")
    allowed={"payment_succeeded","payment_failed","payment_cancelled"}
    if event_type not in allowed: raise HTTPException(400,"Nepodporovaný payment event")
    with closing(conn()) as c:
        exists=c.execute("SELECT * FROM payment_webhook_events WHERE provider_event_id=?",(provider_event_id,)).fetchone()
        if exists:return {"accepted":True,"duplicate":True,"status":exists["status"]}
        wid="pwh_"+uuid.uuid4().hex[:12]
        c.execute("""INSERT INTO payment_webhook_events
                     (id,provider_event_id,event_type,payment_intent_id,payload_json,status,processed_at,created_at)
                     VALUES (?,?,?,?,?,?,?,?)""",
                  (wid,provider_event_id,event_type,intent_id,json.dumps(body,ensure_ascii=False),"received",None,now()))
        pi=c.execute("SELECT * FROM payment_intents WHERE id=?",(intent_id,)).fetchone()
        if not pi: raise HTTPException(404,"Payment intent nenalezen")
        actor = {"id": "system:payment_webhook"}
        if event_type=="payment_succeeded":
            c.execute("UPDATE payment_intents SET status='succeeded',updated_at=? WHERE id=?",(now(),intent_id))
            transition(c, pi["order_id"], "payment_pending", "merchant_pending", actor, "payment_succeeded", {"payment_intent_id":intent_id})
        elif event_type=="payment_failed":
            c.execute("UPDATE payment_intents SET status='failed',updated_at=? WHERE id=?",(now(),intent_id))
            transition(c, pi["order_id"], "payment_pending", "payment_failed", actor, "payment_failed", {"payment_intent_id":intent_id})
        else:
            c.execute("UPDATE payment_intents SET status='cancelled',updated_at=? WHERE id=?",(now(),intent_id))
            transition(c, pi["order_id"], "payment_pending", "payment_cancelled", actor, "payment_cancelled", {"payment_intent_id":intent_id})
        c.execute("UPDATE payment_webhook_events SET status='processed',processed_at=? WHERE id=?",(now(),wid))
        _v053_log(c,"info","payment_webhook_processed",wid,{"event_type":event_type,"payment_intent_id":intent_id})
        c.commit()
        return {"accepted":True,"duplicate":False,"event_type":event_type,"payment_intent_id":intent_id}

@app.get("/api/v059/payment/{payment_intent_id}")
