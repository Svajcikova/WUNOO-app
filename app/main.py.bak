@asynccontextmanager
async def app_lifespan(app: FastAPI):
    from app.repository import configure_postgres_pool, IS_POSTGRES
    enforce_database_runtime_guard()
    if IS_POSTGRES:
        configure_postgres_pool()
        _v142_bootstrap_postgresql()
    else:
        init_db()
        with closing(conn()) as c:
            _run_all_migrations(c)
        _v136_ensure_baselines()
    yield
    if IS_POSTGRES:
        from app.repository import _pg_pool
        if _pg_pool is not None:
            _pg_pool.close()


def migrate_v128(c):
    """Persistence hardening metadata and concurrency-safe SQLite indexes.

    v1.28 does not silently switch production traffic to PostgreSQL. It makes
    the backend choice explicit, hardens the local SQLite fallback for
    concurrent workers, and records a schema contract used by the production
    PostgreSQL migration tooling.
    """
    c.execute("""CREATE TABLE IF NOT EXISTS persistence_contracts(
        id TEXT PRIMARY KEY, backend TEXT NOT NULL, contract_version TEXT NOT NULL,
        checksum TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL,
        UNIQUE(backend, contract_version, checksum)
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_orders_status_updated ON orders(status, updated_at)")
    c.execute("CREATE INDEX IF NOT EXISTS idx_orders_merchant_status ON orders(merchant_id, status, updated_at)")
    c.execute("CREATE INDEX IF NOT EXISTS idx_orders_courier_status ON orders(courier_id, status, updated_at)")
    if c.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='idempotency_keys'").fetchone():
        cols={r[1] for r in c.execute("PRAGMA table_info(idempotency_keys)").fetchall()}
        if {"scope","key"}.issubset(cols):
            c.execute("CREATE INDEX IF NOT EXISTS idx_idempotency_scope_key ON idempotency_keys(scope, key)")
    checksum=hashlib.sha256("wunoo-postgresql-core-v1.28".encode()).hexdigest()
    row=c.execute("SELECT 1 FROM persistence_contracts WHERE backend='postgresql' AND contract_version='1.28' AND checksum=?",(checksum,)).fetchone()
    if not row:
        c.execute("INSERT INTO persistence_contracts(id,backend,contract_version,checksum,status,created_at) VALUES(?,?,?,?,?,?)",
                  ("pc_"+uuid.uuid4().hex[:12],"postgresql","1.28",checksum,"contract_ready",now()))


def migrate_v130(c):
    """Record the production PostgreSQL gate and concurrency contract.

    v1.30 deliberately does not pretend that a local SQLite test is a live
    PostgreSQL deployment. It records the required production capabilities so
    the cutover can be verified explicitly before traffic is enabled.
    """
    c.execute("""CREATE TABLE IF NOT EXISTS v130_production_gates(
        id TEXT PRIMARY KEY,
        gate_name TEXT NOT NULL,
        required_backend TEXT NOT NULL,
        status TEXT NOT NULL,
        details_json TEXT NOT NULL DEFAULT '{}',
        checked_at TEXT NOT NULL
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_v130_gate_name_time ON v130_production_gates(gate_name,checked_at DESC)")
    gates = [
        ("postgres_driver", "postgresql"),
        ("connection_pool", "postgresql"),
        ("transaction_isolation", "postgresql"),
        ("conditional_order_transition", "postgresql"),
        ("idempotency_unique_constraint", "postgresql"),
        ("multi_process_concurrency", "postgresql"),
    ]
    for name, backend in gates:
        exists=c.execute("SELECT 1 FROM v130_production_gates WHERE gate_name=? AND required_backend=? LIMIT 1",(name,backend)).fetchone()
        if not exists:
            c.execute("INSERT INTO v130_production_gates VALUES(?,?,?,?,?,?)",
                      ("pg30_"+uuid.uuid4().hex[:12],name,backend,"pending",json.dumps({"source":"v1.30_contract"}),now()))
    c.commit()


def migrate_v131(c):
    """PostgreSQL schema/migration manifest and local migration journal.

    v1.31 provides the repeatable production schema contract. It does not
    execute PostgreSQL DDL through the SQLite connection; live execution is
    performed by the standalone migration runner against WUNOO_DATABASE_URL.
    """
    c.execute("""CREATE TABLE IF NOT EXISTS schema_migrations(
        version TEXT PRIMARY KEY, checksum TEXT NOT NULL, description TEXT NOT NULL,
        applied_at TEXT NOT NULL, status TEXT NOT NULL
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_schema_migrations_applied ON schema_migrations(applied_at DESC)")
    checksum=hashlib.sha256((BASE.parent / 'migrations' / 'postgresql' / '001_initial_schema.sql').read_bytes()).hexdigest() if (BASE.parent / 'migrations' / 'postgresql' / '001_initial_schema.sql').exists() else 'pending'
    row=c.execute("SELECT 1 FROM schema_migrations WHERE version='1.31.001' AND checksum=?",(checksum,)).fetchone()
    if not row:
        c.execute("INSERT INTO schema_migrations(version,checksum,description,applied_at,status) VALUES(?,?,?,?,?) ON CONFLICT(version) DO UPDATE SET checksum=excluded.checksum,description=excluded.description,applied_at=excluded.applied_at,status=excluded.status",('1.31.001',checksum,'PostgreSQL canonical initial schema','', 'planned'))
    c.commit()


def migrate_v034(c):
    c.execute("""CREATE TABLE IF NOT EXISTS merchant_profiles(
        merchant_id TEXT PRIMARY KEY REFERENCES merchants(id) ON DELETE CASCADE,
        category TEXT,
        cuisine TEXT,
        min_order_czk REAL NOT NULL DEFAULT 0,
        opening_hours_json TEXT NOT NULL DEFAULT '{}',
        rating_avg REAL NOT NULL DEFAULT 0,
        rating_count INTEGER NOT NULL DEFAULT 0
    )""")
    c.execute("""CREATE TABLE IF NOT EXISTS merchant_delivery_zones(
        merchant_id TEXT NOT NULL REFERENCES merchants(id) ON DELETE CASCADE,
        city TEXT NOT NULL,
        radius_km REAL NOT NULL DEFAULT 8,
        PRIMARY KEY(merchant_id, city)
    )""")
    c.execute("""CREATE TABLE IF NOT EXISTS merchant_reviews(
        id TEXT PRIMARY KEY,
        merchant_id TEXT NOT NULL REFERENCES merchants(id) ON DELETE CASCADE,
        customer_id TEXT NOT NULL REFERENCES customers(id) ON DELETE CASCADE,
        order_id TEXT REFERENCES orders(id) ON DELETE SET NULL,
        rating INTEGER NOT NULL CHECK(rating BETWEEN 1 AND 5),
        comment TEXT,
        created_at TEXT NOT NULL
    )""")
    c.execute("""CREATE INDEX IF NOT EXISTS idx_reviews_merchant ON merchant_reviews(merchant_id, created_at)""")
    c.execute("""CREATE INDEX IF NOT EXISTS idx_zones_merchant_city ON merchant_delivery_zones(merchant_id, city)""")
    merchants = c.execute("SELECT id FROM merchants").fetchall()
    default_hours = '{"mon":["10:00","22:00"],"tue":["10:00","22:00"],"wed":["10:00","22:00"],"thu":["10:00","22:00"],"fri":["10:00","23:00"],"sat":["11:00","23:00"],"sun":["11:00","21:00"]}'
    for m in merchants:
        mid = m["id"]
        exists = c.execute("SELECT 1 FROM merchant_profiles WHERE merchant_id=?", (mid,)).fetchone()
        if not exists:
            name = c.execute("SELECT name FROM merchants WHERE id=?", (mid,)).fetchone()["name"]
            lower = name.lower()
            category = "Pizza" if "pizza" in lower else ("Asian" if "katsu" in lower else "Bistro")
            cuisine = "Italská" if category == "Pizza" else ("Japonská" if category == "Asian" else "Moderní česká")
            c.execute(
                "INSERT INTO merchant_profiles VALUES (?,?,?,?,?,?,?)",
                (mid, category, cuisine, 0, default_hours, 4.7, 0)
            )
            c.execute("INSERT OR IGNORE INTO merchant_delivery_zones VALUES (?,?,?)", (mid, "Ostrava", 8.0))
    c.commit()



def _v035_haversine(lat1, lon1, lat2, lon2):
    from math import radians, sin, cos, asin, sqrt
    rlat1, rlon1, rlat2, rlon2 = map(radians, [lat1, lon1, lat2, lon2])
    dlat, dlon = rlat2-rlat1, rlon2-rlon1
    a = sin(dlat/2)**2 + cos(rlat1)*cos(rlat2)*sin(dlon/2)**2
    return 2*6371.0*asin(sqrt(a))

def _v035_is_open_now(hours, now_local):
    key=now_local.strftime("%a").lower()[:3]
    mapping={"mon":"mon","tue":"tue","wed":"wed","thu":"thu","fri":"fri","sat":"sat","sun":"sun"}
    key=mapping.get(key,key)
    pair=hours.get(key)
    if not pair or len(pair)!=2:
        return False
    hhmm=lambda s: int(s.split(":")[0])*60+int(s.split(":")[1])
    cur=now_local.hour*60+now_local.minute
    start,end=hhmm(pair[0]),hhmm(pair[1])
    if end >= start:
        return start <= cur <= end
    return cur >= start or cur <= end

def _v035_delivery_fee(distance_km):
    d=float(distance_km or 0)
    if d <= 2: return 35.0
    if d <= 4: return 49.0
    if d <= 6: return 65.0
    if d <= 8: return 79.0
    return None



