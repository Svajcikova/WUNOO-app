@app.post("/api/merchant/menu")
def v20_merchant_create_menu(body: dict[str, Any], authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u = current_user(authorization); require_role(u, "merchant")
    name = str(body.get("name") or "").strip()
    price = float(body.get("price_czk", 0))
    if len(name) < 2 or price <= 0:
        raise HTTPException(400, "name a price_czk jsou povinné")
    iid = "mi_" + uuid.uuid4().hex[:10]
    with core_db_connect() as c:
        c.execute("INSERT INTO menu_items(id,merchant_id,name,price_czk,active) VALUES (?,?,?,?,1)", (iid, u["merchant_id"], name, price))
        emit(c, None, "menu_item_created", {"menu_item_id": iid, "merchant_id": u["merchant_id"], "price_czk": price}, u["id"])
        c.commit()
        return dict(c.execute("SELECT * FROM menu_items WHERE id=?", (iid,)).fetchone())

@app.patch("/api/merchant/menu/{menu_item_id}")
def v20_merchant_update_menu(menu_item_id: str, body: dict[str, Any], authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u = current_user(authorization); require_role(u, "merchant")
    name = str(body.get("name") or "").strip()
    price = float(body.get("price_czk", 0))
    if len(name) < 2 or price <= 0: raise HTTPException(400, "Neplatné menu")
    with core_db_connect() as c:
        row = c.execute("SELECT * FROM menu_items WHERE id=? AND merchant_id=?", (menu_item_id, u["merchant_id"])).fetchone()
        if not row: raise HTTPException(404, "Položka menu nenalezena")
        c.execute("UPDATE menu_items SET name=?, price_czk=? WHERE id=?", (name, price, menu_item_id))
        emit(c, None, "menu_item_updated", {"menu_item_id": menu_item_id, "price_czk": price}, u["id"])
        c.commit()
        return dict(c.execute("SELECT * FROM menu_items WHERE id=?", (menu_item_id,)).fetchone())

@app.delete("/api/merchant/menu/{menu_item_id}")
def v20_merchant_disable_menu(menu_item_id: str, authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u = current_user(authorization); require_role(u, "merchant")
    with core_db_connect() as c:
        row = c.execute("SELECT 1 FROM menu_items WHERE id=? AND merchant_id=?", (menu_item_id, u["merchant_id"])).fetchone()
        if not row: raise HTTPException(404, "Položka menu nenalezena")
        c.execute("UPDATE menu_items SET active=0 WHERE id=?", (menu_item_id,))
        emit(c, None, "menu_item_disabled", {"menu_item_id": menu_item_id}, u["id"])
        c.commit()
    return {"menu_item_id": menu_item_id, "active": 0}

