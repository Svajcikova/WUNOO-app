        if not chain['valid']: raise HTTPException(409,'checkpoint chain invalid: '+chain['reason'])
        if not _v174_trusted(str(payload['public_key_b64'])): raise HTTPException(409,'witness key is not trusted')
        rp=_v174_receipt_payload(payload['checkpoint_sha256'],payload['witness_id'],payload['witness_system'],payload['witnessed_at']); digest=_v174_hash(rp)
        existing=_v170_row(c,'production_release_external_witness_receipts',' WHERE checkpoint_sha256=? AND witness_id=?',(rp['checkpoint_sha256'],rp['witness_id']),'created_at DESC')
        if existing:
            vr=_v174_verify_receipt(existing,cp)
            if not vr['valid']: raise HTTPException(409,'existing witness receipt invalid: '+vr['reason'])
            return {'schema_version':'1.74','receipt_id':existing['id'],'receipt_sha256':existing['receipt_sha256'],'idempotent':True,'verification':_v174_verify_all(c)}
        rid='wvr_'+uuid.uuid4().hex[:16]; created=now()
        try:
            _,Ed25519PublicKey,_,_,_,_=_v169_crypto(); Ed25519PublicKey.from_public_bytes(base64.b64decode(payload['public_key_b64'])).verify(base64.b64decode(payload['signature_b64']),json.dumps(rp,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode())
        except Exception: raise HTTPException(409,'witness signature invalid')
        c.execute('INSERT INTO production_release_external_witness_receipts(id,checkpoint_id,checkpoint_sha256,witness_id,witness_system,witnessed_at,receipt_sha256,algorithm,public_key_b64,signature_b64,receipt_json,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(rid,cp['id'],rp['checkpoint_sha256'],rp['witness_id'],rp['witness_system'],rp['witnessed_at'],digest,'Ed25519',payload['public_key_b64'],payload['signature_b64'],json.dumps(rp,sort_keys=True,separators=(',',':'),ensure_ascii=False),'VERIFIED',created,str(u.get('email') or u.get('id') or 'operator'))); c.commit()
        return {'schema_version':'1.74','receipt_id':rid,'receipt_sha256':digest,'idempotent':False,'receipt':rp,'verification':_v174_verify_all(c)}
@app.post('/api/v174/ops/external-witness/verify')
def v174_verify(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        result=_v174_verify_all(c)
        if not result['valid']: raise HTTPException(409,result['reason'])
        if payload and payload.get('receipt_id'):
            row=_v170_row(c,'production_release_external_witness_receipts',' WHERE id=?',(payload['receipt_id']),'created_at DESC')
            if not row: raise HTTPException(404,'witness receipt nenalezen')
            cp=_v170_row(c,'production_release_transparency_checkpoints',' WHERE checkpoint_sha256=?',(row['checkpoint_sha256']),'checkpoint_no DESC')
            result['receipt']=_v174_verify_receipt(row,cp)
        return {'schema_version':'1.74','verification':result}
@app.get('/api/v174/ops/external-witness/latest')
def v174_latest(authorization: str|None=Header(default=None)):
