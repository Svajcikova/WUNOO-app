class V067RateLimitMiddleware(BaseHTTPMiddleware):
    async def dispatch(self, request:Request, call_next):
        path=request.url.path
        if path.startswith("/api/"):
            try:
                with closing(conn()) as c:
                    _v067_rate_limit(c,_v067_client_bucket(request),120)
                    c.commit()
            except HTTPException as exc:
                return JSONResponse(status_code=exc.status_code,content={"detail":str(exc.detail)})
            except Exception as exc:
                if v100_config().get("production"):
                    return JSONResponse(status_code=503, content={"detail":"Rate limiter unavailable"})
        return await call_next(request)

app.add_middleware(V067RateLimitMiddleware)

class V072ObservabilityMiddleware(BaseHTTPMiddleware):
    async def dispatch(self, request:Request, call_next):
        import time as _time
        started=_time.perf_counter()
        rid=request.headers.get("x-request-id") or ("req_"+uuid.uuid4().hex[:16])
        try:
            response=await call_next(request)
            status=response.status_code
        except Exception:
            status=500
            raise
        finally:
            duration=round((_time.perf_counter()-started)*1000,3)
            try:
                with closing(conn()) as c:
                    c.execute("""INSERT INTO request_metrics
                        (id,request_id,method,path,status_code,duration_ms,created_at)
                        VALUES (?,?,?,?,?,?,?)""",
                        ("rm_"+uuid.uuid4().hex[:12],rid,request.method,request.url.path,status,duration,now()))
                    c.execute("""INSERT INTO app_logs
                        (id,level,event,request_id,user_id,metadata_json,created_at)
                        VALUES (?,?,?,?,?,?,?)""",
                        ("log_"+uuid.uuid4().hex[:12],"INFO","http_request",rid,None,
                         json.dumps({"status_code":status,"duration_ms":duration},ensure_ascii=False),now()))
                    c.commit()
            except Exception:
                pass
        response.headers["X-Request-ID"]=rid
        return response


app.add_middleware(V072ObservabilityMiddleware)
app.mount("/static", StaticFiles(directory=BASE / "static"), name="static")

