# ---------------- v1.56 Controlled Production Rollout Gate ----------------
def migrate_v156(c):
    c.execute("""CREATE TABLE IF NOT EXISTS controlled_rollout_runs(
        id TEXT PRIMARY KEY, release_version TEXT NOT NULL, phase TEXT NOT NULL,
        decision TEXT NOT NULL, canary_percent INTEGER NOT NULL DEFAULT 0,
        deployment_id TEXT, health_window_id TEXT, attestation_id TEXT,
        checks_json TEXT NOT NULL DEFAULT '{}', operator TEXT, created_at TEXT NOT NULL,
        completed_at TEXT
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_controlled_rollout_version_time ON controlled_rollout_runs(release_version, created_at DESC)")
    try: c.commit()
    except Exception: pass

def _v156_rollout_gate() -> dict[str, Any]:
    att=_v155_attestation_gate()
    production=_v146_production_env()
    blockers=[]
    if not production: blockers.append('production_environment_required')
    if production and att.get('decision')!='GO_LIVE': blockers.append('v155_attestation_not_go_live')
    # A rollout gate never fabricates a live traffic shift. It proves the prerequisites
    # and records an operator-controlled canary phase for an external deployment system.
    return {
        'schema_version':'1.56','gate':'controlled_production_rollout',
        'decision':'GO_CANARY' if not blockers else 'HOLD', 'passed':not blockers,
        'blocking_reasons':blockers,'production_environment':production,
        'attestation':att,
        'rollout_policy':{
            'phases':['preflight','canary','health_window','e2e_verification','full_rollout','complete'],
            'canary_requires_operator_control':True,
            'traffic_shift_is_external':True,
            'automatic_schema_rollback':False,
            'rollback_action':'RECOMMEND_ROLLBACK_ONLY'
        }
    }

def _v156_start_rollout(payload: dict[str,Any], operator: str|None=None) -> dict[str,Any]:
    gate=_v156_rollout_gate()
    if not gate['passed']:
        return {'schema_version':'1.56','decision':'HOLD','phase':'preflight','gate':gate}
    canary=int(payload.get('canary_percent',10) or 10)
    if canary < 1 or canary > 50: raise HTTPException(422,'canary_percent must be between 1 and 50')
    rid='rollout_'+uuid.uuid4().hex[:16]
    deployment_id=str(payload.get('deployment_id') or '') or None
    with core_db_connect() as c:
        c.execute('INSERT INTO controlled_rollout_runs(id,release_version,phase,decision,canary_percent,deployment_id,checks_json,operator,created_at) VALUES(?,?,?,?,?,?,?,?,?)',
                  (rid,'1.56','canary','GO_CANARY',canary,deployment_id,json.dumps(gate,sort_keys=True),operator,now()))
        c.commit()
    return {'schema_version':'1.56','run_id':rid,'phase':'canary','decision':'GO_CANARY','canary_percent':canary,'deployment_id':deployment_id,'gate':gate}

def _v156_advance_rollout(run_id: str, payload: dict[str,Any], operator: str|None=None) -> dict[str,Any]:
    with core_db_connect() as c:
        row=c.execute('SELECT * FROM controlled_rollout_runs WHERE id=?',(run_id,)).fetchone()
    if not row: raise HTTPException(404,'rollout run nenalezen')
    phase=row['phase']
    if phase in {'complete','halted'}: return {'schema_version':'1.56',**dict(row)}
    att=_v155_attestation_gate()
    requested=str(payload.get('phase') or '')
    order=['preflight','canary','health_window','e2e_verification','full_rollout','complete']
    next_phase={'canary':'health_window','health_window':'e2e_verification','e2e_verification':'full_rollout','full_rollout':'complete'}.get(phase)
    if requested and requested!=next_phase: raise HTTPException(422,f'next phase must be {next_phase}')
    checks={'attestation':att,'operator_confirmation':bool(payload.get('operator_confirmed',False)),'phase':next_phase}
    if next_phase in {'full_rollout','complete'} and not checks['operator_confirmation']:
        return {'schema_version':'1.56','run_id':run_id,'phase':phase,'decision':'HOLD','required':'operator_confirmed', 'checks':checks}
    decision='GO_FULL_ROLLOUT' if next_phase=='full_rollout' else ('COMPLETE' if next_phase=='complete' else 'CONTINUE')
    with core_db_connect() as c:
        c.execute('UPDATE controlled_rollout_runs SET phase=?,decision=?,checks_json=?,operator=?,'
                  'completed_at=? WHERE id=?',
                  (next_phase,decision,json.dumps(checks,sort_keys=True),operator or row.get('operator'),now() if next_phase=='complete' else None,run_id))
        c.commit()
    return {'schema_version':'1.56','run_id':run_id,'phase':next_phase,'decision':decision,'checks':checks}

@app.get('/api/v156/ops/rollout-gate')
def v156_rollout_gate(authorization: str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); return _v156_rollout_gate()

