@app.post("/api/v052/mutations/{domain}")
def v052_mutation(domain:str, body:dict[str,Any],
                  authorization:str|None=Header(default=None),
                  idempotency_key:str|None=Header(default=None,alias="Idempotency-Key"))->dict[str,Any]:
    u=current_user(authorization)
    permissions={
        "order": {"customer","merchant","ops_agent","admin"},
        "payment": {"customer","admin"},
        "refund": {"admin","ops_agent"},
        "dispatch": {"courier","ops_agent","admin"},
        "delivery": {"courier","admin"},
        "recovery": {"ops_agent","admin"},
    }
    if domain not in permissions: raise HTTPException(404,"Unknown mutation domain")
    if u["role"] not in permissions[domain]: raise HTTPException(403,"forbidden")
    with core_db_connect() as c:
        cached=_v052_guard(c,f"{domain}:{u['id']}",idempotency_key,body)
        if cached is not None: return cached

        # v0.52 deliberately acts as a hardened command envelope.
        # Existing domain-specific endpoints remain the source of truth for state transitions.
        result={"accepted":True,"domain":domain,"command":body.get("command"),"status":"queued",
                "idempotency":"new","actor_role":u["role"]}
        _v052_store(c,f"{domain}:{u['id']}",idempotency_key,body,result)
        _v052_audit(c,u["id"],"mutation_command","mutation",body.get("entity_id"),{"domain":domain,"command":body.get("command")})
        c.commit()
        return result

