        if _v106_hash(obj)!=row['checkpoint_sha256']: return {'valid':False,'reason':'V106_CHECKPOINT_HASH_INVALID'}
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto(); raw=base64.b64decode(row['public_key_b64'],validate=True);Ed25519PublicKey.from_public_bytes(raw).verify(base64.b64decode(row['signature_b64'],validate=True),_v106_json(obj).encode())
        manifest=obj.get('prefix_manifest') or []
