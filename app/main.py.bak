    with core_db_connect() as c:
        rows=c.execute("SELECT id,status,fulfillment_mode,scheduled_for,total_czk,created_at FROM orders WHERE merchant_id=? ORDER BY CASE WHEN scheduled_for IS NULL THEN 0 ELSE 1 END, scheduled_for, created_at",
                       (u["merchant_id"],)).fetchall()
        return {"orders":[dict(r) for r in rows]}

