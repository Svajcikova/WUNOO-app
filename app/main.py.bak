@app.post("/api/v034/merchants/{merchant_id}/review")
def v034_review(merchant_id: str, body: dict[str, Any], authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u=current_user(authorization); require_role(u,"customer")
    rating=int(body.get("rating",0))
    if rating < 1 or rating > 5: raise HTTPException(400,"rating musí být 1-5")
    order_id=body.get("order_id")
    comment=body.get("comment")
    with core_db_connect() as c:
        merchant=c.execute("SELECT 1 FROM merchants WHERE id=? AND active=1",(merchant_id,)).fetchone()
        if not merchant: raise HTTPException(404,"Restaurace nenalezena")
        if order_id:
            ok=c.execute(
                "SELECT 1 FROM orders WHERE id=? AND customer_id=? AND merchant_id=? AND status='delivered'",
                (order_id,u["customer_id"],merchant_id)
            ).fetchone()
            if not ok: raise HTTPException(409,"Recenzi lze přidat jen k doručené vlastní objednávce")
        rid="rev_"+uuid.uuid4().hex[:10]
        c.execute("INSERT INTO merchant_reviews VALUES (?,?,?,?,?,?,?)",(rid,merchant_id,u["customer_id"],order_id,rating,comment,now()))
        agg=c.execute("SELECT AVG(rating) avg_rating, COUNT(*) count_rating FROM merchant_reviews WHERE merchant_id=?",(merchant_id,)).fetchone()
        c.execute("UPDATE merchant_profiles SET rating_avg=?,rating_count=? WHERE merchant_id=?",(round(float(agg["avg_rating"] or 0),2),int(agg["count_rating"]),merchant_id))
        c.commit()
        return {"review_id":rid,"rating":rating,"rating_avg":round(float(agg["avg_rating"] or 0),2),"rating_count":int(agg["count_rating"])}

