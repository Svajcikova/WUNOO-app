def migrate_v138(c):
    """Record the v1.38 order-lifecycle request-layer cutover."""
    c.execute("""CREATE TABLE IF NOT EXISTS request_layer_cutover_v138(
        id TEXT PRIMARY KEY, route_group TEXT NOT NULL, route_count INTEGER NOT NULL,
        backend TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL,
        UNIQUE(route_group)
    )""")
    groups = [
        ("order_read_lifecycle", 4),
        ("order_payment_detail", 1),
        ("merchant_order_lifecycle", 2),
        ("dispatch_lifecycle", 2),
        ("delivery_lifecycle", 3),
        ("order_tracking_eta", 3),
        ("order_recovery", 2),
    ]
    backend = configured_db_backend()
    for group, count in groups:
        if not c.execute("SELECT 1 AS n FROM request_layer_cutover_v138 WHERE route_group=?", (group,)).fetchone():
            c.execute("INSERT INTO request_layer_cutover_v138 VALUES (?,?,?,?,?,?)",
                      ("v138_" + group, group, count, backend, "completed", now()))
            try:
                c.execute("INSERT INTO request_layer_cutover_audit VALUES (?,?,?,?,?,?)",
                          ("v138_" + group, group, "completed", backend, "Order lifecycle request layer cutover", now()))
            except Exception:
                pass
    # v1.138 Customer Menu Integrity: pin carts to the exact LIVE publication.
    cart_cols = _columns(c, "cart_items")
    for name, ddl in [
        ("menu_publication_no", "ALTER TABLE cart_items ADD COLUMN menu_publication_no INTEGER"),
        ("menu_snapshot_sha256", "ALTER TABLE cart_items ADD COLUMN menu_snapshot_sha256 TEXT"),
        ("unit_price_snapshot_czk", "ALTER TABLE cart_items ADD COLUMN unit_price_snapshot_czk REAL"),
        ("menu_item_name_snapshot", "ALTER TABLE cart_items ADD COLUMN menu_item_name_snapshot TEXT"),
    ]:
        if name not in cart_cols:
            c.execute(ddl)
    mod_cols = _columns(c, "cart_item_modifiers")
    for name, ddl in [
        ("name_snapshot", "ALTER TABLE cart_item_modifiers ADD COLUMN name_snapshot TEXT"),
        ("price_snapshot_czk", "ALTER TABLE cart_item_modifiers ADD COLUMN price_snapshot_czk REAL"),
    ]:
        if name not in mod_cols:
            c.execute(ddl)
    c.execute("CREATE INDEX IF NOT EXISTS idx_cart_items_menu_snapshot ON cart_items(customer_id,merchant_id,menu_publication_no,menu_snapshot_sha256)")
    c.execute("CREATE TABLE IF NOT EXISTS customer_menu_integrity_audit("
              "id TEXT PRIMARY KEY,customer_id TEXT NOT NULL,merchant_id TEXT NOT NULL,action TEXT NOT NULL,"
              "publication_no INTEGER,snapshot_sha256 TEXT,result TEXT NOT NULL,details_json TEXT,created_at TEXT NOT NULL)")
    c.execute("CREATE INDEX IF NOT EXISTS idx_customer_menu_integrity_audit_customer ON customer_menu_integrity_audit(customer_id,created_at DESC)")
    c.commit()


