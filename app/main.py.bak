def _v067_client_bucket(request:Request)->str:
    forwarded=request.headers.get("x-forwarded-for")
    return (forwarded.split(",")[0].strip() if forwarded else (request.client.host if request.client else "unknown"))

def _v067_rate_limit(c,bucket:str,limit:int=120):
    import datetime
    minute=datetime.datetime.utcnow().replace(second=0,microsecond=0).isoformat(timespec="seconds")
    row=c.execute("SELECT * FROM api_rate_limits WHERE bucket=? AND window_start=?",(bucket,minute)).fetchone()
    if not row:
        c.execute("INSERT INTO api_rate_limits VALUES (?,?,?,?,?)",("rl_"+uuid.uuid4().hex[:12],bucket,minute,1,now()))
        return
    if int(row["request_count"])>=limit: raise HTTPException(429,"Too many requests")
    c.execute("UPDATE api_rate_limits SET request_count=request_count+1 WHERE id=?",(row["id"],))

@app.get("/healthz")
