def _v109_run(c):
    checks=[]
    def check(name,valid,reason=None,details=None): checks.append({'check':name,'valid':bool(valid),'reason':reason,'details':details})
    for table in _V109_POLICY['required_tables']:
        try: n=int(c.execute("SELECT COUNT(*) n FROM sqlite_master WHERE type='table' AND name=?",(table,)).fetchone()['n'])
        except Exception: n=0
        check('TABLE:'+table,n==1,'MISSING_TABLE' if n!=1 else None,{'present':n==1})
    try:
        cols={r['name'] for r in c.execute('PRAGMA table_info(orders)').fetchall()}
        required={'id','customer_id','merchant_id','status','subtotal_czk','service_fee_czk','delivery_fee_czk','total_czk','created_at','updated_at'}
        check('ORDERS_SCHEMA',required.issubset(cols),'ORDERS_REQUIRED_COLUMNS_MISSING',{'missing':sorted(required-cols)})
    except Exception as e: check('ORDERS_SCHEMA',False,'SCHEMA_EXCEPTION',str(e))
    invalid=[]
    terminal_states={'payment_failed','payment_cancelled'}
    known_states=set(ORDER_STATES)|terminal_states
    for state,targets in ORDER_STATES.items():
        for target in targets:
            if target not in known_states and target not in invalid: invalid.append(target)
    check('ORDER_STATE_GRAPH',not invalid,'UNKNOWN_TARGET_STATE',{'unknown_targets':invalid,'states':len(known_states),'terminal_states':sorted(terminal_states)})
    try:
        unique_contracts={('payments','order_id'),('payments','provider_payment_id'),('settlements','order_id')}
