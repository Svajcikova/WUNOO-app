@app.get("/api/v032/checkout-summary")
def v032_checkout_summary(authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u = current_user(authorization); require_role(u, "customer")
    with core_db_connect() as c:
        cart_rows = c.execute("""
            SELECT ci.menu_item_id, ci.qty, mi.name, mi.price_czk
            FROM cart_items ci JOIN menu_items mi ON mi.id=ci.menu_item_id
            WHERE ci.customer_id=?
        """, (u["customer_id"],)).fetchall()
        items=[dict(r) for r in cart_rows]
        subtotal=round(sum(float(x["price_czk"])*int(x["qty"]) for x in items),2)
        addr=c.execute(
            "SELECT * FROM customer_addresses WHERE customer_id=? AND is_default=1 ORDER BY created_at DESC LIMIT 1",
            (u["customer_id"],)
        ).fetchone()
        return {
            "items": items,
            "subtotal_czk": subtotal,
            "address": dict(addr) if addr else None,
            "ready_for_quote": bool(items and addr)
        }


@app.get("/api/v034/marketplace")
def v034_marketplace(
    q: str | None = None,
    category: str | None = None,
    cuisine: str | None = None,
    city: str | None = "Ostrava",
    min_rating: float | None = None,
    sort: str = "relevance",
    authorization: str | None = Header(default=None),
) -> dict[str, Any]:
    u = current_user(authorization)
    require_role(u, "customer")
    with core_db_connect() as c:
        rows = c.execute("""
            SELECT m.id,m.name,m.prep_minutes,m.active,m.lat,m.lon,
                   COALESCE(mp.category,'Bistro') category,
                   COALESCE(mp.cuisine,'Moderní česká') cuisine,
                   COALESCE(mp.min_order_czk,0) min_order_czk,
                   COALESCE(mp.rating_avg,0) rating_avg,
                   COALESCE(mp.rating_count,0) rating_count,
                   COALESCE(mp.opening_hours_json,'{}') opening_hours_json
            FROM merchants m
            LEFT JOIN merchant_profiles mp ON mp.merchant_id=m.id
            WHERE m.active=1
        """).fetchall()
        out=[]
        for r in rows:
            x=dict(r)
            if q:
                ql=q.lower()
                if ql not in x["name"].lower() and ql not in x["cuisine"].lower() and ql not in x["category"].lower():
                    hit=c.execute(
                        "SELECT 1 FROM menu_items WHERE merchant_id=? AND active=1 AND lower(name) LIKE ? LIMIT 1",
                        (x["id"], "%"+ql+"%")
                    ).fetchone()
                    if not hit: continue
            if category and category.lower() != "vše" and x["category"].lower() != category.lower():
                continue
            if cuisine and cuisine.lower() != "vše" and x["cuisine"].lower() != cuisine.lower():
                continue
            if min_rating is not None and x["rating_avg"] < min_rating:
                continue
            zone = c.execute(
                "SELECT 1 FROM merchant_delivery_zones WHERE merchant_id=? AND city=? LIMIT 1",
                (x["id"], city or "")
            ).fetchone()
            if city and not zone:
                continue
            # Deterministic demo scoring; real customer geo can be added later.
            x["distance_km"] = 0.0
            x["delivery_available"] = True
            x["score"] = round(
                (x["rating_avg"] * 10) + max(0, 40 - x["prep_minutes"]) + (10 if q else 0),
                2
            )
            x["opening_hours"] = json.loads(x.pop("opening_hours_json") or "{}")
            out.append(x)
        if sort == "rating":
            out.sort(key=lambda z: (-z["rating_avg"], z["prep_minutes"], z["name"]))
        elif sort == "fastest":
            out.sort(key=lambda z: (z["prep_minutes"], -z["rating_avg"], z["name"]))
        else:
            out.sort(key=lambda z: (-z["score"], z["name"]))
        return {"restaurants":out, "categories":sorted({x["category"] for x in out}), "cuisines":sorted({x["cuisine"] for x in out})}


@app.get("/api/v034/merchants/{merchant_id}")
def v034_merchant_detail(merchant_id: str, authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u=current_user(authorization); require_role(u,"customer")
    with core_db_connect() as c:
        m=c.execute("""
            SELECT m.id,m.name,m.prep_minutes,m.active,m.lat,m.lon,
                   mp.category,mp.cuisine,mp.min_order_czk,mp.rating_avg,mp.rating_count,mp.opening_hours_json
            FROM merchants m LEFT JOIN merchant_profiles mp ON mp.merchant_id=m.id
            WHERE m.id=?
        """,(merchant_id,)).fetchone()
        if not m: raise HTTPException(404,"Restaurace nenalezena")
        x=dict(m); x["opening_hours"]=json.loads(x.pop("opening_hours_json") or "{}")
        zone=c.execute("SELECT city,radius_km FROM merchant_delivery_zones WHERE merchant_id=? ORDER BY city",(merchant_id,)).fetchall()
        x["delivery_zones"]=[dict(z) for z in zone]
        menu=c.execute("SELECT id,name,description,price_czk,active FROM menu_items WHERE merchant_id=? AND active=1 ORDER BY name",(merchant_id,)).fetchall()
        x["menu"]=[dict(v) for v in menu]
        return x


