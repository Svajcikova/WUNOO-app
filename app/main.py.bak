        if not reg or reg['status']!='ACTIVE':raise HTTPException(409,'WITNESS_NOT_ACTIVE')
        if reg['current_key_id']!=obj['key_id'] or reg['current_public_key_b64']!=pb:raise HTTPException(409,'WITNESS_KEY_NOT_CURRENT')
