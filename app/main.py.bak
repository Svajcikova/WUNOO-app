def require_permission(c, subject, resource, action, resource_id=None, tenant_id=None, request_id=None):
    allowed, reason = AuthorizationPolicyEngine(c).allow(
        subject, resource, action, resource_id=resource_id, tenant_id=tenant_id, request_id=request_id
    )
    c.execute("""INSERT INTO permission_enforcement_events
        (id,request_id,subject_id,subject_role,resource,action,resource_id,tenant_id,decision,reason,created_at)
        VALUES (?,?,?,?,?,?,?,?,?,?,?)""",
        ("pee_"+uuid.uuid4().hex[:12],request_id,subject.get("id"),subject.get("role"),
         resource,action,resource_id,tenant_id,"allow" if allowed else "deny",reason,now()))
    if not allowed:
        raise HTTPException(status_code=403, detail={"code":"PERMISSION_DENIED","reason":reason})
    return True



