@app.get("/api/v041/orders/{order_id}/promise")
def v041_order_promise(order_id: str, authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u=current_user(authorization)
    with core_db_connect() as c:
        o=c.execute("SELECT * FROM orders WHERE id=?",(order_id,)).fetchone()
        if not o: raise HTTPException(404,"Objednávka nenalezena")
        allowed=(u["role"]=="admin" or
                 (u["role"]=="customer" and o["customer_id"]==u["customer_id"]) or
                 (u["role"]=="merchant" and o["merchant_id"]==u["merchant_id"]) or
                 (u["role"]=="courier" and o.get("courier_id")==u["id"] if isinstance(o,dict) else False))
        if not allowed: raise HTTPException(403,"forbidden")
        return {
            "order_id":order_id,
            "promise_mode":o["promise_mode"],
            "promised_at":o["promised_at"],
            "promise_version":o["promise_version"],
            "snapshot":json.loads(o["promise_snapshot_json"] or "{}")
        }


@app.get("/api/v041/merchants/{merchant_id}/promise-preview")
def v041_promise_preview(merchant_id: str, fulfillment_mode: str="asap", scheduled_for: str|None=None,
                         authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u=current_user(authorization); require_role(u,"customer")
    if fulfillment_mode not in {"asap","scheduled"}: raise HTTPException(400,"Neplatný fulfillment_mode")
    with core_db_connect() as c:
        m=c.execute("SELECT id,active FROM merchants WHERE id=?",(merchant_id,)).fetchone()
        if not m: raise HTTPException(404,"Restaurace nenalezena")
        if not m["active"]: raise HTTPException(409,"Restaurace není aktivní")
        if fulfillment_mode=="scheduled":
            if not scheduled_for: raise HTTPException(400,"scheduled_for je povinné")
            try:
                from datetime import datetime
                when=datetime.fromisoformat(str(scheduled_for).replace("Z","+00:00"))
                if when <= datetime.now(when.tzinfo): raise HTTPException(409,"Slot je v minulosti")
            except HTTPException: raise
            except Exception: raise HTTPException(400,"Neplatný scheduled_for")
        snap=_v041_compute_promise(c,merchant_id,fulfillment_mode,scheduled_for)
        c.commit()
        return snap


@app.post("/api/v041/merchants/{merchant_id}/capacity")
def v041_merchant_capacity(merchant_id: str, body: dict[str,Any], authorization: str | None = Header(default=None)) -> dict[str,Any]:
    u=current_user(authorization); require_role(u,"merchant")
    if u["merchant_id"]!=merchant_id: raise HTTPException(403,"forbidden")
    max_parallel=int(body.get("max_parallel_orders",8))
    prep_buffer=int(body.get("avg_prep_buffer_minutes",5))
    courier_buffer=int(body.get("courier_buffer_minutes",10))
    if not (1<=max_parallel<=100): raise HTTPException(400,"max_parallel_orders mimo limit")
    if not (0<=prep_buffer<=60): raise HTTPException(400,"prep buffer mimo limit")
    if not (0<=courier_buffer<=60): raise HTTPException(400,"courier buffer mimo limit")
    with core_db_connect() as c:
        c.execute("""INSERT INTO merchant_capacity_settings VALUES (?,?,?,?)
                     ON CONFLICT(merchant_id) DO UPDATE SET
                     max_parallel_orders=excluded.max_parallel_orders,
                     avg_prep_buffer_minutes=excluded.avg_prep_buffer_minutes,
                     courier_buffer_minutes=excluded.courier_buffer_minutes""",
                  (merchant_id,max_parallel,prep_buffer,courier_buffer))
        c.commit()
    return {"merchant_id":merchant_id,"max_parallel_orders":max_parallel,
            "avg_prep_buffer_minutes":prep_buffer,"courier_buffer_minutes":courier_buffer}


@app.post("/api/v041/orders/{order_id}/promise-freeze")
def v041_freeze_promise(order_id: str, authorization: str | None = Header(default=None)) -> dict[str,Any]:
    u=current_user(authorization); require_role(u,{"merchant","admin"})
    with core_db_connect() as c:
        o=c.execute("SELECT * FROM orders WHERE id=?",(order_id,)).fetchone()
        if not o: raise HTTPException(404,"Objednávka nenalezena")
        if u["role"]=="merchant" and o["merchant_id"]!=u["merchant_id"]: raise HTTPException(403,"forbidden")
        snap=_v041_compute_promise(c,o["merchant_id"],o["fulfillment_mode"] or "asap",o["scheduled_for"])
        c.execute("UPDATE orders SET promised_at=?,promise_version=?,promise_snapshot_json=?,promise_mode=?,updated_at=? WHERE id=?",
                  (snap["promised_at"],snap["promise_version"],json.dumps(snap,ensure_ascii=False),snap["mode"],now(),order_id))
        emit(c,order_id,"promise_frozen",{"promised_at":snap["promised_at"],"snapshot":snap},u["id"])
        c.commit()
        return {"order_id":order_id,**snap}

