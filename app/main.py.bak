def _v112_hash(v): return hashlib.sha256(_v112_json(v).encode()).hexdigest()
def _v112_run(c):
    checks=[]
    def chk(n,v,r=None,d=None): checks.append({'check':n,'valid':bool(v),'reason':r,'details':d})
    for table, col in [('payment_webhook_events','provider_event_id'),('refunds','provider_refund_id')]:
        try:
            idx=[]
            for ir in c.execute(f'PRAGMA index_list({table})').fetchall():
                if int(ir['unique']): idx.append(tuple(x['name'] for x in c.execute(f"PRAGMA index_info({ir['name']})").fetchall()))
            chk('UNIQUE:'+table, (col,) in idx, None if (col,) in idx else 'MISSING_UNIQUE_CONTRACT', {'unique_indexes':[list(x) for x in idx]})
        except Exception as e: chk('UNIQUE:'+table,False,'INDEX_EXCEPTION',str(e))
    chk('WEBHOOK_ROUTE', any(getattr(r,'path',None)=='/api/v049/webhooks/{provider}' and 'POST' in getattr(r,'methods',set()) for r in app.routes),'MISSING_WEBHOOK_ROUTE')
    chk('PAYMENT_ROUTE', any(getattr(r,'path',None)=='/api/orders/{order_id}/pay' and 'POST' in getattr(r,'methods',set()) for r in app.routes),'MISSING_PAYMENT_ROUTE')
    chk('REFUND_ROUTE', any(getattr(r,'path',None)=='/api/v120/finance/orders/{order_id}/refund' and 'POST' in getattr(r,'methods',set()) for r in app.routes),'MISSING_FINANCE_REFUND_ROUTE')
    try:
        dup=c.execute("SELECT COUNT(*) n FROM (SELECT provider_event_id FROM payment_webhook_events GROUP BY provider_event_id HAVING COUNT(*)>1)").fetchone()['n']
        chk('WEBHOOK_NO_DUPLICATES',int(dup)==0,None if int(dup)==0 else 'DUPLICATE_PROVIDER_EVENTS',{'duplicate_groups':int(dup)})
    except Exception as e: chk('WEBHOOK_NO_DUPLICATES',False,'QUERY_EXCEPTION',str(e))
    try:
