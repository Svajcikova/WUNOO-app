# ---------------------------------------------------------------------------
# WUNOO v1.25 — Security & Abuse Prevention
# ---------------------------------------------------------------------------

def migrate_v125(c):
    c.execute("""CREATE TABLE IF NOT EXISTS v125_security_events(
        id TEXT PRIMARY KEY, event_type TEXT NOT NULL, subject_key TEXT NOT NULL,
        route TEXT, outcome TEXT NOT NULL, score INTEGER NOT NULL DEFAULT 0,
        details_json TEXT NOT NULL DEFAULT '{}', created_at TEXT NOT NULL
    )""")
    c.execute("""CREATE TABLE IF NOT EXISTS v125_abuse_flags(
        id TEXT PRIMARY KEY, subject_key TEXT NOT NULL, flag_type TEXT NOT NULL,
        severity TEXT NOT NULL, score INTEGER NOT NULL DEFAULT 0, status TEXT NOT NULL,
        first_seen_at TEXT NOT NULL, last_seen_at TEXT NOT NULL, occurrences INTEGER NOT NULL DEFAULT 1,
        details_json TEXT NOT NULL DEFAULT '{}', UNIQUE(subject_key,flag_type,status)
    )""")
    c.execute("""CREATE TABLE IF NOT EXISTS v125_replay_nonces(
        nonce TEXT PRIMARY KEY, subject_key TEXT NOT NULL, expires_at TEXT NOT NULL,
        created_at TEXT NOT NULL
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_v125_sec_subject ON v125_security_events(subject_key,created_at)")
    c.execute("CREATE INDEX IF NOT EXISTS idx_v125_flags_status ON v125_abuse_flags(status,severity,last_seen_at)")
    c.execute("CREATE INDEX IF NOT EXISTS idx_v125_nonce_expiry ON v125_replay_nonces(expires_at)")
    c.commit()


def _v125_subject(request: Request):
    ip=request.client.host if request.client else 'unknown'
    return ip


def _v125_record_security(c,event_type,subject,route,outcome,score=0,details=None):
    c.execute("INSERT INTO v125_security_events VALUES(?,?,?,?,?,?,?,?)",
              ('sec25_'+uuid.uuid4().hex[:12],event_type,subject,route,outcome,int(score),json.dumps(details or {},ensure_ascii=False),now()))


def _v125_flag(c,subject,flag_type,severity,score,details=None):
    row=c.execute("SELECT * FROM v125_abuse_flags WHERE subject_key=? AND flag_type=? AND status='open'",(subject,flag_type)).fetchone()
    ts=now()
    if row:
        c.execute("UPDATE v125_abuse_flags SET severity=?,score=?,last_seen_at=?,occurrences=occurrences+1,details_json=? WHERE id=?",
                  (severity,max(int(row['score']),int(score)),ts,json.dumps(details or {},ensure_ascii=False),row['id']))
        return row['id'],False
    fid='af25_'+uuid.uuid4().hex[:12]
    c.execute("INSERT INTO v125_abuse_flags VALUES(?,?,?,?,?,?,?,?,?,?)",
              (fid,subject,flag_type,severity,int(score),'open',ts,ts,1,json.dumps(details or {},ensure_ascii=False)))
    return fid,True


class V125SecurityMiddleware(BaseHTTPMiddleware):
    """Tight route-aware abuse controls layered above the existing global limiter."""
    async def dispatch(self, request:Request, call_next):
        path=request.url.path
        if not path.startswith('/api/'):
            return await call_next(request)
        ip=_v125_subject(request)
        # Login is intentionally much stricter than normal API traffic.
        if path == '/api/login' and request.method == 'POST':
            try:
                allowed,count,retry=RATE_LIMIT_STORE.hit(f'v125:login:{ip}',10,60,int(time.time()))
                if not allowed:
                    with closing(conn()) as c:
                        _v125_record_security(c,'bruteforce_rate_limit',ip,path,'blocked',90,{'count':count,'retry_after':retry})
                        _v125_flag(c,ip,'login_bruteforce','high',90,{'count':count,'retry_after':retry}); c.commit()
                    return JSONResponse(status_code=429,content={'detail':{'code':'LOGIN_RATE_LIMITED','retry_after':retry}},headers={'Retry-After':str(retry)})
            except Exception:
                pass
        # Mutating routes require an explicit idempotency key once clients are beyond the demo login.
        sensitive=path.startswith('/api/v115/checkout') or path.startswith('/api/orders') or path.startswith('/api/v121/support')
        if request.method in {'POST','PATCH','PUT','DELETE'} and sensitive and path != '/api/login':
            key=request.headers.get('Idempotency-Key')
            # Legacy v1.14-v1.24 clients may omit the header; record it but do not break compatibility.
            if not key:
                with closing(conn()) as c:
                    _v125_record_security(c,'missing_idempotency_key',ip,path,'observed',10,{}); c.commit()
            elif (len(key)<8 or len(key)>128 or not re.fullmatch(r'[A-Za-z0-9._:-]+',key)):
                with closing(conn()) as c:
                    _v125_record_security(c,'invalid_idempotency_key',ip,path,'blocked',50,{}); c.commit()
                return JSONResponse(status_code=400,content={'detail':{'code':'INVALID_IDEMPOTENCY_KEY'}})
        return await call_next(request)

app.add_middleware(V125SecurityMiddleware)


@app.get('/api/v125/security/overview')
def v125_security_overview(authorization:str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        flags=[dict(x) for x in c.execute("SELECT * FROM v125_abuse_flags WHERE status='open' ORDER BY CASE severity WHEN 'critical' THEN 1 WHEN 'high' THEN 2 WHEN 'medium' THEN 3 ELSE 4 END,last_seen_at DESC LIMIT 200").fetchall()]
        events=[dict(x) for x in c.execute("SELECT * FROM v125_security_events ORDER BY created_at DESC LIMIT 200").fetchall()]
        return {'schema_version':'1.25','open_flags':flags,'recent_events':events,'count_flags':len(flags)}


@app.post('/api/v125/security/flags/{flag_id}/resolve')
def v125_resolve_flag(flag_id:str, authorization:str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        row=c.execute('SELECT id FROM v125_abuse_flags WHERE id=?',(flag_id,)).fetchone()
        if not row: raise HTTPException(404,'Security flag nenalezen')
        c.execute("UPDATE v125_abuse_flags SET status='resolved' WHERE id=?",(flag_id,)); c.commit()
        return {'schema_version':'1.25','flag_id':flag_id,'status':'resolved'}


@app.post('/api/v125/security/nonce')
def v125_issue_nonce(authorization:str|None=Header(default=None)):
    u=current_user(authorization); subject=str(u['id']);
    nonce=secrets.token_urlsafe(24); created=datetime.now(timezone.utc); expiry=created+__import__('datetime').timedelta(minutes=5)
    with core_db_connect() as c:
        c.execute('DELETE FROM v125_replay_nonces WHERE expires_at<=?',(now(),))
        c.execute('INSERT INTO v125_replay_nonces VALUES(?,?,?,?)',(nonce,subject,expiry.isoformat(),created.isoformat())); c.commit()
    return {'schema_version':'1.25','nonce':nonce,'expires_at':expiry.isoformat()}


def v125_consume_nonce(c,nonce,subject):
    row=c.execute('SELECT * FROM v125_replay_nonces WHERE nonce=? AND subject_key=?',(nonce,subject)).fetchone()
    if not row: raise HTTPException(409,{'code':'REPLAY_DETECTED'})
    if row['expires_at']<=now():
        c.execute('DELETE FROM v125_replay_nonces WHERE nonce=?',(nonce,)); c.commit()
        raise HTTPException(409,{'code':'NONCE_EXPIRED'})
    c.execute('DELETE FROM v125_replay_nonces WHERE nonce=?',(nonce,)); c.commit(); return True


@app.get('/frontend_v029/security_v125.html')
def v125_security_page():
    return FileResponse(BASE.parent / 'frontend_v029' / 'security_v125.html')


# ---------------------------------------------------------------------------
# WUNOO v1.26 — Multi-Tenant & Merchant Isolation
# ---------------------------------------------------------------------------

def migrate_v126(c):
    c.execute("""CREATE TABLE IF NOT EXISTS v126_tenants(
        id TEXT PRIMARY KEY,
        merchant_id TEXT NOT NULL UNIQUE REFERENCES merchants(id) ON DELETE CASCADE,
        status TEXT NOT NULL DEFAULT 'active',
        created_at TEXT NOT NULL,
        updated_at TEXT NOT NULL
    )""")
    c.execute("""CREATE TABLE IF NOT EXISTS v126_tenant_access_audit(
        id TEXT PRIMARY KEY,
        request_id TEXT,
        actor_id TEXT,
        actor_role TEXT,
        tenant_id TEXT,
        resource TEXT NOT NULL,
        resource_id TEXT,
        action TEXT NOT NULL,
        decision TEXT NOT NULL,
        reason TEXT NOT NULL,
        created_at TEXT NOT NULL
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_v126_access_tenant_time ON v126_tenant_access_audit(tenant_id,created_at DESC)")
    c.execute("CREATE INDEX IF NOT EXISTS idx_v126_access_actor_time ON v126_tenant_access_audit(actor_id,created_at DESC)")
    rows=c.execute("SELECT id FROM merchants ORDER BY id").fetchall()
    for r in rows:
        mid=str(r["id"])
        tid="tenant_"+mid
        c.execute("INSERT OR IGNORE INTO v126_tenants(id,merchant_id,status,created_at,updated_at) VALUES(?,?,?,?,?)",(tid,mid,"active",now(),now()))
    c.commit()


def _v126_tenant_for_merchant(c, merchant_id):
    row=c.execute("SELECT * FROM v126_tenants WHERE merchant_id=? AND status='active'",(str(merchant_id),)).fetchone()
    if not row:
        raise HTTPException(404,"Tenant nenalezen")
    return row


def _v126_audit(c, user, tenant_id, resource, resource_id, action, decision, reason, request_id=None):
    c.execute("INSERT INTO v126_tenant_access_audit VALUES(?,?,?,?,?,?,?,?,?,?,?)",
              ("ta26_"+uuid.uuid4().hex[:12],request_id,user.get("id") if user else None,
               user.get("role") if user else None,tenant_id,resource,resource_id,action,decision,reason,now()))


def _v126_require_tenant(c, user, merchant_id, resource, resource_id=None, action="read", request_id=None):
    tenant=_v126_tenant_for_merchant(c, merchant_id)
    tid=str(tenant["id"])
    role=str(user.get("role"))
    own=str(user.get("merchant_id") or "")
    if role in {"admin","ops_agent"}:
        _v126_audit(c,user,tid,resource,resource_id,action,"allow","operator_cross_tenant",request_id)
        return tenant
    if role != "merchant" or own != str(merchant_id):
        _v126_audit(c,user,tid,resource,resource_id,action,"deny","tenant_mismatch",request_id)
        c.commit()
        raise HTTPException(403,"Tenant isolation: přístup k datům jiné restaurace je zakázán")
    _v126_audit(c,user,tid,resource,resource_id,action,"allow","tenant_match",request_id)
    return tenant


@app.get('/api/v126/tenant/context')
def v126_tenant_context(authorization:str|None=Header(default=None)):
    u=current_user(authorization)
    with core_db_connect() as c:
        if u['role'] in {'admin','ops_agent'}:
            rows=c.execute("SELECT t.*,m.name merchant_name FROM v126_tenants t JOIN merchants m ON m.id=t.merchant_id ORDER BY m.name").fetchall()
            result=[dict(r) for r in rows]
            return {'schema_version':'1.26','scope':'operator','tenants':result}
        if u['role']!='merchant' or not u.get('merchant_id'):
            raise HTTPException(403,'Tenant context není dostupný pro tuto roli')
        t=_v126_require_tenant(c,u,u['merchant_id'],'tenant','tenant_'+str(u['merchant_id']),'read')
        c.commit()
        return {'schema_version':'1.26','scope':'tenant','tenant':dict(t)}


@app.get('/api/v126/merchant/{merchant_id}/orders')
def v126_merchant_orders(merchant_id:str, authorization:str|None=Header(default=None)):
    u=current_user(authorization)
    with core_db_connect() as c:
        t=_v126_require_tenant(c,u,merchant_id,'orders',merchant_id,'read')
        rows=c.execute("""SELECT o.id,o.customer_id,o.merchant_id,o.status,o.subtotal_czk,o.total_czk,
                                o.courier_id,o.created_at,o.updated_at,m.name merchant_name
                         FROM orders o JOIN merchants m ON m.id=o.merchant_id
                         WHERE o.merchant_id=? ORDER BY o.created_at DESC LIMIT 500""",(merchant_id,)).fetchall()
        c.commit()
        return {'schema_version':'1.26','tenant_id':t['id'],'merchant_id':merchant_id,'orders':[dict(r) for r in rows]}


@app.get('/api/v126/merchant/{merchant_id}/menu')
def v126_merchant_menu(merchant_id:str, authorization:str|None=Header(default=None)):
    u=current_user(authorization)
    with core_db_connect() as c:
        t=_v126_require_tenant(c,u,merchant_id,'menu',merchant_id,'read')
        rows=c.execute("SELECT id,merchant_id,name,description,price_czk,currency,active,category_id,display_order,version FROM menu_items WHERE merchant_id=? ORDER BY display_order,name,id",(merchant_id,)).fetchall()
        c.commit()
        return {'schema_version':'1.26','tenant_id':t['id'],'merchant_id':merchant_id,'items':[dict(r) for r in rows]}


@app.get('/api/v126/tenant/audit')
def v126_tenant_audit(authorization:str|None=Header(default=None), limit:int=100):
    u=current_user(authorization); limit=max(1,min(int(limit),500))
    with core_db_connect() as c:
        if u['role'] in {'admin','ops_agent'}:
            rows=c.execute("SELECT * FROM v126_tenant_access_audit ORDER BY created_at DESC,id DESC LIMIT ?",(limit,)).fetchall()
        elif u['role']=='merchant' and u.get('merchant_id'):
            tid='tenant_'+str(u['merchant_id'])
            rows=c.execute("SELECT * FROM v126_tenant_access_audit WHERE tenant_id=? ORDER BY created_at DESC,id DESC LIMIT ?",(tid,limit)).fetchall()
        else:
            raise HTTPException(403,'Tenant audit není dostupný pro tuto roli')
        return {'schema_version':'1.26','events':[dict(r) for r in rows]}


class V126TenantIsolationMiddleware(BaseHTTPMiddleware):
    """Defense-in-depth for legacy order/menu routes.

    The versioned v1.26 endpoints enforce scope directly; this middleware adds a
    second guard to legacy routes that contain an order id or merchant menu path.
    """
    async def dispatch(self, request:Request, call_next):
        path=request.url.path
        if not path.startswith('/api/'):
            return await call_next(request)
        auth=request.headers.get('authorization')
        if not auth or not auth.startswith('Bearer '):
            return await call_next(request)
        try:
            u=current_user(auth)
        except HTTPException:
            return await call_next(request)
        if u.get('role')!='merchant':
            return await call_next(request)
        # Guard concrete order-resource URLs: /api/orders/{id}[/*]
        m=re.match(r'^/api/orders/([^/]+)(?:/|$)',path)
        if m:
            oid=m.group(1)
            with closing(conn()) as c:
                o=c.execute('SELECT merchant_id FROM orders WHERE id=?',(oid,)).fetchone()
                if o and str(o['merchant_id'])!=str(u.get('merchant_id')):
                    tid='tenant_'+str(o['merchant_id'])
                    _v126_audit(c,u,tid,'orders',oid,request.method,'deny','tenant_mismatch_legacy_route')
                    c.commit()
                    return JSONResponse(status_code=403,content={'detail':'Tenant isolation: přístup k objednávce jiné restaurace je zakázán'})
        # Guard legacy merchant menu mutation/read routes when they carry an id.
        if path.startswith('/api/merchant/menu/'):
            iid=path.rsplit('/',1)[-1]
            with closing(conn()) as c:
                row=c.execute('SELECT merchant_id FROM menu_items WHERE id=?',(iid,)).fetchone()
                if row and str(row['merchant_id'])!=str(u.get('merchant_id')):
                    tid='tenant_'+str(row['merchant_id'])
                    _v126_audit(c,u,tid,'menu',iid,request.method,'deny','tenant_mismatch_legacy_route')
                    c.commit()
                    return JSONResponse(status_code=403,content={'detail':'Tenant isolation: přístup k menu jiné restaurace je zakázán'})
        return await call_next(request)


app.add_middleware(V126TenantIsolationMiddleware)


@app.get('/frontend_v029/tenant_isolation_v126.html')
def v126_tenant_isolation_page():
    return FileResponse(BASE.parent / 'frontend_v029' / 'tenant_isolation_v126.html')

# ---------------------------------------------------------------------------
# WUNOO v1.27 — API Gateway & Contract Enforcement
# ---------------------------------------------------------------------------
V127_CONTRACTS = {
    'GET /api/v127/catalog/{merchant_id}': {'request':'path: merchant_id','response':['schema_version','tenant_id','merchant_id','items'],'version':'1.27'},
    'GET /api/v127/orders/{order_id}': {'request':'path: order_id','response':['schema_version','order'],'version':'1.27'},
    'GET /api/v127/orders/{order_id}/tracking': {'request':'path: order_id','response':['schema_version','order_id','status'],'version':'1.27'},
    'GET /api/v127/contracts': {'request':'none','response':['schema_version','contracts'],'version':'1.27'},
}


def _v127_request_id(request: Request) -> str:
    rid = request.headers.get('x-request-id') or ('req27_' + uuid.uuid4().hex[:16])
    if len(rid) > 128 or not re.fullmatch(r'[A-Za-z0-9._:-]+', rid):
        raise HTTPException(400, 'Neplatný X-Request-ID')
    return rid


def _v127_contract_response(payload, request_id: str):
    if isinstance(payload, dict):
        payload = dict(payload)
        payload.setdefault('schema_version', '1.27')
    return JSONResponse(content=payload, headers={'X-Request-ID': request_id, 'X-API-Version':'1.27'})


@app.get('/api/v127/contracts')
def v127_contracts(request: Request):
    rid = _v127_request_id(request)
    return _v127_contract_response({'schema_version':'1.27','contracts':V127_CONTRACTS,'deprecations':{
        '/api/v0.38/*':'legacy-compatible; prefer v1.27 for new integrations',
        '/api/v115/*':'stable legacy flow; prefer v1.27 facade for new clients'
    }}, rid)


@app.get('/api/v127/catalog/{merchant_id}')
def v127_catalog(merchant_id: str, request: Request, authorization: str|None=Header(default=None)):
    rid=_v127_request_id(request)
    u=current_user(authorization)
    # Reuse the authoritative v1.15 catalog implementation, but expose a stable v1.27 envelope.
    from fastapi.encoders import jsonable_encoder
    with core_db_connect() as c:
        # v1.27 catalog is a stable facade over the authoritative v1.15 catalog builder.
        result=_v115_catalog(c, merchant_id)
        # Tenant boundary is explicit for merchant operators.
        if u['role']=='merchant' and str(u.get('merchant_id')) != str(merchant_id):
            raise HTTPException(403,'Tenant isolation: přístup k menu jiné restaurace je zakázán')
    return _v127_contract_response({'schema_version':'1.27','merchant_id':merchant_id,'catalog':jsonable_encoder(result)},rid)


@app.get('/api/v127/orders/{order_id}')
def v127_order(order_id: str, request: Request, authorization: str|None=Header(default=None)):
    rid=_v127_request_id(request); u=current_user(authorization)
    with core_db_connect() as c:
        o=c.execute('SELECT * FROM orders WHERE id=?',(order_id,)).fetchone()
        if not o: raise HTTPException(404,'Objednávka nenalezena')
        if u['role']=='merchant' and str(o['merchant_id'])!=str(u.get('merchant_id')):
            raise HTTPException(403,'Tenant isolation: přístup k objednávce je zakázán')
        if u['role']=='customer' and str(o['customer_id'])!=str(u.get('customer_id')):
            raise HTTPException(403,'Přístup k objednávce je zakázán')
        if u['role']=='courier' and o['courier_id'] and str(o['courier_id'])!=str(u.get('courier_id')):
            raise HTTPException(403,'Přístup k objednávce je zakázán')
        return _v127_contract_response({'schema_version':'1.27','order':dict(o)},rid)


@app.get('/api/v127/orders/{order_id}/tracking')
def v127_tracking(order_id: str, request: Request, authorization: str|None=Header(default=None)):
    rid=_v127_request_id(request); u=current_user(authorization)
    with core_db_connect() as c:
        o=c.execute('SELECT * FROM orders WHERE id=?',(order_id,)).fetchone()
        if not o: raise HTTPException(404,'Objednávka nenalezena')
        allowed=(u['role'] in {'admin','ops_agent'} or
                 (u['role']=='merchant' and str(o['merchant_id'])==str(u.get('merchant_id'))) or
                 (u['role']=='customer' and str(o['customer_id'])==str(u.get('customer_id'))) or
                 (u['role']=='courier' and str(o['courier_id'] or '')==str(u.get('courier_id'))))
        if not allowed: raise HTTPException(403,'Přístup k trackingu je zakázán')
        return _v127_contract_response({'schema_version':'1.27','order_id':order_id,'status':o['status'],'courier_id':o['courier_id']},rid)


class V127ContractMiddleware(BaseHTTPMiddleware):
    async def dispatch(self, request: Request, call_next):
        if request.url.path.startswith('/api/v127/'):
            try: rid=_v127_request_id(request)
            except HTTPException as e:
                return JSONResponse(status_code=e.status_code,content={'detail':e.detail})
            response=await call_next(request)
            response.headers['X-Request-ID']=rid
            response.headers['X-API-Version']='1.27'
            response.headers['Cache-Control']='no-store'
            return response
        return await call_next(request)

app.add_middleware(V127ContractMiddleware)

@app.get('/frontend_v029/api_contract_v127.html')
def v127_contract_page():
    return FileResponse(BASE.parent / 'frontend_v029' / 'api_contract_v127.html')


# ---------------- v1.28 PostgreSQL production seam ----------------
@app.get("/api/v128/ops/persistence")
def v128_persistence_status(authorization: str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    configured=configured_db_backend()
    dsn=os.getenv("WUNOO_DATABASE_URL") or os.getenv("DATABASE_URL")
    with core_db_connect() as c:
        contract=c.execute("SELECT * FROM persistence_contracts WHERE backend='postgresql' AND contract_version='1.28' ORDER BY created_at DESC LIMIT 1").fetchone()
        journal,busy=_db_concurrency_info(c)
    return {"configured_backend":configured,"postgresql_dsn_configured":bool(dsn),
            "sqlite_concurrency":{"journal_mode":journal,"busy_timeout_ms":busy,"synchronous":"NORMAL"},
            "postgresql_contract":dict(contract) if contract else None,
            "production_cutover_blocked":configured=="postgresql" and os.getenv("WUNOO_ENV","development").lower() in {"prod","production","staging"}}

@app.get("/api/v128/ops/persistence-contract")
def v128_persistence_contract(authorization: str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    return {"version":"1.28","canonical_backend":"postgresql",
            "sqlite_fallback":"development_only","transactional_requirements":["atomic order transition","conditional state update","idempotency uniqueness","foreign keys","commit_or_rollback"],
            "cutover_rule":"never silently fall back to SQLite when PostgreSQL is selected in production"}

