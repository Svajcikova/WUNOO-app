def _v049_reconcile_order(c, order_id):
    o=c.execute("SELECT total_czk FROM orders WHERE id=?",(order_id,)).fetchone()
    p=c.execute("SELECT * FROM payments WHERE order_id=?",(order_id,)).fetchone()
    refunded=c.execute("SELECT COALESCE(SUM(amount_czk),0) x FROM refunds WHERE order_id=? AND status='succeeded'",(order_id,)).fetchone()["x"]
    expected=float(o["total_czk"]) if o else 0
    captured=float(p["amount_czk"]) if p and p["status"] in {"captured","refunded"} else 0
    remaining=round(captured-float(refunded or 0),2)
    variance=round(expected-captured,2)
    status="reconciled" if abs(variance)<=0.01 else "exception"
    rid="rec_"+uuid.uuid4().hex[:10]
    c.execute("INSERT INTO payment_reconciliation VALUES (?,?,?,?,?,?,?,?)",
              (rid,order_id,p["id"] if p else None,expected,captured,float(refunded or 0),variance,status,now()))
    return {"id":rid,"order_id":order_id,"expected_amount_czk":expected,"captured_amount_czk":captured,
            "refunded_amount_czk":float(refunded or 0),"remaining_paid_czk":remaining,"variance_czk":variance,"status":status}



