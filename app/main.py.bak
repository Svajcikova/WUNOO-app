# v1.14 merchant menu API — server authoritative
def _v114_item(c, merchant_id, item_id):
    return c.execute("""SELECT mi.id,mi.merchant_id,mi.name,mi.description,mi.price_czk,mi.currency,
                              mi.active,mi.category_id,mi.display_order,mi.version,mc.name AS category_name
                       FROM menu_items mi LEFT JOIN menu_categories mc ON mc.id=mi.category_id
                       WHERE mi.id=? AND mi.merchant_id=?""",(item_id,merchant_id)).fetchone()

def _v114_availability(c,item_id):
    row=c.execute("SELECT state,start_at,end_at,reason,updated_at,version FROM product_availability WHERE menu_item_id=? ORDER BY updated_at DESC LIMIT 1",(item_id,)).fetchone()
    return dict(row) if row else {"state":"AVAILABLE","start_at":None,"end_at":None,"reason":None,"version":0}

@app.get("/api/v114/merchant/menu")
def v114_menu(authorization: str | None = Header(default=None)):
    u=current_user(authorization); require_role(u,"merchant")
    with core_db_connect() as c:
        migrate_v114(c)
        cats=c.execute("SELECT id,name,sort_order,active FROM menu_categories WHERE merchant_id=? ORDER BY sort_order,name,id",(u["merchant_id"],)).fetchall()
        rows=c.execute("SELECT mi.id,mi.merchant_id,mi.name,mi.description,mi.price_czk,mi.currency,mi.active,mi.category_id,mi.display_order,mi.version,mc.name AS category_name FROM menu_items mi LEFT JOIN menu_categories mc ON mc.id=mi.category_id WHERE mi.merchant_id=? ORDER BY COALESCE(mc.sort_order,999),mi.display_order,mi.name,mi.id",(u["merchant_id"],)).fetchall()
        items=[]
        for r in rows:
            d=dict(r); d["availability"]=_v114_availability(c,r["id"]); items.append(d)
        return {"schema_version":"1.14","categories":[dict(x) for x in cats],"items":items}

@app.post("/api/v114/merchant/menu-item")
def v114_create_item(body: dict[str,Any], authorization: str | None = Header(default=None)):
    u=current_user(authorization); require_role(u,"merchant")
    name=str(body.get("name","")).strip(); description=body.get("description")
    if not name or len(name)>120: raise HTTPException(400,"Neplatný název položky")
    if description is not None and len(str(description))>2000: raise HTTPException(400,"Popis je příliš dlouhý")
    try: price=float(body.get("price_czk"))
    except Exception: raise HTTPException(400,"Neplatná cena")
    if not math.isfinite(price) or price<0 or price>100000: raise HTTPException(400,"Neplatná cena")
    currency=str(body.get("currency","CZK")).upper()
    if currency!="CZK": raise HTTPException(400,"Podporovaná měna je CZK")
    category_id=body.get("category_id") or None
    with core_db_connect() as c:
        migrate_v114(c)
        if category_id and not c.execute("SELECT 1 FROM menu_categories WHERE id=? AND merchant_id=? AND active=1",(category_id,u["merchant_id"])).fetchone(): raise HTTPException(400,"Kategorie nepatří restauraci")
        max_order=c.execute("SELECT COALESCE(MAX(display_order),-1) n FROM menu_items WHERE merchant_id=? AND category_id IS ?",(u["merchant_id"],category_id)).fetchone()["n"]
        iid="mi_"+uuid.uuid4().hex[:12]
        c.execute("INSERT INTO menu_items(id,merchant_id,name,description,price_czk,active,category_id,display_order,version,currency) VALUES (?,?,?,?,?,?,?,?,?,?)",(iid,u["merchant_id"],name,description,price,1,category_id,int(max_order)+1,1,currency))
        emit(c,None,"menu_item_created",{"merchant_id":u["merchant_id"],"menu_item_id":iid,"name":name,"price_czk":price,"version":1},u["id"])
        c.commit(); row=_v114_item(c,u["merchant_id"],iid)
        return {**dict(row),"availability":_v114_availability(c,iid)}

@app.patch("/api/v114/merchant/menu-item/{item_id}")
def v114_update_item(item_id: str, body: dict[str,Any], authorization: str | None = Header(default=None)):
    u=current_user(authorization); require_role(u,"merchant")
    allowed={"name","description","price_czk","category_id","display_order","active"}; changes={k:v for k,v in body.items() if k in allowed}
    with core_db_connect() as c:
        migrate_v114(c); old=_v114_item(c,u["merchant_id"],item_id)
        if not old: raise HTTPException(404,"Položka nenalezena")
        if "name" in changes:
            changes["name"]=str(changes["name"]).strip()
            if not changes["name"] or len(changes["name"])>120: raise HTTPException(400,"Neplatný název položky")
        if "description" in changes and changes["description"] is not None and len(str(changes["description"]))>2000: raise HTTPException(400,"Popis je příliš dlouhý")
        if "price_czk" in changes:
            try: changes["price_czk"]=float(changes["price_czk"])
            except Exception: raise HTTPException(400,"Neplatná cena")
            if not math.isfinite(changes["price_czk"]) or changes["price_czk"]<0: raise HTTPException(400,"Neplatná cena")
        if "category_id" in changes and changes["category_id"] and not c.execute("SELECT 1 FROM menu_categories WHERE id=? AND merchant_id=? AND active=1",(changes["category_id"],u["merchant_id"])).fetchone(): raise HTTPException(400,"Neplatná kategorie")
        if "display_order" in changes:
            try: changes["display_order"]=int(changes["display_order"])
            except Exception: raise HTTPException(400,"Neplatné pořadí")
            if changes["display_order"]<0: raise HTTPException(400,"Neplatné pořadí")
        if "active" in changes: changes["active"]=1 if bool(changes["active"]) else 0
        if changes:
            changes["version"]=int(old["version"] or 1)+1
            sets=", ".join(f"{k}=?" for k in changes)
            c.execute(f"UPDATE menu_items SET {sets} WHERE id=? AND merchant_id=?",list(changes.values())+[item_id,u["merchant_id"]])
            emit(c,None,"menu_item_updated",{"merchant_id":u["merchant_id"],"menu_item_id":item_id,"changes":changes},u["id"])
        c.commit(); row=_v114_item(c,u["merchant_id"],item_id)
        return {**dict(row),"availability":_v114_availability(c,item_id)}

@app.post("/api/v114/merchant/menu-item/{item_id}/availability")
def v114_availability(item_id: str, body: dict[str,Any], authorization: str | None = Header(default=None)):
    u=current_user(authorization); require_role(u,"merchant")
    state=str(body.get("state","")).upper()
    if state not in {"AVAILABLE","SOLD_OUT"}: raise HTTPException(400,"state musí být AVAILABLE nebo SOLD_OUT")
    start_at=body.get("start_at"); end_at=body.get("end_at")
    if start_at and end_at and str(end_at)<str(start_at): raise HTTPException(400,"end_at musí být po start_at")
    with core_db_connect() as c:
        migrate_v114(c); item=_v114_item(c,u["merchant_id"],item_id)
        if not item: raise HTTPException(404,"Položka nenalezena")
        prev=_v114_availability(c,item_id); version=int(prev.get("version") or 0)+1
        aid="pa_"+uuid.uuid4().hex[:12]
        c.execute("INSERT INTO product_availability(id,menu_item_id,state,start_at,end_at,reason,updated_at,version) VALUES (?,?,?,?,?,?,?,?)",(aid,item_id,state,start_at,end_at,body.get("reason"),now(),version))
        emit(c,None,"menu_item_availability_changed",{"merchant_id":u["merchant_id"],"menu_item_id":item_id,"from":prev["state"],"to":state,"version":version},u["id"])
        c.commit(); return {"id":aid,"menu_item_id":item_id,**_v114_availability(c,item_id)}

@app.get("/api/v114/merchant/menu/validate")
def v114_validate(authorization: str | None = Header(default=None)):
    u=current_user(authorization); require_role(u,"merchant")
    errors=[]; warnings=[]
    with core_db_connect() as c:
        migrate_v114(c); cats=c.execute("SELECT id FROM menu_categories WHERE merchant_id=? AND active=1",(u["merchant_id"],)).fetchall(); cat_ids={x["id"] for x in cats}
        items=c.execute("SELECT id,name,price_czk,currency,category_id,display_order FROM menu_items WHERE merchant_id=? AND active=1",(u["merchant_id"],)).fetchall(); seen=set()
        for i in items:
            if not str(i["name"]).strip(): errors.append({"code":"MISSING_NAME","item_id":i["id"]})
            if float(i["price_czk"])<0: errors.append({"code":"NEGATIVE_PRICE","item_id":i["id"]})
            if i["currency"]!="CZK": errors.append({"code":"INVALID_CURRENCY","item_id":i["id"]})
            if i["category_id"] and i["category_id"] not in cat_ids: errors.append({"code":"INVALID_CATEGORY","item_id":i["id"]})
            key=(i["category_id"],i["display_order"])
            if key in seen: warnings.append({"code":"DUPLICATE_DISPLAY_ORDER","item_id":i["id"],"display_order":i["display_order"]})
            seen.add(key)
        return {"valid":not errors,"errors":errors,"warnings":warnings,"checked_items":len(items),"validator_version":"1.14"}

@app.get("/frontend_v029/merchant_menu_v114.html")
def v114_merchant_menu_page():
    return FileResponse(BASE.parent / "frontend_v029" / "merchant_menu_v114.html")



# v1.15 — customer catalog + authoritative cart/checkout seam

def _v115_effective_availability(c, item_id):
    row = c.execute("""
        SELECT state,start_at,end_at,reason,updated_at,version
        FROM product_availability WHERE menu_item_id=? ORDER BY updated_at DESC LIMIT 1
    """, (item_id,)).fetchone()
    if not row:
        return {"state":"AVAILABLE","reason":None,"version":0,"start_at":None,"end_at":None}
    d=dict(row)
    now_s=now()
    # Scheduled records are effective only inside their explicit window.
    if d["start_at"] and now_s < str(d["start_at"]):
        d["state"]="AVAILABLE"
    if d["end_at"] and now_s >= str(d["end_at"]):
        d["state"]="AVAILABLE"
    return d


def _v115_catalog(c, merchant_id):
    merchant=c.execute("""
        SELECT m.id,m.name,m.active,m.prep_minutes,
               COALESCE(mp.min_order_czk,0) min_order_czk,
               COALESCE(mp.rating_avg,0) rating_avg
        FROM merchants m LEFT JOIN merchant_profiles mp ON mp.merchant_id=m.id
        WHERE m.id=?
    """, (merchant_id,)).fetchone()
    if not merchant or not merchant["active"]:
        raise HTTPException(404,"Restaurace nenalezena")
    cats=c.execute("""
        SELECT id,name,sort_order FROM menu_categories
        WHERE merchant_id=? AND active=1 ORDER BY sort_order,name,id
    """, (merchant_id,)).fetchall()
    rows=c.execute("""
        SELECT mi.id,mi.name,mi.description,mi.price_czk,mi.currency,mi.category_id,
               mi.display_order,mi.version,mi.active,mc.name category_name
        FROM menu_items mi LEFT JOIN menu_categories mc ON mc.id=mi.category_id
        WHERE mi.merchant_id=? AND mi.active=1
        ORDER BY COALESCE(mc.sort_order,999),mi.display_order,mi.name,mi.id
    """, (merchant_id,)).fetchall()
    items=[]
    for r in rows:
        x=dict(r); x["availability"]=_v115_effective_availability(c,r["id"])
        groups=c.execute("""
            SELECT mg.id,mg.name,mg.min_select,mg.max_select
            FROM modifier_groups mg JOIN menu_item_modifier_groups mmg ON mmg.group_id=mg.id
            WHERE mmg.menu_item_id=? AND mg.active=1 ORDER BY mg.name,mg.id
        """, (r["id"],)).fetchall()
        x["modifier_groups"]=[]
        for g in groups:
            gd=dict(g)
            gd["modifiers"]=[dict(m) for m in c.execute(
                "SELECT id,name,price_czk FROM modifiers WHERE group_id=? AND active=1 ORDER BY name,id",
                (g["id"],)).fetchall()]
            x["modifier_groups"].append(gd)
        items.append(x)
    return {"schema_version":"1.15","merchant":dict(merchant),"categories":[dict(x) for x in cats],"items":items}


def _v115_validate_cart_rows(c, customer_id):
    rows=c.execute("""
        SELECT ci.id cart_item_id,ci.menu_item_id,ci.qty,ci.merchant_id,
               mi.name,mi.price_czk,mi.active,m.active merchant_active,
               COALESCE(mp.min_order_czk,0) min_order_czk
        FROM cart_items ci JOIN menu_items mi ON mi.id=ci.menu_item_id
        JOIN merchants m ON m.id=ci.merchant_id
        LEFT JOIN merchant_profiles mp ON mp.merchant_id=m.id
        WHERE ci.customer_id=? ORDER BY ci.id
    """, (customer_id,)).fetchall()
    issues=[]
    merchants={r["merchant_id"] for r in rows}
    if len(merchants)>1: issues.append("multiple_merchants")
    for r in rows:
        av=_v115_effective_availability(c,r["menu_item_id"])
        if not r["active"]: issues.append("menu_item_inactive:"+r["menu_item_id"])
        if av["state"]!="AVAILABLE": issues.append("menu_item_sold_out:"+r["menu_item_id"])
        if not r["merchant_active"]: issues.append("merchant_inactive:"+r["merchant_id"])
        mods=c.execute("""
            SELECT cm.modifier_id,cm.qty,mo.active,mo.group_id,mg.active group_active,
                   mg.name group_name,mg.min_select,mg.max_select
            FROM cart_item_modifiers cm
            LEFT JOIN modifiers mo ON mo.id=cm.modifier_id
            LEFT JOIN modifier_groups mg ON mg.id=mo.group_id
            WHERE cm.cart_item_id=?
        """, (r["cart_item_id"],)).fetchall()
        counts={}
        for m in mods:
            if not m["active"]: issues.append("modifier_inactive:"+str(m["modifier_id"]))
            if not m["group_active"]: issues.append("modifier_group_inactive:"+str(m["modifier_id"]))
            counts[m["group_id"]]=counts.get(m["group_id"],0)+int(m["qty"])
        groups=c.execute("""
            SELECT mg.id,mg.name,mg.min_select,mg.max_select
            FROM modifier_groups mg JOIN menu_item_modifier_groups mmg ON mmg.group_id=mg.id
            WHERE mmg.menu_item_id=? AND mg.active=1
        """, (r["menu_item_id"],)).fetchall()
        for g in groups:
            n=counts.get(g["id"],0)
            if n < int(g["min_select"]): issues.append(f"modifier_min:{r['menu_item_id']}:{g['id']}")
            if n > int(g["max_select"]): issues.append(f"modifier_max:{r['menu_item_id']}:{g['id']}")
    total=sum(float(r["price_czk"])*int(r["qty"]) for r in rows)
    if rows and total < float(rows[0]["min_order_czk"]): issues.append("minimum_order_not_met")
    return rows, sorted(set(issues)), round(total,2)

@app.get("/api/v115/merchants/{merchant_id}/catalog")
def v115_customer_catalog(merchant_id: str, authorization: str | None = Header(default=None)):
    u=current_user(authorization); require_role(u,"customer")
    with core_db_connect() as c:
        migrate_v114(c)
        return _v115_catalog(c,merchant_id)

@app.get("/api/v115/cart")
def v115_cart(authorization: str | None = Header(default=None)):
    u=current_user(authorization); require_role(u,"customer")
    with core_db_connect() as c:
        rows=c.execute("""
            SELECT ci.id cart_item_id,ci.menu_item_id,ci.qty,ci.merchant_id,mi.name,mi.description,mi.price_czk,
                   m.name merchant_name
            FROM cart_items ci JOIN menu_items mi ON mi.id=ci.menu_item_id JOIN merchants m ON m.id=ci.merchant_id
            WHERE ci.customer_id=? ORDER BY ci.id
        """, (u["customer_id"],)).fetchall()
        items=[]
        for r in rows:
            x=dict(r)
            mods=c.execute("""
                SELECT cm.modifier_id,mo.name,mo.price_czk,cm.qty,mo.group_id
                FROM cart_item_modifiers cm JOIN modifiers mo ON mo.id=cm.modifier_id
                WHERE cm.cart_item_id=? ORDER BY mo.name,mo.id
            """, (r["cart_item_id"],)).fetchall()
            note=c.execute("SELECT note FROM cart_item_notes WHERE cart_item_id=?",(r["cart_item_id"],)).fetchone()
            av=_v115_effective_availability(c,r["menu_item_id"])
            modifier_total=sum(float(m["price_czk"])*int(m["qty"]) for m in mods)
            x.update({"modifiers":[dict(m) for m in mods],"note":note["note"] if note else None,
                      "availability":av,"unit_total_czk":round(float(r["price_czk"])+modifier_total,2)})
            x["line_total_czk"]=round(x["unit_total_czk"]*int(r["qty"]),2)
            items.append(x)
        subtotal=round(sum(x["line_total_czk"] for x in items),2)
        _,issues,_=_v115_validate_cart_rows(c,u["customer_id"])
        return {"schema_version":"1.15","merchant_id":items[0]["merchant_id"] if items else None,
                "items":items,"subtotal_czk":subtotal,"valid":not issues,"issues":issues}

@app.post("/api/v115/cart/item")
def v115_cart_item(body: CartModifierIn, authorization: str | None = Header(default=None)):
    u=current_user(authorization); require_role(u,"customer")
    with core_db_connect() as c:
        item=c.execute("SELECT id,merchant_id,active FROM menu_items WHERE id=?",(body.menu_item_id,)).fetchone()
        if not item or not item["active"]: raise HTTPException(404,"Položka není dostupná")
        av=_v115_effective_availability(c,body.menu_item_id)
        if av["state"]!="AVAILABLE": raise HTTPException(409,"Položka je vyprodaná")
        any_item=c.execute("SELECT merchant_id FROM cart_items WHERE customer_id=? LIMIT 1",(u["customer_id"],)).fetchone()
        if any_item and any_item["merchant_id"]!=item["merchant_id"]: raise HTTPException(409,"Košík může obsahovat jednu restauraci")
        groups={r["id"]:dict(r) for r in c.execute("""
            SELECT mg.id,mg.min_select,mg.max_select FROM modifier_groups mg
            JOIN menu_item_modifier_groups mmg ON mmg.group_id=mg.id
            WHERE mmg.menu_item_id=? AND mg.active=1
        """,(body.menu_item_id,)).fetchall()}
        selected={}
        normalized=[]
        for raw in body.modifiers:
            mid=raw.get("modifier_id"); qty=int(raw.get("qty",1))
            if qty<1 or qty>5: raise HTTPException(400,"Neplatné množství modifieru")
            mod=c.execute("""
                SELECT mo.id,mo.name,mo.price_czk,mo.group_id FROM modifiers mo
                JOIN modifier_groups mg ON mg.id=mo.group_id
                JOIN menu_item_modifier_groups mmg ON mmg.group_id=mg.id
                WHERE mo.id=? AND mmg.menu_item_id=? AND mo.active=1 AND mg.active=1
            """,(mid,body.menu_item_id)).fetchone()
            if not mod: raise HTTPException(400,"Modifier není povolený pro tuto položku")
            selected[mod["group_id"]]=selected.get(mod["group_id"],0)+qty
            normalized.append((mod["id"],qty))
        for gid,g in groups.items():
            n=selected.get(gid,0)
            if n<int(g["min_select"]): raise HTTPException(400,f"Vyber alespoň {g['min_select']} položku ve skupině")
            if n>int(g["max_select"]): raise HTTPException(400,f"Maximálně {g['max_select']} položky ve skupině")
        existing=c.execute("SELECT id FROM cart_items WHERE customer_id=? AND menu_item_id=?",(u["customer_id"],body.menu_item_id)).fetchone()
        if existing: cart_id=existing["id"]
        else:
            cart_id="ci_"+uuid.uuid4().hex[:12]
            c.execute("INSERT INTO cart_items(id,customer_id,merchant_id,menu_item_id,qty) VALUES (?,?,?,?,?)",(cart_id,u["customer_id"],item["merchant_id"],item["id"],1))
        c.execute("DELETE FROM cart_item_modifiers WHERE cart_item_id=?",(cart_id,))
        for mid,qty in normalized: c.execute("INSERT INTO cart_item_modifiers(cart_item_id,modifier_id,qty) VALUES (?,?,?)",(cart_id,mid,qty))
        c.execute("CREATE TABLE IF NOT EXISTS cart_item_notes(cart_item_id TEXT PRIMARY KEY,note TEXT,updated_at TEXT NOT NULL)")
        c.execute("INSERT INTO cart_item_notes(cart_item_id,note,updated_at) VALUES (?,?,?) ON CONFLICT(cart_item_id) DO UPDATE SET note=excluded.note,updated_at=excluded.updated_at",(cart_id,body.note,now()))
        c.commit()
    return v115_cart(authorization)

@app.post("/api/v115/cart/clear")
