        seq=int(last['sequence_no'])+1 if last else 1;prev=last['entry_sha256'] if last else _V105_POLICY['genesis_hash']
        obj=_v105_payload(fin,seq,prev);eh=_v105_hash(obj);key,pub,keyid=_v169_load_signer();sig=base64.b64encode(key.sign(_v105_json(obj).encode())).decode();eid='grfcf105_'+uuid.uuid4().hex[:16];t=now();op=str(u.get('email') or u.get('id') or 'operator')
        c.execute('INSERT INTO production_global_recovery_checkpoint_finality_continuity_chain(id,sequence_no,checkpoint_finality_id,checkpoint_id,checkpoint_sha256,finality_proof_sha256,previous_entry_sha256,entry_json,entry_sha256,algorithm,signer_key_id,public_key_b64,signature_b64,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(eid,seq,fid,fin['checkpoint_id'],fin['checkpoint_sha256'],fin['proof_sha256'],prev,_v105_json(obj),eh,'Ed25519',keyid,base64.b64encode(pub).decode(),sig,'APPENDED',t,op));c.commit();row=c.execute('SELECT * FROM production_global_recovery_checkpoint_finality_continuity_chain WHERE id=?',(eid,)).fetchone();return {'schema_version':'1.105','idempotent':False,'entry':dict(row),'verification':_v105_verify_entry(c,row)}
@app.get('/api/v105/ops/global-recovery-checkpoint-finality-chain/verify')
def v105_verify(authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:return {'schema_version':'1.105',**_v105_verify_chain(c)}
@app.get('/api/v105/ops/global-recovery-checkpoint-finality-chain/latest')
def v105_latest(authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        row=c.execute('SELECT * FROM production_global_recovery_checkpoint_finality_continuity_chain ORDER BY sequence_no DESC LIMIT 1').fetchone()
        return {'schema_version':'1.105','entry':dict(row) if row else None,'verification':_v105_verify_entry(c,row) if row else {'valid':True,'reason':'NO_ENTRIES'},'chain_verification':_v105_verify_chain(c)}


