# ---------------------------------------------------------------------------
# WUNOO v1.16 — canonical order lifecycle facade
# ---------------------------------------------------------------------------
# v1.15 made checkout authoritative. v1.16 closes the loop with one explicit
# lifecycle contract for merchant/courier operations while keeping the older
# endpoint family backwards compatible.

V116_LIFECYCLE = [
    "payment_pending", "merchant_pending", "preparing", "dispatch_pending",
    "assigned", "picked_up", "out_for_delivery", "delivered"
]
V116_ACTIONS = {
    "accept": ("merchant", "merchant_pending", "preparing", "merchant_accepted"),
    "ready": ("merchant", "preparing", "dispatch_pending", "merchant_ready"),
    "dispatch": ("courier", "dispatch_pending", "assigned", "courier_assigned"),
    "pickup": ("courier", "assigned", "picked_up", "pickup_completed"),
    "start_delivery": ("courier", "picked_up", "out_for_delivery", "out_for_delivery_started"),
}


def _v116_order_scope(c: sqlite3.Connection, order_id: str, u: dict[str, Any]) -> sqlite3.Row:
    o = c.execute("SELECT * FROM orders WHERE id=?", (order_id,)).fetchone()
    if not o:
        raise HTTPException(404, "Objednávka nenalezena")
    if u["role"] == "customer" and o["customer_id"] != u["customer_id"]:
        raise HTTPException(403, "Objednávka není vaše")
    if u["role"] == "merchant" and o["merchant_id"] != u.get("merchant_id"):
        raise HTTPException(403, "Objednávka není vaše restaurace")
    if u["role"] == "courier" and o["courier_id"] not in (None, u.get("courier_id")):
        raise HTTPException(403, "Objednávka není přiřazená vám")
    return o


def _v116_lifecycle_payload(c: sqlite3.Connection, o: sqlite3.Row) -> dict[str, Any]:
    status = str(o["status"])
    idx = V116_LIFECYCLE.index(status) if status in V116_LIFECYCLE else -1
    stages = [
        ("merchant_pending", "Čeká na restauraci"),
        ("preparing", "Připravuje se"),
        ("dispatch_pending", "Hledáme kurýra"),
        ("assigned", "Kurýr přiřazen"),
        ("picked_up", "Vyzvednuto"),
        ("out_for_delivery", "Na cestě"),
        ("delivered", "Doručeno"),
    ]
    payment = c.execute("SELECT id,status,amount_czk,created_at FROM payments WHERE order_id=?", (o["id"],)).fetchone()
    settlement = c.execute("SELECT id,merchant_czk,courier_czk,platform_czk,variance_czk,status,created_at FROM settlements WHERE order_id=?", (o["id"],)).fetchone()
    events = c.execute("SELECT type,actor_user_id,payload,created_at FROM events WHERE order_id=? ORDER BY created_at", (o["id"],)).fetchall()
    audit = c.execute("SELECT from_state,to_state,actor_id,created_at FROM state_transition_audit WHERE entity_id=? ORDER BY created_at", (o["id"],)).fetchall()
    return {
        "schema_version": "1.16",
        "order_id": o["id"],
        "status": status,
        "status_index": idx,
        "merchant_id": o["merchant_id"],
        "courier_id": o["courier_id"],
        "total_czk": float(o["total_czk"]),
        "payment": dict(payment) if payment else None,
        "settlement": dict(settlement) if settlement else None,
        "stages": [{"key": key, "label": label, "done": idx >= i} for i, (key, label) in enumerate(stages, 1)],
        "events": [dict(x) for x in events],
        "transition_audit": [dict(x) for x in audit],
    }


@app.get("/api/v116/merchant/queue")
def v116_merchant_queue(authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u = current_user(authorization); require_role(u, {"merchant", "admin", "ops_agent"})
    with core_db_connect() as c:
        if u["role"] == "merchant":
            rows = c.execute("""
                SELECT o.id,o.status,o.subtotal_czk,o.total_czk,o.created_at,o.prep_eta_minutes,
                       m.name merchant_name
                FROM orders o JOIN merchants m ON m.id=o.merchant_id
                WHERE o.merchant_id=? AND o.status IN ('merchant_pending','preparing')
                ORDER BY o.created_at ASC
            """, (u.get("merchant_id"),)).fetchall()
        else:
            rows = c.execute("""
                SELECT o.id,o.status,o.subtotal_czk,o.total_czk,o.created_at,o.prep_eta_minutes,
                       m.name merchant_name
                FROM orders o JOIN merchants m ON m.id=o.merchant_id
                WHERE o.status IN ('merchant_pending','preparing')
                ORDER BY o.created_at ASC
            """).fetchall()
        return {"schema_version":"1.16","orders":[dict(x) for x in rows]}


@app.get("/api/v116/courier/queue")
def v116_courier_queue(authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u = current_user(authorization); require_role(u, {"courier", "admin", "ops_agent"})
    with core_db_connect() as c:
        if u["role"] == "courier":
            rows = c.execute("""
                SELECT o.id,o.status,o.merchant_id,o.courier_id,o.address,o.total_czk,
                       o.assigned_at,o.picked_up_at,o.predicted_delivery_at,m.name merchant_name
                FROM orders o JOIN merchants m ON m.id=o.merchant_id
                WHERE (o.status='dispatch_pending' OR o.courier_id=?)
                  AND o.status IN ('dispatch_pending','assigned','picked_up','out_for_delivery')
                ORDER BY o.created_at DESC
            """, (u.get("courier_id"),)).fetchall()
        else:
            rows = c.execute("""
                SELECT o.id,o.status,o.merchant_id,o.courier_id,o.address,o.total_czk,
                       o.assigned_at,o.picked_up_at,o.predicted_delivery_at,m.name merchant_name
                FROM orders o JOIN merchants m ON m.id=o.merchant_id
                WHERE o.status IN ('dispatch_pending','assigned','picked_up','out_for_delivery')
                ORDER BY o.created_at DESC
            """).fetchall()
        return {"schema_version":"1.16","orders":[dict(x) for x in rows]}


@app.get("/api/v116/orders/{order_id}/lifecycle")
def v116_order_lifecycle(order_id: str, authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u = current_user(authorization)
    with core_db_connect() as c:
        o = _v116_order_scope(c, order_id, u)
        return _v116_lifecycle_payload(c, o)


@app.post("/api/v116/orders/{order_id}/transition")
def v116_order_transition(order_id: str, body: dict[str, Any], authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u = current_user(authorization)
    action = str(body.get("action", "")).strip()
    if action not in V116_ACTIONS and action != "deliver":
        raise HTTPException(400, "Neplatná lifecycle akce")

    with core_db_connect() as c:
        o = _v116_order_scope(c, order_id, u)

        if action == "deliver":
            require_role(u, {"courier", "admin", "ops_agent"})
            if u["role"] == "courier" and o["courier_id"] != u.get("courier_id"):
                raise HTTPException(403, "Objednávka není přiřazená vám")
            if o["status"] == "delivered":
                return {"schema_version":"1.16","order_id":order_id,"action":"deliver","status":"delivered","idempotent":True}
            if o["status"] not in {"picked_up", "out_for_delivery"}:
                raise HTTPException(409, f"Objednávku nelze doručit ze stavu {o['status']}")
            # Keep the existing settlement implementation authoritative.
            proof_required = ("delivery_proof_status" in o.keys() and o["delivery_proof_status"] == "required_v044")
            if proof_required and u["role"] != "admin":
                proof = c.execute("SELECT 1 FROM delivery_proofs WHERE order_id=?", (order_id,)).fetchone()
                if not proof:
                    raise HTTPException(409, "Před dokončením doručení chybí proof-of-delivery")
            if c.execute("SELECT 1 FROM settlements WHERE order_id=?", (order_id,)).fetchone():
                raise HTTPException(409, "Settlement již existuje")
            current = o["status"]
            transition(c, order_id, current, "delivered", u, "delivery_completed", {"courier_id": o["courier_id"], "schema_version":"1.16"})
            courier_payout = round(40.0 + 7.0 * float(o["delivery_distance_km"]), 2)
            merchant_amount = round(float(o["subtotal_czk"]), 2)
            platform_amount = round(float(o["total_czk"]) - merchant_amount - courier_payout, 2)
            variance = round(float(o["total_czk"]) - merchant_amount - courier_payout - platform_amount, 2)
            sid = "set_" + uuid.uuid4().hex[:10]
            c.execute("INSERT INTO settlements VALUES (?,?,?,?,?,?,?,?)", (sid, order_id, merchant_amount, courier_payout, platform_amount, variance, "reconciled" if variance == 0 else "exception", now()))
            if o["courier_id"]:
                c.execute("UPDATE couriers SET earnings_czk=earnings_czk+? WHERE id=?", (courier_payout, o["courier_id"]))
            ts = now()
            c.execute("UPDATE orders SET delivered_at=?, updated_at=? WHERE id=?", (ts, ts, order_id))
            emit(c, order_id, "settlement_completed", {"settlement_id":sid,"variance_czk":variance,"schema_version":"1.16"}, u["id"])
            c.commit()
            return {"schema_version":"1.16","order_id":order_id,"action":"deliver","status":"delivered","settlement_id":sid,"variance_czk":variance,"idempotent":False}

        role, expected, target, event_type = V116_ACTIONS[action]
        if u["role"] not in {role, "admin", "ops_agent"}:
            raise HTTPException(403, "Nedostatečné oprávnění")
        if action == "dispatch":
            if o["status"] == "assigned" and o["courier_id"] == u.get("courier_id"):
                return {"schema_version":"1.16","order_id":order_id,"action":action,"status":"assigned","courier_id":o["courier_id"],"idempotent":True}
            if o["status"] != expected:
                raise HTTPException(409, f"Objednávka je ve stavu {o['status']}, očekává se {expected}")
            candidates = courier_candidates(c, o)
            if u["role"] == "courier":
                candidates = [x for x in candidates if x["courier_id"] == u.get("courier_id")]
            if not candidates:
                raise HTTPException(409, "Žádný oprávněný online kurýr")
            candidate = candidates[0]
            ts = now()
            from datetime import timedelta
            eta_min = int(candidate["pickup_eta_minutes"])
            predicted_pickup = (datetime.now(timezone.utc) + timedelta(minutes=eta_min)).isoformat()
            predicted_delivery = (datetime.now(timezone.utc) + timedelta(minutes=eta_min + 30)).isoformat()
            updated = c.execute("""UPDATE orders SET courier_id=?,status='assigned',assigned_at=?,
                predicted_pickup_at=?,predicted_delivery_at=?,updated_at=?
                WHERE id=? AND status='dispatch_pending'""", (candidate["courier_id"],ts,predicted_pickup,predicted_delivery,ts,order_id)).rowcount
            if updated != 1:
                raise HTTPException(409, "State transition conflict")
            emit(c,order_id,event_type,{"courier_id":candidate["courier_id"],"algorithm_version":"v0.12","schema_version":"1.16"},u["id"])
            _notify_order_status(c,order_id,"assigned")
            c.commit()
            return {"schema_version":"1.16","order_id":order_id,"action":action,"status":"assigned","courier_id":candidate["courier_id"],"idempotent":False}

        if o["status"] == target:
            return {"schema_version":"1.16","order_id":order_id,"action":action,"status":target,"idempotent":True}
        if o["status"] != expected:
            raise HTTPException(409, f"Objednávka je ve stavu {o['status']}, očekává se {expected}")
        if action in {"pickup", "start_delivery"} and u["role"] == "courier" and o["courier_id"] != u.get("courier_id"):
            raise HTTPException(403, "Objednávka není přiřazená vám")
        transition(c, order_id, expected, target, u, event_type, {"from":expected,"to":target,"schema_version":"1.16"})
        if action == "pickup":
            c.execute("UPDATE orders SET picked_up_at=?,updated_at=? WHERE id=?", (now(),now(),order_id))
        c.commit()
        return {"schema_version":"1.16","order_id":order_id,"action":action,"status":target,"idempotent":False}


@app.get("/frontend_v029/order_lifecycle_v116.html")
def v116_order_lifecycle_page():
    return FileResponse(BASE.parent / "frontend_v029" / "order_lifecycle_v116.html")


# ---------------------------------------------------------------------------
# WUNOO v1.17 — operational control tower + role-aware live order view
# ---------------------------------------------------------------------------
# v1.17 turns the canonical v1.16 lifecycle into a usable operational surface:
# one compact dashboard contract for customer, merchant, courier and ops, plus
# a customer-safe tracking payload. It is additive and does not replace legacy
# order/tracking endpoints.

V117_ACTIVE_STATUSES = {
    "payment_pending", "merchant_pending", "preparing", "dispatch_pending",
    "assigned", "picked_up", "out_for_delivery", "delayed"
}
V117_STATUS_LABELS = {
    "payment_pending": "Čeká na platbu",
    "merchant_pending": "Čeká na restauraci",
    "preparing": "Připravuje se",
    "dispatch_pending": "Hledáme kurýra",
    "assigned": "Kurýr přiřazen",
    "picked_up": "Vyzvednuto",
    "out_for_delivery": "Na cestě",
    "delayed": "Zpožděno",
    "delivered": "Doručeno",
    "cancelled": "Zrušeno",
}


def _v117_order_scope(c: sqlite3.Connection, order_id: str, u: dict[str, Any]) -> sqlite3.Row:
    o = c.execute("""
        SELECT o.*, m.name merchant_name, cr.name courier_name
        FROM orders o JOIN merchants m ON m.id=o.merchant_id
        LEFT JOIN couriers cr ON cr.id=o.courier_id
        WHERE o.id=?
    """, (order_id,)).fetchone()
    if not o:
        raise HTTPException(404, "Objednávka nenalezena")
    if u["role"] == "customer" and o["customer_id"] != u["customer_id"]:
        raise HTTPException(403, "Objednávka není vaše")
    if u["role"] == "merchant" and o["merchant_id"] != u.get("merchant_id"):
        raise HTTPException(403, "Objednávka není vaše restaurace")
    if u["role"] == "courier" and o["courier_id"] not in (None, u.get("courier_id")):
        raise HTTPException(403, "Objednávka není přiřazená vám")
    return o


def _v117_next_actions(status: str, role: str, courier_id: str | None = None, assigned_courier_id: str | None = None) -> list[dict[str, str]]:
    actions: list[dict[str, str]] = []
    if role in {"merchant", "admin", "ops_agent"}:
        if status == "merchant_pending": actions.append({"action":"accept", "label":"Přijmout objednávku"})
        elif status == "preparing": actions.append({"action":"ready", "label":"Označit jako připravené"})
    if role in {"courier", "admin", "ops_agent"}:
        if status == "dispatch_pending": actions.append({"action":"dispatch", "label":"Přiřadit kurýra"})
        elif status == "assigned" and (role != "courier" or assigned_courier_id == courier_id): actions.append({"action":"pickup", "label":"Vyzvednout"})
        elif status == "picked_up" and (role != "courier" or assigned_courier_id == courier_id): actions.append({"action":"start_delivery", "label":"Zahájit doručení"})
        elif status in {"picked_up", "out_for_delivery"} and (role != "courier" or assigned_courier_id == courier_id): actions.append({"action":"deliver", "label":"Doručit"})
    return actions


def _v117_tracking_payload(c: sqlite3.Connection, o: sqlite3.Row, u: dict[str, Any]) -> dict[str, Any]:
    status = str(o["status"])
    states = ["payment_pending", "merchant_pending", "preparing", "dispatch_pending", "assigned", "picked_up", "out_for_delivery", "delivered"]
    idx = states.index(status) if status in states else -1
    loc = _latest_courier_location(c, o["courier_id"])
    location_age_seconds = None
    if loc:
        try:
            location_age_seconds = max(0, round((datetime.now(timezone.utc) - datetime.fromisoformat(loc["recorded_at"].replace("Z", "+00:00"))).total_seconds()))
        except Exception:
            location_age_seconds = None
    items = c.execute("""
        SELECT oi.id, oi.menu_item_id, mi.name, oi.qty, oi.unit_price_czk
        FROM order_items oi JOIN menu_items mi ON mi.id=oi.menu_item_id
        WHERE oi.order_id=? ORDER BY oi.id
    """, (o["id"],)).fetchall()
    modifiers = c.execute("""
        SELECT oim.order_item_id, oim.modifier_id, oim.name_snapshot, oim.price_snapshot_czk, oim.qty
        FROM order_item_modifiers oim JOIN order_items oi ON oi.id=oim.order_item_id
        WHERE oi.order_id=? ORDER BY oim.order_item_id, oim.name_snapshot
    """, (o["id"],)).fetchall()
    modifier_by_item: dict[str, list[dict[str, Any]]] = {}
    for m in modifiers:
        modifier_by_item.setdefault(m["order_item_id"], []).append(dict(m))
    payment = c.execute("SELECT id,status,amount_czk,created_at FROM payments WHERE order_id=?", (o["id"],)).fetchone()
    settlement = c.execute("SELECT id,merchant_czk,courier_czk,platform_czk,variance_czk,status,created_at FROM settlements WHERE order_id=?", (o["id"],)).fetchone()
    events = c.execute("SELECT type,actor_user_id,payload,created_at FROM events WHERE order_id=? ORDER BY created_at", (o["id"],)).fetchall()
    stages = [
        ("merchant_pending", "Restaurace"), ("preparing", "Příprava"),
        ("dispatch_pending", "Kurýr"), ("assigned", "Přiřazen"),
        ("picked_up", "Vyzvednuto"), ("out_for_delivery", "Na cestě"),
        ("delivered", "Doručeno")
    ]
    return {
        "schema_version": "1.17",
        "order_id": o["id"],
        "status": status,
        "status_label": V117_STATUS_LABELS.get(status, status),
        "status_index": idx,
        "merchant": {"id": o["merchant_id"], "name": o["merchant_name"]},
        "courier": {"id": o["courier_id"], "name": o["courier_name"]} if o["courier_id"] else None,
        "address": o["address"],
        "totals": {"subtotal_czk": float(o["subtotal_czk"]), "service_fee_czk": float(o["service_fee_czk"]), "delivery_fee_czk": float(o["delivery_fee_czk"]), "total_czk": float(o["total_czk"])},
        "timing": {"prep_eta_minutes": o["prep_eta_minutes"], "promised_delivery_at": o["promised_delivery_at"], "predicted_pickup_at": o["predicted_pickup_at"], "predicted_delivery_at": o["predicted_delivery_at"], "assigned_at": o["assigned_at"], "picked_up_at": o["picked_up_at"], "delivered_at": o["delivered_at"], "delay_level": o["delay_level"]},
        "stages": [{"key": key, "label": label, "done": idx >= i} for i, (key, label) in enumerate(stages, 1)],
        "items": [{**dict(item), "modifiers": modifier_by_item.get(item["id"], [])} for item in items],
        "payment": dict(payment) if payment else None,
        "settlement": dict(settlement) if settlement else None,
        "courier_location": loc,
        "location_age_seconds": location_age_seconds,
        "location_stale": location_age_seconds is None or location_age_seconds > 120,
        "next_actions": _v117_next_actions(status, u["role"], u.get("courier_id"), o["courier_id"]),
        "events": [dict(e) for e in events[-30:]],
    }


@app.get("/api/v117/dashboard")
def v117_dashboard(authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u = current_user(authorization)
    role = u["role"]
    with core_db_connect() as c:
        if role == "customer":
            rows = c.execute("""
                SELECT o.id,o.status,o.total_czk,o.created_at,o.predicted_delivery_at,o.promised_delivery_at,
                       o.courier_id,m.name merchant_name
                FROM orders o JOIN merchants m ON m.id=o.merchant_id
                WHERE o.customer_id=? ORDER BY o.created_at DESC LIMIT 50
            """, (u["customer_id"],)).fetchall()
        elif role == "merchant":
            rows = c.execute("""
                SELECT o.id,o.status,o.total_czk,o.created_at,o.predicted_delivery_at,o.promised_delivery_at,
                       o.courier_id,m.name merchant_name
                FROM orders o JOIN merchants m ON m.id=o.merchant_id
                WHERE o.merchant_id=? ORDER BY o.created_at DESC LIMIT 100
            """, (u["merchant_id"],)).fetchall()
        elif role == "courier":
            rows = c.execute("""
                SELECT o.id,o.status,o.total_czk,o.created_at,o.predicted_delivery_at,o.promised_delivery_at,
                       o.courier_id,m.name merchant_name
                FROM orders o JOIN merchants m ON m.id=o.merchant_id
                WHERE o.courier_id=? OR o.status='dispatch_pending'
                ORDER BY o.created_at DESC LIMIT 100
            """, (u["courier_id"],)).fetchall()
        else:
            rows = c.execute("""
                SELECT o.id,o.status,o.total_czk,o.created_at,o.predicted_delivery_at,o.promised_delivery_at,
                       o.courier_id,m.name merchant_name
                FROM orders o JOIN merchants m ON m.id=o.merchant_id
                ORDER BY o.created_at DESC LIMIT 200
            """).fetchall()
        orders = []
        for r in rows:
            x = dict(r)
            x["status_label"] = V117_STATUS_LABELS.get(x["status"], x["status"])
            x["next_actions"] = _v117_next_actions(x["status"], role, u.get("courier_id"), x.get("courier_id"))
            orders.append(x)
        counts = {s: int(c.execute("SELECT COUNT(*) n FROM orders WHERE status=?", (s,)).fetchone()["n"]) for s in V117_STATUS_LABELS}
        if role == "customer":
            customer_filter = " AND customer_id=?"; args=(u["customer_id"],)
        elif role == "merchant":
            customer_filter = " AND merchant_id=?"; args=(u["merchant_id"],)
        elif role == "courier":
            customer_filter = " AND courier_id=?"; args=(u["courier_id"],)
        else:
            customer_filter = ""; args=()
        active = int(c.execute(f"SELECT COUNT(*) n FROM orders WHERE status IN ('merchant_pending','preparing','dispatch_pending','assigned','picked_up','out_for_delivery','delayed'){customer_filter}", args).fetchone()["n"])
        return {"schema_version":"1.17", "role":role, "user_id":u["id"], "active_count":active, "global_status_counts":counts if role in {"admin","ops_agent"} else None, "orders":orders}


@app.get("/api/v117/orders/{order_id}/tracking")
def v117_order_tracking(order_id: str, authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u = current_user(authorization)
    with core_db_connect() as c:
        o = _v117_order_scope(c, order_id, u)
        return _v117_tracking_payload(c, o, u)


@app.get("/api/v117/ops/control-tower")
def v117_control_tower(authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u = current_user(authorization); require_role(u, {"admin", "ops_agent"})
    with core_db_connect() as c:
        rows = c.execute("""
            SELECT o.id,o.status,o.delay_level,o.total_czk,o.created_at,o.updated_at,
                   o.merchant_id,m.name merchant_name,o.courier_id,cr.name courier_name,
                   o.predicted_delivery_at,o.promised_delivery_at
            FROM orders o JOIN merchants m ON m.id=o.merchant_id
            LEFT JOIN couriers cr ON cr.id=o.courier_id
            WHERE o.status NOT IN ('delivered','cancelled')
            ORDER BY CASE WHEN o.delay_level IN ('CRITICAL','MATERIAL_DELAY') THEN 0 WHEN o.delay_level='DELAYED' THEN 1 ELSE 2 END, o.created_at ASC
            LIMIT 200
        """).fetchall()
        critical = sum(1 for r in rows if r["delay_level"] in {"CRITICAL","MATERIAL_DELAY"})
        delayed = sum(1 for r in rows if r["delay_level"] == "DELAYED")
        return {"schema_version":"1.17", "open_orders":len(rows), "critical":critical, "delayed":delayed, "orders":[dict(r) for r in rows]}


