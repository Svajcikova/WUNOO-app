@app.get("/api/v039/merchants/{merchant_id}/availability")
def v039_availability(merchant_id: str, authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u=current_user(authorization)
    require_role(u, "customer")
    with core_db_connect() as c:
        m=c.execute("SELECT id,name,active FROM merchants WHERE id=?",(merchant_id,)).fetchone()
        if not m: raise HTTPException(404,"Restaurace nenalezena")
        if not m["active"]: return {"merchant_id":merchant_id,"status":"CLOSED","open_now":False,"reason":"merchant_inactive"}
        return {"merchant_id":merchant_id,"name":m["name"],**_v039_availability(c,merchant_id)}

@app.post("/api/v039/merchants/{merchant_id}/hours-exception")
def v039_hours_exception(merchant_id: str, body: dict[str, Any], authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u=current_user(authorization)
    require_role(u, "merchant")
    if u["merchant_id"] != merchant_id: raise HTTPException(403,"forbidden")
    status=str(body.get("status","")).lower()
    if status not in {"closed","open","pre_order"}: raise HTTPException(400,"Neplatný status")
    date_local=str(body.get("date_local",""))
    if not re.fullmatch(r"\d{4}-\d{2}-\d{2}",date_local): raise HTTPException(400,"date_local musí být YYYY-MM-DD")
    open_time=body.get("open_time"); close_time=body.get("close_time")
    if status!="closed" and (not open_time or not close_time): raise HTTPException(400,"open_time/close_time jsou povinné")
    if open_time and not re.fullmatch(r"\d{2}:\d{2}",str(open_time)): raise HTTPException(400,"Neplatný open_time")
    if close_time and not re.fullmatch(r"\d{2}:\d{2}",str(close_time)): raise HTTPException(400,"Neplatný close_time")
    eid="hex_"+uuid.uuid4().hex[:10]
    with core_db_connect() as c:
        ok=c.execute("SELECT 1 FROM merchants WHERE id=?",(merchant_id,)).fetchone()
        if not ok: raise HTTPException(404,"Restaurace nenalezena")
        c.execute("INSERT INTO merchant_hours_exceptions VALUES (?,?,?,?,?,?,?,?)",
                  (eid,merchant_id,date_local,status,open_time,close_time,body.get("note"),now()))
        emit(c,None,"merchant_hours_exception_created",{"merchant_id":merchant_id,"date_local":date_local,"status":status},u["id"])
        c.commit()
    return {"id":eid,"merchant_id":merchant_id,"date_local":date_local,"status":status,"open_time":open_time,"close_time":close_time}

