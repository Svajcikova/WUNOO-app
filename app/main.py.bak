@app.post("/api/v084/ops/security/idor-suite")
def v084_idor_suite(authorization:str|None=Header(default=None),
                     idempotency_key:str|None=Header(default=None,alias="Idempotency-Key"))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    key=idempotency_key or ("idor_"+uuid.uuid4().hex[:16])
    with core_db_connect() as c:
        old=c.execute("SELECT * FROM idor_attack_runs WHERE run_key=?",(key,)).fetchone()
        if old:
            return {"run":dict(old),"results":[dict(x) for x in c.execute("SELECT * FROM idor_attack_results WHERE run_id=? ORDER BY id",(old["id"],)).fetchall()],"duplicate":True}
        rid="iar_"+uuid.uuid4().hex[:12]
        c.execute("INSERT INTO idor_attack_runs(id,run_key,status,started_at) VALUES (?,?,?,?)",(rid,key,"running",now()))
        results=[]
        for resource,role,attack,expected in V084_ATTACK_CASES:
            subject={"id":"attacker_"+role,"role":role,"merchant_id":"tenant_A","tenant_id":"tenant_A"}
            resource_id="victim_resource_999"
            hostile_tenant="tenant_B"
            # All attack cases intentionally use a mismatched owner/tenant or forbidden action.
            action="read" if attack in {"id_swap","tenant_swap","owner_swap"} else ("assign" if "assign" in attack else "transition")
            allowed,reason=AuthorizationPolicyEngine(c).allow(subject,resource,action,resource_id,hostile_tenant)
            observed=200 if allowed else 403
            status="PASS" if observed==expected else "FAIL"
            details={"attack":attack,"victim_resource_id":resource_id,"hostile_tenant":hostile_tenant,"reason":reason,"business_called":False if observed==403 else True}
            c.execute("INSERT INTO idor_attack_results VALUES (?,?,?,?,?,?,?,?,?,?)",
                      ("idx_"+uuid.uuid4().hex[:12],rid,resource,attack,role,expected,observed,status,json.dumps(details),now()))
            results.append({"resource":resource,"attack":attack,"role":role,"expected_code":expected,"observed_code":observed,"status":status,"reason":reason})
        passed=sum(x["status"]=="PASS" for x in results); ok=passed==len(results)
        c.execute("UPDATE idor_attack_runs SET status=?,completed_at=?,total_cases=?,passed_cases=?,details_json=? WHERE id=?",
                  ("passed" if ok else "failed",now(),len(results),passed,json.dumps({"attack_classes":5,"fail_closed":True}),rid)); c.commit()
        return {"run_id":rid,"status":"passed" if ok else "failed","total":len(results),"passed":passed,"results":results}

