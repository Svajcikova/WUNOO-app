@app.get("/api/v037/menu/{menu_item_id}/modifiers")
def v037_menu_modifiers(menu_item_id: str, authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u=current_user(authorization); require_role(u,"customer")
    with core_db_connect() as c:
        item=c.execute("SELECT id,merchant_id,name,price_czk,active FROM menu_items WHERE id=?",(menu_item_id,)).fetchone()
        if not item: raise HTTPException(404,"Položka nenalezena")
        groups=c.execute("""
            SELECT mg.id,mg.name,mg.min_select,mg.max_select,mg.active
            FROM modifier_groups mg JOIN menu_item_modifier_groups mmg ON mmg.group_id=mg.id
            WHERE mmg.menu_item_id=? AND mg.active=1 ORDER BY mg.name
        """,(menu_item_id,)).fetchall()
        out=[]
        for g in groups:
            mods=c.execute("SELECT id,name,price_czk,active FROM modifiers WHERE group_id=? AND active=1 ORDER BY name",(g["id"],)).fetchall()
            out.append({**dict(g),"modifiers":[dict(m) for m in mods]})
        return {"menu_item":dict(item),"groups":out}


@app.put("/api/v037/cart/item")
def v037_cart_item(body: CartModifierIn, authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u=current_user(authorization); require_role(u,"customer")
    with core_db_connect() as c:
        item=c.execute("SELECT id,merchant_id,active FROM menu_items WHERE id=?",(body.menu_item_id,)).fetchone()
        if not item or not item["active"]: raise HTTPException(404,"Položka není dostupná")
        live=_v138_live_publication(c,item['merchant_id']) if _db_table_exists(c,'merchant_menu_publications') else None
        if not live: raise HTTPException(409,"Restaurace zatím nemá publikované menu")
        live_snap=json.loads(live['snapshot_json']); live_item=next((x for x in live_snap.get('items',[]) if str(x.get('id'))==str(body.menu_item_id)),None)
        if not live_item: raise HTTPException(409,"Položka není v aktuálním publikovaném menu")
        if str((live_item.get('availability') or {}).get('state','AVAILABLE'))=='SOLD_OUT': raise HTTPException(409,"Položka je momentálně vyprodaná")
        existing=c.execute("SELECT id,merchant_id FROM cart_items WHERE customer_id=? AND menu_item_id=?",(u["customer_id"],body.menu_item_id)).fetchone()
        if not existing:
            # Respect the existing one-merchant cart rule.
            any_item=c.execute("SELECT merchant_id FROM cart_items WHERE customer_id=? LIMIT 1",(u["customer_id"],)).fetchone()
            if any_item and any_item["merchant_id"]!=item["merchant_id"]: raise HTTPException(409,"Košík může obsahovat jednu restauraci")
            cart_id=str(uuid.uuid4())
            c.execute("INSERT INTO cart_items(id,customer_id,merchant_id,menu_item_id,qty,menu_publication_no,menu_snapshot_sha256,unit_price_snapshot_czk,menu_item_name_snapshot) VALUES (?,?,?,?,?,?,?,?,?)",
                      (cart_id,u['customer_id'],item['merchant_id'],item['id'],1,int(live['publication_no']),live['snapshot_sha256'],float(live_item.get('price_czk',0)),live_item.get('name','')))
        else:
            cart_id=existing["id"]
            c.execute("UPDATE cart_items SET menu_publication_no=?,menu_snapshot_sha256=?,unit_price_snapshot_czk=?,menu_item_name_snapshot=? WHERE id=?",
                      (int(live['publication_no']),live['snapshot_sha256'],float(live_item.get('price_czk',0)),live_item.get('name',''),cart_id))
        c.execute("DELETE FROM cart_item_modifiers WHERE cart_item_id=?",(cart_id,))
        for raw in body.modifiers:
            mid=raw.get("modifier_id"); qty=int(raw.get("qty",1))
            if qty<1 or qty>5: raise HTTPException(400,"Neplatné množství modifieru")
            mod=c.execute("""
                SELECT mo.id,mo.name,mo.price_czk,mo.group_id,mg.min_select,mg.max_select
                FROM modifiers mo JOIN modifier_groups mg ON mg.id=mo.group_id
                JOIN menu_item_modifier_groups mmg ON mmg.group_id=mg.id
                WHERE mo.id=? AND mmg.menu_item_id=? AND mo.active=1 AND mg.active=1
            """,(mid,body.menu_item_id)).fetchone()
            if not mod: raise HTTPException(400,"Modifier není povolený pro tuto položku")
            live_groups={g['id']:g for g in (next((x for x in live_snap.get('items',[]) if str(x.get('id'))==str(body.menu_item_id)),{}) or {}).get('modifier_groups',[])}
            allowed_modifier=next((m for g in live_groups.values() for m in g.get('modifiers',[]) if str(m.get('id'))==str(mid)),None)
            if not allowed_modifier: raise HTTPException(409,"Modifier není v aktuálním publikovaném menu")
            c.execute("INSERT INTO cart_item_modifiers(cart_item_id,modifier_id,qty,name_snapshot,price_snapshot_czk) VALUES (?,?,?,?,?)",
                      (cart_id,mid,qty,allowed_modifier.get('name',''),float(allowed_modifier.get('price_czk',0))))
        # Persist note on cart item only if schema has note column; otherwise use a side table.
        c.execute("""CREATE TABLE IF NOT EXISTS cart_item_notes(
            cart_item_id TEXT PRIMARY KEY,
            note TEXT,
            updated_at TEXT NOT NULL
        )""")
        c.execute("INSERT INTO cart_item_notes(cart_item_id,note,updated_at) VALUES (?,?,?) ON CONFLICT(cart_item_id) DO UPDATE SET note=excluded.note,updated_at=excluded.updated_at",(cart_id,body.note,now()))
        c.commit()
    return get_cart(authorization)


@app.get("/api/v037/cart")
def v037_cart(authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u=current_user(authorization); require_role(u,"customer")
    with core_db_connect() as c:
        rows=c.execute("""
          SELECT ci.id cart_item_id,ci.menu_item_id,ci.qty,ci.merchant_id,mi.name,mi.price_czk,m.name merchant_name
          FROM cart_items ci JOIN menu_items mi ON mi.id=ci.menu_item_id JOIN merchants m ON m.id=ci.merchant_id
          WHERE ci.customer_id=? ORDER BY ci.id
        """,(u["customer_id"],)).fetchall()
        items=[]
        for r in rows:
            x=dict(r)
            mods=c.execute("""
              SELECT cm.modifier_id,mo.name,mo.price_czk,cm.qty
              FROM cart_item_modifiers cm JOIN modifiers mo ON mo.id=cm.modifier_id
              WHERE cm.cart_item_id=?
            """,(r["cart_item_id"],)).fetchall()
            note=c.execute("SELECT note FROM cart_item_notes WHERE cart_item_id=?",(r["cart_item_id"],)).fetchone()
            modifier_total=sum(float(m["price_czk"])*int(m["qty"]) for m in mods)
            x["modifiers"]=[dict(m) for m in mods]
            x["note"]=note["note"] if note else None
            x["unit_total_czk"]=round(float(r["price_czk"])+modifier_total,2)
            x["line_total_czk"]=round(x["unit_total_czk"]*int(r["qty"]),2)
            items.append(x)
        subtotal=round(sum(x["line_total_czk"] for x in items),2)
        return {"merchant_id":next(iter({x["merchant_id"] for x in items}),None) if items else None,"items":items,"subtotal_czk":subtotal}


@app.get("/api/v037/checkout/validate")
def v037_checkout_validate(authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u=current_user(authorization); require_role(u,"customer")
    cart=v037_cart(authorization)
    issues=[]
    with core_db_connect() as c:
        for item in cart["items"]:
            mi=c.execute("SELECT active,price_czk FROM menu_items WHERE id=?",(item["menu_item_id"],)).fetchone()
            if not mi or not mi["active"]: issues.append("menu_item_inactive:"+item["menu_item_id"])
            # Ensure modifiers are still active.
            for mod in item["modifiers"]:
                active=c.execute("SELECT active FROM modifiers WHERE id=?",(mod["modifier_id"],)).fetchone()
                if not active or not active["active"]: issues.append("modifier_inactive:"+mod["modifier_id"])
        return {"valid":not issues,"issues":issues,"subtotal_czk":cart["subtotal_czk"]}


@app.post("/api/v037/checkout")
def v037_checkout(authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u=current_user(authorization); require_role(u,"customer")
    valid=v037_checkout_validate(authorization)
    if not valid["valid"]: raise HTTPException(409,detail={"message":"Košík není validní","issues":valid["issues"]})
    cart=v037_cart(authorization)
    if not cart["items"]: raise HTTPException(409,"Košík je prázdný")
    with core_db_connect() as c:
        # Re-read authoritative menu prices and modifier prices in one transaction.
        subtotal=0.0
        snapshots=[]
        for item in cart["items"]:
            mi=c.execute("SELECT id,merchant_id,name,price_czk FROM menu_items WHERE id=? AND active=1",(item["menu_item_id"],)).fetchone()
            if not mi: raise HTTPException(409,"Položka se mezitím stala nedostupná")
            line_mods=[]
            unit=float(mi["price_czk"])
            for mod in item["modifiers"]:
                m=c.execute("SELECT id,name,price_czk FROM modifiers WHERE id=? AND active=1",(mod["modifier_id"],)).fetchone()
                if not m: raise HTTPException(409,"Modifier se mezitím stal nedostupný")
                q=int(mod["qty"]); unit+=float(m["price_czk"])*q
                line_mods.append((m["id"],m["name"],float(m["price_czk"]),q))
            subtotal += unit*int(item["qty"])
            snapshots.append((mi,line_mods,item))
        subtotal=round(subtotal,2)
        # Find default address.
        addr=c.execute("SELECT id,address,lat,lon FROM customer_addresses WHERE customer_id=? ORDER BY is_default DESC,created_at DESC LIMIT 1",(u["customer_id"],)).fetchone()
        if not addr: raise HTTPException(409,"Chybí doručovací adresa")
        oid="o_"+uuid.uuid4().hex[:10]
        merchant_id=snapshots[0][0]["merchant_id"]
        c.execute("""
          INSERT INTO orders(id,customer_id,merchant_id,status,subtotal_czk,delivery_fee_czk,service_fee_czk,pro_discount_czk,total_czk,pricing_version,created_at,updated_at)
          VALUES (?,?,?,?,?,?,?,?,?,?,?,?)
        """,(oid,u["customer_id"],merchant_id,"merchant_pending",subtotal,0,0,0,subtotal,"v037_snapshot",now(),now()))
        for mi,line_mods,item in snapshots:
            oi="oi_"+uuid.uuid4().hex[:10]
            c.execute("INSERT INTO order_items(id,order_id,menu_item_id,name_snapshot,unit_price_czk,qty,line_total_czk) VALUES (?,?,?,?,?,?,?)",
                      (oi,oid,mi["id"],mi["name"],float(mi["price_czk"]),int(item["qty"]),round(float(item["unit_total_czk"])*int(item["qty"]),2)))
            for mid,mname,mprice,mqty in line_mods:
                c.execute("INSERT INTO order_item_modifiers VALUES (?,?,?,?,?)",(oi,mid,mname,mprice,mqty))
            c.execute("""CREATE TABLE IF NOT EXISTS order_item_notes(
                order_item_id TEXT PRIMARY KEY,
                note TEXT
            )""")
            c.execute("INSERT INTO order_item_notes(order_item_id,note) VALUES (?,?) ON CONFLICT(order_item_id) DO UPDATE SET note=excluded.note",(oi,item["note"]))
        c.execute("DELETE FROM cart_items WHERE customer_id=?",(u["customer_id"],))
        c.commit()
        return {"order_id":oid,"subtotal_czk":subtotal,"pricing_version":"v037_snapshot"}

