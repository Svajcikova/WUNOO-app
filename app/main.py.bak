# ---------------- WUNOO v1.113: Concurrent Courier Claim Integrity Gate ----------------
def migrate_v113(c):
    c.executescript("""CREATE TABLE IF NOT EXISTS production_courier_claim_integrity_gates_v113(
        id TEXT PRIMARY KEY, gate_no INTEGER NOT NULL UNIQUE, gate_json TEXT NOT NULL,
        gate_sha256 TEXT NOT NULL UNIQUE, algorithm TEXT NOT NULL, signer_key_id TEXT NOT NULL,
        public_key_b64 TEXT NOT NULL, signature_b64 TEXT NOT NULL, status TEXT NOT NULL,
        created_at TEXT NOT NULL, operator TEXT
    ); CREATE INDEX IF NOT EXISTS idx_v113_gate_no ON production_courier_claim_integrity_gates_v113(gate_no);""")
_V113_POLICY={
    'schema_version':'1.113','format':'wunoo.release.concurrent-courier-claim.integrity-gate.v1',
    'hash':'SHA-256','algorithm':'Ed25519','fail_closed':True,'immutable_history':True,
    'no_automatic_recovery':True,'no_automatic_release':True,
    'contracts':['dispatch_pending claim is conditional','courier assignment has one winner','losing concurrent claim fails with conflict','claim emits exactly one courier_assigned event','no duplicate assignment mutation']
}
def _v113_json(v): return json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False)
def _v113_hash(v): return hashlib.sha256(_v113_json(v).encode()).hexdigest()
def _v113_run(c):
    checks=[]
    def chk(n,v,r=None,d=None): checks.append({'check':n,'valid':bool(v),'reason':r,'details':d})
    # Structural contract: the critical repository must use a single conditional UPDATE.
    try:
        import inspect
        src=inspect.getsource(V132CourierRepository.claim)
        atomic=('UPDATE orders SET courier_id=?,status=\'assigned\'' in src and
                'WHERE id=? AND status=\'dispatch_pending\' AND courier_id IS NULL' in src and
                'rowcount != 1' in src)
        chk('ATOMIC_CLAIM_REPOSITORY',atomic,'MISSING_CONDITIONAL_CLAIM' if not atomic else None)
    except Exception as e: chk('ATOMIC_CLAIM_REPOSITORY',False,'SOURCE_INSPECTION_EXCEPTION',str(e))
    try:
        required={'id','status','courier_id','assigned_at','updated_at'}
        cols={r['name'] for r in c.execute('PRAGMA table_info(orders)').fetchall()}
        chk('ORDERS_CLAIM_COLUMNS',required.issubset(cols),'CLAIM_COLUMNS_MISSING',{'missing':sorted(required-cols)})
    except Exception as e: chk('ORDERS_CLAIM_COLUMNS',False,'SCHEMA_EXCEPTION',str(e))
    try:
        route=any(getattr(r,'path',None)=='/api/v133/critical/orders/{order_id}/claim-courier' and 'POST' in getattr(r,'methods',set()) for r in app.routes)
        chk('CLAIM_ROUTE',route,'MISSING_CLAIM_ROUTE')
    except Exception as e: chk('CLAIM_ROUTE',False,'ROUTE_INSPECTION_EXCEPTION',str(e))
    try:
        dup=c.execute("SELECT COUNT(*) n FROM (SELECT id FROM orders GROUP BY id HAVING COUNT(*)>1)").fetchone()['n']
        chk('NO_DUPLICATE_ORDER_ROWS',int(dup)==0,'DUPLICATE_ORDER_ROWS',{'violations':int(dup)})
    except Exception as e: chk('NO_DUPLICATE_ORDER_ROWS',False,'QUERY_EXCEPTION',str(e))
    try:
        dup_events=c.execute("SELECT COUNT(*) n FROM (SELECT order_id FROM events WHERE type='courier_assigned' GROUP BY order_id HAVING COUNT(*)>1)").fetchone()['n']
        chk('ASSIGNMENT_EVENT_UNIQUENESS_AUDIT',int(dup_events)==0,'MULTIPLE_COURIER_ASSIGNED_EVENTS',{'duplicate_order_groups':int(dup_events)})
    except Exception as e: chk('ASSIGNMENT_EVENT_UNIQUENESS_AUDIT',False,'QUERY_EXCEPTION',str(e))
    return {'valid':all(x['valid'] for x in checks),'checks':checks,'integrity_state':'CONCURRENT_COURIER_CLAIM_FAIL_CLOSED'}
def _v113_payload(no,result):
    return {'format':_V113_POLICY['format'],'schema_version':'1.113','gate_no':int(no),'checks':result['checks'],'overall_valid':bool(result['valid']),'integrity_state':result['integrity_state']}
def _v113_verify(c,row):
    try:
        if not row:return {'valid':False,'reason':'NO_GATE'}
        obj=json.loads(row['gate_json'] or '{}')
        if obj.get('format')!=_V113_POLICY['format'] or obj.get('schema_version')!='1.113': return {'valid':False,'reason':'V113_FORMAT_INVALID'}
        if _v113_hash(obj)!=row['gate_sha256']: return {'valid':False,'reason':'V113_HASH_INVALID'}
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto(); pub=base64.b64decode(row['public_key_b64'],validate=True); Ed25519PublicKey.from_public_bytes(pub).verify(base64.b64decode(row['signature_b64'],validate=True),_v113_json(obj).encode())
        if _v176_key_id(pub)!=row['signer_key_id']: return {'valid':False,'reason':'V113_SIGNER_KEY_ID_INVALID'}
        if int(row['gate_no'])!=int(obj.get('gate_no',-1)) or (row['status']=='VALID')!=bool(obj.get('overall_valid')): return {'valid':False,'reason':'V113_METADATA_INVALID'}
        return {'valid':True,'gate_no':int(row['gate_no']),'overall_valid':bool(obj.get('overall_valid'))}
    except Exception:return {'valid':False,'reason':'V113_GATE_INVALID'}
