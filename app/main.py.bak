        if u["role"]=="customer" and p["customer_id"]!=u["customer_id"]: raise HTTPException(403,"forbidden")
        return {"payment":dict(p)}

@app.post("/api/v059/payment/demo-simulate")
def v059_payment_demo_simulate(body:dict[str,Any], authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"customer","admin","ops_agent"})
    intent_id=str(body.get("payment_intent_id","")).strip()
    outcome=str(body.get("outcome","succeeded")).strip()
    if not intent_id: raise HTTPException(400,"payment_intent_id je povinné")
    if outcome not in ("succeeded","failed","cancelled"): raise HTTPException(400,"Neplatný outcome")
    with core_db_connect() as c:
        pi=c.execute("SELECT pi.id,o.customer_id FROM payment_intents pi JOIN orders o ON o.id=pi.order_id WHERE pi.id=?",(intent_id,)).fetchone()
        if not pi: raise HTTPException(404,"Payment intent nenalezen")
        if u["role"]=="customer" and pi["customer_id"]!=u["customer_id"]:
            raise HTTPException(403,"Payment intent nepatří tomuto zákazníkovi")
    return _process_v059_payment_webhook({"id":"demo_evt_"+uuid.uuid4().hex[:12],"type":"payment_"+outcome,"payment_intent_id":intent_id})

