# ---------------------------------------------------------------------------
# v1.129 — Concurrent Dispatch Load & Cross-Order Integrity Gate
# ---------------------------------------------------------------------------
_V129_POLICY={
    'schema_version':'1.129',
    'format':'wunoo.release.concurrent-dispatch-load.integrity-gate.v1',
    'hash':'SHA-256','algorithm':'Ed25519','fail_closed':True,
    'immutable_history':True,'no_automatic_recovery':True,'no_automatic_release':True,
    'load_profile':{'orders':6,'concurrent_claimers_per_order':2,'requests':12},
    'contracts':[
        'each dispatch_pending order has at most one courier assignment',
        'concurrent claim contention produces exactly one winner per order',
        'losing claim returns conflict',
        'exactly one courier_assigned event exists per claimed order',
        'claims on independent orders do not interfere',
    ]
}
def _v129_json(v): return json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False)
def _v129_hash(v): return hashlib.sha256(_v129_json(v).encode()).hexdigest()
def _v129_run(c):
    checks=[]
    def chk(n,v,r=None,d=None): checks.append({'check':n,'valid':bool(v),'reason':r,'details':d})
    try:
        import inspect
        src=inspect.getsource(V132CourierRepository.claim)
        atomic=('UPDATE orders SET courier_id=?,status=\'assigned\'' in src and
                'WHERE id=? AND status=\'dispatch_pending\' AND courier_id IS NULL' in src and
                'rowcount != 1' in src)
        chk('ATOMIC_SINGLE_WINNER_CLAIM',atomic,'MISSING_ATOMIC_CLAIM')
    except Exception as e: chk('ATOMIC_SINGLE_WINNER_CLAIM',False,'SOURCE_INSPECTION_EXCEPTION',str(e))
    try:
        dup=c.execute("SELECT COUNT(*) n FROM (SELECT id FROM orders GROUP BY id HAVING COUNT(*)>1)").fetchone()['n']
        chk('NO_DUPLICATE_ORDER_ROWS',int(dup)==0,'DUPLICATE_ORDER_ROWS',{'violations':int(dup)})
    except Exception as e: chk('NO_DUPLICATE_ORDER_ROWS',False,'QUERY_EXCEPTION',str(e))
    try:
        bad=c.execute("SELECT COUNT(*) n FROM orders WHERE courier_id IS NOT NULL AND status NOT IN ('assigned','picked_up','out_for_delivery','delayed','delivered','cancelled')").fetchone()['n']
        chk('COURIER_STATUS_CONSISTENCY',int(bad)==0,'COURIER_STATUS_MISMATCH',{'violations':int(bad)})
    except Exception as e: chk('COURIER_STATUS_CONSISTENCY',False,'QUERY_EXCEPTION',str(e))
    try:
        dup_events=c.execute("SELECT COUNT(*) n FROM (SELECT order_id FROM events WHERE type='courier_assigned' GROUP BY order_id HAVING COUNT(*)>1)").fetchone()['n']
        chk('ONE_ASSIGNMENT_EVENT_PER_ORDER',int(dup_events)==0,'MULTIPLE_COURIER_ASSIGNED_EVENTS',{'duplicate_order_groups':int(dup_events)})
    except Exception as e: chk('ONE_ASSIGNMENT_EVENT_PER_ORDER',False,'QUERY_EXCEPTION',str(e))
    try:
        # If an order is assigned, the event must reference the same courier as the order.
        rows=c.execute("SELECT o.id,o.courier_id,e.payload FROM orders o JOIN events e ON e.order_id=o.id AND e.type='courier_assigned' WHERE o.courier_id IS NOT NULL").fetchall()
        mismatches=[]
        for r in rows:
            try:
                payload=ast.literal_eval(r['payload']) if isinstance(r['payload'],str) else {}
                if str(payload.get('courier_id')) != str(r['courier_id']): mismatches.append(r['id'])
            except Exception: mismatches.append(r['id'])
        chk('ASSIGNMENT_EVENT_MATCHES_ORDER',not mismatches,'ASSIGNMENT_EVENT_MISMATCH',{'order_ids':mismatches[:20]})
    except Exception as e: chk('ASSIGNMENT_EVENT_MATCHES_ORDER',False,'QUERY_EXCEPTION',str(e))
    return {'valid':all(x['valid'] for x in checks),'checks':checks,'integrity_state':'CONCURRENT_DISPATCH_LOAD_FAIL_CLOSED'}
def _v129_payload(no,result):
    return {'format':_V129_POLICY['format'],'schema_version':'1.129','gate_no':int(no),'load_profile':_V129_POLICY['load_profile'],'checks':result['checks'],'overall_valid':bool(result['valid']),'integrity_state':result['integrity_state']}
def _v129_verify(c,row):
    try:
        if not row:return {'valid':False,'reason':'NO_GATE'}
        obj=json.loads(row['gate_json'] or '{}')
        if obj.get('format')!=_V129_POLICY['format'] or obj.get('schema_version')!='1.129': return {'valid':False,'reason':'V129_FORMAT_INVALID'}
        if _v129_hash(obj)!=row['gate_sha256']: return {'valid':False,'reason':'V129_HASH_INVALID'}
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto()
        pub=base64.b64decode(row['public_key_b64'],validate=True)
        Ed25519PublicKey.from_public_bytes(pub).verify(base64.b64decode(row['signature_b64'],validate=True),_v129_json(obj).encode())
        if _v176_key_id(pub)!=row['signer_key_id']: return {'valid':False,'reason':'V129_SIGNER_KEY_ID_INVALID'}
        if int(row['gate_no'])!=int(obj.get('gate_no',-1)) or (row['status']=='VALID')!=bool(obj.get('overall_valid')): return {'valid':False,'reason':'V129_METADATA_INVALID'}
        return {'valid':True,'gate_no':int(row['gate_no']),'overall_valid':bool(obj.get('overall_valid'))}
    except Exception:return {'valid':False,'reason':'V129_GATE_INVALID'}
@app.get('/api/v129/ops/dispatch-load-integrity-gate/policy')
def v129_policy(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); return _V129_POLICY
