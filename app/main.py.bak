_V137_MENU_SYNC_POLICY = {
    'schema_version':'1.137',
    'purpose':'customer-exact merchant menu preview, modifier snapshotting and publish sync status',
    'tenant_isolated':True,
    'customer_projection':'live_publication_only',
    'modifier_snapshot':True,
