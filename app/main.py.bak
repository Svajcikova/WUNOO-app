            idxrows=c.execute(f"PRAGMA index_list({table})").fetchall();found=False
            for ir in idxrows:
                if int(ir['unique']):
                    cols=[x['name'] for x in c.execute(f"PRAGMA index_info({ir['name']})").fetchall()]
                    if cols==[col]: found=True
            if not found: missing.append(f'{table}.{col}')
        check('FINANCIAL_UNIQUENESS',not missing,'MISSING_UNIQUE_CONSTRAINT',{'missing':missing})
    except Exception as e: check('FINANCIAL_UNIQUENESS',False,'INDEX_INSPECTION_EXCEPTION',str(e))
    route_paths={'/api/orders','/api/orders/{order_id}/pay','/api/orders/{order_id}/merchant-accept','/api/orders/{order_id}/ready','/api/orders/{order_id}/dispatch','/api/orders/{order_id}/pickup','/api/orders/{order_id}/start-delivery','/api/orders/{order_id}/deliver'}
    actual={getattr(r,'path',None) for r in app.routes}
    missing=sorted(route_paths-actual);check('GOLDEN_ORDER_ROUTES',not missing,'MISSING_CRITICAL_ROUTE',{'missing':missing,'required':sorted(route_paths)})
    return {'valid':all(x['valid'] for x in checks),'checks':checks,'contract_state':'GOLDEN_ORDER_PRODUCTION_CONTRACT_VERIFIED'}
