    return {'schema_version':'1.70','certificate_id':cid,'certificate':cert,'evaluation':ev}

@app.post('/api/v170/ops/release-certificate/verify')
def v170_verify(payload: dict[str,Any]|None=None, authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); payload=payload or {}
    with core_db_connect() as c:
        if payload.get('certificate_id'): row=_v170_row(c,'production_release_certificates',' WHERE id=?',(payload['certificate_id'],),'created_at DESC')
        elif payload.get('certificate_sha256'): row=_v170_row(c,'production_release_certificates',' WHERE certificate_sha256=?',(payload['certificate_sha256'],),'created_at DESC')
        else: row=_v170_row(c,'production_release_certificates',order='created_at DESC')
        if not row: raise HTTPException(404,'release certificate nenalezen')
        cert=json.loads(row['certificate_json'] or '{}')
        result=_v170_verify_certificate(cert)
        if not result['valid']: raise HTTPException(409,result['reason'])
        # Re-verify the exact upstream v1.69 signature row and the exact current manifest artifact.
        sigrow=_v170_row(c,'production_release_signatures',' WHERE id=?',(row['signature_id'],),'created_at DESC')
        manrow=_v170_row(c,'production_release_manifests',' WHERE id=?',(row['manifest_id'],),'created_at DESC')
        if not sigrow or not manrow: raise HTTPException(409,'certificate upstream evidence missing')
        sres=_v169_verify_signature(json.loads(sigrow['attestation_json'] or '{}'),sigrow['signature_b64'],sigrow['public_key_b64'])
        mres=_v168_verify_manifest(json.loads(manrow['manifest_json'] or '{}'),manrow['manifest_sha256'])
        if not sres['valid']: raise HTTPException(409,'embedded v1.69 signature invalid: '+sres['reason'])
        if not mres['valid']: raise HTTPException(409,'embedded v1.68 manifest invalid: '+mres['reason'])
        return {'schema_version':'1.70','certificate_id':row['id'],'release_version':row['release_version'],'certificate_sha256':row['certificate_sha256'],
                'verification':result,'manifest_verification':mres,'signature_verification':sres,'status':row['status']}

@app.get('/api/v170/ops/release-certificate/latest')
def v170_latest(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
