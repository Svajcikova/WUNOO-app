@app.post("/api/v061/dispatch/create")
def v061_dispatch_create(body:dict[str,Any], authorization:str|None=Header(default=None), idempotency_key:str|None=Header(default=None,alias="Idempotency-Key"))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"merchant","admin","ops_agent"})
    oid=str(body.get("order_id","")).strip()
    with core_db_connect() as c:
        cached=_v052_guard(c,f"dispatch-create:{u['id']}",idempotency_key,{"order_id":oid})
        if cached is not None:return cached
        o=c.execute("SELECT * FROM orders WHERE id=?",(oid,)).fetchone()
        if not o: raise HTTPException(404,"Objednávka nenalezena")
        if u["role"]=="merchant" and o["merchant_id"]!=u.get("merchant_id"): raise HTTPException(403,"forbidden")
        if o["status"]!="ready_for_pickup": raise HTTPException(409,"Objednávka není ready_for_pickup")
        existing=c.execute("SELECT * FROM dispatch_jobs WHERE order_id=?",(oid,)).fetchone()
        if existing:
            result={"dispatch_job_id":existing["id"],"status":existing["status"]}
        else:
            did="dj_"+uuid.uuid4().hex[:12]
            c.execute("""INSERT INTO dispatch_jobs
                         (id,order_id,merchant_id,status,pickup_eta_minutes,delivery_eta_minutes,offered_at,created_at,updated_at)
                         VALUES (?,?,?,?,?,?,?,?,?)""",
                      (did,oid,o["merchant_id"],"offered",5,25,now(),now(),now()))
            emit(c,oid,"dispatch_offered",{"dispatch_job_id":did,"pickup_eta_minutes":5,"delivery_eta_minutes":25},u["id"])
            result={"dispatch_job_id":did,"status":"offered","pickup_eta_minutes":5,"delivery_eta_minutes":25}
        _v052_store(c,f"dispatch-create:{u['id']}",idempotency_key,{"order_id":oid},result)
        c.commit();return result

@app.get("/api/v061/courier/jobs")
def v061_courier_jobs(status:str|None=None, authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"courier","admin","ops_agent"})
    with core_db_connect() as c:
        if status:
            rows=c.execute("SELECT * FROM dispatch_jobs WHERE status=? ORDER BY offered_at DESC LIMIT 100",(status,)).fetchall()
        else:
            rows=c.execute("SELECT * FROM dispatch_jobs WHERE status IN ('offered','accepted','picked_up','delivered') ORDER BY updated_at DESC LIMIT 100").fetchall()
        return {"jobs":[dict(x) for x in rows]}

@app.post("/api/v061/courier/jobs/{job_id}/action")
def v061_courier_action(job_id:str, body:dict[str,Any], authorization:str|None=Header(default=None), idempotency_key:str|None=Header(default=None,alias="Idempotency-Key"))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"courier","admin","ops_agent"})
    action=str(body.get("action","")).strip()
    transitions={"accept":("offered","accepted"),"pickup":("accepted","picked_up"),"deliver":("picked_up","delivered")}
    if action not in transitions: raise HTTPException(400,"Neplatná courier akce")
    with core_db_connect() as c:
        j=c.execute("SELECT * FROM dispatch_jobs WHERE id=?",(job_id,)).fetchone()
        if not j: raise HTTPException(404,"Dispatch job nenalezen")
        cached=_v052_guard(c,f"courier-action:{u['id']}",idempotency_key,{"job_id":job_id,"action":action})
        if cached is not None:return cached
        expected,new_status=transitions[action]
        if j["status"]!=expected: raise HTTPException(409,f"Job je ve stavu {j['status']}, očekáváno {expected}")
        courier_id=u.get("courier_id") or j["courier_id"]
        if action!="accept" and j["courier_id"] and courier_id!=j["courier_id"]: raise HTTPException(403,"Job patří jinému kurýrovi")
        if action=="accept":
            if j["courier_id"] and j["courier_id"]!=courier_id: raise HTTPException(409,"Job je již přidělen")
            c.execute("UPDATE dispatch_jobs SET courier_id=?,status='accepted',accepted_at=?,updated_at=? WHERE id=?",(courier_id,""+now(),now(),job_id))
            atomic_transition_any(c, j["order_id"], ("dispatch_pending", "ready_for_pickup"), "courier_assigned", u, "courier_accept", {"courier_id": courier_id, "from": "dispatch_pending|ready_for_pickup", "to": "courier_assigned"})
            c.execute("UPDATE orders SET courier_id=?,updated_at=? WHERE id=? AND status='courier_assigned' AND courier_id IS NULL",(courier_id,now(),j["order_id"]))
        elif action=="pickup":
            c.execute("UPDATE dispatch_jobs SET status='picked_up',picked_up_at=?,updated_at=? WHERE id=?",(now(),now(),job_id))
            atomic_transition_any(c, j["order_id"], ("courier_assigned", "assigned"), "out_for_delivery", u, "courier_pickup", {"from": "courier_assigned|assigned", "to": "out_for_delivery"})
        else:
            c.execute("UPDATE dispatch_jobs SET status='delivered',delivered_at=?,updated_at=? WHERE id=?",(now(),now(),job_id))
            atomic_transition_any(c, j["order_id"], ("out_for_delivery", "picked_up"), "delivered", u, "courier_deliver", {"from": "out_for_delivery|picked_up", "to": "delivered"})
        emit(c,j["order_id"],f"courier_{action}",{"dispatch_job_id":job_id,"status":new_status},u["id"])
        result={"dispatch_job_id":job_id,"order_id":j["order_id"],"action":action,"status":new_status,"courier_id":courier_id}
        _v052_store(c,f"courier-action:{u['id']}",idempotency_key,{"job_id":job_id,"action":action},result)
        _v052_audit(c,u["id"],f"courier_{action}","dispatch_job",job_id,{"order_id":j["order_id"]})
        c.commit();return result

@app.post("/api/v061/courier/jobs/{job_id}/location")
def v061_courier_location(job_id:str, body:dict[str,Any], authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"courier","admin","ops_agent"})
    lat=float(body.get("latitude"));lon=float(body.get("longitude"))
    eta=int(body.get("eta_minutes",0))
    with core_db_connect() as c:
        j=c.execute("SELECT * FROM dispatch_jobs WHERE id=?",(job_id,)).fetchone()
        if not j: raise HTTPException(404,"Dispatch job nenalezen")
        if u["role"]=="courier" and j["courier_id"]!=u.get("courier_id"): raise HTTPException(403,"forbidden")
        lid="cle_"+uuid.uuid4().hex[:12]
        c.execute("INSERT INTO courier_location_events VALUES (?,?,?,?,?,?,?)",(lid,job_id,j["courier_id"] or u.get("courier_id"),lat,lon,eta,now()))
        c.execute("UPDATE dispatch_jobs SET delivery_eta_minutes=?,updated_at=? WHERE id=?",(eta,now(),job_id))
        c.commit();return {"accepted":True,"job_id":job_id,"eta_minutes":eta}

