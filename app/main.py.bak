def courier_candidates(c: sqlite3.Connection, order: sqlite3.Row) -> list[dict[str, Any]]:
    rows = c.execute("""
        SELECT id, name, status, verified, lat, lon, earnings_czk
        FROM couriers
        WHERE status='online' AND verified=1
        ORDER BY id
    """).fetchall()
    result=[]
    for r in rows:
        # v0.4 deterministic ETA proxy from static demo coordinates; replace with live routing later.
        distance_km = round(abs(r["lat"] - 49.834) * 111 + abs(r["lon"] - 18.292) * 72, 2)
        pickup_eta = max(4, round(distance_km * 4 + 3))
        workload = 0
        quality = {"c_anna": "A", "c_petr": "A", "c_lukas": "B"}.get(r["id"], "C")
        acceptance = {"c_anna": 0.85, "c_petr": 0.82, "c_lukas": 0.79}.get(r["id"], 0.70)
        result.append({
            "courier_id": r["id"],
            "name": r["name"],
            "quality_tier": quality,
            "distance_km": distance_km,
            "pickup_eta_minutes": pickup_eta,
            "acceptance_probability": acceptance,
            "workload": workload,
        })
    for x in result:
        eta_fit = max(0.0, 100.0 - x["pickup_eta_minutes"] * 6.0)
        route_fit = max(0.0, 100.0 - x["distance_km"] * 20.0)
        acceptance_fit = x["acceptance_probability"] * 100.0
        quality_fit = {"A": 95.0, "B": 85.0, "C": 75.0}.get(x["quality_tier"], 70.0)
        x["dispatch_score"] = round(0.40*eta_fit + 0.30*route_fit + 0.15*acceptance_fit + 0.15*quality_fit, 2)
    result.sort(key=lambda x: (-x["dispatch_score"], x["pickup_eta_minutes"], x["distance_km"]))
    for idx, x in enumerate(result, 1): x["rank"] = idx
    return result


