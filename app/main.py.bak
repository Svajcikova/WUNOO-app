def _v047_users_for_order(c, order):
    ids=set()
    ids.add(order["customer_id"])
    if order["merchant_id"]:
        r=c.execute("SELECT id FROM users WHERE merchant_id=? AND active=1 ORDER BY id LIMIT 1",(order["merchant_id"],)).fetchone()
        if r: ids.add(r["id"])
    if order["courier_id"]:
        r=c.execute("SELECT id FROM users WHERE courier_id=? AND active=1 ORDER BY id LIMIT 1",(order["courier_id"],)).fetchone()
        if r: ids.add(r["id"])
    return ids

def _v047_event_message(typ, payload):
    mapping={
        "courier_assigned":("Kurýr přiřazen","Kurýr byl přiřazen k objednávce."),
        "pickup_completed":("Objednávka vyzvednuta","Kurýr vyzvedl objednávku."),
        "out_for_delivery_started":("Kurýr je na cestě","Objednávka je na cestě k vám."),
        "delivery_completed":("Objednávka doručena","Objednávka byla doručena."),
        "delivery_exception_opened":("Problém s doručením","U objednávky byl nahlášen problém."),
        "promise_breach":("Doručení má zpoždění","Slíbený čas doručení byl překročen."),
        "courier_offer_created":("Nová nabídka","Máte novou nabídku doručení."),
        "courier_offer_expired":("Nabídka vypršela","Nabídka doručení vypršela."),
        "customer_recovery_applied":("Kompenzace připsána","Na objednávku byla aplikována kompenzace."),
    }
    return mapping.get(typ,(typ.replace("_"," ").title(),"Došlo k aktualizaci objednávky."))



def migrate_v048(c):
    c.execute("""CREATE TABLE IF NOT EXISTS notification_jobs(
        id TEXT PRIMARY KEY,
        event_key TEXT NOT NULL UNIQUE,
        order_id TEXT,
        event_type TEXT NOT NULL,
        status TEXT NOT NULL DEFAULT 'pending',
        attempts INTEGER NOT NULL DEFAULT 0,
        last_error TEXT,
        created_at TEXT NOT NULL,
        processed_at TEXT
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_notification_jobs_status ON notification_jobs(status,created_at)")
    c.commit()

def _v048_event_key(order_id, event_type, payload):
    import hashlib, json as _json
    stable=_json.dumps(payload or {},sort_keys=True,ensure_ascii=False)
    return hashlib.sha256(f"{order_id}|{event_type}|{stable}".encode()).hexdigest()

def _v048_enqueue_event(c, order_id, event_type, payload=None):
    key=_v048_event_key(order_id,event_type,payload)
    jid="nj_"+uuid.uuid4().hex[:10]
    try:
        c.execute("INSERT INTO notification_jobs VALUES (?,?,?,?,?,?,?,?,?)",
                  (jid,key,order_id,event_type,"pending",0,None,now(),None))
        return True
    except Exception:
        return False

def _v048_process_jobs(c, limit=100):
    rows=c.execute("SELECT * FROM notification_jobs WHERE status IN ('pending','retry') ORDER BY created_at LIMIT ?",(limit,)).fetchall()
    processed=[]; failed=[]
    for job in rows:
        try:
            if not job["order_id"]:
                raise ValueError("missing order_id")
            o=c.execute("SELECT * FROM orders WHERE id=?",(job["order_id"],)).fetchone()
            if not o:
                raise ValueError("order not found")
            title,msg=_v047_event_message(job["event_type"],{})
            for uid in _v047_users_for_order(c,o):
                _v047_notify(c,uid,title,msg,job["event_type"],job["order_id"],
                             "warning" if job["event_type"] in {"delivery_exception_opened","promise_breach"} else "info")
            c.execute("UPDATE notification_jobs SET status='processed',attempts=attempts+1,processed_at=?,last_error=NULL WHERE id=?",(now(),job["id"]))
            processed.append(job["id"])
        except Exception as exc:
            attempts=int(job["attempts"])+1
            status="dead" if attempts>=3 else "retry"
            c.execute("UPDATE notification_jobs SET status=?,attempts=?,last_error=? WHERE id=?",(status,attempts,str(exc),job["id"]))
            failed.append({"id":job["id"],"status":status,"error":str(exc)})
    c.commit()
    return {"processed":processed,"failed":failed}



