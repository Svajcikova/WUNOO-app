            "INSERT INTO courier_locations(order_id,courier_id,lat,lon,recorded_at,remaining_distance_km,live_eta_minutes,deviation_ratio) "
            "VALUES(?,?,?,?,?,?,?,?)",
            (order_id,courier_id,lat,lon,reported_at,remaining_distance_km,live_eta_minutes,deviation_ratio)
