        old=json.loads(live['snapshot_json']) if live else {'categories':[],'items':[]}
        return {'schema_version':'1.136','merchant_id':mid,'publishable':bool(validation['valid']),
                'draft_sha256':sha,'live_sha256':live['snapshot_sha256'] if live else None,
                'publication_no':int(live['publication_no']) if live else None,
                'changed':bool(not live or live['snapshot_sha256']!=sha),'diff':_v136_snapshot_diff(old,draft),'validation':validation}


