@app.post("/api/v066/auth/refresh")
def v066_auth_refresh(body:dict[str,Any], request:Request)->dict[str,Any]:
    raw=str(body.get("refresh_token","")).strip()
    if not raw: raise HTTPException(400,"refresh_token je povinný")
    token_hash=hashlib.sha256(raw.encode()).hexdigest()
    with core_db_connect() as c:
        s=c.execute("SELECT * FROM refresh_sessions WHERE token_hash=?",(token_hash,)).fetchone()
        if not s or s["revoked_at"] or s["expires_at"]<now(): raise HTTPException(401,"refresh token je neplatný")
        u=c.execute("SELECT * FROM users WHERE id=?",(s["user_id"],)).fetchone()
        if not u: raise HTTPException(401,"uživatel nenalezen")
        new_access=_issue_access_session(c, u)
        c.execute("UPDATE refresh_sessions SET last_used_at=? WHERE id=?",(now(),s["id"]))
        c.execute("INSERT INTO security_events VALUES (?,?,?,?,?,?)",
                  ("sec_"+uuid.uuid4().hex[:12],u["id"],"token_refresh",request.client.host if request.client else None,json.dumps({},ensure_ascii=False),now()))
        c.commit()
        return {"access_token":new_access,"token_type":"bearer","user_id":u["id"],"role":u["role"]}

@app.post("/api/v066/auth/revoke")
def v066_auth_revoke(body:dict[str,Any], authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization)
    raw=str(body.get("refresh_token","")).strip()
    with core_db_connect() as c:
        if raw:
            h=hashlib.sha256(raw.encode()).hexdigest()
            c.execute("UPDATE refresh_sessions SET revoked_at=? WHERE user_id=? AND token_hash=?",(now(),u["id"],h))
        else:
            c.execute("UPDATE refresh_sessions SET revoked_at=? WHERE user_id=? AND revoked_at IS NULL",(now(),u["id"]))
        c.execute("INSERT INTO security_events VALUES (?,?,?,?,?,?)",
                  ("sec_"+uuid.uuid4().hex[:12],u["id"],"session_revoked",None,json.dumps({},ensure_ascii=False),now()))
        c.commit()
        return {"revoked":True}

@app.post("/api/v066/auth/login-session")
def v066_login_session(body:dict[str,Any], request:Request)->dict[str,Any]:
    # Uses the existing application's login credential validator when available.
    email=str(body.get("email","")).strip().lower()
    password=str(body.get("password",""))
    if not email or not password: raise HTTPException(400,"email a password jsou povinné")
    with core_db_connect() as c:
        u=c.execute("SELECT * FROM users WHERE LOWER(email)=?",(email,)).fetchone()
        if not u: raise HTTPException(401,"Neplatné přihlašovací údaje")
        valid=False
        if "password_hash" in u.keys():
            try:
                valid=verify_password(password,u["password_hash"])
            except Exception: valid=False
        if not valid:
            # Keep compatibility with legacy demo users where the project exposes a dedicated validator.
            try: valid=bool(authenticate_user(c,email,password))
            except Exception: valid=False
        if not valid:
            c.execute("INSERT INTO security_events VALUES (?,?,?,?,?,?)",
                      ("sec_"+uuid.uuid4().hex[:12],u["id"],"login_failed",request.client.host if request.client else None,json.dumps({},ensure_ascii=False),now()))
            c.commit()
            raise HTTPException(401,"Neplatné přihlašovací údaje")
        access=_issue_access_session(c, u)
        refresh=secrets.token_urlsafe(48)
        h=hashlib.sha256(refresh.encode()).hexdigest()
        import datetime
        exp=(datetime.datetime.utcnow()+datetime.timedelta(days=30)).isoformat(timespec="seconds")
        c.execute("INSERT INTO refresh_sessions VALUES (?,?,?,?,?,?,?)",
                  ("rs_"+uuid.uuid4().hex[:12],u["id"],h,exp,None,now(),now()))
        c.execute("INSERT INTO security_events VALUES (?,?,?,?,?,?)",
                  ("sec_"+uuid.uuid4().hex[:12],u["id"],"login_success",request.client.host if request.client else None,json.dumps({"role":u["role"]},ensure_ascii=False),now()))
        c.commit()
        return {"access_token":access,"refresh_token":refresh,"token_type":"bearer","expires_in":3600,"user_id":u["id"],"role":u["role"]}

