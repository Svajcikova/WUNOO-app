class AuthorizationPolicyEngine:
    """Deny-by-default policy engine with explicit role/resource/action rules."""
    def __init__(self,c): self.c=c

    def allow(self, subject, resource, action, resource_id=None, tenant_id=None, request_id=None):
        role=subject.get("role")
        row=self.c.execute("""SELECT effect,scope FROM authz_policies
                              WHERE resource=? AND action=? AND subject_role=?
                              ORDER BY id LIMIT 1""",(resource,action,role)).fetchone()
        decision="deny"; reason="no_matching_policy"
        if row and row["effect"]=="allow":
            scope=row["scope"]
            if scope=="global":
                decision="allow"; reason="explicit_global_policy"
            elif scope=="tenant":
                own=subject.get("merchant_id") or subject.get("tenant_id")
                decision="allow" if tenant_id and own and str(own)==str(tenant_id) else "deny"
                reason="tenant_match" if decision=="allow" else "tenant_mismatch"
            elif scope=="owner":
                own=subject.get("id")
                decision="allow" if resource_id and own and str(own)==str(resource_id) else "deny"
                reason="owner_match" if decision=="allow" else "owner_mismatch"
        self.c.execute("""INSERT INTO authorization_decisions
            (id,request_id,subject_id,subject_role,resource,action,resource_id,tenant_id,decision,reason,created_at)
            VALUES (?,?,?,?,?,?,?,?,?,?,?)""",
            ("azd_"+uuid.uuid4().hex[:12],request_id,subject.get("id"),role,resource,action,resource_id,tenant_id,decision,reason,now()))
        return decision=="allow",reason

def _v078_seed_policies(c):
    policies=[
        ("orders","read","admin","global"),
        ("orders","read","ops_agent","global"),
        ("orders","read","merchant","tenant"),
        ("orders","read","customer","owner"),
        ("orders","read","courier","global"),
        ("orders","transition","admin","global"),
        ("orders","transition","ops_agent","global"),
        ("orders","transition","merchant","tenant"),
        ("orders","transition","courier","owner"),
        ("payments","read","admin","global"),
        ("payments","read","ops_agent","global"),
        ("payments","read","merchant","tenant"),
        ("settlements","read","admin","global"),
        ("settlements","read","ops_agent","global"),
        ("settlements","read","merchant","tenant"),
    ]
    for resource,action,role,scope in policies:
        c.execute("""INSERT OR IGNORE INTO authz_policies
            (id,resource,action,subject_role,scope,effect,created_at)
            VALUES (?,?,?,?,?,?,?)""",
            ("pol_"+uuid.uuid4().hex[:12],resource,action,role,scope,"allow",now()))



