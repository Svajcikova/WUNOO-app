    "006_request_layer_v141.sql","007_request_layer_v138_order_lifecycle.sql","008_request_layer_v139_finance.sql",
    "009_request_layer_v140_operations_security.sql","010_release_candidate_gate.sql","011_production_hardening.sql",
    "012_production_deployment.sql","013_release_readiness.sql","014_release_artifact_integrity.sql",
    "015_release_operations.sql","016_production_observability_rollback.sql","017_final_production_launch.sql",
    "018_evidence_bound_final_launch.sql","019_business_critical_e2e.sql","020_deployment_aware_e2e_evidence.sql",
    "021_production_release_attestation.sql","022_controlled_production_rollout.sql","023_production_traffic_safety_controller.sql",
    "024_slo_burn_rate_incident_guard.sql","027_production_safety_engine_integration.sql","028_production_safety_event_ledger.sql",
    "029_safety_ledger_reconciliation_recovery.sql","030_global_evidence_root.sql","031_global_checkpoint_federation.sql",
    "032_merchant_menu_publication_v136.sql",
)
_V144_REQUIRED_TESTS = (
    "TEST_V110.py","TEST_V113.py","TEST_V129.py","TEST_V132_CX.py","TEST_V139.py","TEST_V140_PAYMENT_LOCK_E2E.py",
    "TEST_V141_PAYMENT_FINALITY_E2E.py","TEST_V142_FINANCE_FINALITY_E2E.py","TEST_V143.py","TEST_V144.py",
)

def _v144_migration_manifest() -> dict[str, Any]:
    files = _v142_postgresql_migration_files()
    names = [p.name for p in files]
    missing = [x for x in _V144_EXPECTED_MIGRATIONS if x not in names]
    unexpected_empty = [p.name for p in files if p.stat().st_size <= 0]
    checksums = [{"name": p.name, "sha256": hashlib.sha256(p.read_bytes()).hexdigest(), "bytes": p.stat().st_size} for p in files]
    return {
        "complete": not missing and not unexpected_empty,
        "missing": missing,
        "unexpected_empty": unexpected_empty,
        "file_count": len(files),
        "expected_file_count": len(_V144_EXPECTED_MIGRATIONS),
        "files": checksums,
    }

def _v144_test_artifact_scan() -> dict[str, Any]:
    root = Path(__file__).parent.parent
    present = {name: (root / name).exists() and (root / name).stat().st_size > 0 for name in _V144_REQUIRED_TESTS}
    return {"required": present, "all_present": all(present.values()), "count_present": sum(present.values()), "count_required": len(present)}

def _v144_release_candidate_scan() -> dict[str, Any]:
    request = _v135_request_layer_scan()
    sqlite = _v141_sqlite_specific_request_scan()
    manifest = _v144_migration_manifest()
    tests = _v144_test_artifact_scan()
    source = Path(__file__).read_text(encoding='utf-8')
    required_symbols = (
        'enforce_database_runtime_guard','_v142_bootstrap_postgresql','_v143_live_pg_gate',
        '_v144_release_candidate_scan','_v144_test_artifact_scan'
    )
    symbols = {s: (s in source) for s in required_symbols}
    production_guard = 'Production WUNOO requires PostgreSQL' in source
    passed = bool(
        request['remaining_request_functions'] == 0 and sqlite['count'] == 0 and manifest['complete']
        and tests['all_present'] and all(symbols.values()) and production_guard
    )
    return {
        "passed": passed,
        "request_layer": {"passed": request['remaining_request_functions'] == 0, **request},
        "sqlite_specific_request_layer": {"passed": sqlite['count'] == 0, **sqlite},
        "migration_manifest": {"passed": manifest['complete'], **manifest},
        "test_artifacts": {"passed": tests['all_present'], **tests},
        "required_runtime_symbols": symbols,
        "production_guard_present": production_guard,
    }

def _v144_runtime_gate() -> dict[str, Any]:
    backend = configured_db_backend()
    dsn = bool(os.getenv('WUNOO_DATABASE_URL') or os.getenv('DATABASE_URL'))
    env = os.getenv('WUNOO_ENV','development').strip().lower()
    production = env in {'prod','production','staging'}
    pg = _v143_live_pg_gate() if backend == 'postgresql' else {"executed": False, "passed": False, "reason": "NOT_POSTGRES"}
    return {
        "production_environment": production,
        "backend": backend,
        "dsn_configured": dsn,
        "live_postgresql": pg,
        "passed": (not production and backend == 'sqlite') or (backend == 'postgresql' and dsn and pg.get('executed') and pg.get('passed') is True),
    }

@app.get('/api/v144/ops/release-candidate-gate')
def v144_release_candidate_gate(authorization: str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    scan = _v144_release_candidate_scan()
    runtime = _v144_runtime_gate()
    release_candidate = bool(scan['passed'] and runtime['passed'])
    return {
        "schema_version":"1.44", "gate":"production_release_candidate",
        "release_candidate":release_candidate, "static_gates":scan, "runtime_gate":runtime,
        "blocking_reasons": ([] if release_candidate else ["runtime_postgresql_not_verified"] if runtime['production_environment'] else ["static_release_gate_failed"]),
        "note":"Production release requires a real PostgreSQL verification; local SQLite only proves static/release-candidate integrity."
    }

