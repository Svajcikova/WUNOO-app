@app.get("/api/v063/ops/order/{order_id}/360")
def v063_order_360(order_id:str, authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    with core_db_connect() as c:
        o=c.execute("SELECT * FROM orders WHERE id=?",(order_id,)).fetchone()
        if not o: raise HTTPException(404,"Objednávka nenalezena")
        tables=[
            ("events","SELECT * FROM events WHERE order_id=? ORDER BY created_at"),
            ("dispatch","SELECT * FROM dispatch_jobs WHERE order_id=?"),
            ("settlement","SELECT * FROM settlement_runs WHERE order_id=?"),
            ("ledger","SELECT * FROM finance_ledger_entries WHERE order_id=? ORDER BY created_at"),
            ("payments","SELECT * FROM payments WHERE order_id=?"),
        ]
        result={"order":dict(o)}
        for name,sql in tables: result[name]=[dict(x) for x in c.execute(sql,(order_id,)).fetchall()]
        return result

