        c.execute('INSERT INTO production_federation_reconciled_finality_gates(id,federation_id,epoch_id,federation_sha256,epoch_sha256,reconciliation_id,reconciliation_sha256,decision_id,decision_sha256,effective_quorum,eligible_witness_ids_json,gate_json,gate_sha256,algorithm,signer_key_id,public_key_b64,signature_b64,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(gid,fed['id'],epoch['id'],fed['federation_sha256'],epoch['epoch_sha256'],rec['id'],rec['reconciliation_sha256'],dec['id'],dec['decision_sha256'],int(dec['effective_quorum']),dec['eligible_witness_ids_json'],_v193_json(obj),digest,'Ed25519',keyid,base64.b64encode(pub).decode(),sig,'FINAL',t,operator));c.commit();g=c.execute('SELECT * FROM production_federation_reconciled_finality_gates WHERE id=?',(gid,)).fetchone();return {'schema_version':'1.93','idempotent':False,'gate':dict(g),'verification':{'valid':True,'reason':'RECONCILED_FINALITY_GATE_VERIFIED'}}

@app.get('/api/v193/ops/reconciled-finality/verify')
