        except Exception:raise HTTPException(409,'WITNESS_SIGNATURE_INVALID')
        aid='gcpa_'+uuid.uuid4().hex[:16];t=now();c.execute('INSERT INTO production_global_evidence_checkpoint_attestations(id,checkpoint_id,checkpoint_sha256,witness_id,key_id,public_key_b64,signature_b64,attestation_json,attestation_sha256,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?)',(aid,cp['id'],cp['checkpoint_sha256'],wid,obj['key_id'],pb,sig,_v183_json(obj),digest,'VERIFIED',t,operator));c.commit();row=_v170_row(c,'production_global_evidence_checkpoint_attestations',' WHERE id=?',(aid,),'created_at DESC');return {'schema_version':'1.83','idempotent':False,'attestation':dict(row),'verification':_v183_verify_attestation(c,row)}
@app.post('/api/v183/ops/global-evidence-checkpoints/finality')
def v183_finality(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin'});p=payload or {};operator=str(u.get('email') or u.get('id') or 'operator')
