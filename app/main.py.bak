@app.get("/api/v072/ops/metrics")
def v072_metrics(authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    with core_db_connect() as c:
        total=int(c.execute("SELECT COUNT(*) n FROM request_metrics").fetchone()["n"])
        errors=int(c.execute("SELECT COUNT(*) n FROM request_metrics WHERE status_code>=500").fetchone()["n"])
        client_errors=int(c.execute("SELECT COUNT(*) n FROM request_metrics WHERE status_code>=400 AND status_code<500").fetchone()["n"])
        avg=float(c.execute("SELECT COALESCE(AVG(duration_ms),0) n FROM request_metrics").fetchone()["n"])
        p95=float(c.execute("""SELECT duration_ms FROM request_metrics ORDER BY duration_ms
                                LIMIT 1 OFFSET MAX((SELECT COUNT(*) FROM request_metrics)-1,0)*95/100""").fetchone()["duration_ms"]) if total else 0
        return {"requests":total,"server_errors":errors,"client_errors":client_errors,"avg_ms":round(avg,2),"p95_ms":round(p95,2)}

@app.get("/api/v072/ops/metrics/routes")
def v072_route_metrics(authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    with core_db_connect() as c:
        rows=c.execute("""SELECT path,COUNT(*) requests,ROUND(AVG(duration_ms),2) avg_ms,
                          SUM(CASE WHEN status_code>=500 THEN 1 ELSE 0 END) server_errors
                          FROM request_metrics GROUP BY path ORDER BY requests DESC LIMIT 100""").fetchall()
        return {"routes":[dict(x) for x in rows]}

