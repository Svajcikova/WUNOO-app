    return FileResponse(BASE.parent / "frontend_v029" / "tracking_v045.html")


@app.post("/api/v046/reliability/sweep")
def v046_reliability_sweep(authorization: str | None = Header(default=None)) -> dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    created=[]
    recovery=[]
    redispatch=[]
    with core_db_connect() as c:
        rows=c.execute("""SELECT * FROM orders
            WHERE status NOT IN ('delivered','cancelled')
            ORDER BY created_at LIMIT 500""").fetchall()
        for o in rows:
            assessment=_v046_assess_order(c,o)
            for typ,severity,details in assessment["issues"]:
                active=c.execute("SELECT 1 FROM reliability_incidents WHERE order_id=? AND type=? AND status='open'",(o["id"],typ)).fetchone()
                if active: continue
                iid="inc_"+uuid.uuid4().hex[:10]
                c.execute("INSERT INTO reliability_incidents VALUES (?,?,?,?,?,?,?,?)",
                          (iid,o["id"],typ,severity,"open",now(),None,json.dumps(details)))
                emit(c,o["id"],"reliability_incident_opened",{"incident_id":iid,"type":typ,"severity":severity,"details":details},u["id"])
                created.append({"id":iid,"order_id":o["id"],"type":typ,"severity":severity})
                if typ=="STALE_GPS" and o["status"] in {"assigned","picked_up","out_for_delivery","delayed"} and o["courier_id"]:
                    rid="rd_"+uuid.uuid4().hex[:10]
                    c.execute("INSERT INTO order_redispatches VALUES (?,?,?,?,?,?,?)",
                              (rid,o["id"],o["courier_id"],"stale_gps","requested",now(),None))
                    redispatch.append({"id":rid,"order_id":o["id"],"reason":"stale_gps"})
                if typ=="PROMISE_BREACH":
                    amount=_v046_recovery_amount(o,typ)
                    if amount>0:
                        aid="rec_"+uuid.uuid4().hex[:10]
                        c.execute("INSERT INTO customer_recovery_actions VALUES (?,?,?,?,?,?,?)",
                                  (aid,o["id"],"service_credit",amount,"proposed",now(),None))
                        recovery.append({"id":aid,"order_id":o["id"],"action":"service_credit","amount_czk":amount})
        c.commit()
    return {"incidents":created,"recovery_actions":recovery,"redispatches":redispatch}


@app.get("/api/v046/orders/{order_id}/reliability")
def v046_order_reliability(order_id:str, authorization: str | None = Header(default=None)) -> dict[str,Any]:
    u=current_user(authorization)
    with core_db_connect() as c:
        o=c.execute("SELECT * FROM orders WHERE id=?",(order_id,)).fetchone()
        if not o: raise HTTPException(404,"Objednávka nenalezena")
        allowed=(u["role"]=="admin" or
                 (u["role"]=="ops_agent") or
                 (u["role"]=="customer" and o["customer_id"]==u["customer_id"]) or
                 (u["role"]=="merchant" and o["merchant_id"]==u["merchant_id"]) or
                 (u["role"]=="courier" and o["courier_id"]==u["courier_id"]))
        if not allowed: raise HTTPException(403,"forbidden")
        inc=c.execute("SELECT * FROM reliability_incidents WHERE order_id=? ORDER BY detected_at DESC",(order_id,)).fetchall()
        rec=c.execute("SELECT * FROM customer_recovery_actions WHERE order_id=? ORDER BY created_at DESC",(order_id,)).fetchall()
        rd=c.execute("SELECT * FROM order_redispatches WHERE order_id=? ORDER BY created_at DESC",(order_id,)).fetchall()
        return {"order_id":order_id,
                "incidents":[dict(x) for x in inc],
                "recovery_actions":[dict(x) for x in rec],
                "redispatches":[dict(x) for x in rd]}


@app.post("/api/v046/orders/{order_id}/redispatch")
def v046_redispatch(order_id:str, authorization: str | None = Header(default=None)) -> dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    with core_db_connect() as c:
        o=c.execute("SELECT * FROM orders WHERE id=?",(order_id,)).fetchone()
        if not o: raise HTTPException(404,"Objednávka nenalezena")
        # Atomically move the order back to dispatch_pending and detach the previous courier.
        old=o["courier_id"]
        expected=str(o["status"])
        if expected in {'delivered','cancelled'}:
            raise HTTPException(409,"Objednávku nelze redispatchnout")
        atomic_transition_any(c, order_id, (expected,), 'dispatch_pending', u, 'order_redispatch_requested', {"old_courier_id":old})
        c.execute("UPDATE orders SET courier_id=NULL,updated_at=? WHERE id=? AND status='dispatch_pending'",(now(),order_id))
        rid="rd_"+uuid.uuid4().hex[:10]
        c.execute("INSERT INTO order_redispatches VALUES (?,?,?,?,?,?,?)",(rid,order_id,old,"manual_or_reliability","completed",now(),now()))
        emit(c,order_id,"order_redispatch_requested",{"redispatch_id":rid,"old_courier_id":old},u["id"])
        c.commit()
        return {"order_id":order_id,"status":"dispatch_pending","redispatch_id":rid,"old_courier_id":old}


@app.post("/api/v046/recovery/{recovery_id}/apply")
def v046_apply_recovery(recovery_id:str, authorization: str | None = Header(default=None)) -> dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    with core_db_connect() as c:
        r=c.execute("SELECT * FROM customer_recovery_actions WHERE id=?",(recovery_id,)).fetchone()
        if not r: raise HTTPException(404,"Recovery akce nenalezena")
        if r["status"]=="applied": return dict(r)
        c.execute("UPDATE customer_recovery_actions SET status='applied',applied_at=? WHERE id=?",(now(),recovery_id))
        emit(c,r["order_id"],"customer_recovery_applied",{"recovery_id":recovery_id,"amount_czk":r["amount_czk"],"action":r["action"]},u["id"])
        c.commit()
        return {"id":recovery_id,"status":"applied","amount_czk":r["amount_czk"]}

