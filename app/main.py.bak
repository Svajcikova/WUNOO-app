                _,Ed25519PublicKey,_,_,_,_=_v169_crypto();Ed25519PublicKey.from_public_bytes(base64.b64decode(r['public_key_b64'],validate=True)).verify(base64.b64decode(r['signature_b64'],validate=True),_v191_json(obj).encode())
            except Exception:return {'schema_version':'1.91','valid':False,'reason':'DECISION_SIGNATURE_INVALID','checked_assessments':len(rows),'checked_decisions':i}
        return {'schema_version':'1.91','valid':True,'reason':'ADAPTIVE_TRUST_RECOVERY_EVIDENCE_VERIFIED','assessments':len(rows),'decisions':len(ds)}


# ---------------- WUNOO v1.92: Trust Recovery -> Quorum Reconciliation ----------------
def migrate_v192(c):
    c.executescript("""CREATE TABLE IF NOT EXISTS production_federation_quorum_reconciliations(
        id TEXT PRIMARY KEY, federation_id TEXT NOT NULL, epoch_id TEXT, reconciliation_no INTEGER NOT NULL,
        previous_state TEXT, current_state TEXT NOT NULL, transition TEXT NOT NULL, current_quorum INTEGER NOT NULL, minimum_quorum INTEGER NOT NULL,
        eligible_count INTEGER NOT NULL, recoverable_count INTEGER NOT NULL, pending_count INTEGER NOT NULL,
        restored_witness_ids_json TEXT NOT NULL, excluded_witness_ids_json TEXT NOT NULL,
        reconciliation_json TEXT NOT NULL, reconciliation_sha256 TEXT NOT NULL UNIQUE,
        algorithm TEXT NOT NULL, signer_key_id TEXT NOT NULL, public_key_b64 TEXT NOT NULL, signature_b64 TEXT NOT NULL,
        status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT
    );
    CREATE INDEX IF NOT EXISTS idx_v192_reconcile_fed ON production_federation_quorum_reconciliations(federation_id,created_at);
    CREATE TABLE IF NOT EXISTS production_federation_quorum_reconciliation_decisions(
        id TEXT PRIMARY KEY, reconciliation_id TEXT NOT NULL, federation_id TEXT NOT NULL, epoch_id TEXT,
        decision_type TEXT NOT NULL, effective_quorum INTEGER NOT NULL, eligible_witness_ids_json TEXT NOT NULL,
        restored_witness_ids_json TEXT NOT NULL, decision_json TEXT NOT NULL, decision_sha256 TEXT NOT NULL UNIQUE,
        algorithm TEXT NOT NULL, signer_key_id TEXT NOT NULL, public_key_b64 TEXT NOT NULL, signature_b64 TEXT NOT NULL,
        status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT
    );
    CREATE INDEX IF NOT EXISTS idx_v192_decisions_fed ON production_federation_quorum_reconciliation_decisions(federation_id,created_at);
    """)

_V192_POLICY={
    'schema_version':'1.92',
    'reconciliation_format':'wunoo.release.global.checkpoint.federation.quorum.reconciliation.v1',
    'decision_format':'wunoo.release.global.checkpoint.federation.quorum.reconciliation.decision.v1',
    'hash':'SHA-256','algorithm':'Ed25519','minimum_quorum_rule':'floor(2N/3)+1',
    'automatic_trust_restoration':False,'automatic_finality':False,
    'historical_federation_immutable':True,'fail_closed':True,'no_automatic_release':True
}
def _v192_hash(v): return hashlib.sha256(json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()).hexdigest()
def _v192_json(v): return json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False)
def _v192_min_quorum(n): return (2*n)//3+1 if n else 0
def _v192_latest_event(c,fid,wid):
    return c.execute('SELECT * FROM production_federation_recovery_events WHERE federation_id=? AND subject_witness_id=? ORDER BY created_at DESC,id DESC',(fid,wid)).fetchone()
def _v192_reconcile(c,fid,epoch_id=None,exclude_reconciliation_id=None):
    fed=_v170_row(c,'production_global_checkpoint_federations',' WHERE id=?',(fid,),'created_at DESC')
    if not fed: raise HTTPException(404,'FEDERATION_NOT_FOUND')
    if not _v184_verify_federation(c,fed)['valid']: raise HTTPException(409,'FEDERATION_INVALID')
    members=sorted(set(json.loads(fed['member_witness_ids_json'] or '[]'))); minimum=_v192_min_quorum(len(members)); effective_q=int(fed['quorum_required']); binding=None
    if epoch_id:
        binding=_v190_binding(c,epoch_id)
        if not binding: raise HTTPException(409,'DYNAMIC_QUORUM_BINDING_REQUIRED')
        effective_q=int(binding['effective_quorum'])
    if effective_q<minimum: raise HTTPException(409,'QUORUM_BELOW_BFT_MINIMUM')
    conflicts=_v188_conflicts(c,fid); byz={r['witness_id'] for r in conflicts if _v188_verify_conflict(c,r)['valid']}
    eligible=[];excluded=[];recoverable=[];pending=[];restored=[];details=[]
    for wid in members:
        trust=_v177_evaluate(c,wid); latest=_v192_latest_event(c,fid,wid); et=str(latest['event_type']) if latest else None
        unavailable=et in {'WITNESS_SUSPENDED','WITNESS_REVOKED','WITNESS_UNAVAILABLE'}
        is_recovery=et in {'WITNESS_REINSTATED','WITNESS_REPLACED','QUORUM_RESTORED'}
        if unavailable: recoverable.append(wid)
        elif not trust['valid']: pending.append(wid)
        if is_recovery and trust['valid'] and wid not in byz: restored.append(wid)
        ok=trust['valid'] and wid not in byz and not unavailable
        (eligible if ok else excluded).append(wid)
        details.append({'witness_id':wid,'trusted':bool(trust['valid']),'latest_recovery_event':et,'byzantine_conflict':wid in byz,'eligible_for_quorum':ok})
    query='SELECT * FROM production_federation_quorum_reconciliations WHERE federation_id=?'
    args=[fid]
    if exclude_reconciliation_id: query+=' AND id<>?';args.append(exclude_reconciliation_id)
    query+=' ORDER BY created_at DESC,id DESC LIMIT 1'
    prev=c.execute(query,tuple(args)).fetchone(); previous_state=prev['current_state'] if prev else None
    ec=len(eligible); state='SAFE' if ec>=effective_q and not excluded else ('DEGRADED' if ec>=effective_q else 'UNSAFE')
    if previous_state=='UNSAFE' and state=='SAFE': transition='RECOVERED_TO_SAFE'
    elif previous_state=='DEGRADED' and state=='SAFE': transition='DEGRADED_TO_SAFE'
    elif state=='DEGRADED': transition='REMAINS_DEGRADED'
    elif state=='UNSAFE': transition='REMAINS_UNSAFE'
    else: transition='SAFE_RECONFIRMED'
    chain=_v187_chain(c,fid);cv=_v188_verify_all(c,fid)
    if not chain['valid']: raise HTTPException(409,chain['reason'])
    if not cv['valid']: raise HTTPException(409,cv['reason'])
    payload={'format':_V192_POLICY['reconciliation_format'],'schema_version':'1.92','federation_id':fid,'federation_sha256':fed['federation_sha256'],'epoch_id':epoch_id,'current_quorum':effective_q,'minimum_quorum':minimum,'member_count':len(members),'eligible_witness_ids':eligible,'excluded_witness_ids':excluded,'recoverable_witness_ids':recoverable,'pending_witness_ids':pending,'restored_witness_ids':sorted(set(restored)),'eligible_count':ec,'recoverable_count':len(recoverable),'pending_count':len(pending),'current_state':state,'previous_state':previous_state,'transition':transition,'recovery_head_sha256':chain['head_sha256'],'byzantine_conflict_count':len(conflicts),'binding_sha256':binding['binding_sha256'] if binding else None,'details':details}
    return fed,payload
def _v192_verify_reconciliation(c,row):
    try:
        obj=json.loads(row['reconciliation_json'] or '{}')
        if _v192_hash(obj)!=row['reconciliation_sha256']: return {'valid':False,'reason':'RECONCILIATION_HASH_INVALID'}
        if obj.get('federation_sha256')!=row['reconciliation_json'] and False: return {'valid':False,'reason':'RECONCILIATION_FEDERATION_CHANGED'}
        fed=_v170_row(c,'production_global_checkpoint_federations',' WHERE id=?',(row['federation_id'],),'created_at DESC')
        if not fed or fed['federation_sha256']!=obj.get('federation_sha256'): return {'valid':False,'reason':'RECONCILIATION_FEDERATION_CHANGED'}
        chain=_v187_chain(c,row['federation_id']);cv=_v188_verify_all(c,row['federation_id'])
        if not chain['valid']: return {'valid':False,'reason':chain['reason']}
        if not cv['valid']: return {'valid':False,'reason':cv['reason']}
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto()
        Ed25519PublicKey.from_public_bytes(base64.b64decode(row['public_key_b64'],validate=True)).verify(base64.b64decode(row['signature_b64'],validate=True),_v192_json(obj).encode())
        return {'valid':True,'reason':'QUORUM_RECONCILIATION_VERIFIED'}
    except HTTPException as e:return {'valid':False,'reason':str(e.detail)}
    except Exception:return {'valid':False,'reason':'RECONCILIATION_SIGNATURE_INVALID'}
def _v192_decision_payload(r):
    return {'format':_V192_POLICY['decision_format'],'schema_version':'1.92','reconciliation_id':r['id'],'federation_id':r['federation_id'],'federation_sha256':r['federation_sha256'],'epoch_id':r['epoch_id'],'decision_type':r['decision_type'],'effective_quorum':int(r['effective_quorum']),'eligible_witness_ids':json.loads(r['eligible_witness_ids_json'] or '[]'),'restored_witness_ids':json.loads(r['restored_witness_ids_json'] or '[]'),'reconciliation_sha256':r['reconciliation_sha256']}

@app.get('/api/v192/ops/quorum-reconciliation/policy')
def v192_policy(authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'});return _V192_POLICY
@app.post('/api/v192/ops/quorum-reconciliation/assess')
def v192_assess(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'});p=payload or {};operator=str(u.get('email') or u.get('id') or 'operator')
    with core_db_connect() as c:
        fed,obj=_v192_reconcile(c,str(p.get('federation_id') or ''),p.get('epoch_id'));digest=_v192_hash(obj);ex=c.execute('SELECT * FROM production_federation_quorum_reconciliations WHERE reconciliation_sha256=?',(digest,)).fetchone()
        if ex:return {'schema_version':'1.92','idempotent':True,'reconciliation':dict(ex),'verification':_v192_verify_reconciliation(c,ex)}
        mx=c.execute('SELECT COALESCE(MAX(reconciliation_no),0) AS n FROM production_federation_quorum_reconciliations WHERE federation_id=?',(fed['id'],)).fetchone();no=int(mx['n'])+1;signer,pub,keyid=_v169_load_signer();sig=base64.b64encode(signer.sign(_v192_json(obj).encode())).decode();rid='qrr_'+uuid.uuid4().hex[:16];t=now()
        c.execute('INSERT INTO production_federation_quorum_reconciliations(id,federation_id,epoch_id,reconciliation_no,previous_state,current_state,transition,current_quorum,minimum_quorum,eligible_count,recoverable_count,pending_count,restored_witness_ids_json,excluded_witness_ids_json,reconciliation_json,reconciliation_sha256,algorithm,signer_key_id,public_key_b64,signature_b64,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(rid,fed['id'],p.get('epoch_id'),no,obj['previous_state'],obj['current_state'],obj['transition'],obj['current_quorum'],obj['minimum_quorum'],obj['eligible_count'],obj['recoverable_count'],obj['pending_count'],_v192_json(obj['restored_witness_ids']),_v192_json(obj['excluded_witness_ids']),_v192_json(obj),digest,'Ed25519',keyid,base64.b64encode(pub).decode(),sig,'FINAL',t,operator));c.commit();r=c.execute('SELECT * FROM production_federation_quorum_reconciliations WHERE id=?',(rid,)).fetchone();return {'schema_version':'1.92','idempotent':False,'reconciliation':dict(r),'verification':_v192_verify_reconciliation(c,r)}
@app.post('/api/v192/ops/quorum-reconciliation/decision')
def v192_decision(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin'});p=payload or {};operator=str(u.get('email') or u.get('id') or 'operator')
    with core_db_connect() as c:
        rid=str(p.get('reconciliation_id') or '');r=c.execute('SELECT * FROM production_federation_quorum_reconciliations WHERE id=?',(rid,)).fetchone()
        if not r: raise HTTPException(404,'RECONCILIATION_NOT_FOUND')
        vr=_v192_verify_reconciliation(c,r)
        if not vr['valid']: raise HTTPException(409,vr['reason'])
        if r['current_state']!='SAFE': raise HTTPException(409,'QUORUM_NOT_SAFE')
        dtype='RECOVERY_QUORUM_RECONCILED' if r['transition'] in {'RECOVERED_TO_SAFE','DEGRADED_TO_SAFE'} else 'QUORUM_RECONFIRMED_SAFE'
        objbase=json.loads(r['reconciliation_json'] or '{}');row={'id':rid,'federation_id':r['federation_id'],'federation_sha256':objbase['federation_sha256'],'epoch_id':r['epoch_id'],'decision_type':dtype,'effective_quorum':r['current_quorum'],'eligible_witness_ids_json':objbase.get('eligible_witness_ids_json') or _v192_json(objbase['eligible_witness_ids']),'restored_witness_ids_json':r['restored_witness_ids_json'],'reconciliation_sha256':r['reconciliation_sha256']}
        obj=_v192_decision_payload(row);digest=_v192_hash(obj);ex=c.execute('SELECT * FROM production_federation_quorum_reconciliation_decisions WHERE decision_sha256=?',(digest,)).fetchone()
        if ex:return {'schema_version':'1.92','idempotent':True,'decision':dict(ex)}
        signer,pub,keyid=_v169_load_signer();sig=base64.b64encode(signer.sign(_v192_json(obj).encode())).decode();did='qrd_'+uuid.uuid4().hex[:16];t=now();c.execute('INSERT INTO production_federation_quorum_reconciliation_decisions(id,reconciliation_id,federation_id,epoch_id,decision_type,effective_quorum,eligible_witness_ids_json,restored_witness_ids_json,decision_json,decision_sha256,algorithm,signer_key_id,public_key_b64,signature_b64,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(did,rid,r['federation_id'],r['epoch_id'],dtype,int(r['current_quorum']),row['eligible_witness_ids_json'],r['restored_witness_ids_json'],_v192_json(obj),digest,'Ed25519',keyid,base64.b64encode(pub).decode(),sig,'FINAL',t,operator));c.commit();d=c.execute('SELECT * FROM production_federation_quorum_reconciliation_decisions WHERE id=?',(did,)).fetchone();return {'schema_version':'1.92','idempotent':False,'decision':dict(d),'verification':{'valid':True,'reason':'QUORUM_RECONCILIATION_DECISION_VERIFIED'}}
@app.get('/api/v192/ops/quorum-reconciliation/verify')
def v192_verify(authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        rs=c.execute('SELECT * FROM production_federation_quorum_reconciliations ORDER BY created_at,id').fetchall()
        for i,r in enumerate(rs,1):
            vr=_v192_verify_reconciliation(c,r)
            if not vr['valid']: return {'schema_version':'1.92','valid':False,'reason':vr['reason'],'checked_reconciliations':i}
        ds=c.execute('SELECT * FROM production_federation_quorum_reconciliation_decisions ORDER BY created_at,id').fetchall();_,Ed25519PublicKey,_,_,_,_=_v169_crypto()
        for i,d in enumerate(ds,1):
            try:
                obj=json.loads(d['decision_json'] or '{}')
                if _v192_hash(obj)!=d['decision_sha256']: raise ValueError()
                Ed25519PublicKey.from_public_bytes(base64.b64decode(d['public_key_b64'],validate=True)).verify(base64.b64decode(d['signature_b64'],validate=True),_v192_json(obj).encode())
            except Exception:return {'schema_version':'1.92','valid':False,'reason':'DECISION_SIGNATURE_INVALID','checked_reconciliations':len(rs),'checked_decisions':i}
        return {'schema_version':'1.92','valid':True,'reason':'TRUST_RECOVERY_QUORUM_RECONCILIATION_VERIFIED','reconciliations':len(rs),'decisions':len(ds)}


# ---------------- WUNOO v1.93: Reconciled Finality Gate ----------------
def migrate_v193(c):
    c.executescript("""CREATE TABLE IF NOT EXISTS production_federation_reconciled_finality_gates(
        id TEXT PRIMARY KEY, federation_id TEXT NOT NULL, epoch_id TEXT NOT NULL,
        federation_sha256 TEXT NOT NULL, epoch_sha256 TEXT NOT NULL,
        reconciliation_id TEXT NOT NULL, reconciliation_sha256 TEXT NOT NULL,
        decision_id TEXT NOT NULL, decision_sha256 TEXT NOT NULL,
        effective_quorum INTEGER NOT NULL, eligible_witness_ids_json TEXT NOT NULL,
        gate_json TEXT NOT NULL, gate_sha256 TEXT NOT NULL UNIQUE,
        algorithm TEXT NOT NULL, signer_key_id TEXT NOT NULL, public_key_b64 TEXT NOT NULL,
        signature_b64 TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT
    );
    CREATE INDEX IF NOT EXISTS idx_v193_gate_epoch ON production_federation_reconciled_finality_gates(epoch_id,created_at);
    """)

_V193_POLICY={
    'schema_version':'1.93',
    'gate_format':'wunoo.release.global.checkpoint.federation.reconciled.finality.gate.v1',
    'hash':'SHA-256','algorithm':'Ed25519',
    'requires_reconciliation_state':'SAFE',
    'requires_recovery_decision':True,
    'historical_federation_immutable':True,
    'automatic_gate_creation':False,
    'automatic_finality':False,
    'fail_closed':True,'no_automatic_release':True
}
def _v193_hash(v): return hashlib.sha256(json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()).hexdigest()
def _v193_json(v): return json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False)
def _v193_gate_for_epoch(c,epoch):
    if not epoch:return None
    r=c.execute('SELECT * FROM production_federation_reconciled_finality_gates WHERE epoch_id=? ORDER BY created_at DESC,id DESC LIMIT 1',(epoch['id'],)).fetchone()
    return r
def _v193_require_finality_gate(c,epoch):
    g=_v193_gate_for_epoch(c,epoch)
    if not g:return False
    try:
        obj=json.loads(g['gate_json'] or '{}')
        if _v193_hash(obj)!=g['gate_sha256']:return False
        if obj.get('epoch_sha256')!=epoch['epoch_sha256']:return False
        rec=c.execute('SELECT * FROM production_federation_quorum_reconciliations WHERE id=?',(g['reconciliation_id'],)).fetchone()
        dec=c.execute('SELECT * FROM production_federation_quorum_reconciliation_decisions WHERE id=?',(g['decision_id'],)).fetchone()
        if not rec or not dec or rec['current_state']!='SAFE' or dec['decision_type'] not in {'RECOVERY_QUORUM_RECONCILED','QUORUM_RECONFIRMED_SAFE'}:return False
        if rec['reconciliation_sha256']!=g['reconciliation_sha256'] or dec['decision_sha256']!=g['decision_sha256']:return False
        vr=_v192_verify_reconciliation(c,rec)
        if not vr['valid']:return False
        objd=json.loads(dec['decision_json'] or '{}')
        if _v192_hash(objd)!=dec['decision_sha256']:return False
        b=_v190_binding(c,epoch['id'])
        if not b or int(dec['effective_quorum'])!=int(b['effective_quorum']):
            # v1.90 epoch quorum must match reconciled effective quorum.
            return False
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto()
        Ed25519PublicKey.from_public_bytes(base64.b64decode(g['public_key_b64'],validate=True)).verify(base64.b64decode(g['signature_b64'],validate=True),_v193_json(obj).encode())
        return True
    except Exception:return False

def _v193_gate_payload(epoch,fed,rec,dec):
    return {'format':_V193_POLICY['gate_format'],'schema_version':'1.93','federation_id':fed['id'],'federation_sha256':fed['federation_sha256'],'epoch_id':epoch['id'],'epoch_sha256':epoch['epoch_sha256'],'reconciliation_id':rec['id'],'reconciliation_sha256':rec['reconciliation_sha256'],'decision_id':dec['id'],'decision_sha256':dec['decision_sha256'],'effective_quorum':int(dec['effective_quorum']),'eligible_witness_ids':json.loads(dec['eligible_witness_ids_json'] or '[]'),'gate_state':'RECONCILED_SAFE'}

@app.get('/api/v193/ops/reconciled-finality/policy')
def v193_policy(authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'});return _V193_POLICY

@app.post('/api/v193/ops/reconciled-finality/gate')
def v193_gate(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin'});p=payload or {};operator=str(u.get('email') or u.get('id') or 'operator')
    with core_db_connect() as c:
        epoch=_v186_epoch(c,p.get('epoch_id'))
        if not epoch:raise HTTPException(404,'EPOCH_NOT_FOUND')
        fed=_v170_row(c,'production_global_checkpoint_federations',' WHERE id=?',(epoch['federation_id'],),'created_at DESC')
        rec=c.execute('SELECT * FROM production_federation_quorum_reconciliations WHERE federation_id=? AND epoch_id IS NULL ORDER BY created_at DESC,id DESC LIMIT 1',(fed['id'],)).fetchone()
        if not rec: rec=c.execute('SELECT * FROM production_federation_quorum_reconciliations WHERE federation_id=? ORDER BY created_at DESC,id DESC LIMIT 1',(fed['id'],)).fetchone()
        if not rec:raise HTTPException(409,'RECONCILIATION_REQUIRED')
        vr=_v192_verify_reconciliation(c,rec)
        if not vr['valid']:raise HTTPException(409,vr['reason'])
        if rec['current_state']!='SAFE':raise HTTPException(409,'RECONCILIATION_NOT_SAFE')
        dec=c.execute('SELECT * FROM production_federation_quorum_reconciliation_decisions WHERE reconciliation_id=? ORDER BY created_at DESC,id DESC LIMIT 1',(rec['id'],)).fetchone()
        if not dec:raise HTTPException(409,'RECONCILIATION_DECISION_REQUIRED')
