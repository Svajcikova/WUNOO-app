    try:
        rows=c.execute('SELECT * FROM production_recovery_finality_checkpoint_finality_continuity_chain_v107 ORDER BY sequence_no').fetchall();prev=_V107_POLICY['genesis_hash'];expected=1
        for r in rows:
            if int(r['sequence_no'])!=expected:return {'valid':False,'reason':'V107_SEQUENCE_GAP','expected_sequence':expected,'actual_sequence':int(r['sequence_no']),'entries':len(rows)}
            if r['previous_entry_sha256']!=prev:return {'valid':False,'reason':'V107_PREVIOUS_HASH_MISMATCH','sequence_no':expected,'entries':len(rows)}
            vr=_v107_verify_entry(c,r)
            if not vr.get('valid'):return {'valid':False,'reason':'V107_ENTRY_NOT_VERIFIABLE','sequence_no':expected,'detail':vr.get('reason'),'entries':len(rows)}
            prev=r['entry_sha256'];expected+=1
        return {'valid':True,'entries':len(rows),'head_entry_sha256':prev,'next_sequence_no':expected}
    except Exception:return {'valid':False,'reason':'V107_CHAIN_INVALID'}
