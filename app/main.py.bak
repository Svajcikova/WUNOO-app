# ---------------- v1.41 Legacy request-layer bulk cutover ----------------
def migrate_v141(c):
    c.execute("""CREATE TABLE IF NOT EXISTS v141_request_layer_cutover(
        id TEXT PRIMARY KEY, cutover_version TEXT NOT NULL,
        direct_conn_request_functions INTEGER NOT NULL,
        sqlite_specific_request_functions INTEGER NOT NULL,
        status TEXT NOT NULL, created_at TEXT NOT NULL
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_v141_request_layer_cutover_created ON v141_request_layer_cutover(created_at DESC)")
    c.execute("""CREATE TABLE IF NOT EXISTS payment_capture_finality_v141(
        id TEXT PRIMARY KEY, order_id TEXT NOT NULL UNIQUE, payment_intent_id TEXT NOT NULL UNIQUE,
        provider_event_id TEXT UNIQUE, payment_id TEXT NOT NULL UNIQUE, amount_czk REAL NOT NULL,
        currency TEXT NOT NULL, ledger_debit_czk REAL NOT NULL, ledger_credit_czk REAL NOT NULL,
        status TEXT NOT NULL, finality_sha256 TEXT NOT NULL UNIQUE, created_at TEXT NOT NULL, updated_at TEXT NOT NULL
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_v141_finality_order ON payment_capture_finality_v141(order_id)")
    c.execute("""CREATE TABLE IF NOT EXISTS payment_capture_finality_audit_v141(
        id TEXT PRIMARY KEY, order_id TEXT NOT NULL, payment_intent_id TEXT NOT NULL, action TEXT NOT NULL,
        provider_event_id TEXT, status TEXT NOT NULL, amount_czk REAL, details_json TEXT, created_at TEXT NOT NULL
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_v141_finality_audit_order ON payment_capture_finality_audit_v141(order_id,created_at DESC)")
    c.commit()

def _v141_sqlite_specific_request_scan() -> dict[str, Any]:
    import ast
    source=Path(__file__).read_text(encoding="utf-8")
    tree=ast.parse(source)
    terms=("sqlite_master","PRAGMA","BEGIN IMMEDIATE","INSERT OR REPLACE","datetime('now'",'datetime("now"')
    hits=[]
    for node in ast.walk(tree):
        if not isinstance(node,(ast.FunctionDef,ast.AsyncFunctionDef)): continue
        routes=[]
        for dec in node.decorator_list:
            if isinstance(dec,ast.Call) and isinstance(dec.func,ast.Attribute) and dec.func.attr in {"get","post","put","patch","delete","options","head"} and dec.args and isinstance(dec.args[0],ast.Constant):
                routes.append(str(dec.args[0].value))
        if not routes: continue
        text="\n".join(source.splitlines()[node.lineno-1:node.end_lineno])
        found=[term for term in terms if term.lower() in text.lower()]
        if found: hits.append({"function":node.name,"routes":routes,"line":node.lineno,"sqlite_constructs":found})
    return {"count":len(hits),"routes":hits}



# ---------------- WUNOO v1.141: Payment Capture & Order Finality ----------------
_V141_POLICY={'schema_version':'1.141','format':'wunoo.release.payment.capture.order.finality.v1','hash':'SHA-256','fail_closed':True,'immutable_finality':True,'payment_unique_per_order':True,'provider_event_replay_safe':True,'ledger_double_entry_required':True,'no_duplicate_capture':True}

def _v141_json(v): return json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False)
def _v141_hash(v): return hashlib.sha256(_v141_json(v).encode()).hexdigest()
def _v141_get_intent(c,intent_id,customer_id=None):
    if customer_id is None: row=c.execute('SELECT * FROM payment_intents WHERE id=?',(intent_id,)).fetchone()
    else: row=c.execute('SELECT pi.* FROM payment_intents pi JOIN orders o ON o.id=pi.order_id WHERE pi.id=? AND o.customer_id=?',(intent_id,customer_id)).fetchone()
    if not row: raise HTTPException(404,'Payment intent nenalezen')
    return row

def _v141_capture_finality(c,pi,provider_event_id=None,actor_id='system:payment_finality'):
    order_id=str(pi['order_id']); intent_id=str(pi['id'])
    locked=round(float(pi['locked_amount_czk'] if pi['locked_amount_czk'] is not None else pi['amount_czk']),2); currency=str(pi['locked_currency'] or pi['currency'] or 'CZK')
    existing=c.execute('SELECT * FROM payment_capture_finality_v141 WHERE order_id=?',(order_id,)).fetchone()
    if existing:
        if str(existing['payment_intent_id'])!=intent_id or round(float(existing['amount_czk']),2)!=locked or str(existing['currency'])!=currency: raise HTTPException(409,{'code':'PAYMENT_FINALITY_CONFLICT'})
        return dict(existing),True
    payment=c.execute('SELECT * FROM payments WHERE order_id=?',(order_id,)).fetchone()
    if payment:
        if round(float(payment['amount_czk']),2)!=locked or str(payment['provider_payment_id'])!=str(pi['provider_intent_id']): raise HTTPException(409,{'code':'CAPTURE_CONFLICT'})
        payment_id=str(payment['id'])
        if str(payment['status'])!='captured': c.execute('UPDATE payments SET status=? WHERE id=?',('captured',payment_id))
    else:
        payment_id='pay141_'+uuid.uuid4().hex[:12]
        try:
            c.execute('SAVEPOINT v141_payment_insert')
            c.execute('INSERT INTO payments(id,order_id,provider_payment_id,amount_czk,status,created_at) VALUES(?,?,?,?,?,?)',(payment_id,order_id,pi['provider_intent_id'],locked,'captured',now()))
            c.execute('RELEASE SAVEPOINT v141_payment_insert')
        except Exception:
            try:c.execute('ROLLBACK TO SAVEPOINT v141_payment_insert')
            finally:
                try:c.execute('RELEASE SAVEPOINT v141_payment_insert')
                except Exception:pass
            payment=c.execute('SELECT * FROM payments WHERE order_id=?',(order_id,)).fetchone()
            if not payment: raise
            if round(float(payment['amount_czk']),2)!=locked or str(payment['provider_payment_id'])!=str(pi['provider_intent_id']): raise HTTPException(409,{'code':'CAPTURE_CONFLICT'})
            payment_id=str(payment['id'])
    pair=c.execute("SELECT COALESCE(SUM(CASE WHEN direction='debit' THEN amount_czk ELSE 0 END),0) d, COALESCE(SUM(CASE WHEN direction='credit' THEN amount_czk ELSE 0 END),0) cr FROM finance_ledger_entries WHERE order_id=? AND entry_type='payment_capture_v141'",(order_id,)).fetchone()
    debit=round(float(pair['d'] or 0),2); credit=round(float(pair['cr'] or 0),2)
    if abs(debit-locked)>0.01 or abs(credit-locked)>0.01:
        if debit>0.01 or credit>0.01: raise HTTPException(409,{'code':'PAYMENT_CAPTURE_LEDGER_CONFLICT'})
        ref='cap141_'+uuid.uuid4().hex[:12]
        meta=_v141_json({'payment_intent_id':intent_id,'provider_event_id':provider_event_id,'actor':actor_id})
        c.execute('INSERT INTO finance_ledger_entries VALUES (?,?,?,?,?,?,?,?,?)',('fle141_'+uuid.uuid4().hex[:12],order_id,'payment_capture_v141','customer_receivable','debit',locked,ref,meta,now()))
        c.execute('INSERT INTO finance_ledger_entries VALUES (?,?,?,?,?,?,?,?,?)',('fle141_'+uuid.uuid4().hex[:12],order_id,'payment_capture_v141','payment_clearing','credit',locked,ref,meta,now()))
        debit=credit=locked
    payload={'format':_V141_POLICY['format'],'schema_version':'1.141','order_id':order_id,'payment_intent_id':intent_id,'payment_id':payment_id,'provider_event_id':provider_event_id,'amount_czk':locked,'currency':currency,'ledger_debit_czk':debit,'ledger_credit_czk':credit}
    digest=_v141_hash(payload); fid='fin141_'+uuid.uuid4().hex[:12]
    try:
        c.execute('INSERT INTO payment_capture_finality_v141(id,order_id,payment_intent_id,provider_event_id,payment_id,amount_czk,currency,ledger_debit_czk,ledger_credit_czk,status,finality_sha256,created_at,updated_at) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?)',(fid,order_id,intent_id,provider_event_id,payment_id,locked,currency,debit,credit,'FINAL',digest,now(),now()))
    except Exception:
        existing=c.execute('SELECT * FROM payment_capture_finality_v141 WHERE order_id=?',(order_id,)).fetchone()
        if not existing: raise
        if str(existing['payment_intent_id'])!=intent_id or round(float(existing['amount_czk']),2)!=locked: raise HTTPException(409,{'code':'PAYMENT_FINALITY_CONFLICT'})
        return dict(existing),True
    c.execute('INSERT INTO payment_capture_finality_audit_v141 VALUES (?,?,?,?,?,?,?,?,?)',('fina_'+uuid.uuid4().hex[:12],order_id,intent_id,'FINALIZE_CAPTURE',provider_event_id,'FINAL',locked,_v141_json({'payment_id':payment_id,'ledger_debit_czk':debit,'ledger_credit_czk':credit,'actor':actor_id}),now()))
    return dict(c.execute('SELECT * FROM payment_capture_finality_v141 WHERE id=?',(fid,)).fetchone()),False

@app.get('/api/v141/payment/finality-policy')
def v141_payment_finality_policy(authorization:str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent','customer'}); return _V141_POLICY

@app.post('/api/v141/payment/finalize')
def v141_payment_finalize(body:dict[str,Any],authorization:str|None=Header(default=None),idempotency_key:str|None=Header(default=None,alias='Idempotency-Key')):
    u=current_user(authorization); require_role(u,'customer'); intent_id=str(body.get('payment_intent_id') or '').strip()
    if not intent_id: raise HTTPException(400,'payment_intent_id je povinné')
    with core_db_connect() as c:
        cached=_v052_guard(c,f'payment-finalize-v141:{u["id"]}',idempotency_key,{'payment_intent_id':intent_id})
        if cached is not None: out=dict(cached); out['idempotent_reuse']=True; return out
        pi=_v141_get_intent(c,intent_id,u['customer_id'])
        if str(pi['status'])!='succeeded': raise HTTPException(409,{'code':'PAYMENT_NOT_SUCCEEDED'})
        finality,idem=_v141_capture_finality(c,pi,None,u['id'])
        result={'schema_version':'1.141','payment_intent_id':intent_id,'order_id':pi['order_id'],'payment_id':finality['payment_id'],'status':'captured','finality_id':finality['id'],'amount_czk':float(finality['amount_czk']),'currency':finality['currency'],'ledger_debit_czk':float(finality['ledger_debit_czk']),'ledger_credit_czk':float(finality['ledger_credit_czk']),'idempotent_reuse':idem}
        _v052_store(c,f'payment-finalize-v141:{u["id"]}',idempotency_key,{'payment_intent_id':intent_id},result); c.commit(); return result

@app.post('/api/v141/payment/webhook')
async def v141_payment_webhook(request:Request,x_wunoo_signature:str|None=Header(default=None,alias='X-WUNOO-Signature')):
    raw=await request.body(); _verify_webhook_signature(raw,x_wunoo_signature,required=True)
    try: body=json.loads(raw.decode('utf-8'))
    except Exception: raise HTTPException(400,'Neplatné JSON tělo webhooku')
    event_id=str(body.get('id','')); event_type=str(body.get('type','')); intent_id=str(body.get('payment_intent_id','')); amount=body.get('amount_czk',body.get('amount')); currency=str(body.get('currency','CZK'))
    if not event_id or not event_type or not intent_id: raise HTTPException(400,'Webhook id, type a payment_intent_id jsou povinné')
    if event_type not in {'payment_succeeded','payment_failed','payment_cancelled'}: raise HTTPException(400,'Nepodporovaný payment event')
    with core_db_connect() as c:
        prior=c.execute('SELECT * FROM payment_webhook_events WHERE provider_event_id=?',(event_id,)).fetchone()
        if prior:return {'accepted':True,'duplicate':True,'status':prior['status']}
        pi=_v141_get_intent(c,intent_id); locked=round(float(pi['locked_amount_czk'] if pi['locked_amount_czk'] is not None else pi['amount_czk']),2); cur=str(pi['locked_currency'] or pi['currency'] or 'CZK')
        if amount is not None and round(float(amount),2)!=locked: raise HTTPException(409,{'code':'PAYMENT_AMOUNT_MISMATCH','expected_amount_czk':locked,'received_amount_czk':float(amount)})
        if currency!=cur: raise HTTPException(409,{'code':'PAYMENT_CURRENCY_MISMATCH','expected_currency':cur,'received_currency':currency})
        if pi['quote_id']:
            q=c.execute('SELECT total_czk FROM checkout_quotes WHERE id=?',(pi['quote_id'],)).fetchone()
            if not q or round(float(q['total_czk']),2)!=locked: raise HTTPException(409,{'code':'PAYMENT_QUOTE_MISMATCH'})
        wid='pwh141_'+uuid.uuid4().hex[:12]
        c.execute('INSERT INTO payment_webhook_events(id,provider_event_id,event_type,payload_json,status,processed_at,created_at) VALUES(?,?,?,?,?,?,?)',(wid,event_id,event_type,_v141_json(body),'received',None,now()))
        if event_type=='payment_succeeded':
            c.execute('UPDATE payment_intents SET status=\'succeeded\',updated_at=? WHERE id=?',(now(),intent_id))
            actor='system:payment_webhook_v141'
            finality,idem=_v141_capture_finality(c,pi,event_id,actor)
            if pi['order_id']:
                try: transition(c,pi['order_id'],'payment_pending','merchant_pending',{'id':actor},'payment_succeeded_v141',{'payment_intent_id':intent_id,'locked_amount_czk':locked})
                except HTTPException: pass
            c.execute('UPDATE payment_webhook_events SET status=?,processed_at=? WHERE id=?',('processed',now(),wid)); emit(c,pi['order_id'],'payment_finality_reached',{'payment_intent_id':intent_id,'payment_id':finality['payment_id'],'finality_id':finality['id'],'amount_czk':locked,'ledger_balanced':abs(float(finality['ledger_debit_czk'])-float(finality['ledger_credit_czk']))<=0.01},actor); c.commit()
            return {'accepted':True,'duplicate':False,'event_type':event_type,'payment_intent_id':intent_id,'payment_id':finality['payment_id'],'finality_id':finality['id'],'amount_czk':locked,'currency':cur,'idempotent_finality':idem}
        if str(pi['status'])=='succeeded': c.execute('UPDATE payment_webhook_events SET status=?,processed_at=? WHERE id=?',('ignored',now(),wid)); c.commit(); return {'accepted':True,'duplicate':False,'ignored':True,'reason':'ALREADY_SUCCEEDED'}
        terminal='failed' if event_type=='payment_failed' else 'cancelled'; c.execute('UPDATE payment_intents SET status=?,updated_at=? WHERE id=?',(terminal,now(),intent_id)); c.execute('UPDATE payment_webhook_events SET status=?,processed_at=? WHERE id=?',('processed',now(),wid)); c.commit(); return {'accepted':True,'duplicate':False,'event_type':event_type,'payment_intent_id':intent_id,'status':terminal}

@app.get('/api/v141/payment/finality/{payment_intent_id}')
def v141_payment_finality_get(payment_intent_id:str,authorization:str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'customer','admin','ops_agent','merchant'})
    with core_db_connect() as c:
        row=c.execute('SELECT f.*,o.customer_id,o.merchant_id FROM payment_capture_finality_v141 f JOIN orders o ON o.id=f.order_id WHERE f.payment_intent_id=?',(payment_intent_id,)).fetchone()
        if not row: raise HTTPException(404,'Payment finality nenalezena')
        if u['role']=='customer' and row['customer_id']!=u['customer_id']: raise HTTPException(403,'forbidden')
        if u['role']=='merchant' and row['merchant_id']!=u.get('merchant_id'): raise HTTPException(403,'forbidden')
        return {'schema_version':'1.141','finality':dict(row)}
@app.get("/api/v141/ops/request-layer-status")
def v141_request_layer_status(authorization: str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    scan=_v135_request_layer_scan(); sqlite_scan=_v141_sqlite_specific_request_scan()
    with core_db_connect() as c:
        row=c.execute("SELECT COUNT(*) n FROM v141_request_layer_cutover").fetchone()
    return {"version":"1.41","direct_conn_request_functions":scan["direct_conn_request_functions"],
            "remaining_direct_conn_request_functions":scan["remaining_request_functions"],
            "sqlite_specific_request_functions":sqlite_scan["count"],
            "sqlite_specific_routes":sqlite_scan["routes"],
            "cutover_complete":scan["remaining_request_functions"]==0 and sqlite_scan["count"]==0,
            "audit_records":int(row["n"])}


# ---------------- v1.42 Finance Reconciliation Finality ----------------
def migrate_v142(c):
    c.execute("""CREATE TABLE IF NOT EXISTS v142_finance_reconciliation_finality(
        id TEXT PRIMARY KEY, order_id TEXT NOT NULL UNIQUE, payment_intent_id TEXT, payment_id TEXT,
        captured_czk REAL NOT NULL DEFAULT 0, refunded_czk REAL NOT NULL DEFAULT 0, settlement_czk REAL NOT NULL DEFAULT 0,
        ledger_debit_czk REAL NOT NULL DEFAULT 0, ledger_credit_czk REAL NOT NULL DEFAULT 0, variance_czk REAL NOT NULL DEFAULT 0,
        status TEXT NOT NULL, finality_sha256 TEXT NOT NULL UNIQUE, source_version TEXT NOT NULL,
        created_at TEXT NOT NULL, updated_at TEXT NOT NULL
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_v142_fin_recon_status ON v142_finance_reconciliation_finality(status,created_at DESC)")
    c.execute("""CREATE TABLE IF NOT EXISTS v142_finance_reconciliation_audit(
        id TEXT PRIMARY KEY, order_id TEXT NOT NULL, action TEXT NOT NULL, status TEXT NOT NULL,
        variance_czk REAL NOT NULL DEFAULT 0, details_json TEXT, created_at TEXT NOT NULL
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_v142_fin_recon_audit_order ON v142_finance_reconciliation_audit(order_id,created_at DESC)")
    c.commit()

_V142_FINANCE_POLICY={
    'schema_version':'1.42','format':'wunoo.release.finance.reconciliation.finality.v1',
    'zero_variance_required':True,'ledger_must_balance':True,'payment_equals_capture':True,
    'refund_bounded':True,'settlement_equals_net_payment':True,
}

def _v142_fin_hash(payload):
    return hashlib.sha256(json.dumps(payload,sort_keys=True,separators=(",",":"),ensure_ascii=False).encode()).hexdigest()

def _v142_fin_snapshot(c, order_id):
    o=c.execute("SELECT * FROM orders WHERE id=?",(order_id,)).fetchone()
    if not o: raise HTTPException(404,'Objednávka nenalezena')
    payment=c.execute("SELECT * FROM payments WHERE order_id=? ORDER BY created_at DESC LIMIT 1",(order_id,)).fetchone()
    captured=round(float(payment['amount_czk']) if payment and payment['status'] in {'captured','refunded'} else 0.0,2)
    refunded=round(float(c.execute("SELECT COALESCE(SUM(amount_czk),0) n FROM refunds WHERE order_id=? AND status IN ('pending','processed','succeeded')",(order_id,)).fetchone()['n'] or 0),2)
    sr=c.execute("SELECT * FROM settlement_runs WHERE order_id=?",(order_id,)).fetchone()
    legacy=c.execute("SELECT * FROM settlements WHERE order_id=?",(order_id,)).fetchone()
    if sr: settlement=round(float(sr['gross_czk']),2); settlement_id=sr['id']
    elif legacy: settlement=round(float(o['total_czk']),2); settlement_id=legacy['id']
    else: settlement=0.0; settlement_id=None
    led=c.execute("SELECT COALESCE(SUM(CASE WHEN direction='debit' THEN amount_czk ELSE 0 END),0) d, COALESCE(SUM(CASE WHEN direction='credit' THEN amount_czk ELSE 0 END),0) cr FROM finance_ledger_entries WHERE order_id=?",(order_id,)).fetchone()
    debit=round(float(led['d'] or 0),2); credit=round(float(led['cr'] or 0),2)
    net=round(captured-refunded,2)
    payment_match=bool(payment) and abs(captured-round(float(o['total_czk']),2))<=0.01
    ledger_balanced=abs(debit-credit)<=0.01
    settlement_match=(abs(settlement-net)<=0.01) if settlement_id else (o['status'] not in {'delivered','merchant_pending'})
    variance=round(max(abs(captured-float(o['total_czk'])) if payment else 0.0,abs(debit-credit),abs(settlement-net) if settlement_id else 0.0),2)
    exceptions=[]
    if refunded>captured+0.01: exceptions.append('REFUND_OVER_CAPTURED')
    if payment and not payment_match: exceptions.append('PAYMENT_TOTAL_MISMATCH')
    if not ledger_balanced: exceptions.append('LEDGER_UNBALANCED')
    if settlement_id and not settlement_match: exceptions.append('SETTLEMENT_NET_MISMATCH')
    if o['status']=='delivered' and not settlement_id: exceptions.append('DELIVERED_WITHOUT_SETTLEMENT')
    final_eligible = (not exceptions) and settlement_id is not None
    status='FINAL' if final_eligible else ('PENDING_SETTLEMENT' if not exceptions else 'EXCEPTION')
    return {'order':dict(o),'payment':dict(payment) if payment else None,'captured_czk':captured,'refunded_czk':refunded,'net_paid_czk':net,'settlement_czk':settlement,'settlement_id':settlement_id,'ledger_debit_czk':debit,'ledger_credit_czk':credit,'ledger_balanced':ledger_balanced,'variance_czk':variance,'exceptions':exceptions,'status':status}

def _v142_fin_store(c,snap):
    payload={'order_id':snap['order']['id'],'payment_id':snap['payment']['id'] if snap['payment'] else None,'captured_czk':snap['captured_czk'],'refunded_czk':snap['refunded_czk'],'net_paid_czk':snap['net_paid_czk'],'settlement_czk':snap['settlement_czk'],'settlement_id':snap['settlement_id'],'ledger_debit_czk':snap['ledger_debit_czk'],'ledger_credit_czk':snap['ledger_credit_czk'],'variance_czk':snap['variance_czk'],'status':snap['status']}
    digest=_v142_fin_hash(payload)
    existing=c.execute("SELECT * FROM v142_finance_reconciliation_finality WHERE order_id=?",(snap['order']['id'],)).fetchone()
    if existing and existing['status']=='FINAL' and str(existing['finality_sha256'])!=digest:
        raise HTTPException(409,{'code':'FINANCE_FINALITY_CONFLICT'})
    if existing:
        fid=existing['id']
        c.execute("UPDATE v142_finance_reconciliation_finality SET captured_czk=?,refunded_czk=?,settlement_czk=?,ledger_debit_czk=?,ledger_credit_czk=?,variance_czk=?,status=?,updated_at=? WHERE order_id=?",(snap['captured_czk'],snap['refunded_czk'],snap['settlement_czk'],snap['ledger_debit_czk'],snap['ledger_credit_czk'],snap['variance_czk'],snap['status'],now(),snap['order']['id']))
    else:
        fid='fin142_'+uuid.uuid4().hex[:12]
        payment_intent_id=None
        if snap['payment']:
            pi=c.execute("SELECT id FROM payment_intents WHERE order_id=? ORDER BY created_at DESC LIMIT 1",(snap['order']['id'],)).fetchone(); payment_intent_id=pi['id'] if pi else None
        c.execute("INSERT INTO v142_finance_reconciliation_finality(id,order_id,payment_intent_id,payment_id,captured_czk,refunded_czk,settlement_czk,ledger_debit_czk,ledger_credit_czk,variance_czk,status,finality_sha256,source_version,created_at,updated_at) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)",(fid,snap['order']['id'],payment_intent_id,payload['payment_id'],snap['captured_czk'],snap['refunded_czk'],snap['settlement_czk'],snap['ledger_debit_czk'],snap['ledger_credit_czk'],snap['variance_czk'],snap['status'],digest,'v1.42-finance-finality',now(),now()))
    c.execute("INSERT INTO v142_finance_reconciliation_audit VALUES (?,?,?,?,?,?,?)",('fina142_'+uuid.uuid4().hex[:12],snap['order']['id'],'RECONCILE',snap['status'],snap['variance_czk'],json.dumps({'exceptions':snap['exceptions'],'settlement_id':snap['settlement_id']},ensure_ascii=False),now()))
    return dict(c.execute("SELECT * FROM v142_finance_reconciliation_finality WHERE order_id=?",(snap['order']['id'],)).fetchone())

@app.post('/api/v142/finance/reconcile-finality/{order_id}')
def v142_finance_reconcile_finality(order_id:str, authorization:str|None=Header(default=None), idempotency_key:str|None=Header(default=None,alias='Idempotency-Key')):
    u=current_user(authorization); require_role(u,{'admin','ops_agent','merchant'})
    if not idempotency_key or len(idempotency_key)>120: raise HTTPException(400,'Idempotency-Key je povinný')
    with core_db_connect() as c:
        o=c.execute('SELECT * FROM orders WHERE id=?',(order_id,)).fetchone()
        if not o: raise HTTPException(404,'Objednávka nenalezena')
        if u['role']=='merchant' and o['merchant_id']!=u.get('merchant_id'): raise HTTPException(403,'forbidden')
        payload={'order_id':order_id,'action':'reconcile-finality'}; scope=f'v142:finance-finality:{u["id"]}:{order_id}'
        cached=_v118_cached_command(c,scope,idempotency_key,payload)
        if cached is not None:return cached
        snap=_v142_fin_snapshot(c,order_id); row=_v142_fin_store(c,snap)
        result={'schema_version':'1.42','order_id':order_id,'status':snap['status'],'finality_id':row['id'],'finality_sha256':row['finality_sha256'],'captured_czk':snap['captured_czk'],'refunded_czk':snap['refunded_czk'],'net_paid_czk':snap['net_paid_czk'],'settlement_czk':snap['settlement_czk'],'ledger_debit_czk':snap['ledger_debit_czk'],'ledger_credit_czk':snap['ledger_credit_czk'],'variance_czk':snap['variance_czk'],'exceptions':snap['exceptions']}
        _v118_store_command(c,scope,idempotency_key,payload,'reconcile-finality',result); c.commit(); return result

@app.get('/api/v142/finance/finality/{order_id}')
def v142_finance_finality_get(order_id:str, authorization:str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent','merchant'})
    with core_db_connect() as c:
        o=c.execute('SELECT * FROM orders WHERE id=?',(order_id,)).fetchone()
        if not o: raise HTTPException(404,'Objednávka nenalezena')
        if u['role']=='merchant' and o['merchant_id']!=u.get('merchant_id'): raise HTTPException(403,'forbidden')
        row=c.execute('SELECT * FROM v142_finance_reconciliation_finality WHERE order_id=?',(order_id,)).fetchone()
        if not row: raise HTTPException(404,'Finance finality nenalezena')
        audit=c.execute('SELECT * FROM v142_finance_reconciliation_audit WHERE order_id=? ORDER BY created_at DESC LIMIT 50',(order_id,)).fetchall()
        return {'schema_version':'1.42','finality':dict(row),'audit':[dict(x) for x in audit]}

@app.get('/api/v142/finance/policy')
def v142_finance_policy(authorization:str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent','merchant'})
    return _V142_FINANCE_POLICY

# ---------------- v1.42 PostgreSQL production cutover gate ----------------
_V142_REQUIRED_TABLES = (
    "customers","merchants","couriers","users","customer_addresses",
    "menu_categories","menu_items","cart_items","orders","order_items",
    "payments","settlement_runs","settlements","finance_ledger_entries",
    "refunds","courier_offers","courier_locations","notifications",
    "notification_preferences","notification_events","refresh_sessions",
    "sessions","security_events","events","schema_migrations",
)

def _v142_pg_schema_gate() -> dict[str, Any]:
    dsn = os.getenv("WUNOO_DATABASE_URL") or os.getenv("DATABASE_URL")
    if not dsn:
        return {"reachable":False,"reason":"POSTGRES_DSN_MISSING","missing_tables":list(_V142_REQUIRED_TABLES)}
    try:
        import psycopg
    except ImportError:
        return {"reachable":False,"reason":"POSTGRES_DRIVER_MISSING","missing_tables":list(_V142_REQUIRED_TABLES)}
    try:
        with psycopg.connect(dsn) as pg:
            with pg.cursor() as cur:
                cur.execute("SELECT version(), current_setting('transaction_isolation'), current_database()")
                info=cur.fetchone()
                cur.execute("SELECT table_name FROM information_schema.tables WHERE table_schema='public'")
                present={r[0] for r in cur.fetchall()}
                cur.execute("SELECT version,status FROM schema_migrations ORDER BY version")
                migrations=[{"version":r[0],"status":r[1]} for r in cur.fetchall()]
        missing=[t for t in _V142_REQUIRED_TABLES if t not in present]
        return {"reachable":True,"missing_tables":missing,"schema_complete":not missing,"database":info[2],"transaction_isolation":info[1],"server_version":info[0],"migrations":migrations}
    except Exception as exc:
        return {"reachable":False,"reason":"POSTGRES_SCHEMA_CHECK_FAILED","error":str(exc)[:300],"missing_tables":list(_V142_REQUIRED_TABLES)}

@app.get('/api/v142/ops/postgresql-gate')
def v142_postgresql_gate(authorization: str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    backend=configured_db_backend(); env=os.getenv('WUNOO_ENV','development').strip().lower()
    dsn=bool(os.getenv('WUNOO_DATABASE_URL') or os.getenv('DATABASE_URL'))
    driver=_v130_has('psycopg'); pool=_v130_has('psycopg_pool')
    request_scan=_v135_request_layer_scan(); sqlite_scan=_v141_sqlite_specific_request_scan()
    schema=_v142_pg_schema_gate() if backend=='postgresql' else {"reachable":False,"reason":"NOT_POSTGRES"}
    ready=bool(backend=='postgresql' and dsn and driver and pool and request_scan['remaining_request_functions']==0 and sqlite_scan['count']==0 and schema.get('reachable') and schema.get('schema_complete'))
    return {"schema_version":"1.42","gate":"postgresql_production_cutover","environment":env,"configured_backend":backend,"ready_for_live_cutover":ready,"checks":{"dsn_configured":dsn,"postgres_driver_installed":driver,"postgres_pool_installed":pool,"request_layer_clean":request_scan['remaining_request_functions']==0,"sqlite_specific_request_layer_clean":sqlite_scan['count']==0,"schema_complete":schema.get('schema_complete',False),"database_reachable":schema.get('reachable',False)},"schema":schema,"next_gate":"live multi-process PostgreSQL concurrency and financial integrity test"}

@app.get('/api/v142/ops/postgresql-schema')
def v142_postgresql_schema(authorization: str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
