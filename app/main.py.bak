@app.get("/api/v094/ops/security/dashboard")
def v094_security_dashboard(authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    with core_db_connect() as c:
        snapshot=security_dashboard_snapshot(c,3600)
        alerts=[dict(x) for x in c.execute("SELECT * FROM security_alerts WHERE status='open' ORDER BY created_at DESC LIMIT 50").fetchall()]
        chain_rows=c.execute("SELECT id,event_hash,prev_hash FROM security_audit_events ORDER BY created_at,id").fetchall()
    valid=True; previous=None
    for row in chain_rows:
        if row["prev_hash"]!=previous: valid=False; break
        previous=row["event_hash"]
    counts={x["event_type"]:x["n"] for x in snapshot["event_counts"]}
    return {"window":"last_60_minutes","counts":counts,
            "top_paths":snapshot["top_paths"],"open_alerts":alerts,
            "audit_chain_valid":valid,
            "health":"ALERT" if alerts or not valid else "HEALTHY"}

@app.post("/api/v094/ops/security/dashboard/evaluate")
def v094_security_dashboard_evaluate(authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    with core_db_connect() as c:
        snap=security_dashboard_snapshot(c,3600)
        counts={x["event_type"]:int(x["n"]) for x in snap["event_counts"]}
        rules=[("critical_429_spike","http.429",50,"high"),
               ("critical_403_spike","http.403",100,"medium"),
               ("server_error_spike","http.5xx",20,"critical"),
               ("auth_failure_spike","http.401",50,"high")]
        created=[]
        for key,event_type,threshold,severity in rules:
            observed=counts.get(event_type,0)
            if observed>=threshold:
                alert_key=f"{key}:{now()[:13].replace('-', '').replace(':', '').replace('T', '')}"
                c.execute("""INSERT INTO security_alerts
                    (id,alert_key,severity,alert_type,status,threshold_value,observed_value,window_seconds,details_json,created_at)
                    VALUES (?,?,?,?,?,?,?,?,?,?) ON CONFLICT(alert_key) DO NOTHING""",
                    ("sal_"+uuid.uuid4().hex[:12],alert_key,severity,key,"open",threshold,observed,3600,
                     json.dumps({"event_type":event_type}),now()))
                created.append({"alert_type":key,"severity":severity,"observed":observed,"threshold":threshold})
        c.commit()
    return {"evaluated":True,"created_or_opened":created}

