    if payload.get('format')!='wunoo.release.certificate.v1': return {'valid':False,'reason':'CERTIFICATE_FORMAT_INVALID'}
    pub_b64=str(cert.get('signer_public_key_b64') or '')
    sig_b64=str(cert.get('certificate_signature_b64') or '')
    try:
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto()
        pub=base64.b64decode(pub_b64,validate=True); sig=base64.b64decode(sig_b64,validate=True)
        Ed25519PublicKey.from_public_bytes(pub).verify(sig,json.dumps(payload,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode())
        key_id=_v169_key_id(pub)
