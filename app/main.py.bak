@app.post("/api/orders/{order_id}/dispatch")
def dispatch(order_id: str, authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u = current_user(authorization); require_role(u, "courier", "admin")
    with core_db_connect() as c:
        o = c.execute("SELECT * FROM orders WHERE id=?", (order_id,)).fetchone()
        if not o or o["status"] != "dispatch_pending":
            raise HTTPException(409, "Objednávka není připravena k dispatchi")
        candidates = courier_candidates(c, o)
        if u["role"] == "courier":
            candidate = next((x for x in candidates if x["courier_id"] == u["courier_id"]), None)
        else:
            candidate = candidates[0] if candidates else None
        if not candidate:
            raise HTTPException(409, "Žádný oprávněný online kurýr")
        # Atomic guard against two workers assigning the same order.
        from datetime import timedelta
        ts = now()
        eta_min = int(candidate["pickup_eta_minutes"])
        predicted_pickup = (datetime.now(timezone.utc) + timedelta(minutes=eta_min)).isoformat()
        predicted_delivery = (datetime.now(timezone.utc) + timedelta(minutes=eta_min + 30)).isoformat()
        updated = c.execute(
            "UPDATE orders SET courier_id=?, status='assigned', assigned_at=?, predicted_pickup_at=?, predicted_delivery_at=?, updated_at=? WHERE id=? AND status='dispatch_pending'",
            (candidate["courier_id"], ts, predicted_pickup, predicted_delivery, ts, order_id),
        ).rowcount
        if updated != 1:
            raise HTTPException(409, "Objednávku právě přiřadil jiný dispatch worker")
        emit(c, order_id, "courier_assigned", {
            "courier_id": candidate["courier_id"],
            "algorithm_version": "v0.12",
            "rank": candidate["rank"],
            "pickup_eta_minutes": candidate["pickup_eta_minutes"],
            "distance_km": candidate["distance_km"],
            "dispatch_score": candidate["dispatch_score"]
        }, u["id"])
        c.commit()
        return {"order_id": order_id, "courier_id": candidate["courier_id"], "candidate": candidate, "status": "assigned"}


@app.post("/api/orders/{order_id}/dispatch-offer")
def create_dispatch_offer(order_id: str, authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u = current_user(authorization); require_role(u, "admin", "ops_agent", "courier")
    from datetime import timedelta
    with core_db_connect() as c:
        o = c.execute("SELECT * FROM orders WHERE id=?", (order_id,)).fetchone()
        if not o or o["status"] != "dispatch_pending":
            raise HTTPException(409, "Objednávka není připravena k dispatchi")
        candidates = courier_candidates(c, o)
        if u["role"] == "courier":
            candidates = [x for x in candidates if x["courier_id"] == u["courier_id"]]
        if not candidates:
            raise HTTPException(409, "Žádný oprávněný online kurýr")
        # Do not re-offer a courier who already has a pending offer for this order.
        existing = {r["courier_id"] for r in c.execute("SELECT courier_id FROM courier_offers WHERE order_id=? AND status='offered'", (order_id,)).fetchall()}
        candidate = next((x for x in candidates if x["courier_id"] not in existing), None)
        if not candidate:
            raise HTTPException(409, "Všichni vhodní kurýři již mají nabídku")
        offered_at = now()
        predicted_delivery = (datetime.now(timezone.utc) + timedelta(minutes=int(candidate["pickup_eta_minutes"])+30)).isoformat()
        oid = "off_" + uuid.uuid4().hex[:10]
        c.execute(
            "INSERT INTO courier_offers(id,order_id,courier_id,algorithm_version,rank,distance_km,pickup_eta_minutes,predicted_delivery_at,status,offered_at) VALUES (?,?,?,?,?,?,?,?,?,?)",
            (oid, order_id, candidate["courier_id"], "v0.12", candidate["rank"], candidate["distance_km"], candidate["pickup_eta_minutes"], predicted_delivery, "offered", offered_at),
        )
        emit(c, order_id, "courier_offer_created", {"offer_id": oid, "courier_id": candidate["courier_id"], "rank": candidate["rank"], "dispatch_score": candidate["dispatch_score"], "pickup_eta_minutes": candidate["pickup_eta_minutes"]}, u["id"])
        c.commit()
        return {"offer_id": oid, "order_id": order_id, "courier_id": candidate["courier_id"], "status": "offered", "expires_after_seconds": 20, "candidate": candidate}


@app.get("/api/courier/offers")
def courier_offers(authorization: str | None = Header(default=None)) -> list[dict[str, Any]]:
    u = current_user(authorization); require_role(u, "courier")
    with core_db_connect() as c:
        rows = c.execute("""
            SELECT co.*, m.name merchant_name, o.address, o.total_czk
            FROM courier_offers co JOIN orders o ON o.id=co.order_id JOIN merchants m ON m.id=o.merchant_id
            WHERE co.courier_id=? AND co.status='offered' ORDER BY co.offered_at DESC
        """, (u["courier_id"],)).fetchall()
        return [dict(r) for r in rows]


@app.post("/api/courier/offers/{offer_id}/respond")
def respond_to_offer(offer_id: str, response: str, authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u = current_user(authorization); require_role(u, "courier")
    if response not in {"accept", "decline"}:
        raise HTTPException(400, "response musí být accept nebo decline")
    with core_db_connect() as c:
        offer = c.execute("SELECT * FROM courier_offers WHERE id=?", (offer_id,)).fetchone()
        if not offer or offer["courier_id"] != u["courier_id"]:
            raise HTTPException(404, "Nabídka nenalezena")
        if offer["status"] != "offered":
            raise HTTPException(409, "Nabídka již byla vyřešena")
        age = (datetime.now(timezone.utc) - datetime.fromisoformat(offer["offered_at"].replace("Z", "+00:00"))).total_seconds()
        if age > 20:
            c.execute("UPDATE courier_offers SET status='expired', responded_at=?, response_reason=? WHERE id=?", (now(), "timeout", offer_id))
            emit(c, offer["order_id"], "courier_offer_expired", {"offer_id": offer_id, "courier_id": u["courier_id"]}, u["id"])
            c.commit()
            raise HTTPException(409, "Nabídka vypršela")
        if response == "decline":
            c.execute("UPDATE courier_offers SET status='declined', responded_at=?, response_reason=? WHERE id=?", (now(), "courier_declined", offer_id))
            emit(c, offer["order_id"], "courier_offer_declined", {"offer_id": offer_id, "courier_id": u["courier_id"]}, u["id"])
            c.commit()
            return {"offer_id": offer_id, "status": "declined"}
        # Accept with atomic order-state guard.
        ts = now()
        updated = c.execute("UPDATE orders SET courier_id=?, status='assigned', assigned_at=?, predicted_pickup_at=?, predicted_delivery_at=?, updated_at=? WHERE id=? AND status='dispatch_pending'", (u["courier_id"], ts, ts, offer["predicted_delivery_at"], ts, offer["order_id"])).rowcount
        if updated != 1:
            c.execute("UPDATE courier_offers SET status='lost', responded_at=?, response_reason=? WHERE id=?", (ts, "order_already_assigned", offer_id))
            c.commit()
            raise HTTPException(409, "Objednávku již převzal jiný kurýr")
        c.execute("UPDATE courier_offers SET status='accepted', responded_at=?, response_reason=? WHERE id=?", (ts, "courier_accepted", offer_id))
        c.execute("UPDATE courier_offers SET status='lost', responded_at=?, response_reason=? WHERE order_id=? AND id<>? AND status='offered'", (ts, "another_offer_accepted", offer["order_id"], offer_id))
        emit(c, offer["order_id"], "courier_assigned", {"courier_id": u["courier_id"], "algorithm_version": offer["algorithm_version"], "offer_id": offer_id, "pickup_eta_minutes": offer["pickup_eta_minutes"], "dispatch_score": None}, u["id"])
        c.commit()
        return {"offer_id": offer_id, "order_id": offer["order_id"], "courier_id": u["courier_id"], "status": "accepted"}


@app.post("/api/orders/{order_id}/pickup")
def pickup(order_id: str, authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u = current_user(authorization); require_role(u, "courier", "admin")
    with core_db_connect() as c:
        o = c.execute("SELECT * FROM orders WHERE id=?", (order_id,)).fetchone()
        if not o or (u["role"] == "courier" and o["courier_id"] != u["courier_id"]):
            raise HTTPException(403, "Objednávka není dostupná")
        ts = now()
        c.execute("UPDATE orders SET picked_up_at=?, updated_at=? WHERE id=?", (ts, ts, order_id))
        transition(c, order_id, "assigned", "picked_up", u, "pickup_completed", {"courier_id": o["courier_id"]})
        c.commit()
        return {"order_id": order_id, "status": "picked_up"}


@app.post("/api/orders/{order_id}/start-delivery")
def start_delivery(order_id: str, authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u = current_user(authorization); require_role(u, "courier", "admin")
