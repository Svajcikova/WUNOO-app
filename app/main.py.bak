        if not cp:raise HTTPException(404,'GLOBAL_CHECKPOINT_NOT_FOUND')
        q=_v183_quorum(p.get('quorum_required'));existing=_v170_row(c,'production_global_evidence_checkpoint_finality',' WHERE checkpoint_id=? AND quorum_required=?',(cp['id'],q),'created_at DESC')
