@app.get("/api/courier/active-route")
def v20_courier_active_route(authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u = current_user(authorization); require_role(u, "courier")
    with core_db_connect() as c:
        order = c.execute("SELECT * FROM orders WHERE courier_id=? AND status IN ('assigned','picked_up','out_for_delivery','delayed') ORDER BY updated_at DESC LIMIT 1", (u["courier_id"],)).fetchone()
        if not order: return {"active": False}
        loc = c.execute("SELECT * FROM courier_locations WHERE courier_id=? ORDER BY recorded_at DESC LIMIT 1", (u["courier_id"],)).fetchone()
