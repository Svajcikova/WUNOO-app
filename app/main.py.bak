@app.post("/api/v060/merchant/orders/{order_id}/action")
def v060_merchant_action(order_id:str, body:dict[str,Any], authorization:str|None=Header(default=None), idempotency_key:str|None=Header(default=None,alias="Idempotency-Key"))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"merchant","admin","ops_agent"})
    action=str(body.get("action","")).strip()
    transitions={
        "accept":("confirmed","preparing"),
        "reject":("confirmed","merchant_rejected"),
        "ready":("preparing","ready_for_pickup"),
    }
    if action not in transitions: raise HTTPException(400,"Neplatná merchant akce")
    with core_db_connect() as c:
        o=c.execute("SELECT * FROM orders WHERE id=?",(order_id,)).fetchone()
        if not o: raise HTTPException(404,"Objednávka nenalezena")
        if u["role"]=="merchant" and o["merchant_id"]!=u.get("merchant_id"): raise HTTPException(403,"forbidden")
        cached=_v052_guard(c,f"merchant-action:{u['id']}",idempotency_key,{"order_id":order_id,"action":action})
        if cached is not None:return cached
        expected,new_status=transitions[action]
        atomic_transition_any(c, order_id, (expected,), new_status, u, f"merchant_{action}", {"from": expected, "to": new_status})
        c.execute("INSERT INTO merchant_order_actions VALUES (?,?,?,?,?,?,?)",
                  ("moa_"+uuid.uuid4().hex[:12],order_id,o["merchant_id"],action,u["id"],
                   json.dumps(body.get("metadata") or {},ensure_ascii=False),now()))
        emit(c,order_id,f"merchant_{action}",{"from":expected,"to":new_status},u["id"])
        result={"order_id":order_id,"action":action,"status":new_status}
        _v052_store(c,f"merchant-action:{u['id']}",idempotency_key,{"order_id":order_id,"action":action},result)
        _v052_audit(c,u["id"],f"merchant_{action}","order",order_id,{"from":expected,"to":new_status})
        if action=="accept":
            _v053_enqueue(c,"notifications","notification.process",{"order_id":order_id,"event":"merchant_accept"})
        elif action=="ready":
            _v053_enqueue(c,"dispatch","notification.process",{"order_id":order_id,"event":"ready_for_pickup"})
        c.commit()
        return result

@app.get("/api/v060/merchant/orders/{order_id}")
