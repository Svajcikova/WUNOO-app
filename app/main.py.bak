    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    with core_db_connect() as c:
        migrate_v097(c); rows,total=prometheus_metrics(c)
    lines=["# HELP wunoo_http_requests_total HTTP requests observed in the last hour",
           "# TYPE wunoo_http_requests_total counter"]
    for r in rows: lines.append(f'wunoo_http_requests_total{{status="{r["status_code"]}"}} {int(r["n"])}')
    lines += ["# HELP wunoo_http_requests_window_total Total HTTP requests observed in the last hour",
              "# TYPE wunoo_http_requests_window_total gauge",f"wunoo_http_requests_window_total {total}"]
    return PlainTextResponse("\n".join(lines)+"\n",media_type="text/plain; version=0.0.4")

