        if int(payload.get('sequence_no',-1))<last_seq or int(payload.get('entries_count',-1))!=int(r['entries_count']) or int(payload.get('sequence_no',-1))!=int(r['sequence_no']) or payload.get('head_sha256')!=r['head_sha256']:
            return {'valid':False,'reason':'CHECKPOINT_BINDING_INVALID','checkpoint_no':expected}
        try: _,Ed25519PublicKey,_,_,_,_=_v169_crypto(); Ed25519PublicKey.from_public_bytes(base64.b64decode(r['public_key_b64'])).verify(base64.b64decode(r['signature_b64']),json.dumps(payload,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode())
