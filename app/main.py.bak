    c.commit()

def _v051_require_idempotency(c, scope, idem_key, request_hash, user_id=None):
    if not idem_key or len(idem_key)>120:
        raise HTTPException(400,"Idempotency-Key je povinný")
    existing=c.execute("SELECT * FROM api_idempotency_keys WHERE scope=? AND idem_key=?",(scope,idem_key)).fetchone()
    if existing:
        if existing["request_hash"]!=request_hash:
            raise HTTPException(409,"Idempotency-Key byl použit pro jiný request")
        return existing
    return None

def _v051_store_idempotency(c, scope, idem_key, request_hash, response, status_code=200, user_id=None):
    iid="idem_"+uuid.uuid4().hex[:12]
    c.execute("""INSERT INTO api_idempotency_keys
                 (id,user_id,scope,idem_key,request_hash,response_json,status_code,created_at)
                 VALUES (?,?,?,?,?,?,?,?)""",
              (iid,user_id,scope,idem_key,request_hash,json.dumps(response,ensure_ascii=False),status_code,now()))
    return iid

def _v051_rate_limit(c, bucket_key, limit=60, window_seconds=60):
    import time
    current=int(time.time())
    row=c.execute("SELECT * FROM api_rate_buckets WHERE bucket_key=?",(bucket_key,)).fetchone()
    if not row or current-int(row["window_start"])>=window_seconds:
        c.execute("INSERT OR REPLACE INTO api_rate_buckets VALUES (?,?,?)",(bucket_key,current,1))
        return
    count=int(row["request_count"])+1
    if count>limit:
        raise HTTPException(429,"Rate limit exceeded")
    c.execute("UPDATE api_rate_buckets SET request_count=? WHERE bucket_key=?",(count,bucket_key))



def migrate_v052(c):
    c.execute("""CREATE TABLE IF NOT EXISTS mutation_idempotency(
        id TEXT PRIMARY KEY,
        scope TEXT NOT NULL,
        idem_key TEXT NOT NULL,
        request_hash TEXT NOT NULL,
        response_json TEXT NOT NULL,
        status_code INTEGER NOT NULL DEFAULT 200,
        created_at TEXT NOT NULL,
        UNIQUE(scope,idem_key)
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_mutation_idem_created ON mutation_idempotency(created_at)")
    c.commit()

def _v052_guard(c, scope, idem_key, request_payload):
    if not idem_key or len(idem_key)>120:
        raise HTTPException(400,"Idempotency-Key je povinný")
    raw=json.dumps(request_payload or {},sort_keys=True,ensure_ascii=False)
    rh=hashlib.sha256(raw.encode()).hexdigest()
    row=c.execute("SELECT * FROM mutation_idempotency WHERE scope=? AND idem_key=?",(scope,idem_key)).fetchone()
    if row:
        if row["request_hash"]!=rh:
            raise HTTPException(409,"Idempotency-Key použit pro jiný request")
        return json.loads(row["response_json"])
    return None

def _v052_store(c, scope, idem_key, request_payload, response, status_code=200):
    raw=json.dumps(request_payload or {},sort_keys=True,ensure_ascii=False)
    rh=hashlib.sha256(raw.encode()).hexdigest()
    iid="mid_"+uuid.uuid4().hex[:12]
    c.execute("""INSERT INTO mutation_idempotency
                 (id,scope,idem_key,request_hash,response_json,status_code,created_at)
                 VALUES (?,?,?,?,?,?,?)""",
              (iid,scope,idem_key,rh,json.dumps(response,ensure_ascii=False),status_code,now()))

def _v052_audit(c,user_id,action,entity_type,entity_id,meta=None):
    try:
        c.execute("INSERT INTO ops_audit_log VALUES (?,?,?,?,?,?,?)",
                  ("audit_"+uuid.uuid4().hex[:10],user_id,action,entity_type,entity_id,
                   json.dumps(meta or {},ensure_ascii=False),now()))
    except Exception:
        # Audit is best-effort for compatibility routes; never make a successful
        # finance mutation depend on SQLite-specific schema introspection.
        pass



