@app.post('/api/v104/ops/global-recovery-finality-chain-checkpoints/issue')
def v104_issue(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin'});p=payload or {};op=str(u.get('email') or u.get('id') or 'operator')
    with core_db_connect() as c:
        chain=_v103_verify_chain(c)
        if not chain.get('valid'):raise HTTPException(409,'V103_CHAIN_NOT_VERIFIABLE')
        seq=int(p.get('chain_sequence_no') or chain['last_sequence_no'])
        if seq<1 or seq>int(chain['last_sequence_no']):raise HTTPException(400,'V104_INVALID_CHAIN_SEQUENCE')
        row=c.execute('SELECT * FROM production_global_recovery_finality_chain_checkpoints WHERE chain_sequence_no=?',(seq,)).fetchone()
        if row:
            vr=_v104_verify_checkpoint(c,row)
            if vr.get('valid'):return {'schema_version':'1.104','idempotent':True,'checkpoint':dict(row),'verification':vr}
            raise HTTPException(409,'V104_EXISTING_CHECKPOINT_INVALID')
        manifest=_v104_manifest(c,seq);head=manifest[-1]['entry_sha256'];no=int(c.execute('SELECT COALESCE(MAX(checkpoint_no),0)+1 n FROM production_global_recovery_finality_chain_checkpoints').fetchone()['n']);obj=_v104_checkpoint_payload(no,seq,head,manifest);ch=_v104_hash(obj);key,pub,keyid=_v169_load_signer();sig=base64.b64encode(key.sign(_v104_json(obj).encode())).decode();cid='grfc104_'+uuid.uuid4().hex[:16];t=now()
        c.execute('INSERT INTO production_global_recovery_finality_chain_checkpoints(id,checkpoint_no,chain_sequence_no,chain_head_entry_sha256,entry_count,prefix_manifest_json,checkpoint_json,checkpoint_sha256,algorithm,signer_key_id,public_key_b64,signature_b64,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(cid,no,seq,head,len(manifest),_v104_json(manifest),_v104_json(obj),ch,'Ed25519',keyid,base64.b64encode(pub).decode(),sig,'CHECKPOINTED',t,op));c.commit();row=c.execute('SELECT * FROM production_global_recovery_finality_chain_checkpoints WHERE id=?',(cid,)).fetchone();return {'schema_version':'1.104','idempotent':False,'checkpoint':dict(row),'verification':_v104_verify_checkpoint(c,row)}
@app.post('/api/v104/ops/global-recovery-finality-chain-checkpoints/attest')
def v104_attest(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin'});p=payload or {};cid=p.get('checkpoint_id');fid=p.get('federation_id');wid=p.get('witness_id');pub=str(p.get('public_key_b64') or '');sig=str(p.get('signature_b64') or '')
    with core_db_connect() as c:
        cp=c.execute('SELECT * FROM production_global_recovery_finality_chain_checkpoints WHERE id=?',(cid,)).fetchone();fed=c.execute('SELECT * FROM production_global_checkpoint_federations WHERE id=?',(fid,)).fetchone()
        if not cp or not fed:raise HTTPException(404,'V104_CHECKPOINT_OR_FEDERATION_NOT_FOUND')
        keyid=_v176_key_id(base64.b64decode(pub,validate=True));obj=_v104_attestation_payload(cp,fed,wid,keyid);digest=_v104_hash(obj);ex=c.execute('SELECT * FROM production_global_recovery_finality_checkpoint_attestations WHERE checkpoint_id=? AND federation_id=? AND witness_id=?',(cid,fid,wid)).fetchone()
        if ex:
            if ex['attestation_sha256']==digest and ex['signature_b64']==sig and ex['public_key_b64']==pub:return {'schema_version':'1.104','idempotent':True,'attestation':dict(ex),'verification':_v104_verify_attestation(c,ex,cp,fed)}
            raise HTTPException(409,'V104_EXISTING_ATTESTATION_CONFLICT')
        temp={'id':'','checkpoint_id':cid,'checkpoint_sha256':cp['checkpoint_sha256'],'federation_id':fid,'federation_sha256':fed['federation_sha256'],'witness_id':wid,'key_id':keyid,'public_key_b64':pub,'signature_b64':sig,'attestation_json':_v104_json(obj),'attestation_sha256':digest}
        vr=_v104_verify_attestation(c,temp,cp,fed)
        if not vr.get('valid'):raise HTTPException(409,'V104_ATTESTATION_NOT_VERIFIABLE')
        aid='grfa104_'+uuid.uuid4().hex[:16];t=now();op=str(u.get('email') or u.get('id') or 'operator');c.execute('INSERT INTO production_global_recovery_finality_checkpoint_attestations(id,checkpoint_id,checkpoint_sha256,federation_id,federation_sha256,witness_id,key_id,public_key_b64,signature_b64,attestation_json,attestation_sha256,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(aid,cid,cp['checkpoint_sha256'],fid,fed['federation_sha256'],wid,keyid,pub,sig,_v104_json(obj),digest,'VERIFIED',t,op));c.commit();row=c.execute('SELECT * FROM production_global_recovery_finality_checkpoint_attestations WHERE id=?',(aid,)).fetchone();return {'schema_version':'1.104','idempotent':False,'attestation':dict(row),'verification':_v104_verify_attestation(c,row,cp,fed)}
@app.post('/api/v104/ops/global-recovery-finality-chain-checkpoints/finalize')
def v104_finalize(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin'});p=payload or {};cid=p.get('checkpoint_id')
    with core_db_connect() as c:
        cp=c.execute('SELECT * FROM production_global_recovery_finality_chain_checkpoints WHERE id=?',(cid,)).fetchone()
        if not cp:raise HTTPException(404,'V104_CHECKPOINT_NOT_FOUND')
        cv=_v104_verify_checkpoint(c,cp)
        if not cv.get('valid'):raise HTTPException(409,'V104_CHECKPOINT_NOT_VERIFIABLE')
        ex=c.execute('SELECT * FROM production_global_recovery_finality_checkpoint_finality WHERE checkpoint_id=?',(cid,)).fetchone()
        if ex:return {'schema_version':'1.104','idempotent':True,'finality':dict(ex),'verification':_v104_verify_finality(c,ex)}
        rows=c.execute('SELECT * FROM production_global_recovery_finality_checkpoint_attestations WHERE checkpoint_id=? ORDER BY federation_id,witness_id',(cid,)).fetchall();valid=[];seenf=set();seenw=set()
        for a in rows:
            if a['federation_id'] in seenf or a['witness_id'] in seenw:continue
            fed=c.execute('SELECT * FROM production_global_checkpoint_federations WHERE id=?',(a['federation_id'],)).fetchone();vr=_v104_verify_attestation(c,a,cp,fed)
            if vr.get('valid'):valid.append((a,fed));seenf.add(a['federation_id']);seenw.add(a['witness_id'])
        allf=sorted({x[1]['id'] for x in valid});q=int(p.get('required_federation_quorum') or _v104_quorum(len(allf)))
        if q<1 or q>len(allf):raise HTTPException(409,'V104_CROSS_FEDERATION_QUORUM_NOT_MET')
        chosen=sorted(valid[:q], key=lambda x:x[1]['id']);fids=[x[1]['id'] for x in chosen];wids=[x[0]['witness_id'] for x in chosen];ahs=[x[0]['attestation_sha256'] for x in chosen];proof=_v104_finality_payload(cp,q,fids,wids,ahs);ph=_v104_hash(proof);key,pub,keyid=_v169_load_signer();sig=base64.b64encode(key.sign(_v104_json(proof).encode())).decode();fid='grff104_'+uuid.uuid4().hex[:16];t=now();op=str(u.get('email') or u.get('id') or 'operator')
        c.execute('INSERT INTO production_global_recovery_finality_checkpoint_finality(id,checkpoint_id,checkpoint_sha256,required_federation_quorum,federation_count,federation_ids_json,witness_ids_json,attestation_hashes_json,proof_json,proof_sha256,algorithm,signer_key_id,public_key_b64,signature_b64,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(fid,cid,cp['checkpoint_sha256'],q,len(fids),_v104_json(fids),_v104_json(wids),_v104_json(ahs),_v104_json(proof),ph,'Ed25519',keyid,base64.b64encode(pub).decode(),sig,'FINALIZED',t,op));c.commit();row=c.execute('SELECT * FROM production_global_recovery_finality_checkpoint_finality WHERE id=?',(fid,)).fetchone();return {'schema_version':'1.104','idempotent':False,'finality':dict(row),'verification':_v104_verify_finality(c,row)}
@app.get('/api/v104/ops/global-recovery-finality-chain-checkpoints/verify')
def v104_verify(authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        cps=c.execute('SELECT * FROM production_global_recovery_finality_chain_checkpoints ORDER BY checkpoint_no').fetchall(); fins=c.execute('SELECT * FROM production_global_recovery_finality_checkpoint_finality ORDER BY created_at,id').fetchall();cv=[_v104_verify_checkpoint(c,r) for r in cps];fv=[_v104_verify_finality(c,r) for r in fins];return {'schema_version':'1.104','valid':all(x.get('valid') for x in cv+fv),'checkpoints':cv,'finalities':fv}
@app.get('/api/v104/ops/global-recovery-finality-chain-checkpoints/latest')
def v104_latest(authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'})
