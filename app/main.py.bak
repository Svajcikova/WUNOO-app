@app.get("/api/v099/ops/telemetry/end_to_end")
def v099_end_to_end(authorization:str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    rid=v099_get_context().get("request_id")
    with core_db_connect() as c:
        migrate_v097(c); migrate_v095(c)
        audit=int(c.execute("SELECT COUNT(*) n FROM security_audit_events WHERE request_id=?",(rid,)).fetchone()["n"]) if rid else 0
        logs=int(c.execute("SELECT COUNT(*) n FROM structured_logs WHERE request_id=?",(rid,)).fetchone()["n"]) if rid else 0
    return {"request_id":rid,"audit_events":audit,"structured_logs":logs,
            "end_to_end_correlation":bool(rid)}


