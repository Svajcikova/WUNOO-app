@app.get("/api/v051/health/readiness")
def v051_readiness():
    checks={}
    try:
        with core_db_connect() as c:
            c.execute("SELECT 1").fetchone()
            checks["database"]="ok"
            tables=["orders","payments","notifications","reliability_incidents","api_idempotency_keys"]
            for t in tables:
                c.execute(f"SELECT 1 FROM {t} LIMIT 1")
                checks[t]="ok"
    except Exception as exc:
        checks["database"]=f"error:{exc}"
    ready=all(v=="ok" for v in checks.values())
    return {"ready":ready,"checks":checks,"version":"0.51.0"}


@app.post("/api/v051/payment-intent")
def v051_payment_intent(authorization:str|None=Header(default=None), idempotency_key:str|None=Header(default=None,alias="Idempotency-Key"))->dict[str,Any]:
    u=current_user(authorization); require_role(u,"customer")
    scope=f"payment-intent:{u['id']}"
    import hashlib, json as _json
    rh=hashlib.sha256(f"{u['customer_id']}".encode()).hexdigest()
    with core_db_connect() as c:
        cached=_v051_require_idempotency(c,scope,idempotency_key,rh,u["id"])
        if cached: return json.loads(cached["response_json"])
        rows=c.execute("SELECT id FROM orders WHERE customer_id=? AND status='payment_pending' ORDER BY created_at DESC LIMIT 1",(u["customer_id"],)).fetchone()
        if not rows: raise HTTPException(409,"Nenalezena payment-pending objednávka")
        result=v049_payment_intent(rows["id"],authorization)
        _v051_store_idempotency(c,scope,idempotency_key,rh,result,200,u["id"])
        c.commit()
        return result

@app.post("/api/v051/payment-webhook")
async def v051_payment_webhook(request:Request,
                               x_wunoo_signature:str|None=Header(default=None, alias="X-WUNOO-Signature"))->dict[str,Any]:
    raw=await request.body()
    _verify_webhook_signature(raw, x_wunoo_signature, required=True)
    try:
        body=json.loads(raw.decode("utf-8"))
    except Exception:
        raise HTTPException(400,"Neplatné JSON tělo webhooku")
    event_id=str(body.get("id",""))
    if not event_id: raise HTTPException(400,"Webhook id je povinné")
    return _process_v049_payment_webhook("test", body)


