        if not vr['valid']: raise HTTPException(409,'checkpoint chain invalid: '+vr['reason'])
        seq=int(logvr['next_sequence_no'])-1; head=str(logvr['head_sha256']); count=len(entries); prev=str(vr['head_checkpoint_sha256']); no=int(vr['next_checkpoint_no'])
