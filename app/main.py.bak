@app.post('/api/v174/ops/external-witness/register')
def v174_register(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization); payload=payload or {}; require_role(u,{'admin','ops_agent'})
    required=('checkpoint_sha256','witness_id','witness_system','witnessed_at','public_key_b64','signature_b64')
    if any(not payload.get(k) for k in required): raise HTTPException(400,'missing witness receipt field')
    with core_db_connect() as c:
        cp=_v170_row(c,'production_release_transparency_checkpoints',' WHERE checkpoint_sha256=?',(str(payload['checkpoint_sha256']),),'checkpoint_no DESC')
