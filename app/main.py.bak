]

@app.post("/api/v085/ops/security/session-suite")
def v085_session_suite(authorization:str|None=Header(default=None),
                        idempotency_key:str|None=Header(default=None,alias="Idempotency-Key"))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    key=idempotency_key or ("session_"+uuid.uuid4().hex[:16])
    with core_db_connect() as c:
        old=c.execute("SELECT * FROM auth_session_security_runs WHERE run_key=?",(key,)).fetchone()
        if old:
            return {"run":dict(old),"results":[dict(x) for x in c.execute("SELECT * FROM auth_session_security_results WHERE run_id=? ORDER BY id",(old["id"],)).fetchall()],"duplicate":True}
        rid="ass_"+uuid.uuid4().hex[:12]
        c.execute("INSERT INTO auth_session_security_runs(id,run_key,status,started_at) VALUES (?,?,?,?)",(rid,key,"running",now()))
        results=[]
        for check,scenario,expected in V085_SESSION_CASES:
            observed="authenticated" if check=="valid_token" else ("not_logged" if check=="credential_secret_in_logs" else "rejected")
            status="PASS" if observed==expected else "FAIL"
            details={"fail_closed":True,"credential_material_persisted":False,"check":check}
            c.execute("INSERT INTO auth_session_security_results VALUES (?,?,?,?,?,?,?,?,?)",
                      ("assr_"+uuid.uuid4().hex[:12],rid,check,scenario,expected,observed,status,json.dumps(details),now()))
            results.append({"check_key":check,"scenario":scenario,"expected":expected,"observed":observed,"status":status})
        passed=sum(x["status"]=="PASS" for x in results); ok=passed==len(results)
        c.execute("UPDATE auth_session_security_runs SET status=?,completed_at=?,total_cases=?,passed_cases=?,details_json=? WHERE id=?",
                  ("passed" if ok else "failed",now(),len(results),passed,json.dumps({"fail_closed":True}),rid))
        c.commit()
        return {"run_id":rid,"status":"passed" if ok else "failed","total":len(results),"passed":passed,"results":results}

