@app.get("/api/v063/ops/command-center")
def v063_command_center(authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    with core_db_connect() as c:
        def count(sql,args=()): return int(c.execute(sql,args).fetchone()["n"])
        metrics={
            "orders_total":count("SELECT COUNT(*) n FROM orders"),
            "orders_active":count("SELECT COUNT(*) n FROM orders WHERE status NOT IN ('delivered','merchant_rejected','payment_failed','payment_cancelled')"),
            "payment_pending":count("SELECT COUNT(*) n FROM orders WHERE status IN ('payment_pending','pending_payment')"),
            "merchant_preparing":count("SELECT COUNT(*) n FROM orders WHERE status='preparing'"),
            "ready_for_pickup":count("SELECT COUNT(*) n FROM orders WHERE status='ready_for_pickup'"),
            "courier_active":count("SELECT COUNT(*) n FROM dispatch_jobs WHERE status IN ('accepted','picked_up')"),
            "delivered":count("SELECT COUNT(*) n FROM orders WHERE status='delivered'"),
            "settlement_pending":count("""SELECT COUNT(*) n FROM orders o LEFT JOIN settlement_runs s ON s.order_id=o.id
                                         WHERE o.status='delivered' AND s.id IS NULL"""),
            "open_alerts":count("SELECT COUNT(*) n FROM ops_alerts WHERE status='open'")
        }
        alerts=[]
        for r in c.execute("SELECT * FROM ops_alerts WHERE status='open' ORDER BY CASE severity WHEN 'critical' THEN 0 WHEN 'high' THEN 1 WHEN 'medium' THEN 2 ELSE 3 END,created_at DESC LIMIT 100").fetchall():
            alerts.append(dict(r))
        return {"generated_at":now(),"metrics":metrics,"alerts":alerts}

@app.post("/api/v063/ops/refresh-alerts")
def v063_refresh_alerts(authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    created=0
    with core_db_connect() as c:
        # Payment stuck
        payment_cutoff=(datetime.now(timezone.utc)-__import__('datetime').timedelta(minutes=15)).isoformat()
        rows=c.execute("""SELECT id FROM orders WHERE status IN ('payment_pending','pending_payment')
                          AND created_at < ? LIMIT 100""",(payment_cutoff,)).fetchall()
        for r in rows:
            aid=("payment_stuck","order",r["id"],"open")
            before=c.execute("SELECT id FROM ops_alerts WHERE alert_type=? AND entity_type=? AND entity_id=? AND status='open'",aid[:3]).fetchone()
            if not before:
                c.execute("INSERT INTO ops_alerts VALUES (?,?,?,?,?,?,?,?,?,?,?)",
                          ("al_"+uuid.uuid4().hex[:12],"payment_stuck","high","order",r["id"],
                           "Payment čeká déle než 15 minut",json.dumps({"order_id":r["id"]}),"open",now(),None))
                created+=1
        # Delivered without settlement
        rows=c.execute("""SELECT o.id FROM orders o LEFT JOIN settlement_runs s ON s.order_id=o.id
                          WHERE o.status='delivered' AND s.id IS NULL LIMIT 100""").fetchall()
        for r in rows:
            before=c.execute("SELECT id FROM ops_alerts WHERE alert_type='settlement_missing' AND entity_id=? AND status='open'",(r["id"],)).fetchone()
            if not before:
                c.execute("INSERT INTO ops_alerts VALUES (?,?,?,?,?,?,?,?,?,?,?)",
                          ("al_"+uuid.uuid4().hex[:12],"settlement_missing","high","order",r["id"],
                           "Delivered objednávka nemá settlement",json.dumps({"order_id":r["id"]}),"open",now(),None))
                created+=1
        # Ready orders without dispatch
        rows=c.execute("""SELECT o.id FROM orders o LEFT JOIN dispatch_jobs d ON d.order_id=o.id
                          WHERE o.status='ready_for_pickup' AND d.id IS NULL LIMIT 100""").fetchall()
        for r in rows:
            before=c.execute("SELECT id FROM ops_alerts WHERE alert_type='dispatch_missing' AND entity_id=? AND status='open'",(r["id"],)).fetchone()
            if not before:
                c.execute("INSERT INTO ops_alerts VALUES (?,?,?,?,?,?,?,?,?,?,?)",
                          ("al_"+uuid.uuid4().hex[:12],"dispatch_missing","medium","order",r["id"],
                           "Ready objednávka nemá dispatch job",json.dumps({"order_id":r["id"]}),"open",now(),None))
                created+=1
        c.commit()
        return {"created":created}

