class TransactionalRepository:
    """Small DB-neutral transaction boundary. SQLite is the current adapter; PostgreSQL can implement the same contract."""
    def __init__(self, c):
        self.c=c

    def begin(self):
        self.c.execute("BEGIN")

    def commit(self):
        self.c.commit()

    def rollback(self):
        self.c.rollback()

    def execute(self, sql, args=()):
        return self.c.execute(sql,args)

class PaymentRepository(TransactionalRepository):
    def get_captured_total(self, order_id):
        return float(self.c.execute("SELECT COALESCE(SUM(amount_czk),0) n FROM payments WHERE order_id=? AND status='captured'",(order_id,)).fetchone()["n"])

class FinanceRepository(TransactionalRepository):
    def get_settlement(self, order_id):
        return self.c.execute("SELECT * FROM settlement_runs WHERE order_id=?",(order_id,)).fetchone()

class AtomicOrderTransitionService:
    def __init__(self,c):
        self.c=c
    def transition(self, order_id, expected, target, actor_id=None, idem=None):
        row=self.c.execute("SELECT status FROM orders WHERE id=?",(order_id,)).fetchone()
        if not row: raise HTTPException(404,"Objednávka nenalezena")
        if row["status"]!=expected: raise HTTPException(409,f"Neplatný transition: {row['status']} -> {target}; očekáváno {expected}")
        ts=now()
        cur=self.c.execute("UPDATE orders SET status=?,updated_at=? WHERE id=? AND status=?",(target,ts,order_id,expected))
        if cur.rowcount!=1: raise HTTPException(409,"State transition conflict")
        self.c.execute("INSERT INTO state_transition_audit VALUES (?,?,?,?,?,?,?,?)",
                       ("sta_"+uuid.uuid4().hex[:12],"order",order_id,expected,target,actor_id,idem,ts))
        emit(self.c,order_id,"state_transition",{"from":expected,"to":target},actor_id)
        return {"order_id":order_id,"from_status":expected,"status":target}


