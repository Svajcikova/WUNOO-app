def _haversine_km(lat1, lon1, lat2, lon2):
    from math import radians, sin, cos, asin, sqrt
    if None in (lat1, lon1, lat2, lon2):
        return None
    rlat1, rlon1, rlat2, rlon2 = map(radians, [lat1, lon1, lat2, lon2])
    dlat = rlat2 - rlat1
    dlon = rlon2 - rlon1
    a = sin(dlat / 2) ** 2 + cos(rlat1) * cos(rlat2) * sin(dlon / 2) ** 2
    return 2 * 6371.0 * asin(sqrt(a))


def _estimate_eta_minutes(distance_km, avg_speed_kmh=24.0):
    if distance_km is None:
        return None
    return max(1, round((distance_km / avg_speed_kmh) * 60))


def _tracking_status(distance_km, promised_delivery_at, predicted_delivery_at):
    from datetime import datetime, timezone
    if predicted_delivery_at and promised_delivery_at:
        try:
            p = datetime.fromisoformat(str(predicted_delivery_at).replace("Z", "+00:00"))
            w = datetime.fromisoformat(str(promised_delivery_at).replace("Z", "+00:00"))
            delay_seconds = (p - w).total_seconds()
            if delay_seconds > 30 * 60:
                return "CRITICAL"
            if delay_seconds > 15 * 60:
                return "MATERIAL_DELAY"
            if delay_seconds > 5 * 60:
                return "DELAYED"
        except Exception:
            pass
    return "ON_TIME"



def db_get_latest_courier_location(order_id, courier_id):
    with closing(conn()) as c:
        row = c.execute(
            "SELECT order_id,courier_id,lat,lon,recorded_at AS reported_at,remaining_distance_km,live_eta_minutes,deviation_ratio "
            "FROM courier_locations WHERE order_id=? AND courier_id=? ORDER BY recorded_at DESC LIMIT 1",
            (order_id, courier_id)
        ).fetchone()
    return dict(row) if row else None


def db_insert_courier_location(order_id, courier_id, lat, lon, reported_at, remaining_distance_km, live_eta_minutes, deviation_ratio):
