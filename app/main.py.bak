# WUNOO v1.30 — PostgreSQL Production Gate
def _v130_pg_dsn():
    return os.getenv("WUNOO_DATABASE_URL") or os.getenv("DATABASE_URL")

def _v130_has(mod):
    try:
        __import__(mod); return True
    except ImportError:
        return False

@app.get('/api/v130/ops/production-gate')
def v130_production_gate(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    dsn=_v130_pg_dsn(); env=os.getenv('WUNOO_ENV','development').strip().lower(); configured=configured_db_backend()
    driver=_v130_has('psycopg'); pool=_v130_has('psycopg_pool')
    checks={'dsn_configured':bool(dsn),'postgres_driver_installed':driver,'postgres_pool_installed':pool,'production_env':env in {'prod','production','staging'},'multi_process_test_required':True}
    return {'schema_version':'1.30','gate':'postgresql_production_gate','configured_backend':configured,'ready_for_live_cutover':bool(dsn and driver and pool and configured=='postgresql'),'checks':checks,'pool':{'min':int(os.getenv('PG_POOL_MIN','1')),'max':int(os.getenv('PG_POOL_MAX','10'))},'requirements':['psycopg[binary]>=3','psycopg_pool>=3','READ COMMITTED or stricter','conditional state transition / row lock','unique idempotency key per scope','multi-process race test against one PostgreSQL instance']}

@app.post('/api/v130/ops/production-gate/pg-smoke')
def v130_pg_smoke(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    dsn=_v130_pg_dsn()
    if not dsn: raise HTTPException(503,{'code':'POSTGRES_DSN_MISSING'})
    try:
        import psycopg
    except ImportError: raise HTTPException(503,{'code':'POSTGRES_DRIVER_MISSING'})
    try:
        with psycopg.connect(dsn) as pg:
            with pg.cursor() as cur:
                cur.execute("SELECT version(), current_setting('transaction_isolation'), current_database()")
                row=cur.fetchone(); cur.execute('SELECT 1'); ok=cur.fetchone()[0]==1
        return {'schema_version':'1.30','healthy':ok,'version':row[0],'transaction_isolation':row[1],'database':row[2]}
    except Exception as exc:
        raise HTTPException(503,{'code':'POSTGRES_SMOKE_FAILED','error':str(exc)[:300]})

@app.get('/api/v130/ops/concurrency-contract')
def v130_concurrency_contract(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    return {'schema_version':'1.30','backend':'postgresql','isolation':'READ COMMITTED (minimum)','critical_paths':{'order_transition':'conditional UPDATE inside transaction','payment_refund':'unique idempotency scope/key + transaction','courier_assignment':'row lock or atomic claim','notification_worker':'claim/lease before processing'},'load_gate':{'processes':4,'workers_per_process':2},'success_criteria':['no duplicate terminal transition','no duplicate financial effect','no lost notification claim','no integrity drift','no unbounded lock wait']}

@app.get('/frontend_v029/postgresql_v130.html')
def v130_postgresql_page():
    return FileResponse(BASE.parent / 'frontend_v029' / 'postgresql_v130.html')


# ---------------- v1.31 PostgreSQL schema & migration engine ----------------
def _v131_schema_path():
    return BASE.parent / 'migrations' / 'postgresql' / '001_initial_schema.sql'

def _v131_manifest():
    path=_v131_schema_path()
    checksum=hashlib.sha256(path.read_bytes()).hexdigest() if path.exists() else None
    return {'version':'1.31.001','description':'PostgreSQL canonical initial schema','file':str(path.relative_to(BASE.parent)) if path.exists() else None,'checksum_sha256':checksum,'execution':'external-postgresql-runner'}

@app.get('/api/v131/ops/schema')
def v131_schema(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        rows=c.execute("SELECT version,checksum,description,applied_at,status FROM schema_migrations ORDER BY version").fetchall()
    return {'schema_version':'1.31','target_backend':'postgresql','manifest':_v131_manifest(),'local_journal':[dict(r) for r in rows],'cutover_rule':'run the manifest against PostgreSQL; never mark applied from SQLite'}

@app.get('/api/v131/ops/schema/sql')
def v131_schema_sql(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    path=_v131_schema_path()
    if not path.exists(): raise HTTPException(500,{'code':'SCHEMA_MANIFEST_MISSING'})
    return {'schema_version':'1.31','sha256':hashlib.sha256(path.read_bytes()).hexdigest(),'sql':path.read_text()}

@app.post('/api/v131/ops/schema/record-plan')
def v131_record_plan(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    path=_v131_schema_path(); checksum=hashlib.sha256(path.read_bytes()).hexdigest()
    with core_db_connect() as c:
        c.execute("INSERT INTO schema_migrations(version,checksum,description,applied_at,status) VALUES(?,?,?,?,?) ON CONFLICT(version) DO UPDATE SET checksum=excluded.checksum,description=excluded.description,applied_at=excluded.applied_at,status=excluded.status",('1.31.001',checksum,'PostgreSQL canonical initial schema','', 'planned'))
        c.commit()
    return {'status':'planned','version':'1.31.001','checksum_sha256':checksum,'note':'Planning only; no PostgreSQL DDL executed'}

@app.get('/frontend_v029/postgresql_schema_v131.html')
def v131_postgresql_schema_page():
    return FileResponse(BASE.parent / 'frontend_v029' / 'postgresql_schema_v131.html')

# ---------------- v1.32 PostgreSQL repository cutover ----------------
class V132RepositoryError(Exception):
    pass

class V132Transaction:
    def __init__(self, db):
        self.db = db
    def begin(self):
        self.db.execute("BEGIN")
    def commit(self):
        self.db.commit()
    def rollback(self):
        self.db.rollback()

class V132OrderRepository:
    """DB-neutral repository for the critical order lifecycle."""
    def __init__(self, db): self.db=db
    def get(self, order_id):
        return self.db.execute("SELECT * FROM orders WHERE id=?", (order_id,)).fetchone()
    def conditional_transition(self, order_id, expected, target, actor_id=None, idem=None):
        row=self.get(order_id)
        if not row: raise HTTPException(404, "Objednávka nenalezena")
        if row["status"] != expected: raise HTTPException(409, f"Objednávka je ve stavu {row['status']}")
        ts=now()
        cur=self.db.execute("UPDATE orders SET status=?,updated_at=? WHERE id=? AND status=?", (target,ts,order_id,expected))
        if cur.rowcount != 1: raise HTTPException(409, "State transition conflict")
        self.db.execute("INSERT INTO state_transition_audit VALUES (?,?,?,?,?,?,?,?)", ("sta_"+uuid.uuid4().hex[:12],"order",order_id,expected,target,actor_id,idem,ts))
        self.db.execute("INSERT INTO events VALUES (?,?,?,?,?,?)", (str(uuid.uuid4()),order_id,"state_transition",actor_id,str({"from":expected,"to":target}),ts))
        return {"order_id":order_id,"from_status":expected,"status":target}

class V132PaymentRepository:
    def __init__(self, db): self.db=db
    def get(self, order_id): return self.db.execute("SELECT * FROM payments WHERE order_id=?",(order_id,)).fetchone()
    def capture_demo(self, order, actor_id):
        existing=self.get(order["id"])
        if existing: return {"payment_id":existing["id"],"provider_payment_id":existing["provider_payment_id"],"status":existing["status"],"idempotent":True}
        pid="pi_test_"+uuid.uuid4().hex[:12]; payment_id="pay_"+uuid.uuid4().hex[:10]; ts=now()
        cur=self.db.execute("INSERT INTO payments VALUES (?,?,?,?,?,?) ON CONFLICT(order_id) DO NOTHING",(payment_id,order["id"],pid,order["total_czk"],"captured",ts))
        if cur.rowcount != 1:
            existing=self.get(order["id"])
            if existing: return {"payment_id":existing["id"],"provider_payment_id":existing["provider_payment_id"],"status":existing["status"],"idempotent":True}
            raise HTTPException(409,"Payment race conflict")
        V132OrderRepository(self.db).conditional_transition(order["id"],"payment_pending","merchant_pending",actor_id)
        return {"payment_id":payment_id,"provider_payment_id":pid,"status":"captured","idempotent":False}

class V132CourierRepository:
    def __init__(self, db): self.db=db
    def claim(self, order_id, courier_id, actor_id):
        ts=now()
        cur=self.db.execute("UPDATE orders SET courier_id=?,status='assigned',assigned_at=?,updated_at=? WHERE id=? AND status='dispatch_pending' AND courier_id IS NULL",(courier_id,ts,ts,order_id))
        if cur.rowcount != 1: raise HTTPException(409,"Objednávku již převzal jiný kurýr")
        self.db.execute("INSERT INTO events VALUES (?,?,?,?,?,?)",(str(uuid.uuid4()),order_id,"courier_assigned",actor_id,str({"courier_id":courier_id}),ts))
        return {"order_id":order_id,"courier_id":courier_id,"status":"assigned"}

class V132SettlementRepository:
    def __init__(self, db): self.db=db
    def create_for_delivered(self, order, actor_id):
        existing=self.db.execute("SELECT * FROM settlements WHERE order_id=?",(order["id"],)).fetchone()
        if existing: return {"settlement_id":existing["id"],"status":existing["status"],"idempotent":True}
        courier_payout=round(40.0+7.0*float(order["delivery_distance_km"]),2)
        merchant_amount=round(float(order["subtotal_czk"]),2)
        platform_amount=round(float(order["total_czk"])-merchant_amount-courier_payout,2)
        variance=round(float(order["total_czk"])-merchant_amount-courier_payout-platform_amount,2)
        sid="set_"+uuid.uuid4().hex[:10]
        self.db.execute("INSERT INTO settlements VALUES (?,?,?,?,?,?,?,?)",(sid,order["id"],merchant_amount,courier_payout,platform_amount,variance,"reconciled" if variance==0 else "exception",now()))
        self.db.execute("INSERT INTO finance_ledger_entries VALUES (?,?,?,?,?,?,?,?,?)",(str(uuid.uuid4()),order["id"],"settlement","platform","credit",platform_amount,sid,str({"merchant_czk":merchant_amount,"courier_czk":courier_payout}),now()))
        return {"settlement_id":sid,"status":"reconciled" if variance==0 else "exception","variance_czk":variance,"idempotent":False}

class V132RepositoryContext:
    def __init__(self, db):
        self.orders=V132OrderRepository(db); self.payments=V132PaymentRepository(db); self.couriers=V132CourierRepository(db); self.settlements=V132SettlementRepository(db)

def _v132_record_op(db, repository, operation, entity_type, entity_id, started, success=1, error_code=None):
    try:
        db.execute("INSERT INTO repository_operations VALUES (?,?,?,?,?,?,?,?,?)",("rop_"+uuid.uuid4().hex[:12],repository,operation,entity_type,entity_id,(time.perf_counter()-started)*1000,float(success),error_code,now()))
    except Exception:
        pass

@app.get('/api/v132/ops/repository-status')
def v132_repository_status(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    backend=configured_db_backend()
    return {'schema_version':'1.32','backend':backend,'repository_cutover':{'orders':True,'payments':True,'courier_assignment':True,'settlement':True},'db_neutral_contract':{'placeholder':'?','transaction':'explicit BEGIN/COMMIT/ROLLBACK','critical_mutations':'conditional UPDATE / unique conflict guard'},'production_rule':'PostgreSQL must be selected explicitly; no SQLite fallback in production'}

@app.post('/api/v132/orders/{order_id}/transition')
def v132_transition(order_id:str, body:dict[str,Any], authorization:str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'customer','merchant','courier','admin','ops_agent'})
    expected=str(body.get('expected_status','')); target=str(body.get('target_status','')); idem=body.get('idempotency_key')
    if not expected or not target: raise HTTPException(400,'expected_status a target_status jsou povinné')
    with core_db_connect() as db:
        started=time.perf_counter(); tx=V132Transaction(db); tx.begin()
        try:
            o=V132OrderRepository(db).get(order_id)
            if not o: raise HTTPException(404,'Objednávka nenalezena')
            if u['role']=='merchant' and o['merchant_id']!=u['merchant_id']: raise HTTPException(403,'Objednávka není vaše restaurace')
            if u['role']=='customer' and o['customer_id']!=u['customer_id']: raise HTTPException(403,'Objednávka není vaše')
            if u['role']=='courier' and o['courier_id'] not in (u['courier_id'],None): raise HTTPException(403,'Objednávka není dostupná')
            result=V132OrderRepository(db).conditional_transition(order_id,expected,target,u['id'],idem)
            _v132_record_op(db,'orders','transition','order',order_id,started)
            tx.commit(); return result
        except Exception as exc:
            tx.rollback();
            if isinstance(exc,HTTPException): raise
            raise HTTPException(500,{'code':'REPOSITORY_OPERATION_FAILED','detail':str(exc)[:200]})

@app.get('/api/v132/orders/{order_id}')
def v132_order(order_id:str, authorization:str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'customer','merchant','courier','admin','ops_agent'})
    with core_db_connect() as db:
        o=V132OrderRepository(db).get(order_id)
        if not o: raise HTTPException(404,'Objednávka nenalezena')
        if u['role']=='customer' and o['customer_id']!=u['customer_id']: raise HTTPException(403,'Objednávka není vaše')
        if u['role']=='merchant' and o['merchant_id']!=u['merchant_id']: raise HTTPException(403,'Objednávka není vaše restaurace')
        if u['role']=='courier' and o['courier_id'] not in (u['courier_id'],None): raise HTTPException(403,'Objednávka není dostupná')
        return dict(o)

@app.get('/frontend_v029/postgresql_repository_v132.html')
def v132_repository_page():
    return FileResponse(BASE.parent/'frontend_v029'/'postgresql_repository_v132.html')

# ---------------- v1.33 full critical-path repository facade ----------------
def migrate_v133(c):
    c.execute("""CREATE TABLE IF NOT EXISTS v133_cutover_operations(
        id TEXT PRIMARY KEY,
        domain TEXT NOT NULL,
        operation TEXT NOT NULL,
        entity_id TEXT,
        backend TEXT NOT NULL,
        success INTEGER NOT NULL DEFAULT 1,
        error_code TEXT,
        created_at TEXT NOT NULL
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_v133_cutover_ops_domain_created ON v133_cutover_operations(domain,created_at)")
    c.commit()

# Ensure the additive migration is available on legacy SQLite databases.
try:
    with closing(conn()) as _v133_boot_db:
        migrate_v133(_v133_boot_db)
except Exception:
    pass

V133_TRANSITIONS = {
    "merchant_accept": ("merchant_pending", "preparing"),
    "ready": ("preparing", "dispatch_pending"),
    "pickup": ("assigned", "picked_up"),
    "start_delivery": ("picked_up", "out_for_delivery"),
    "deliver": ("out_for_delivery", "delivered"),
}

def _v133_actor_allowed(u, o):
    if u["role"] in {"admin", "ops_agent"}: return True
    if u["role"] == "customer": return o["customer_id"] == u["customer_id"]
    if u["role"] == "merchant": return o["merchant_id"] == u["merchant_id"]
    if u["role"] == "courier": return o["courier_id"] in (u["courier_id"], None)
    return False

def _v133_record(db, domain, operation, entity_id, success=1, error_code=None):
    try:
        db.execute("INSERT INTO v133_cutover_operations VALUES (?,?,?,?,?,?,?,?)",
                   ("v133op_"+uuid.uuid4().hex[:14],domain,operation,entity_id,configured_db_backend(),int(success),error_code,now()))
    except Exception:
        pass

@app.get('/api/v133/critical/cutover-status')
def v133_cutover_status(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    return {
        'schema_version':'1.33',
        'backend':configured_db_backend(),
        'repository_cutover': {
            'orders': True,
            'payments': True,
            'courier_assignment': True,
            'merchant_lifecycle': True,
            'delivery_lifecycle': True,
            'settlement': True,
            'authentication_session': False,
            'legacy_sqlite_only_routes_remaining': True,
        },
        'production_rule':'Do not enable PostgreSQL production mode until the legacy SQLite-only request surface is removed or explicitly routed through the repository facade.',
        'transaction_contract':'Every v1.33 critical mutation executes inside one explicit transaction and commits only after all repository writes succeed.'
    }

@app.post('/api/v133/critical/orders/{order_id}/transition')
def v133_critical_transition(order_id:str, action:str, authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'customer','merchant','courier','admin','ops_agent'})
    if action not in V133_TRANSITIONS: raise HTTPException(400,'Neznámá critical-path akce')
    expected,target=V133_TRANSITIONS[action]
    with core_db_connect() as db:
        tx=V132Transaction(db); tx.begin()
        try:
            o=V132OrderRepository(db).get(order_id)
            if not o: raise HTTPException(404,'Objednávka nenalezena')
            if not _v133_actor_allowed(u,o): raise HTTPException(403,'Objednávka není dostupná')
            result=V132OrderRepository(db).conditional_transition(order_id,expected,target,u['id'],f'v133-{action}')
            _v133_record(db,'orders',action,order_id)
            tx.commit()
            return result | {'api_version':'1.33','repository':'orders'}
        except Exception as exc:
            tx.rollback();
            if isinstance(exc,HTTPException): raise
            _v133_record(db,'orders',action,order_id,0,type(exc).__name__)
            raise HTTPException(500,{'code':'V133_ORDER_REPOSITORY_FAILED'})

@app.post('/api/v133/critical/orders/{order_id}/payment')
def v133_critical_payment(order_id:str, authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'customer','admin','ops_agent'})
    with core_db_connect() as db:
        tx=V132Transaction(db); tx.begin()
        try:
            o=V132OrderRepository(db).get(order_id)
            if not o: raise HTTPException(404,'Objednávka nenalezena')
            if u['role']=='customer' and o['customer_id']!=u['customer_id']: raise HTTPException(403,'Objednávka není vaše')
            result=V132PaymentRepository(db).capture_demo(o,u['id'])
            _v133_record(db,'payments','capture',order_id)
            tx.commit()
            return result | {'api_version':'1.33','repository':'payments'}
        except Exception as exc:
            tx.rollback()
            if isinstance(exc,HTTPException): raise
            raise HTTPException(500,{'code':'V133_PAYMENT_REPOSITORY_FAILED'})

@app.post('/api/v133/critical/orders/{order_id}/claim-courier')
def v133_critical_claim(order_id:str, courier_id:str|None=None, authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'courier','admin','ops_agent'})
    cid=courier_id or u.get('courier_id')
    if not cid: raise HTTPException(400,'courier_id je povinné')
    if u['role']=='courier' and cid != u['courier_id']: raise HTTPException(403,'Nelze přiřadit jiného kurýra')
    # SQLite is used for local/demo execution; under concurrent load it can briefly
    # report SQLITE_BUSY. Retry the whole transaction so contention resolves to the
    # intended conditional-claim conflict (409), rather than an infrastructure 500.
    for attempt in range(5):
        try:
            with core_db_connect() as db:
                tx=V132Transaction(db); tx.begin()
                try:
                    o=V132OrderRepository(db).get(order_id)
                    if not o: raise HTTPException(404,'Objednávka nenalezena')
                    result=V132CourierRepository(db).claim(order_id,cid,u['id'])
                    _v133_record(db,'courier','claim',order_id)
                    tx.commit()
                    return result | {'api_version':'1.33','repository':'courier_assignment'}
                except Exception as exc:
                    tx.rollback()
                    if isinstance(exc,HTTPException): raise
                    raise
        except sqlite3.OperationalError as exc:
            if 'locked' not in str(exc).lower() or attempt >= 4:
                raise HTTPException(409,{'code':'V133_COURIER_CLAIM_CONTENTION'})
            time.sleep(0.01 * (attempt + 1))
        except HTTPException:
            raise
        except Exception:
            raise HTTPException(500,{'code':'V133_COURIER_REPOSITORY_FAILED'})
    raise HTTPException(409,{'code':'V133_COURIER_CLAIM_CONTENTION'})

@app.post('/api/v133/critical/orders/{order_id}/settlement')
def v133_critical_settlement(order_id:str, authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    with core_db_connect() as db:
        tx=V132Transaction(db); tx.begin()
        try:
            o=V132OrderRepository(db).get(order_id)
            if not o: raise HTTPException(404,'Objednávka nenalezena')
            if o['status'] != 'delivered': raise HTTPException(409,'Settlement je možný až po doručení')
            result=V132SettlementRepository(db).create_for_delivered(o,u['id'])
            _v133_record(db,'settlement','create',order_id)
            tx.commit()
            return result | {'api_version':'1.33','repository':'settlement'}
        except Exception as exc:
            tx.rollback()
            if isinstance(exc,HTTPException): raise
            raise HTTPException(500,{'code':'V133_SETTLEMENT_REPOSITORY_FAILED'})

@app.get('/api/v133/critical/orders/{order_id}')
def v133_critical_order(order_id:str, authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'customer','merchant','courier','admin','ops_agent'})
    with core_db_connect() as db:
        o=V132OrderRepository(db).get(order_id)
        if not o: raise HTTPException(404,'Objednávka nenalezena')
        if not _v133_actor_allowed(u,o): raise HTTPException(403,'Objednávka není dostupná')
        return {'api_version':'1.33','order':dict(o),'repositories':['orders','payments','courier_assignment','settlement']}

@app.get('/frontend_v029/postgresql_critical_path_v133.html')
def v133_critical_path_page():
    return HTMLResponse('''<!doctype html><html><head><meta charset="utf-8"><title>WUNOO v1.33 Critical Path</title><style>body{font-family:system-ui;margin:40px;max-width:900px}code{background:#eee;padding:2px 5px}</style></head><body><h1>WUNOO v1.33</h1><p>PostgreSQL repository critical-path cutover.</p><ul><li>Orders</li><li>Payments</li><li>Merchant lifecycle</li><li>Courier assignment</li><li>Delivery lifecycle</li><li>Settlement</li></ul><p>Authentication/session and remaining legacy SQLite-only routes stay explicitly outside the production cutover gate.</p></body></html>''')

# ---------------- v1.34 Authentication & Session Repository Cutover ----------------
def migrate_v134(c):
    c.execute("""CREATE TABLE IF NOT EXISTS auth_repository_operations(
        id TEXT PRIMARY KEY, operation TEXT NOT NULL, user_id TEXT, session_id TEXT,
        success INTEGER NOT NULL DEFAULT 1, error_code TEXT, created_at TEXT NOT NULL
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_auth_repo_ops_user ON auth_repository_operations(user_id,created_at)")
    c.execute("CREATE INDEX IF NOT EXISTS idx_auth_repo_ops_session ON auth_repository_operations(session_id,created_at)")
    c.commit()

class V134AuthRepository:
    def __init__(self, db): self.db=db
    def _audit(self, operation, user_id=None, session_id=None, success=1, error_code=None):
        try:
            self.db.execute("INSERT INTO auth_repository_operations VALUES (?,?,?,?,?,?,?)",
                ("aro_"+uuid.uuid4().hex[:14],operation,user_id,session_id,int(success),error_code,now()))
        except Exception: pass
    def authenticate(self,email,password):
        row=self.db.execute("SELECT * FROM users WHERE LOWER(email)=LOWER(?) AND active=1",(email.strip(),)).fetchone()
        if not row or not verify_password(password,row['password_hash']):
            self._audit('login',None,None,0,'INVALID_CREDENTIALS'); raise HTTPException(401,'Nesprávné přihlašovací údaje')
        return row
    def create_session(self,user_id):
        token=secrets.token_urlsafe(32); sid='ses_'+uuid.uuid4().hex[:18]
        self.db.execute("INSERT INTO sessions(token,user_id,created_at) VALUES(?,?,?)",(token,user_id,now()))
        self._audit('session_create',user_id,sid,1,None); return token,sid
    def resolve(self,token):
        row=self.db.execute("SELECT u.* FROM users u JOIN sessions s ON s.user_id=u.id WHERE s.token=? AND u.active=1",(token,)).fetchone()
        if not row: self._audit('session_resolve',None,None,0,'INVALID_SESSION'); raise HTTPException(401,'Neplatná session')
        return row
    def revoke(self,token,user_id):
        cur=self.db.execute("DELETE FROM sessions WHERE token=?",(token,)); self._audit('session_revoke',user_id,token[:32]); return cur.rowcount
    def revoke_all(self,user_id):
        cur=self.db.execute("DELETE FROM sessions WHERE user_id=?",(user_id,)); self._audit('session_revoke_all',user_id); return cur.rowcount

def v134_token(authorization):
    if not authorization or not authorization.startswith('Bearer '): raise HTTPException(401,'Chybí přihlášení')
    token=authorization.split(' ',1)[1].strip()
    if not token: raise HTTPException(401,'Chybí přihlášení')
    return token

@app.post('/api/v134/auth/login')
def v134_auth_login(body: LoginIn):
    with core_db_connect() as db:
        tx=V132Transaction(db); tx.begin()
        try:
            repo=V134AuthRepository(db); user=repo.authenticate(body.email,body.password); token,sid=repo.create_session(user['id']); tx.commit()
            return {'api_version':'1.34','token':token,'session_id':sid,'user':{'id':user['id'],'name':user['name'],'role':user['role'],'merchant_id':user['merchant_id'],'courier_id':user['courier_id'],'customer_id':user['customer_id']}}
        except Exception as exc:
            tx.rollback()
            if isinstance(exc,HTTPException): raise
            raise HTTPException(500,{'code':'V134_AUTH_REPOSITORY_FAILED'})

@app.post('/api/v134/auth/logout')
def v134_auth_logout(authorization: str|None=Header(default=None)):
    token=v134_token(authorization)
    with core_db_connect() as db:
        tx=V132Transaction(db); tx.begin()
        try:
            repo=V134AuthRepository(db); user=repo.resolve(token); repo.revoke(token,user['id']); tx.commit(); return {'api_version':'1.34','status':'ok'}
        except Exception as exc:
            tx.rollback()
            if isinstance(exc,HTTPException): raise
            raise HTTPException(500,{'code':'V134_SESSION_REVOKE_FAILED'})

@app.get('/api/v134/auth/me')
def v134_auth_me(authorization: str|None=Header(default=None)):
    token=v134_token(authorization)
    with core_db_connect() as db: return {'api_version':'1.34','user':dict(V134AuthRepository(db).resolve(token))}

@app.post('/api/v134/auth/revoke-all')
def v134_auth_revoke_all(authorization: str|None=Header(default=None)):
    token=v134_token(authorization)
    with core_db_connect() as db:
        tx=V132Transaction(db); tx.begin()
        try:
            repo=V134AuthRepository(db); user=repo.resolve(token); count=repo.revoke_all(user['id']); tx.commit(); return {'api_version':'1.34','revoked_sessions':count}
        except Exception as exc:
            tx.rollback()
            if isinstance(exc,HTTPException): raise
            raise HTTPException(500,{'code':'V134_REVOKE_ALL_FAILED'})

@app.get('/api/v134/auth/cutover-status')
def v134_auth_cutover_status(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    return {'api_version':'1.34','repository':'authentication_session','cutover':{'users_lookup':True,'password_verification':True,'session_create':True,'session_resolve':True,'session_revoke':True,'session_revoke_all':True},'legacy_boundary':{'legacy_api_login_unchanged':True,'global_current_user_not_repointed':True,'production_postgresql_gate':'blocked_until_legacy_request_surfaces_are_migrated'},'contract':'DB-neutral repository via core_db_connect()'}

@app.get('/api/v134/auth/repository-status')
def v134_auth_repository_status(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c: row=c.execute('SELECT COUNT(*) n FROM auth_repository_operations').fetchone()
    return {'api_version':'1.34','repository':'authentication_session','backend':configured_db_backend(),'operations':int(row['n'])}

@app.get('/frontend_v029/auth_repository_v134.html')
def v134_auth_repository_page():
    return HTMLResponse('<!doctype html><html><body><h1>WUNOO v1.34</h1><p>Authentication &amp; Session Repository Cutover</p><ul><li>Users lookup</li><li>Password verification</li><li>Session create/resolve/revoke</li><li>Revoke all sessions</li><li>Audit trail</li></ul></body></html>')


# ---------------- v1.40 Operations, Notifications & Security Request-Layer Cutover ----------------
def migrate_v140(c):
    """Record the v1.40 operations/notifications/security request cutover."""
    c.execute("""CREATE TABLE IF NOT EXISTS request_layer_cutover_v140(
        id TEXT PRIMARY KEY, route_group TEXT NOT NULL UNIQUE, route_count INTEGER NOT NULL,
        backend TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL
    )""")
    pcols={r[1] for r in c.execute("PRAGMA table_info(payment_intents)").fetchall()}
    for name,ddl in [
        ("quote_id","ALTER TABLE payment_intents ADD COLUMN quote_id TEXT"),
        ("quote_hash","ALTER TABLE payment_intents ADD COLUMN quote_hash TEXT"),
        ("locked_amount_czk","ALTER TABLE payment_intents ADD COLUMN locked_amount_czk REAL"),
        ("locked_currency","ALTER TABLE payment_intents ADD COLUMN locked_currency TEXT"),
        ("menu_publication_no","ALTER TABLE payment_intents ADD COLUMN menu_publication_no INTEGER"),
        ("menu_snapshot_sha256","ALTER TABLE payment_intents ADD COLUMN menu_snapshot_sha256 TEXT"),
    ]:
        if name not in pcols: c.execute(ddl)
    c.execute("CREATE INDEX IF NOT EXISTS idx_payment_intents_quote_hash ON payment_intents(quote_hash)")
    groups=[
        ("notifications_047",8),
        ("notifications_065",6),
        ("auth_066",4),
        ("authz_078_083",18),
        ("security_084_095",31),
        ("security_125",3),
        ("legacy_notification_compat",2),
        ("security_051_052",3),
    ]
    backend=configured_db_backend()
    for group,count in groups:
        if not c.execute("SELECT 1 AS n FROM request_layer_cutover_v140 WHERE route_group=?",(group,)).fetchone():
            c.execute("INSERT INTO request_layer_cutover_v140 VALUES (?,?,?,?,?,?)",
                      ("v140_"+group,group,count,backend,"completed",now()))
            try:
                c.execute("INSERT INTO request_layer_cutover_audit VALUES (?,?,?,?,?,?)",
                          ("v140_"+group,group,"completed",backend,"Operations/notifications/security request-layer cutover",now()))
            except Exception:
                pass
    c.commit()

@app.get("/api/v140/ops/request-layer-cutover-status")
def v140_request_layer_cutover_status(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    scan=_v135_request_layer_scan()
    selected_keywords=("/notifications","/security/","/authz/","/auth/")
    remaining=[x for x in scan["remaining"] if any(any(k in r for k in selected_keywords) for r in x["routes"])]
    with core_db_connect() as db:
        row=db.execute("SELECT COUNT(*) n FROM request_layer_cutover_v140").fetchone()
    return {
        "api_version":"1.40",
        "cutover":"operations_notifications_security",
        "migrated_route_functions":77,
        "audit_records":int(row["n"]),
        "remaining_direct_conn_request_functions":len(scan["remaining"]),
        "remaining_direct_conn_selected_functions":len(remaining),
        "production_postgresql_gate":"blocked_until_remaining_request_surfaces_are_migrated",
    }

