@app.post("/api/v062/settlement/run")
def v062_settlement_run(body:dict[str,Any], authorization:str|None=Header(default=None), idempotency_key:str|None=Header(default=None,alias="Idempotency-Key"))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    oid=str(body.get("order_id","")).strip()
    if not oid: raise HTTPException(400,"order_id je povinné")
    with core_db_connect() as c:
        c.execute("BEGIN")
        cached=_v052_guard(c,f"settlement:{u['id']}",idempotency_key,{"order_id":oid})
        if cached is not None:return cached
        o=c.execute("SELECT * FROM orders WHERE id=?",(oid,)).fetchone()
        if not o: raise HTTPException(404,"Objednávka nenalezena")
        if o["status"]!="delivered": raise HTTPException(409,"Settlement je možný až po delivered")
        existing=c.execute("SELECT * FROM settlement_runs WHERE order_id=?",(oid,)).fetchone()
        if existing:
            result={"settlement_id":existing["id"],"status":existing["status"],"gross_czk":existing["gross_czk"],
                    "platform_fee_czk":existing["platform_fee_czk"],"merchant_payout_czk":existing["merchant_payout_czk"],
                    "courier_payout_czk":existing["courier_payout_czk"],"delivery_fee_czk":existing["delivery_fee_czk"],
                    "adjustment_czk":existing["adjustment_czk"],"net_czk":existing["net_czk"]}
        else:
            gross=round(float(o["total_czk"]),2)
            # Delivery fee is treated as the delivery component; platform fee is applied to order gross.
            fee=round(gross*0.18,2)
            courier=39.0
            merchant=round(gross-fee-courier,2)
            if merchant<0: merchant=0.0
            net=round(gross-fee-courier,2)
            sid="set_"+uuid.uuid4().hex[:12]
            c.execute("""INSERT INTO settlement_runs
                         (id,order_id,status,gross_czk,platform_fee_czk,merchant_payout_czk,courier_payout_czk,
                          delivery_fee_czk,adjustment_czk,net_czk,created_at)
                         VALUES (?,?,?,?,?,?,?,?,?,?,?)""",
                      (sid,oid,"completed",gross,fee,merchant,courier,courier,0.0,net,now()))
            entries=[
                ("order_gross","customer_receivable","debit",gross),
                ("platform_fee","platform_revenue","credit",fee),
                ("merchant_payout","merchant_payable","credit",merchant),
                ("courier_payout","courier_payable","credit",courier),
            ]
            for typ,acct,direction,amount in entries:
                c.execute("INSERT INTO finance_ledger_entries VALUES (?,?,?,?,?,?,?,?,?)",
                          ("fle_"+uuid.uuid4().hex[:12],oid,typ,acct,direction,amount,sid,json.dumps({"source":"v062"},ensure_ascii=False),now()))
            result={"settlement_id":sid,"status":"completed","gross_czk":gross,"platform_fee_czk":fee,
                    "merchant_payout_czk":merchant,"courier_payout_czk":courier,"delivery_fee_czk":courier,
                    "adjustment_czk":0.0,"net_czk":net}
            emit(c,oid,"settlement_completed",result,u["id"])
        _v052_store(c,f"settlement:{u['id']}",idempotency_key,{"order_id":oid},result)
        _v052_audit(c,u["id"],"settlement_run","order",oid,result)
        c.commit();return result

@app.get("/api/v062/settlement/{order_id}")
def v062_settlement_get(order_id:str, authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent","merchant"})
    with core_db_connect() as c:
        s=c.execute("SELECT * FROM settlement_runs WHERE order_id=?",(order_id,)).fetchone()
        if not s: raise HTTPException(404,"Settlement nenalezen")
        if u["role"]=="merchant":
            o=c.execute("SELECT merchant_id FROM orders WHERE id=?",(order_id,)).fetchone()
            if not o or o["merchant_id"]!=u.get("merchant_id"): raise HTTPException(403,"forbidden")
        entries=c.execute("SELECT * FROM finance_ledger_entries WHERE order_id=? ORDER BY created_at",(order_id,)).fetchall()
        return {"settlement":dict(s),"ledger":[dict(x) for x in entries]}

@app.get("/api/v062/finance/reconciliation/{order_id}")
def v062_reconciliation(order_id:str, authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    with core_db_connect() as c:
        s=c.execute("SELECT * FROM settlement_runs WHERE order_id=?",(order_id,)).fetchone()
        if not s: raise HTTPException(404,"Settlement nenalezen")
        deb=float(c.execute("SELECT COALESCE(SUM(amount_czk),0) n FROM finance_ledger_entries WHERE order_id=? AND direction='debit'",(order_id,)).fetchone()["n"])
        cred=float(c.execute("SELECT COALESCE(SUM(amount_czk),0) n FROM finance_ledger_entries WHERE order_id=? AND direction='credit'",(order_id,)).fetchone()["n"])
        variance=round(float(s["gross_czk"])-float(s["platform_fee_czk"])-float(s["merchant_payout_czk"])-float(s["courier_payout_czk"]),2)
        balanced=abs(variance)<=0.01 and abs(deb-cred)<=0.01
        return {"order_id":order_id,"balanced":balanced,"settlement_variance_czk":variance,"ledger_debits_czk":deb,"ledger_credits_czk":cred}

@app.post("/api/v062/settlement/run-batch")
def v062_settlement_batch(authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    with core_db_connect() as c:
        orders=c.execute("SELECT id FROM orders WHERE status='delivered' ORDER BY updated_at LIMIT 100").fetchall()
    results=[]
    for row in orders:
        try:
            results.append(v062_settlement_run({"order_id":row["id"]},authorization))
        except Exception as exc:
            results.append({"order_id":row["id"],"status":"failed","error":str(exc)})
    return {"processed":len(results),"results":results}

