        raw=base64.b64decode(row['public_key_b64'],validate=True)
        if _v176_key_id(raw)!=row['signer_key_id']:return {'valid':False,'reason':'V109_SIGNER_KEY_ID_INVALID'}
        if int(row['gate_no'])!=int(obj.get('gate_no',-1)) or (row['status']=='VALID')!=bool(obj.get('overall_valid')):return {'valid':False,'reason':'V109_METADATA_INVALID'}
        return {'valid':True,'gate_no':int(row['gate_no']),'overall_valid':bool(obj.get('overall_valid'))}
    except Exception:return {'valid':False,'reason':'V109_GATE_INVALID'}
