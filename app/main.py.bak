_V173_POLICY={'schema_version':'1.73','format':'wunoo.release.transparency.checkpoint.v1','hash_algorithm':'sha256','signature_algorithm':'Ed25519','previous_checkpoint_required':True,'append_only':True,'purpose':'tamper_evident_transparency_checkpoint','external_witnessing_supported':True,'fail_closed':True,'automatic_release':False,'checkpoint_is_not_release_authorization':True}
def _v173_hash(payload): return hashlib.sha256(json.dumps(payload,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()).hexdigest()
def _v173_zero(): return '0'*64
def _v173_payload(no,seq,head,count,prev):
    return {'format':'wunoo.release.transparency.checkpoint.v1','schema_version':'1.73','checkpoint_no':int(no),'sequence_no':int(seq),'head_sha256':str(head),'entries_count':int(count),'previous_checkpoint_sha256':str(prev)}
