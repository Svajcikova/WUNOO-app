        status_code INTEGER NOT NULL, duration_ms REAL NOT NULL, created_at TEXT NOT NULL)""")
    c.execute("""CREATE TABLE IF NOT EXISTS observability_dependency_checks(
        id TEXT PRIMARY KEY, dependency TEXT NOT NULL, status TEXT NOT NULL,
        latency_ms REAL, error TEXT, checked_at TEXT NOT NULL)""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_obs_req_time ON observability_request_metrics(created_at)")
    c.execute("CREATE INDEX IF NOT EXISTS idx_obs_dep_time ON observability_dependency_checks(checked_at)")
    c.commit()

def record_request_metric(request, response, duration_ms):
    rid=response.headers.get("X-Request-ID") or security_request_id(request)
    with closing(conn()) as c:
        migrate_v096(c)
        c.execute("""INSERT INTO observability_request_metrics
            (id,request_id,method,path,status_code,duration_ms,created_at)
            VALUES (?,?,?,?,?,?,?)""",
            ("orm_"+uuid.uuid4().hex[:12],rid,request.method,request.url.path,
             response.status_code,float(duration_ms),now()))
        emit_structured_log(c,level="INFO" if response.status_code < 400 else "WARN",
            event_name="http.request",request_id=rid,method=request.method,
            path=request.url.path,status_code=response.status_code,
            duration_ms=float(duration_ms),metadata={"source":"v0.97"})
        c.commit()


