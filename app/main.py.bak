@app.post("/api/v078/ops/authz/check")
def v078_authz_check(body:dict[str,Any], authorization:str|None=Header(default=None), request_id:str|None=Header(default=None,alias="X-Request-ID"))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    resource=str(body.get("resource","")).strip()
    action=str(body.get("action","")).strip()
    resource_id=body.get("resource_id")
    tenant_id=body.get("tenant_id")
    if not resource or not action: raise HTTPException(400,"resource a action jsou povinné")
    with core_db_connect() as c:
        allowed,reason=AuthorizationPolicyEngine(c).allow(u,resource,action,resource_id,tenant_id,request_id)
        c.commit()
        return {"decision":"allow" if allowed else "deny","reason":reason,"default":"deny"}

