# ---------------------------------------------------------------------------
# WUNOO v1.24 — production scheduler & autonomous recovery
# ---------------------------------------------------------------------------
def migrate_v124(c):
    c.execute("""CREATE TABLE IF NOT EXISTS v124_schedules(
        id TEXT PRIMARY KEY, job_name TEXT NOT NULL UNIQUE, interval_seconds INTEGER NOT NULL,
        enabled INTEGER NOT NULL DEFAULT 1, next_run_at TEXT NOT NULL, last_run_at TEXT,
        last_status TEXT, updated_at TEXT NOT NULL
    )""")
    c.execute("""CREATE TABLE IF NOT EXISTS v124_scheduler_runs(
        id TEXT PRIMARY KEY, job_name TEXT NOT NULL, status TEXT NOT NULL,
        started_at TEXT NOT NULL, finished_at TEXT, result_json TEXT NOT NULL DEFAULT '{}', error TEXT
    )""")
    c.execute("""CREATE TABLE IF NOT EXISTS v124_recovery_actions(
        id TEXT PRIMARY KEY, order_id TEXT NOT NULL, action TEXT NOT NULL, reason TEXT NOT NULL,
        status TEXT NOT NULL, correlation_id TEXT NOT NULL, created_at TEXT NOT NULL, completed_at TEXT
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_v124_schedule_due ON v124_schedules(enabled,next_run_at)")
    c.execute("CREATE INDEX IF NOT EXISTS idx_v124_runs_job ON v124_scheduler_runs(job_name,started_at,id)")
    c.execute("CREATE INDEX IF NOT EXISTS idx_v124_recovery_order ON v124_recovery_actions(order_id,created_at)")
    ts=now()
    defaults=[
        ('health_scan',60),('alert_scan',60),('notification_process',30),
        ('recovery_scan',60),('finance_reconcile',300)
    ]
    for name,interval in defaults:
        c.execute("INSERT OR IGNORE INTO v124_schedules(id,job_name,interval_seconds,enabled,next_run_at,updated_at) VALUES(?,?,?,?,?,?)",
                  ('sch24_'+uuid.uuid4().hex[:10],name,interval,1,ts,ts))
    c.commit()


def _v124_record_run(c,name,fn):
    rid='run24_'+uuid.uuid4().hex[:12]; started=now()
    c.execute("INSERT INTO v124_scheduler_runs(id,job_name,status,started_at,result_json) VALUES(?,?,?,?,?)",(rid,name,'running',started,'{}'))
    try:
        result=fn(c) or {}; finished=now()
        c.execute("UPDATE v124_scheduler_runs SET status='success',finished_at=?,result_json=? WHERE id=?",(finished,_v122_json(result),rid))
        return {'id':rid,'status':'success','result':result}
    except Exception as exc:
        c.execute("UPDATE v124_scheduler_runs SET status='failed',finished_at=?,error=? WHERE id=?",(now(),str(exc),rid))
        raise


def _v124_recovery_scan(c):
    """Conservative autonomous recovery: only deterministic, reversible dispatch recovery and merchant timeout."""
    t=datetime.now(timezone.utc); actions=[]
    rows=c.execute("SELECT * FROM orders WHERE status='merchant_pending' OR status IN ('assigned','picked_up','out_for_delivery','delayed') ORDER BY created_at LIMIT 200").fetchall()
    for o in rows:
        reason=None; action=None
        if o['status']=='merchant_pending':
            try: age=(t-datetime.fromisoformat(str(o['created_at']).replace('Z','+00:00'))).total_seconds()
            except Exception: age=0
            if age>=600: reason='merchant_timeout'; action='merchant_timeout'
        else:
            loc=c.execute("SELECT recorded_at FROM courier_locations WHERE order_id=? ORDER BY recorded_at DESC LIMIT 1",(o['id'],)).fetchone()
            stale=True
            if loc:
                try: stale=(t-datetime.fromisoformat(str(loc['recorded_at']).replace('Z','+00:00'))).total_seconds()>180
                except Exception: stale=True
            if stale: reason='courier_stale_or_missing'; action='redispatch'
        if not action: continue
        # Avoid repeating the same automated action while it is already reflected in the order/recovery log.
        existing=c.execute("SELECT 1 FROM v124_recovery_actions WHERE order_id=? AND action=? AND status='completed' ORDER BY created_at DESC LIMIT 1",(o['id'],action)).fetchone()
        if existing and action=='merchant_timeout': continue
        cid='auto24_'+uuid.uuid4().hex[:12]
        aid='act24_'+uuid.uuid4().hex[:12]
        c.execute("INSERT INTO v124_recovery_actions VALUES(?,?,?,?,?,?,?,?)",(aid,o['id'],action,reason,'running',cid,now(),None))
        try:
            if action=='merchant_timeout':
                atomic_transition_any(c,o['id'],('merchant_pending',),'cancelled',{'id':'scheduler','role':'ops_agent'},'merchant_timeout',{'reason_code':reason,'schema_version':'1.24','correlation_id':cid})
                c.execute("INSERT INTO order_cancellations VALUES (?,?,?,?,?,?)",('can24_'+uuid.uuid4().hex[:10],o['id'],'scheduler','merchant_rejected','automatic merchant timeout',now()))
            else:
                _v119_reassign_locked(c,o,{'id':'scheduler','role':'ops_agent'},reason)
            c.execute("UPDATE v124_recovery_actions SET status='completed',completed_at=? WHERE id=?",(now(),aid))
            emit(c,o['id'],'autonomous_recovery_completed',{'action':action,'reason':reason,'correlation_id':cid,'schema_version':'1.24'},'scheduler')
            actions.append({'order_id':o['id'],'action':action,'reason':reason,'status':'completed','correlation_id':cid})
        except Exception as exc:
            c.execute("UPDATE v124_recovery_actions SET status='failed',completed_at=? WHERE id=?",(now(),aid))
            actions.append({'order_id':o['id'],'action':action,'reason':reason,'status':'failed','error':str(exc),'correlation_id':cid})
    return {'actions':actions,'count':len(actions)}


def _v124_finance_reconcile(c):
    rows=c.execute("SELECT id FROM orders WHERE status IN ('delivered','cancelled') ORDER BY updated_at DESC LIMIT 200").fetchall()
    checked=0; exceptions=0
    for r in rows:
        snap=_v120_finance_snapshot(c,r['id']); _v120_store_reconciliation(c,snap); checked+=1
        if snap['status']!='reconciled': exceptions+=1
    return {'checked':checked,'exceptions':exceptions}


def _v124_run_job(c,name):
    if name=='health_scan': return _v123_health_scan(c)
    if name=='alert_scan': return _v123_alert_scan(c)
    if name=='notification_process':
        queued=_v122_queue_deliveries(c,200); processed=_v122_process_deliveries(c,300)
        return {'queued_count':len(queued),**processed}
    if name=='recovery_scan': return _v124_recovery_scan(c)
    if name=='finance_reconcile': return _v124_finance_reconcile(c)
    raise ValueError('unknown job')


@app.post('/api/v124/ops/scheduler/tick')
def v124_scheduler_tick(authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    now_dt=datetime.now(timezone.utc); ran=[]
    with core_db_connect() as c:
        c.execute('BEGIN')
        due=c.execute("SELECT * FROM v124_schedules WHERE enabled=1 AND next_run_at<=? ORDER BY next_run_at,id LIMIT 20",(now(),)).fetchall()
        for srow in due:
            name=srow['job_name']
            try:
                result=_v124_record_run(c,name,lambda cx,n=name:_v124_run_job(cx,n))
                status='success'; error=None
            except Exception as exc:
                result={'status':'failed','error':str(exc)}; status='failed'; error=str(exc)
            next_dt=now_dt+__import__('datetime').timedelta(seconds=int(srow['interval_seconds']))
            c.execute("UPDATE v124_schedules SET last_run_at=?,last_status=?,next_run_at=?,updated_at=? WHERE id=?",(now(),status,next_dt.isoformat(),now(),srow['id']))
            ran.append({'job_name':name,**result})
        c.commit()
    return {'schema_version':'1.24','ran_count':len(ran),'runs':ran}


@app.get('/api/v124/ops/scheduler')
def v124_scheduler(authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        schedules=[dict(x) for x in c.execute('SELECT * FROM v124_schedules ORDER BY job_name').fetchall()]
        runs=[dict(x) for x in c.execute('SELECT * FROM v124_scheduler_runs ORDER BY started_at DESC,id DESC LIMIT 100').fetchall()]
        recovery=[dict(x) for x in c.execute('SELECT * FROM v124_recovery_actions ORDER BY created_at DESC LIMIT 100').fetchall()]
        return {'schema_version':'1.24','schedules':schedules,'runs':runs,'recovery_actions':recovery}


@app.post('/api/v124/ops/scheduler/{job_name}/toggle')
def v124_scheduler_toggle(job_name:str, body:dict[str,Any]|None=None, authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
