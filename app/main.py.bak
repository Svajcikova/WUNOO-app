    )""")
    c.execute("""CREATE TABLE IF NOT EXISTS courier_dispatch_stats(
        courier_id TEXT PRIMARY KEY,
        offered_count INTEGER NOT NULL DEFAULT 0,
        accepted_count INTEGER NOT NULL DEFAULT 0,
        declined_count INTEGER NOT NULL DEFAULT 0,
        expired_count INTEGER NOT NULL DEFAULT 0
    )""")
    cols={r[1] for r in c.execute("PRAGMA table_info(courier_offers)").fetchall()}
    if "expires_at" not in cols:
        c.execute("ALTER TABLE courier_offers ADD COLUMN expires_at TEXT")
    if "fallback_reason" not in cols:
        c.execute("ALTER TABLE courier_offers ADD COLUMN fallback_reason TEXT")
    c.execute("CREATE INDEX IF NOT EXISTS idx_offer_expiry ON courier_offers(status,expires_at)")
    c.commit()



def _v043_rank_couriers(c, order):
    base=courier_candidates(c,order)
    ranked=[]
    for x in base:
        courier_id=x["courier_id"]
        active=c.execute("""SELECT COUNT(*) n FROM orders
            WHERE courier_id=? AND status IN ('assigned','picked_up','out_for_delivery','delayed')""",(courier_id,)).fetchone()["n"]
        settings=c.execute("SELECT * FROM courier_dispatch_settings WHERE courier_id=?",(courier_id,)).fetchone()
        max_active=int(settings["max_active_orders"]) if settings else 2
        if active>=max_active: continue
        stats=c.execute("SELECT * FROM courier_dispatch_stats WHERE courier_id=?",(courier_id,)).fetchone()
        acceptance=(float(stats["accepted_count"])/float(stats["offered_count"])) if stats and stats["offered_count"] else x["acceptance_probability"]
        load_penalty=min(35,active*12)
        final=round(x["dispatch_score"] - load_penalty + acceptance*8,2)
        x={**x,"active_orders":active,"acceptance_rate":round(acceptance,3),"final_score":final}
        ranked.append(x)
    ranked.sort(key=lambda z:(-z["final_score"],z["pickup_eta_minutes"],z["distance_km"],z["courier_id"]))
    for i,x in enumerate(ranked,1): x["rank"]=i
    return ranked

def _v043_expire_offers(c):
    from datetime import datetime, timezone
    rows=c.execute("""SELECT * FROM courier_offers WHERE status='offered' AND expires_at IS NOT NULL""").fetchall()
    changed=[]
    for o in rows:
        try:
            exp=datetime.fromisoformat(str(o["expires_at"]).replace("Z","+00:00"))
            if datetime.now(timezone.utc) >= exp:
                c.execute("UPDATE courier_offers SET status='expired',response_reason='timeout',responded_at=? WHERE id=?",(now(),o["id"]))
                c.execute("""INSERT INTO courier_dispatch_stats(courier_id,offered_count,accepted_count,declined_count,expired_count)
                             VALUES (?,?,0,0,1)
                             ON CONFLICT(courier_id) DO UPDATE SET expired_count=expired_count+1""",(o["courier_id"],1))
                emit(c,o["order_id"],"courier_offer_expired",{"offer_id":o["id"],"courier_id":o["courier_id"]},None)
                changed.append(o["id"])
        except Exception:
            continue
    if changed: c.commit()
    return changed



