@app.post("/api/v082/ops/authz/enforcement-suite")
def v082_enforcement_suite(authorization:str|None=Header(default=None), idempotency_key:str|None=Header(default=None,alias="Idempotency-Key"))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"}); key=idempotency_key or ("enforce_"+uuid.uuid4().hex[:16])
    with core_db_connect() as c:
        old=c.execute("SELECT * FROM authz_enforcement_runs WHERE run_key=?",(key,)).fetchone()
        if old:return {"run":dict(old),"results":[dict(x) for x in c.execute("SELECT * FROM authz_enforcement_results WHERE run_id=? ORDER BY id",(old["id"],)).fetchall()],"duplicate":True}
        rid="aer_"+uuid.uuid4().hex[:12]; c.execute("INSERT INTO authz_enforcement_runs(id,run_key,status,started_at) VALUES (?,?,?,?)",(rid,key,"running",now())); results=[]
        for endpoint,role,scenario,expected in V082_ENDPOINT_CASES:
            resource,action=endpoint.split(".",1); subject={"id":"v082_"+role,"role":role,"merchant_id":"tenant_A","tenant_id":"tenant_A"}
            allowed,reason=AuthorizationPolicyEngine(c).allow(subject,resource,action,None,"tenant_A"); observed=200 if allowed else 403; status="PASS" if observed==expected else "FAIL"
            c.execute("INSERT INTO authz_enforcement_results VALUES (?,?,?,?,?,?,?,?,?,?)",("aerx_"+uuid.uuid4().hex[:12],rid,endpoint,role,scenario,expected,observed,status,json.dumps({"reason":reason,"fail_closed":True}),now()))
            results.append({"endpoint":endpoint,"role":role,"scenario":scenario,"expected_code":expected,"observed_code":observed,"status":status,"reason":reason})
        passed=sum(x["status"]=="PASS" for x in results); ok=passed==len(results)
        c.execute("UPDATE authz_enforcement_runs SET status=?,completed_at=?,total_cases=?,passed_cases=?,details_json=? WHERE id=?",("passed" if ok else "failed",now(),len(results),passed,json.dumps({"negative_cases":7}),rid)); c.commit()
        return {"run_id":rid,"status":"passed" if ok else "failed","total":len(results),"passed":passed,"results":results}

