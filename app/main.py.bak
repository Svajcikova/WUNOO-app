@app.post("/api/v058/checkout/quote")
def v058_checkout_quote(body:dict[str,Any], authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"customer"})
    items=body.get("items") or []
    merchant_id=str(body.get("merchant_id","")).strip()
    promo=str(body.get("promo_code","")).strip().upper()
    if not merchant_id or not items: raise HTTPException(400,"merchant_id a items jsou povinné")
    with core_db_connect() as c:
        total_items=0.0; normalized=[]
        for item in items:
            pid=str(item.get("product_id","")); qty=int(item.get("qty",1))
            if qty<1 or qty>50: raise HTTPException(400,"Neplatné množství")
            p=c.execute("SELECT * FROM catalog_products WHERE id=? AND merchant_id=? AND available=1",(pid,merchant_id)).fetchone()
            if not p: raise HTTPException(409,"Produkt není dostupný")
            mods=item.get("modifiers") or []
            mod_total=0.0; mod_norm=[]
            for mid in mods:
                m=c.execute("SELECT * FROM catalog_modifiers WHERE id=? AND product_id=?",(str(mid),pid)).fetchone()
                if not m: raise HTTPException(409,"Neplatný modifier")
                mod_total+=float(m["price_delta_czk"]);mod_norm.append({"id":m["id"],"name":m["name"],"price_delta_czk":m["price_delta_czk"]})
            unit=round(float(p["price_czk"])+mod_total,2); line=round(unit*qty,2)
            total_items+=line
            normalized.append({"product_id":pid,"name":p["name"],"qty":qty,"unit_price_czk":unit,"line_total_czk":line,"modifiers":mod_norm})
        subtotal=round(total_items,2)
        delivery_fee=39.0 if subtotal<399 else 0.0
        service_fee=round(subtotal*0.05,2)
        discount=0.0
        if promo:
            pc=c.execute("SELECT * FROM promo_codes WHERE code=? AND active=1",(promo,)).fetchone()
            if not pc: raise HTTPException(400,"Promo kód není platný")
            if subtotal<float(pc["min_subtotal_czk"]): raise HTTPException(400,"Nesplněné minimum pro promo kód")
            if pc["expires_at"] and pc["expires_at"]<now(): raise HTTPException(400,"Promo kód expiroval")
            discount=(subtotal*float(pc["value"])/100) if pc["discount_type"]=="percent" else float(pc["value"])
            if pc["max_discount_czk"] is not None: discount=min(discount,float(pc["max_discount_czk"]))
            discount=min(discount,subtotal+delivery_fee+service_fee)
        total=round(subtotal+delivery_fee+service_fee-discount,2)
        qid="quote_"+uuid.uuid4().hex[:12]
        # Quote expires in 10 minutes; SQLite datetime format is UTC-like app now().
        import datetime
        expires=(datetime.datetime.utcnow()+datetime.timedelta(minutes=10)).isoformat(timespec="seconds")
        c.execute("INSERT INTO checkout_quotes VALUES (?,?,?,?,?,?,?,?,?,?,?,?)",
                  (qid,u["customer_id"],merchant_id,json.dumps(normalized,ensure_ascii=False),subtotal,delivery_fee,service_fee,round(discount,2),total,"CZK","quoted",expires,now()))
        c.commit()
        return {"quote_id":qid,"merchant_id":merchant_id,"items":normalized,"subtotal_czk":subtotal,
                "delivery_fee_czk":delivery_fee,"service_fee_czk":service_fee,"discount_czk":round(discount,2),
                "total_czk":total,"currency":"CZK","expires_at":expires}

@app.post("/api/v058/checkout/confirm")
def v058_checkout_confirm(body:dict[str,Any], authorization:str|None=Header(default=None), idempotency_key:str|None=Header(default=None,alias="Idempotency-Key"))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"customer"})
    qid=str(body.get("quote_id","")).strip()
    if not qid: raise HTTPException(400,"quote_id je povinné")
    with core_db_connect() as c:
        cached=_v052_guard(c,f"checkout-confirm:{u['id']}",idempotency_key,{"quote_id":qid})
        if cached is not None: return cached
        q=c.execute("SELECT * FROM checkout_quotes WHERE id=? AND customer_id=?",(qid,u["customer_id"])).fetchone()
        if not q: raise HTTPException(404,"Checkout quote nenalezen")
        if q["status"]!="quoted" or q["expires_at"]<now(): raise HTTPException(409,"Checkout quote je neplatný nebo expirovaný")
        oid="ord_"+uuid.uuid4().hex[:12]
        c.execute("""INSERT INTO orders
                     (id,customer_id,merchant_id,courier_id,status,total_czk,fulfillment_mode,promised_at,created_at,updated_at)
                     VALUES (?,?,?,?,?,?,?,?,?,?)""",
                  (oid,u["customer_id"],q["merchant_id"],None,"payment_pending",q["total_czk"],"delivery",q["expires_at"],now(),now()))
        emit(c,oid,"order_created",{"source":"checkout_v058","quote_id":qid,"subtotal_czk":q["subtotal_czk"],
                                   "delivery_fee_czk":q["delivery_fee_czk"],"service_fee_czk":q["service_fee_czk"],
                                   "discount_czk":q["discount_czk"],"total_czk":q["total_czk"]},u["id"])
        c.execute("UPDATE checkout_quotes SET status='confirmed' WHERE id=?",(qid,))
        result={"order_id":oid,"quote_id":qid,"status":"payment_pending","total_czk":q["total_czk"],"currency":"CZK"}
        _v052_store(c,f"checkout-confirm:{u['id']}",idempotency_key,{"quote_id":qid},result)
        _v052_audit(c,u["id"],"checkout_confirm","order",oid,{"quote_id":qid,"total_czk":q["total_czk"]})
        c.commit()
        return result

