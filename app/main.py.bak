@app.get("/api/v053/health/ready")
def v053_readiness():
    checks={}
    try:
        with core_db_connect() as c:
            c.execute("SELECT 1").fetchone()
            for table in ("orders","payments","background_jobs","app_logs"):
                c.execute(f"SELECT 1 FROM {table} LIMIT 1")
                checks[table]="ok"
    except Exception as exc:
        checks["database"]=f"error:{exc}"
    return {"ready":all(v=="ok" for v in checks.values()),"checks":checks,"version":"0.53.0"}

@app.post("/api/v053/jobs")
def v053_enqueue_job(body:dict[str,Any], authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    queue=str(body.get("queue","default")).strip()
    job_type=str(body.get("job_type","")).strip()
    if not job_type: raise HTTPException(400,"job_type je povinný")
    with core_db_connect() as c:
        jid=_v053_enqueue(c,queue,job_type,body.get("payload") or {})
        _v053_log(c,"info","job_enqueued",None,{"job_id":jid,"queue":queue,"job_type":job_type})
        c.commit()
        return {"job_id":jid,"status":"queued"}

@app.post("/api/v053/worker/run")
def v053_worker_run(limit:int=10, authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    limit=max(1,min(int(limit),50))
    processed=[]; failed=[]
    with core_db_connect() as c:
        rows=c.execute("""SELECT * FROM background_jobs
                          WHERE status='queued' AND available_at<=?
                          ORDER BY created_at LIMIT ?""",(now(),limit)).fetchall()
        for job in rows:
            try:
                c.execute("UPDATE background_jobs SET status='running',locked_at=?,attempts=attempts+1 WHERE id=? AND status='queued'",(now(),job["id"]))
                # v0.53 worker is intentionally transport-agnostic; registered job types can be added
                # without coupling queue storage to external infrastructure.
                if job["job_type"] not in {"notification.process","reliability.sweep","payment.reconcile","noop"}:
                    raise ValueError("unknown job_type")
                if job["job_type"]=="notification.process":
                    _v048_process_jobs(c,100)
                elif job["job_type"]=="reliability.sweep":
                    _v046_reliability_sweep(authorization)
                elif job["job_type"]=="payment.reconcile":
                    orders=c.execute("SELECT id FROM orders WHERE status NOT IN ('cancelled',) ORDER BY updated_at DESC LIMIT 100").fetchall()
                    for o in orders: _v049_reconcile_order(c,o["id"])
                c.execute("UPDATE background_jobs SET status='succeeded',finished_at=?,locked_at=NULL WHERE id=?",(now(),job["id"]))
                _v053_log(c,"info","job_succeeded",None,{"job_id":job["id"],"job_type":job["job_type"]})
                processed.append(job["id"])
            except Exception as exc:
                attempts=int(job["attempts"])+1
                status="dead" if attempts>=int(job["max_attempts"]) else "queued"
                c.execute("UPDATE background_jobs SET status=?,last_error=?,locked_at=NULL,available_at=? WHERE id=?",
                          (status,str(exc),now(),job["id"]))
                _v053_log(c,"error","job_failed",None,{"job_id":job["id"],"error":str(exc),"attempts":attempts})
                failed.append({"job_id":job["id"],"status":status})
        c.commit()
    return {"processed":processed,"failed":failed}

