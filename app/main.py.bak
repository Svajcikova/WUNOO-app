    c.commit()


def _v135_request_layer_scan() -> dict[str, Any]:
    """Static AST inventory of direct conn() calls inside request functions.

    This deliberately reports technical debt instead of guessing whether a route
    is production-critical. Migration/startup helpers are separated from HTTP
    handlers so the remaining request-layer SQLite surface is measurable.
    """
    import ast
    source = Path(__file__).read_text(encoding="utf-8")
    tree = ast.parse(source)
    request = []
    non_request = []
    for node in ast.walk(tree):
        if not isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
            continue
        has_conn = any(
            isinstance(x, ast.Call) and isinstance(x.func, ast.Name) and x.func.id == "conn"
            for x in ast.walk(node)
            if x is not node
        )
        if not has_conn:
            continue
        routes = []
        for dec in node.decorator_list:
            if isinstance(dec, ast.Call) and isinstance(dec.func, ast.Attribute) and dec.func.attr in {"get","post","put","patch","delete","options","head"}:
                if dec.args and isinstance(dec.args[0], ast.Constant):
                    routes.append(str(dec.args[0].value))
        item = {"function": node.name, "routes": routes, "line": node.lineno}
        (request if routes else non_request).append(item)
    request.sort(key=lambda x: x["line"])
    non_request.sort(key=lambda x: x["line"])
    migrated_auth = {"/api/login", "/api/logout", "/api/me"}
    remaining = [x for x in request if not migrated_auth.intersection(x["routes"])]
    return {
        "api_version": "1.35",
        "scanner": "ast-direct-conn-request-layer",
        "direct_conn_request_functions": len(request),
        "remaining_request_functions": len(remaining),
        "migrated_legacy_auth_routes": sorted(migrated_auth),
        "remaining": remaining,
        "non_request_direct_conn_functions": non_request,
    }


# ---------------- v1.138 Customer Menu Integrity ----------------
_V138_CUSTOMER_MENU_INTEGRITY_POLICY = {
    'schema_version':'1.138',
    'purpose':'pin customer cart and checkout to exact LIVE merchant menu publication',
    'fail_closed_on_publication_change':True,
    'price_source':'LIVE_publication_snapshot',
    'sold_out_guard':True,
    'tenant_isolated':True,
}


def _v138_live_publication(c, merchant_id):
    row=c.execute("""SELECT id,merchant_id,publication_no,snapshot_sha256,snapshot_json,status,created_at,actor_user_id
                    FROM merchant_menu_publications WHERE merchant_id=? AND status='LIVE'
                    ORDER BY publication_no DESC,id DESC LIMIT 1""",(merchant_id,)).fetchone()
    return row


def _v138_cart_integrity(c, customer_id):
    rows=c.execute("""SELECT ci.id,ci.menu_item_id,ci.qty,ci.merchant_id,ci.menu_publication_no,ci.menu_snapshot_sha256,
                            ci.unit_price_snapshot_czk,ci.menu_item_name_snapshot
                     FROM cart_items ci WHERE ci.customer_id=? ORDER BY ci.id""",(customer_id,)).fetchall()
    if not rows:
        return {'valid':True,'empty':True,'merchant_id':None,'issues':[],'live_publication_no':None,'live_snapshot_sha256':None,'items':[]}
    merchants={r['merchant_id'] for r in rows}
    if len(merchants)!=1:
        return {'valid':False,'empty':False,'merchant_id':None,'issues':[{'code':'MULTIPLE_MERCHANTS'}], 'live_publication_no':None,'live_snapshot_sha256':None,'items':[]}
    merchant_id=next(iter(merchants)); live=_v138_live_publication(c,merchant_id)
    if not live:
        return {'valid':False,'empty':False,'merchant_id':merchant_id,'issues':[{'code':'NO_LIVE_PUBLICATION'}],'live_publication_no':None,'live_snapshot_sha256':None,'items':[]}
    snap=json.loads(live['snapshot_json']); items={str(x.get('id')):x for x in snap.get('items',[])}; issues=[]; out=[]
    for r in rows:
        live_item=items.get(str(r['menu_item_id']))
        if not live_item:
            issues.append({'code':'ITEM_REMOVED','menu_item_id':r['menu_item_id']}); continue
        if r['menu_publication_no'] is None or int(r['menu_publication_no'])!=int(live['publication_no']) or r['menu_snapshot_sha256']!=live['snapshot_sha256']:
            issues.append({'code':'PUBLICATION_CHANGED','menu_item_id':r['menu_item_id'],'cart_publication_no':r['menu_publication_no'],'live_publication_no':int(live['publication_no'])})
        if str((live_item.get('availability') or {}).get('state','AVAILABLE'))=='SOLD_OUT':
            issues.append({'code':'ITEM_SOLD_OUT','menu_item_id':r['menu_item_id']})
        if round(float(r['unit_price_snapshot_czk'] if r['unit_price_snapshot_czk'] is not None else live_item.get('price_czk',0)),2) != round(float(live_item.get('price_czk',0)),2):
            issues.append({'code':'PRICE_SNAPSHOT_MISMATCH','menu_item_id':r['menu_item_id']})
        out.append({'menu_item_id':r['menu_item_id'],'qty':int(r['qty']),'name':live_item.get('name'), 'unit_price_czk':float(live_item.get('price_czk',0))})
    return {'valid':not issues,'empty':False,'merchant_id':merchant_id,'issues':issues,'live_publication_no':int(live['publication_no']),'live_snapshot_sha256':live['snapshot_sha256'],'items':out}


@app.get('/api/v138/customer/cart-integrity')
def v138_customer_cart_integrity(authorization: str|None=Header(default=None)):
