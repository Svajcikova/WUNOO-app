@app.post("/api/v042/orders")
def v042_create_order(body: dict[str,Any], authorization: str | None = Header(default=None)) -> dict[str,Any]:
    u=current_user(authorization); require_role(u,"customer")
    items=body.get("items") or []
    if not items: raise HTTPException(400,"Košík je prázdný")
    address_id=body.get("address_id")
    if not address_id: raise HTTPException(400,"address_id je povinné")
    fulfillment_mode=str(body.get("fulfillment_mode","asap"))
    scheduled_for=body.get("scheduled_for")
    if fulfillment_mode not in {"asap","scheduled"}: raise HTTPException(400,"Neplatný fulfillment_mode")
    with core_db_connect() as c:
        addr=c.execute("SELECT * FROM customer_addresses WHERE id=? AND customer_id=?",(address_id,u["customer_id"])).fetchone()
        if not addr: raise HTTPException(400,"Adresa nenalezena")
        merchant_ids=set()
        snapshots=[]
        subtotal=0.0
        for raw in items:
            mid=raw.get("menu_item_id"); qty=int(raw.get("qty",1))
            if qty<1 or qty>20: raise HTTPException(400,"Neplatné množství")
            mi=c.execute("SELECT id,merchant_id,name,price_czk,active FROM menu_items WHERE id=?",(mid,)).fetchone()
            if not mi or not mi["active"]: raise HTTPException(409,"Menu položka není dostupná")
            merchant_ids.add(mi["merchant_id"])
            snapshots.append((mi,qty))
            subtotal += float(mi["price_czk"])*qty
        if len(merchant_ids)!=1: raise HTTPException(409,"Objednávka může být jen z jedné restaurace")
        merchant_id=next(iter(merchant_ids))
        live_pub=_v138_live_publication(c,merchant_id) if _db_table_exists(c,'merchant_menu_publications') else None
        if live_pub:
            live_snap=json.loads(live_pub['snapshot_json']); live_items={str(x.get('id')):x for x in live_snap.get('items',[])}
            for mi,qty in snapshots:
                li=live_items.get(str(mi['id']))
                if not li:
                    raise HTTPException(409,{'code':'MENU_CHANGED_REQUOTE','message':'Menu položka už není v aktuálním publikovaném menu','menu_item_id':mi['id']})
                if str((li.get('availability') or {}).get('state','AVAILABLE'))=='SOLD_OUT':
                    raise HTTPException(409,{'code':'ITEM_SOLD_OUT','menu_item_id':mi['id']})
                # Canonical order price must come from the current LIVE snapshot, never the mutable draft row.
                mi_live_price=float(li.get('price_czk',0))
                if round(float(mi['price_czk']),2)!=round(mi_live_price,2):
                    raise HTTPException(409,{'code':'MENU_PRICE_CHANGED','message':'Cena položky se změnila. Obnovte košík a quote.','menu_item_id':mi['id'],'live_publication_no':int(live_pub['publication_no'])})
            pricing_version=f"v1.138_menu_{live_pub['snapshot_sha256'][:12]}"
        else:
            pricing_version="v042_snapshot"
        if fulfillment_mode=="scheduled" and not scheduled_for:
            raise HTTPException(400,"scheduled_for je povinné")
        oid="o_"+uuid.uuid4().hex[:10]
        # Minimal canonical order; modifiers remain handled by v0.37 endpoint if used.
        c.execute("""INSERT INTO orders(id,customer_id,merchant_id,status,subtotal_czk,delivery_fee_czk,
                     service_fee_czk,pro_discount_czk,total_czk,pricing_version,created_at,updated_at,
                     fulfillment_mode,scheduled_for,schedule_status)
                     VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)""",
                  (oid,u["customer_id"],merchant_id,"merchant_pending",round(subtotal,2),0,0,0,round(subtotal,2),
                   pricing_version,now(),now(),fulfillment_mode,
                   scheduled_for if fulfillment_mode=="scheduled" else None,
                   "pending" if fulfillment_mode=="scheduled" else "none"))
        for mi,qty in snapshots:
            oi="oi_"+uuid.uuid4().hex[:10]
            if live_pub:
                li=live_items[str(mi['id'])]; unit=float(li.get('price_czk',0)); name_snapshot=str(li.get('name') or mi['name'])
            else:
                unit=float(mi['price_czk']); name_snapshot=mi['name']
            line=round(unit*qty,2)
            c.execute("INSERT INTO order_items(id,order_id,menu_item_id,name_snapshot,unit_price_czk,qty,line_total_czk) VALUES (?,?,?,?,?,?,?)",
                      (oi,oid,mi["id"],name_snapshot,unit,qty,line))
        snap=_v042_attach_promise(c,oid,merchant_id,fulfillment_mode,scheduled_for)
        c.commit()
        return {"order_id":oid,"fulfillment_mode":fulfillment_mode,"scheduled_for":scheduled_for,
                "subtotal_czk":round(subtotal,2),"promise":snap}


@app.get("/api/v042/dispatch-queue")
def v042_dispatch_queue(authorization: str | None = Header(default=None)) -> dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops","courier"})
    with core_db_connect() as c:
        rows=c.execute("""SELECT * FROM orders
                          WHERE status IN ('dispatch_pending','merchant_pending','preparing')
                          ORDER BY created_at""").fetchall()
        data=[dict(x) for x in rows]
        data.sort(key=lambda o:_v042_dispatch_score(c,o))
        return {"orders":data}


