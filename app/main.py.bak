        id TEXT PRIMARY KEY, merchant_id TEXT NOT NULL, publication_id TEXT,
        action TEXT NOT NULL, draft_sha256 TEXT NOT NULL, live_sha256 TEXT,
        exact INTEGER NOT NULL DEFAULT 0, actor_user_id TEXT, created_at TEXT NOT NULL
