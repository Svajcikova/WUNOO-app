@app.post('/api/v189/ops/federation-quorum/propose')
def v189_propose(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin'});p=payload or {};operator=str(u.get('email') or u.get('id') or 'operator')
    with core_db_connect() as c:
        fid=str(p.get('federation_id') or '');eid=p.get('epoch_id');fed,obj,details=_v189_assess(c,fid,eid);toq=int(p.get('to_quorum') or 0);minimum=_v189_min_quorum(obj['member_count']);eligible=obj['eligible_witness_ids']
        if toq<minimum:raise HTTPException(409,'REBALANCE_BELOW_BFT_MINIMUM')
        if toq>len(eligible):raise HTTPException(409,'REBALANCE_QUORUM_EXCEEDS_ELIGIBLE')
        current=int(obj['current_quorum'])
        if toq==current:raise HTTPException(409,'REBALANCE_NO_CHANGE')
        reason=str(p.get('reason') or 'DYNAMIC_TRUST_REBALANCE');required=current if current<=len(eligible) else len(eligible)
        if required<minimum:raise HTTPException(409,'REBALANCE_APPROVAL_QUORUM_UNSAFE')
        excluded=obj['excluded_witness_ids'];pr={'format':_V189_POLICY['proposal_format'],'schema_version':'1.89','federation_id':fid,'federation_sha256':fed['federation_sha256'],'epoch_id':eid,'from_quorum':current,'to_quorum':toq,'minimum_quorum':minimum,'reason':reason,'eligible_witness_ids':eligible,'excluded_witness_ids':excluded,'required_approvals':required,'assessment_basis_sha256':_v189_hash(obj)};digest=_v189_hash(pr)
        ex=c.execute('SELECT * FROM production_federation_quorum_rebalance_proposals WHERE proposal_sha256=?',(digest,)).fetchone()
        if ex:return {'schema_version':'1.89','idempotent':True,'proposal':dict(ex)}
        pid='fqp_'+uuid.uuid4().hex[:16];t=now();c.execute('INSERT INTO production_federation_quorum_rebalance_proposals(id,federation_id,epoch_id,from_quorum,to_quorum,reason,eligible_witness_ids_json,excluded_witness_ids_json,required_approvals,status,proposal_json,proposal_sha256,created_at,finalized_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(pid,fid,eid,current,toq,reason,_v189_json(eligible),_v189_json(excluded),required,'PROPOSED',_v189_json(pr),digest,t,None,operator));c.commit();r=c.execute('SELECT * FROM production_federation_quorum_rebalance_proposals WHERE id=?',(pid,)).fetchone();return {'schema_version':'1.89','idempotent':False,'proposal':dict(r)}

@app.post('/api/v189/ops/federation-quorum/approve')
def v189_approve(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin'});p=payload or {};operator=str(u.get('email') or u.get('id') or 'operator')
    with core_db_connect() as c:
        pr=c.execute('SELECT * FROM production_federation_quorum_rebalance_proposals WHERE id=?',(p.get('proposal_id'),)).fetchone()
        if not pr:raise HTTPException(404,'PROPOSAL_NOT_FOUND')
        if pr['status']!='PROPOSED':raise HTTPException(409,'PROPOSAL_NOT_OPEN')
        wid=str(p.get('witness_id') or '');kid=str(p.get('key_id') or '');pb=str(p.get('public_key_b64') or '');sig=str(p.get('signature_b64') or '')
        members=json.loads(pr['eligible_witness_ids_json'] or '[]')
        if wid not in members:raise HTTPException(409,'APPROVER_NOT_ELIGIBLE')
        hist=_v176_history(c,wid,kid)
        if not hist or hist['public_key_b64']!=pb:raise HTTPException(409,'APPROVER_KEY_INVALID')
        obj=_v189_approval_payload(pr,wid,kid)
        ok,reason=_v188_verify_signed_payload(c,wid,kid,obj,sig)
        if not ok:raise HTTPException(409,'APPROVAL_'+reason)
        digest=_v189_hash(obj);ex=c.execute('SELECT * FROM production_federation_quorum_rebalance_approvals WHERE proposal_id=? AND witness_id=?',(pr['id'],wid)).fetchone()
        if ex:return {'schema_version':'1.89','idempotent':True,'approval':dict(ex),'verification':_v189_verify_approval(c,ex)}
        aid='fqa_'+uuid.uuid4().hex[:16];t=now();c.execute('INSERT INTO production_federation_quorum_rebalance_approvals(id,proposal_id,federation_id,witness_id,key_id,public_key_b64,signature_b64,approval_json,approval_sha256,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?)',(aid,pr['id'],pr['federation_id'],wid,kid,pb,sig,_v189_json(obj),digest,'VERIFIED',t,operator));c.commit();r=c.execute('SELECT * FROM production_federation_quorum_rebalance_approvals WHERE id=?',(aid,)).fetchone();return {'schema_version':'1.89','idempotent':False,'approval':dict(r),'verification':_v189_verify_approval(c,r)}

@app.post('/api/v189/ops/federation-quorum/finalize')
def v189_finalize(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin'});p=payload or {};operator=str(u.get('email') or u.get('id') or 'operator')
    with core_db_connect() as c:
        pr=c.execute('SELECT * FROM production_federation_quorum_rebalance_proposals WHERE id=?',(p.get('proposal_id'),)).fetchone()
        if not pr:raise HTTPException(404,'PROPOSAL_NOT_FOUND')
        if pr['status']=='APPROVED_FOR_NEXT_EPOCH':return {'schema_version':'1.89','idempotent':True,'proposal':dict(pr),'approvals':[]}
        rows=c.execute('SELECT * FROM production_federation_quorum_rebalance_approvals WHERE proposal_id=? ORDER BY witness_id ASC',(pr['id'],)).fetchall();valid=[r for r in rows if _v189_verify_approval(c,r)['valid']];ids=sorted(set(r['witness_id'] for r in valid));required=int(pr['required_approvals'])
        if len(ids)<required:raise HTTPException(409,'REBALANCE_APPROVAL_QUORUM_NOT_REACHED')
        # Never mutate the historical federation quorum. The approved value is for the next federation epoch only.
        fed=_v170_row(c,'production_global_checkpoint_federations',' WHERE id=?',(pr['federation_id'],),'created_at DESC')
        obj={'format':_V189_POLICY['proposal_format'],'schema_version':'1.89','proposal_id':pr['id'],'federation_id':pr['federation_id'],'federation_sha256':fed['federation_sha256'],'from_quorum':int(pr['from_quorum']),'to_quorum':int(pr['to_quorum']),'required_approvals':required,'approving_witness_ids':ids,'historical_federation_immutable':True}
        signer,pub,keyid=_v169_load_signer();sig=base64.b64encode(signer.sign(_v189_json(obj).encode())).decode();c.execute('UPDATE production_federation_quorum_rebalance_proposals SET status=?,finalized_at=? WHERE id=?',('APPROVED_FOR_NEXT_EPOCH',now(),pr['id']));c.commit();r=c.execute('SELECT * FROM production_federation_quorum_rebalance_proposals WHERE id=?',(pr['id'],)).fetchone();return {'schema_version':'1.89','idempotent':False,'status':'APPROVED_FOR_NEXT_EPOCH','proposal':dict(r),'approving_witness_ids':ids,'decision':{'decision_json':obj,'decision_sha256':_v189_hash(obj),'algorithm':'Ed25519','signer_key_id':keyid,'public_key_b64':base64.b64encode(pub).decode(),'signature_b64':sig}}

@app.get('/api/v189/ops/federation-quorum/verify')
def v189_verify(authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        rows=c.execute('SELECT * FROM production_federation_quorum_assessments ORDER BY federation_id,assessment_no ASC').fetchall();checked=0
        for r in rows:
            vr=_v189_verify_assessment(c,r);checked+=1
            if not vr['valid']:return {'schema_version':'1.89','valid':False,'reason':vr['reason'],'checked':checked}
        ps=c.execute('SELECT * FROM production_federation_quorum_rebalance_proposals ORDER BY created_at ASC,id ASC').fetchall()
        for pr in ps:
            try:
                obj=json.loads(pr['proposal_json'] or '{}')
                if _v189_hash(obj)!=pr['proposal_sha256']:return {'schema_version':'1.89','valid':False,'reason':'PROPOSAL_HASH_INVALID','checked':checked}
                if pr['status']=='APPROVED_FOR_NEXT_EPOCH':
                    apps=c.execute('SELECT * FROM production_federation_quorum_rebalance_approvals WHERE proposal_id=?',(pr['id'],)).fetchall();valid=[r for r in apps if _v189_verify_approval(c,r)['valid']]
                    if len(set(r['witness_id'] for r in valid))<int(pr['required_approvals']):return {'schema_version':'1.89','valid':False,'reason':'FINALIZED_PROPOSAL_APPROVALS_INVALID','checked':checked}
            except Exception:return {'schema_version':'1.89','valid':False,'reason':'PROPOSAL_INVALID','checked':checked}
        return {'schema_version':'1.89','valid':True,'reason':'DYNAMIC_QUORUM_EVIDENCE_VERIFIED','assessments':len(rows),'proposals':len(ps),'checked':checked}


# ---------------- WUNOO v1.90: Dynamic Quorum Epoch Activation & Finality ----------------
def migrate_v190(c):
    c.executescript("""CREATE TABLE IF NOT EXISTS production_federation_epoch_quorum_bindings(
        id TEXT PRIMARY KEY, epoch_id TEXT NOT NULL UNIQUE, federation_id TEXT NOT NULL,
        federation_sha256 TEXT NOT NULL, epoch_sha256 TEXT NOT NULL, source_proposal_id TEXT NOT NULL,
        from_quorum INTEGER NOT NULL, effective_quorum INTEGER NOT NULL, binding_json TEXT NOT NULL,
        binding_sha256 TEXT NOT NULL UNIQUE, algorithm TEXT NOT NULL, signer_key_id TEXT NOT NULL,
        public_key_b64 TEXT NOT NULL, signature_b64 TEXT NOT NULL, status TEXT NOT NULL,
        created_at TEXT NOT NULL, operator TEXT
    );
    CREATE INDEX IF NOT EXISTS idx_v190_quorum_binding_fed ON production_federation_epoch_quorum_bindings(federation_id,created_at);
    CREATE TABLE IF NOT EXISTS production_federation_epoch_dynamic_finality(
        id TEXT PRIMARY KEY, epoch_id TEXT NOT NULL UNIQUE, federation_id TEXT NOT NULL,
        federation_sha256 TEXT NOT NULL, epoch_sha256 TEXT NOT NULL, quorum_required INTEGER NOT NULL,
        witness_count INTEGER NOT NULL, witness_ids_json TEXT NOT NULL, attestation_hashes_json TEXT NOT NULL,
        binding_sha256 TEXT NOT NULL, proof_json TEXT NOT NULL, proof_sha256 TEXT NOT NULL UNIQUE,
        algorithm TEXT NOT NULL, signer_key_id TEXT NOT NULL, public_key_b64 TEXT NOT NULL,
        signature_b64 TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT
    );
    CREATE INDEX IF NOT EXISTS idx_v190_dynamic_finality_fed ON production_federation_epoch_dynamic_finality(federation_id,created_at);
    """)

_V190_POLICY={
    'schema_version':'1.90',
    'binding_format':'wunoo.release.global.checkpoint.federation.epoch.quorum.binding.v1',
    'finality_format':'wunoo.release.global.checkpoint.federation.epoch.dynamic.finality.v1',
    'hash':'SHA-256','algorithm':'Ed25519',
    'approved_proposal_required':True,'historical_epoch_immutable':True,
    'dynamic_quorum_applies_to_next_epoch_only':True,'automatic_quorum_mutation':False,
    'bft_minimum_rule':'floor(2N/3)+1','fail_closed':True,'no_automatic_release':True
}
def _v190_hash(v): return hashlib.sha256(json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()).hexdigest()
def _v190_json(v): return json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False)
def _v190_binding_payload(epoch,fed,proposal):
    return {'format':_V190_POLICY['binding_format'],'schema_version':'1.90','epoch_id':epoch['id'],'epoch_no':int(epoch['epoch_no']),
            'epoch_sha256':epoch['epoch_sha256'],'federation_id':fed['id'],'federation_sha256':fed['federation_sha256'],
            'source_proposal_id':proposal['id'],'proposal_sha256':proposal['proposal_sha256'],
            'from_quorum':int(proposal['from_quorum']),'effective_quorum':int(proposal['to_quorum'])}
def _v190_binding(c,epoch_id):
    return c.execute('SELECT * FROM production_federation_epoch_quorum_bindings WHERE epoch_id=?',(epoch_id,)).fetchone()
def _v190_effective_quorum(c,epoch):
    b=_v190_binding(c,epoch['id'])
    return int(b['effective_quorum']) if b else int(_v170_row(c,'production_global_checkpoint_federations',' WHERE id=?',(epoch['federation_id'],),'created_at DESC')['quorum_required'])
def _v190_verify_binding(c,row):
    try:
        epoch=_v186_epoch(c,row['epoch_id']);
        if not epoch:return {'valid':False,'reason':'BINDING_EPOCH_NOT_FOUND'}
        fed=_v170_row(c,'production_global_checkpoint_federations',' WHERE id=?',(row['federation_id'],),'created_at DESC')
        if not fed:return {'valid':False,'reason':'BINDING_FEDERATION_NOT_FOUND'}
        ev=_v185_verify_epoch(c,epoch); fv=_v184_verify_federation(c,fed)
        if not ev['valid']:return {'valid':False,'reason':'BINDING_EPOCH_INVALID'}
        if not fv['valid']:return {'valid':False,'reason':'BINDING_FEDERATION_INVALID'}
        proposal=c.execute('SELECT * FROM production_federation_quorum_rebalance_proposals WHERE id=?',(row['source_proposal_id'],)).fetchone()
        if not proposal or proposal['status']!='APPROVED_FOR_NEXT_EPOCH':return {'valid':False,'reason':'BINDING_PROPOSAL_NOT_APPROVED'}
        obj=json.loads(row['binding_json'] or '{}');expected=_v190_binding_payload(epoch,fed,proposal)
        if obj!=expected:return {'valid':False,'reason':'BINDING_PAYLOAD_INVALID'}
        if _v190_hash(obj)!=row['binding_sha256']:return {'valid':False,'reason':'BINDING_HASH_INVALID'}
        if row['epoch_sha256']!=epoch['epoch_sha256'] or row['federation_sha256']!=fed['federation_sha256']:return {'valid':False,'reason':'BINDING_STATE_CHANGED'}
        if int(row['effective_quorum'])<_v189_min_quorum(len(json.loads(epoch['member_snapshot_json'] or '[]'))):return {'valid':False,'reason':'BINDING_BELOW_BFT_MINIMUM'}
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto();Ed25519PublicKey.from_public_bytes(base64.b64decode(row['public_key_b64'],validate=True)).verify(base64.b64decode(row['signature_b64'],validate=True),_v190_json(obj).encode())
        return {'valid':True,'reason':'DYNAMIC_QUORUM_BINDING_VERIFIED','effective_quorum':int(row['effective_quorum'])}
    except Exception:return {'valid':False,'reason':'BINDING_INVALID'}
def _v190_dynamic_collect(c,epoch):
    b=_v190_binding(c,epoch['id']);
    if not b:return None,{'valid':False,'reason':'DYNAMIC_QUORUM_BINDING_REQUIRED'}
    bv=_v190_verify_binding(c,b)
    if not bv['valid']:return None,bv
    q=int(b['effective_quorum']);members=json.loads(epoch['member_snapshot_json'] or '[]')
    rows=c.execute('SELECT * FROM production_federation_epoch_attestations WHERE epoch_id=? ORDER BY witness_id ASC,attestation_sha256 ASC',(epoch['id'],)).fetchall();valid=[]
    conflicts=_v188_conflicts(c,epoch['federation_id']);byz=sorted(set(r['witness_id'] for r in conflicts if _v188_verify_conflict(c,r)['valid']))
    for r in rows:
        vr=_v186_verify_attestation(c,r)
        if vr['valid'] and r['witness_id'] not in byz:valid.append(r)
    by={r['witness_id']:r for r in valid}
    if len(by)<q:return None,{'valid':False,'reason':'DYNAMIC_QUORUM_NOT_REACHED','quorum_required':q,'eligible_attestations':len(by),'excluded_byzantine_witness_ids':byz}
    selected=sorted(by.values(),key=lambda r:(r['witness_id'],r['attestation_sha256']))[:q]
    return selected,{'valid':True,'quorum_required':q,'member_count':len(members),'excluded_byzantine_witness_ids':byz}
def _v190_proof(epoch,fed,b,selected):
    return {'format':_V190_POLICY['finality_format'],'schema_version':'1.90','epoch_id':epoch['id'],'epoch_no':int(epoch['epoch_no']),
            'epoch_sha256':epoch['epoch_sha256'],'federation_id':fed['id'],'federation_sha256':fed['federation_sha256'],
            'binding_sha256':b['binding_sha256'],'quorum_required':int(b['effective_quorum']),
            'witness_ids':[r['witness_id'] for r in sorted(selected,key=lambda x:x['witness_id'])],'attestation_hashes':[r['attestation_sha256'] for r in sorted(selected,key=lambda x:x['witness_id'])]}
def _v190_verify_finality(c,row):
    try:
        epoch=_v186_epoch(c,row['epoch_id']);
        if not epoch:return {'valid':False,'reason':'DYNAMIC_FINALITY_EPOCH_NOT_FOUND'}
        fed=_v170_row(c,'production_global_checkpoint_federations',' WHERE id=?',(row['federation_id'],),'created_at DESC');b=_v190_binding(c,epoch['id'])
        if not fed or not b:return {'valid':False,'reason':'DYNAMIC_FINALITY_STATE_MISSING'}
        if not _v185_verify_epoch(c,epoch)['valid'] or not _v184_verify_federation(c,fed)['valid']:return {'valid':False,'reason':'DYNAMIC_FINALITY_BASE_INVALID'}
        bv=_v190_verify_binding(c,b)
        if not bv['valid']:return {'valid':False,'reason':'DYNAMIC_FINALITY_BINDING_INVALID'}
        ids=json.loads(row['witness_ids_json'] or '[]');hashes=json.loads(row['attestation_hashes_json'] or '[]')
        if int(row['quorum_required'])!=int(b['effective_quorum']) or len(ids)!=int(row['witness_count']) or len(ids)!=len(set(ids)) or len(ids)!=len(hashes):return {'valid':False,'reason':'DYNAMIC_FINALITY_QUORUM_INVALID'}
        selected=[]
        for wid,ah in zip(ids,hashes):
            r=c.execute('SELECT * FROM production_federation_epoch_attestations WHERE epoch_id=? AND witness_id=? AND attestation_sha256=?',(epoch['id'],wid,ah)).fetchone()
            if not r or not _v186_verify_attestation(c,r)['valid']:return {'valid':False,'reason':'DYNAMIC_FINALITY_ATTESTATION_INVALID'}
            if any(x['witness_id']==wid and _v188_verify_conflict(c,x)['valid'] for x in _v188_conflicts(c,epoch['federation_id'])):return {'valid':False,'reason':'DYNAMIC_FINALITY_BYZANTINE_WITNESS_INCLUDED'}
            selected.append(r)
        obj=json.loads(row['proof_json'] or '{}');expected=_v190_proof(epoch,fed,b,selected)
        if obj!=expected or _v190_hash(obj)!=row['proof_sha256']:return {'valid':False,'reason':'DYNAMIC_FINALITY_PROOF_INVALID'}
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto();Ed25519PublicKey.from_public_bytes(base64.b64decode(row['public_key_b64'],validate=True)).verify(base64.b64decode(row['signature_b64'],validate=True),_v190_json(obj).encode())
        return {'valid':True,'reason':'DYNAMIC_FEDERATION_EPOCH_FINALITY_VERIFIED','witness_count':len(ids),'quorum_required':int(row['quorum_required'])}
    except Exception:return {'valid':False,'reason':'DYNAMIC_FINALITY_INVALID'}

@app.get('/api/v190/ops/federation-epochs/policy')
def v190_policy(authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'});return _V190_POLICY
@app.post('/api/v190/ops/federation-epochs/activate-rebalance')
def v190_activate_rebalance(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin'});p=payload or {};operator=str(u.get('email') or u.get('id') or 'operator')
    with core_db_connect() as c:
        pr=c.execute('SELECT * FROM production_federation_quorum_rebalance_proposals WHERE id=?',(p.get('proposal_id'),)).fetchone()
        if not pr:raise HTTPException(404,'PROPOSAL_NOT_FOUND')
        if pr['status']!='APPROVED_FOR_NEXT_EPOCH':raise HTTPException(409,'REBALANCE_NOT_APPROVED')
        fed=_v170_row(c,'production_global_checkpoint_federations',' WHERE id=?',(pr['federation_id'],),'created_at DESC')
        if not fed or not _v184_verify_federation(c,fed)['valid']:raise HTTPException(409,'FEDERATION_INVALID')
        prev=_v170_row(c,'production_checkpoint_federation_epochs',order='epoch_no DESC')
        if prev and prev['federation_id']!=fed['id']:raise HTTPException(409,'FEDERATION_EPOCH_FEDERATION_CHANGED')
        existing=c.execute('SELECT * FROM production_checkpoint_federation_epochs WHERE predecessor_epoch_id=?',(prev['id'],)).fetchone() if prev else None
        if existing:
            b=_v190_binding(c,existing['id'])
            if b and b['source_proposal_id']==pr['id']:return {'schema_version':'1.90','idempotent':True,'epoch':dict(existing),'binding':dict(b),'verification':_v190_verify_binding(c,b)}
            raise HTTPException(409,'NEXT_EPOCH_ALREADY_EXISTS')
        members=_v185_members(c,fed);no=(int(prev['epoch_no']) if prev else 0)+1;t=now();obj=_v185_epoch_payload(no,fed,prev,members,t);digest=_v185_hash(obj);signer,pub,keyid=_v169_load_signer();sig=base64.b64encode(signer.sign(_v185_json(obj).encode())).decode();eid='gfe_'+uuid.uuid4().hex[:16]
        c.execute('INSERT INTO production_checkpoint_federation_epochs(id,epoch_no,federation_id,federation_version,federation_sha256,predecessor_epoch_id,predecessor_epoch_sha256,member_snapshot_json,epoch_json,epoch_sha256,algorithm,signer_key_id,public_key_b64,signature_b64,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(eid,no,fed['id'],fed['federation_version'],fed['federation_sha256'],prev['id'] if prev else None,prev['epoch_sha256'] if prev else '0'*64,_v185_json(members),_v185_json(obj),digest,'Ed25519',keyid,base64.b64encode(pub).decode(),sig,'SEALED',t,operator))
        epoch=_v170_row(c,'production_checkpoint_federation_epochs',' WHERE id=?',(eid,),'epoch_no DESC');bo=_v190_binding_payload(epoch,fed,pr);bd=_v190_hash(bo);bsig=base64.b64encode(signer.sign(_v190_json(bo).encode())).decode();bid='fqb_'+uuid.uuid4().hex[:16]
        c.execute('INSERT INTO production_federation_epoch_quorum_bindings(id,epoch_id,federation_id,federation_sha256,epoch_sha256,source_proposal_id,from_quorum,effective_quorum,binding_json,binding_sha256,algorithm,signer_key_id,public_key_b64,signature_b64,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(bid,eid,fed['id'],fed['federation_sha256'],epoch['epoch_sha256'],pr['id'],pr['from_quorum'],pr['to_quorum'],_v190_json(bo),bd,'Ed25519',keyid,base64.b64encode(pub).decode(),bsig,'ACTIVE',t,operator));c.commit();b=_v190_binding(c,eid);return {'schema_version':'1.90','idempotent':False,'epoch':dict(epoch),'binding':dict(b),'verification':_v190_verify_binding(c,b)}
@app.post('/api/v190/ops/federation-epochs/finalize')
def v190_finalize(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin'});p=payload or {};operator=str(u.get('email') or u.get('id') or 'operator')
    with core_db_connect() as c:
        epoch=_v186_epoch(c,p.get('epoch_id'))
        if not epoch:raise HTTPException(404,'EPOCH_NOT_FOUND')
        b=_v190_binding(c,epoch['id'])
        if not b:raise HTTPException(409,'DYNAMIC_QUORUM_BINDING_REQUIRED')
        existing=c.execute('SELECT * FROM production_federation_epoch_dynamic_finality WHERE epoch_id=?',(epoch['id'],)).fetchone()
        if existing:return {'schema_version':'1.90','idempotent':True,'finality':dict(existing),'verification':_v190_verify_finality(c,existing)}
        if not _v193_require_finality_gate(c, epoch): raise HTTPException(409,'RECONCILED_FINALITY_GATE_REQUIRED')
        selected,meta=_v190_dynamic_collect(c,epoch)
        if not selected:raise HTTPException(409,meta['reason'])
        fed=_v170_row(c,'production_global_checkpoint_federations',' WHERE id=?',(epoch['federation_id'],),'created_at DESC');obj=_v190_proof(epoch,fed,b,selected);digest=_v190_hash(obj);signer,pub,keyid=_v169_load_signer();sig=base64.b64encode(signer.sign(_v190_json(obj).encode())).decode();fid='def_'+uuid.uuid4().hex[:16];t=now();ordered=sorted(selected,key=lambda x:x['witness_id']);ids=[r['witness_id'] for r in ordered];ahs=[r['attestation_sha256'] for r in ordered]
        c.execute('INSERT INTO production_federation_epoch_dynamic_finality(id,epoch_id,federation_id,federation_sha256,epoch_sha256,quorum_required,witness_count,witness_ids_json,attestation_hashes_json,binding_sha256,proof_json,proof_sha256,algorithm,signer_key_id,public_key_b64,signature_b64,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(fid,epoch['id'],fed['id'],fed['federation_sha256'],epoch['epoch_sha256'],b['effective_quorum'],len(selected),_v190_json(ids),_v190_json(ahs),b['binding_sha256'],_v190_json(obj),digest,'Ed25519',keyid,base64.b64encode(pub).decode(),sig,'FINAL',t,operator));c.commit();r=c.execute('SELECT * FROM production_federation_epoch_dynamic_finality WHERE id=?',(fid,)).fetchone();return {'schema_version':'1.90','idempotent':False,'finality':dict(r),'verification':_v190_verify_finality(c,r)}
@app.get('/api/v190/ops/federation-epochs/verify')
def v190_verify(authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        bs=c.execute('SELECT * FROM production_federation_epoch_quorum_bindings ORDER BY created_at ASC').fetchall()
        for b in bs:
            vr=_v190_verify_binding(c,b)
            if not vr['valid']:return {'schema_version':'1.90','valid':False,'reason':vr['reason'],'checked_bindings':1}
        fs=c.execute('SELECT * FROM production_federation_epoch_dynamic_finality ORDER BY created_at ASC').fetchall()
        for f in fs:
            vr=_v190_verify_finality(c,f)
            if not vr['valid']:return {'schema_version':'1.90','valid':False,'reason':vr['reason'],'checked_bindings':len(bs),'checked_finality':1}
        return {'schema_version':'1.90','valid':True,'reason':'DYNAMIC_QUORUM_EPOCH_EVIDENCE_VERIFIED','bindings':len(bs),'finality_records':len(fs)}


# ---------------- WUNOO v1.91: Adaptive Trust Recovery ----------------
def migrate_v191(c):
    c.executescript("""CREATE TABLE IF NOT EXISTS production_federation_trust_recovery_assessments(
        id TEXT PRIMARY KEY, federation_id TEXT NOT NULL, epoch_id TEXT, assessment_no INTEGER NOT NULL,
        member_count INTEGER NOT NULL, currently_eligible_count INTEGER NOT NULL, recoverable_count INTEGER NOT NULL,
        pending_recovery_count INTEGER NOT NULL, safety_state TEXT NOT NULL,
        eligible_witness_ids_json TEXT NOT NULL, recoverable_witness_ids_json TEXT NOT NULL,
        pending_witness_ids_json TEXT NOT NULL, assessment_json TEXT NOT NULL,
        assessment_sha256 TEXT NOT NULL UNIQUE, created_at TEXT NOT NULL, operator TEXT,
        UNIQUE(federation_id,assessment_no)
    );
    CREATE INDEX IF NOT EXISTS idx_v191_recovery_assess_fed ON production_federation_trust_recovery_assessments(federation_id,created_at);
    CREATE TABLE IF NOT EXISTS production_federation_trust_recovery_decisions(
        id TEXT PRIMARY KEY, federation_id TEXT NOT NULL, epoch_id TEXT, decision_type TEXT NOT NULL,
        target_witness_id TEXT NOT NULL, target_key_id TEXT, required_quorum INTEGER NOT NULL,
        approving_witness_ids_json TEXT NOT NULL, recovery_event_head_sha256 TEXT NOT NULL,
        decision_json TEXT NOT NULL, decision_sha256 TEXT NOT NULL UNIQUE,
        algorithm TEXT NOT NULL, signer_key_id TEXT NOT NULL, public_key_b64 TEXT NOT NULL,
        signature_b64 TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT
    );
    CREATE INDEX IF NOT EXISTS idx_v191_recovery_decisions_fed ON production_federation_trust_recovery_decisions(federation_id,created_at);
    """)
    cols=[r[1] for r in c.execute("PRAGMA table_info(production_federation_trust_recovery_assessments)").fetchall()]
    if "status" not in cols: c.execute("ALTER TABLE production_federation_trust_recovery_assessments ADD COLUMN status TEXT NOT NULL DEFAULT 'ACTIVE'")

_V191_POLICY={
    'schema_version':'1.91',
    'assessment_format':'wunoo.release.global.checkpoint.federation.adaptive.trust.recovery.assessment.v1',
    'decision_format':'wunoo.release.global.checkpoint.federation.adaptive.trust.recovery.decision.v1',
    'hash':'SHA-256','algorithm':'Ed25519',
    'recovery_requires_explicit_event':True,
    'registry_trust_required':True,
    'byzantine_conflict_blocks_recovery':True,
    'approval_quorum_from_current_federation':True,
    'historical_finality_preserved':True,
    'automatic_reinstatement':False,
    'automatic_quorum_mutation':False,
    'fail_closed':True,'no_automatic_release':True
}
def _v191_hash(v): return hashlib.sha256(json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()).hexdigest()
def _v191_json(v): return json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False)
def _v191_latest_event(c,fid,wid):
    r=c.execute('SELECT * FROM production_federation_recovery_events WHERE federation_id=? AND subject_witness_id=? ORDER BY created_at DESC,id DESC',(fid,wid)).fetchone()
    return r
def _v191_assess(c,fid,epoch_id=None):
    fed=_v170_row(c,'production_global_checkpoint_federations',' WHERE id=?',(fid,),'created_at DESC')
    if not fed: raise HTTPException(404,'FEDERATION_NOT_FOUND')
    if not _v184_verify_federation(c,fed)['valid']: raise HTTPException(409,'FEDERATION_INVALID')
    members=sorted(set(json.loads(fed['member_witness_ids_json'] or '[]')))
    conflicts=_v188_conflicts(c,fid)
    byz=sorted(set(r['witness_id'] for r in conflicts if _v188_verify_conflict(c,r)['valid']))
    eligible=[];recoverable=[];pending=[];details=[]
    for wid in members:
        trust=_v177_evaluate(c,wid); trusted=bool(trust['valid']); ev=_v191_latest_event(c,fid,wid)
        typ=str(ev['event_type']) if ev else None
        failed=typ in {'WITNESS_SUSPENDED','WITNESS_REVOKED','WITNESS_UNAVAILABLE'}
        recovered=typ in {'WITNESS_REINSTATED','WITNESS_REPLACED','QUORUM_RESTORED'}
        blocked=wid in byz
        if trusted and not failed and not blocked: eligible.append(wid)
        elif trusted and failed and not blocked:
            recoverable.append(wid)
        elif failed or blocked or not trusted: pending.append(wid)
        details.append({'witness_id':wid,'trusted':trusted,'latest_recovery_event':typ,'byzantine_conflict':blocked,'currently_eligible':wid in eligible,'recoverable':wid in recoverable,'pending':wid in pending,'recovery_event_id':ev['id'] if ev else None})
    q=int(fed['quorum_required']); minimum=_v189_min_quorum(len(members)); state='SAFE' if len(eligible)>=q and not recoverable and not pending else ('DEGRADED' if len(eligible)>=q else 'UNSAFE')
    payload={'format':_V191_POLICY['assessment_format'],'schema_version':'1.91','federation_id':fid,'federation_sha256':fed['federation_sha256'],'epoch_id':epoch_id,'member_count':len(members),'currently_eligible_count':len(eligible),'recoverable_count':len(recoverable),'pending_recovery_count':len(pending),'current_quorum':q,'minimum_quorum':minimum,'safety_state':state,'eligible_witness_ids':eligible,'recoverable_witness_ids':recoverable,'pending_witness_ids':pending,'byzantine_witness_ids':byz,'recovery_head_sha256':_v187_chain(c,fid)['head_sha256'],'details':details}
    return fed,payload

def _v191_verify_assessment(c,row):
    try:
        obj=json.loads(row['assessment_json'] or '{}')
        if _v191_hash(obj)!=row['assessment_sha256']: return {'valid':False,'reason':'ASSESSMENT_HASH_INVALID'}
        _,cur=_v191_assess(c,row['federation_id'],row['epoch_id'])
        if obj!=cur:return {'valid':False,'reason':'ASSESSMENT_RECOMPUTE_INVALID'}
        return {'valid':True,'reason':'ADAPTIVE_TRUST_ASSESSMENT_VERIFIED'}
    except HTTPException as e:return {'valid':False,'reason':str(e.detail)}
    except Exception:return {'valid':False,'reason':'ASSESSMENT_INVALID'}
def _v191_decision_payload(row,wid,approvers):
    return {'format':_V191_POLICY['decision_format'],'schema_version':'1.91','federation_id':row['federation_id'],'federation_sha256':row['federation_sha256'],'epoch_id':row['epoch_id'],'decision_type':row['decision_type'],'target_witness_id':wid,'target_key_id':row['target_key_id'],'required_quorum':int(row['required_quorum']),'approving_witness_ids':approvers,'recovery_event_head_sha256':row['recovery_event_head_sha256']}

@app.get('/api/v191/ops/trust-recovery/policy')
def v191_policy(authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'});return _V191_POLICY
@app.post('/api/v191/ops/trust-recovery/assess')
def v191_assess_endpoint(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'});p=payload or {};operator=str(u.get('email') or u.get('id') or 'operator')
    with core_db_connect() as c:
        fed,obj=_v191_assess(c,str(p.get('federation_id') or ''),p.get('epoch_id'))
        mx=c.execute('SELECT COALESCE(MAX(assessment_no),0) AS n FROM production_federation_trust_recovery_assessments WHERE federation_id=?',(fed['id'],)).fetchone();no=int(mx['n'])+1;digest=_v191_hash(obj)
        ex=c.execute('SELECT * FROM production_federation_trust_recovery_assessments WHERE assessment_sha256=?',(digest,)).fetchone()
        if ex:return {'schema_version':'1.91','idempotent':True,'assessment':dict(ex)}
        aid='tra_'+uuid.uuid4().hex[:16];c.execute('INSERT INTO production_federation_trust_recovery_assessments(id,federation_id,epoch_id,assessment_no,member_count,currently_eligible_count,recoverable_count,pending_recovery_count,safety_state,eligible_witness_ids_json,recoverable_witness_ids_json,pending_witness_ids_json,assessment_json,assessment_sha256,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(aid,fed['id'],p.get('epoch_id'),no,obj['member_count'],obj['currently_eligible_count'],obj['recoverable_count'],obj['pending_recovery_count'],obj['safety_state'],_v191_json(obj['eligible_witness_ids']),_v191_json(obj['recoverable_witness_ids']),_v191_json(obj['pending_witness_ids']),_v191_json(obj),digest,'ACTIVE',now(),operator));c.execute('UPDATE production_federation_trust_recovery_assessments SET status=? WHERE federation_id=? AND id<>? AND status=?',('SUPERSEDED',fed['id'],aid,'ACTIVE'));c.commit();r=c.execute('SELECT * FROM production_federation_trust_recovery_assessments WHERE id=?',(aid,)).fetchone();return {'schema_version':'1.91','idempotent':False,'assessment':dict(r),'verification':_v191_verify_assessment(c,r)}
@app.post('/api/v191/ops/trust-recovery/reinstate')
def v191_reinstate(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin'});p=payload or {};operator=str(u.get('email') or u.get('id') or 'operator')
    with core_db_connect() as c:
        fid=str(p.get('federation_id') or '');wid=str(p.get('witness_id') or '')
        fed,obj=_v191_assess(c,fid,p.get('epoch_id'))
        if wid not in obj['recoverable_witness_ids']: raise HTTPException(409,'WITNESS_NOT_RECOVERABLE')
        q=int(fed['quorum_required']);approvers=sorted(set(str(x) for x in (p.get('approving_witness_ids') or [])))
        if len(approvers)<q: raise HTTPException(409,'RECOVERY_QUORUM_NOT_REACHED')
        members=json.loads(fed['member_witness_ids_json'] or '[]')
        for aw in approvers:
            if aw not in members or aw==wid: raise HTTPException(409,'APPROVER_NOT_ELIGIBLE')
            rr=c.execute('SELECT * FROM production_external_witness_registry WHERE witness_id=?',(aw,)).fetchone()
            if not rr or rr['status']!='ACTIVE' or not _v177_evaluate(c,aw)['valid']: raise HTTPException(409,'APPROVER_NOT_TRUSTED')
        ev=_v191_latest_event(c,fid,wid)
        if not ev: raise HTTPException(409,'RECOVERY_EVENT_REQUIRED')
        keyid=str(p.get('key_id') or '') or ev['subject_key_id']
        row={'federation_id':fid,'federation_sha256':fed['federation_sha256'],'epoch_id':p.get('epoch_id'),'decision_type':'WITNESS_REINSTATEMENT','target_key_id':keyid,'required_quorum':q,'recovery_event_head_sha256':_v187_chain(c,fid)['head_sha256']}
        objd=_v191_decision_payload(row,wid,approvers);digest=_v191_hash(objd);ex=c.execute('SELECT * FROM production_federation_trust_recovery_decisions WHERE decision_sha256=?',(digest,)).fetchone()
        if ex:return {'schema_version':'1.91','idempotent':True,'decision':dict(ex)}
        signer,pub,skid=_v169_load_signer();sig=base64.b64encode(signer.sign(_v191_json(objd).encode())).decode();did='trd_'+uuid.uuid4().hex[:16];c.execute('INSERT INTO production_federation_trust_recovery_decisions(id,federation_id,epoch_id,decision_type,target_witness_id,target_key_id,required_quorum,approving_witness_ids_json,recovery_event_head_sha256,decision_json,decision_sha256,algorithm,signer_key_id,public_key_b64,signature_b64,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(did,fid,p.get('epoch_id'),'WITNESS_REINSTATEMENT',wid,keyid,q,_v191_json(approvers),row['recovery_event_head_sha256'],_v191_json(objd),digest,'Ed25519',skid,base64.b64encode(pub).decode(),sig,'FINAL',now(),operator));c.commit();r=c.execute('SELECT * FROM production_federation_trust_recovery_decisions WHERE id=?',(did,)).fetchone();return {'schema_version':'1.91','idempotent':False,'decision':dict(r),'verification':{'valid':True,'reason':'ADAPTIVE_TRUST_RECOVERY_DECISION_VERIFIED'}}
@app.get('/api/v191/ops/trust-recovery/verify')
def v191_verify(authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        rows=c.execute('SELECT * FROM production_federation_trust_recovery_assessments WHERE status="ACTIVE" ORDER BY created_at,id').fetchall()
        for i,r in enumerate(rows,1):
            vr=_v191_verify_assessment(c,r)
            if not vr['valid']:return {'schema_version':'1.91','valid':False,'reason':vr['reason'],'checked_assessments':i}
        ds=c.execute('SELECT * FROM production_federation_trust_recovery_decisions ORDER BY created_at,id').fetchall()
