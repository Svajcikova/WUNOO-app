@app.post("/api/v070/ops/migration")
def v070_record_migration(body:dict[str,Any], authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin"})
    name=str(body.get("migration_name","")).strip()
    checksum=str(body.get("checksum","")).strip()
    if not name or not checksum: raise HTTPException(400,"migration_name a checksum jsou povinné")
    with core_db_connect() as c:
        row=c.execute("SELECT * FROM migration_runs WHERE migration_name=? AND checksum=?",(name,checksum)).fetchone()
        if row:return {"status":"already_recorded","migration":dict(row)}
        mid="mig_"+uuid.uuid4().hex[:12]
        c.execute("INSERT INTO migration_runs(id,migration_name,checksum,status,started_at) VALUES (?,?,?,?,?)",(mid,name,checksum,"started",now()))
        c.execute("UPDATE migration_runs SET status='completed',completed_at=? WHERE id=?",(now(),mid))
        c.commit()
        return {"id":mid,"migration_name":name,"checksum":checksum,"status":"completed"}

