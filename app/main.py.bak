def _v046_assess_order(c, o):
    from datetime import datetime, timezone
    issues=[]
    promised=o["promised_at"] if "promised_at" in o.keys() else None
    stale_seconds=None
    loc=c.execute("SELECT recorded_at,live_eta_minutes,deviation_ratio FROM courier_locations WHERE order_id=? ORDER BY recorded_at DESC LIMIT 1",(o["id"],)).fetchone()
    if loc:
        try:
            stale_seconds=max(0,(datetime.now(timezone.utc)-datetime.fromisoformat(str(loc["recorded_at"]).replace("Z","+00:00"))).total_seconds())
        except Exception:
            stale_seconds=None
        if stale_seconds is not None and stale_seconds>180 and o["status"] in {"assigned","picked_up","out_for_delivery","delayed"}:
            issues.append(("STALE_GPS","P1",{"stale_seconds":round(stale_seconds,1)}))
    if promised and o["status"] not in {"delivered","cancelled"}:
        try:
            p=datetime.fromisoformat(str(promised).replace("Z","+00:00"))
            late=max(0,(datetime.now(p.tzinfo)-p).total_seconds()/60)
            if late>=15: issues.append(("PROMISE_BREACH","P1",{"late_minutes":round(late,1)}))
            elif late>=5: issues.append(("PROMISE_RISK","P2",{"late_minutes":round(late,1)}))
        except Exception: pass
    if o["status"] in {"assigned","picked_up","out_for_delivery","delayed"} and not o["courier_id"]:
        issues.append(("MISSING_COURIER","P0",{}))
    return {"issues":issues,"stale_seconds":stale_seconds}

def _v046_recovery_amount(o, incident_type):
    total=float(o["total_czk"] or 0)
    if incident_type=="PROMISE_BREACH":
        return min(100.0,round(total*0.10,2))
    if incident_type=="STALE_GPS":
        return 0.0
    return 0.0



