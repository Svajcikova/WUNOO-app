@app.post("/api/v036/cart/mutate")
def v036_cart_mutate(body: dict[str, Any], authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u = current_user(authorization); require_role(u, "customer")
    action = body.get("action")
    menu_item_id = body.get("menu_item_id")
    if action not in {"increment","decrement","set","remove","clear"}:
        raise HTTPException(400, "Neplatná cart operace")
    with core_db_connect() as c:
        if action == "clear":
            c.execute("DELETE FROM cart_items WHERE customer_id=?", (u["customer_id"],))
        else:
            row = c.execute(
                "SELECT ci.id,ci.qty,ci.merchant_id,mi.price_czk,mi.active FROM cart_items ci "
                "JOIN menu_items mi ON mi.id=ci.menu_item_id WHERE ci.customer_id=? AND ci.menu_item_id=?",
                (u["customer_id"], menu_item_id)
            ).fetchone()
            if action == "remove":
                if row: c.execute("DELETE FROM cart_items WHERE id=?", (row["id"],))
            else:
                if not row:
                    raise HTTPException(404, "Položka není v košíku")
                if not row["active"]:
                    raise HTTPException(409, "Položka už není v prodeji")
                current = int(row["qty"])
                if action == "increment":
                    qty = current + 1
                elif action == "decrement":
                    qty = current - 1
                else:
                    qty = int(body.get("qty", current))
                if qty <= 0:
                    c.execute("DELETE FROM cart_items WHERE id=?", (row["id"],))
                elif qty > 20:
                    raise HTTPException(400, "Maximálně 20 kusů")
                else:
                    c.execute("UPDATE cart_items SET qty=? WHERE id=?", (qty, row["id"]))
        c.commit()
    return get_cart(authorization)


@app.get("/api/v036/cart/validate")
def v036_cart_validate(authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u = current_user(authorization); require_role(u, "customer")
    with core_db_connect() as c:
        rows = c.execute("""
            SELECT ci.menu_item_id,ci.qty,ci.merchant_id,mi.name,mi.price_czk,mi.active,
                   m.active merchant_active,COALESCE(mp.min_order_czk,0) min_order_czk
            FROM cart_items ci
            JOIN menu_items mi ON mi.id=ci.menu_item_id
            JOIN merchants m ON m.id=ci.merchant_id
            LEFT JOIN merchant_profiles mp ON mp.merchant_id=m.id
            WHERE ci.customer_id=?
        """,(u["customer_id"],)).fetchall()
        issues=[]
        if not rows:
            issues.append("empty_cart")
        merchants={r["merchant_id"] for r in rows}
        if len(merchants)>1:
            issues.append("multiple_merchants")
        total=sum(float(r["price_czk"])*int(r["qty"]) for r in rows)
        for r in rows:
            if not r["active"]: issues.append(f"menu_item_inactive:{r['menu_item_id']}")
            if not r["merchant_active"]: issues.append(f"merchant_inactive:{r['merchant_id']}")
        minimum=float(rows[0]["min_order_czk"]) if rows else 0
        if total < minimum: issues.append("minimum_order_not_met")
        return {
            "valid": not issues,
            "issues": issues,
            "subtotal_czk": round(total,2),
            "minimum_order_czk": minimum,
            "merchant_id": next(iter(merchants),None)
        }

