@app.get("/api/v057/marketplace")
def v057_marketplace(q:str|None=None, authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"customer"})
    with core_db_connect() as c:
        args=[]; sql="""SELECT m.id,m.name,COUNT(p.id) product_count
                         FROM merchants m LEFT JOIN catalog_products p
                         ON p.merchant_id=m.id AND p.available=1 WHERE 1=1"""
        if q:
            sql+=" AND (LOWER(m.name) LIKE ? OR EXISTS (SELECT 1 FROM catalog_products p2 WHERE p2.merchant_id=m.id AND p2.available=1 AND LOWER(p2.name) LIKE ?))"
            term="%"+q.lower()+"%";args += [term,term]
        sql+=" GROUP BY m.id,m.name ORDER BY m.name LIMIT 100"
        return {"merchants":[dict(x) for x in c.execute(sql,args).fetchall()]}

@app.get("/api/v057/merchants/{merchant_id}/menu")
def v057_menu(merchant_id:str, authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"customer"})
    with core_db_connect() as c:
        m=c.execute("SELECT id,name FROM merchants WHERE id=?",(merchant_id,)).fetchone()
        if not m: raise HTTPException(404,"Podnik nenalezen")
        products=c.execute("""SELECT * FROM catalog_products
                              WHERE merchant_id=? AND available=1
                              ORDER BY sort_order,name""",(merchant_id,)).fetchall()
        out=[]
        for p in products:
            mods=c.execute("""SELECT * FROM catalog_modifiers
                              WHERE product_id=? ORDER BY sort_order,name""",(p["id"],)).fetchall()
            out.append({"product":dict(p),"modifiers":[dict(x) for x in mods]})
        return {"merchant":dict(m),"items":out}

