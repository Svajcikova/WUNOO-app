@app.get("/api/v040/merchants/{merchant_id}/preorder-slots")
def v040_slots(merchant_id: str, authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u=current_user(authorization); require_role(u,"customer")
    with core_db_connect() as c:
        m=c.execute("SELECT id,active FROM merchants WHERE id=?",(merchant_id,)).fetchone()
        if not m: raise HTTPException(404,"Restaurace nenalezena")
        av=_v039_availability(c,merchant_id)
        settings=c.execute("SELECT * FROM merchant_preorder_settings WHERE merchant_id=?",(merchant_id,)).fetchone()
        enabled=bool(settings["enabled"]) if settings else True
        return {"merchant_id":merchant_id,"enabled":enabled,"availability":av,"slots":_v040_slots(c,merchant_id) if enabled else []}


@app.post("/api/v040/merchants/{merchant_id}/preorder-settings")
def v040_preorder_settings(merchant_id: str, body: dict[str, Any], authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u=current_user(authorization); require_role(u,"merchant")
    if u["merchant_id"]!=merchant_id: raise HTTPException(403,"forbidden")
    slot_minutes=int(body.get("slot_minutes",30)); cutoff=int(body.get("cutoff_minutes",30)); horizon=int(body.get("horizon_days",3)); enabled=1 if body.get("enabled",True) else 0
    if slot_minutes not in {15,30,60}: raise HTTPException(400,"slot_minutes musí být 15/30/60")
    if cutoff<5 or cutoff>240: raise HTTPException(400,"cutoff_minutes mimo limit")
    if horizon<1 or horizon>7: raise HTTPException(400,"horizon_days mimo limit")
    with core_db_connect() as c:
        c.execute("INSERT INTO merchant_preorder_settings VALUES (?,?,?,?,?) ON CONFLICT(merchant_id) DO UPDATE SET enabled=excluded.enabled,slot_minutes=excluded.slot_minutes,cutoff_minutes=excluded.cutoff_minutes,horizon_days=excluded.horizon_days",
                  (merchant_id,enabled,slot_minutes,cutoff,horizon))
        c.commit()
    return {"merchant_id":merchant_id,"enabled":bool(enabled),"slot_minutes":slot_minutes,"cutoff_minutes":cutoff,"horizon_days":horizon}


@app.post("/api/v040/orders/{order_id}/schedule")
def v040_schedule_order(order_id: str, body: dict[str, Any], authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u=current_user(authorization); require_role(u,"customer")
    scheduled_for=str(body.get("scheduled_for",""))
    with core_db_connect() as c:
        o=c.execute("SELECT * FROM orders WHERE id=? AND customer_id=?",(order_id,u["customer_id"])).fetchone()
        if not o: raise HTTPException(404,"Objednávka nenalezena")
        slot=c.execute("SELECT * FROM merchant_preorder_slots WHERE id=? AND merchant_id=?",(scheduled_for,o["merchant_id"])).fetchone()
        if not slot: raise HTTPException(409,"Slot není dostupný")
        if slot["status"]!="open" or int(slot["reserved"])>=int(slot["capacity"]): raise HTTPException(409,"Slot je plný")
        current=c.execute("SELECT slot_id FROM order_preorder_reservations WHERE order_id=?",(order_id,)).fetchone() if _db_table_exists(c, "order_preorder_reservations") else None
        if current: raise HTTPException(409,"Objednávka už má rezervovaný slot")
        c.execute("""CREATE TABLE IF NOT EXISTS order_preorder_reservations(
            order_id TEXT PRIMARY KEY, slot_id TEXT NOT NULL, reserved_at TEXT NOT NULL
        )""")
        c.execute("INSERT INTO order_preorder_reservations VALUES (?,?,?)",(order_id,scheduled_for,now()))
        c.execute("UPDATE merchant_preorder_slots SET reserved=reserved+1 WHERE id=?",(scheduled_for,))
        c.execute("UPDATE orders SET fulfillment_mode='scheduled', scheduled_for=?, schedule_status='reserved', status='merchant_pending', updated_at=? WHERE id=?",
                  (slot["slot_start"],now(),order_id))
        emit(c,order_id,"preorder_slot_reserved",{"slot_id":scheduled_for,"scheduled_for":slot["slot_start"]},u["id"])
        c.commit()
        return {"order_id":order_id,"fulfillment_mode":"scheduled","scheduled_for":slot["slot_start"],"slot_id":scheduled_for,"schedule_status":"reserved"}


@app.get("/api/v040/merchant/preorder-queue")
def v040_merchant_queue(authorization: str | None = Header(default=None)) -> dict[str, Any]:
