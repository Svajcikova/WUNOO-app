# ---------------- v1.62 Production Safety Event Bus & Decision Ledger ----------------
def migrate_v162(c):
    c.execute("""CREATE TABLE IF NOT EXISTS production_safety_event_ledger(
        id TEXT PRIMARY KEY, event_type TEXT NOT NULL, aggregate_type TEXT NOT NULL,
        aggregate_id TEXT NOT NULL, release_version TEXT, rollout_run_id TEXT, deployment_id TEXT,
        decision TEXT, payload_json TEXT NOT NULL DEFAULT '{}', prev_event_hash TEXT,
        event_hash TEXT NOT NULL, sequence_no INTEGER NOT NULL, operator TEXT,
        created_at TEXT NOT NULL
    )""")
    c.execute("CREATE UNIQUE INDEX IF NOT EXISTS uq_safety_ledger_sequence ON production_safety_event_ledger(sequence_no)")
    c.execute("CREATE INDEX IF NOT EXISTS idx_safety_ledger_aggregate ON production_safety_event_ledger(aggregate_type, aggregate_id, sequence_no DESC)")
    c.execute("CREATE INDEX IF NOT EXISTS idx_safety_ledger_run ON production_safety_event_ledger(rollout_run_id, sequence_no DESC)")
    c.execute("CREATE INDEX IF NOT EXISTS idx_safety_ledger_release ON production_safety_event_ledger(release_version, sequence_no DESC)")
    try: c.commit()
    except Exception: pass

_V162_POLICY = {
    'schema_version':'1.62',
    'append_only':True,
    'hash_chain':True,
    'tamper_detection':True,
    'canonical_decisions':['GO','HOLD','ROLLBACK_RECOMMENDED'],
    'automatic_traffic_mutation':False,
    'automatic_rollback':False,
    'fail_closed':True,
}

def _v162_event_hash(event):
    return hashlib.sha256(json.dumps(event,sort_keys=True,separators=(',',':')).encode()).hexdigest()

def _v162_append(c, event_type, aggregate_type, aggregate_id, payload, operator='system'):
    # A single append-only chain is used for deterministic audit/reconciliation.
    row=c.execute('SELECT sequence_no,event_hash FROM production_safety_event_ledger ORDER BY sequence_no DESC LIMIT 1').fetchone()
    seq=(int(row['sequence_no'])+1) if row else 1
    prev=str(row['event_hash']) if row else None
    body={
        'schema_version':'1.62','sequence_no':seq,'event_type':str(event_type),
        'aggregate_type':str(aggregate_type),'aggregate_id':str(aggregate_id),
        'release_version':payload.get('release_version'),'rollout_run_id':payload.get('rollout_run_id'),
        'deployment_id':payload.get('deployment_id'),'decision':payload.get('decision'),
        'payload':payload,'prev_event_hash':prev,'operator':operator,
    }
    digest=_v162_event_hash(body)
    eid='sev_'+uuid.uuid4().hex[:16]
    c.execute('INSERT INTO production_safety_event_ledger(id,event_type,aggregate_type,aggregate_id,release_version,rollout_run_id,deployment_id,decision,payload_json,prev_event_hash,event_hash,sequence_no,operator,created_at) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?)',
              (eid,str(event_type),str(aggregate_type),str(aggregate_id),payload.get('release_version'),payload.get('rollout_run_id'),payload.get('deployment_id'),payload.get('decision'),json.dumps(payload,sort_keys=True,separators=(',',':')),prev,digest,seq,operator,now()))
    return {'event_id':eid,'sequence_no':seq,'event_hash':digest,'prev_event_hash':prev}

def _v162_verify(c, limit=None):
    q='SELECT * FROM production_safety_event_ledger ORDER BY sequence_no ASC'
    rows=c.execute(q).fetchall()
    expected_seq=1; prev=None; errors=[]
    for r in rows:
        if int(r['sequence_no'])!=expected_seq: errors.append({'type':'SEQUENCE_GAP','sequence_no':r['sequence_no'],'expected':expected_seq})
        if (r['prev_event_hash'] or None)!=(prev or None): errors.append({'type':'CHAIN_BREAK','sequence_no':r['sequence_no']})
        try: payload=json.loads(r['payload_json'] or '{}')
        except Exception: payload={}; errors.append({'type':'INVALID_PAYLOAD_JSON','sequence_no':r['sequence_no']})
        body={'schema_version':'1.62','sequence_no':int(r['sequence_no']),'event_type':r['event_type'],'aggregate_type':r['aggregate_type'],'aggregate_id':r['aggregate_id'],'release_version':r['release_version'],'rollout_run_id':r['rollout_run_id'],'deployment_id':r['deployment_id'],'decision':r['decision'],'payload':payload,'prev_event_hash':r['prev_event_hash'],'operator':r['operator']}
        actual=_v162_event_hash(body)
        if actual!=r['event_hash']: errors.append({'type':'HASH_MISMATCH','sequence_no':r['sequence_no']})
        prev=r['event_hash']; expected_seq=int(r['sequence_no'])+1
    result={'valid':not errors,'event_count':len(rows),'head_sequence':rows[-1]['sequence_no'] if rows else 0,'head_hash':rows[-1]['event_hash'] if rows else None,'errors':errors[:50]}
    return result

@app.get('/api/v162/ops/safety-ledger/policy')
def v162_policy(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); return _V162_POLICY

@app.post('/api/v162/ops/safety-ledger/event')
def v162_append_event(payload: dict[str,Any], authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    event_type=str(payload.get('event_type','')).strip().upper()
    aggregate_type=str(payload.get('aggregate_type','safety_decision')).strip()
    aggregate_id=str(payload.get('aggregate_id','')).strip()
    if not event_type or not aggregate_id: raise HTTPException(422,'event_type and aggregate_id are required')
    operator=str(u.get('email') or u.get('id') or 'operator')
    clean={k:v for k,v in payload.items() if k not in {'event_type','aggregate_type','aggregate_id'}}
    with core_db_connect() as c:
        health=_v162_verify(c)
        if not health['valid']: raise HTTPException(409,'safety ledger integrity failure; append blocked')
        out=_v162_append(c,event_type,aggregate_type,aggregate_id,clean,operator); c.commit()
    return {'schema_version':'1.62',**out,'ledger_status':'VALID'}

@app.post('/api/v162/ops/safety-ledger/publish-integration/{integration_id}')
def v162_publish_integration(integration_id: str, authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); operator=str(u.get('email') or u.get('id') or 'operator')
    with core_db_connect() as c:
        row=c.execute('SELECT * FROM production_safety_engine_integrations WHERE id=?',(integration_id,)).fetchone()
        if not row: raise HTTPException(404,'safety integration nenalezena')
        existing=c.execute("SELECT id FROM production_safety_event_ledger WHERE event_type=? AND aggregate_type=? AND aggregate_id=? ORDER BY sequence_no DESC LIMIT 1",('SAFETY_INTEGRATION','safety_integration',integration_id)).fetchone()
        if existing: return {'schema_version':'1.62','event_id':existing['id'],'idempotent':True}
        payload={'integration_id':integration_id,'release_version':row['release_version'],'rollout_run_id':row['rollout_run_id'],'deployment_id':row['deployment_id'],'decision':row['decision'],'confidence':row['confidence'],'reason':row['reason'],'evidence_sha256':row['evidence_sha256']}
        health=_v162_verify(c)
        if not health['valid']: raise HTTPException(409,'safety ledger integrity failure; publish blocked')
        out=_v162_append(c,'SAFETY_INTEGRATION','safety_integration',integration_id,payload,operator); c.commit()
    return {'schema_version':'1.62',**out,'idempotent':False}

@app.get('/api/v162/ops/safety-ledger/verify')
def v162_verify(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c: result=_v162_verify(c)
    return {'schema_version':'1.62','policy':_V162_POLICY,**result}

@app.get('/api/v162/ops/safety-ledger/latest')
def v162_latest(rollout_run_id: str|None=None, release_version: str|None=None, authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        if rollout_run_id: row=c.execute('SELECT * FROM production_safety_event_ledger WHERE rollout_run_id=? ORDER BY sequence_no DESC LIMIT 1',(rollout_run_id,)).fetchone()
        elif release_version: row=c.execute('SELECT * FROM production_safety_event_ledger WHERE release_version=? ORDER BY sequence_no DESC LIMIT 1',(release_version,)).fetchone()
        else: row=c.execute('SELECT * FROM production_safety_event_ledger ORDER BY sequence_no DESC LIMIT 1').fetchone()
        health=_v162_verify(c)
    if not row: raise HTTPException(404,'safety ledger event nenalezen')
    return {'schema_version':'1.62','event':dict(row),'ledger':health,'policy':_V162_POLICY}


# ---------------- v1.64 Production Safety Recovery Controller ----------------
def migrate_v164(c):
    c.execute("""CREATE TABLE IF NOT EXISTS production_safety_recovery_runs(
        id TEXT PRIMARY KEY, release_version TEXT, rollout_run_id TEXT, deployment_id TEXT,
        phase TEXT NOT NULL, decision TEXT NOT NULL, recovery_snapshot_id TEXT,
        verification_json TEXT NOT NULL DEFAULT '{}', transitions_json TEXT NOT NULL DEFAULT '[]',
        evidence_sha256 TEXT NOT NULL, operator TEXT, created_at TEXT NOT NULL, updated_at TEXT NOT NULL
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_safety_recovery_runs_time ON production_safety_recovery_runs(updated_at DESC)")
    c.execute("CREATE INDEX IF NOT EXISTS idx_safety_recovery_runs_rollout ON production_safety_recovery_runs(rollout_run_id,updated_at DESC)")
    try: c.commit()
    except Exception: pass

_V164_POLICY={
    'schema_version':'1.64','state_machine':['HOLD','VERIFY','RECOVER','REVALIDATE','RELEASE'],
    'fail_closed':True,'non_destructive_recovery':True,'release_requires_fresh_go':True,
    'recover_requires_operator_confirmation':True,'release_requires_operator_confirmation':True,
    'ledger_integrity_required':True,'automatic_traffic_mutation':False,'automatic_rollback':False,
}

def _v164_hash(payload):
    return hashlib.sha256(json.dumps(payload,sort_keys=True,separators=(',',':')).encode()).hexdigest()

def _v164_latest_integration(c, rollout_run_id=None, release_version=None):
    if rollout_run_id: return c.execute('SELECT * FROM production_safety_engine_integrations WHERE rollout_run_id=? ORDER BY created_at DESC LIMIT 1',(rollout_run_id,)).fetchone()
    if release_version: return c.execute('SELECT * FROM production_safety_engine_integrations WHERE release_version=? ORDER BY created_at DESC LIMIT 1',(release_version,)).fetchone()
    return c.execute('SELECT * FROM production_safety_engine_integrations ORDER BY created_at DESC LIMIT 1').fetchone()

def _v164_validation(c, rollout_run_id=None, release_version=None):
    ledger=_v163_verify_detailed(c)
    recon=c.execute('SELECT * FROM production_safety_ledger_reconciliations ORDER BY created_at DESC LIMIT 1').fetchone()
    integ=_v164_latest_integration(c,rollout_run_id,release_version)
    reasons=[]
    if not ledger['valid']: reasons.append('SAFETY_LEDGER_INVALID')
    if not recon: reasons.append('NO_RECONCILIATION')
    elif recon['status']!='HEALTHY': reasons.append('RECOVERY_REQUIRED')
    if not integ: reasons.append('NO_SAFETY_INTEGRATION')
    elif integ['decision']!='GO': reasons.append('UPSTREAM_NOT_GO')
    return {'valid':not reasons,'ledger_valid':ledger['valid'],'reconciliation_status':dict(recon)['status'] if recon else None,'integration_decision':dict(integ)['decision'] if integ else None,'integration_id':dict(integ)['id'] if integ else None,'reasons':reasons}

def _v164_transition(run, phase, decision, verification, operator, confirmed=False):
    current=run['phase']
    allowed={'HOLD':{'VERIFY'},'VERIFY':{'RECOVER'},'RECOVER':{'REVALIDATE'},'REVALIDATE':{'RELEASE'},'RELEASE':set()}
    if phase not in allowed.get(current,set()): raise HTTPException(409,f'invalid recovery transition {current}->{phase}')
    if phase in {'RECOVER','RELEASE'} and not confirmed: raise HTTPException(409,f'operator confirmation required for {phase}')
    transitions=json.loads(run['transitions_json'] or '[]')
    transitions.append({'from':current,'to':phase,'decision':decision,'verification':verification,'operator':operator,'at':now()})
    return transitions

@app.get('/api/v164/ops/safety-recovery/policy')
def v164_policy(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); return _V164_POLICY

@app.post('/api/v164/ops/safety-recovery/start')
def v164_start(payload: dict[str,Any]|None=None, authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); payload=payload or {}; operator=str(u.get('email') or u.get('id') or 'operator')
    with core_db_connect() as c:
        rollout=payload.get('rollout_run_id'); release=payload.get('release_version'); deployment=payload.get('deployment_id')
        integ=_v164_latest_integration(c,rollout,release)
        if integ:
            release=release or integ['release_version']; rollout=rollout or integ['rollout_run_id']; deployment=deployment or integ['deployment_id']
        val=_v164_validation(c,rollout,release)
        # Starting is intentionally HOLD even when validation is healthy: recovery is an explicit workflow.
        rid='psrec_'+uuid.uuid4().hex[:16]; created=now()
        snap=c.execute('SELECT * FROM production_safety_ledger_recovery_snapshots ORDER BY created_at DESC LIMIT 1').fetchone()
        body={'schema_version':'1.64','release_version':release,'rollout_run_id':rollout,'deployment_id':deployment,'initial_validation':val,'snapshot_id':snap['id'] if snap else None}
        digest=_v164_hash(body)
        c.execute('INSERT INTO production_safety_recovery_runs(id,release_version,rollout_run_id,deployment_id,phase,decision,recovery_snapshot_id,verification_json,transitions_json,evidence_sha256,operator,created_at,updated_at) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?)',
                  (rid,release,rollout,deployment,'HOLD','HOLD',snap['id'] if snap else None,json.dumps(val,sort_keys=True),'[]',digest,operator,created,created)); c.commit()
    return {'schema_version':'1.64','recovery_run_id':rid,'phase':'HOLD','decision':'HOLD','validation':val,'recovery_snapshot_id':snap['id'] if snap else None,'evidence_sha256':digest}

@app.post('/api/v164/ops/safety-recovery/{run_id}/advance')
def v164_advance(run_id: str, payload: dict[str,Any]|None=None, authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); payload=payload or {}; operator=str(u.get('email') or u.get('id') or 'operator'); confirmed=bool(payload.get('operator_confirmed',False))
    with core_db_connect() as c:
        run=c.execute('SELECT * FROM production_safety_recovery_runs WHERE id=?',(run_id,)).fetchone()
        if not run: raise HTTPException(404,'recovery run nenalezen')
        current=run['phase']; next_phase={'HOLD':'VERIFY','VERIFY':'RECOVER','RECOVER':'REVALIDATE','REVALIDATE':'RELEASE'}.get(current)
        if not next_phase: raise HTTPException(409,'recovery run already released')
        val=_v164_validation(c,run['rollout_run_id'],run['release_version'])
        if next_phase=='VERIFY' and not val['valid']: raise HTTPException(409,'verification failed: '+';'.join(val['reasons']))
        if next_phase=='RECOVER' and not run['recovery_snapshot_id']: raise HTTPException(409,'no recovery snapshot available')
        if next_phase=='REVALIDATE' and not confirmed: raise HTTPException(409,'operator confirmation required for REVALIDATE')
        if next_phase=='RELEASE' and (not confirmed or not val['valid']): raise HTTPException(409,'release requires operator confirmation and fresh GO validation')
        decision='GO' if next_phase=='RELEASE' else ('HOLD' if next_phase in {'HOLD','VERIFY'} else 'RECOVER')
        verification={'phase':next_phase,'validation':val,'operator_confirmed':confirmed}
        transitions=_v164_transition(run,next_phase,decision,verification,operator,confirmed)
        digest=_v164_hash({'run_id':run_id,'phase':next_phase,'decision':decision,'verification':verification,'transitions':transitions})
        c.execute('UPDATE production_safety_recovery_runs SET phase=?,decision=?,verification_json=?,transitions_json=?,evidence_sha256=?,updated_at=? WHERE id=?',(next_phase,decision,json.dumps(verification,sort_keys=True),json.dumps(transitions,sort_keys=True),digest,now(),run_id)); c.commit()
    return {'schema_version':'1.64','recovery_run_id':run_id,'phase':next_phase,'decision':decision,'verification':verification,'evidence_sha256':digest}

@app.get('/api/v164/ops/safety-recovery/{run_id}')
def v164_get(run_id: str, authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c: row=c.execute('SELECT * FROM production_safety_recovery_runs WHERE id=?',(run_id,)).fetchone()
    if not row: raise HTTPException(404,'recovery run nenalezen')
    out=dict(row)
    for k in ('verification_json','transitions_json'):
        try: out[k[:-5] if k.endswith('_json') else k]=json.loads(out.pop(k) or ('{}' if k=='verification_json' else '[]'))
        except Exception: pass
    return {'schema_version':'1.64','recovery':out,'policy':_V164_POLICY}

@app.get('/api/v164/ops/safety-recovery/latest')
def v164_latest(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c: row=c.execute('SELECT * FROM production_safety_recovery_runs ORDER BY updated_at DESC LIMIT 1').fetchone()
    if not row: raise HTTPException(404,'recovery run nenalezen')
    return {'schema_version':'1.64','recovery':dict(row),'policy':_V164_POLICY}


# ---------------- v1.65 Production Safety Recovery Automation & Canary Revalidation ----------------
def migrate_v165(c):
    c.execute("""CREATE TABLE IF NOT EXISTS production_safety_revalidation_runs(
        id TEXT PRIMARY KEY, recovery_run_id TEXT, release_version TEXT, rollout_run_id TEXT,
        deployment_id TEXT, phase TEXT NOT NULL, decision TEXT NOT NULL,
        canary_required_pct REAL NOT NULL DEFAULT 1.0, observations_json TEXT NOT NULL DEFAULT '{}',
        gate_snapshot_json TEXT NOT NULL DEFAULT '{}', evidence_sha256 TEXT NOT NULL,
        operator TEXT, created_at TEXT NOT NULL, updated_at TEXT NOT NULL
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_safety_revalidation_time ON production_safety_revalidation_runs(updated_at DESC)")
    c.execute("CREATE INDEX IF NOT EXISTS idx_safety_revalidation_run ON production_safety_revalidation_runs(rollout_run_id,updated_at DESC)")
    try: c.commit()
    except Exception: pass

_V165_POLICY={
    'schema_version':'1.65',
    'state_machine':['CANARY','HEALTH','SLO','INCIDENT','SAFETY_CHAIN','RELEASE'],
    'canary_required_pct':1.0,
    'fresh_evidence_required':True,
    'recovery_release_required':True,
    'healthy_traffic_required':True,
    'healthy_slo_required':True,
    'incident_clear_required':True,
    'ledger_integrity_required':True,
    'fail_closed':True,
    'automatic_traffic_mutation':False,
    'automatic_rollback':False,
}

def _v165_hash(payload):
    return hashlib.sha256(json.dumps(payload,sort_keys=True,separators=(',',':')).encode()).hexdigest()

def _v165_num(v, default=0.0):
    try: return float(v)
    except Exception: return default

def _v165_eval(snapshot):
    recovery=str(snapshot.get('recovery_decision') or '').upper()
    traffic=snapshot.get('traffic') or {}
    slo=snapshot.get('slo') or {}
    incident=snapshot.get('incident') or {}
    ledger=bool(snapshot.get('ledger_valid',False))
    canary_pct=_v165_num(snapshot.get('canary_pct'),0)
    canary_ok=canary_pct>=1.0
    traffic_ok=(bool(traffic.get('healthy',False)) and _v165_num(traffic.get('availability_pct'),0)>=99.5 and _v165_num(traffic.get('error_rate_pct'),100)<=2.0 and _v165_num(traffic.get('p95_latency_ms'),999999)<=1500 and _v165_num(traffic.get('sample_count'),0)>=20)
    slo_ok=(bool(slo.get('healthy',False)) and _v165_num(slo.get('short_burn_rate'),999999)<6 and _v165_num(slo.get('long_burn_rate'),999999)<1)
    severity=str(incident.get('severity') or '').upper()
    incident_ok=severity not in {'SEV1','SEV2'} and str(incident.get('decision') or 'GO').upper() not in {'HOLD','ROLLBACK_RECOMMENDED'}
    chain_ok=ledger and str(snapshot.get('ledger_reconciliation_status') or 'HEALTHY').upper()=='HEALTHY'
    recovery_ok=recovery=='GO'
    gates={'recovery':recovery_ok,'canary':canary_ok,'traffic_health':traffic_ok,'slo':slo_ok,'incident':incident_ok,'safety_chain':chain_ok}
    failed=[k for k,v in gates.items() if not v]
    if recovery=='ROLLBACK_RECOMMENDED': decision='ROLLBACK_RECOMMENDED'; reason='recovery controller requires rollback'
    elif failed: decision='HOLD'; reason='failed revalidation gates: '+','.join(failed)
    else: decision='GO'; reason='fresh canary, traffic, SLO, incident and safety-chain evidence all pass'
    return {'decision':decision,'reason':reason,'gates':gates,'failed_gates':failed,'canary_pct':canary_pct}

def _v165_latest_row(c, table, rollout_run_id=None, release_version=None):
    clauses=[]; args=[]
    if rollout_run_id: clauses.append('rollout_run_id=?'); args.append(rollout_run_id)
    if release_version: clauses.append('release_version=?'); args.append(release_version)
    where=(' WHERE '+' AND '.join(clauses)) if clauses else ''
    return c.execute(f'SELECT * FROM {table}{where} ORDER BY created_at DESC LIMIT 1',tuple(args)).fetchone()

def _v165_collect(c, recovery_run_id=None, rollout_run_id=None, release_version=None):
    recovery=None
    if recovery_run_id: recovery=c.execute('SELECT * FROM production_safety_recovery_runs WHERE id=?',(recovery_run_id,)).fetchone()
    if recovery:
        rollout_run_id=rollout_run_id or recovery['rollout_run_id']; release_version=release_version or recovery['release_version']
    integ=_v164_latest_integration(c,rollout_run_id,release_version)
    rollout=_v165_latest_row(c,'production_rollout_observations',rollout_run_id,release_version)
    slo=_v165_latest_row(c,'production_slo_guard_observations',rollout_run_id,release_version)
    incident=_v165_latest_row(c,'production_incident_correlations',rollout_run_id,release_version)
    recon=c.execute('SELECT * FROM production_safety_ledger_reconciliations ORDER BY created_at DESC LIMIT 1').fetchone()
    ledger=_v163_verify_detailed(c)
    snapshot={
        'schema_version':'1.65','recovery_run_id':recovery_run_id,'release_version':release_version,'rollout_run_id':rollout_run_id,
        'recovery_decision':str(recovery['decision'] if recovery else (integ['decision'] if integ else 'HOLD')),
        'traffic':dict(rollout) if rollout else {}, 'slo':dict(slo) if slo else {},
        'incident':dict(incident) if incident else {}, 'ledger_valid':bool(ledger['valid']),
        'ledger_reconciliation_status':str(recon['status']) if recon else None,
        'canary_pct':100.0 if rollout and str(rollout['phase']).lower()=='canary' else (100.0 if rollout else 0.0),
        'source_ids':{'recovery':recovery['id'] if recovery else None,'integration':integ['id'] if integ else None,'traffic':rollout['id'] if rollout else None,'slo':slo['id'] if slo else None,'incident':incident['id'] if incident else None,'reconciliation':recon['id'] if recon else None},
    }
    return snapshot

@app.get('/api/v165/ops/safety-revalidation/policy')
def v165_policy(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); return _V165_POLICY

@app.post('/api/v165/ops/safety-revalidation/evaluate')
def v165_evaluate(payload: dict[str,Any]|None=None, authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); payload=payload or {}
    operator=str(u.get('email') or u.get('id') or 'operator')
    with core_db_connect() as c:
        snap=_v165_collect(c,payload.get('recovery_run_id'),payload.get('rollout_run_id'),payload.get('release_version'))
    ev=_v165_eval(snap); body={'snapshot':snap,'evaluation':ev}; digest=_v165_hash(body)
    rid='psreval_'+uuid.uuid4().hex[:16]
    with core_db_connect() as c:
        c.execute('INSERT INTO production_safety_revalidation_runs(id,recovery_run_id,release_version,rollout_run_id,deployment_id,phase,decision,canary_required_pct,observations_json,gate_snapshot_json,evidence_sha256,operator,created_at,updated_at) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?)',
                  (rid,payload.get('recovery_run_id'),snap.get('release_version'),snap.get('rollout_run_id'),None,'CANARY',ev['decision'],100.0,json.dumps({},sort_keys=True),json.dumps(snap,sort_keys=True),digest,operator,now(),now())); c.commit()
    return {'schema_version':'1.65','revalidation_run_id':rid,'phase':'CANARY','evidence_sha256':digest,**ev}

@app.post('/api/v165/ops/safety-revalidation/{run_id}/advance')
def v165_advance(run_id: str, payload: dict[str,Any]|None=None, authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); payload=payload or {}; operator=str(u.get('email') or u.get('id') or 'operator')
    with core_db_connect() as c:
        row=c.execute('SELECT * FROM production_safety_revalidation_runs WHERE id=?',(run_id,)).fetchone()
        if not row: raise HTTPException(404,'revalidation run nenalezen')
        phases={'CANARY':'HEALTH','HEALTH':'SLO','SLO':'INCIDENT','INCIDENT':'SAFETY_CHAIN','SAFETY_CHAIN':'RELEASE','RELEASE':None}
        nxt=phases.get(row['phase'])
        if not nxt: raise HTTPException(409,'revalidation already released')
        snap=_v165_collect(c,row['recovery_run_id'],row['rollout_run_id'],row['release_version']); ev=_v165_eval(snap)
        phase_gate={'HEALTH':'canary','SLO':'traffic_health','INCIDENT':'slo','SAFETY_CHAIN':'incident','RELEASE':'safety_chain'}[nxt]
        confirmed=bool(payload.get('operator_confirmed',False))
        if not ev['gates'].get(phase_gate,False): raise HTTPException(409,f'{nxt} gate failed: {ev["reason"]}')
        if nxt=='RELEASE' and not confirmed: raise HTTPException(409,'operator confirmation required for RELEASE')
        decision='GO' if nxt=='RELEASE' else ev['decision']
        digest=_v165_hash({'run_id':run_id,'phase':nxt,'decision':decision,'snapshot':snap,'operator_confirmed':confirmed})
        c.execute('UPDATE production_safety_revalidation_runs SET phase=?,decision=?,gate_snapshot_json=?,evidence_sha256=?,operator=?,updated_at=? WHERE id=?',(nxt,decision,json.dumps(snap,sort_keys=True),digest,operator,now(),run_id)); c.commit()
    return {'schema_version':'1.65','revalidation_run_id':run_id,'phase':nxt,'decision':decision,'gate':phase_gate,'evidence_sha256':digest}

@app.get('/api/v165/ops/safety-revalidation/{run_id}')
def v165_get(run_id: str, authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c: row=c.execute('SELECT * FROM production_safety_revalidation_runs WHERE id=?',(run_id,)).fetchone()
    if not row: raise HTTPException(404,'revalidation run nenalezen')
    return {'schema_version':'1.65','revalidation':dict(row),'policy':_V165_POLICY}


# ---------------- v1.66 Production Safety Autonomous Promotion Controller ----------------
def migrate_v166(c):
    c.execute("""CREATE TABLE IF NOT EXISTS production_safety_promotion_runs(
        id TEXT PRIMARY KEY, revalidation_run_id TEXT, release_version TEXT, rollout_run_id TEXT,
        phase TEXT NOT NULL, decision TEXT NOT NULL, promotion_percent REAL NOT NULL DEFAULT 0,
        gate_snapshot_json TEXT NOT NULL DEFAULT '{}', evidence_sha256 TEXT NOT NULL,
        operator TEXT, created_at TEXT NOT NULL, updated_at TEXT NOT NULL
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_safety_promotion_time ON production_safety_promotion_runs(updated_at DESC)")
    c.execute("CREATE INDEX IF NOT EXISTS idx_safety_promotion_rollout ON production_safety_promotion_runs(rollout_run_id,updated_at DESC)")
    try: c.commit()
    except Exception: pass

_V166_POLICY={
    'schema_version':'1.66',
    'state_machine':['PRECHECK','CANARY_PROMOTION','FULL_PROMOTION','COMPLETE','BLOCKED'],
    'required_revalidation_decision':'GO',
    'required_revalidation_phase':'RELEASE',
    'canary_percent':10.0,
    'full_percent':100.0,
    'operator_confirmation_required_for_promotion':True,
    'automatic_traffic_mutation':False,
    'automatic_rollback':False,
    'fail_closed':True,
}

def _v166_hash(payload):
    return hashlib.sha256(json.dumps(payload,sort_keys=True,separators=(',',':')).encode()).hexdigest()

def _v166_eval(snapshot):
    phase=str(snapshot.get('revalidation_phase') or '').upper()
    decision=str(snapshot.get('revalidation_decision') or '').upper()
    ledger=str(snapshot.get('ledger_status') or '').upper()
    conflict=bool(snapshot.get('conflict',False))
    release_bound=bool(snapshot.get('release_binding_pass',False))
    ok=(phase=='RELEASE' and decision=='GO' and ledger=='HEALTHY' and release_bound and not conflict)
    if not ok:
        reasons=[]
        if phase!='RELEASE': reasons.append('revalidation_phase')
        if decision!='GO': reasons.append('revalidation_decision')
        if ledger!='HEALTHY': reasons.append('ledger_status')
        if not release_bound: reasons.append('release_binding')
        if conflict: reasons.append('upstream_conflict')
        return {'decision':'HOLD','reason':'promotion precheck failed: '+','.join(reasons),'promotion_allowed':False}
    return {'decision':'GO','reason':'fresh v1.65 release revalidation and safety-chain evidence authorize promotion','promotion_allowed':True}

def _v166_collect(c, revalidation_run_id=None, rollout_run_id=None, release_version=None):
    row=None
    if revalidation_run_id:
        row=c.execute('SELECT * FROM production_safety_revalidation_runs WHERE id=?',(revalidation_run_id,)).fetchone()
    if not row:
        clauses=[]; args=[]
        if rollout_run_id: clauses.append('rollout_run_id=?'); args.append(rollout_run_id)
        if release_version: clauses.append('release_version=?'); args.append(release_version)
        where=(' WHERE '+' AND '.join(clauses)) if clauses else ''
        row=c.execute(f'SELECT * FROM production_safety_revalidation_runs{where} ORDER BY updated_at DESC LIMIT 1',tuple(args)).fetchone()
    snap={'schema_version':'1.66','revalidation_run_id':row['id'] if row else None,
          'release_version':row['release_version'] if row else release_version,
          'rollout_run_id':row['rollout_run_id'] if row else rollout_run_id,
          'revalidation_phase':str(row['phase']) if row else None,
          'revalidation_decision':str(row['decision']) if row else None,
          'ledger_status':None,'release_binding_pass':False,'conflict':False,'source_id':row['id'] if row else None}
    if row:
        try:
            gs=json.loads(row['gate_snapshot_json'] or '{}')
            snap['ledger_status']=gs.get('ledger_reconciliation_status') or ('HEALTHY' if gs.get('ledger_valid') else None)
            snap['release_binding_pass']=bool(gs.get('release_binding_pass', True if row['phase']=='RELEASE' and row['decision']=='GO' else False))
            snap['conflict']=bool(gs.get('upstream_conflict',False))
        except Exception: pass
    return snap

