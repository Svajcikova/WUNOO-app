def security_request_id(request):
    return request.headers.get("X-Request-ID") or ("req_"+uuid.uuid4().hex[:16])

def append_security_audit(c, *, event_type, request_id, outcome, http_status=None,
                          actor_id=None, actor_role=None, tenant_id=None,
                          resource=None, action=None, metadata=None):
    prev=c.execute("SELECT event_hash FROM security_audit_events ORDER BY created_at DESC,id DESC LIMIT 1").fetchone()
    prev_hash=prev["event_hash"] if prev else None
    payload={"event_type":event_type,"request_id":request_id,"actor_id":actor_id,
             "actor_role":actor_role,"tenant_id":tenant_id,"resource":resource,
             "action":action,"outcome":outcome,"http_status":http_status,
             "metadata":metadata or {},"prev_hash":prev_hash}
    raw=json.dumps(payload,sort_keys=True,separators=(",",":"),ensure_ascii=False)
    event_hash=hashlib.sha256(raw.encode()).hexdigest()
    eid="sae_"+uuid.uuid4().hex[:12]
    c.execute("""INSERT INTO security_audit_events
        (id,event_hash,prev_hash,event_type,request_id,actor_id,actor_role,tenant_id,resource,action,outcome,http_status,metadata_json,created_at)
        VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?)""",
        (eid,event_hash,prev_hash,event_type,request_id,actor_id,actor_role,tenant_id,
         resource,action,outcome,http_status,json.dumps(metadata or {},ensure_ascii=False),now()))
    return eid,event_hash


