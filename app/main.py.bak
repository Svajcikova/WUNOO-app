        cp=c.execute('SELECT * FROM production_global_recovery_finality_chain_checkpoints ORDER BY checkpoint_no DESC LIMIT 1').fetchone();fin=c.execute('SELECT * FROM production_global_recovery_finality_checkpoint_finality WHERE checkpoint_id=?',(cp['id'],)).fetchone() if cp else None;return {'schema_version':'1.104','checkpoint':dict(cp) if cp else None,'verification':_v104_verify_checkpoint(c,cp) if cp else {'valid':True,'reason':'NO_CHECKPOINTS'},'finality':dict(fin) if fin else None,'finality_verification':_v104_verify_finality(c,fin) if fin else {'valid':True,'reason':'NO_FINALITY'}}

# ---------------- WUNOO v1.103: Global Recovery Checkpoint Finality Chain ----------------
def migrate_v103(c):
    c.executescript("""CREATE TABLE IF NOT EXISTS production_global_recovery_checkpoint_finality_chain(
        id TEXT PRIMARY KEY, sequence_no INTEGER NOT NULL UNIQUE, finality_id TEXT NOT NULL UNIQUE,
        checkpoint_id TEXT NOT NULL, checkpoint_sha256 TEXT NOT NULL, finality_proof_sha256 TEXT NOT NULL,
        previous_entry_sha256 TEXT NOT NULL, entry_json TEXT NOT NULL, entry_sha256 TEXT NOT NULL UNIQUE,
        algorithm TEXT NOT NULL, signer_key_id TEXT NOT NULL, public_key_b64 TEXT NOT NULL,
        signature_b64 TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT
    );
    CREATE INDEX IF NOT EXISTS idx_v103_recovery_finality_chain_seq ON production_global_recovery_checkpoint_finality_chain(sequence_no);
    CREATE INDEX IF NOT EXISTS idx_v103_recovery_finality_chain_cp ON production_global_recovery_checkpoint_finality_chain(checkpoint_id);
    """)

_V103_POLICY={
    'schema_version':'1.103',
    'entry_format':'wunoo.release.global.recovery.checkpoint.finality.continuity.entry.v1',
    'hash':'SHA-256','algorithm':'Ed25519','genesis_hash':'0'*64,
    'requires_verified_v102_finality':True,'strict_sequence':True,'immutable_history':True,
    'cross_layer_binding_required':True,'no_automatic_recovery':True,'fail_closed':True,
    'no_automatic_release':True
}
def _v103_json(v): return json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False)
def _v103_hash(v): return hashlib.sha256(_v103_json(v).encode()).hexdigest()
def _v103_payload(seq,fin,prev):
    return {'format':_V103_POLICY['entry_format'],'schema_version':'1.103','sequence_no':int(seq),
            'finality_id':fin['id'],'checkpoint_id':fin['checkpoint_id'],'checkpoint_sha256':fin['checkpoint_sha256'],
            'finality_proof_sha256':fin['proof_sha256'],'previous_entry_sha256':prev,
            'continuity_state':'GLOBAL_RECOVERY_CHECKPOINT_FINALITY_CONTINUOUS'}
def _v103_verify_entry(c,row):
    try:
        obj=json.loads(row['entry_json'] or '{}')
        if obj.get('format')!=_V103_POLICY['entry_format'] or obj.get('schema_version')!='1.103': return {'valid':False,'reason':'V103_ENTRY_FORMAT_INVALID'}
        fields=(('sequence_no',int(row['sequence_no']),int(obj.get('sequence_no',-1))),('finality_id',row['finality_id'],obj.get('finality_id')),('checkpoint_id',row['checkpoint_id'],obj.get('checkpoint_id')),('checkpoint_sha256',row['checkpoint_sha256'],obj.get('checkpoint_sha256')),('finality_proof_sha256',row['finality_proof_sha256'],obj.get('finality_proof_sha256')),('previous_entry_sha256',row['previous_entry_sha256'],obj.get('previous_entry_sha256')))
        for _,a,b in fields:
            if a!=b:return {'valid':False,'reason':'V103_ENTRY_METADATA_INVALID'}
        if _v103_hash(obj)!=row['entry_sha256']:return {'valid':False,'reason':'V103_ENTRY_HASH_INVALID'}
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto(); Ed25519PublicKey.from_public_bytes(base64.b64decode(row['public_key_b64'],validate=True)).verify(base64.b64decode(row['signature_b64'],validate=True),_v103_json(obj).encode())
        fin=c.execute('SELECT * FROM production_global_recovery_chain_checkpoint_finality WHERE id=?',(row['finality_id'],)).fetchone()
        if not fin:return {'valid':False,'reason':'V102_FINALITY_NOT_FOUND'}
        fv=_v102_verify_finality(c,fin)
        if not fv.get('valid'):return {'valid':False,'reason':'V102_FINALITY_NOT_VERIFIABLE','detail':fv.get('reason')}
        if fin['checkpoint_id']!=row['checkpoint_id'] or fin['checkpoint_sha256']!=row['checkpoint_sha256'] or fin['proof_sha256']!=row['finality_proof_sha256']:return {'valid':False,'reason':'V103_UPSTREAM_BINDING_INVALID'}
        return {'valid':True,'sequence_no':int(row['sequence_no']),'finality_id':row['finality_id'],'checkpoint_id':row['checkpoint_id']}
    except Exception:return {'valid':False,'reason':'V103_ENTRY_INVALID'}
def _v103_verify_chain(c):
    try:
        rows=c.execute('SELECT * FROM production_global_recovery_checkpoint_finality_chain ORDER BY sequence_no ASC').fetchall();prev=_V103_POLICY['genesis_hash'];expected=1
        for row in rows:
            if int(row['sequence_no'])!=expected:return {'valid':False,'reason':'V103_SEQUENCE_GAP','expected_sequence_no':expected}
            if row['previous_entry_sha256']!=prev:return {'valid':False,'reason':'V103_PREVIOUS_HASH_MISMATCH','sequence_no':expected}
            vr=_v103_verify_entry(c,row)
            if not vr['valid']:return {'valid':False,'reason':vr['reason'],'sequence_no':expected,'detail':vr.get('detail')}
            prev=row['entry_sha256'];expected+=1
        return {'valid':True,'entries':len(rows),'head_entry_sha256':prev,'last_sequence_no':expected-1}
    except Exception:return {'valid':False,'reason':'V103_CHAIN_INVALID'}

@app.get('/api/v103/ops/global-recovery-checkpoint-finality-chain/policy')
def v103_policy(authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'});return _V103_POLICY
@app.post('/api/v103/ops/global-recovery-checkpoint-finality-chain/append')
def v103_append(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin'});p=payload or {};op=str(u.get('email') or u.get('id') or 'operator')
    with core_db_connect() as c:
        fid=p.get('finality_id')
        fin=c.execute('SELECT * FROM production_global_recovery_chain_checkpoint_finality WHERE id=?',(fid,)).fetchone() if fid else c.execute('SELECT * FROM production_global_recovery_chain_checkpoint_finality ORDER BY created_at DESC,id DESC LIMIT 1').fetchone()
        if not fin:raise HTTPException(404,'V102_FINALITY_NOT_FOUND')
        fv=_v102_verify_finality(c,fin)
        if not fv.get('valid'):raise HTTPException(409,'V102_FINALITY_NOT_VERIFIABLE')
        ex=c.execute('SELECT * FROM production_global_recovery_checkpoint_finality_chain WHERE finality_id=?',(fin['id'],)).fetchone()
        if ex:
            vr=_v103_verify_entry(c,ex)
            if vr['valid']:return {'schema_version':'1.103','idempotent':True,'entry':dict(ex),'verification':vr}
            raise HTTPException(409,'V103_EXISTING_ENTRY_INVALID')
        chain=_v103_verify_chain(c)
        if not chain['valid']:raise HTTPException(409,'V103_CHAIN_NOT_APPENDABLE')
        seq=int(chain['last_sequence_no'])+1;prev=chain['head_entry_sha256'];obj=_v103_payload(seq,fin,prev);eh=_v103_hash(obj);key,pub,keyid=_v169_load_signer();sig=base64.b64encode(key.sign(_v103_json(obj).encode())).decode();eid='grfc_'+uuid.uuid4().hex[:16];t=now()
        c.execute('INSERT INTO production_global_recovery_checkpoint_finality_chain(id,sequence_no,finality_id,checkpoint_id,checkpoint_sha256,finality_proof_sha256,previous_entry_sha256,entry_json,entry_sha256,algorithm,signer_key_id,public_key_b64,signature_b64,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(eid,seq,fin['id'],fin['checkpoint_id'],fin['checkpoint_sha256'],fin['proof_sha256'],prev,_v103_json(obj),eh,'Ed25519',keyid,base64.b64encode(pub).decode(),sig,'APPENDED',t,op));c.commit();row=c.execute('SELECT * FROM production_global_recovery_checkpoint_finality_chain WHERE id=?',(eid,)).fetchone();return {'schema_version':'1.103','idempotent':False,'entry':dict(row),'verification':_v103_verify_entry(c,row)}
@app.get('/api/v103/ops/global-recovery-checkpoint-finality-chain/verify')
def v103_verify(authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:return {'schema_version':'1.103',**_v103_verify_chain(c)}
@app.get('/api/v103/ops/global-recovery-checkpoint-finality-chain/latest')
def v103_latest(authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        row=c.execute('SELECT * FROM production_global_recovery_checkpoint_finality_chain ORDER BY sequence_no DESC LIMIT 1').fetchone();return {'schema_version':'1.103','entry':dict(row) if row else None,'verification':_v103_verify_chain(c)}


# ---------------- WUNOO v1.102: Global Recovery Consensus Chain Checkpoints & Cross-Federation Witnessing ----------------
def migrate_v102(c):
    c.executescript("""CREATE TABLE IF NOT EXISTS production_global_recovery_chain_checkpoints(
        id TEXT PRIMARY KEY, checkpoint_no INTEGER NOT NULL UNIQUE, chain_sequence_no INTEGER NOT NULL,
        chain_head_entry_sha256 TEXT NOT NULL, entry_count INTEGER NOT NULL,
        prefix_manifest_json TEXT NOT NULL, checkpoint_json TEXT NOT NULL,
        checkpoint_sha256 TEXT NOT NULL UNIQUE, algorithm TEXT NOT NULL,
        signer_key_id TEXT NOT NULL, public_key_b64 TEXT NOT NULL, signature_b64 TEXT NOT NULL,
        status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT
    );
    CREATE INDEX IF NOT EXISTS idx_v102_checkpoint_seq ON production_global_recovery_chain_checkpoints(chain_sequence_no);
    CREATE TABLE IF NOT EXISTS production_global_recovery_chain_checkpoint_attestations(
        id TEXT PRIMARY KEY, checkpoint_id TEXT NOT NULL, checkpoint_sha256 TEXT NOT NULL,
        federation_id TEXT NOT NULL, witness_id TEXT NOT NULL, key_id TEXT NOT NULL,
        public_key_b64 TEXT NOT NULL, signature_b64 TEXT NOT NULL, attestation_json TEXT NOT NULL,
        attestation_sha256 TEXT NOT NULL UNIQUE, status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT,
        UNIQUE(checkpoint_id,federation_id,witness_id)
    );
    CREATE INDEX IF NOT EXISTS idx_v102_checkpoint_att ON production_global_recovery_chain_checkpoint_attestations(checkpoint_id,federation_id);
    CREATE TABLE IF NOT EXISTS production_global_recovery_chain_checkpoint_finality(
        id TEXT PRIMARY KEY, checkpoint_id TEXT NOT NULL, checkpoint_sha256 TEXT NOT NULL,
        required_federation_quorum INTEGER NOT NULL, federation_count INTEGER NOT NULL,
        federation_ids_json TEXT NOT NULL, witness_ids_json TEXT NOT NULL,
        attestation_hashes_json TEXT NOT NULL, proof_json TEXT NOT NULL, proof_sha256 TEXT NOT NULL UNIQUE,
        algorithm TEXT NOT NULL, signer_key_id TEXT NOT NULL, public_key_b64 TEXT NOT NULL,
        signature_b64 TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT,
        UNIQUE(checkpoint_id)
    );
    """)

_V102_POLICY={
    'schema_version':'1.102',
    'checkpoint_format':'wunoo.release.global.recovery.chain.checkpoint.v1',
    'attestation_format':'wunoo.release.global.recovery.chain.checkpoint.attestation.v1',
    'finality_format':'wunoo.release.global.recovery.chain.checkpoint.federation.finality.v1',
    'hash':'SHA-256','algorithm':'Ed25519','genesis_hash':'0'*64,
    'checkpoint_scope':'GLOBAL_RECOVERY_CONSENSUS_CHAIN_PREFIX',
    'prefix_manifest_required':True,'requires_verified_v101_chain_prefix':True,
    'federation_membership_required':True,'active_trust_required':True,'current_key_required':True,
    'distinct_witnesses_required':True,'distinct_federations_required':True,
    'default_federation_quorum':'floor(2N/3)+1; N<3 => N',
    'destructive_restore':False,'automatic_restore':False,'immutable_history':True,
    'fail_closed':True,'no_automatic_release':True
}
def _v102_hash(v): return hashlib.sha256(json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()).hexdigest()
def _v102_json(v): return json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False)
def _v102_quorum(n):
    n=int(n)
    if n<1:return 0
    return n if n<3 else (2*n)//3+1
def _v102_manifest(c,seq):
    rows=c.execute('SELECT sequence_no,entry_sha256,consensus_id,checkpoint_id,decision_id FROM production_global_recovery_consensus_chain WHERE sequence_no<=? ORDER BY sequence_no ASC',(seq,)).fetchall()
    return [{'sequence_no':int(r['sequence_no']),'entry_sha256':r['entry_sha256'],'consensus_id':r['consensus_id'],'checkpoint_id':r['checkpoint_id'],'decision_id':r['decision_id']} for r in rows]
def _v102_checkpoint_payload(no,seq,head,manifest):
    return {'format':_V102_POLICY['checkpoint_format'],'schema_version':'1.102','checkpoint_no':int(no),'chain_sequence_no':int(seq),'chain_head_entry_sha256':head,'entry_count':len(manifest),'prefix_manifest':manifest}
def _v102_verify_checkpoint(c,row):
    try:
        obj=json.loads(row['checkpoint_json'] or '{}'); manifest=json.loads(row['prefix_manifest_json'] or '[]')
        if obj.get('format')!=_V102_POLICY['checkpoint_format'] or obj.get('schema_version')!='1.102': return {'valid':False,'reason':'V102_CHECKPOINT_FORMAT_INVALID'}
        if int(obj.get('checkpoint_no',-1))!=int(row['checkpoint_no']) or int(obj.get('chain_sequence_no',-1))!=int(row['chain_sequence_no']) or int(obj.get('entry_count',-1))!=int(row['entry_count']): return {'valid':False,'reason':'V102_CHECKPOINT_METADATA_INVALID'}
        if manifest!=json.loads(row['prefix_manifest_json'] or '[]') or len(manifest)!=int(row['entry_count']): return {'valid':False,'reason':'V102_CHECKPOINT_MANIFEST_INVALID'}
        prev=_V102_POLICY['genesis_hash']; expected=1
        for item in manifest:
            if int(item.get('sequence_no',-1))!=expected or not item.get('entry_sha256'): return {'valid':False,'reason':'V102_CHECKPOINT_MANIFEST_SEQUENCE_INVALID','sequence_no':expected}
            expected+=1
        head=manifest[-1]['entry_sha256'] if manifest else _V102_POLICY['genesis_hash']
        if int(row['chain_sequence_no'])!=len(manifest) or row['chain_head_entry_sha256']!=head or obj.get('chain_head_entry_sha256')!=head: return {'valid':False,'reason':'V102_CHECKPOINT_HEAD_INVALID'}
        if _v102_hash(obj)!=row['checkpoint_sha256']: return {'valid':False,'reason':'V102_CHECKPOINT_HASH_INVALID'}
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto(); Ed25519PublicKey.from_public_bytes(base64.b64decode(row['public_key_b64'],validate=True)).verify(base64.b64decode(row['signature_b64'],validate=True),_v102_json(obj).encode())
        current=c.execute('SELECT * FROM production_global_recovery_consensus_chain WHERE sequence_no<=? ORDER BY sequence_no ASC',(int(row['chain_sequence_no']),)).fetchall()
        if len(current)!=len(manifest): return {'valid':False,'reason':'CURRENT_RECOVERY_CHAIN_DIVERGED'}
        for cur,item in zip(current,manifest):
            if int(cur['sequence_no'])!=int(item['sequence_no']) or cur['entry_sha256']!=item['entry_sha256'] or cur['consensus_id']!=item['consensus_id'] or cur['checkpoint_id']!=item['checkpoint_id'] or cur['decision_id']!=item['decision_id']: return {'valid':False,'reason':'CURRENT_RECOVERY_CHAIN_DIVERGED','sequence_no':int(item['sequence_no'])}
            vr=_v101_verify_entry(c,cur)
            if not vr['valid']: return {'valid':False,'reason':'CURRENT_RECOVERY_CHAIN_PREFIX_INVALID','sequence_no':int(item['sequence_no']),'detail':vr.get('reason')}
        return {'valid':True,'checkpoint_no':int(row['checkpoint_no']),'chain_sequence_no':int(row['chain_sequence_no']),'chain_head_entry_sha256':head,'entries':len(manifest)}
    except Exception:return {'valid':False,'reason':'V102_CHECKPOINT_INVALID'}
def _v102_attestation_payload(cp,fed,wid,keyid):
    return {'format':_V102_POLICY['attestation_format'],'schema_version':'1.102','checkpoint_id':cp['id'],'checkpoint_sha256':cp['checkpoint_sha256'],'federation_id':fed['id'],'witness_id':wid,'key_id':keyid}
def _v102_verify_attestation(c,row,cp,fed):
    try:
        cv=_v102_verify_checkpoint(c,cp); fv=_v184_verify_federation(c,fed)
        if not cv['valid']:return {'valid':False,'reason':'CHECKPOINT_NOT_VERIFIABLE','detail':cv.get('reason')}
        if not fv['valid']:return {'valid':False,'reason':'FEDERATION_NOT_VERIFIABLE','detail':fv.get('reason')}
        if row['witness_id'] not in set(json.loads(fed['member_witness_ids_json'] or '[]')):return {'valid':False,'reason':'WITNESS_NOT_FEDERATION_MEMBER'}
        obj=json.loads(row['attestation_json'] or '{}'); exp=_v102_attestation_payload(cp,fed,row['witness_id'],row['key_id'])
        if obj!=exp:return {'valid':False,'reason':'V102_ATTESTATION_PAYLOAD_INVALID'}
        if row['checkpoint_sha256']!=cp['checkpoint_sha256'] or _v102_hash(obj)!=row['attestation_sha256']:return {'valid':False,'reason':'V102_ATTESTATION_BINDING_INVALID'}
        raw=base64.b64decode(row['public_key_b64'],validate=True)
        if _v176_key_id(raw)!=row['key_id']:return {'valid':False,'reason':'V102_ATTESTATION_KEY_ID_INVALID'}
        reg=_v176_registry_row(c,row['witness_id'])
        if not reg or reg['status']!='ACTIVE' or reg['current_key_id']!=row['key_id'] or reg['current_public_key_b64']!=row['public_key_b64']:return {'valid':False,'reason':'WITNESS_TRUST_OR_KEY_INVALID'}
        tv=_v177_evaluate(c,row['witness_id'])
        if not tv['valid']:return {'valid':False,'reason':tv['reason']}
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto();Ed25519PublicKey.from_public_bytes(raw).verify(base64.b64decode(row['signature_b64'],validate=True),_v102_json(obj).encode())
        return {'valid':True,'witness_id':row['witness_id'],'federation_id':fed['id'],'key_id':row['key_id']}
    except Exception:return {'valid':False,'reason':'V102_ATTESTATION_INVALID'}
def _v102_finality_payload(cp,q,fids,wids,ahs):
    return {'format':_V102_POLICY['finality_format'],'schema_version':'1.102','checkpoint_id':cp['id'],'checkpoint_sha256':cp['checkpoint_sha256'],'required_federation_quorum':int(q),'federation_ids':list(fids),'witness_ids':list(wids),'attestation_hashes':list(ahs),'finality_state':'RECOVERY_CHAIN_CHECKPOINT_FEDERALLY_FINAL'}
def _v102_verify_finality(c,row):
    try:
        cp=c.execute('SELECT * FROM production_global_recovery_chain_checkpoints WHERE id=?',(row['checkpoint_id'],)).fetchone()
        if not cp:return {'valid':False,'reason':'V102_CHECKPOINT_NOT_FOUND'}
        cv=_v102_verify_checkpoint(c,cp)
        if not cv['valid']:return {'valid':False,'reason':'V102_CHECKPOINT_NOT_VERIFIABLE','detail':cv.get('reason')}
        fids=json.loads(row['federation_ids_json'] or '[]');wids=json.loads(row['witness_ids_json'] or '[]');ahs=json.loads(row['attestation_hashes_json'] or '[]'); q=int(row['required_federation_quorum'])
        if q<1 or q>len(fids) or len(fids)<q or len(set(fids))!=len(fids) or len(wids)!=len(ahs) or len(wids)!=q or len(set(wids))!=len(wids) or len(set(fids))<q:return {'valid':False,'reason':'V102_FINALITY_QUORUM_INVALID'}
        valid=[];covered=set();seen=set()
        for ah in ahs:
            ar=c.execute('SELECT * FROM production_global_recovery_chain_checkpoint_attestations WHERE attestation_sha256=?',(ah,)).fetchone()
            if not ar:continue
            fed=c.execute('SELECT * FROM production_global_checkpoint_federations WHERE id=?',(ar['federation_id'],)).fetchone()
            vr=_v102_verify_attestation(c,ar,cp,fed)
            if vr['valid'] and vr['witness_id'] in wids and vr['witness_id'] not in seen:seen.add(vr['witness_id']);covered.add(vr['federation_id']);valid.append(vr)
        if len(valid)!=q or len(covered)!=q:return {'valid':False,'reason':'V102_FEDERATION_QUORUM_NOT_VERIFIED'}
        obj=json.loads(row['proof_json'] or '{}');exp=_v102_finality_payload(cp,q,fids,wids,ahs)
        if obj!=exp or _v102_hash(obj)!=row['proof_sha256']:return {'valid':False,'reason':'V102_FINALITY_PROOF_INVALID'}
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto();Ed25519PublicKey.from_public_bytes(base64.b64decode(row['public_key_b64'],validate=True)).verify(base64.b64decode(row['signature_b64'],validate=True),_v102_json(obj).encode())
        return {'valid':True,'checkpoint_id':cp['id'],'required_federation_quorum':q,'federations':sorted(covered),'witnesses':sorted(seen)}
    except Exception:return {'valid':False,'reason':'V102_FINALITY_INVALID'}

@app.get('/api/v102/ops/global-recovery-chain-checkpoints/policy')
def v102_policy(authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'});return _V102_POLICY
@app.post('/api/v102/ops/global-recovery-chain-checkpoints/issue')
def v102_issue(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin'});p=payload or {};op=str(u.get('email') or u.get('id') or 'operator')
    with core_db_connect() as c:
        chain=_v101_verify_chain(c)
        if not chain['valid']:raise HTTPException(409,'V101_CHAIN_NOT_VERIFIABLE')
        seq=int(p.get('chain_sequence_no') or chain.get('entries',0))
        if seq<0 or seq>int(chain.get('entries',0)):raise HTTPException(409,'V102_CHECKPOINT_SEQUENCE_INVALID')
        ex=c.execute('SELECT * FROM production_global_recovery_chain_checkpoints WHERE chain_sequence_no=? ORDER BY checkpoint_no DESC LIMIT 1',(seq,)).fetchone()
        if ex and _v102_verify_checkpoint(c,ex)['valid']:return {'schema_version':'1.102','idempotent':True,'checkpoint':dict(ex),'verification':_v102_verify_checkpoint(c,ex)}
        manifest=_v102_manifest(c,seq);head=manifest[-1]['entry_sha256'] if manifest else _V102_POLICY['genesis_hash'];no=int(c.execute('SELECT COALESCE(MAX(checkpoint_no),0)+1 n FROM production_global_recovery_chain_checkpoints').fetchone()['n']);obj=_v102_checkpoint_payload(no,seq,head,manifest);ch=_v102_hash(obj);key,pub,keyid=_v169_load_signer();sig=base64.b64encode(key.sign(_v102_json(obj).encode())).decode();cid='grcp_'+uuid.uuid4().hex[:16];t=now()
        c.execute('INSERT INTO production_global_recovery_chain_checkpoints(id,checkpoint_no,chain_sequence_no,chain_head_entry_sha256,entry_count,prefix_manifest_json,checkpoint_json,checkpoint_sha256,algorithm,signer_key_id,public_key_b64,signature_b64,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(cid,no,seq,head,len(manifest),_v102_json(manifest),_v102_json(obj),ch,'Ed25519',keyid,base64.b64encode(pub).decode(),sig,'CHECKPOINTED',t,op));c.commit();row=c.execute('SELECT * FROM production_global_recovery_chain_checkpoints WHERE id=?',(cid,)).fetchone();return {'schema_version':'1.102','idempotent':False,'checkpoint':dict(row),'verification':_v102_verify_checkpoint(c,row)}
@app.post('/api/v102/ops/global-recovery-chain-checkpoints/attest')
def v102_attest(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'});p=payload or {};cid=str(p.get('checkpoint_id') or '').strip();fid=str(p.get('federation_id') or '').strip();wid=str(p.get('witness_id') or '').strip();pub=str(p.get('public_key_b64') or '').strip();sig=str(p.get('signature_b64') or '').strip()
    if not all((cid,fid,wid,pub,sig)):raise HTTPException(400,'checkpoint_id,federation_id,witness_id,public_key_b64,signature_b64 required')
    with core_db_connect() as c:
        cp=c.execute('SELECT * FROM production_global_recovery_chain_checkpoints WHERE id=?',(cid,)).fetchone();fed=c.execute('SELECT * FROM production_global_checkpoint_federations WHERE id=?',(fid,)).fetchone()
        if not cp:raise HTTPException(404,'V102_CHECKPOINT_NOT_FOUND')
        if not fed:raise HTTPException(404,'V102_FEDERATION_NOT_FOUND')
        try:keyid=_v176_key_id(base64.b64decode(pub,validate=True))
        except Exception:raise HTTPException(400,'V102_PUBLIC_KEY_INVALID')
        obj=_v102_attestation_payload(cp,fed,wid,keyid);digest=_v102_hash(obj);ex=c.execute('SELECT * FROM production_global_recovery_chain_checkpoint_attestations WHERE checkpoint_id=? AND federation_id=? AND witness_id=?',(cid,fid,wid)).fetchone()
        if ex:
            if ex['attestation_sha256']==digest and ex['signature_b64']==sig:return {'schema_version':'1.102','idempotent':True,'attestation':dict(ex),'verification':_v102_verify_attestation(c,ex,cp,fed)}
            raise HTTPException(409,'V102_ATTESTATION_ALREADY_EXISTS')
        temp={'checkpoint_sha256':cp['checkpoint_sha256'],'federation_id':fid,'witness_id':wid,'key_id':keyid,'public_key_b64':pub,'signature_b64':sig,'attestation_json':_v102_json(obj),'attestation_sha256':digest}
        vr=_v102_verify_attestation(c,temp,cp,fed)
        if not vr['valid']:raise HTTPException(409,vr['reason'])
        aid='grca_'+uuid.uuid4().hex[:16];t=now();op=str(u.get('email') or u.get('id') or 'operator');c.execute('INSERT INTO production_global_recovery_chain_checkpoint_attestations(id,checkpoint_id,checkpoint_sha256,federation_id,witness_id,key_id,public_key_b64,signature_b64,attestation_json,attestation_sha256,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?)',(aid,cid,cp['checkpoint_sha256'],fid,wid,keyid,pub,sig,_v102_json(obj),digest,'VERIFIED',t,op));c.commit();row=c.execute('SELECT * FROM production_global_recovery_chain_checkpoint_attestations WHERE id=?',(aid,)).fetchone();return {'schema_version':'1.102','idempotent':False,'attestation':dict(row),'verification':_v102_verify_attestation(c,row,cp,fed)}
@app.post('/api/v102/ops/global-recovery-chain-checkpoints/finalize')
def v102_finalize(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin'});p=payload or {};op=str(u.get('email') or u.get('id') or 'operator')
    with core_db_connect() as c:
        cp=c.execute('SELECT * FROM production_global_recovery_chain_checkpoints WHERE id=?',(p.get('checkpoint_id'),)).fetchone() if p.get('checkpoint_id') else c.execute('SELECT * FROM production_global_recovery_chain_checkpoints ORDER BY checkpoint_no DESC LIMIT 1').fetchone()
        if not cp:raise HTTPException(404,'V102_CHECKPOINT_NOT_FOUND')
        cv=_v102_verify_checkpoint(c,cp)
        if not cv['valid']:raise HTTPException(409,'V102_CHECKPOINT_NOT_FINALIZABLE')
        ex=c.execute('SELECT * FROM production_global_recovery_chain_checkpoint_finality WHERE checkpoint_id=?',(cp['id'],)).fetchone()
        if ex:return {'schema_version':'1.102','idempotent':True,'finality':dict(ex),'verification':_v102_verify_finality(c,ex)}
        fids=sorted({r['federation_id'] for r in c.execute('SELECT * FROM production_global_recovery_chain_checkpoint_attestations WHERE checkpoint_id=?',(cp['id'],)).fetchall()});q=int(p.get('required_federation_quorum') or _v102_quorum(len(fids)))
        if q<1 or q>len(fids):raise HTTPException(409,'V102_QUORUM_INVALID')
        rows=c.execute('SELECT * FROM production_global_recovery_chain_checkpoint_attestations WHERE checkpoint_id=? ORDER BY federation_id,witness_id,attestation_sha256',(cp['id'],)).fetchall();chosen=[];seen_w=set();seen_f=set()
        for r in rows:
            if r['federation_id'] in seen_f:continue
            fed=c.execute('SELECT * FROM production_global_checkpoint_federations WHERE id=?',(r['federation_id'],)).fetchone();vr=_v102_verify_attestation(c,r,cp,fed)
            if vr['valid'] and vr['witness_id'] not in seen_w:chosen.append((r,vr));seen_w.add(vr['witness_id']);seen_f.add(vr['federation_id'])
            if len(chosen)>=q:break
        if len(chosen)<q:raise HTTPException(409,'V102_FEDERATION_QUORUM_NOT_REACHED')
        wids=[x[1]['witness_id'] for x in chosen];ahs=[x[0]['attestation_sha256'] for x in chosen];proof=_v102_finality_payload(cp,q,sorted(seen_f),wids,ahs);ph=_v102_hash(proof);key,pub,keyid=_v169_load_signer();sig=base64.b64encode(key.sign(_v102_json(proof).encode())).decode();fid='grcf_'+uuid.uuid4().hex[:16];t=now();c.execute('INSERT INTO production_global_recovery_chain_checkpoint_finality(id,checkpoint_id,checkpoint_sha256,required_federation_quorum,federation_count,federation_ids_json,witness_ids_json,attestation_hashes_json,proof_json,proof_sha256,algorithm,signer_key_id,public_key_b64,signature_b64,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(fid,cp['id'],cp['checkpoint_sha256'],q,len(seen_f),_v102_json(sorted(seen_f)),_v102_json(wids),_v102_json(ahs),_v102_json(proof),ph,'Ed25519',keyid,base64.b64encode(pub).decode(),sig,'FINALIZED',t,op));c.commit();row=c.execute('SELECT * FROM production_global_recovery_chain_checkpoint_finality WHERE id=?',(fid,)).fetchone();return {'schema_version':'1.102','idempotent':False,'finality':dict(row),'verification':_v102_verify_finality(c,row)}
@app.get('/api/v102/ops/global-recovery-chain-checkpoints/verify')
def v102_verify(authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        cps=c.execute('SELECT * FROM production_global_recovery_chain_checkpoints ORDER BY checkpoint_no').fetchall()
        for i,r in enumerate(cps,1):
            vr=_v102_verify_checkpoint(c,r)
            if not vr['valid']:return {'schema_version':'1.102','valid':False,'reason':vr['reason'],'checked_checkpoints':i}
        fins=c.execute('SELECT * FROM production_global_recovery_chain_checkpoint_finality ORDER BY created_at,id').fetchall()
        for i,r in enumerate(fins,1):
            vr=_v102_verify_finality(c,r)
            if not vr['valid']:return {'schema_version':'1.102','valid':False,'reason':vr['reason'],'checked_finalities':i}
        return {'schema_version':'1.102','valid':True,'reason':'GLOBAL_RECOVERY_CHAIN_CHECKPOINTS_AND_FEDERATION_FINALITY_VERIFIED','checkpoints':len(cps),'finalities':len(fins)}
@app.get('/api/v102/ops/global-recovery-chain-checkpoints/latest')
def v102_latest(authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        r=c.execute('SELECT * FROM production_global_recovery_chain_checkpoints ORDER BY checkpoint_no DESC LIMIT 1').fetchone();return {'schema_version':'1.102','checkpoint':dict(r) if r else None,'verification':_v102_verify_checkpoint(c,r) if r else {'valid':True,'reason':'NO_CHECKPOINTS'}}


# ---------------- WUNOO v1.99: Global Finality Checkpoint Federation & Recovery Quorum ----------------
def migrate_v199(c):
    c.executescript("""CREATE TABLE IF NOT EXISTS production_global_finality_checkpoint_federation_attestations(
        id TEXT PRIMARY KEY, checkpoint_id TEXT NOT NULL, checkpoint_sha256 TEXT NOT NULL,
        federation_id TEXT NOT NULL, federation_sha256 TEXT NOT NULL, witness_id TEXT NOT NULL,
        key_id TEXT NOT NULL, public_key_b64 TEXT NOT NULL, signature_b64 TEXT NOT NULL,
        attestation_json TEXT NOT NULL, attestation_sha256 TEXT NOT NULL UNIQUE,
        status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT,
        UNIQUE(checkpoint_id,federation_id,witness_id)
    );
    CREATE INDEX IF NOT EXISTS idx_v199_cp_fed_att ON production_global_finality_checkpoint_federation_attestations(checkpoint_id,federation_id);
    CREATE TABLE IF NOT EXISTS production_global_finality_checkpoint_federation_finality(
        id TEXT PRIMARY KEY, checkpoint_id TEXT NOT NULL, checkpoint_sha256 TEXT NOT NULL,
        federation_id TEXT NOT NULL, federation_sha256 TEXT NOT NULL, quorum_required INTEGER NOT NULL,
        witness_count INTEGER NOT NULL, witness_ids_json TEXT NOT NULL, attestation_hashes_json TEXT NOT NULL,
        proof_json TEXT NOT NULL, proof_sha256 TEXT NOT NULL UNIQUE, algorithm TEXT NOT NULL,
        signer_key_id TEXT NOT NULL, public_key_b64 TEXT NOT NULL, signature_b64 TEXT NOT NULL,
        status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT,
        UNIQUE(checkpoint_id,federation_id)
    );
    CREATE TABLE IF NOT EXISTS production_global_finality_checkpoint_recovery_quorum(
        id TEXT PRIMARY KEY, checkpoint_id TEXT NOT NULL, checkpoint_sha256 TEXT NOT NULL,
        federation_finality_id TEXT NOT NULL, federation_id TEXT NOT NULL, restore_sequence_no INTEGER NOT NULL,
        restore_entry_sha256 TEXT NOT NULL, recovery_mode TEXT NOT NULL, decision_json TEXT NOT NULL,
        decision_sha256 TEXT NOT NULL UNIQUE, algorithm TEXT NOT NULL, signer_key_id TEXT NOT NULL,
        public_key_b64 TEXT NOT NULL, signature_b64 TEXT NOT NULL, status TEXT NOT NULL,
        created_at TEXT NOT NULL, operator TEXT
    );
    CREATE INDEX IF NOT EXISTS idx_v199_recovery_quorum_checkpoint ON production_global_finality_checkpoint_recovery_quorum(checkpoint_id);
    """)

_V199_POLICY={
    'schema_version':'1.99','attestation_format':'wunoo.release.global.finality.checkpoint.federation.attestation.v1',
    'finality_format':'wunoo.release.global.finality.checkpoint.federation.finality.v1',
    'recovery_format':'wunoo.release.global.finality.checkpoint.federation.recovery.quorum.v1',
    'hash':'SHA-256','algorithm':'Ed25519','distinct_witnesses_required':True,
    'federation_membership_required':True,'active_trust_required':True,'current_key_required':True,
    'checkpoint_must_verify':True,'quorum_required_from_federation':True,
    'destructive_restore':False,'automatic_restore':False,'immutable_history':True,
    'fail_closed':True,'no_automatic_release':True
}
def _v199_hash(v): return hashlib.sha256(json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()).hexdigest()
def _v199_json(v): return json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False)
def _v199_attestation_payload(cp,fed,wid,keyid):
    return {'format':_V199_POLICY['attestation_format'],'schema_version':'1.99','checkpoint_sha256':cp['checkpoint_sha256'],
            'federation_id':fed['id'],'federation_sha256':fed['federation_sha256'],'witness_id':wid,'key_id':keyid}
def _v199_verify_attestation(c,row,cp,fed):
    try:
        if not cp or not fed:return {'valid':False,'reason':'V199_BINDING_OBJECT_NOT_FOUND'}
        cv=_v198_verify_checkpoint(c,cp)
        if not cv['valid']:return {'valid':False,'reason':'CHECKPOINT_NOT_VERIFIABLE','detail':cv.get('reason')}
        fv=_v184_verify_federation(c,fed)
        if not fv['valid']:return {'valid':False,'reason':'FEDERATION_NOT_VERIFIABLE','detail':fv.get('reason')}
        members=json.loads(fed['member_witness_ids_json'] or '[]')
        if row['witness_id'] not in members:return {'valid':False,'reason':'WITNESS_NOT_FEDERATION_MEMBER'}
        obj=json.loads(row['attestation_json'] or '{}')
        expected=_v199_attestation_payload(cp,fed,row['witness_id'],row['key_id'])
        if obj!=expected:return {'valid':False,'reason':'V199_ATTESTATION_PAYLOAD_INVALID'}
        if row['checkpoint_sha256']!=cp['checkpoint_sha256'] or row['federation_sha256']!=fed['federation_sha256']:return {'valid':False,'reason':'V199_ATTESTATION_BINDING_INVALID'}
        if _v199_hash(obj)!=row['attestation_sha256']:return {'valid':False,'reason':'V199_ATTESTATION_HASH_INVALID'}
        raw=base64.b64decode(row['public_key_b64'],validate=True)
        if _v176_key_id(raw)!=row['key_id']:return {'valid':False,'reason':'V199_ATTESTATION_KEY_ID_INVALID'}
        reg=_v176_registry_row(c,row['witness_id'])
        if not reg or reg['status']!='ACTIVE':return {'valid':False,'reason':'WITNESS_NOT_ACTIVE'}
        if reg['current_key_id']!=row['key_id'] or reg['current_public_key_b64']!=row['public_key_b64']:return {'valid':False,'reason':'WITNESS_KEY_NOT_CURRENT'}
        tv=_v177_evaluate(c,row['witness_id'])
        if not tv['valid']:return {'valid':False,'reason':tv['reason']}
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto();Ed25519PublicKey.from_public_bytes(raw).verify(base64.b64decode(row['signature_b64'],validate=True),_v199_json(obj).encode())
        return {'valid':True,'witness_id':row['witness_id'],'federation_id':fed['id'],'key_id':row['key_id']}
    except Exception:return {'valid':False,'reason':'V199_ATTESTATION_INVALID'}
def _v199_finality_payload(cp,fed,q,wids,hashes):
    return {'format':_V199_POLICY['finality_format'],'schema_version':'1.99','checkpoint_id':cp['id'],
            'checkpoint_sha256':cp['checkpoint_sha256'],'federation_id':fed['id'],'federation_sha256':fed['federation_sha256'],
            'quorum_required':q,'witness_ids':wids,'attestation_hashes':hashes,'finality_state':'FEDERATED_CHECKPOINT_FINAL'}
def _v199_verify_finality(c,row):
    try:
        cp=c.execute('SELECT * FROM production_global_finality_checkpoints WHERE id=?',(row['checkpoint_id'],)).fetchone()
        fed=c.execute('SELECT * FROM production_global_checkpoint_federations WHERE id=?',(row['federation_id'],)).fetchone()
        if not cp:return {'valid':False,'reason':'CHECKPOINT_NOT_FOUND'}
        if not fed:return {'valid':False,'reason':'FEDERATION_NOT_FOUND'}
        cv=_v198_verify_checkpoint(c,cp)
        if not cv['valid']:return {'valid':False,'reason':'CHECKPOINT_NOT_VERIFIABLE','detail':cv.get('reason')}
        fv=_v184_verify_federation(c,fed)
        if not fv['valid']:return {'valid':False,'reason':'FEDERATION_NOT_VERIFIABLE','detail':fv.get('reason')}
        ids=json.loads(row['witness_ids_json'] or '[]');ahs=json.loads(row['attestation_hashes_json'] or '[]');members=set(json.loads(fed['member_witness_ids_json'] or '[]'))
        if row['checkpoint_sha256']!=cp['checkpoint_sha256'] or row['federation_sha256']!=fed['federation_sha256']:return {'valid':False,'reason':'V199_FINALITY_BINDING_INVALID'}
        if int(row['quorum_required'])!=int(fed['quorum_required']):return {'valid':False,'reason':'V199_FEDERATION_QUORUM_CHANGED'}
        if len(ids)!=len(ahs) or len(ids)!=int(row['witness_count']) or len(ids)<int(row['quorum_required']) or len(set(ids))!=len(ids) or any(x not in members for x in ids):return {'valid':False,'reason':'V199_QUORUM_INVALID'}
        proof=json.loads(row['proof_json'] or '{}')
        if proof!=_v199_finality_payload(cp,fed,int(row['quorum_required']),ids,ahs):return {'valid':False,'reason':'V199_FINALITY_PROOF_INVALID'}
        if _v199_hash(proof)!=row['proof_sha256']:return {'valid':False,'reason':'V199_FINALITY_PROOF_HASH_INVALID'}
        for aid,wid in zip(ahs,ids):
            a=c.execute('SELECT * FROM production_global_finality_checkpoint_federation_attestations WHERE attestation_sha256=?',(aid,)).fetchone()
            if not a:return {'valid':False,'reason':'V199_ATTESTATION_NOT_FOUND'}
            ar=_v199_verify_attestation(c,a,cp,fed)
            if not ar['valid']:return {'valid':False,'reason':ar['reason'],'witness_id':wid}
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto();Ed25519PublicKey.from_public_bytes(base64.b64decode(row['public_key_b64'],validate=True)).verify(base64.b64decode(row['signature_b64'],validate=True),_v199_json(proof).encode())
        return {'valid':True,'reason':'FEDERATED_GLOBAL_CHECKPOINT_FINALITY_VERIFIED','witness_count':len(ids),'quorum_required':int(row['quorum_required'])}
    except Exception:return {'valid':False,'reason':'V199_FINALITY_INVALID'}
def _v199_recovery_payload(cp,fin):
    return {'format':_V199_POLICY['recovery_format'],'schema_version':'1.99','checkpoint_id':cp['id'],
            'checkpoint_sha256':cp['checkpoint_sha256'],'federation_finality_id':fin['id'],'federation_id':fin['federation_id'],
            'restore_sequence_no':int(cp['chain_sequence_no']),'restore_entry_sha256':cp['chain_head_entry_sha256'],
            'recovery_mode':'READ_ONLY_RECONSTRUCTION','no_chain_mutation':True}

@app.get('/api/v199/ops/global-finality-checkpoint-federation/policy')
def v199_policy(authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'});return _V199_POLICY
@app.post('/api/v199/ops/global-finality-checkpoint-federation/attest')
def v199_attest(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'});p=payload or {};cid=str(p.get('checkpoint_id') or '').strip();fid=str(p.get('federation_id') or '').strip();wid=str(p.get('witness_id') or '').strip();pub=str(p.get('public_key_b64') or '').strip();sig=str(p.get('signature_b64') or '').strip()
    if not cid or not fid or not wid or not pub or not sig:raise HTTPException(400,'checkpoint_id,federation_id,witness_id,public_key_b64,signature_b64 required')
    with core_db_connect() as c:
        cp=c.execute('SELECT * FROM production_global_finality_checkpoints WHERE id=?',(cid,)).fetchone();fed=c.execute('SELECT * FROM production_global_checkpoint_federations WHERE id=?',(fid,)).fetchone()
        if not cp:raise HTTPException(404,'GLOBAL_CHECKPOINT_NOT_FOUND')
        if not fed:raise HTTPException(404,'FEDERATION_NOT_FOUND')
        if not _v198_verify_checkpoint(c,cp)['valid']:raise HTTPException(409,'GLOBAL_CHECKPOINT_NOT_VERIFIABLE')
        if not _v184_verify_federation(c,fed)['valid']:raise HTTPException(409,'FEDERATION_NOT_VERIFIABLE')
        if wid not in set(json.loads(fed['member_witness_ids_json'] or '[]')):raise HTTPException(409,'WITNESS_NOT_FEDERATION_MEMBER')
        try:keyid=_v176_key_id(base64.b64decode(pub,validate=True))
        except Exception:raise HTTPException(400,'PUBLIC_KEY_INVALID')
        obj=_v199_attestation_payload(cp,fed,wid,keyid);digest=_v199_hash(obj);existing=c.execute('SELECT * FROM production_global_finality_checkpoint_federation_attestations WHERE checkpoint_id=? AND federation_id=? AND witness_id=?',(cid,fid,wid)).fetchone()
        if existing:
            if existing['attestation_sha256']==digest and existing['signature_b64']==sig and existing['public_key_b64']==pub:return {'schema_version':'1.99','idempotent':True,'attestation':dict(existing),'verification':_v199_verify_attestation(c,existing,cp,fed)}
            raise HTTPException(409,'V199_ATTESTATION_ALREADY_EXISTS')
        temp={'id':'','checkpoint_id':cid,'checkpoint_sha256':cp['checkpoint_sha256'],'federation_id':fid,'federation_sha256':fed['federation_sha256'],'witness_id':wid,'key_id':keyid,'public_key_b64':pub,'signature_b64':sig,'attestation_json':_v199_json(obj),'attestation_sha256':digest}
        vr=_v199_verify_attestation(c,temp,cp,fed)
        if not vr['valid']:raise HTTPException(409,vr['reason'])
        aid='gfa_'+uuid.uuid4().hex[:16];t=now();op=str(u.get('email') or u.get('id') or 'operator')
        c.execute('INSERT INTO production_global_finality_checkpoint_federation_attestations(id,checkpoint_id,checkpoint_sha256,federation_id,federation_sha256,witness_id,key_id,public_key_b64,signature_b64,attestation_json,attestation_sha256,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(aid,cid,cp['checkpoint_sha256'],fid,fed['federation_sha256'],wid,keyid,pub,sig,_v199_json(obj),digest,'VERIFIED',t,op));c.commit();row=c.execute('SELECT * FROM production_global_finality_checkpoint_federation_attestations WHERE id=?',(aid,)).fetchone();return {'schema_version':'1.99','idempotent':False,'attestation':dict(row),'verification':_v199_verify_attestation(c,row,cp,fed)}
@app.post('/api/v199/ops/global-finality-checkpoint-federation/finalize')
def v199_finalize(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin'});p=payload or {}
    with core_db_connect() as c:
        cp=c.execute('SELECT * FROM production_global_finality_checkpoints WHERE id=?',(p.get('checkpoint_id'),)).fetchone() if p.get('checkpoint_id') else c.execute('SELECT * FROM production_global_finality_checkpoints ORDER BY checkpoint_no DESC LIMIT 1').fetchone()
        fed=c.execute('SELECT * FROM production_global_checkpoint_federations WHERE id=?',(p.get('federation_id'),)).fetchone() if p.get('federation_id') else c.execute('SELECT * FROM production_global_checkpoint_federations ORDER BY federation_no DESC LIMIT 1').fetchone()
        if not cp:raise HTTPException(404,'GLOBAL_CHECKPOINT_NOT_FOUND')
        if not fed:raise HTTPException(404,'FEDERATION_NOT_FOUND')
        cv=_v198_verify_checkpoint(c,cp);fv=_v184_verify_federation(c,fed)
        if not cv['valid']:raise HTTPException(409,'GLOBAL_CHECKPOINT_NOT_FINALIZABLE')
        if not fv['valid']:raise HTTPException(409,'FEDERATION_NOT_FINALIZABLE')
        existing=c.execute('SELECT * FROM production_global_finality_checkpoint_federation_finality WHERE checkpoint_id=? AND federation_id=?',(cp['id'],fed['id'])).fetchone()
        if existing:return {'schema_version':'1.99','idempotent':True,'finality':dict(existing),'verification':_v199_verify_finality(c,existing)}
        q=int(fed['quorum_required']);rows=c.execute('SELECT * FROM production_global_finality_checkpoint_federation_attestations WHERE checkpoint_id=? AND federation_id=? ORDER BY witness_id,attestation_sha256',(cp['id'],fed['id'])).fetchall();valid=[];seen=set()
        for a in rows:
            ar=_v199_verify_attestation(c,a,cp,fed)
            if ar['valid'] and ar['witness_id'] not in seen:seen.add(ar['witness_id']);valid.append(a)
        if len(valid)<q:raise HTTPException(409,'V199_FEDERATION_QUORUM_NOT_REACHED')
        chosen=valid[:q];wids=sorted(a['witness_id'] for a in chosen);amap={a['witness_id']:a for a in chosen};ahs=[amap[x]['attestation_sha256'] for x in wids];proof=_v199_finality_payload(cp,fed,q,wids,ahs);ph=_v199_hash(proof);key,pub,keyid=_v169_load_signer();sig=base64.b64encode(key.sign(_v199_json(proof).encode())).decode();fid='gff_'+uuid.uuid4().hex[:16];t=now();op=str(u.get('email') or u.get('id') or 'operator')
        c.execute('INSERT INTO production_global_finality_checkpoint_federation_finality(id,checkpoint_id,checkpoint_sha256,federation_id,federation_sha256,quorum_required,witness_count,witness_ids_json,attestation_hashes_json,proof_json,proof_sha256,algorithm,signer_key_id,public_key_b64,signature_b64,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(fid,cp['id'],cp['checkpoint_sha256'],fed['id'],fed['federation_sha256'],q,len(chosen),_v199_json(wids),_v199_json(ahs),_v199_json(proof),ph,'Ed25519',keyid,base64.b64encode(pub).decode(),sig,'FINALIZED',t,op));c.commit();row=c.execute('SELECT * FROM production_global_finality_checkpoint_federation_finality WHERE id=?',(fid,)).fetchone();return {'schema_version':'1.99','idempotent':False,'finality':dict(row),'verification':_v199_verify_finality(c,row)}
@app.get('/api/v199/ops/global-finality-checkpoint-federation/verify')
def v199_verify(authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        rows=c.execute('SELECT * FROM production_global_finality_checkpoint_federation_finality ORDER BY created_at,id').fetchall()
        for i,row in enumerate(rows,1):
            vr=_v199_verify_finality(c,row)
            if not vr['valid']:return {'schema_version':'1.99','valid':False,'reason':vr['reason'],'checked_finalities':i}
        return {'schema_version':'1.99','valid':True,'reason':'FEDERATED_GLOBAL_CHECKPOINT_FINALITY_VERIFIED','finalities':len(rows)}
@app.post('/api/v199/ops/global-finality-checkpoint-federation/recover')
def v199_recover(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin'});p=payload or {}
    with core_db_connect() as c:
        fin=c.execute('SELECT * FROM production_global_finality_checkpoint_federation_finality WHERE id=?',(p.get('finality_id'),)).fetchone() if p.get('finality_id') else c.execute('SELECT * FROM production_global_finality_checkpoint_federation_finality ORDER BY created_at DESC LIMIT 1').fetchone()
        if not fin:raise HTTPException(404,'V199_FINALITY_NOT_FOUND')
        fv=_v199_verify_finality(c,fin)
        if not fv['valid']:raise HTTPException(409,'V199_FINALITY_NOT_VERIFIABLE')
        cp=c.execute('SELECT * FROM production_global_finality_checkpoints WHERE id=?',(fin['checkpoint_id'],)).fetchone()
        existing=c.execute('SELECT * FROM production_global_finality_checkpoint_recovery_quorum WHERE checkpoint_id=? AND federation_finality_id=?',(cp['id'],fin['id'])).fetchone()
        if existing:return {'schema_version':'1.99','idempotent':True,'recovery':dict(existing),'verification':fv}
        obj=_v199_recovery_payload(cp,fin);dh=_v199_hash(obj);key,pub,keyid=_v169_load_signer();sig=base64.b64encode(key.sign(_v199_json(obj).encode())).decode();rid='gqr_'+uuid.uuid4().hex[:16];t=now();op=str(u.get('email') or u.get('id') or 'operator')
        c.execute('INSERT INTO production_global_finality_checkpoint_recovery_quorum(id,checkpoint_id,checkpoint_sha256,federation_finality_id,federation_id,restore_sequence_no,restore_entry_sha256,recovery_mode,decision_json,decision_sha256,algorithm,signer_key_id,public_key_b64,signature_b64,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(rid,cp['id'],cp['checkpoint_sha256'],fin['id'],fin['federation_id'],int(cp['chain_sequence_no']),cp['chain_head_entry_sha256'],'READ_ONLY_RECONSTRUCTION',_v199_json(obj),dh,'Ed25519',keyid,base64.b64encode(pub).decode(),sig,'QUORUM_AUTHORIZED_RECONSTRUCTION',t,op));c.commit();row=c.execute('SELECT * FROM production_global_finality_checkpoint_recovery_quorum WHERE id=?',(rid,)).fetchone();return {'schema_version':'1.99','idempotent':False,'recovery':dict(row),'verification':fv}

# ---------------- WUNOO v1.98: Global Finality Checkpoints & Historical Recovery ----------------
def migrate_v198(c):
    c.executescript("""CREATE TABLE IF NOT EXISTS production_global_finality_checkpoints(
        id TEXT PRIMARY KEY, checkpoint_no INTEGER NOT NULL UNIQUE, chain_sequence_no INTEGER NOT NULL,
        chain_head_entry_sha256 TEXT NOT NULL, entry_count INTEGER NOT NULL,
        prefix_manifest_json TEXT NOT NULL, checkpoint_json TEXT NOT NULL,
        checkpoint_sha256 TEXT NOT NULL UNIQUE, algorithm TEXT NOT NULL,
        signer_key_id TEXT NOT NULL, public_key_b64 TEXT NOT NULL, signature_b64 TEXT NOT NULL,
        status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT
    );
    CREATE INDEX IF NOT EXISTS idx_v198_checkpoint_seq ON production_global_finality_checkpoints(chain_sequence_no);
    CREATE TABLE IF NOT EXISTS production_global_finality_checkpoint_recovery(
        id TEXT PRIMARY KEY, checkpoint_id TEXT NOT NULL, restore_sequence_no INTEGER NOT NULL,
        restore_entry_sha256 TEXT NOT NULL, recovery_mode TEXT NOT NULL,
        reason TEXT NOT NULL, plan_json TEXT NOT NULL, plan_sha256 TEXT NOT NULL UNIQUE,
        algorithm TEXT NOT NULL, signer_key_id TEXT NOT NULL, public_key_b64 TEXT NOT NULL,
        signature_b64 TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT
    );
    CREATE INDEX IF NOT EXISTS idx_v198_recovery_checkpoint ON production_global_finality_checkpoint_recovery(checkpoint_id);
    """)

_V198_POLICY={
    'schema_version':'1.98',
    'format':'wunoo.release.global.finality.checkpoint.v1',
    'recovery_format':'wunoo.release.global.finality.checkpoint.recovery.v1',
    'hash':'SHA-256','algorithm':'Ed25519','genesis_hash':'0'*64,
    'checkpoint_scope':'GLOBAL_FINALITY_CHAIN_PREFIX',
    'historical_verification_independent_of_current_head':True,
    'prefix_manifest_required':True,
    'requires_verified_v197_chain_prefix':True,
    'destructive_restore':False,'automatic_restore':False,
    'immutable_history':True,'fail_closed':True,'no_automatic_release':True
}
def _v198_hash(v): return hashlib.sha256(json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()).hexdigest()
def _v198_json(v): return json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False)
def _v198_checkpoint_payload(seq,head,manifest):
    return {'format':_V198_POLICY['format'],'schema_version':'1.98','checkpoint_no':None,
            'chain_sequence_no':int(seq),'chain_head_entry_sha256':head,'entry_count':len(manifest),
            'prefix_manifest':manifest}
def _v198_manifest(c,seq):
    rows=c.execute('SELECT sequence_no,entry_sha256,finality_id,anchor_id FROM production_global_finality_chain WHERE sequence_no<=? ORDER BY sequence_no ASC',(seq,)).fetchall()
    manifest=[{'sequence_no':int(r['sequence_no']),'entry_sha256':r['entry_sha256'],'finality_id':r['finality_id'],'anchor_id':r['anchor_id']} for r in rows]
    return manifest

def _v198_verify_checkpoint(c,row):
    try:
        obj=json.loads(row['checkpoint_json'] or '{}');manifest=json.loads(row['prefix_manifest_json'] or '[]')
        if obj.get('format')!=_V198_POLICY['format'] or obj.get('schema_version')!='1.98':return {'valid':False,'reason':'GLOBAL_CHECKPOINT_FORMAT_INVALID'}
        if int(obj.get('checkpoint_no',-1))!=int(row['checkpoint_no']):return {'valid':False,'reason':'GLOBAL_CHECKPOINT_NUMBER_INVALID'}
        if int(obj.get('chain_sequence_no',-1))!=int(row['chain_sequence_no']) or int(obj.get('entry_count',-1))!=int(row['entry_count']):return {'valid':False,'reason':'GLOBAL_CHECKPOINT_METADATA_INVALID'}
        if manifest!=json.loads(row['prefix_manifest_json'] or '[]'):return {'valid':False,'reason':'GLOBAL_CHECKPOINT_MANIFEST_ENCODING_INVALID'}
        if len(manifest)!=int(row['entry_count']):return {'valid':False,'reason':'GLOBAL_CHECKPOINT_ENTRY_COUNT_INVALID'}
        expected=1;prev=_V198_POLICY['genesis_hash']
        for item in manifest:
            if int(item['sequence_no'])!=expected:return {'valid':False,'reason':'GLOBAL_CHECKPOINT_MANIFEST_SEQUENCE_INVALID','checked_entries':expected-1}
            if not item.get('entry_sha256') or len(item['entry_sha256'])!=64:return {'valid':False,'reason':'GLOBAL_CHECKPOINT_MANIFEST_HASH_INVALID'}
            expected+=1
        if int(row['chain_sequence_no'])!=len(manifest):return {'valid':False,'reason':'GLOBAL_CHECKPOINT_PREFIX_LENGTH_INVALID'}
        head=manifest[-1]['entry_sha256'] if manifest else _V198_POLICY['genesis_hash']
        if row['chain_head_entry_sha256']!=head or obj.get('chain_head_entry_sha256')!=head:return {'valid':False,'reason':'GLOBAL_CHECKPOINT_HEAD_INVALID'}
        if _v198_hash(obj)!=row['checkpoint_sha256']:return {'valid':False,'reason':'GLOBAL_CHECKPOINT_HASH_INVALID'}
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto();Ed25519PublicKey.from_public_bytes(base64.b64decode(row['public_key_b64'],validate=True)).verify(base64.b64decode(row['signature_b64'],validate=True),_v198_json(obj).encode())
        # Verify the historical prefix against the stored manifest. Later chain entries are irrelevant.
        current=c.execute('SELECT * FROM production_global_finality_chain WHERE sequence_no<=? ORDER BY sequence_no ASC',(int(row['chain_sequence_no']),)).fetchall()
        if len(current)!=len(manifest):return {'valid':False,'reason':'CURRENT_CHAIN_DIVERGED','checked_entries':min(len(current),len(manifest))}
        for cur,item in zip(current,manifest):
            if int(cur['sequence_no'])!=int(item['sequence_no']) or cur['entry_sha256']!=item['entry_sha256'] or cur['finality_id']!=item['finality_id'] or cur['anchor_id']!=item['anchor_id']:
                return {'valid':False,'reason':'CURRENT_CHAIN_DIVERGED','sequence_no':int(item['sequence_no'])}
            vr=_v197_verify_entry(c,cur)
            if not vr['valid']:return {'valid':False,'reason':'CURRENT_CHAIN_PREFIX_INVALID','sequence_no':int(item['sequence_no']),'detail':vr.get('reason')}
        return {'valid':True,'checkpoint_no':int(row['checkpoint_no']),'chain_sequence_no':int(row['chain_sequence_no']),'chain_head_entry_sha256':head,'entries':len(manifest),'historical_prefix_intact':True}
    except Exception:return {'valid':False,'reason':'GLOBAL_CHECKPOINT_INVALID'}

def _v198_historical_manifest_valid(row):
    try:
        m=json.loads(row['prefix_manifest_json'] or '[]');return isinstance(m,list) and len(m)==int(row['entry_count']) and (m[-1]['entry_sha256'] if m else _V198_POLICY['genesis_hash'])==row['chain_head_entry_sha256']
    except Exception:return False

def _v198_recovery_payload(row,reason):
    return {'format':_V198_POLICY['recovery_format'],'schema_version':'1.98','checkpoint_id':row['id'],
            'checkpoint_no':int(row['checkpoint_no']),'restore_sequence_no':int(row['chain_sequence_no']),
            'restore_entry_sha256':row['chain_head_entry_sha256'],'recovery_mode':'READ_ONLY_RECONSTRUCTION',
            'reason':reason,'no_chain_mutation':True}

@app.get('/api/v198/ops/global-finality-checkpoints/policy')
def v198_policy(authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'});return _V198_POLICY
@app.post('/api/v198/ops/global-finality-checkpoints/issue')
def v198_issue(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin'});p=payload or {};operator=str(u.get('email') or u.get('id') or 'operator')
    with core_db_connect() as c:
        vr=_v197_verify_chain(c)
        if not vr['valid']:raise HTTPException(409,'GLOBAL_FINALITY_CHAIN_NOT_VERIFIABLE')
        requested=int(p.get('chain_sequence_no') or vr['entries'])
        if requested<0 or requested>vr['entries']:raise HTTPException(409,'GLOBAL_CHECKPOINT_SEQUENCE_INVALID')
        existing=c.execute('SELECT * FROM production_global_finality_checkpoints WHERE chain_sequence_no=? ORDER BY checkpoint_no DESC LIMIT 1',(requested,)).fetchone()
        if existing:
            ev=_v198_verify_checkpoint(c,existing)
            if ev['valid']:return {'schema_version':'1.98','idempotent':True,'checkpoint':dict(existing),'verification':ev}
        manifest=_v198_manifest(c,requested);head=manifest[-1]['entry_sha256'] if manifest else _V198_POLICY['genesis_hash'];no=int(c.execute('SELECT COALESCE(MAX(checkpoint_no),0)+1 n FROM production_global_finality_checkpoints').fetchone()['n'])
        obj=_v198_checkpoint_payload(requested,head,manifest);obj['checkpoint_no']=no;ch=_v198_hash(obj);key,pub,keyid=_v169_load_signer();sig=base64.b64encode(key.sign(_v198_json(obj).encode())).decode();cid='gcp_'+uuid.uuid4().hex[:16];t=now()
        c.execute('INSERT INTO production_global_finality_checkpoints(id,checkpoint_no,chain_sequence_no,chain_head_entry_sha256,entry_count,prefix_manifest_json,checkpoint_json,checkpoint_sha256,algorithm,signer_key_id,public_key_b64,signature_b64,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(cid,no,requested,head,len(manifest),_v198_json(manifest),_v198_json(obj),ch,'Ed25519',keyid,base64.b64encode(pub).decode(),sig,'CHECKPOINTED',t,operator));c.commit();row=c.execute('SELECT * FROM production_global_finality_checkpoints WHERE id=?',(cid,)).fetchone();return {'schema_version':'1.98','idempotent':False,'checkpoint':dict(row),'verification':_v198_verify_checkpoint(c,row)}
@app.get('/api/v198/ops/global-finality-checkpoints/verify')
def v198_verify(authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        rows=c.execute('SELECT * FROM production_global_finality_checkpoints ORDER BY checkpoint_no ASC').fetchall()
        for i,row in enumerate(rows,1):
            vr=_v198_verify_checkpoint(c,row)
            if not vr['valid']:return {'schema_version':'1.98','valid':False,'reason':vr['reason'],'checkpoint_no':int(row['checkpoint_no']),'checked_checkpoints':i}
        return {'schema_version':'1.98','valid':True,'reason':'GLOBAL_FINALITY_CHECKPOINTS_VERIFIED','checkpoints':len(rows)}
@app.get('/api/v198/ops/global-finality-checkpoints/latest')
def v198_latest(authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        row=c.execute('SELECT * FROM production_global_finality_checkpoints ORDER BY checkpoint_no DESC LIMIT 1').fetchone();return {'schema_version':'1.98','checkpoint':dict(row) if row else None,'verification':_v198_verify_checkpoint(c,row) if row else {'valid':True,'reason':'NO_CHECKPOINTS'}}
@app.post('/api/v198/ops/global-finality-checkpoints/recover')
def v198_recover(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin'});p=payload or {};operator=str(u.get('email') or u.get('id') or 'operator');reason=str(p.get('reason') or 'Historical checkpoint reconstruction requested')
    with core_db_connect() as c:
        row=c.execute('SELECT * FROM production_global_finality_checkpoints WHERE id=?',(p.get('checkpoint_id'),)).fetchone() if p.get('checkpoint_id') else c.execute('SELECT * FROM production_global_finality_checkpoints ORDER BY checkpoint_no DESC LIMIT 1').fetchone()
        if not row:raise HTTPException(404,'GLOBAL_CHECKPOINT_NOT_FOUND')
        if not _v198_historical_manifest_valid(row):raise HTTPException(409,'GLOBAL_CHECKPOINT_MANIFEST_INVALID')
        existing=c.execute('SELECT * FROM production_global_finality_checkpoint_recovery WHERE checkpoint_id=? ORDER BY created_at DESC LIMIT 1',(row['id'],)).fetchone()
        if existing:return {'schema_version':'1.98','idempotent':True,'recovery':dict(existing),'checkpoint':dict(row)}
        plan=_v198_recovery_payload(row,reason);ph=_v198_hash(plan);key,pub,keyid=_v169_load_signer();sig=base64.b64encode(key.sign(_v198_json(plan).encode())).decode();rid='gcr_'+uuid.uuid4().hex[:16];t=now()
        c.execute('INSERT INTO production_global_finality_checkpoint_recovery(id,checkpoint_id,restore_sequence_no,restore_entry_sha256,recovery_mode,reason,plan_json,plan_sha256,algorithm,signer_key_id,public_key_b64,signature_b64,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(rid,row['id'],int(row['chain_sequence_no']),row['chain_head_entry_sha256'],'READ_ONLY_RECONSTRUCTION',reason,_v198_json(plan),ph,'Ed25519',keyid,base64.b64encode(pub).decode(),sig,'READY_FOR_RECONSTRUCTION',t,operator));c.commit();rr=c.execute('SELECT * FROM production_global_finality_checkpoint_recovery WHERE id=?',(rid,)).fetchone();return {'schema_version':'1.98','idempotent':False,'recovery':dict(rr),'checkpoint':dict(row),'verification':_v198_verify_checkpoint(c,row)}


# ---------------- WUNOO v1.100: Global Recovery Consensus & Cross-Federation Recovery Finality ----------------
def migrate_v100(c):
    c.executescript("""CREATE TABLE IF NOT EXISTS production_global_recovery_consensus(
        id TEXT PRIMARY KEY, checkpoint_id TEXT NOT NULL, checkpoint_sha256 TEXT NOT NULL,
        required_federation_quorum INTEGER NOT NULL, federation_count INTEGER NOT NULL,
        federation_ids_json TEXT NOT NULL, federation_finality_ids_json TEXT NOT NULL,
        proof_json TEXT NOT NULL, proof_sha256 TEXT NOT NULL UNIQUE,
        algorithm TEXT NOT NULL, signer_key_id TEXT NOT NULL, public_key_b64 TEXT NOT NULL,
        signature_b64 TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT,
        UNIQUE(checkpoint_id)
    );
    CREATE INDEX IF NOT EXISTS idx_v100_recovery_consensus_checkpoint
      ON production_global_recovery_consensus(checkpoint_id,created_at);
    CREATE TABLE IF NOT EXISTS production_global_recovery_consensus_decisions(
        id TEXT PRIMARY KEY, consensus_id TEXT NOT NULL, checkpoint_id TEXT NOT NULL,
        checkpoint_sha256 TEXT NOT NULL, restore_sequence_no INTEGER NOT NULL,
        restore_entry_sha256 TEXT NOT NULL, recovery_mode TEXT NOT NULL,
        decision_json TEXT NOT NULL, decision_sha256 TEXT NOT NULL UNIQUE,
        algorithm TEXT NOT NULL, signer_key_id TEXT NOT NULL, public_key_b64 TEXT NOT NULL,
        signature_b64 TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT,
        UNIQUE(consensus_id)
    );
    CREATE INDEX IF NOT EXISTS idx_v100_recovery_decisions_checkpoint
      ON production_global_recovery_consensus_decisions(checkpoint_id,created_at);
    """)

_V100_POLICY={
    'schema_version':'1.100',
    'consensus_format':'wunoo.release.global.recovery.cross.federation.consensus.v1',
    'decision_format':'wunoo.release.global.recovery.cross.federation.decision.v1',
    'hash':'SHA-256','algorithm':'Ed25519',
    'default_federation_quorum':'floor(2N/3)+1; N<3 => N',
    'distinct_federations_required':True,
    'federation_finality_required':True,
    'checkpoint_must_verify':True,
    'cross_federation_consensus_required':True,
    'destructive_restore':False,'automatic_restore':False,
    'no_chain_mutation':True,'immutable_history':True,
    'fail_closed':True,'no_automatic_release':True
}
def _v100_hash(v): return hashlib.sha256(json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()).hexdigest()
def _v100_json(v): return json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False)
def _v100_quorum(n):
    n=int(n)
    if n<1:return 0
    return n if n<3 else (2*n)//3+1
def _v100_consensus_payload(cp,q,fids,ffids):
    return {'format':_V100_POLICY['consensus_format'],'schema_version':'1.100','checkpoint_id':cp['id'],
            'checkpoint_sha256':cp['checkpoint_sha256'],'required_federation_quorum':q,
            'federation_ids':sorted(fids),'federation_finality_ids':sorted(ffids),
            'restore_sequence_no':int(cp['chain_sequence_no']),'restore_entry_sha256':cp['chain_head_entry_sha256'],
            'recovery_mode':'CROSS_FEDERATION_READ_ONLY_RECONSTRUCTION'}
def _v100_verify_consensus(c,row):
    try:
        cp=c.execute('SELECT * FROM production_global_finality_checkpoints WHERE id=?',(row['checkpoint_id'],)).fetchone()
        if not cp:return {'valid':False,'reason':'V100_CHECKPOINT_NOT_FOUND'}
        cv=_v198_verify_checkpoint(c,cp)
        if not cv['valid']:return {'valid':False,'reason':'V100_CHECKPOINT_NOT_VERIFIABLE','detail':cv.get('reason')}
        if row['checkpoint_sha256']!=cp['checkpoint_sha256']:return {'valid':False,'reason':'V100_CHECKPOINT_BINDING_INVALID'}
        fids=json.loads(row['federation_ids_json'] or '[]'); ffids=json.loads(row['federation_finality_ids_json'] or '[]')
        if not isinstance(fids,list) or not isinstance(ffids,list) or len(fids)!=len(ffids) or len(fids)!=int(row['federation_count']) or len(set(fids))!=len(fids) or len(set(ffids))!=len(ffids):
            return {'valid':False,'reason':'V100_FEDERATION_SET_INVALID'}
        q=_v100_quorum(len(fids))
        if int(row['required_federation_quorum'])!=q or len(fids)<q:return {'valid':False,'reason':'V100_FEDERATION_QUORUM_INVALID'}
        pairs=[]
        for fid,ffid in zip(fids,ffids):
            fed=c.execute('SELECT * FROM production_global_checkpoint_federations WHERE id=?',(fid,)).fetchone()
            fin=c.execute('SELECT * FROM production_global_finality_checkpoint_federation_finality WHERE id=?',(ffid,)).fetchone()
            if not fed or not fin:return {'valid':False,'reason':'V100_FEDERATION_FINALITY_NOT_FOUND'}
            if fin['federation_id']!=fid or fin['checkpoint_id']!=cp['id']:return {'valid':False,'reason':'V100_FEDERATION_FINALITY_BINDING_INVALID'}
            fv=_v199_verify_finality(c,fin)
            if not fv['valid']:return {'valid':False,'reason':'V100_FEDERATION_FINALITY_NOT_VERIFIABLE','detail':fv.get('reason')}
            pairs.append((fid,ffid))
        obj=json.loads(row['proof_json'] or '{}');expected=_v100_consensus_payload(cp,q,fids,ffids)
        if obj!=expected:return {'valid':False,'reason':'V100_CONSENSUS_PROOF_INVALID'}
        if _v100_hash(obj)!=row['proof_sha256']:return {'valid':False,'reason':'V100_CONSENSUS_HASH_INVALID'}
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto();Ed25519PublicKey.from_public_bytes(base64.b64decode(row['public_key_b64'],validate=True)).verify(base64.b64decode(row['signature_b64'],validate=True),_v100_json(obj).encode())
        return {'valid':True,'checkpoint_id':cp['id'],'federations':len(fids),'required_quorum':q,'restore_sequence_no':int(cp['chain_sequence_no']),'restore_entry_sha256':cp['chain_head_entry_sha256']}
    except Exception:return {'valid':False,'reason':'V100_CONSENSUS_INVALID'}
def _v100_decision_payload(cons,cp):
    return {'format':_V100_POLICY['decision_format'],'schema_version':'1.100','consensus_id':cons['id'],
            'checkpoint_id':cp['id'],'checkpoint_sha256':cp['checkpoint_sha256'],
            'restore_sequence_no':int(cp['chain_sequence_no']),'restore_entry_sha256':cp['chain_head_entry_sha256'],
            'recovery_mode':'CROSS_FEDERATION_READ_ONLY_RECONSTRUCTION','no_chain_mutation':True}
def _v100_verify_decision(c,row):
    try:
        cons=c.execute('SELECT * FROM production_global_recovery_consensus WHERE id=?',(row['consensus_id'],)).fetchone()
        if not cons:return {'valid':False,'reason':'V100_CONSENSUS_NOT_FOUND'}
        cv=_v100_verify_consensus(c,cons)
        if not cv['valid']:return {'valid':False,'reason':'V100_CONSENSUS_NOT_VERIFIABLE','detail':cv.get('reason')}
        cp=c.execute('SELECT * FROM production_global_finality_checkpoints WHERE id=?',(row['checkpoint_id'],)).fetchone()
        obj=json.loads(row['decision_json'] or '{}');expected=_v100_decision_payload(cons,cp)
        if obj!=expected:return {'valid':False,'reason':'V100_DECISION_PAYLOAD_INVALID'}
        if row['checkpoint_sha256']!=cp['checkpoint_sha256'] or int(row['restore_sequence_no'])!=int(cp['chain_sequence_no']) or row['restore_entry_sha256']!=cp['chain_head_entry_sha256']:return {'valid':False,'reason':'V100_DECISION_BINDING_INVALID'}
        if row['recovery_mode']!='CROSS_FEDERATION_READ_ONLY_RECONSTRUCTION' or obj.get('no_chain_mutation') is not True:return {'valid':False,'reason':'V100_DESTRUCTIVE_RECOVERY_FORBIDDEN'}
        if _v100_hash(obj)!=row['decision_sha256']:return {'valid':False,'reason':'V100_DECISION_HASH_INVALID'}
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto();Ed25519PublicKey.from_public_bytes(base64.b64decode(row['public_key_b64'],validate=True)).verify(base64.b64decode(row['signature_b64'],validate=True),_v100_json(obj).encode())
        return {'valid':True,'consensus_id':cons['id'],'checkpoint_id':cp['id'],'no_chain_mutation':True}
    except Exception:return {'valid':False,'reason':'V100_DECISION_INVALID'}

@app.get('/api/v100/ops/global-recovery-consensus/policy')
def v100_policy(authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'});return _V100_POLICY
@app.post('/api/v100/ops/global-recovery-consensus/finalize')
def v100_finalize(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin'});p=payload or {}
    with core_db_connect() as c:
        cp=c.execute('SELECT * FROM production_global_finality_checkpoints WHERE id=?',(p.get('checkpoint_id'),)).fetchone() if p.get('checkpoint_id') else c.execute('SELECT * FROM production_global_finality_checkpoints ORDER BY checkpoint_no DESC LIMIT 1').fetchone()
        if not cp:raise HTTPException(404,'GLOBAL_CHECKPOINT_NOT_FOUND')
        cv=_v198_verify_checkpoint(c,cp)
        if not cv['valid']:raise HTTPException(409,'GLOBAL_CHECKPOINT_NOT_VERIFIABLE')
        existing=c.execute('SELECT * FROM production_global_recovery_consensus WHERE checkpoint_id=?',(cp['id'],)).fetchone()
        if existing:return {'schema_version':'1.100','idempotent':True,'consensus':dict(existing),'verification':_v100_verify_consensus(c,existing)}
        frows=c.execute('SELECT * FROM production_global_checkpoint_federations ORDER BY federation_no ASC').fetchall();valid=[]
        for fed in frows:
            if not _v184_verify_federation(c,fed)['valid']:continue
            fin=c.execute('SELECT * FROM production_global_finality_checkpoint_federation_finality WHERE checkpoint_id=? AND federation_id=?',(cp['id'],fed['id'])).fetchone()
            if fin and _v199_verify_finality(c,fin)['valid']:valid.append((fed,fin))
        q=_v100_quorum(len(frows))
        # Consensus quorum is over configured federations, not merely available federations.
        if len(valid)<q:raise HTTPException(409,'V100_CROSS_FEDERATION_QUORUM_NOT_REACHED')
        chosen=valid[:q];fids=sorted(x[0]['id'] for x in chosen);fmap={x[0]['id']:x[1]['id'] for x in chosen};ffids=[fmap[x] for x in fids]
        obj=_v100_consensus_payload(cp,q,fids,ffids);ph=_v100_hash(obj);key,pub,keyid=_v169_load_signer();sig=base64.b64encode(key.sign(_v100_json(obj).encode())).decode();cid='grc_'+uuid.uuid4().hex[:16];t=now();op=str(u.get('email') or u.get('id') or 'operator')
        c.execute('INSERT INTO production_global_recovery_consensus(id,checkpoint_id,checkpoint_sha256,required_federation_quorum,federation_count,federation_ids_json,federation_finality_ids_json,proof_json,proof_sha256,algorithm,signer_key_id,public_key_b64,signature_b64,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(cid,cp['id'],cp['checkpoint_sha256'],q,len(chosen),_v100_json(fids),_v100_json(ffids),_v100_json(obj),ph,'Ed25519',keyid,base64.b64encode(pub).decode(),sig,'FINALIZED',t,op));c.commit();row=c.execute('SELECT * FROM production_global_recovery_consensus WHERE id=?',(cid,)).fetchone();return {'schema_version':'1.100','idempotent':False,'consensus':dict(row),'verification':_v100_verify_consensus(c,row)}
@app.get('/api/v100/ops/global-recovery-consensus/verify')
def v100_verify(authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        rows=c.execute('SELECT * FROM production_global_recovery_consensus ORDER BY created_at,id').fetchall()
        for i,row in enumerate(rows,1):
            vr=_v100_verify_consensus(c,row)
            if not vr['valid']:return {'schema_version':'1.100','valid':False,'reason':vr['reason'],'checked_consensus':i}
        return {'schema_version':'1.100','valid':True,'reason':'GLOBAL_CROSS_FEDERATION_RECOVERY_CONSENSUS_VERIFIED','consensus_records':len(rows)}
@app.post('/api/v100/ops/global-recovery-consensus/recover')
def v100_recover(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin'});p=payload or {}
    with core_db_connect() as c:
        cons=c.execute('SELECT * FROM production_global_recovery_consensus WHERE id=?',(p.get('consensus_id'),)).fetchone() if p.get('consensus_id') else c.execute('SELECT * FROM production_global_recovery_consensus ORDER BY created_at DESC LIMIT 1').fetchone()
        if not cons:raise HTTPException(404,'V100_CONSENSUS_NOT_FOUND')
        cv=_v100_verify_consensus(c,cons)
        if not cv['valid']:raise HTTPException(409,'V100_CONSENSUS_NOT_VERIFIABLE')
        cp=c.execute('SELECT * FROM production_global_finality_checkpoints WHERE id=?',(cons['checkpoint_id'],)).fetchone()
        existing=c.execute('SELECT * FROM production_global_recovery_consensus_decisions WHERE consensus_id=?',(cons['id'],)).fetchone()
        if existing:return {'schema_version':'1.100','idempotent':True,'decision':dict(existing),'verification':_v100_verify_decision(c,existing)}
        obj=_v100_decision_payload(cons,cp);dh=_v100_hash(obj);key,pub,keyid=_v169_load_signer();sig=base64.b64encode(key.sign(_v100_json(obj).encode())).decode();rid='grd_'+uuid.uuid4().hex[:16];t=now();op=str(u.get('email') or u.get('id') or 'operator')
        c.execute('INSERT INTO production_global_recovery_consensus_decisions(id,consensus_id,checkpoint_id,checkpoint_sha256,restore_sequence_no,restore_entry_sha256,recovery_mode,decision_json,decision_sha256,algorithm,signer_key_id,public_key_b64,signature_b64,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(rid,cons['id'],cp['id'],cp['checkpoint_sha256'],int(cp['chain_sequence_no']),cp['chain_head_entry_sha256'],'CROSS_FEDERATION_READ_ONLY_RECONSTRUCTION',_v100_json(obj),dh,'Ed25519',keyid,base64.b64encode(pub).decode(),sig,'CROSS_FEDERATION_QUORUM_AUTHORIZED_RECONSTRUCTION',t,op));c.commit();row=c.execute('SELECT * FROM production_global_recovery_consensus_decisions WHERE id=?',(rid,)).fetchone();return {'schema_version':'1.100','idempotent':False,'decision':dict(row),'verification':_v100_verify_decision(c,row)}


# ---------------- WUNOO v1.101: Global Recovery Consensus Chain ----------------
def migrate_v101(c):
    c.executescript("""CREATE TABLE IF NOT EXISTS production_global_recovery_consensus_chain(
        id TEXT PRIMARY KEY, sequence_no INTEGER NOT NULL UNIQUE, consensus_id TEXT NOT NULL UNIQUE,
        checkpoint_id TEXT NOT NULL, checkpoint_sha256 TEXT NOT NULL, decision_id TEXT NOT NULL UNIQUE,
        decision_sha256 TEXT NOT NULL, previous_entry_sha256 TEXT NOT NULL,
        entry_json TEXT NOT NULL, entry_sha256 TEXT NOT NULL UNIQUE,
        algorithm TEXT NOT NULL, signer_key_id TEXT NOT NULL, public_key_b64 TEXT NOT NULL,
        signature_b64 TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT
    );
    CREATE INDEX IF NOT EXISTS idx_v101_recovery_chain_checkpoint
      ON production_global_recovery_consensus_chain(checkpoint_id,sequence_no);
    CREATE INDEX IF NOT EXISTS idx_v101_recovery_chain_consensus
      ON production_global_recovery_consensus_chain(consensus_id);
    """)

_V101_POLICY={
    'schema_version':'1.101',
    'format':'wunoo.release.global.recovery.consensus.continuity.entry.v1',
    'hash':'SHA-256','algorithm':'Ed25519','genesis_hash':'0'*64,
    'requires_verified_v100_consensus':True,
    'requires_verified_v100_recovery_decision':True,
    'strict_sequence':True,'previous_entry_required':True,
    'immutable_history':True,'append_only':True,
    'automatic_append':False,'destructive_restore':False,
    'no_chain_mutation':True,'fail_closed':True,'no_automatic_release':True
}
def _v101_hash(v): return hashlib.sha256(json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()).hexdigest()
def _v101_json(v): return json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False)
def _v101_payload(cons,dec,seq,prev):
    return {'format':_V101_POLICY['format'],'schema_version':'1.101','sequence_no':int(seq),
            'consensus_id':cons['id'],'checkpoint_id':cons['checkpoint_id'],
            'checkpoint_sha256':cons['checkpoint_sha256'],'decision_id':dec['id'],
            'decision_sha256':dec['decision_sha256'],'previous_entry_sha256':prev,
            'recovery_mode':'CROSS_FEDERATION_READ_ONLY_RECONSTRUCTION',
            'no_chain_mutation':True}
def _v101_verify_entry(c,row):
    try:
        cons=c.execute('SELECT * FROM production_global_recovery_consensus WHERE id=?',(row['consensus_id'],)).fetchone()
        if not cons:return {'valid':False,'reason':'V101_CONSENSUS_NOT_FOUND'}
        cv=_v100_verify_consensus(c,cons)
        if not cv['valid']:return {'valid':False,'reason':'V101_CONSENSUS_NOT_VERIFIABLE','detail':cv.get('reason')}
        dec=c.execute('SELECT * FROM production_global_recovery_consensus_decisions WHERE id=?',(row['decision_id'],)).fetchone()
        if not dec:return {'valid':False,'reason':'V101_DECISION_NOT_FOUND'}
        dv=_v100_verify_decision(c,dec)
        if not dv['valid']:return {'valid':False,'reason':'V101_DECISION_NOT_VERIFIABLE','detail':dv.get('reason')}
        if dec['consensus_id']!=cons['id'] or dec['checkpoint_id']!=cons['checkpoint_id']:
            return {'valid':False,'reason':'V101_CONSENSUS_DECISION_BINDING_INVALID'}
        if row['checkpoint_id']!=cons['checkpoint_id'] or row['checkpoint_sha256']!=cons['checkpoint_sha256']:
            return {'valid':False,'reason':'V101_CHECKPOINT_BINDING_INVALID'}
        if row['decision_sha256']!=dec['decision_sha256']:
            return {'valid':False,'reason':'V101_DECISION_HASH_BINDING_INVALID'}
        obj=json.loads(row['entry_json'] or '{}')
        expected=_v101_payload(cons,dec,int(row['sequence_no']),row['previous_entry_sha256'])
        if obj!=expected:return {'valid':False,'reason':'V101_ENTRY_PAYLOAD_INVALID'}
        if int(obj.get('sequence_no',-1))!=int(row['sequence_no']):return {'valid':False,'reason':'V101_SEQUENCE_INVALID'}
        if _v101_hash(obj)!=row['entry_sha256']:return {'valid':False,'reason':'V101_ENTRY_HASH_INVALID'}
        if row['algorithm']!='Ed25519':return {'valid':False,'reason':'V101_ALGORITHM_INVALID'}
        raw=base64.b64decode(row['public_key_b64'],validate=True)
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto()
        Ed25519PublicKey.from_public_bytes(raw).verify(base64.b64decode(row['signature_b64'],validate=True),_v101_json(obj).encode())
        return {'valid':True,'sequence_no':int(row['sequence_no']),'consensus_id':cons['id'],'decision_id':dec['id'],'checkpoint_id':cons['checkpoint_id'],'previous_entry_sha256':row['previous_entry_sha256']}
    except Exception:return {'valid':False,'reason':'V101_ENTRY_INVALID'}
def _v101_verify_chain(c):
    try:
        rows=c.execute('SELECT * FROM production_global_recovery_consensus_chain ORDER BY sequence_no ASC').fetchall()
        prev=_V101_POLICY['genesis_hash'];expected_seq=1
        for row in rows:
            if int(row['sequence_no'])!=expected_seq:return {'valid':False,'reason':'V101_SEQUENCE_GAP','expected_sequence':expected_seq,'actual_sequence':int(row['sequence_no'])}
            if row['previous_entry_sha256']!=prev:return {'valid':False,'reason':'V101_PREVIOUS_HASH_MISMATCH','sequence_no':expected_seq}
            vr=_v101_verify_entry(c,row)
            if not vr['valid']:return {'valid':False,'reason':vr['reason'],'sequence_no':expected_seq,'detail':vr.get('detail')}
            prev=row['entry_sha256'];expected_seq+=1
        return {'valid':True,'entries':len(rows),'head_entry_sha256':prev,'next_sequence_no':expected_seq}
    except Exception:return {'valid':False,'reason':'V101_CHAIN_INVALID'}

