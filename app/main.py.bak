    with core_db_connect() as c:
        result=_v113_run(c); rows=c.execute('SELECT * FROM production_courier_claim_integrity_gates_v113 ORDER BY gate_no').fetchall(); hist=[_v113_verify(c,r) for r in rows]; return {'schema_version':'1.113','valid':result['valid'] and all(x['valid'] for x in hist),'current_result':result,'gates':len(rows),'history_verification':hist}
