            row = db.execute("SELECT COUNT(*) n FROM request_layer_cutover_v138").fetchone()
            audit = int(row["n"])
        except Exception:
            audit = 0
    return {"api_version":"1.38", "cutover":"order_lifecycle",
            "migrated_route_groups": 7, "audit_records": audit,
            "remaining_direct_conn_order_functions": len(remaining_order),
            "remaining_direct_conn_order_routes": remaining_order,
            "production_postgresql_gate":"blocked_until_remaining_request_surfaces_are_migrated"}


# ---------------- v1.39 Finance + Refund Request-Layer Cutover ----------------
def migrate_v139(c):
    """Record the finance/refund request-layer cutover and checkout quote locks."""
    # Existing v1.39 finance cutover audit.
    c.execute("""CREATE TABLE IF NOT EXISTS checkout_quotes(
        id TEXT PRIMARY KEY, customer_id TEXT NOT NULL, merchant_id TEXT NOT NULL,
        items_json TEXT NOT NULL, subtotal_czk REAL NOT NULL, delivery_fee_czk REAL NOT NULL,
        service_fee_czk REAL NOT NULL, discount_czk REAL NOT NULL DEFAULT 0, total_czk REAL NOT NULL,
        currency TEXT NOT NULL DEFAULT 'CZK', status TEXT NOT NULL DEFAULT 'quoted',
        expires_at TEXT NOT NULL, created_at TEXT NOT NULL
    )""")
    c.execute("""CREATE TABLE IF NOT EXISTS request_layer_cutover_v139(
        id TEXT PRIMARY KEY, route_group TEXT NOT NULL, route_count INTEGER NOT NULL,
        backend TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL,
        UNIQUE(route_group)
    )""")
    qcols={r[1] for r in c.execute("PRAGMA table_info(checkout_quotes)").fetchall()}
    for name,ddl in [
        ("menu_publication_no","ALTER TABLE checkout_quotes ADD COLUMN menu_publication_no INTEGER"),
        ("menu_snapshot_sha256","ALTER TABLE checkout_quotes ADD COLUMN menu_snapshot_sha256 TEXT"),
        ("quote_hash","ALTER TABLE checkout_quotes ADD COLUMN quote_hash TEXT"),
        ("locked_at","ALTER TABLE checkout_quotes ADD COLUMN locked_at TEXT"),
        ("address_id","ALTER TABLE checkout_quotes ADD COLUMN address_id TEXT"),
        ("pricing_version","ALTER TABLE checkout_quotes ADD COLUMN pricing_version TEXT"),
        ("confirmed_order_id","ALTER TABLE checkout_quotes ADD COLUMN confirmed_order_id TEXT"),
    ]:
        if name not in qcols: c.execute(ddl)
    c.execute("CREATE UNIQUE INDEX IF NOT EXISTS ux_checkout_quotes_hash ON checkout_quotes(quote_hash) WHERE quote_hash IS NOT NULL")
    c.execute("""CREATE TABLE IF NOT EXISTS checkout_quote_lock_audit(
        id TEXT PRIMARY KEY, quote_id TEXT NOT NULL, customer_id TEXT NOT NULL, merchant_id TEXT NOT NULL,
        action TEXT NOT NULL, publication_no INTEGER, snapshot_sha256 TEXT, quote_hash TEXT,
        result TEXT NOT NULL, details_json TEXT, created_at TEXT NOT NULL
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_quote_lock_audit_customer ON checkout_quote_lock_audit(customer_id,created_at DESC)")
    groups=[
        ("refund_core",3),
        ("settlement_v062",4),
        ("refund_v064",1),
        ("finance_v120",5),
    ]
    backend=configured_db_backend()
    for group,count in groups:
        if not c.execute("SELECT 1 AS n FROM request_layer_cutover_v139 WHERE route_group=?",(group,)).fetchone():
            c.execute("INSERT INTO request_layer_cutover_v139 VALUES (?,?,?,?,?,?)",
                      ("v139_"+group,group,count,backend,"completed",now()))
            try:
                c.execute("INSERT INTO request_layer_cutover_audit VALUES (?,?,?,?,?,?)",
                          ("v139_"+group,group,"completed",backend,"Finance/refund request layer cutover",now()))
            except Exception:
                pass
    c.commit()




def _v139_quote_hash(customer_id, merchant_id, address_id, publication_no, snapshot_sha256, items, pricing):
    payload={
        "customer_id":customer_id,"merchant_id":merchant_id,"address_id":address_id,
        "publication_no":int(publication_no),"snapshot_sha256":snapshot_sha256,
        "items":items,
        "pricing":{k:pricing[k] for k in ("subtotal_czk","service_fee_czk","delivery_fee_czk","pro_discount_czk","total_czk","pricing_version")}
    }
    raw=json.dumps(payload,ensure_ascii=False,separators=(",",":"),sort_keys=True)
    return hashlib.sha256(raw.encode()).hexdigest()


def _v139_live_and_cart(c, customer_id, address_id):
    rows=c.execute("""SELECT ci.id,ci.menu_item_id,ci.qty,ci.merchant_id,ci.menu_publication_no,ci.menu_snapshot_sha256,
                           ci.unit_price_snapshot_czk,ci.menu_item_name_snapshot
                    FROM cart_items ci WHERE ci.customer_id=? ORDER BY ci.id""",(customer_id,)).fetchall()
    if not rows: raise HTTPException(400,"Košík je prázdný")
    merchants={r['merchant_id'] for r in rows}
    if len(merchants)!=1: raise HTTPException(409,"Košík může obsahovat jen jednu restauraci")
    merchant_id=next(iter(merchants)); live=_v138_live_publication(c,merchant_id)
    if not live: raise HTTPException(409,"Restaurace zatím nemá publikované menu")
    snap=json.loads(live['snapshot_json']); live_items={str(x.get('id')):x for x in snap.get('items',[])}
    normalized=[]; issues=[]
    for r in rows:
        li=live_items.get(str(r['menu_item_id']))
        if not li: issues.append({'code':'ITEM_REMOVED','menu_item_id':r['menu_item_id']}); continue
        if str((li.get('availability') or {}).get('state','AVAILABLE'))=='SOLD_OUT': issues.append({'code':'ITEM_SOLD_OUT','menu_item_id':r['menu_item_id']})
        if r['menu_publication_no'] is None or int(r['menu_publication_no'])!=int(live['publication_no']) or r['menu_snapshot_sha256']!=live['snapshot_sha256']:
            issues.append({'code':'PUBLICATION_CHANGED','menu_item_id':r['menu_item_id']})
        unit=float(li.get('price_czk',0)); qty=int(r['qty'])
        normalized.append({'menu_item_id':r['menu_item_id'],'name':li.get('name'),'qty':qty,'unit_price_czk':unit,'line_total_czk':round(unit*qty,2),
                           'modifier_groups':li.get('modifier_groups',[])})
    if issues: raise HTTPException(409,{'code':'MENU_CHANGED_REQUOTE','message':'Menu se změnilo. Aktualizujte košík před checkoutem.','issues':issues})
    pricing=pricing_for_cart(c,customer_id,merchant_id,round(sum(x['line_total_czk'] for x in normalized),2),address_id)
    return merchant_id,live,normalized,pricing


@app.post('/api/v139/checkout/quote')
def v139_checkout_quote(body:dict[str,Any], authorization:str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,'customer')
    address_id=str(body.get('address_id') or '').strip()
    if not address_id: raise HTTPException(400,'address_id je povinné')
    with core_db_connect() as c:
        merchant_id,live,items,pricing=_v139_live_and_cart(c,u['customer_id'],address_id)
        qhash=_v139_quote_hash(u['customer_id'],merchant_id,address_id,live['publication_no'],live['snapshot_sha256'],items,pricing)
        existing=c.execute('SELECT * FROM checkout_quotes WHERE quote_hash=? AND customer_id=? AND status=\'quoted\'',(qhash,u['customer_id'])).fetchone()
        if existing:
            return {'schema_version':'1.139','quote_id':existing['id'],'idempotent_reuse':True,'merchant_id':merchant_id,'address_id':address_id,
                    'menu_publication_no':int(existing['menu_publication_no']),'menu_snapshot_sha256':existing['menu_snapshot_sha256'],
                    'quote_hash':existing['quote_hash'],'expires_at':existing['expires_at'],'items':items,**pricing}
        import datetime
        expires=(datetime.datetime.utcnow()+datetime.timedelta(minutes=10)).isoformat(timespec='seconds')
        qid='quote139_'+uuid.uuid4().hex[:12]
        c.execute("""INSERT INTO checkout_quotes\n            (id,customer_id,merchant_id,items_json,subtotal_czk,delivery_fee_czk,service_fee_czk,discount_czk,total_czk,currency,status,expires_at,created_at,menu_publication_no,menu_snapshot_sha256,quote_hash,locked_at,address_id,pricing_version)\n            VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)""",
            (qid,u['customer_id'],merchant_id,json.dumps(items,ensure_ascii=False),pricing['subtotal_czk'],pricing['delivery_fee_czk'],pricing['service_fee_czk'],pricing['pro_discount_czk'],pricing['total_czk'],'CZK','quoted',expires,now(),int(live['publication_no']),live['snapshot_sha256'],qhash,now(),address_id,pricing['pricing_version']))
        c.execute("INSERT INTO checkout_quote_lock_audit VALUES (?,?,?,?,?,?,?,?,?,?,?)",('qla_'+uuid.uuid4().hex[:12],qid,u['customer_id'],merchant_id,'QUOTE_LOCKED',int(live['publication_no']),live['snapshot_sha256'],qhash,'PASS',json.dumps({'total_czk':pricing['total_czk']},ensure_ascii=False),now()))
        c.commit()
        return {'schema_version':'1.139','quote_id':qid,'idempotent_reuse':False,'merchant_id':merchant_id,'address_id':address_id,
                'menu_publication_no':int(live['publication_no']),'menu_snapshot_sha256':live['snapshot_sha256'],'quote_hash':qhash,'expires_at':expires,'items':items,**pricing}


@app.post('/api/v139/checkout/confirm')
def v139_checkout_confirm(body:dict[str,Any], authorization:str|None=Header(default=None), idempotency_key:str|None=Header(default=None,alias='Idempotency-Key')):
    u=current_user(authorization); require_role(u,'customer')
    qid=str(body.get('quote_id') or '').strip()
    if not qid: raise HTTPException(400,'quote_id je povinné')
    with core_db_connect() as c:
        cached=_v052_guard(c,f'checkout-v139-confirm:{u["id"]}',idempotency_key,{'quote_id':qid})
        if cached is not None: return cached
        q=c.execute('SELECT * FROM checkout_quotes WHERE id=? AND customer_id=?',(qid,u['customer_id'])).fetchone()
        if not q: raise HTTPException(404,'Checkout quote nenalezen')
        if q['status']=='confirmed' and q['confirmed_order_id']:
            result={'schema_version':'1.139','order_id':q['confirmed_order_id'],'quote_id':qid,'status':'payment_pending','total_czk':q['total_czk'],'currency':'CZK','idempotent_reuse':True}
            return result
        if q['status']!='quoted' or q['expires_at']<now(): raise HTTPException(409,{'code':'QUOTE_EXPIRED','message':'Quote je neplatný nebo expirovaný'})
        live=_v138_live_publication(c,q['merchant_id'])
        if not live or int(live['publication_no'])!=int(q['menu_publication_no']) or live['snapshot_sha256']!=q['menu_snapshot_sha256']:
            c.execute("INSERT INTO checkout_quote_lock_audit VALUES (?,?,?,?,?,?,?,?,?,?,?)",('qla_'+uuid.uuid4().hex[:12],qid,u['customer_id'],q['merchant_id'],'CONFIRM_BLOCKED',int(live['publication_no']) if live else None,live['snapshot_sha256'] if live else None,q['quote_hash'],'FAIL',json.dumps({'code':'QUOTE_STALE'},ensure_ascii=False),now())); c.commit()
            raise HTTPException(409,{'code':'QUOTE_STALE','message':'Publikované menu se změnilo. Vytvořte nový quote.','current_publication_no':int(live['publication_no']) if live else None})
        # Recompute and compare canonical pricing under the exact locked publication.
        rows=json.loads(q['items_json']); live_snap=json.loads(live['snapshot_json']); live_items={str(x.get('id')):x for x in live_snap.get('items',[])}
        normalized=[]
        for it in rows:
            li=live_items.get(str(it['menu_item_id']))
            if not li or str((li.get('availability') or {}).get('state','AVAILABLE'))=='SOLD_OUT':
                raise HTTPException(409,{'code':'QUOTE_ITEM_STALE','menu_item_id':it['menu_item_id']})
            unit=float(li.get('price_czk',0)); qty=int(it['qty']); normalized.append({'menu_item_id':it['menu_item_id'],'name':li.get('name'),'qty':qty,'unit_price_czk':unit,'line_total_czk':round(unit*qty,2),'modifier_groups':li.get('modifier_groups',[])})
        pricing=pricing_for_cart(c,u['customer_id'],q['merchant_id'],round(sum(x['line_total_czk'] for x in normalized),2),q['address_id'])
        expected_hash=_v139_quote_hash(u['customer_id'],q['merchant_id'],q['address_id'],q['menu_publication_no'],q['menu_snapshot_sha256'],normalized,pricing)
        if expected_hash!=q['quote_hash'] or round(float(pricing['total_czk']),2)!=round(float(q['total_czk']),2):
            raise HTTPException(409,{'code':'QUOTE_PRICE_MISMATCH','message':'Quote už neodpovídá kanonickému pricing snapshotu'})
        addr=c.execute('SELECT * FROM customer_addresses WHERE id=? AND customer_id=?',(q['address_id'],u['customer_id'])).fetchone()
        if not addr: raise HTTPException(409,'Adresa nenalezena')
        oid='ord139_'+uuid.uuid4().hex[:12]; t=now()
        c.execute("INSERT INTO orders(id,customer_id,merchant_id,status,subtotal_czk,service_fee_czk,delivery_fee_czk,total_czk,pro_discount_czk,pricing_version,created_at,updated_at,address,address_id) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
                  (oid,u['customer_id'],q['merchant_id'],'payment_pending',q['subtotal_czk'],q['service_fee_czk'],q['delivery_fee_czk'],q['total_czk'],q['discount_czk'],f"v1.139_quote_{q['quote_hash'][:12]}",t,t,f"{addr['street']}, {addr['city']} {addr['postal_code'] or ''}".strip(),q['address_id']))
        for it in normalized:
            oi='oi139_'+uuid.uuid4().hex[:10]
            c.execute("INSERT INTO order_items(id,order_id,menu_item_id,qty,unit_price_czk) VALUES (?,?,?,?,?)",(oi,oid,it['menu_item_id'],it['qty'],it['unit_price_czk']))
        c.execute("UPDATE checkout_quotes SET status='confirmed',confirmed_order_id=? WHERE id=?",(oid,qid))
        emit(c,oid,'order_created',{'source':'checkout_v139','quote_id':qid,'quote_hash':q['quote_hash'],'menu_publication_no':int(q['menu_publication_no']),'menu_snapshot_sha256':q['menu_snapshot_sha256'],'total_czk':q['total_czk']},u['id'])
        result={'schema_version':'1.139','order_id':oid,'quote_id':qid,'status':'payment_pending','total_czk':q['total_czk'],'currency':'CZK','idempotent_reuse':False,'quote_hash':q['quote_hash'],'menu_publication_no':int(q['menu_publication_no'])}
        _v052_store(c,f'checkout-v139-confirm:{u["id"]}',idempotency_key,{'quote_id':qid},result)
        c.execute("INSERT INTO checkout_quote_lock_audit VALUES (?,?,?,?,?,?,?,?,?,?,?)",('qla_'+uuid.uuid4().hex[:12],qid,u['customer_id'],q['merchant_id'],'CONFIRMED',int(q['menu_publication_no']),q['menu_snapshot_sha256'],q['quote_hash'],'PASS',json.dumps({'order_id':oid,'total_czk':q['total_czk']},ensure_ascii=False),now()))
        c.commit()
        return result

