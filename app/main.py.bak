# ---------------------------------------------------------------------------
# WUNOO v1.18 — production hardening / failure-safe mutation gateway
# ---------------------------------------------------------------------------
# v1.18 keeps v1.16 as the canonical state machine, but puts a retry-safe,
# transaction-scoped command envelope around the high-risk order mutations.
# The goal is exactly-once business effect for client retries and a single
# authoritative response for a reused Idempotency-Key.

def migrate_v118(c):
    c.execute("""CREATE TABLE IF NOT EXISTS v118_command_log(
        id TEXT PRIMARY KEY,
        scope TEXT NOT NULL,
        idem_key TEXT NOT NULL,
        request_hash TEXT NOT NULL,
        command TEXT NOT NULL,
        response_json TEXT NOT NULL,
        created_at TEXT NOT NULL,
        UNIQUE(scope, idem_key)
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_v118_command_log_created ON v118_command_log(created_at)")
    c.commit()


def _v118_cached_command(c, scope, idem_key, payload):
    if not idem_key or len(idem_key) > 120:
        raise HTTPException(400, "Idempotency-Key je povinný")
    raw=json.dumps(payload or {}, sort_keys=True, ensure_ascii=False)
    rh=hashlib.sha256(raw.encode()).hexdigest()
    row=c.execute("SELECT * FROM v118_command_log WHERE scope=? AND idem_key=?", (scope, idem_key)).fetchone()
    if row:
        if row["request_hash"] != rh:
            raise HTTPException(409, "Idempotency-Key použit pro jiný request")
        return json.loads(row["response_json"])
    return None


def _v118_store_command(c, scope, idem_key, payload, command, response):
    raw=json.dumps(payload or {}, sort_keys=True, ensure_ascii=False)
    rh=hashlib.sha256(raw.encode()).hexdigest()
    c.execute("""INSERT INTO v118_command_log
        (id,scope,idem_key,request_hash,command,response_json,created_at)
        VALUES (?,?,?,?,?,?,?)""",
        ("v118_"+uuid.uuid4().hex[:12], scope, idem_key, rh, command,
         json.dumps(response, ensure_ascii=False), now()))


@app.post("/api/v118/orders/{order_id}/command")
def v118_order_command(order_id: str, body: dict[str, Any],
                       authorization: str | None = Header(default=None),
                       idempotency_key: str | None = Header(default=None, alias="Idempotency-Key")) -> dict[str, Any]:
    """Retry-safe command gateway for order lifecycle + cancellation/refund.

    A successful command is persisted in the same DB transaction as its state
    change. A client retry with the same key receives the original response;
    reusing the key for a different command payload is rejected.
    """
    u=current_user(authorization)
    action=str(body.get("action", "")).strip()
    allowed={"accept","ready","dispatch","pickup","start_delivery","deliver","cancel","refund"}
    if action not in allowed:
        raise HTTPException(400, "Neplatná v1.18 command akce")
    payload={"order_id":order_id,"action":action}
    if action=="cancel": payload["reason_code"]=str(body.get("reason_code","customer_request"))
    if action=="refund": payload["amount_czk"]=round(float(body.get("amount_czk",0)),2); payload["reason_code"]=str(body.get("reason_code","customer_request"))
    scope=f"v118:{u['id']}:{order_id}"

    with core_db_connect() as c:
        c.execute("BEGIN")
        cached=_v118_cached_command(c,scope,idempotency_key,payload)
        if cached is not None:
            c.rollback()
            return cached
        o=c.execute("SELECT * FROM orders WHERE id=?",(order_id,)).fetchone()
        if not o: raise HTTPException(404,"Objednávka nenalezena")

        if u["role"]=="customer" and o["customer_id"]!=u.get("customer_id"): raise HTTPException(403,"forbidden")
        if u["role"]=="merchant" and o["merchant_id"]!=u.get("merchant_id"): raise HTTPException(403,"forbidden")
        if u["role"]=="courier" and action in {"pickup","start_delivery","deliver"} and o["courier_id"]!=u.get("courier_id"):
            raise HTTPException(403,"Objednávka není přiřazená vám")

        if action in {"accept","ready"} and u["role"] not in {"merchant","admin","ops_agent"}:
            raise HTTPException(403,"Nedostatečné oprávnění")
        if action in {"dispatch","pickup","start_delivery","deliver"} and u["role"] not in {"courier","admin","ops_agent"}:
            raise HTTPException(403,"Nedostatečné oprávnění")
        if action=="cancel" and u["role"] not in {"customer","merchant","admin","ops_agent"}:
            raise HTTPException(403,"Nedostatečné oprávnění")
        if action=="refund" and u["role"] not in {"merchant","admin","ops_agent"}:
            raise HTTPException(403,"Nedostatečné oprávnění")

        result=None
        if action in V116_ACTIONS:
            role,expected,target,event_type=V116_ACTIONS[action]
            if o["status"]==target:
                result={"schema_version":"1.18","order_id":order_id,"action":action,"status":target,"idempotent":True}
            elif o["status"]!=expected:
                raise HTTPException(409,f"Objednávka je ve stavu {o['status']}, očekává se {expected}")
            elif action=="dispatch":
                candidates=courier_candidates(c,o)
                if u["role"]=="courier": candidates=[x for x in candidates if x["courier_id"]==u.get("courier_id")]
                if not candidates: raise HTTPException(409,"Žádný oprávněný online kurýr")
                candidate=candidates[0]; ts=now()
                from datetime import timedelta
                eta=int(candidate["pickup_eta_minutes"])
                pp=(datetime.now(timezone.utc)+timedelta(minutes=eta)).isoformat()
                pd=(datetime.now(timezone.utc)+timedelta(minutes=eta+30)).isoformat()
                changed=c.execute("""UPDATE orders SET courier_id=?,status='assigned',assigned_at=?,
                    predicted_pickup_at=?,predicted_delivery_at=?,updated_at=?
                    WHERE id=? AND status='dispatch_pending'""",
                    (candidate["courier_id"],ts,pp,pd,ts,order_id)).rowcount
                if changed!=1: raise HTTPException(409,"State transition conflict")
                emit(c,order_id,event_type,{"courier_id":candidate["courier_id"],"schema_version":"1.18"},u["id"])
                _notify_order_status(c,order_id,"assigned")
                result={"schema_version":"1.18","order_id":order_id,"action":action,"status":"assigned","courier_id":candidate["courier_id"],"idempotent":False}
            else:
                transition(c,order_id,expected,target,u,event_type,{"from":expected,"to":target,"schema_version":"1.18"})
                if action=="pickup": c.execute("UPDATE orders SET picked_up_at=?,updated_at=? WHERE id=?",(now(),now(),order_id))
                result={"schema_version":"1.18","order_id":order_id,"action":action,"status":target,"idempotent":False}

        elif action=="deliver":
            require_role(u,{"courier","admin","ops_agent"})
            if o["status"]=="delivered":
                result={"schema_version":"1.18","order_id":order_id,"action":"deliver","status":"delivered","idempotent":True}
            elif o["status"] not in {"picked_up","out_for_delivery"}:
                raise HTTPException(409,f"Objednávku nelze doručit ze stavu {o['status']}")
            else:
                proof_required=("delivery_proof_status" in o.keys() and o["delivery_proof_status"]=="required_v044")
                if proof_required and u["role"]!="admin" and not c.execute("SELECT 1 FROM delivery_proofs WHERE order_id=?",(order_id,)).fetchone():
                    raise HTTPException(409,"Před dokončením doručení chybí proof-of-delivery")
                if c.execute("SELECT 1 FROM settlements WHERE order_id=?",(order_id,)).fetchone():
                    raise HTTPException(409,"Settlement již existuje")
                transition(c,order_id,o["status"],"delivered",u,"delivery_completed",{"schema_version":"1.18"})
                courier_payout=round(40.0+7.0*float(o["delivery_distance_km"]),2)
                merchant_amount=round(float(o["subtotal_czk"]),2)
                platform_amount=round(float(o["total_czk"])-merchant_amount-courier_payout,2)
                variance=round(float(o["total_czk"])-merchant_amount-courier_payout-platform_amount,2)
                sid="set_"+uuid.uuid4().hex[:10]
                c.execute("INSERT INTO settlements VALUES (?,?,?,?,?,?,?,?)",(sid,order_id,merchant_amount,courier_payout,platform_amount,variance,"reconciled" if variance==0 else "exception",now()))
                if o["courier_id"]: c.execute("UPDATE couriers SET earnings_czk=earnings_czk+? WHERE id=?",(courier_payout,o["courier_id"]))
                c.execute("UPDATE orders SET delivered_at=?,updated_at=? WHERE id=?",(now(),now(),order_id))
                emit(c,order_id,"settlement_completed",{"settlement_id":sid,"variance_czk":variance,"schema_version":"1.18"},u["id"])
                result={"schema_version":"1.18","order_id":order_id,"action":"deliver","status":"delivered","settlement_id":sid,"variance_czk":variance,"idempotent":False}

        elif action=="cancel":
            reason=payload["reason_code"]
            if reason not in {"customer_request","merchant_rejected","payment_failed","courier_failed","duplicate","fraud_review"}: raise HTTPException(400,"Neplatný reason_code")
            if o["status"] in {"delivered","cancelled","payment_failed","payment_cancelled","refunded"}: raise HTTPException(409,"Objednávku již nelze zrušit")
            atomic_transition_any(c,order_id,("payment_pending","merchant_pending","preparing","dispatch_pending","assigned","picked_up","out_for_delivery","confirmed","ready_for_pickup","courier_assigned"),"cancelled",u,"order_cancelled",{"reason_code":reason,"schema_version":"1.18"})
            c.execute("INSERT INTO order_cancellations VALUES (?,?,?,?,?,?)",("can_"+uuid.uuid4().hex[:12],order_id,u["id"],reason,str(body.get("note",""))[:500],now()))
            result={"schema_version":"1.18","order_id":order_id,"action":"cancel","status":"cancelled","reason_code":reason,"idempotent":False}

        elif action=="refund":
            amount=payload["amount_czk"]
            if amount<=0: raise HTTPException(400,"Částka refundu musí být > 0")
            paid=c.execute("SELECT COALESCE(SUM(amount_czk),0) n FROM payments WHERE order_id=? AND status='captured'",(order_id,)).fetchone()["n"]
            refunded=c.execute("SELECT COALESCE(SUM(amount_czk),0) n FROM refunds WHERE order_id=? AND status IN ('pending','processed','succeeded')",(order_id,)).fetchone()["n"]
            remaining=round(float(paid)-float(refunded),2)
            if amount>remaining+0.01: raise HTTPException(409,f"Refund převyšuje zbývající částku {remaining:.2f} Kč")
            payment=c.execute("SELECT id FROM payments WHERE order_id=? AND status='captured' ORDER BY created_at DESC LIMIT 1",(order_id,)).fetchone()
            rid="ref_"+uuid.uuid4().hex[:12]
            insert_refund(c,rid,order_id,payment["id"] if payment else None,amount,payload["reason_code"],"processed","demo_ref_"+uuid.uuid4().hex[:10])
            if round(amount,2)>=round(remaining,2): c.execute("UPDATE payments SET status='refunded' WHERE order_id=? AND status='captured'",(order_id,))
            emit(c,order_id,"refund_completed",{"refund_id":rid,"amount_czk":amount,"schema_version":"1.18"},u["id"])
            result={"schema_version":"1.18","order_id":order_id,"action":"refund","refund_id":rid,"amount_czk":amount,"status":"processed","idempotent":False}

        _v118_store_command(c,scope,idempotency_key,payload,action,result)
        c.commit()
        return result


@app.get("/api/v118/orders/{order_id}/integrity")
def v118_order_integrity(order_id: str, authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent","merchant","customer","courier"})
    with core_db_connect() as c:
        o=_v116_order_scope(c,order_id,u)
        payment=c.execute("SELECT * FROM payments WHERE order_id=? ORDER BY created_at DESC LIMIT 1",(order_id,)).fetchone()
        settlement=c.execute("SELECT * FROM settlements WHERE order_id=?",(order_id,)).fetchone()
        refunds=c.execute("SELECT COALESCE(SUM(amount_czk),0) n FROM refunds WHERE order_id=? AND status IN ('pending','processed','succeeded')",(order_id,)).fetchone()["n"]
        duplicate_settlements=int(c.execute("SELECT COUNT(*) n FROM settlements WHERE order_id=?",(order_id,)).fetchone()["n"])
        command_count=int(c.execute("SELECT COUNT(*) n FROM v118_command_log WHERE scope LIKE ?",(f"%:{order_id}",)).fetchone()["n"])
        checks={
            "single_settlement": duplicate_settlements<=1,
            "payment_not_over_refunded": float(refunds)<=float(payment["amount_czk"] if payment else 0)+0.01,
            "delivered_has_settlement": o["status"]!="delivered" or settlement is not None,
            "cancelled_not_settled": o["status"]!="cancelled" or settlement is None,
        }
        return {"schema_version":"1.18","order_id":order_id,"status":o["status"],"healthy":all(checks.values()),"checks":checks,"payment":dict(payment) if payment else None,"settlement":dict(settlement) if settlement else None,"refunded_czk":float(refunds),"v118_command_count":command_count}


@app.get("/frontend_v029/hardening_v118.html")
def v118_hardening_page():
    return FileResponse(BASE.parent / "frontend_v029" / "hardening_v118.html")

# ---------------------------------------------------------------------------
# WUNOO v1.19 — failure & recovery engine
# ---------------------------------------------------------------------------

def migrate_v119(c):
    c.execute("""CREATE TABLE IF NOT EXISTS order_cancellations(
        id TEXT PRIMARY KEY, order_id TEXT NOT NULL, actor_user_id TEXT NOT NULL, reason_code TEXT NOT NULL, note TEXT, created_at TEXT NOT NULL
    )""")
    c.execute("""CREATE TABLE IF NOT EXISTS v119_recovery_log(
        id TEXT PRIMARY KEY,
        order_id TEXT NOT NULL,
        action TEXT NOT NULL,
        reason_code TEXT NOT NULL,
        previous_status TEXT,
        resulting_status TEXT,
        previous_courier_id TEXT,
        created_at TEXT NOT NULL
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_v119_recovery_order ON v119_recovery_log(order_id,created_at)")
    c.commit()


def _v119_recovery_candidates(c, o, exclude_ids=None):
    exclude_ids=set(exclude_ids or [])
    candidates=courier_candidates(c,o)
    return [x for x in candidates if x["courier_id"] not in exclude_ids]


def _v119_store_recovery(c, order_id, action, reason, previous_status, resulting_status, previous_courier_id):
    c.execute("INSERT INTO v119_recovery_log VALUES (?,?,?,?,?,?,?,?)",(
        "v119_"+uuid.uuid4().hex[:12],order_id,action,reason,previous_status,resulting_status,previous_courier_id,now()))


def _v119_reassign_locked(c, o, actor, reason):
    previous=o["courier_id"]
    if o["status"] not in {"assigned","picked_up","out_for_delivery","delayed"}:
        raise HTTPException(409,f"Objednávku nelze redispatchnout ze stavu {o['status']}")
    old_ids={r["previous_courier_id"] for r in c.execute("SELECT previous_courier_id FROM v119_recovery_log WHERE order_id=? AND previous_courier_id IS NOT NULL",(o["id"],)).fetchall()}
    if previous: old_ids.add(previous)
    atomic_transition_any(c,o["id"],(o["status"],),"dispatch_pending",actor,"order_redispatch_requested",{
        "reason_code":reason,"previous_courier_id":previous,"schema_version":"1.19"})
    c.execute("UPDATE orders SET courier_id=NULL,assigned_at=NULL,picked_up_at=NULL,updated_at=? WHERE id=?",(now(),o["id"]))
    rid="rd19_"+uuid.uuid4().hex[:10]
    c.execute("INSERT INTO order_redispatches VALUES (?,?,?,?,?,?,?)",(rid,o["id"],previous,reason,"completed",now(),now()))
    _v119_store_recovery(c,o["id"],"redispatch",reason,o["status"],"dispatch_pending",previous)
    emit(c,o["id"],"recovery_redispatch_completed",{"redispatch_id":rid,"excluded_couriers":sorted(x for x in old_ids if x),"schema_version":"1.19"},actor["id"])
    return {"order_id":o["id"],"status":"dispatch_pending","redispatch_id":rid,"previous_courier_id":previous,"excluded_couriers":sorted(x for x in old_ids if x)}


@app.post("/api/v119/orders/{order_id}/recover")
def v119_recover_order(order_id: str, body: dict[str, Any], authorization: str | None = Header(default=None), idempotency_key: str | None = Header(default=None, alias="Idempotency-Key")) -> dict[str, Any]:
    u=current_user(authorization)
    action=str(body.get("action","")).strip()
    allowed={"merchant_reject","courier_fail","redispatch","timeout_check","payment_fail"}
    if action not in allowed: raise HTTPException(400,"Neplatná v1.19 recovery akce")
    if not idempotency_key or len(idempotency_key)>120: raise HTTPException(400,"Idempotency-Key je povinný")
    payload={"order_id":order_id,"action":action,"reason_code":str(body.get("reason_code",action))}
    scope=f"v119:{u['id']}:{order_id}"
    with core_db_connect() as c:
        c.execute("BEGIN")
        cached=_v118_cached_command(c,scope,idempotency_key,payload)
        if cached is not None:
            c.rollback(); return cached
        o=c.execute("SELECT * FROM orders WHERE id=?",(order_id,)).fetchone()
        if not o: raise HTTPException(404,"Objednávka nenalezena")
        if u["role"]=="merchant" and o["merchant_id"]!=u.get("merchant_id"): raise HTTPException(403,"forbidden")
        if u["role"]=="customer" and o["customer_id"]!=u.get("customer_id"): raise HTTPException(403,"forbidden")
        if action=="merchant_reject":
            require_role(u,{"merchant","admin","ops_agent"})
            if o["status"]!="merchant_pending": raise HTTPException(409,f"Objednávku nelze odmítnout ze stavu {o['status']}")
            atomic_transition_any(c,order_id,("merchant_pending",),"cancelled",u,"merchant_rejected",{"reason_code":"merchant_rejected","schema_version":"1.19"})
            c.execute("INSERT INTO order_cancellations VALUES (?,?,?,?,?,?)",("can19_"+uuid.uuid4().hex[:10],order_id,u["id"],"merchant_rejected",str(body.get("note",""))[:500],now()))
            result={"schema_version":"1.19","order_id":order_id,"action":action,"status":"cancelled","reason_code":"merchant_rejected"}
        elif action=="payment_fail":
            require_role(u,{"customer","admin","ops_agent"})
            if u["role"]=="customer" and o["customer_id"]!=u.get("customer_id"): raise HTTPException(403,"forbidden")
            if o["status"]!="payment_pending": raise HTTPException(409,f"Payment failure lze simulovat jen ze stavu {o['status']}")
            atomic_transition_any(c,order_id,("payment_pending",),"payment_failed",u,"payment_failed",{"schema_version":"1.19","reason_code":"payment_failed"})
            c.execute("UPDATE payment_intents SET status='failed',updated_at=? WHERE order_id=? AND status NOT IN ('succeeded','failed','cancelled')",(now(),order_id))
            result={"schema_version":"1.19","order_id":order_id,"action":action,"status":"payment_failed"}
        elif action in {"courier_fail","redispatch"}:
            require_role(u,{"courier","admin","ops_agent"})
            if u["role"]=="courier" and o["courier_id"]!=u.get("courier_id"): raise HTTPException(403,"Objednávka není přiřazená vám")
            reason="courier_failed" if action=="courier_fail" else str(body.get("reason_code","manual_redispatch"))
            result=_v119_reassign_locked(c,o,u,reason)
            result.update({"schema_version":"1.19","action":action})
        else:  # timeout_check
            require_role(u,{"admin","ops_agent"})
            if o["status"] in {"delivered","cancelled","payment_failed","payment_cancelled"}:
                result={"schema_version":"1.19","order_id":order_id,"action":action,"status":o["status"],"recovery":"none","reason":"terminal"}
            else:
                t=datetime.fromisoformat(str(body.get("now_at") or now()).replace("Z","+00:00"))
                reason="none"; recovery="none"; result=None
                if o["status"]=="merchant_pending":
                    created=datetime.fromisoformat(o["created_at"].replace("Z","+00:00"))
                    if (t-created).total_seconds()>=600:
                        reason="merchant_timeout"; recovery="merchant_timeout"
                        atomic_transition_any(c,order_id,("merchant_pending",),"cancelled",u,"merchant_timeout",{"reason_code":"merchant_timeout","schema_version":"1.19"})
                        c.execute("INSERT INTO order_cancellations VALUES (?,?,?,?,?,?)",("can19_"+uuid.uuid4().hex[:10],order_id,u["id"],"merchant_rejected","merchant timeout",now()))
                elif o["status"] in {"assigned","picked_up","out_for_delivery","delayed"}:
                    loc=c.execute("SELECT recorded_at FROM courier_locations WHERE order_id=? ORDER BY recorded_at DESC LIMIT 1",(order_id,)).fetchone()
                    stale=False
                    if loc:
                        try: stale=(t-datetime.fromisoformat(str(loc["recorded_at"]).replace("Z","+00:00"))).total_seconds()>180
                        except Exception: stale=False
                    if not loc or stale:
                        reason="courier_stale_or_missing"; recovery="redispatch"
                        result=_v119_reassign_locked(c,o,u,reason); result.update({"schema_version":"1.19","action":action,"recovery":recovery,"reason":reason})
                result=result if isinstance(result,dict) else {"schema_version":"1.19","order_id":order_id,"action":action,"status":c.execute("SELECT status FROM orders WHERE id=?",(order_id,)).fetchone()["status"],"recovery":recovery,"reason":reason}
        _v118_store_command(c,scope,idempotency_key,payload,action,result)
        c.commit(); return result


@app.get("/api/v119/orders/{order_id}/recovery")
def v119_recovery_status(order_id: str, authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u=current_user(authorization)
    with core_db_connect() as c:
        o=_v116_order_scope(c,order_id,u)
        incidents=c.execute("SELECT * FROM reliability_incidents WHERE order_id=?",(order_id,)).fetchall()
        recovery=c.execute("SELECT * FROM customer_recovery_actions WHERE order_id=? ORDER BY created_at DESC",(order_id,)).fetchall()
        redispatch=c.execute("SELECT * FROM order_redispatches WHERE order_id=? ORDER BY created_at DESC",(order_id,)).fetchall()
        log=c.execute("SELECT * FROM v119_recovery_log WHERE order_id=? ORDER BY created_at DESC",(order_id,)).fetchall()
        return {"schema_version":"1.19","order_id":order_id,"status":o["status"],"active_courier_id":o["courier_id"],"incidents":[dict(x) for x in incidents],"recovery_actions":[dict(x) for x in recovery],"redispatches":[dict(x) for x in redispatch],"recovery_log":[dict(x) for x in log]}


@app.get("/frontend_v029/recovery_v119.html")
def v119_recovery_page():
    return FileResponse(BASE.parent / "frontend_v029" / "recovery_v119.html")

# ---------------------------------------------------------------------------
# WUNOO v1.20 — finance & settlement integrity
# ---------------------------------------------------------------------------

def migrate_v120(c):
    c.execute("""CREATE TABLE IF NOT EXISTS v120_finance_reconciliation(
        id TEXT PRIMARY KEY, order_id TEXT NOT NULL UNIQUE, status TEXT NOT NULL,
        captured_czk REAL NOT NULL DEFAULT 0, refunded_czk REAL NOT NULL DEFAULT 0,
        refundable_czk REAL NOT NULL DEFAULT 0, gross_czk REAL NOT NULL DEFAULT 0,
        merchant_czk REAL NOT NULL DEFAULT 0, courier_czk REAL NOT NULL DEFAULT 0,
        platform_czk REAL NOT NULL DEFAULT 0, ledger_debit_czk REAL NOT NULL DEFAULT 0,
        ledger_credit_czk REAL NOT NULL DEFAULT 0, variance_czk REAL NOT NULL DEFAULT 0,
        settlement_source TEXT, exception_code TEXT, created_at TEXT NOT NULL
    )""")
    c.execute("""CREATE TABLE IF NOT EXISTS v120_payouts(
        id TEXT PRIMARY KEY, order_id TEXT NOT NULL, beneficiary_type TEXT NOT NULL,
        beneficiary_id TEXT, amount_czk REAL NOT NULL, status TEXT NOT NULL,
        settlement_id TEXT, created_at TEXT NOT NULL, completed_at TEXT,
        UNIQUE(order_id, beneficiary_type)
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_v120_recon_status ON v120_finance_reconciliation(status,created_at)")
    c.execute("CREATE INDEX IF NOT EXISTS idx_v120_payout_order ON v120_payouts(order_id,created_at)")
    c.commit()


def _v120_finance_snapshot(c, order_id):
    o=c.execute("SELECT * FROM orders WHERE id=?",(order_id,)).fetchone()
    if not o: raise HTTPException(404,"Objednávka nenalezena")
    captured=float(c.execute("SELECT COALESCE(SUM(amount_czk),0) n FROM payments WHERE order_id=? AND status IN ('captured','refunded')",(order_id,)).fetchone()["n"] or 0)
    refunded=float(c.execute("SELECT COALESCE(SUM(amount_czk),0) n FROM refunds WHERE order_id=? AND status IN ('pending','processed','succeeded')",(order_id,)).fetchone()["n"] or 0)
    refundable=round(max(0.0,captured-refunded),2)
    sr=c.execute("SELECT * FROM settlement_runs WHERE order_id=?",(order_id,)).fetchone()
    legacy=c.execute("SELECT * FROM settlements WHERE order_id=?",(order_id,)).fetchone()
    settlement_source="settlement_runs" if sr else ("legacy_settlements" if legacy else None)
    if sr:
        gross=float(sr["gross_czk"]); merchant=float(sr["merchant_payout_czk"]); courier=float(sr["courier_payout_czk"]); platform=float(sr["platform_fee_czk"]); settlement_id=sr["id"]
    elif legacy:
        gross=float(o["total_czk"]); merchant=float(legacy["merchant_czk"]); courier=float(legacy["courier_czk"]); platform=float(legacy["platform_czk"]); settlement_id=legacy["id"]
    else:
        gross=float(o["total_czk"]); merchant=courier=platform=0.0; settlement_id=None
    deb=float(c.execute("SELECT COALESCE(SUM(amount_czk),0) n FROM finance_ledger_entries WHERE order_id=? AND direction='debit'",(order_id,)).fetchone()["n"] or 0)
    cred=float(c.execute("SELECT COALESCE(SUM(amount_czk),0) n FROM finance_ledger_entries WHERE order_id=? AND direction='credit'",(order_id,)).fetchone()["n"] or 0)
    settlement_variance=round(gross-merchant-courier-platform,2) if settlement_id else 0.0
    ledger_variance=round(deb-cred,2)
    payout_rows=c.execute("SELECT * FROM v120_payouts WHERE order_id=? ORDER BY created_at",(order_id,)).fetchall()
    payout_total=round(sum(float(x["amount_czk"]) for x in payout_rows),2)
    exception=None
    if refunded > captured + 0.01: exception="REFUND_OVER_CAPTURED"
    elif settlement_id and abs(settlement_variance)>0.01: exception="SETTLEMENT_VARIANCE"
    elif settlement_id and abs(ledger_variance)>0.01: exception="LEDGER_UNBALANCED"
    elif o["status"]=="delivered" and not settlement_id: exception="DELIVERED_WITHOUT_SETTLEMENT"
    elif payout_total > round(max(0.0,gross-refunded)+0.01,2): exception="PAYOUT_EXCEEDS_NET"
    status="exception" if exception else "reconciled"
    return {"order":o,"captured_czk":round(captured,2),"refunded_czk":round(refunded,2),"refundable_czk":refundable,
            "gross_czk":round(gross,2),"merchant_czk":round(merchant,2),"courier_czk":round(courier,2),"platform_czk":round(platform,2),
            "settlement_id":settlement_id,"settlement_source":settlement_source,"ledger_debit_czk":round(deb,2),"ledger_credit_czk":round(cred,2),
            "settlement_variance_czk":settlement_variance,"ledger_variance_czk":ledger_variance,"payout_total_czk":payout_total,
            "status":status,"exception_code":exception,"payouts":[dict(x) for x in payout_rows]}


def _v120_store_reconciliation(c, snap):
    c.execute("""INSERT INTO v120_finance_reconciliation
        (id,order_id,status,captured_czk,refunded_czk,refundable_czk,gross_czk,merchant_czk,courier_czk,platform_czk,
         ledger_debit_czk,ledger_credit_czk,variance_czk,settlement_source,exception_code,created_at)
        VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)
        ON CONFLICT(order_id) DO UPDATE SET status=excluded.status,captured_czk=excluded.captured_czk,
         refunded_czk=excluded.refunded_czk,refundable_czk=excluded.refundable_czk,gross_czk=excluded.gross_czk,
         merchant_czk=excluded.merchant_czk,courier_czk=excluded.courier_czk,platform_czk=excluded.platform_czk,
         ledger_debit_czk=excluded.ledger_debit_czk,ledger_credit_czk=excluded.ledger_credit_czk,variance_czk=excluded.variance_czk,
         settlement_source=excluded.settlement_source,exception_code=excluded.exception_code,created_at=excluded.created_at""",
        ("rec20_"+uuid.uuid4().hex[:12],snap["order"]["id"],snap["status"],snap["captured_czk"],snap["refunded_czk"],snap["refundable_czk"],
         snap["gross_czk"],snap["merchant_czk"],snap["courier_czk"],snap["platform_czk"],snap["ledger_debit_czk"],snap["ledger_credit_czk"],
         snap["settlement_variance_czk"]+snap["ledger_variance_czk"],snap["settlement_source"],snap["exception_code"],now()))


@app.get("/api/v120/finance/orders/{order_id}")
def v120_finance_order(order_id:str, authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent","merchant"})
    with core_db_connect() as c:
        o=c.execute("SELECT * FROM orders WHERE id=?",(order_id,)).fetchone()
        if not o: raise HTTPException(404,"Objednávka nenalezena")
        if u["role"]=="merchant" and o["merchant_id"]!=u.get("merchant_id"): raise HTTPException(403,"forbidden")
        s=_v120_finance_snapshot(c,order_id)
        return {"schema_version":"1.20",**{k:v for k,v in s.items() if k!="order"},"order_id":order_id,"order_status":o["status"]}


@app.post("/api/v120/finance/orders/{order_id}/reconcile")
def v120_reconcile(order_id:str, authorization:str|None=Header(default=None), idempotency_key:str|None=Header(default=None,alias="Idempotency-Key"))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    if not idempotency_key or len(idempotency_key)>120: raise HTTPException(400,"Idempotency-Key je povinný")
    payload={"order_id":order_id,"action":"reconcile"}; scope=f"v120:reconcile:{u['id']}:{order_id}"
    with core_db_connect() as c:
        c.execute("BEGIN")
        cached=_v118_cached_command(c,scope,idempotency_key,payload)
        if cached is not None: c.rollback(); return cached
        snap=_v120_finance_snapshot(c,order_id); _v120_store_reconciliation(c,snap)
        result={"schema_version":"1.20","order_id":order_id,"status":snap["status"],"exception_code":snap["exception_code"],
                "settlement_source":snap["settlement_source"],"settlement_variance_czk":snap["settlement_variance_czk"],"ledger_variance_czk":snap["ledger_variance_czk"],
                "captured_czk":snap["captured_czk"],"refunded_czk":snap["refunded_czk"],"refundable_czk":snap["refundable_czk"]}
        _v118_store_command(c,scope,idempotency_key,payload,"reconcile",result); c.commit(); return result


@app.post("/api/v120/finance/orders/{order_id}/refund")
def v120_refund(order_id:str, body:dict[str,Any], authorization:str|None=Header(default=None), idempotency_key:str|None=Header(default=None,alias="Idempotency-Key"))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"merchant","admin","ops_agent"})
    if not idempotency_key or len(idempotency_key)>120: raise HTTPException(400,"Idempotency-Key je povinný")
    amount=round(float(body.get("amount_czk",0)),2); reason=str(body.get("reason_code","customer_request"))
    if amount<=0: raise HTTPException(400,"Částka refundu musí být > 0")
    payload={"order_id":order_id,"action":"refund","amount_czk":amount,"reason_code":reason}; scope=f"v120:refund:{u['id']}:{order_id}"
    with core_db_connect() as c:
        c.execute("BEGIN")
        cached=_v118_cached_command(c,scope,idempotency_key,payload)
        if cached is not None: c.rollback(); return cached
        o=c.execute("SELECT * FROM orders WHERE id=?",(order_id,)).fetchone()
        if not o: raise HTTPException(404,"Objednávka nenalezena")
        if u["role"]=="merchant" and o["merchant_id"]!=u.get("merchant_id"): raise HTTPException(403,"forbidden")
        if o["status"] not in {"cancelled","delivered"}: raise HTTPException(409,"Refund je povolen pouze pro cancelled/delivered objednávku")
        snap=_v120_finance_snapshot(c,order_id)
        if amount>snap["refundable_czk"]+0.01: raise HTTPException(409,f"Refund převyšuje zbývající částku {snap['refundable_czk']:.2f} Kč")
        payment=c.execute("SELECT id FROM payments WHERE order_id=? AND status IN ('captured','refunded') ORDER BY created_at DESC LIMIT 1",(order_id,)).fetchone()
        rid="ref20_"+uuid.uuid4().hex[:12]
        insert_refund(c,rid,order_id,payment["id"] if payment else None,amount,reason,"processed","demo_ref20_"+uuid.uuid4().hex[:10])
        if amount>=snap["refundable_czk"]-0.01:
            c.execute("UPDATE payments SET status='refunded' WHERE order_id=? AND status='captured'",(order_id,))
        emit(c,order_id,"finance_refund_completed",{"refund_id":rid,"amount_czk":amount,"schema_version":"1.20"},u["id"])
        snap2=_v120_finance_snapshot(c,order_id); _v120_store_reconciliation(c,snap2)
        result={"schema_version":"1.20","order_id":order_id,"refund_id":rid,"amount_czk":amount,"status":"processed","remaining_refundable_czk":snap2["refundable_czk"]}
        _v118_store_command(c,scope,idempotency_key,payload,"refund",result); c.commit(); return result


@app.post("/api/v120/finance/orders/{order_id}/payout")
def v120_payout(order_id:str, authorization:str|None=Header(default=None), idempotency_key:str|None=Header(default=None,alias="Idempotency-Key"))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    if not idempotency_key or len(idempotency_key)>120: raise HTTPException(400,"Idempotency-Key je povinný")
    payload={"order_id":order_id,"action":"payout"}; scope=f"v120:payout:{u['id']}:{order_id}"
    with core_db_connect() as c:
        c.execute("BEGIN")
        cached=_v118_cached_command(c,scope,idempotency_key,payload)
        if cached is not None: c.rollback(); return cached
        snap=_v120_finance_snapshot(c,order_id); o=snap["order"]
        if o["status"]!="delivered": raise HTTPException(409,"Payout je možný až po delivered")
        if snap["status"]!="reconciled": raise HTTPException(409,"Finance reconciliation není v pořádku")
        existing=c.execute("SELECT * FROM v120_payouts WHERE order_id=? ORDER BY created_at",(order_id,)).fetchall()
        if existing:
            result={"schema_version":"1.20","order_id":order_id,"status":"completed","idempotent":True,"payouts":[dict(x) for x in existing]}
        else:
            sid=snap["settlement_id"]
            rows=[("merchant",o["merchant_id"],snap["merchant_czk"]),("courier",o["courier_id"],snap["courier_czk"]),("platform",None,snap["platform_czk"])]
            payouts=[]
            for typ,bid,amount in rows:
                pid="pay20_"+uuid.uuid4().hex[:12]
                c.execute("INSERT INTO v120_payouts VALUES (?,?,?,?,?,?,?,?,?)",(pid,order_id,typ,bid,round(float(amount),2),"completed",sid,now(),now()))
                payouts.append({"id":pid,"beneficiary_type":typ,"beneficiary_id":bid,"amount_czk":round(float(amount),2),"status":"completed"})
            emit(c,order_id,"finance_payouts_completed",{"payouts":payouts,"schema_version":"1.20"},u["id"])
            result={"schema_version":"1.20","order_id":order_id,"status":"completed","idempotent":False,"payouts":payouts}
        _v118_store_command(c,scope,idempotency_key,payload,"payout",result); c.commit(); return result


@app.get("/api/v120/finance/exceptions")
def v120_finance_exceptions(authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    with core_db_connect() as c:
        rows=c.execute("SELECT * FROM v120_finance_reconciliation WHERE status='exception' ORDER BY created_at DESC").fetchall()
        return {"schema_version":"1.20","count":len(rows),"exceptions":[dict(x) for x in rows]}

@app.get("/frontend_v029/finance_v120.html")
def v120_finance_page():
    return FileResponse(BASE.parent / "frontend_v029" / "finance_v120.html")


# WUNOO v1.21 — customer trust & support

def migrate_v121(c):
    c.execute("""CREATE TABLE IF NOT EXISTS v121_support_cases(
        id TEXT PRIMARY KEY, order_id TEXT NOT NULL REFERENCES orders(id),
        customer_id TEXT NOT NULL, status TEXT NOT NULL DEFAULT 'open',
        category TEXT NOT NULL, priority TEXT NOT NULL DEFAULT 'normal',
        subject TEXT NOT NULL, description TEXT NOT NULL DEFAULT '',
        refund_requested_czk REAL NOT NULL DEFAULT 0,
        refund_approved_czk REAL NOT NULL DEFAULT 0,
        sla_due_at TEXT, assigned_to TEXT, resolution_code TEXT,
        created_at TEXT NOT NULL, updated_at TEXT NOT NULL, resolved_at TEXT, closed_at TEXT
    )""")
    c.execute("""CREATE TABLE IF NOT EXISTS v121_support_messages(
        id TEXT PRIMARY KEY, case_id TEXT NOT NULL REFERENCES v121_support_cases(id),
        actor_id TEXT NOT NULL, actor_role TEXT NOT NULL, body TEXT NOT NULL,
        created_at TEXT NOT NULL
    )""")
    c.execute("""CREATE TABLE IF NOT EXISTS v121_disputes(
        id TEXT PRIMARY KEY, case_id TEXT NOT NULL REFERENCES v121_support_cases(id),
        order_id TEXT NOT NULL, reason_code TEXT NOT NULL, status TEXT NOT NULL DEFAULT 'open',
        amount_czk REAL NOT NULL DEFAULT 0, decision_code TEXT, decided_by TEXT,
        created_at TEXT NOT NULL, decided_at TEXT
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_v121_cases_order ON v121_support_cases(order_id,created_at)")
    c.execute("CREATE INDEX IF NOT EXISTS idx_v121_cases_status ON v121_support_cases(status,priority,sla_due_at)")
    c.execute("CREATE INDEX IF NOT EXISTS idx_v121_messages_case ON v121_support_messages(case_id,created_at)")


def _v121_case_scope(c, case_id, u):
    row=c.execute("SELECT * FROM v121_support_cases WHERE id=?",(case_id,)).fetchone()
    if not row: raise HTTPException(404,"Support case nenalezen")
    if u["role"]=="customer" and row["customer_id"]!=u.get("customer_id"): raise HTTPException(403,"forbidden")
    return row


def _v121_sla_due(priority):
    from datetime import timedelta
    mins={"urgent":60,"high":240,"normal":1440,"low":2880}.get(priority,1440)
    return (datetime.now(timezone.utc)+timedelta(minutes=mins)).isoformat()


@app.post("/api/v121/support/cases")
def v121_case_create(body:dict[str,Any], authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization)
    require_role(u,{"customer","merchant","admin","ops_agent"})
    oid=str(body.get("order_id","")).strip(); category=str(body.get("category","other")).strip()
    priority=str(body.get("priority","normal")).strip(); subject=str(body.get("subject","")).strip(); desc=str(body.get("description",""))[:4000]
    if not oid or not subject: raise HTTPException(400,"order_id a subject jsou povinné")
    if category not in {"delivery","missing_item","wrong_item","quality","payment","refund","merchant","courier","other"}: raise HTTPException(400,"Neplatná kategorie")
    if priority not in {"low","normal","high","urgent"}: raise HTTPException(400,"Neplatná priorita")
    with core_db_connect() as c:
        o=c.execute("SELECT * FROM orders WHERE id=?",(oid,)).fetchone()
        if not o: raise HTTPException(404,"Objednávka nenalezena")
        if u["role"]=="customer" and o["customer_id"]!=u.get("customer_id"): raise HTTPException(403,"forbidden")
        if u["role"]=="merchant" and o["merchant_id"]!=u.get("merchant_id"): raise HTTPException(403,"forbidden")
        existing=c.execute("SELECT * FROM v121_support_cases WHERE order_id=? AND status NOT IN ('closed') AND customer_id=? ORDER BY created_at DESC LIMIT 1",(oid,o["customer_id"])).fetchone()
        if existing: return {"schema_version":"1.21","case":dict(existing),"deduplicated":True}
        cid="case21_"+uuid.uuid4().hex[:12]; ts=now()
        c.execute("INSERT INTO v121_support_cases VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)",(cid,oid,o["customer_id"],"open",category,priority,subject,desc,0,0,_v121_sla_due(priority),None,None,ts,ts,None,None))
        c.execute("INSERT INTO v121_support_messages VALUES (?,?,?,?,?,?)",("msg21_"+uuid.uuid4().hex[:12],cid,u["id"],u["role"],desc or subject,ts))
        emit(c,oid,"support_case_created",{"case_id":cid,"category":category,"priority":priority,"schema_version":"1.21"},u["id"]); c.commit()
        return {"schema_version":"1.21","case_id":cid,"status":"open","sla_due_at":_v121_sla_due(priority)}


@app.get("/api/v121/support/cases/{case_id}")
def v121_case_get(case_id:str, authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization)
    with core_db_connect() as c:
        case=_v121_case_scope(c,case_id,u)
        msgs=c.execute("SELECT * FROM v121_support_messages WHERE case_id=? ORDER BY created_at",(case_id,)).fetchall()
        disputes=c.execute("SELECT * FROM v121_disputes WHERE case_id=? ORDER BY created_at",(case_id,)).fetchall()
        return {"schema_version":"1.21","case":dict(case),"messages":[dict(x) for x in msgs],"disputes":[dict(x) for x in disputes]}


@app.post("/api/v121/support/cases/{case_id}/message")
def v121_case_message(case_id:str, body:dict[str,Any], authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"customer","merchant","admin","ops_agent"})
    text=str(body.get("body","")).strip()[:4000]
    if not text: raise HTTPException(400,"Zpráva je povinná")
    with core_db_connect() as c:
        case=_v121_case_scope(c,case_id,u)
        if case["status"] in {"closed"}: raise HTTPException(409,"Case je uzavřený")
        mid="msg21_"+uuid.uuid4().hex[:12]; ts=now()
        c.execute("INSERT INTO v121_support_messages VALUES (?,?,?,?,?,?)",(mid,case_id,u["id"],u["role"],text,ts))
        c.execute("UPDATE v121_support_cases SET updated_at=? WHERE id=?",(ts,case_id)); c.commit()
        return {"schema_version":"1.21","message_id":mid,"case_id":case_id,"status":case["status"]}


@app.post("/api/v121/support/cases/{case_id}/triage")
def v121_case_triage(case_id:str, body:dict[str,Any], authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    status=str(body.get("status","in_progress")); priority=str(body.get("priority","normal")); assignee=str(body.get("assigned_to",u["id"]))
    if status not in {"in_progress","waiting_customer","waiting_merchant","resolved"}: raise HTTPException(400,"Neplatný status")
    if priority not in {"low","normal","high","urgent"}: raise HTTPException(400,"Neplatná priorita")
    with core_db_connect() as c:
        case=_v121_case_scope(c,case_id,u); ts=now(); resolved=ts if status=="resolved" else case["resolved_at"]
        c.execute("UPDATE v121_support_cases SET status=?,priority=?,assigned_to=?,updated_at=?,resolved_at=? WHERE id=?",(status,priority,assignee,ts,resolved,case_id)); c.commit()
        return {"schema_version":"1.21","case_id":case_id,"status":status,"priority":priority,"assigned_to":assignee}


@app.post("/api/v121/support/cases/{case_id}/dispute")
def v121_dispute_create(case_id:str, body:dict[str,Any], authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"customer","merchant","admin","ops_agent"})
    reason=str(body.get("reason_code","other")); amount=round(float(body.get("amount_czk",0) or 0),2)
    if reason not in {"missing_item","wrong_item","quality","late_delivery","payment","other"}: raise HTTPException(400,"Neplatný dispute reason")
    with core_db_connect() as c:
        case=_v121_case_scope(c,case_id,u)
        existing=c.execute("SELECT * FROM v121_disputes WHERE case_id=? AND status='open'",(case_id,)).fetchone()
        if existing: return {"schema_version":"1.21","dispute":dict(existing),"deduplicated":True}
        d="disp21_"+uuid.uuid4().hex[:12]; ts=now()
        c.execute("INSERT INTO v121_disputes VALUES (?,?,?,?,?,?,?,?,?,?)",(d,case_id,case["order_id"],reason,"open",max(0,amount),None,None,ts,None));
        c.execute("UPDATE v121_support_cases SET status='in_progress',refund_requested_czk=MAX(refund_requested_czk,?),updated_at=? WHERE id=?",(max(0,amount),ts,case_id)); c.commit()
        return {"schema_version":"1.21","dispute_id":d,"status":"open","amount_czk":max(0,amount)}


@app.post("/api/v121/support/cases/{case_id}/resolve")
def v121_case_resolve(case_id:str, body:dict[str,Any], authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    resolution=str(body.get("resolution_code","resolved")); approve=round(float(body.get("refund_approved_czk",0) or 0),2)
    if approve<0: raise HTTPException(400,"Refund nemůže být záporný")
    with core_db_connect() as c:
        case=_v121_case_scope(c,case_id,u); snap=_v120_finance_snapshot(c,case["order_id"])
        if approve>snap["refundable_czk"]+0.01: raise HTTPException(409,"Schválený refund převyšuje refundable částku")
        ts=now()
        c.execute("UPDATE v121_support_cases SET status='resolved',resolution_code=?,refund_approved_czk=?,updated_at=?,resolved_at=? WHERE id=?",(resolution,approve,ts,ts,case_id))
        for d in c.execute("SELECT id FROM v121_disputes WHERE case_id=? AND status='open'",(case_id,)).fetchall():
            c.execute("UPDATE v121_disputes SET status='resolved',decision_code=?,decided_by=?,decided_at=? WHERE id=?",("refund_approved" if approve else resolution,u["id"],ts,d["id"]))
        c.commit(); return {"schema_version":"1.21","case_id":case_id,"status":"resolved","resolution_code":resolution,"refund_approved_czk":approve,"refundable_remaining_czk":snap["refundable_czk"]}


@app.post("/api/v121/support/cases/{case_id}/close")
def v121_case_close(case_id:str, authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent","customer"})
    with core_db_connect() as c:
        case=_v121_case_scope(c,case_id,u)
        if case["status"]!="resolved": raise HTTPException(409,"Case musí být nejdřív resolved")
        ts=now(); c.execute("UPDATE v121_support_cases SET status='closed',updated_at=?,closed_at=? WHERE id=?",(ts,ts,case_id)); c.commit()
        return {"schema_version":"1.21","case_id":case_id,"status":"closed"}


@app.get("/api/v121/support/queue")
def v121_support_queue(authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    with core_db_connect() as c:
        rows=c.execute("SELECT * FROM v121_support_cases WHERE status NOT IN ('closed') ORDER BY CASE priority WHEN 'urgent' THEN 1 WHEN 'high' THEN 2 WHEN 'normal' THEN 3 ELSE 4 END,sla_due_at LIMIT 200").fetchall()
        overdue=[dict(x) for x in rows if x["sla_due_at"] and x["sla_due_at"]<now() and x["status"] not in {"resolved"}]
        return {"schema_version":"1.21","count":len(rows),"overdue_count":len(overdue),"cases":[dict(x) for x in rows]}


@app.get("/frontend_v029/support_v121.html")
def v121_support_page():
    return FileResponse(BASE.parent / "frontend_v029" / "support_v121.html")


# ---------------------------------------------------------------------------
# WUNOO v1.22 — notifications & real-time event engine
# ---------------------------------------------------------------------------

def migrate_v122(c):
    c.execute("""CREATE TABLE IF NOT EXISTS v122_event_outbox(
        id TEXT PRIMARY KEY,
        event_key TEXT NOT NULL UNIQUE,
        order_id TEXT,
        event_type TEXT NOT NULL,
        actor_user_id TEXT,
        payload_json TEXT NOT NULL,
        created_at TEXT NOT NULL,
        processed_at TEXT
    )""")
    c.execute("""CREATE TABLE IF NOT EXISTS v122_notification_deliveries(
        id TEXT PRIMARY KEY,
        event_id TEXT NOT NULL,
        user_id TEXT NOT NULL,
        channel TEXT NOT NULL,
        status TEXT NOT NULL DEFAULT 'queued',
        attempts INTEGER NOT NULL DEFAULT 0,
        provider_ref TEXT,
        last_error TEXT,
        created_at TEXT NOT NULL,
        sent_at TEXT,
        UNIQUE(event_id,user_id,channel)
    )""")
    c.execute("""CREATE TABLE IF NOT EXISTS v122_notification_preferences(
        user_id TEXT NOT NULL,
        channel TEXT NOT NULL,
        enabled INTEGER NOT NULL DEFAULT 1,
        PRIMARY KEY(user_id,channel)
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_v122_outbox_created ON v122_event_outbox(created_at,id)")
    c.execute("CREATE INDEX IF NOT EXISTS idx_v122_delivery_queue ON v122_notification_deliveries(status,created_at)")
    c.execute("CREATE INDEX IF NOT EXISTS idx_v122_delivery_user ON v122_notification_deliveries(user_id,created_at)")
    c.commit()


def _v122_json(value):
    import json
    return json.dumps(value or {}, sort_keys=True, ensure_ascii=False, default=str)


def _v122_event_key(order_id, event_type, payload):
    raw=f"{order_id or ''}|{event_type}|{_v122_json(payload)}"
    return hashlib.sha256(raw.encode()).hexdigest()


def _v122_recipients(c, order_id, event_type, actor_user_id=None):
    ids=set()
    if order_id:
        o=c.execute("SELECT * FROM orders WHERE id=?",(order_id,)).fetchone()
        if o:
            if o["customer_id"]:
                r=c.execute("SELECT id FROM users WHERE customer_id=? AND active=1 ORDER BY id LIMIT 1",(o["customer_id"],)).fetchone()
                if r: ids.add(r["id"])
            if o["merchant_id"]:
                r=c.execute("SELECT id FROM users WHERE merchant_id=? AND active=1 ORDER BY id LIMIT 1",(o["merchant_id"],)).fetchone()
                if r: ids.add(r["id"])
            if o["courier_id"]:
                r=c.execute("SELECT id FROM users WHERE courier_id=? AND active=1 ORDER BY id LIMIT 1",(o["courier_id"],)).fetchone()
                if r: ids.add(r["id"])
    # Operational failures/support/finance alerts also go to ops.
    if event_type in {"delivery_exception_opened","promise_breach","order_redispatch_requested","support_case_created","finance_refund_completed","finance_payouts_completed"}:
        rows=c.execute("SELECT id FROM users WHERE role IN ('admin','ops_agent') AND active=1").fetchall()
        ids.update(r["id"] for r in rows)
    if actor_user_id: ids.discard(actor_user_id)
    return ids


def _v122_template(event_type, payload):
    mapping={
        "merchant_accepted":("Objednávka potvrzena","Restaurace přijala objednávku."),
        "merchant_ready":("Objednávka je připravena","Objednávka je připravena k vyzvednutí."),
        "courier_assigned":("Kurýr přiřazen","K objednávce byl přiřazen kurýr."),
        "pickup_completed":("Objednávka vyzvednuta","Kurýr objednávku vyzvedl."),
        "out_for_delivery_started":("Kurýr je na cestě","Objednávka je na cestě."),
        "delivery_completed":("Objednávka doručena","Objednávka byla doručena."),
        "support_case_created":("Nový support případ","Byl vytvořen nový zákaznický support případ."),
        "finance_refund_completed":("Refund dokončen","Refundace byla zpracována."),
        "order_redispatch_requested":("Hledáme nového kurýra","Doručení bylo předáno k novému přiřazení."),
        "delivery_exception_opened":("Problém s doručením","U objednávky byl zaznamenán problém."),
        "promise_breach":("Doručení se zpožďuje","Objednávka překročila slíbený čas."),
    }
    return mapping.get(event_type,(event_type.replace('_',' ').title(),"Došlo k aktualizaci objednávky."))


def _v122_enqueue_event_outbox(c, order_id, event_type, payload=None, actor_user_id=None):
    key=_v122_event_key(order_id,event_type,payload)
    eid="evt22_"+uuid.uuid4().hex[:12]
    try:
        c.execute("INSERT INTO v122_event_outbox VALUES (?,?,?,?,?,?,?,?)",
                  (eid,key,order_id,event_type,actor_user_id,_v122_json(payload),now(),None))
    except sqlite3.IntegrityError:
        return None
    return eid


def _v122_pref_enabled(c, user_id, channel):
    r=c.execute("SELECT enabled FROM v122_notification_preferences WHERE user_id=? AND channel=?",(user_id,channel)).fetchone()
    if r is not None: return bool(r["enabled"])
    # In-app and email are on by default; SMS is explicit opt-in.
    return channel in {"in_app","email"}


def _v122_queue_deliveries(c, limit=100):
    import json
    rows=c.execute("SELECT * FROM v122_event_outbox WHERE processed_at IS NULL ORDER BY created_at,id LIMIT ?",(limit,)).fetchall()
    queued=[]
    for ev in rows:
        payload=json.loads(ev["payload_json"] or "{}")
        for uid in _v122_recipients(c,ev["order_id"],ev["event_type"],ev["actor_user_id"]):
            title,body=_v122_template(ev["event_type"],payload)
            for channel in ("in_app","email","sms"):
                if not _v122_pref_enabled(c,uid,channel):
                    continue
                did="del22_"+uuid.uuid4().hex[:12]
                try:
                    c.execute("INSERT INTO v122_notification_deliveries VALUES (?,?,?,?,?,?,?,?,?,?)",
                              (did,ev["id"],uid,channel,"queued",0,None,None,now(),None))
                    queued.append(did)
                except sqlite3.IntegrityError:
                    pass
        c.execute("UPDATE v122_event_outbox SET processed_at=? WHERE id=?",(now(),ev["id"]))
    c.commit()
    return queued


def _v122_process_deliveries(c, limit=200):
    rows=c.execute("SELECT * FROM v122_notification_deliveries WHERE status IN ('queued','retry') ORDER BY created_at,id LIMIT ?",(limit,)).fetchall()
    sent=[]; failed=[]
    for d in rows:
        try:
            # Provider adapters are deliberately deterministic in MVP/demo. The
            # contract is channel-neutral, so real email/SMS providers can replace this layer.
            attempt=int(d["attempts"])+1
            pref=c.execute("SELECT enabled FROM v122_notification_preferences WHERE user_id=? AND channel=?",(d["user_id"],d["channel"])).fetchone()
            if pref is not None and not pref["enabled"]:
                c.execute("UPDATE v122_notification_deliveries SET status='cancelled',attempts=?,last_error=NULL WHERE id=?",(attempt,d["id"]))
                continue
            provider=f"demo:{d['channel']}:{d['id']}"
            c.execute("UPDATE v122_notification_deliveries SET status='sent',attempts=?,provider_ref=?,sent_at=?,last_error=NULL WHERE id=?",
                      (attempt,provider,now(),d["id"]))
            # v1.22 keeps its own durable in-app inbox in the delivery table;
            # this avoids coupling to multiple legacy notifications schemas.
            sent.append(d["id"])
        except Exception as exc:
            attempts=int(d["attempts"])+1; status="dead" if attempts>=3 else "retry"
            c.execute("UPDATE v122_notification_deliveries SET status=?,attempts=?,last_error=? WHERE id=?",(status,attempts,str(exc),d["id"]))
            failed.append({"id":d["id"],"status":status,"error":str(exc)})
    c.commit()
    return {"sent":sent,"failed":failed}


@app.post("/api/v122/events/publish")
def v122_publish_event(body:dict[str,Any], authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    order_id=body.get("order_id"); event_type=str(body.get("event_type","")).strip(); payload=body.get("payload") or {}
    if not event_type: raise HTTPException(400,"event_type je povinný")
    with core_db_connect() as c:
        if order_id and not c.execute("SELECT 1 FROM orders WHERE id=?",(order_id,)).fetchone(): raise HTTPException(404,"Objednávka nenalezena")
        eid=_v122_enqueue_event_outbox(c,order_id,event_type,payload,u["id"])
        c.commit()
        return {"schema_version":"1.22","event_id":eid,"deduplicated":eid is None,"event_type":event_type,"order_id":order_id}


@app.post("/api/v122/jobs/process")
def v122_process_notifications(authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    with core_db_connect() as c:
        queued=_v122_queue_deliveries(c,200)
        result=_v122_process_deliveries(c,300)
        return {"schema_version":"1.22","queued_count":len(queued),**result}


@app.get("/api/v122/jobs")
def v122_notification_jobs(status:str|None=None, authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    with core_db_connect() as c:
        if status:
            rows=c.execute("SELECT * FROM v122_notification_deliveries WHERE status=? ORDER BY created_at DESC LIMIT 200",(status,)).fetchall()
        else:
            rows=c.execute("SELECT * FROM v122_notification_deliveries ORDER BY created_at DESC LIMIT 200").fetchall()
        return {"schema_version":"1.22","count":len(rows),"deliveries":[dict(x) for x in rows]}


@app.get("/api/v122/inbox")
def v122_inbox(unread_only:bool=False, authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization)
    with core_db_connect() as c:
        q="""SELECT d.id,d.event_id,d.channel,d.status,d.created_at,d.sent_at,e.order_id,e.event_type,e.payload_json
             FROM v122_notification_deliveries d JOIN v122_event_outbox e ON e.id=d.event_id
             WHERE d.user_id=? AND d.channel='in_app' AND d.status='sent'"""
        args=[u["id"]]
        if unread_only:
            q+=" AND NOT EXISTS (SELECT 1 FROM notifications n WHERE n.user_id=d.user_id AND n.order_id=e.order_id AND n.type=e.event_type AND n.created_at=d.sent_at)"
        q+=" ORDER BY d.created_at DESC LIMIT 100"
        rows=c.execute(q,args).fetchall()
        return {"schema_version":"1.22","count":len(rows),"items":[dict(x) for x in rows]}


@app.post("/api/v122/preferences")
def v122_set_preferences(body:dict[str,Any], authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization)
    values=body.get("channels") or {}
    if not isinstance(values,dict): raise HTTPException(400,"channels musí být objekt")
    allowed={"in_app","email","sms"}
    with core_db_connect() as c:
        for channel,val in values.items():
            if channel not in allowed: raise HTTPException(400,"Neplatný channel")
            c.execute("INSERT INTO v122_notification_preferences(user_id,channel,enabled) VALUES (?,?,?) ON CONFLICT(user_id,channel) DO UPDATE SET enabled=excluded.enabled",(u["id"],channel,1 if bool(val) else 0))
        c.commit()
        rows=c.execute("SELECT channel,enabled FROM v122_notification_preferences WHERE user_id=? ORDER BY channel",(u["id"],)).fetchall()
        return {"schema_version":"1.22","channels":{r["channel"]:bool(r["enabled"]) for r in rows}}


@app.get("/api/v122/preferences")
def v122_get_preferences(authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization)
    with core_db_connect() as c:
        rows=c.execute("SELECT channel,enabled FROM v122_notification_preferences WHERE user_id=? ORDER BY channel",(u["id"],)).fetchall()
        current={"in_app":True,"email":True,"sms":False}
        current.update({r["channel"]:bool(r["enabled"]) for r in rows})
        return {"schema_version":"1.22","channels":current}


@app.get("/api/v122/feed")
def v122_feed(after:str|None=None, authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization)
    with core_db_connect() as c:
        q="""SELECT e.id,e.order_id,e.event_type,e.payload_json,e.created_at
             FROM v122_event_outbox e
             WHERE e.order_id IN (SELECT id FROM orders WHERE customer_id=? OR merchant_id IN (SELECT merchant_id FROM users WHERE id=?))
                OR e.order_id IN (SELECT id FROM orders WHERE courier_id IN (SELECT courier_id FROM users WHERE id=?))"""
        args=[u.get("customer_id"),u["id"],u["id"]]
        if after:
            q+=" AND e.created_at>?"; args.append(after)
        q+=" ORDER BY e.created_at,e.id LIMIT 200"
        rows=c.execute(q,args).fetchall()
        return {"schema_version":"1.22","next_cursor":rows[-1]["created_at"] if rows else after,"events":[dict(x) for x in rows]}


@app.get("/frontend_v029/notifications_v122.html")
def v122_notifications_page():
    return FileResponse(BASE.parent / "frontend_v029" / "notifications_v122.html")


# ---------------------------------------------------------------------------
# WUNOO v1.23 — observability & automated operations
# ---------------------------------------------------------------------------
def migrate_v123(c):
    c.execute("""CREATE TABLE IF NOT EXISTS v123_job_runs(
        id TEXT PRIMARY KEY, job_name TEXT NOT NULL, status TEXT NOT NULL,
        started_at TEXT NOT NULL, finished_at TEXT, result_json TEXT NOT NULL DEFAULT '{}',
        error TEXT
    )""")
    c.execute("""CREATE TABLE IF NOT EXISTS v123_alerts(
        id TEXT PRIMARY KEY, fingerprint TEXT NOT NULL UNIQUE, severity TEXT NOT NULL,
        alert_type TEXT NOT NULL, status TEXT NOT NULL DEFAULT 'open',
        message TEXT NOT NULL, first_seen_at TEXT NOT NULL, last_seen_at TEXT NOT NULL,
        occurrences INTEGER NOT NULL DEFAULT 1, resolved_at TEXT
    )""")
    c.execute("""CREATE TABLE IF NOT EXISTS v123_incidents(
        id TEXT PRIMARY KEY, alert_id TEXT, severity TEXT NOT NULL, status TEXT NOT NULL DEFAULT 'open',
        title TEXT NOT NULL, summary TEXT NOT NULL, opened_at TEXT NOT NULL, closed_at TEXT,
        correlation_id TEXT
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_v123_jobs_started ON v123_job_runs(started_at,id)")
    c.execute("CREATE INDEX IF NOT EXISTS idx_v123_alerts_status ON v123_alerts(status,last_seen_at)")
    c.execute("CREATE INDEX IF NOT EXISTS idx_v123_incidents_status ON v123_incidents(status,opened_at)")
    c.commit()


def _v123_record_job(c, name, fn):
    jid='job23_'+uuid.uuid4().hex[:12]; started=now()
    c.execute("INSERT INTO v123_job_runs(id,job_name,status,started_at,result_json) VALUES(?,?,?,?,?)",(jid,name,'running',started,'{}'))
    try:
        result=fn(c) or {}; finished=now()
        c.execute("UPDATE v123_job_runs SET status='success',finished_at=?,result_json=? WHERE id=?",(finished,_v122_json(result),jid))
        c.commit(); return {'id':jid,'status':'success','result':result}
    except Exception as exc:
        c.execute("UPDATE v123_job_runs SET status='failed',finished_at=?,error=? WHERE id=?",(now(),str(exc),jid)); c.commit()
        raise


def _v123_upsert_alert(c, alert_type, fingerprint, severity, message):
    ts=now(); row=c.execute("SELECT * FROM v123_alerts WHERE fingerprint=?",(fingerprint,)).fetchone()
    if row:
        c.execute("UPDATE v123_alerts SET severity=?,message=?,last_seen_at=?,occurrences=occurrences+1,status='open',resolved_at=NULL WHERE id=?",(severity,message,ts,row['id']))
        return row['id'], False
    aid='al23_'+uuid.uuid4().hex[:12]
    c.execute("INSERT INTO v123_alerts VALUES(?,?,?,?,?,?,?,?,?,?)",(aid,fingerprint,severity,alert_type,'open',message,ts,ts,1,None))
    return aid, True


def _v123_health_scan(c):
    checks={}
    t=time.perf_counter(); c.execute('SELECT 1').fetchone(); checks['database']={'status':'healthy','latency_ms':round((time.perf_counter()-t)*1000,3)}
    # Queue pressure: old unsent notification work is operationally actionable.
    q=c.execute("SELECT COUNT(*) n FROM v122_notification_deliveries WHERE status IN ('queued','retry')").fetchone()['n']
    dead=c.execute("SELECT COUNT(*) n FROM v122_notification_deliveries WHERE status='dead'").fetchone()['n']
    checks['notification_queue']={'status':'unhealthy' if q>500 else 'healthy','queued':int(q),'dead':int(dead)}
    # Financial exceptions from v1.20 integrity records when present.
    fin=0
    try:
        cols=[r['name'] for r in c.execute("PRAGMA table_info(v120_finance_exceptions)").fetchall()]
        if cols: fin=int(c.execute("SELECT COUNT(*) n FROM v120_finance_exceptions WHERE status IN ('open','unresolved')").fetchone()['n'])
    except Exception: pass
    checks['finance_exceptions']={'status':'unhealthy' if fin else 'healthy','open':fin}
    overall='healthy' if all(x['status']=='healthy' for x in checks.values()) else 'degraded'
    return {'status':overall,'checks':checks,'scanned_at':now()}


def _v123_alert_scan(c):
    health=_v123_health_scan(c); created=[]
    for name,check in health['checks'].items():
        if check['status']!='healthy':
            severity='critical' if name=='database' else 'high'
            aid,new=_v123_upsert_alert(c,'health_degraded',f'health:{name}',severity,f'{name} is degraded')
            if new: created.append(aid)
    # Detect delivery backlog age.
    row=c.execute("SELECT MIN(created_at) oldest FROM v122_notification_deliveries WHERE status IN ('queued','retry')").fetchone()
    if row and row['oldest'] and row['oldest'] < datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%S'):
        # Only a count-based alert is actionable here; avoid assuming timezone semantics.
        q=c.execute("SELECT COUNT(*) n FROM v122_notification_deliveries WHERE status IN ('queued','retry')").fetchone()['n']
        if q>100:
            aid,new=_v123_upsert_alert(c,'notification_backlog','notifications:backlog','high',f'Notification backlog is {q} deliveries')
            if new: created.append(aid)
    c.commit(); return {'health':health,'new_alerts':created}


@app.get('/api/v123/ops/health')
def v123_ops_health(authorization:str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c: return {'schema_version':'1.23',**_v123_health_scan(c)}


@app.post('/api/v123/ops/jobs/run')
def v123_run_jobs(body:dict[str,Any]|None=None, authorization:str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    body=body or {}; requested=str(body.get('job','health_scan'))
    allowed={'health_scan','alert_scan','notification_process'}
    if requested not in allowed: raise HTTPException(400,'Neplatný job')
    with core_db_connect() as c:
        if requested=='health_scan': return {'schema_version':'1.23',**_v123_record_job(c,requested,_v123_health_scan)}
        if requested=='alert_scan': return {'schema_version':'1.23',**_v123_record_job(c,requested,_v123_alert_scan)}
        def run_notifications(cx):
            queued=_v122_queue_deliveries(cx,200); processed=_v122_process_deliveries(cx,300)
            return {'queued_count':len(queued),**processed}
        return {'schema_version':'1.23',**_v123_record_job(c,requested,run_notifications)}


@app.get('/api/v123/ops/jobs')
def v123_jobs(authorization:str|None=Header(default=None)):
