# ---------------- v1.35 Legacy SQLite Request-Layer Elimination ----------------
def _v136_ensure_baselines():
    """Create one-time live baseline snapshots for existing merchants during cutover."""
    with closing(conn()) as c:
        c.execute("CREATE TABLE IF NOT EXISTS merchant_menu_publications(id TEXT PRIMARY KEY,merchant_id TEXT NOT NULL,publication_no INTEGER NOT NULL,snapshot_sha256 TEXT NOT NULL,snapshot_json TEXT NOT NULL,status TEXT NOT NULL,created_at TEXT NOT NULL,actor_user_id TEXT,UNIQUE(merchant_id,publication_no),UNIQUE(merchant_id,snapshot_sha256))")
        c.execute("CREATE TABLE IF NOT EXISTS merchant_menu_publish_audit(id TEXT PRIMARY KEY,merchant_id TEXT NOT NULL,publication_id TEXT NOT NULL,action TEXT NOT NULL,snapshot_sha256 TEXT NOT NULL,actor_user_id TEXT,created_at TEXT NOT NULL)")
        merchants=c.execute("SELECT id FROM merchants WHERE active=1").fetchall()
        for mr in merchants:
            mid=mr[0]
            if c.execute("SELECT 1 FROM merchant_menu_publications WHERE merchant_id=? LIMIT 1",(mid,)).fetchone(): continue
            active=c.execute("SELECT COUNT(*) FROM menu_items WHERE merchant_id=? AND active=1",(mid,)).fetchone()[0]
            if not active: continue
            cats=c.execute("SELECT id,name,sort_order,active FROM menu_categories WHERE merchant_id=? ORDER BY sort_order,name,id",(mid,)).fetchall()
            items=c.execute("SELECT id,name,description,price_czk,currency,active,category_id,display_order,version FROM menu_items WHERE merchant_id=? AND active=1 ORDER BY display_order,name,id",(mid,)).fetchall()
            snap={'schema_version':'1.136','merchant_id':mid,'categories':[dict(x) for x in cats], 'items':[{**dict(x),'availability':{'state':'AVAILABLE','start_at':None,'end_at':None,'reason':None,'version':0}} for x in items]}
            raw=json.dumps(snap,ensure_ascii=False,separators=(',',':'),sort_keys=True); sha=hashlib.sha256(raw.encode()).hexdigest(); pid='pub_'+uuid.uuid4().hex[:12]
            c.execute("INSERT INTO merchant_menu_publications VALUES (?,?,?,?,?,?,?,?)",(pid,mid,1,sha,raw,'LIVE',now(),'system_v136_migration'))
            c.execute("INSERT INTO merchant_menu_publish_audit VALUES (?,?,?,?,?,?,?)",('mpa_'+uuid.uuid4().hex[:12],mid,pid,'BASELINE_MIGRATION',sha,'system_v136_migration',now()))
        c.commit()


def migrate_v136(c):
    """Record DB-neutral request-layer cutovers completed in v1.36."""
    c.execute("""CREATE TABLE IF NOT EXISTS request_layer_cutover_v136(
        id TEXT PRIMARY KEY, route_group TEXT NOT NULL, route_count INTEGER NOT NULL,
        backend TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL,
        UNIQUE(route_group)
    )""")
    # Merchant menu publication boundary. Draft edits live in menu_* tables;
    # customer reads use the immutable latest published snapshot.
    c.execute("""CREATE TABLE IF NOT EXISTS merchant_menu_publications(
        id TEXT PRIMARY KEY, merchant_id TEXT NOT NULL, publication_no INTEGER NOT NULL,
        snapshot_sha256 TEXT NOT NULL, snapshot_json TEXT NOT NULL, status TEXT NOT NULL,
        created_at TEXT NOT NULL, actor_user_id TEXT, UNIQUE(merchant_id, publication_no),
        UNIQUE(merchant_id, snapshot_sha256)
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_menu_publications_live ON merchant_menu_publications(merchant_id,status,publication_no DESC)")
    c.execute("""CREATE TABLE IF NOT EXISTS merchant_menu_publish_audit(
        id TEXT PRIMARY KEY, merchant_id TEXT NOT NULL, publication_id TEXT NOT NULL,
        action TEXT NOT NULL, snapshot_sha256 TEXT NOT NULL, actor_user_id TEXT,
        created_at TEXT NOT NULL
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_menu_publish_audit_merchant ON merchant_menu_publish_audit(merchant_id,created_at DESC)")
    rows = [
        ("customer_core", 12),
        ("catalog_read", 7),
        ("ops_dashboard_health", 2),
    ]
    backend = configured_db_backend()
    for group, count in rows:
        exists = c.execute("SELECT 1 AS n FROM request_layer_cutover_v136 WHERE route_group=?", (group,)).fetchone()
        if not exists:
            c.execute("""INSERT INTO request_layer_cutover_v136
                (id,route_group,route_count,backend,status,created_at) VALUES (?,?,?,?,?,?)""",
                ("v136_" + group, group, count, backend, "completed", now()))
            try:
                c.execute("""INSERT INTO request_layer_cutover_audit
                    (id,route_group,status,backend,details,created_at) VALUES (?,?,?,?,?,?)""",
                    ("v136_" + group, group, "completed", backend,
                     "DB-neutral request layer cutover", now()))
            except Exception:
                pass
    c.commit()


