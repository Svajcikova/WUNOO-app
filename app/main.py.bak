@app.get("/api/v035/quote")
def v035_quote(merchant_id: str, authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u=current_user(authorization); require_role(u,"customer")
    with core_db_connect() as c:
        m=c.execute("SELECT id,name,lat,lon FROM merchants WHERE id=? AND active=1",(merchant_id,)).fetchone()
        a=c.execute("SELECT lat,lon,label FROM customer_addresses WHERE customer_id=? ORDER BY is_default DESC,created_at DESC LIMIT 1",(u["customer_id"],)).fetchone()
        if not m: raise HTTPException(404,"Restaurace nenalezena")
        if not a or a["lat"] is None or a["lon"] is None:
            return {"merchant_id":merchant_id,"distance_km":None,"delivery_fee_czk":None,"location_required":True}
        distance=round(_v035_haversine(float(a["lat"]),float(a["lon"]),float(m["lat"]),float(m["lon"])),2)
        fee=_v035_delivery_fee(distance)
        return {"merchant_id":merchant_id,"distance_km":distance,"delivery_fee_czk":fee,"delivery_available":fee is not None}

