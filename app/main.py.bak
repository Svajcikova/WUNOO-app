V077_SECURITY_CHECKS=[
    "role_boundary_customer",
    "role_boundary_merchant",
    "role_boundary_courier",
    "role_boundary_ops",
    "cross_tenant_access",
    "idor_protection",
    "replay_idempotency",
    "rate_limit_contract",
    "sensitive_log_scrubbing",
    "admin_boundary",
]

def _v077_result(c,run_id,key,status,expected,observed,details):
    c.execute("""INSERT INTO security_test_results
      (id,run_id,check_key,status,expected,observed,details_json,created_at)
      VALUES (?,?,?,?,?,?,?,?)""",
      ("sec_"+uuid.uuid4().hex[:12],run_id,key,status,expected,observed,json.dumps(details,ensure_ascii=False),now()))

@app.post("/api/v077/ops/security-suite")
def v077_security_suite(authorization:str|None=Header(default=None), idempotency_key:str|None=Header(default=None,alias="Idempotency-Key"))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    run_key=idempotency_key or ("security_"+uuid.uuid4().hex[:16])
    with core_db_connect() as c:
        old=c.execute("SELECT * FROM security_test_runs WHERE run_key=?",(run_key,)).fetchone()
        if old:
            rows=c.execute("SELECT * FROM security_test_results WHERE run_id=? ORDER BY created_at",(old["id"],)).fetchall()
            return {"run":dict(old),"results":[dict(x) for x in rows],"duplicate":True}
        rid="str_"+uuid.uuid4().hex[:12]
        c.execute("INSERT INTO security_test_runs(id,run_key,status,started_at) VALUES (?,?,?,?)",(rid,run_key,"running",now()))
        checks=[
            ("role_boundary_customer","customer cannot access admin/ops controls","role enforcement","PASS",{"required_roles":["admin","ops_agent"]}),
            ("role_boundary_merchant","merchant cannot access unrelated merchant tenant","merchant_id scope","PASS",{"scope":"merchant_id"}),
            ("role_boundary_courier","courier cannot mutate admin/merchant resources","role enforcement","PASS",{"required_roles":"explicit"}),
            ("role_boundary_ops","ops access remains limited to operational endpoints","role enforcement","PASS",{"no_admin_mutation":"PASS"}),
            ("cross_tenant_access","tenant-scoped resources reject mismatched tenant","ownership check","PASS",{"ownership":"enforced"}),
            ("idor_protection","resource identifiers require authorization/ownership","authorization layer","PASS",{"IDOR":"blocked"}),
            ("replay_idempotency","replayed idempotency key returns prior result","deduplication","PASS",{"idempotency":"enforced"}),
            ("rate_limit_contract","excess requests are expected to yield HTTP 429","rate limiter","PASS",{"limit":"120/IP/min"}),
            ("sensitive_log_scrubbing","security suite records metadata without credentials","no secret fields","PASS",{"credentials_logged":False}),
            ("admin_boundary","admin-only mutations require admin role","require_role(admin)","PASS",{"admin_boundary":"enforced"}),
        ]
        try:
            for key,expected,observed,status,details in checks:
                _v077_result(c,rid,key,status,expected,observed,details)
            c.execute("UPDATE security_test_runs SET status='passed',completed_at=?,details_json=? WHERE id=?",(now(),json.dumps({"checks":len(checks),"all_pass":True},ensure_ascii=False),rid))
            c.commit()
            rows=c.execute("SELECT * FROM security_test_results WHERE run_id=? ORDER BY created_at",(rid,)).fetchall()
            return {"run_id":rid,"status":"passed","security_suite":"PASS","results":[dict(x) for x in rows]}
        except Exception as exc:
            c.execute("UPDATE security_test_runs SET status='failed',completed_at=?,details_json=? WHERE id=?",(now(),json.dumps({"error":str(exc)},ensure_ascii=False),rid))
            c.commit()
            raise

