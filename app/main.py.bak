        pv=_v185_verify_epoch(c,prev)
        if not pv['valid']:raise HTTPException(409,pv['reason'])
        fed=_v170_row(c,'production_global_checkpoint_federations',' WHERE id=?',(prev['federation_id'],),'created_at DESC')
        members=_v185_members(c,fed);no=int(prev['epoch_no'])+1;t=now();obj=_v185_epoch_payload(no,fed,prev,members,t);digest=_v185_hash(obj);signer,pub,keyid=_v169_load_signer();sig=base64.b64encode(signer.sign(_v185_json(obj).encode())).decode();eid='gfe_'+uuid.uuid4().hex[:16]
        existing=c.execute('SELECT * FROM production_checkpoint_federation_epochs WHERE predecessor_epoch_id=?',(prev['id'],)).fetchone()
        if existing:return {'schema_version':'1.85','idempotent':True,'epoch':dict(existing),'transition':None,'verification':_v185_verify_epoch(c,existing)}
        c.execute('INSERT INTO production_checkpoint_federation_epochs(id,epoch_no,federation_id,federation_version,federation_sha256,predecessor_epoch_id,predecessor_epoch_sha256,member_snapshot_json,epoch_json,epoch_sha256,algorithm,signer_key_id,public_key_b64,signature_b64,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(eid,no,fed['id'],fed['federation_version'],fed['federation_sha256'],prev['id'],prev['epoch_sha256'],_v185_json(members),_v185_json(obj),digest,'Ed25519',keyid,base64.b64encode(pub).decode(),sig,'SEALED',t,operator));to=_v170_row(c,'production_checkpoint_federation_epochs',' WHERE id=?',(eid,),'epoch_no DESC');trobj=_v185_transition_payload(prev,to);td=_v185_hash(trobj);ts=base64.b64encode(signer.sign(_v185_json(trobj).encode())).decode();tid='gft_'+uuid.uuid4().hex[:16];c.execute('INSERT INTO production_checkpoint_federation_epoch_transitions(id,from_epoch_id,to_epoch_id,from_epoch_sha256,to_epoch_sha256,transition_json,transition_sha256,algorithm,signer_key_id,public_key_b64,signature_b64,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(tid,prev['id'],to['id'],prev['epoch_sha256'],to['epoch_sha256'],_v185_json(trobj),td,'Ed25519',keyid,base64.b64encode(pub).decode(),ts,'VERIFIED',t,operator));c.commit();return {'schema_version':'1.85','idempotent':False,'epoch':dict(to),'transition':dict(_v170_row(c,'production_checkpoint_federation_epoch_transitions',' WHERE id=?',(tid,),'created_at DESC')),'verification':_v185_chain(c)}
@app.get('/api/v185/ops/federation-epochs/verify')
def v185_verify(authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'})
