        )
        c.commit()


def _recovery_decision(order, latest_location=None):
    """Return a deterministic recovery decision for an active delivery."""
    status = order.get("status")
    delay = order.get("delay_level") or "ON_TIME"
    if status not in {"assigned", "picked_up", "out_for_delivery", "delayed"}:
        return {"action": "NONE", "reason": "order_not_in_delivery"}

    if delay == "CRITICAL":
        return {"action": "REASSIGN", "reason": "critical_eta_breach_risk"}
    if delay == "MATERIAL_DELAY":
        return {"action": "REASSIGN_OR_NOTIFY", "reason": "material_eta_breach_risk"}

    if latest_location:
        deviation = latest_location.get("deviation_ratio")
        stale = latest_location.get("location_stale", False)
        if stale:
            return {"action": "REASSIGN_OR_VERIFY", "reason": "stale_location"}
        if deviation is not None and deviation >= 0.50:
            return {"action": "REASSIGN_OR_VERIFY", "reason": "major_route_deviation"}
    return {"action": "MONITOR", "reason": "within_expected_range"}

def _safe_recovery_message(action, eta):
    if action == "REASSIGN":
        return f"Objednávku přerozdělujeme, aby dorazila co nejdříve. Nový odhad: {eta} min."
    if action == "REASSIGN_OR_NOTIFY":
        return f"Objednávka má zpoždění. Pracujeme na nápravě. Odhad: {eta} min."
    if action == "REASSIGN_OR_VERIFY":
        return f"Prověřujeme průběh doručení. Odhad: {eta} min."
    return None



