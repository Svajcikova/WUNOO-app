@app.post("/api/customer/cart/clear")
def v20_customer_clear_cart(body: dict[str, Any], authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u = current_user(authorization); require_role(u, "customer")
    if body.get("confirm") is not True: raise HTTPException(400, "confirm=true je povinné")
    with core_db_connect() as c:
        count = c.execute("SELECT COUNT(*) n FROM cart_items WHERE customer_id=?", (u["customer_id"],)).fetchone()["n"]
        c.execute("DELETE FROM cart_items WHERE customer_id=?", (u["customer_id"],))
        emit(c, None, "cart_cleared", {"customer_id":u["customer_id"],"items":count}, u["id"]); c.commit()
    return {"cleared": count}

@app.get("/api/customer/order-summary/{order_id}")
def v20_customer_order_summary(order_id: str, authorization: str | None = Header(default=None)) -> dict[str, Any]:
    u = current_user(authorization); require_role(u, "customer")
    with core_db_connect() as c:
        order = c.execute("SELECT * FROM orders WHERE id=? AND customer_id=?", (order_id, u["customer_id"])).fetchone()
        if not order: raise HTTPException(404, "Objednávka nenalezena")
        items = c.execute("SELECT oi.*, mi.name FROM order_items oi LEFT JOIN menu_items mi ON mi.id=oi.menu_item_id WHERE oi.order_id=?", (order_id,)).fetchall()
        events = c.execute("SELECT id,type,payload,actor_user_id,created_at FROM events WHERE order_id=? ORDER BY created_at", (order_id,)).fetchall()
        return {"order":dict(order),"items":[dict(x) for x in items],"events":[dict(x) for x in events]}

