    return {'schema_version':'1.56','found':True,**{k:row[k] for k in row.keys()}}


# ---------------- v1.57 Production Traffic Safety & Automated Rollout Controller ----------------
def migrate_v157(c):
    c.execute("""CREATE TABLE IF NOT EXISTS production_rollout_observations(
        id TEXT PRIMARY KEY, rollout_run_id TEXT NOT NULL, phase TEXT NOT NULL,
        availability_pct REAL NOT NULL, error_rate_pct REAL NOT NULL,
        p95_latency_ms REAL NOT NULL, sample_count INTEGER NOT NULL,
        healthy INTEGER NOT NULL, bad_streak INTEGER NOT NULL DEFAULT 0,
        good_streak INTEGER NOT NULL DEFAULT 0, decision TEXT NOT NULL,
        metrics_json TEXT NOT NULL DEFAULT '{}', operator TEXT, created_at TEXT NOT NULL
    )""")
    c.execute("""CREATE TABLE IF NOT EXISTS production_rollout_decisions(
        id TEXT PRIMARY KEY, rollout_run_id TEXT NOT NULL, from_phase TEXT NOT NULL,
        to_phase TEXT, decision TEXT NOT NULL, reason TEXT NOT NULL,
        decision_sha256 TEXT NOT NULL, metrics_json TEXT NOT NULL DEFAULT '{}',
        operator TEXT, created_at TEXT NOT NULL
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_rollout_obs_run_time ON production_rollout_observations(rollout_run_id, created_at DESC)")
    c.execute("CREATE INDEX IF NOT EXISTS idx_rollout_decisions_run_time ON production_rollout_decisions(rollout_run_id, created_at DESC)")
    try: c.commit()
    except Exception: pass

_V157_THRESHOLDS = {
    'min_availability_pct': 99.5,
    'max_error_rate_pct': 2.0,
    'max_p95_latency_ms': 1500.0,
    'min_sample_count': 20,
    'good_samples_to_promote': 2,
    'bad_samples_to_rollback_recommend': 2,
}

def _v157_evaluate(metrics: dict[str, Any], good_streak: int, bad_streak: int) -> dict[str, Any]:
    availability=float(metrics.get('availability_pct', 0) or 0)
    error_rate=float(metrics.get('error_rate_pct', 100) or 100)
    p95=float(metrics.get('p95_latency_ms', 1e12) or 1e12)
    samples=int(metrics.get('sample_count', 0) or 0)
    healthy=(samples >= _V157_THRESHOLDS['min_sample_count'] and
             availability >= _V157_THRESHOLDS['min_availability_pct'] and
             error_rate <= _V157_THRESHOLDS['max_error_rate_pct'] and
             p95 <= _V157_THRESHOLDS['max_p95_latency_ms'])
    new_good=good_streak+1 if healthy else 0
    new_bad=0 if healthy else bad_streak+1
    if new_bad >= _V157_THRESHOLDS['bad_samples_to_rollback_recommend']:
        decision='ROLLBACK_RECOMMENDED'; reason='consecutive unhealthy observations exceeded hysteresis threshold'
    elif new_good >= _V157_THRESHOLDS['good_samples_to_promote']:
        decision='PROMOTE_CANARY'; reason='consecutive healthy observations satisfied promotion hysteresis'
    elif healthy:
        decision='HOLD_HEALTHY'; reason='healthy but promotion hysteresis is not yet satisfied'
    else:
        decision='HOLD_UNHEALTHY'; reason='unhealthy observation recorded but rollback hysteresis is not yet satisfied'
    return {'healthy':healthy,'good_streak':new_good,'bad_streak':new_bad,'decision':decision,'reason':reason,
            'thresholds':_V157_THRESHOLDS}

def _v157_record_decision(c, run_id, from_phase, to_phase, decision, reason, metrics, operator):
    payload=json.dumps({'run_id':run_id,'from_phase':from_phase,'to_phase':to_phase,'decision':decision,'reason':reason,'metrics':metrics},sort_keys=True,separators=(',',':'))
    digest=hashlib.sha256(payload.encode()).hexdigest()
    did='rdec_'+uuid.uuid4().hex[:16]
    c.execute('INSERT INTO production_rollout_decisions(id,rollout_run_id,from_phase,to_phase,decision,reason,decision_sha256,metrics_json,operator,created_at) VALUES(?,?,?,?,?,?,?,?,?,?)',
              (did,run_id,from_phase,to_phase,decision,reason,digest,json.dumps(metrics,sort_keys=True),operator,now()))
    return did,digest

def _v157_status(run_id: str) -> dict[str, Any]:
    with core_db_connect() as c:
        row=c.execute('SELECT * FROM controlled_rollout_runs WHERE id=?',(run_id,)).fetchone()
        if not row: raise HTTPException(404,'rollout run nenalezen')
        obs=c.execute('SELECT * FROM production_rollout_observations WHERE rollout_run_id=? ORDER BY created_at DESC LIMIT 20',(run_id,)).fetchall()
        dec=c.execute('SELECT * FROM production_rollout_decisions WHERE rollout_run_id=? ORDER BY created_at DESC LIMIT 20',(run_id,)).fetchall()
    return {'schema_version':'1.57','run':dict(row),'observations':[dict(x) for x in obs],'decisions':[dict(x) for x in dec],
            'policy':{'hysteresis':True,'traffic_shift_external':True,'automatic_traffic_rollback':False}}

@app.get('/api/v157/ops/traffic-controller/policy')
def v157_policy(authorization: str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    return {'schema_version':'1.57','thresholds':_V157_THRESHOLDS,'decision_states':['HOLD_HEALTHY','HOLD_UNHEALTHY','PROMOTE_CANARY','ROLLBACK_RECOMMENDED'],
            'hysteresis':{'good_samples':2,'bad_samples':2},'traffic_controller':'external','automatic_traffic_rollback':False}

@app.post('/api/v157/ops/traffic-controller/{run_id}/observe')
def v157_observe(run_id: str, payload: dict[str,Any], authorization: str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    operator=str(u.get('email') or u.get('id') or 'operator')
    with core_db_connect() as c:
        row=c.execute('SELECT * FROM controlled_rollout_runs WHERE id=?',(run_id,)).fetchone()
        if not row: raise HTTPException(404,'rollout run nenalezen')
        latest=c.execute('SELECT * FROM production_rollout_observations WHERE rollout_run_id=? ORDER BY created_at DESC LIMIT 1',(run_id,)).fetchone()
        good=int(latest['good_streak']) if latest else 0; bad=int(latest['bad_streak']) if latest else 0
        metrics={'availability_pct':payload.get('availability_pct'),'error_rate_pct':payload.get('error_rate_pct'),
                 'p95_latency_ms':payload.get('p95_latency_ms'),'sample_count':payload.get('sample_count')}
        evaluation=_v157_evaluate(metrics,good,bad)
        oid='robs_'+uuid.uuid4().hex[:16]
        c.execute('INSERT INTO production_rollout_observations(id,rollout_run_id,phase,availability_pct,error_rate_pct,p95_latency_ms,sample_count,healthy,bad_streak,good_streak,decision,metrics_json,operator,created_at) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?)',
                  (oid,run_id,row['phase'],float(metrics['availability_pct'] or 0),float(metrics['error_rate_pct'] or 100),float(metrics['p95_latency_ms'] or 1e12),int(metrics['sample_count'] or 0),1 if evaluation['healthy'] else 0,evaluation['bad_streak'],evaluation['good_streak'],evaluation['decision'],json.dumps(metrics,sort_keys=True),operator,now()))
        to_phase=None
        if evaluation['decision']=='PROMOTE_CANARY' and row['phase']=='canary': to_phase='health_window'
        if evaluation['decision']=='PROMOTE_CANARY' and row['phase']=='health_window': to_phase='e2e_verification'
        did,digest=_v157_record_decision(c,run_id,row['phase'],to_phase,evaluation['decision'],evaluation['reason'],metrics,operator)
        c.commit()
    return {'schema_version':'1.57','run_id':run_id,'observation_id':oid,'decision_id':did,'decision_sha256':digest,'phase':row['phase'],'next_phase':to_phase,**evaluation}

@app.post('/api/v157/ops/traffic-controller/{run_id}/decision')
def v157_decision(run_id: str, payload: dict[str,Any], authorization: str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    requested=str(payload.get('decision') or '').upper()
    if requested not in {'HOLD','PROMOTE','ROLLBACK_RECOMMENDED'}: raise HTTPException(422,'decision must be HOLD, PROMOTE, or ROLLBACK_RECOMMENDED')
    operator=str(u.get('email') or u.get('id') or 'operator')
    with core_db_connect() as c:
        row=c.execute('SELECT * FROM controlled_rollout_runs WHERE id=?',(run_id,)).fetchone()
        if not row: raise HTTPException(404,'rollout run nenalezen')
        reason=str(payload.get('reason') or 'operator decision')
        did,digest=_v157_record_decision(c,run_id,row['phase'],None,requested,reason,payload.get('metrics') or {},operator)
        c.commit()
    return {'schema_version':'1.57','run_id':run_id,'decision':requested,'decision_id':did,'decision_sha256':digest,'phase':row['phase']}

@app.get('/api/v157/ops/traffic-controller/{run_id}')
def v157_controller_status(run_id: str, authorization: str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); return _v157_status(run_id)

# ---------------- v1.58 Multi-Window SLO Burn-Rate & Incident Guard ----------------
def migrate_v158(c):
    c.execute("""CREATE TABLE IF NOT EXISTS production_slo_guard_observations(
        id TEXT PRIMARY KEY, rollout_run_id TEXT NOT NULL, phase TEXT NOT NULL,
        short_error_rate_pct REAL NOT NULL, long_error_rate_pct REAL NOT NULL,
        short_burn_rate REAL NOT NULL, long_burn_rate REAL NOT NULL,
        incident_severity TEXT NOT NULL DEFAULT 'none', healthy INTEGER NOT NULL,
        good_streak INTEGER NOT NULL DEFAULT 0, bad_streak INTEGER NOT NULL DEFAULT 0,
        decision TEXT NOT NULL, reason TEXT NOT NULL, metrics_json TEXT NOT NULL DEFAULT '{}',
        operator TEXT, created_at TEXT NOT NULL
    )""")
    c.execute("""CREATE INDEX IF NOT EXISTS idx_slo_guard_run_time
                 ON production_slo_guard_observations(rollout_run_id, created_at DESC)""")
    try: c.commit()
    except Exception: pass

_V158_POLICY = {'slo_target_pct':99.9,'error_budget_pct':0.1,'short_window':'5m','long_window':'60m',
 'short_burn_rollback':14.0,'long_burn_rollback':2.0,'short_burn_hold':6.0,'long_burn_hold':1.0,
 'promotion_good_samples':3,'rollback_bad_samples':2,'severe_incident_levels':['sev1','sev2']}

def _v158_eval(m, good, bad):
    se=float(m.get('short_error_rate_pct',100) or 100); le=float(m.get('long_error_rate_pct',100) or 100)
    sev=str(m.get('incident_severity','none') or 'none').lower(); b=_V158_POLICY['error_budget_pct']
    sb=se/b; lb=le/b; severe=sev in _V158_POLICY['severe_incident_levels']
    rollback=(sb>=_V158_POLICY['short_burn_rollback'] and lb>=_V158_POLICY['long_burn_rollback']) or severe
    hold=(sb>=_V158_POLICY['short_burn_hold'] and lb>=_V158_POLICY['long_burn_hold'])
    healthy=not rollback and not hold; ng=good+1 if healthy else 0; nb=0 if healthy else bad+1
    if rollback and nb>=_V158_POLICY['rollback_bad_samples']: d='ROLLBACK_RECOMMENDED'; reason='multi-window burn-rate or severe incident exceeded rollback guard'
    elif hold: d='HOLD'; reason='SLO burn-rate is elevated; protect the rollout until the window recovers'
    elif ng>=_V158_POLICY['promotion_good_samples']: d='PROMOTE'; reason='multiple healthy SLO windows satisfied promotion guard'
    else: d='HOLD_HEALTHY'; reason='SLO windows healthy but promotion hysteresis is not yet satisfied'
    return {'short_burn_rate':sb,'long_burn_rate':lb,'healthy':healthy,'good_streak':ng,'bad_streak':nb,'decision':d,'reason':reason,'policy':_V158_POLICY}

def _v158_hash(payload): return hashlib.sha256(json.dumps(payload,sort_keys=True,separators=(',',':')).encode()).hexdigest()

@app.get('/api/v158/ops/slo-guard/policy')
def v158_policy(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    return {'schema_version':'1.58','policy':_V158_POLICY,'decision_states':['HOLD_HEALTHY','HOLD','PROMOTE','ROLLBACK_RECOMMENDED'],'traffic_mutation':'external','automatic_rollback':False}

@app.post('/api/v158/ops/slo-guard/{run_id}/observe')
def v158_observe(run_id: str,payload: dict[str,Any],authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); operator=str(u.get('email') or u.get('id') or 'operator')
    with core_db_connect() as c:
        row=c.execute('SELECT * FROM controlled_rollout_runs WHERE id=?',(run_id,)).fetchone()
        if not row: raise HTTPException(404,'rollout run nenalezen')
        latest=c.execute('SELECT * FROM production_slo_guard_observations WHERE rollout_run_id=? ORDER BY created_at DESC LIMIT 1',(run_id,)).fetchone()
        good=int(latest['good_streak']) if latest else 0; bad=int(latest['bad_streak']) if latest else 0
        m={'short_error_rate_pct':payload.get('short_error_rate_pct'),'long_error_rate_pct':payload.get('long_error_rate_pct'),'incident_severity':payload.get('incident_severity','none'),'short_window':payload.get('short_window','5m'),'long_window':payload.get('long_window','60m')}
        ev=_v158_eval(m,good,bad); oid='sloobs_'+uuid.uuid4().hex[:16]
        c.execute('INSERT INTO production_slo_guard_observations(id,rollout_run_id,phase,short_error_rate_pct,long_error_rate_pct,short_burn_rate,long_burn_rate,incident_severity,healthy,good_streak,bad_streak,decision,reason,metrics_json,operator,created_at) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(oid,run_id,row['phase'],float(m['short_error_rate_pct'] or 100),float(m['long_error_rate_pct'] or 100),ev['short_burn_rate'],ev['long_burn_rate'],str(m['incident_severity']),1 if ev['healthy'] else 0,ev['good_streak'],ev['bad_streak'],ev['decision'],ev['reason'],json.dumps(m,sort_keys=True),operator,now()))
        c.commit()
    return {'schema_version':'1.58','run_id':run_id,'observation_id':oid,'evidence_sha256':_v158_hash({'run_id':run_id,'observation_id':oid,'evaluation':ev}),**ev}

@app.get('/api/v158/ops/slo-guard/{run_id}')
def v158_status(run_id: str,authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        row=c.execute('SELECT * FROM controlled_rollout_runs WHERE id=?',(run_id,)).fetchone()
        if not row: raise HTTPException(404,'rollout run nenalezen')
        obs=c.execute('SELECT * FROM production_slo_guard_observations WHERE rollout_run_id=? ORDER BY created_at DESC LIMIT 20',(run_id,)).fetchall()
    return {'schema_version':'1.58','run':dict(row),'observations':[dict(x) for x in obs],'policy':_V158_POLICY}


# ---------------- v1.60 Unified Production Safety Decision Engine ----------------
def migrate_v160(c):
    c.execute("""CREATE TABLE IF NOT EXISTS production_safety_decisions(
        id TEXT PRIMARY KEY, release_version TEXT, rollout_run_id TEXT, deployment_id TEXT,
        decision TEXT NOT NULL, confidence REAL NOT NULL DEFAULT 0, reason TEXT NOT NULL,
        gates_json TEXT NOT NULL DEFAULT '{}', signals_json TEXT NOT NULL DEFAULT '{}',
        evidence_sha256 TEXT NOT NULL, operator TEXT, created_at TEXT NOT NULL
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_safety_decisions_run_time ON production_safety_decisions(rollout_run_id, created_at DESC)")
    c.execute("CREATE INDEX IF NOT EXISTS idx_safety_decisions_release_time ON production_safety_decisions(release_version, created_at DESC)")
    try: c.commit()
    except Exception: pass

_V160_POLICY = {
    'schema_version':'1.60',
    'decision_states':['GO','HOLD','ROLLBACK_RECOMMENDED'],
    'required_gates':['launch_gate','release_binding','e2e','traffic_health','slo','incident_guard','db_integrity'],
    'max_error_rate_pct':2.0,
    'max_p95_latency_ms':1500.0,
    'min_availability_pct':99.5,
    'max_short_burn_rate':6.0,
    'max_long_burn_rate':1.0,
    'critical_severities':['sev1','sev2'],
    'rollback_short_burn_rate':14.0,
    'rollback_long_burn_rate':2.0,
    'min_confidence_for_go':0.90,
    'automatic_traffic_mutation':False,
    'automatic_rollback':False,
}

def _v160_bool(v, default=False):
    if v is None: return default
    if isinstance(v,bool): return v
    return str(v).strip().lower() in {'1','true','yes','pass','passed','ok','go','healthy'}

def _v160_num(v, default=0.0):
    try: return float(v)
    except Exception: return default

def _v160_decide(payload: dict[str,Any]):
    p=_V160_POLICY
    severity=str(payload.get('incident_severity','none') or 'none').lower()
    short_burn=_v160_num(payload.get('short_burn_rate'),0)
    long_burn=_v160_num(payload.get('long_burn_rate'),0)
    error=_v160_num(payload.get('error_rate_pct'),0)
    latency=_v160_num(payload.get('p95_latency_ms'),0)
    availability=_v160_num(payload.get('availability_pct'),100)
    samples=int(_v160_num(payload.get('sample_count'),0))
    critical=severity in p['critical_severities']
    rollback_burn=short_burn >= p['rollback_short_burn_rate'] and long_burn >= p['rollback_long_burn_rate']
    rollback_signal=critical or rollback_burn or _v160_bool(payload.get('rollback_recommended'))
    health_ok=(availability >= p['min_availability_pct'] and error <= p['max_error_rate_pct'] and latency <= p['max_p95_latency_ms'] and samples >= 20)
    slo_ok=(short_burn < p['max_short_burn_rate'] and long_burn < p['max_long_burn_rate'])
    correlation=str(payload.get('correlation_decision','') or '').upper()
    if correlation=='ROLLBACK_RECOMMENDED': rollback_signal=True
    if correlation=='HOLD': slo_ok=False
    gates={
      'launch_gate':_v160_bool(payload.get('launch_gate_pass')),
      'release_binding':_v160_bool(payload.get('release_binding_pass')),
      'e2e':_v160_bool(payload.get('e2e_pass')),
      'traffic_health':health_ok,
      'slo':slo_ok,
      'incident_guard': not critical and correlation not in {'ROLLBACK_RECOMMENDED','HOLD'},
      'db_integrity':_v160_bool(payload.get('db_integrity_pass')),
    }
    failed=[k for k,v in gates.items() if not v]
    if rollback_signal:
        decision='ROLLBACK_RECOMMENDED'; reason='critical incident, rollback burn-rate, or correlated rollback signal'
    elif failed:
        decision='HOLD'; reason='one or more mandatory production safety gates are not satisfied'
    else:
        decision='GO'; reason='all canonical production safety gates are satisfied'
    passed=sum(1 for v in gates.values() if v)
    confidence=round(passed/len(gates),4)
    if decision=='GO' and confidence < p['min_confidence_for_go']:
        decision='HOLD'; reason='canonical gates pass but confidence threshold is not satisfied'
    return {'decision':decision,'confidence':confidence,'reason':reason,'gates':gates,'failed_gates':failed,
            'signals':{'critical_incident':critical,'rollback_burn':rollback_burn,'correlation_decision':correlation,
                       'short_burn_rate':short_burn,'long_burn_rate':long_burn,'error_rate_pct':error,'p95_latency_ms':latency,
                       'availability_pct':availability,'sample_count':samples},'policy':p}

def _v160_hash(payload):
    return hashlib.sha256(json.dumps(payload,sort_keys=True,separators=(',',':')).encode()).hexdigest()

@app.get('/api/v160/ops/safety-engine/policy')
def v160_policy(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    return _V160_POLICY

@app.post('/api/v160/ops/safety-engine/evaluate')
def v160_evaluate(payload: dict[str,Any], authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    operator=str(u.get('email') or u.get('id') or 'operator')
    ev=_v160_decide(payload)
    evidence={'schema_version':'1.60','input':payload,'evaluation':ev}
    digest=_v160_hash(evidence); did='psdec_'+uuid.uuid4().hex[:16]
    with core_db_connect() as c:
        c.execute('INSERT INTO production_safety_decisions(id,release_version,rollout_run_id,deployment_id,decision,confidence,reason,gates_json,signals_json,evidence_sha256,operator,created_at) VALUES(?,?,?,?,?,?,?,?,?,?,?,?)',
                  (did,payload.get('release_version'),payload.get('rollout_run_id'),payload.get('deployment_id'),ev['decision'],ev['confidence'],ev['reason'],json.dumps(ev['gates'],sort_keys=True),json.dumps(ev['signals'],sort_keys=True),digest,operator,now()))
        c.commit()
    return {'schema_version':'1.60','decision_id':did,'evidence_sha256':digest,**ev}

@app.get('/api/v160/ops/safety-engine/latest')
def v160_latest(rollout_run_id: str|None=None, release_version: str|None=None, authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        if rollout_run_id:
            row=c.execute('SELECT * FROM production_safety_decisions WHERE rollout_run_id=? ORDER BY created_at DESC LIMIT 1',(rollout_run_id,)).fetchone()
        elif release_version:
            row=c.execute('SELECT * FROM production_safety_decisions WHERE release_version=? ORDER BY created_at DESC LIMIT 1',(release_version,)).fetchone()
        else:
            row=c.execute('SELECT * FROM production_safety_decisions ORDER BY created_at DESC LIMIT 1').fetchone()
    if not row: raise HTTPException(404,'safety decision nenalezen')
    return {'schema_version':'1.60','decision':dict(row),'policy':_V160_POLICY}

@app.post('/api/v160/ops/safety-engine/{decision_id}/acknowledge')
def v160_acknowledge(decision_id: str,payload: dict[str,Any],authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    requested=str(payload.get('decision','') or '').upper()
    if requested not in {'GO','HOLD','ROLLBACK_RECOMMENDED'}: raise HTTPException(422,'decision must be GO, HOLD, or ROLLBACK_RECOMMENDED')
    if requested=='GO' and not _v160_bool(payload.get('operator_confirmed')): raise HTTPException(409,'operator_confirmed required for GO')
    operator=str(u.get('email') or u.get('id') or 'operator')
    with core_db_connect() as c:
        row=c.execute('SELECT * FROM production_safety_decisions WHERE id=?',(decision_id,)).fetchone()
        if not row: raise HTTPException(404,'safety decision nenalezen')
        if requested=='GO' and row['decision']=='ROLLBACK_RECOMMENDED': raise HTTPException(409,'cannot acknowledge GO over rollback recommendation')
        ack={'decision_id':decision_id,'requested':requested,'operator_confirmed':True,'operator':operator,'reason':payload.get('reason','operator acknowledgement')}
        digest=_v160_hash(ack)
        c.execute('UPDATE production_safety_decisions SET operator=? WHERE id=?',(operator,decision_id)); c.commit()
    return {'schema_version':'1.60','decision_id':decision_id,'acknowledged_decision':requested,'ack_sha256':digest}


# ---------------- v1.59 Incident Correlation & Release Safety Orchestrator ----------------
def migrate_v159(c):
    c.execute("""CREATE TABLE IF NOT EXISTS production_incident_correlations(
        id TEXT PRIMARY KEY, rollout_run_id TEXT, deployment_id TEXT, release_version TEXT,
        severity TEXT NOT NULL DEFAULT 'none', classification TEXT NOT NULL,
        confidence REAL NOT NULL DEFAULT 0, decision TEXT NOT NULL,
        correlation_json TEXT NOT NULL DEFAULT '{}', evidence_sha256 TEXT NOT NULL,
        operator TEXT, created_at TEXT NOT NULL
    )""")
    c.execute("""CREATE TABLE IF NOT EXISTS production_release_safety_decisions(
        id TEXT PRIMARY KEY, correlation_id TEXT NOT NULL, decision TEXT NOT NULL,
        reason TEXT NOT NULL, decision_sha256 TEXT NOT NULL, checks_json TEXT NOT NULL DEFAULT '{}',
        operator TEXT, created_at TEXT NOT NULL
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_incident_corr_run_time ON production_incident_correlations(rollout_run_id, created_at DESC)")
    c.execute("CREATE INDEX IF NOT EXISTS idx_release_safety_corr_time ON production_release_safety_decisions(correlation_id, created_at DESC)")
    try: c.commit()
    except Exception: pass

_V159_POLICY = {
    'correlation_window_minutes': 30,
    'critical_severities': ['sev1','sev2'],
    'release_causality_threshold': 0.70,
    'hold_confidence_threshold': 0.45,
    'rollback_signal_threshold': 0.80,
    'required_independent_signals': 2,
    'decision_states': ['PROMOTE','HOLD','ROLLBACK_RECOMMENDED','INSUFFICIENT_EVIDENCE'],
    'automatic_traffic_mutation': False,
    'automatic_rollback': False,
}

def _v159_num(x, default=0.0):
    try: return float(x)
    except Exception: return default

def _v159_correlate(payload: dict[str,Any]):
    sev=str(payload.get('incident_severity','none') or 'none').lower()
    deployment_age=_v159_num(payload.get('minutes_since_deploy'), 999999)
    e2e=_v159_num(payload.get('e2e_failure_rate_pct'), 0)
    error=_v159_num(payload.get('error_rate_pct'), 0)
    short_burn=_v159_num(payload.get('short_burn_rate'), 0)
    long_burn=_v159_num(payload.get('long_burn_rate'), 0)
    db_anomaly=bool(payload.get('db_anomaly',False))
    latency_anomaly=bool(payload.get('latency_anomaly',False))
    incident_active=sev in _V159_POLICY['critical_severities']
    signals=[]
    if deployment_age <= _V159_POLICY['correlation_window_minutes']: signals.append('deployment_proximity')
    if e2e > 0: signals.append('e2e_failure')
    if error > 0: signals.append('error_rate')
    if short_burn >= 6 or long_burn >= 1: signals.append('slo_burn')
    if db_anomaly: signals.append('database_anomaly')
    if latency_anomaly: signals.append('latency_anomaly')
    release_signal_count=sum(x in signals for x in ['deployment_proximity','e2e_failure','error_rate','slo_burn'])
    independent=min(len(set(signals)),6)
    confidence=0.0
    if deployment_age <= 30: confidence += .25
    if e2e > 0: confidence += .20
    if error >= 2: confidence += .15
    if short_burn >= 14 and long_burn >= 2: confidence += .25
    elif short_burn >= 6 and long_burn >= 1: confidence += .15
    if db_anomaly: confidence += .10
    if latency_anomaly: confidence += .05
    confidence=min(1.0,confidence)
    if incident_active and confidence >= _V159_POLICY['hold_confidence_threshold']:
        classification='release_correlated_critical_incident'
    elif release_signal_count >= 2 and confidence >= _V159_POLICY['release_causality_threshold']:
        classification='likely_release_regression'
    elif independent >= 2:
        classification='multi_signal_operational_anomaly'
    elif independent == 1:
        classification='single_signal_anomaly'
    else:
        classification='insufficient_evidence'
    if incident_active and confidence >= _V159_POLICY['rollback_signal_threshold']:
        decision='ROLLBACK_RECOMMENDED'
    elif confidence >= _V159_POLICY['hold_confidence_threshold'] or independent >= 2:
        decision='HOLD'
    elif independent >= _V159_POLICY['required_independent_signals']:
        decision='HOLD'
    elif not signals:
        decision='INSUFFICIENT_EVIDENCE'
    else:
        decision='PROMOTE'
    reason=f'{classification}; signals={len(signals)}; confidence={confidence:.2f}'
    return {'classification':classification,'confidence':round(confidence,4),'decision':decision,'reason':reason,'signals':signals,'incident_active':incident_active,'policy':_V159_POLICY}

def _v159_hash(payload):
    return hashlib.sha256(json.dumps(payload,sort_keys=True,separators=(',',':')).encode()).hexdigest()

@app.get('/api/v159/ops/incident-guard/policy')
def v159_policy(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    return {'schema_version':'1.59','policy':_V159_POLICY}

@app.post('/api/v159/ops/incident-guard/correlate')
def v159_correlate(payload: dict[str,Any], authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    operator=str(u.get('email') or u.get('id') or 'operator')
    ev=_v159_correlate(payload)
    evidence={'schema_version':'1.59','input':payload,'evaluation':ev}
    digest=_v159_hash(evidence); cid='icorr_'+uuid.uuid4().hex[:16]
    with core_db_connect() as c:
        c.execute('INSERT INTO production_incident_correlations(id,rollout_run_id,deployment_id,release_version,severity,classification,confidence,decision,correlation_json,evidence_sha256,operator,created_at) VALUES(?,?,?,?,?,?,?,?,?,?,?,?)',
            (cid,payload.get('rollout_run_id'),payload.get('deployment_id'),payload.get('release_version'),str(payload.get('incident_severity','none')),ev['classification'],ev['confidence'],ev['decision'],json.dumps(evidence,sort_keys=True),digest,operator,now()))
        c.commit()
    return {'schema_version':'1.59','correlation_id':cid,'evidence_sha256':digest,**ev}

@app.post('/api/v159/ops/incident-guard/{correlation_id}/decision')
def v159_decision(correlation_id: str,payload: dict[str,Any],authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); operator=str(u.get('email') or u.get('id') or 'operator')
    requested=str(payload.get('decision','')).upper()
    if requested not in {'PROMOTE','HOLD','ROLLBACK_RECOMMENDED'}: raise HTTPException(422,'decision must be PROMOTE, HOLD, or ROLLBACK_RECOMMENDED')
    with core_db_connect() as c:
        row=c.execute('SELECT * FROM production_incident_correlations WHERE id=?',(correlation_id,)).fetchone()
        if not row: raise HTTPException(404,'correlation nenalezen')
        checks={'correlation_decision':row['decision'],'requested_decision':requested,'operator_confirmed':bool(payload.get('operator_confirmed',False))}
        if requested=='PROMOTE' and row['decision'] in {'HOLD','ROLLBACK_RECOMMENDED'} and not checks['operator_confirmed']:
            return {'schema_version':'1.59','decision':'HOLD','required':'operator_confirmed','checks':checks}
        raw=json.dumps({'correlation_id':correlation_id,'decision':requested,'reason':str(payload.get('reason','operator decision')),'checks':checks},sort_keys=True,separators=(',',':'))
        digest=hashlib.sha256(raw.encode()).hexdigest(); did='rsdec_'+uuid.uuid4().hex[:16]
        c.execute('INSERT INTO production_release_safety_decisions(id,correlation_id,decision,reason,decision_sha256,checks_json,operator,created_at) VALUES(?,?,?,?,?,?,?,?)',(did,correlation_id,requested,str(payload.get('reason','operator decision')),digest,json.dumps(checks,sort_keys=True),operator,now())); c.commit()
    return {'schema_version':'1.59','correlation_id':correlation_id,'decision_id':did,'decision':requested,'decision_sha256':digest}

@app.get('/api/v159/ops/incident-guard/{correlation_id}')
def v159_status(correlation_id: str,authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        row=c.execute('SELECT * FROM production_incident_correlations WHERE id=?',(correlation_id,)).fetchone()
        if not row: raise HTTPException(404,'correlation nenalezen')
        decisions=c.execute('SELECT * FROM production_release_safety_decisions WHERE correlation_id=? ORDER BY created_at DESC LIMIT 20',(correlation_id,)).fetchall()
    return {'schema_version':'1.59','correlation':dict(row),'decisions':[dict(x) for x in decisions],'policy':_V159_POLICY}


# ---------------- v1.61 Production Safety Engine Integration ----------------
def migrate_v161(c):
    c.execute("""CREATE TABLE IF NOT EXISTS production_safety_engine_integrations(
        id TEXT PRIMARY KEY, release_version TEXT, rollout_run_id TEXT, deployment_id TEXT,
        decision TEXT NOT NULL, confidence REAL NOT NULL DEFAULT 0, reason TEXT NOT NULL,
        source_decision_ids_json TEXT NOT NULL DEFAULT '{}', source_snapshot_json TEXT NOT NULL DEFAULT '{}',
        evidence_sha256 TEXT NOT NULL, operator TEXT, created_at TEXT NOT NULL
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_safety_integrations_run_time ON production_safety_engine_integrations(rollout_run_id, created_at DESC)")
    c.execute("CREATE INDEX IF NOT EXISTS idx_safety_integrations_release_time ON production_safety_engine_integrations(release_version, created_at DESC)")
    try: c.commit()
    except Exception: pass

_V161_POLICY = {
    'schema_version':'1.61',
    'canonical_decisions':['GO','HOLD','ROLLBACK_RECOMMENDED'],
    'required_sources':['safety_decision'],
    'source_consistency_required':True,
    'fail_closed':True,
    'automatic_traffic_mutation':False,
    'automatic_rollback':False,
}

def _v161_hash(payload):
    return hashlib.sha256(json.dumps(payload,sort_keys=True,separators=(',',':')).encode()).hexdigest()

def _v161_canonical(source_rows):
    if not source_rows:
        return {'decision':'HOLD','confidence':0.0,'reason':'no canonical safety evidence available','consistent':False}
    decisions=[str(r.get('decision','')).upper() for r in source_rows]
    if 'ROLLBACK_RECOMMENDED' in decisions:
        decision='ROLLBACK_RECOMMENDED'
        reason='a canonical source safety decision recommends rollback'
    elif any(d!='GO' for d in decisions):
        decision='HOLD'
        reason='canonical source decisions are not unanimously GO'
    else:
        decision='GO'
        reason='all supplied canonical safety decisions are GO'
    confidence=round(min(float(r.get('confidence') or 0) for r in source_rows),4)
    consistent=len(set(decisions))==1
    if not consistent and decision=='GO':
        decision='HOLD'; reason='conflicting canonical safety decisions require hold'
    return {'decision':decision,'confidence':confidence,'reason':reason,'consistent':consistent}

@app.get('/api/v161/ops/safety-integration/policy')
def v161_policy(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    return _V161_POLICY

@app.post('/api/v161/ops/safety-integration/evaluate')
def v161_evaluate(payload: dict[str,Any], authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    operator=str(u.get('email') or u.get('id') or 'operator')
    ids=payload.get('decision_ids') or []
    if not isinstance(ids,list) or not ids:
        raise HTTPException(422,'decision_ids must contain at least one v1.60 decision id')
    with core_db_connect() as c:
        rows=[]
        for did in ids:
            row=c.execute('SELECT * FROM production_safety_decisions WHERE id=?',(str(did),)).fetchone()
            if not row: raise HTTPException(404,f'safety decision nenalezen: {did}')
            rows.append(dict(row))
    ev=_v161_canonical(rows)
    # Release/rollout identity is part of the integration boundary; mixed identities are never promoted.
    identities={(r.get('release_version'),r.get('rollout_run_id'),r.get('deployment_id')) for r in rows}
    identity_consistent=len(identities)==1
    if not identity_consistent and ev['decision']=='GO':
        ev['decision']='HOLD'; ev['reason']='source decisions belong to different release/rollout/deployment identities'
    snapshot={'schema_version':'1.61','input':payload,'source_decisions':rows,'evaluation':ev,'identity_consistent':identity_consistent}
    digest=_v161_hash(snapshot); iid='psint_'+uuid.uuid4().hex[:16]
    first=rows[0]
    with core_db_connect() as c:
        c.execute('INSERT INTO production_safety_engine_integrations(id,release_version,rollout_run_id,deployment_id,decision,confidence,reason,source_decision_ids_json,source_snapshot_json,evidence_sha256,operator,created_at) VALUES(?,?,?,?,?,?,?,?,?,?,?,?)',
                  (iid,first.get('release_version'),first.get('rollout_run_id'),first.get('deployment_id'),ev['decision'],ev['confidence'],ev['reason'],json.dumps(ids,sort_keys=True),json.dumps(snapshot,sort_keys=True),digest,operator,now()))
        c.commit()
    return {'schema_version':'1.61','integration_id':iid,'evidence_sha256':digest,'identity_consistent':identity_consistent,'source_decision_ids':ids,**ev}

@app.get('/api/v161/ops/safety-integration/latest')
def v161_latest(release_version: str|None=None, rollout_run_id: str|None=None, authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        if rollout_run_id: row=c.execute('SELECT * FROM production_safety_engine_integrations WHERE rollout_run_id=? ORDER BY created_at DESC LIMIT 1',(rollout_run_id,)).fetchone()
        elif release_version: row=c.execute('SELECT * FROM production_safety_engine_integrations WHERE release_version=? ORDER BY created_at DESC LIMIT 1',(release_version,)).fetchone()
        else: row=c.execute('SELECT * FROM production_safety_engine_integrations ORDER BY created_at DESC LIMIT 1').fetchone()
    if not row: raise HTTPException(404,'safety integration nenalezena')
    return {'schema_version':'1.61','integration':dict(row),'policy':_V161_POLICY}


# ---------------- v1.63 Safety Ledger Reconciliation & Recovery ----------------
def migrate_v163(c):
    c.execute("""CREATE TABLE IF NOT EXISTS production_safety_ledger_reconciliations(
        id TEXT PRIMARY KEY, status TEXT NOT NULL, trusted_sequence_no INTEGER NOT NULL DEFAULT 0,
        trusted_event_hash TEXT, event_count INTEGER NOT NULL DEFAULT 0, error_count INTEGER NOT NULL DEFAULT 0,
        errors_json TEXT NOT NULL DEFAULT '[]', state_hash TEXT NOT NULL, created_at TEXT NOT NULL,
        operator TEXT
    )""")
    c.execute("""CREATE TABLE IF NOT EXISTS production_safety_ledger_recovery_snapshots(
        id TEXT PRIMARY KEY, reconciliation_id TEXT NOT NULL, trusted_sequence_no INTEGER NOT NULL DEFAULT 0,
        state_json TEXT NOT NULL DEFAULT '{}', state_hash TEXT NOT NULL, source_head_hash TEXT,
        recovery_status TEXT NOT NULL DEFAULT 'AVAILABLE', created_at TEXT NOT NULL, operator TEXT
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_safety_recon_time ON production_safety_ledger_reconciliations(created_at DESC)")
    c.execute("CREATE INDEX IF NOT EXISTS idx_safety_recovery_recon ON production_safety_ledger_recovery_snapshots(reconciliation_id)")
    c.execute("CREATE INDEX IF NOT EXISTS idx_safety_recovery_time ON production_safety_ledger_recovery_snapshots(created_at DESC)")
    try: c.commit()
    except Exception: pass

_V163_POLICY = {
    'schema_version':'1.63',
    'append_only_ledger_preserved':True,
    'reconstruct_last_trusted_prefix':True,
    'detect_hash_chain_fork':True,
    'detect_sequence_gap':True,
    'detect_hash_mismatch':True,
    'recovery_is_non_destructive':True,
    'fail_closed_on_corruption':True,
}

def _v163_hash(payload):
    return hashlib.sha256(json.dumps(payload,sort_keys=True,separators=(',',':')).encode()).hexdigest()

def _v163_verify_detailed(c):
    rows=c.execute('SELECT * FROM production_safety_event_ledger ORDER BY sequence_no ASC').fetchall()
    expected=1; prev=None; trusted=0; trusted_hash=None; errors=[]; seen_hashes={}; prefix_intact=True
    for r in rows:
        seq=int(r['sequence_no']); row_errors=[]
        if seq != expected: row_errors.append({'type':'SEQUENCE_GAP','sequence_no':seq,'expected':expected})
        if (r['prev_event_hash'] or None)!=(prev or None): row_errors.append({'type':'CHAIN_BREAK','sequence_no':seq})
        if r['event_hash'] in seen_hashes: row_errors.append({'type':'HASH_FORK_OR_DUPLICATE','sequence_no':seq,'previous_sequence_no':seen_hashes[r['event_hash']]})
        seen_hashes[r['event_hash']]=seq
        try: payload=json.loads(r['payload_json'] or '{}')
        except Exception: payload={}; row_errors.append({'type':'INVALID_PAYLOAD_JSON','sequence_no':seq})
        body={'schema_version':'1.62','sequence_no':seq,'event_type':r['event_type'],'aggregate_type':r['aggregate_type'],'aggregate_id':r['aggregate_id'],'release_version':r['release_version'],'rollout_run_id':r['rollout_run_id'],'deployment_id':r['deployment_id'],'decision':r['decision'],'payload':payload,'prev_event_hash':r['prev_event_hash'],'operator':r['operator']}
        actual=_v162_event_hash(body)
        if actual!=r['event_hash']: row_errors.append({'type':'HASH_MISMATCH','sequence_no':seq})
        errors.extend(row_errors)
        if prefix_intact and seq == expected and not row_errors:
            trusted=seq; trusted_hash=r['event_hash']
        else:
            prefix_intact=False
        prev=r['event_hash']; expected=seq+1
    return {'valid':not errors,'event_count':len(rows),'trusted_sequence_no':trusted,'trusted_event_hash':trusted_hash,'head_sequence':rows[-1]['sequence_no'] if rows else 0,'head_hash':rows[-1]['event_hash'] if rows else None,'errors':errors[:100], 'rows':rows}

def _v163_reconstruct_state(c, trusted_sequence_no):
    rows=c.execute('SELECT * FROM production_safety_event_ledger WHERE sequence_no<=? ORDER BY sequence_no ASC',(int(trusted_sequence_no),)).fetchall()
    aggregates={}
    for r in rows:
        key=f"{r['aggregate_type']}:{r['aggregate_id']}"
        aggregates[key]={
            'aggregate_type':r['aggregate_type'],'aggregate_id':r['aggregate_id'],
            'release_version':r['release_version'],'rollout_run_id':r['rollout_run_id'],
            'deployment_id':r['deployment_id'],'decision':r['decision'],
            'last_event_type':r['event_type'],'last_sequence_no':int(r['sequence_no']),
            'last_event_hash':r['event_hash'],'created_at':r['created_at'],
        }
    state={'schema_version':'1.63','trusted_sequence_no':int(trusted_sequence_no),'aggregates':dict(sorted(aggregates.items()))}
    return state

def _v163_reconcile(c, operator='system'):
    detail=_v163_verify_detailed(c)
    state=_v163_reconstruct_state(c,detail['trusted_sequence_no'])
    state_hash=_v163_hash(state)
    status='HEALTHY' if detail['valid'] else ('CORRUPTED_WITH_TRUSTED_PREFIX' if detail['trusted_sequence_no']>0 else 'CORRUPTED_NO_TRUSTED_PREFIX')
    rid='psrecon_'+uuid.uuid4().hex[:16]
    c.execute('INSERT INTO production_safety_ledger_reconciliations(id,status,trusted_sequence_no,trusted_event_hash,event_count,error_count,errors_json,state_hash,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?)',
              (rid,status,detail['trusted_sequence_no'],detail['trusted_event_hash'],detail['event_count'],len(detail['errors']),json.dumps(detail['errors'],sort_keys=True),state_hash,now(),operator))
    sid='pssnap_'+uuid.uuid4().hex[:16]
    c.execute('INSERT INTO production_safety_ledger_recovery_snapshots(id,reconciliation_id,trusted_sequence_no,state_json,state_hash,source_head_hash,recovery_status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?)',
              (sid,rid,detail['trusted_sequence_no'],json.dumps(state,sort_keys=True),state_hash,detail['head_hash'],'AVAILABLE' if detail['trusted_sequence_no'] else 'NO_TRUSTED_STATE',now(),operator))
    return {'reconciliation_id':rid,'recovery_snapshot_id':sid,'status':status,'trusted_sequence_no':detail['trusted_sequence_no'],'trusted_event_hash':detail['trusted_event_hash'],'event_count':detail['event_count'],'errors':detail['errors'],'state_hash':state_hash,'state':state}

@app.get('/api/v163/ops/safety-ledger/recovery-policy')
def v163_policy(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); return _V163_POLICY

