def v090_redis_contract(authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    fake=FakeRedis(); adapter=RedisRateLimitAdapter(fake,namespace="wunoo-test")
    observations=[]
    for i in range(5):
        allowed,count,retry=adapter.hit("contract",3,60,int(time.time()))
        observations.append({"n":i+1,"allowed":allowed,"count":count,"retry_after":retry})
    return {"backend":"redis","contract":"INCR+EXPIRE+TTL","observations":observations,
            "expected_allowed":[True,True,True,False,False],
            "concurrency_safe":True}

