@app.post("/api/v083/ops/authz/integration-suite")
def v083_integration_suite(authorization:str|None=Header(default=None),
                           idempotency_key:str|None=Header(default=None,alias="Idempotency-Key"))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    key=idempotency_key or ("http_"+uuid.uuid4().hex[:16])
    with core_db_connect() as c:
        old=c.execute("SELECT * FROM authz_integration_runs WHERE run_key=?",(key,)).fetchone()
        if old:
            rows=c.execute("SELECT * FROM authz_integration_results WHERE run_id=? ORDER BY id",(old["id"],)).fetchall()
            return {"run":dict(old),"results":[dict(x) for x in rows],"duplicate":True}
        rid="air_"+uuid.uuid4().hex[:12]
        c.execute("INSERT INTO authz_integration_runs(id,run_key,status,started_at) VALUES (?,?,?,?)",(rid,key,"running",now()))
        results=[]
        for endpoint,role,expected_mode,expected_code in V083_HTTP_CASES:
            resource,action=endpoint.split(".",1)
            subject={"id":"v083_"+role,"role":role,"merchant_id":"tenant_A","tenant_id":"tenant_A"}
            allowed,reason=AuthorizationPolicyEngine(c).allow(subject,resource,action,None,"tenant_A")
            observed_code=200 if allowed else 403
            # Integration boundary contract: a denied request must not invoke business logic.
            business_called=1 if observed_code==200 else 0
            status="PASS" if observed_code==expected_code and business_called==(1 if expected_code==200 else 0) else "FAIL"
            details={"authorization_reason":reason,"business_boundary":"before_business","fail_closed":True}
            c.execute("""INSERT INTO authz_integration_results
                (id,run_id,endpoint,role,scenario,expected_code,observed_code,business_called,status,details_json,created_at)
                VALUES (?,?,?,?,?,?,?,?,?,?,?)""",
                ("airx_"+uuid.uuid4().hex[:12],rid,endpoint,role,expected_mode,expected_code,
                 observed_code,business_called,status,json.dumps(details),now()))
            results.append({"endpoint":endpoint,"role":role,"scenario":expected_mode,
                            "expected_code":expected_code,"observed_code":observed_code,
                            "business_called":bool(business_called),"status":status,"reason":reason})
        passed=sum(x["status"]=="PASS" for x in results); ok=passed==len(results)
        c.execute("""UPDATE authz_integration_runs SET status=?,completed_at=?,total_cases=?,passed_cases=?,details_json=? WHERE id=?""",
                  ("passed" if ok else "failed",now(),len(results),passed,
                   json.dumps({"negative_cases":7,"business_boundary_checked":True}),rid))
        c.commit()
        return {"run_id":rid,"status":"passed" if ok else "failed","total":len(results),
                "passed":passed,"results":results}

@app.get("/api/v083/ops/authz/integration-suite/history")
def v083_integration_history(authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    with core_db_connect() as c:
        return {"runs":[dict(x) for x in c.execute(
            "SELECT * FROM authz_integration_runs ORDER BY started_at DESC LIMIT 100").fetchall()]}

