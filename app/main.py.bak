class AtomicRateLimitStore:
    def __init__(self):
        self._buckets={}
        self._lock=threading.Lock()
    def hit(self,key,limit,window_seconds,now_epoch):
        with self._lock:
            b=self._buckets.get(key)
            if b is None or now_epoch-b["start"]>=window_seconds:
                b={"start":now_epoch,"count":0}; self._buckets[key]=b
            b["count"]+=1
            allowed=b["count"]<=limit
            return allowed,b["count"],max(0,int(window_seconds-(now_epoch-b["start"])))

RATE_LIMIT_STORE=AtomicRateLimitStore()

def rate_limit_check(c,request,route,user=None,limit=60,window_seconds=60):
    epoch=int(time.time()); ip=request.client.host if request.client else "unknown"
    keys=[("ip",ip)]
    if user:
        keys += [("user",str(user.get("id","unknown"))),
                 ("tenant",str(user.get("tenant_id") or user.get("merchant_id") or "unknown"))]
    for scope,key in keys:
        allowed,count,retry=RATE_LIMIT_STORE.hit(f"{scope}:{key}:{route}",limit,window_seconds,epoch)
        c.execute("INSERT INTO rate_limit_events VALUES (?,?,?,?,?,?,?,?,?,?)",
                  ("rle_"+uuid.uuid4().hex[:12],scope,key,route,int(allowed),count,limit,window_seconds,retry,now()))
        if not allowed:
            c.commit()
            raise HTTPException(status_code=429,detail={"code":"RATE_LIMITED","scope":scope,"retry_after":retry},
                                headers={"Retry-After":str(retry)})
    c.commit()
    return True


