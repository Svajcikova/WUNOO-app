@app.post("/api/v057/catalog/seed-demo")
def v057_seed_demo(authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin"})
    with core_db_connect() as c:
        merchants=c.execute("SELECT id,name FROM merchants ORDER BY id LIMIT 3").fetchall()
        created=0
        for m in merchants:
            existing=c.execute("SELECT COUNT(*) n FROM catalog_products WHERE merchant_id=?",(m["id"],)).fetchone()["n"]
            if existing: continue
            for n,(name,price) in enumerate([("Classic Burger",189),("Crispy Chicken",209),("Fries",69)]):
                pid="prod_"+uuid.uuid4().hex[:10]
                c.execute("INSERT INTO catalog_products VALUES (?,?,?,?,?,?,?,?,?,?)",
                          (pid,m["id"],name,"Demo položka pro marketplace",price,None,1,n,now(),now()))
                if name!="Fries":
                    for mn,delta,req in [("Cheddar",25,0),("Jalapeño",15,0),("Extra sauce",10,0)]:
                        c.execute("INSERT INTO catalog_modifiers VALUES (?,?,?,?,?,?,?)",
                                  ("mod_"+uuid.uuid4().hex[:10],pid,mn,delta,req,0,now()))
                created+=1
        c.commit()
        return {"created":created}

