    return {"status":"ok","service":"wunoo"}

@app.get("/readyz")
def v067_readyz():
    # Canonical readiness endpoint: development only checks DB connectivity;
    # production/staging additionally requires the v1.46 deployment gate.
    if os.getenv("WUNOO_ENV", "development").strip().lower() in {"prod", "production", "staging"}:
        gate = _v146_deployment_gate() if "_v146_deployment_gate" in globals() else {"production_pass": False}
        if not gate.get("production_pass"):
            return JSONResponse(status_code=503, content={"status":"not_ready", "database":"postgresql_required", "production_pass":False, "blocking_reasons":gate.get("blocking_reasons", ["deployment_gate"])})
    with core_db_connect() as c:
        c.execute("SELECT 1").fetchone()
    return {"status":"ready","database":"ok"}

@app.post("/api/v067/ops/retry-dead-letter")
def v067_retry_dead_letter(body:dict[str,Any], authorization:str|None=Header(default=None))->dict[str,Any]:
    u=current_user(authorization); require_role(u,{"admin","ops_agent"})
    dlq_id=str(body.get("dead_letter_id","")).strip()
    with core_db_connect() as c:
        d=c.execute("SELECT * FROM dead_letter_jobs WHERE id=?",(dlq_id,)).fetchone()
        if not d: raise HTTPException(404,"DLQ job nenalezen")
        c.execute("UPDATE dead_letter_jobs SET status='retry_queued',retried_at=? WHERE id=?",(now(),dlq_id))
        _v053_enqueue(c,d["queue_name"],d["job_type"],json.loads(d["payload_json"]))
        c.commit()
        return {"dead_letter_id":dlq_id,"status":"retry_queued"}

