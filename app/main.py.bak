            raise HTTPException(404, "Restaurace nenalezena")
        live = c.execute("SELECT publication_no,snapshot_sha256,snapshot_json FROM merchant_menu_publications WHERE merchant_id=? AND status='LIVE' ORDER BY publication_no DESC LIMIT 1", (merchant_id,)).fetchone() if _db_table_exists(c,'merchant_menu_publications') else None
