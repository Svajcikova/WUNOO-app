# ---------------- v1.67 Production Promotion Evidence & Final Release Gate ----------------
def migrate_v167(c):
    c.execute("""CREATE TABLE IF NOT EXISTS production_final_release_gates(
        id TEXT PRIMARY KEY, release_version TEXT, promotion_run_id TEXT,
        decision TEXT NOT NULL, gate_status TEXT NOT NULL,
        evidence_snapshot_json TEXT NOT NULL DEFAULT '{}',
        source_versions_json TEXT NOT NULL DEFAULT '{}',
        evidence_sha256 TEXT NOT NULL, created_at TEXT NOT NULL,
        operator TEXT
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_final_release_gate_time ON production_final_release_gates(created_at DESC)")
    c.execute("CREATE INDEX IF NOT EXISTS idx_final_release_gate_release ON production_final_release_gates(release_version,created_at DESC)")
    try: c.commit()
    except Exception: pass

_V167_POLICY={
    'schema_version':'1.67',
    'required_versions':['1.48','1.51','1.52','1.54','1.55','1.56','1.57','1.58','1.59','1.60','1.61','1.62','1.63','1.64','1.65','1.66'],
    'required_promotion_phase':'COMPLETE',
    'required_promotion_decision':'GO',
    'required_ledger_status':'HEALTHY',
    'fail_closed':True,
    'operator_confirmation_required':True,
    'automatic_release':False,
}

def _v167_hash(payload):
    return hashlib.sha256(json.dumps(payload,sort_keys=True,separators=(',',':')).encode()).hexdigest()

def _v167_row(c, table, where='', args=(), order='created_at DESC'):
    try:
        return c.execute(f'SELECT * FROM {table}{where} ORDER BY {order} LIMIT 1',args).fetchone()
    except Exception:
        return None

def _v167_collect(c, promotion_run_id=None, release_version=None):
    pr=None
    if promotion_run_id:
        pr=_v167_row(c,'production_safety_promotion_runs',' WHERE id=?',(promotion_run_id,),'updated_at DESC')
    if not pr and release_version:
        pr=_v167_row(c,'production_safety_promotion_runs',' WHERE release_version=?',(release_version,),'updated_at DESC')
    if not pr:
        pr=_v167_row(c,'production_safety_promotion_runs',order='updated_at DESC')
    snap={'schema_version':'1.67','promotion_run_id':pr['id'] if pr else None,'release_version':pr['release_version'] if pr else release_version,
          'promotion_phase':str(pr['phase']) if pr else None,'promotion_decision':str(pr['decision']) if pr else None,
          'promotion_percent':float(pr['promotion_percent']) if pr else 0.0,'promotion_evidence_sha256':pr['evidence_sha256'] if pr else None,
          'source_versions':{},'gate_results':{},'conflicts':[],'missing':[]}
    if pr:
        snap['source_versions']['1.66']=pr['evidence_sha256']
    # v1.65 release revalidation
    rr=_v167_row(c,'production_safety_revalidation_runs',' WHERE release_version=?',(snap['release_version'],),'updated_at DESC') if snap['release_version'] else _v167_row(c,'production_safety_revalidation_runs',order='updated_at DESC')
    if rr:
        snap['gate_results']['1.65']={'phase':rr['phase'],'decision':rr['decision'],'evidence_sha256':rr['evidence_sha256']}
        snap['source_versions']['1.65']=rr['evidence_sha256']
    else: snap['missing'].append('1.65')
    # final launch/attestation evidence; preserve exact latest hashes where available
    for ver,table,col in [('1.55','production_release_attestations','evidence_sha256'),('1.54','production_e2e_evidence_runs','evidence_sha256'),('1.52','production_launch_verification_runs','evidence_sha256')]:
        row=_v167_row(c,table,order='created_at DESC')
        if row:
            snap['gate_results'][ver]=dict(row)
            if col in row.keys(): snap['source_versions'][ver]=row[col]
        else: snap['missing'].append(ver)
    # v1.61 integration latest, if table exists
    row=_v167_row(c,'production_safety_integrations',order='created_at DESC')
    if row:
        snap['gate_results']['1.61']=dict(row); snap['source_versions']['1.61']=row['evidence_sha256'] if 'evidence_sha256' in row.keys() else row.get('id')
    else: snap['missing'].append('1.61')
    # ledger latest/reconciliation
    row=_v167_row(c,'production_safety_ledger_recoveries',order='created_at DESC')
    if row:
        snap['gate_results']['1.63']=dict(row); snap['source_versions']['1.63']=row['evidence_sha256'] if 'evidence_sha256' in row.keys() else row.get('id')
    else: snap['missing'].append('1.63')
    return snap

def _v167_eval(snapshot):
    missing=list(snapshot.get('missing') or [])
    conflicts=list(snapshot.get('conflicts') or [])
    phase=str(snapshot.get('promotion_phase') or '').upper()
    decision=str(snapshot.get('promotion_decision') or '').upper()
    percent=float(snapshot.get('promotion_percent') or 0)
    if phase!='COMPLETE': missing.append('promotion_complete')
    if decision!='GO': missing.append('promotion_go')
    if percent < 100: missing.append('promotion_100_percent')
    # Verify critical source evidence, without trusting a single downstream summary.
    rr=snapshot.get('gate_results',{}).get('1.65') or {}
    if str(rr.get('phase','')).upper()!='RELEASE' or str(rr.get('decision','')).upper()!='GO': missing.append('1.65_release_go')
    for v in ('1.61','1.63'):
        if v not in snapshot.get('source_versions',{}): missing.append(v)
    # Detect obvious contradictory downstream decisions.
    for v,obj in (snapshot.get('gate_results') or {}).items():
        if isinstance(obj,dict) and str(obj.get('decision','')).upper() in ('ROLLBACK_RECOMMENDED','HOLD','BLOCKED'):
            conflicts.append(f'{v}:{str(obj.get("decision")).upper()}')
    conflicts=sorted(set(conflicts)); snapshot['conflicts']=conflicts
    if conflicts: return {'decision':'HOLD','gate_status':'CONFLICT','reason':'conflicting upstream release evidence','release_allowed':False}
    if missing: return {'decision':'HOLD','gate_status':'INCOMPLETE','reason':'missing or incomplete release evidence: '+','.join(sorted(set(missing))),'release_allowed':False}
    return {'decision':'GO','gate_status':'READY','reason':'complete cryptographically bound promotion evidence chain','release_allowed':True}

@app.get('/api/v167/ops/final-release-gate/policy')
def v167_policy(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); return _V167_POLICY

@app.post('/api/v167/ops/final-release-gate/evaluate')
def v167_evaluate(payload: dict[str,Any]|None=None, authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); payload=payload or {}
    with core_db_connect() as c: snap=_v167_collect(c,payload.get('promotion_run_id'),payload.get('release_version')); ev=_v167_eval(snap)
    return {'schema_version':'1.67','snapshot':snap,'evaluation':ev,'evidence_sha256':_v167_hash({'snapshot':snap,'evaluation':ev})}

@app.post('/api/v167/ops/final-release-gate/attest')
def v167_attest(payload: dict[str,Any]|None=None, authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); payload=payload or {}; operator=str(u.get('email') or u.get('id') or 'operator')
    if not bool(payload.get('operator_confirmed',False)): raise HTTPException(409,'operator confirmation required')
    with core_db_connect() as c:
        snap=_v167_collect(c,payload.get('promotion_run_id'),payload.get('release_version')); ev=_v167_eval(snap)
        body={'snapshot':snap,'evaluation':ev,'operator':operator}; digest=_v167_hash(body)
        rid='final_'+uuid.uuid4().hex[:16]
        c.execute('INSERT INTO production_final_release_gates(id,release_version,promotion_run_id,decision,gate_status,evidence_snapshot_json,source_versions_json,evidence_sha256,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?)',
                  (rid,snap.get('release_version'),snap.get('promotion_run_id'),ev['decision'],ev['gate_status'],json.dumps(snap,sort_keys=True),json.dumps(snap.get('source_versions',{}),sort_keys=True),digest,now(),operator)); c.commit()
    if ev['decision']!='GO': raise HTTPException(409,ev['reason'])
    return {'schema_version':'1.67','final_release_gate_id':rid,'decision':ev['decision'],'gate_status':ev['gate_status'],'evidence_sha256':digest}

@app.get('/api/v167/ops/final-release-gate/latest')
def v167_latest(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c: row=_v167_row(c,'production_final_release_gates',order='created_at DESC')
    if not row: raise HTTPException(404,'final release gate nenalezen')
    return {'schema_version':'1.67','gate':dict(row),'policy':_V167_POLICY}


# ---------------- v1.68 Production Release Manifest & Immutable Evidence Bundle ----------------
def migrate_v168(c):
    c.execute("""CREATE TABLE IF NOT EXISTS production_release_manifests(
        id TEXT PRIMARY KEY, release_version TEXT NOT NULL, manifest_json TEXT NOT NULL,
        manifest_sha256 TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT,
        UNIQUE(release_version, manifest_sha256))""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_release_manifest_time ON production_release_manifests(created_at DESC)")
    c.execute("CREATE INDEX IF NOT EXISTS idx_release_manifest_release ON production_release_manifests(release_version,created_at DESC)")
    try: c.commit()
    except Exception: pass

_V168_POLICY={
 'schema_version':'1.68','manifest_format':'wunoo.release.manifest.v1',
 'required_manifest_sections':['release','source_tree','migrations','safety_chain'],
 'required_safety_versions':['1.48','1.51','1.52','1.54','1.55','1.56','1.57','1.58','1.59','1.60','1.61','1.62','1.63','1.64','1.65','1.66','1.67'],
 'hash_algorithm':'sha256','deterministic':True,'immutable':True,'fail_closed':True,'automatic_release':False}

def _v168_sha(data):
    return hashlib.sha256(json.dumps(data,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()).hexdigest()

def _v168_file_sha(path):
    h=hashlib.sha256()
    with open(path,'rb') as f:
        for chunk in iter(lambda:f.read(1024*1024),b''): h.update(chunk)
    return h.hexdigest()

def _v168_source_tree():
    root=BASE.parent; out=[]
    for path in sorted(root.rglob('*')):
        if not path.is_file(): continue
        rel=path.relative_to(root).as_posix()
        if any(x in {'.git','__pycache__','.pytest_cache'} for x in path.parts): continue
        if path.suffix in {'.db','.sqlite','.pyc'} or rel.startswith(('TEST_','test_')): continue
        out.append({'path':rel,'sha256':_v168_file_sha(path),'size':path.stat().st_size})
    return out

def _v168_collect(c, release_version=None):
    version=str(release_version or os.getenv('WUNOO_RELEASE_VERSION') or '1.68')
    mroot=BASE.parent/'migrations'; migrations=[]
    if mroot.exists():
        for path in sorted(mroot.glob('*.sql')):
            migrations.append({'path':path.relative_to(BASE.parent).as_posix(),'sha256':_v168_file_sha(path),'size':path.stat().st_size})
    safety={}
    for ver,table,keys in [
      ('1.67','production_final_release_gates',('id','decision','gate_status','evidence_sha256')),
      ('1.66','production_safety_promotion_runs',('id','phase','decision','evidence_sha256')),
      ('1.65','production_safety_revalidation_runs',('id','phase','decision','evidence_sha256')),
      ('1.61','production_safety_integrations',('id','decision','gate_status','evidence_sha256')),
      ('1.63','production_safety_ledger_recoveries',('id','status','decision','evidence_sha256'))]:
        try:
            row=_v167_row(c,table,order='created_at DESC' if ver not in ('1.66',) else 'updated_at DESC')
            if row:
                d=dict(row); safety[ver]={k:d[k] for k in keys if k in d}
        except Exception: pass
    manifest={'format':_V168_POLICY['manifest_format'],
      'release':{'version':version,'backend':configured_db_backend(),'environment':os.getenv('WUNOO_ENV','development')},
      'source_tree':_v168_source_tree(),'migrations':migrations,'safety_chain':safety,
      'policy':{'hash_algorithm':'sha256','required_safety_versions':_V168_POLICY['required_safety_versions']}}
    return manifest,_v168_sha(manifest)

def _v168_verify_manifest(manifest, expected_sha256=None):
    if not isinstance(manifest,dict): return {'valid':False,'reason':'manifest_not_object'}
    missing=[x for x in _V168_POLICY['required_manifest_sections'] if x not in manifest]
    if missing: return {'valid':False,'reason':'missing_sections','missing':missing}
    actual=_v168_sha(manifest)
    if expected_sha256 and actual!=expected_sha256: return {'valid':False,'reason':'HASH_MISMATCH','expected_sha256':expected_sha256,'actual_sha256':actual}
    root=BASE.parent; absent=[]; mismatches=[]
    for item in list(manifest.get('source_tree') or []):
        path=root/item['path']
        if not path.exists(): absent.append(item['path']); continue
        got=_v168_file_sha(path)
        if got!=item.get('sha256'): mismatches.append({'path':item['path'],'expected':item.get('sha256'),'actual':got})
    if absent or mismatches: return {'valid':False,'reason':'ARTIFACT_DRIFT','absent':absent,'mismatches':mismatches,'actual_sha256':actual}
    return {'valid':True,'reason':'IMMUTABLE_MANIFEST_VERIFIED','actual_sha256':actual}

@app.get('/api/v168/ops/release-manifest/policy')
def v168_policy(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); return _V168_POLICY

@app.post('/api/v168/ops/release-manifest/generate')
def v168_generate(payload: dict[str,Any]|None=None, authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); payload=payload or {}; operator=str(u.get('email') or u.get('id') or 'operator')
    with core_db_connect() as c:
        manifest,digest=_v168_collect(c,payload.get('release_version')); result=_v168_verify_manifest(manifest,digest)
        rid='manifest_'+uuid.uuid4().hex[:16]
        c.execute('INSERT INTO production_release_manifests(id,release_version,manifest_json,manifest_sha256,status,created_at,operator) VALUES(?,?,?,?,?,?,?)',(rid,manifest['release']['version'],json.dumps(manifest,sort_keys=True,separators=(',',':'),ensure_ascii=False),digest,'VERIFIED' if result['valid'] else 'INVALID',now(),operator)); c.commit()
    return {'schema_version':'1.68','manifest_id':rid,'release_version':manifest['release']['version'],'manifest_sha256':digest,'status':'VERIFIED' if result['valid'] else 'INVALID','manifest':manifest}

@app.post('/api/v168/ops/release-manifest/verify')
def v168_verify(payload: dict[str,Any]|None=None, authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); payload=payload or {}
    with core_db_connect() as c:
        if payload.get('manifest_id'): row=_v167_row(c,'production_release_manifests',' WHERE id=?',(payload['manifest_id'],),'created_at DESC')
        elif payload.get('manifest_sha256'): row=_v167_row(c,'production_release_manifests',' WHERE manifest_sha256=?',(payload['manifest_sha256'],),'created_at DESC')
        else: row=_v167_row(c,'production_release_manifests',order='created_at DESC')
    if not row: raise HTTPException(404,'release manifest nenalezen')
    result=_v168_verify_manifest(json.loads(row['manifest_json']),row['manifest_sha256'])
    if not result['valid']: raise HTTPException(409,result['reason'])
    return {'schema_version':'1.68','manifest_id':row['id'],'release_version':row['release_version'],'manifest_sha256':row['manifest_sha256'],'verification':result}

@app.get('/api/v168/ops/release-manifest/latest')
def v168_latest(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c: row=_v167_row(c,'production_release_manifests',order='created_at DESC')
    if not row: raise HTTPException(404,'release manifest nenalezen')
    result=_v168_verify_manifest(json.loads(row['manifest_json']),row['manifest_sha256'])
    return {'schema_version':'1.68','manifest_id':row['id'],'release_version':row['release_version'],'manifest_sha256':row['manifest_sha256'],'status':row['status'],'verification':result}


# ---------------- v1.69 Signed Release & Supply Chain Verification ----------------
def migrate_v169(c):
    c.execute("""CREATE TABLE IF NOT EXISTS production_release_signatures(
        id TEXT PRIMARY KEY, release_version TEXT NOT NULL, manifest_id TEXT,
        manifest_sha256 TEXT NOT NULL, algorithm TEXT NOT NULL, key_id TEXT NOT NULL,
        public_key_b64 TEXT NOT NULL, signature_b64 TEXT NOT NULL,
        attestation_json TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT,
        UNIQUE(manifest_sha256,key_id,signature_b64))""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_release_signature_time ON production_release_signatures(created_at DESC)")
    c.execute("CREATE INDEX IF NOT EXISTS idx_release_signature_manifest ON production_release_signatures(manifest_sha256,created_at DESC)")
    try: c.commit()
    except Exception: pass

_V169_POLICY={
 'schema_version':'1.69','format':'wunoo.release.signature.v1','algorithm':'Ed25519',
 'hash_algorithm':'sha256','required_manifest_format':'wunoo.release.manifest.v1',
 'production_requires_configured_signer':True,'trusted_key_allowlist_env':'WUNOO_RELEASE_TRUSTED_PUBLIC_KEYS_B64',
 'fail_closed':True,'automatic_release':False}

def _v169_crypto():
    try:
        from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey, Ed25519PublicKey
        from cryptography.hazmat.primitives.serialization import Encoding, PublicFormat, PrivateFormat, NoEncryption
        return Ed25519PrivateKey,Ed25519PublicKey,Encoding,PublicFormat,PrivateFormat,NoEncryption
    except Exception as exc:
        raise HTTPException(503,'Ed25519 crypto backend unavailable') from exc

def _v169_key_id(public_key_bytes):
    return hashlib.sha256(public_key_bytes).hexdigest()[:32]

def _v169_load_signer():
    Ed25519PrivateKey,_,Encoding,PublicFormat,PrivateFormat,NoEncryption=_v169_crypto()
    raw=os.getenv('WUNOO_RELEASE_SIGNING_PRIVATE_KEY_B64','').strip()
    production=str(os.getenv('WUNOO_ENV','development')).lower() in ('prod','production','staging')
    if not raw:
        if production: raise HTTPException(503,'production signing key is not configured')
        key=Ed25519PrivateKey.generate()
        pub=key.public_key().public_bytes(Encoding.Raw,PublicFormat.Raw)
        return key, pub, _v169_key_id(pub)
    try:
        import base64
        data=base64.b64decode(raw,validate=True)
        if len(data)!=32: raise ValueError('Ed25519 seed must be 32 bytes')
        key=Ed25519PrivateKey.from_private_bytes(data)
        pub=key.public_key().public_bytes(Encoding.Raw,PublicFormat.Raw)
        return key,pub,_v169_key_id(pub)
    except Exception as exc:
        raise HTTPException(503,'invalid Ed25519 signing key') from exc

def _v169_trusted(pub_b64):
    import base64
    configured=[x.strip() for x in os.getenv('WUNOO_RELEASE_TRUSTED_PUBLIC_KEYS_B64','').split(',') if x.strip()]
    if not configured: return str(os.getenv('WUNOO_ENV','development')).lower() not in ('prod','production','staging')
    return pub_b64 in configured

def _v169_attestation(manifest, manifest_sha, key_id, pub_b64):
    return {'schema_version':'1.69','statement':'WUNOO_RELEASE_ATTESTATION','release_version':manifest.get('release',{}).get('version'),
            'manifest_sha256':manifest_sha,'manifest_format':manifest.get('format'),'key_id':key_id,
            'public_key_b64':pub_b64,'source_tree_sha256':_v168_sha(manifest.get('source_tree',[])),
            'migrations_sha256':_v168_sha(manifest.get('migrations',[]))}

def _v169_sign_payload(attestation):
    return json.dumps(attestation,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()

def _v169_verify_signature(attestation, signature_b64, public_key_b64):
    import base64
    _,Ed25519PublicKey,_,_,_,_=_v169_crypto()
    try:
        pub=base64.b64decode(public_key_b64,validate=True); sig=base64.b64decode(signature_b64,validate=True)
        Ed25519PublicKey.from_public_bytes(pub).verify(sig,_v169_sign_payload(attestation))
        if _v169_key_id(pub)!=str(attestation.get('key_id')): return {'valid':False,'reason':'KEY_ID_MISMATCH'}
        if not _v169_trusted(public_key_b64): return {'valid':False,'reason':'UNTRUSTED_SIGNING_KEY'}
        return {'valid':True,'reason':'SIGNED_RELEASE_VERIFIED','key_id':_v169_key_id(pub)}
    except Exception:
        return {'valid':False,'reason':'SIGNATURE_INVALID'}

@app.get('/api/v169/ops/release-signing/policy')
def v169_policy(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); return _V169_POLICY

@app.post('/api/v169/ops/release-signing/sign')
def v169_sign(payload: dict[str,Any]|None=None, authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); payload=payload or {}; operator=str(u.get('email') or u.get('id') or 'operator')
    import base64
    with core_db_connect() as c:
        row=_v167_row(c,'production_release_manifests',(' WHERE id=?' if payload.get('manifest_id') else ''),((payload['manifest_id'],) if payload.get('manifest_id') else ()), 'created_at DESC') if payload.get('manifest_id') else _v167_row(c,'production_release_manifests',' WHERE manifest_sha256=?' if payload.get('manifest_sha256') else '',((payload['manifest_sha256'],) if payload.get('manifest_sha256') else ()), 'created_at DESC') if payload.get('manifest_sha256') else _v167_row(c,'production_release_manifests',order='created_at DESC')
    if not row: raise HTTPException(404,'release manifest nenalezen')
    manifest=json.loads(row['manifest_json']); verification=_v168_verify_manifest(manifest,row['manifest_sha256'])
    if not verification['valid']: raise HTTPException(409,'manifest verification failed: '+verification['reason'])
    key,pub,key_id=_v169_load_signer(); pub_b64=base64.b64encode(pub).decode()
    att=_v169_attestation(manifest,row['manifest_sha256'],key_id,pub_b64); sig=base64.b64encode(key.sign(_v169_sign_payload(att))).decode()
    status=_v169_verify_signature(att,sig,pub_b64)['reason']
    rid='sig_'+uuid.uuid4().hex[:16]
    with core_db_connect() as c:
        c.execute('INSERT INTO production_release_signatures(id,release_version,manifest_id,manifest_sha256,algorithm,key_id,public_key_b64,signature_b64,attestation_json,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?)',(rid,row['release_version'],row['id'],row['manifest_sha256'],'Ed25519',key_id,pub_b64,sig,json.dumps(att,sort_keys=True,separators=(',',':')),status,now(),operator)); c.commit()
    return {'schema_version':'1.69','signature_id':rid,'release_version':row['release_version'],'manifest_sha256':row['manifest_sha256'],'algorithm':'Ed25519','key_id':key_id,'public_key_b64':pub_b64,'signature_b64':sig,'attestation':att,'status':status}

@app.post('/api/v169/ops/release-signing/verify')
def v169_verify(payload: dict[str,Any]|None=None, authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); payload=payload or {}
    with core_db_connect() as c:
        if payload.get('signature_id'): row=_v167_row(c,'production_release_signatures',' WHERE id=?',(payload['signature_id'],),'created_at DESC')
        elif payload.get('manifest_sha256'): row=_v167_row(c,'production_release_signatures',' WHERE manifest_sha256=?',(payload['manifest_sha256'],),'created_at DESC')
        else: row=_v167_row(c,'production_release_signatures',order='created_at DESC')
    if not row: raise HTTPException(404,'release signature nenalezena')
    att=json.loads(row['attestation_json']); result=_v169_verify_signature(att,row['signature_b64'],row['public_key_b64'])
    if not result['valid']: raise HTTPException(409,result['reason'])
    return {'schema_version':'1.69','signature_id':row['id'],'release_version':row['release_version'],'manifest_sha256':row['manifest_sha256'],'verification':result,'attestation':att}

@app.get('/api/v169/ops/release-signing/latest')
def v169_latest(authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c: row=_v167_row(c,'production_release_signatures',order='created_at DESC')
    if not row: raise HTTPException(404,'release signature nenalezena')
    att=json.loads(row['attestation_json']); result=_v169_verify_signature(att,row['signature_b64'],row['public_key_b64'])
    return {'schema_version':'1.69','signature_id':row['id'],'release_version':row['release_version'],'manifest_sha256':row['manifest_sha256'],'status':row['status'],'verification':result,'attestation':att}


# ---------------- v1.70 Production Release Certificate & Verification Authority ----------------
def migrate_v170(c):
    c.execute("""CREATE TABLE IF NOT EXISTS production_release_certificates(
        id TEXT PRIMARY KEY, release_version TEXT NOT NULL, manifest_id TEXT,
        manifest_sha256 TEXT NOT NULL, signature_id TEXT NOT NULL, signer_key_id TEXT NOT NULL,
        certificate_sha256 TEXT NOT NULL, certificate_json TEXT NOT NULL,
        certificate_signature_b64 TEXT NOT NULL, status TEXT NOT NULL,
        verification_policy_version TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT,
        UNIQUE(certificate_sha256)
    )""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_release_certificate_time ON production_release_certificates(created_at DESC)")
    c.execute("CREATE INDEX IF NOT EXISTS idx_release_certificate_release ON production_release_certificates(release_version,created_at DESC)")
    c.execute("CREATE INDEX IF NOT EXISTS idx_release_certificate_manifest ON production_release_certificates(manifest_sha256,created_at DESC)")
    try: c.commit()
    except Exception: pass

_V170_POLICY={
 'schema_version':'1.70','format':'wunoo.release.certificate.v1','hash_algorithm':'sha256',
 'certificate_signature_algorithm':'Ed25519','required_manifest_format':'wunoo.release.manifest.v1',
 'required_evidence_versions':['1.63','1.64','1.65','1.66','1.67','1.68','1.69'],
 'required_final_gate_status':'READY','required_final_gate_decision':'GO',
 'required_promotion_phase':'COMPLETE','required_promotion_decision':'GO',
 'required_revalidation_phase':'RELEASE','required_revalidation_decision':'GO',
 'required_ledger_status':'HEALTHY','trusted_key_allowlist_env':'WUNOO_RELEASE_TRUSTED_PUBLIC_KEYS_B64',
 'fail_closed':True,'automatic_release':False,'certificate_is_not_release_authorization':True}

def _v170_hash(payload):
    return hashlib.sha256(json.dumps(payload,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()).hexdigest()

def _v170_row(c, table, where='', args=(), order='created_at DESC'):
    try: return c.execute(f'SELECT * FROM {table}{where} ORDER BY {order} LIMIT 1',args).fetchone()
    except Exception: return None

def _v170_collect(c, manifest_id=None, signature_id=None, release_version=None):
    # Exact signed manifest.
    if manifest_id: manifest_row=_v170_row(c,'production_release_manifests',' WHERE id=?',(manifest_id,),'created_at DESC')
    elif release_version: manifest_row=_v170_row(c,'production_release_manifests',' WHERE release_version=?',(release_version,),'created_at DESC')
    else: manifest_row=_v170_row(c,'production_release_manifests',order='created_at DESC')
    out={'schema_version':'1.70','release_version':release_version,'manifest':None,'signature':None,
         'evidence':{},'missing':[],'conflicts':[]}
    if not manifest_row:
        out['missing'].append('1.68:manifest'); return out
    manifest=json.loads(manifest_row['manifest_json'] or '{}')
    mv=_v168_verify_manifest(manifest,manifest_row['manifest_sha256'])
    out['manifest']={'id':manifest_row['id'],'release_version':manifest_row['release_version'],'sha256':manifest_row['manifest_sha256'],
                     'format':manifest.get('format'),'verification':mv}
    release=str(manifest_row['release_version'])
    out['release_version']=release
    if release_version and str(release_version)!=release: out['conflicts'].append('release_version:manifest')
    # Exact v1.69 signature bound to this manifest.
    if signature_id: sig_row=_v170_row(c,'production_release_signatures',' WHERE id=?',(signature_id,),'created_at DESC')
    else: sig_row=_v170_row(c,'production_release_signatures',' WHERE manifest_sha256=?',(manifest_row['manifest_sha256'],),'created_at DESC')
    if not sig_row: out['missing'].append('1.69:signature')
    else:
        att=json.loads(sig_row['attestation_json'] or '{}')
        sv=_v169_verify_signature(att,sig_row['signature_b64'],sig_row['public_key_b64'])
        out['signature']={'id':sig_row['id'],'release_version':sig_row['release_version'],'manifest_sha256':sig_row['manifest_sha256'],
                         'algorithm':sig_row['algorithm'],'key_id':sig_row['key_id'],'signature_sha256':hashlib.sha256(str(sig_row['signature_b64']).encode()).hexdigest(),
                         'verification':sv}
        if str(sig_row['release_version'])!=release: out['conflicts'].append('release_version:signature')
        if str(sig_row['manifest_sha256'])!=str(manifest_row['manifest_sha256']): out['conflicts'].append('manifest_sha256:signature')
    # Final release gate and upstream promotion/revalidation.
    gate=_v170_row(c,'production_final_release_gates',' WHERE release_version=?',(release,),'created_at DESC')
    if not gate: gate=_v170_row(c,'production_final_release_gates',order='created_at DESC')
    if not gate: out['missing'].append('1.67:final_release_gate')
    else:
        out['evidence']['1.67']={'id':gate['id'],'release_version':gate['release_version'],'promotion_run_id':gate['promotion_run_id'],
                                 'decision':gate['decision'],'gate_status':gate['gate_status'],'evidence_sha256':gate['evidence_sha256']}
        if str(gate['release_version'] or release)!=release: out['conflicts'].append('release_version:1.67')
        try: out['evidence']['1.67']['source_versions']=json.loads(gate['source_versions_json'] or '{}')
        except Exception: out['evidence']['1.67']['source_versions']={}
    promotion_id=out['evidence'].get('1.67',{}).get('promotion_run_id')
    pr=_v170_row(c,'production_safety_promotion_runs',' WHERE id=?',(promotion_id,),'updated_at DESC') if promotion_id else _v170_row(c,'production_safety_promotion_runs',' WHERE release_version=?',(release,),'updated_at DESC')
    if not pr: out['missing'].append('1.66:promotion')
    else:
        out['evidence']['1.66']={'id':pr['id'],'release_version':pr['release_version'],'revalidation_run_id':pr['revalidation_run_id'],
                                 'phase':pr['phase'],'decision':pr['decision'],'promotion_percent':float(pr['promotion_percent'] or 0),'evidence_sha256':pr['evidence_sha256']}
        if str(pr['release_version'] or release)!=release: out['conflicts'].append('release_version:1.66')
    reval_id=out['evidence'].get('1.66',{}).get('revalidation_run_id')
    rr=_v170_row(c,'production_safety_revalidation_runs',' WHERE id=?',(reval_id,),'updated_at DESC') if reval_id else _v170_row(c,'production_safety_revalidation_runs',' WHERE release_version=?',(release,),'updated_at DESC')
    if not rr: out['missing'].append('1.65:revalidation')
    else:
        out['evidence']['1.65']={'id':rr['id'],'release_version':rr['release_version'],'phase':rr['phase'],'decision':rr['decision'],'evidence_sha256':rr['evidence_sha256']}
        if str(rr['release_version'] or release)!=release: out['conflicts'].append('release_version:1.65')
    # Actual v1.63/v1.64 tables (avoid the historical v1.67 table-name aliases).
    recon=_v170_row(c,'production_safety_ledger_reconciliations',order='created_at DESC')
    if not recon: out['missing'].append('1.63:ledger_reconciliation')
    else: out['evidence']['1.63']={'id':recon['id'],'status':recon['status'],'trusted_sequence_no':recon['trusted_sequence_no'],'state_hash':recon['state_hash']}
    recov=_v170_row(c,'production_safety_ledger_recovery_snapshots',order='created_at DESC')
    if not recov: out['missing'].append('1.63:recovery_snapshot')
    else: out['evidence']['1.63']['recovery_snapshot_id']=recov['id']; out['evidence']['1.63']['recovery_status']=recov['recovery_status']; out['evidence']['1.63']['recovery_state_hash']=recov['state_hash']
    recovery=_v170_row(c,'production_safety_recovery_runs',order='updated_at DESC')
    if not recovery: out['missing'].append('1.64:recovery_run')
    else: out['evidence']['1.64']={'id':recovery['id'],'release_version':recovery['release_version'],'phase':recovery['phase'],'decision':recovery['decision'],'recovery_snapshot_id':recovery['recovery_snapshot_id'],'evidence_sha256':recovery['evidence_sha256']}
