    with core_db_connect() as c:
        c.execute("DELETE FROM cart_items WHERE customer_id=?",(u["customer_id"],)); c.commit()
    return v115_cart(authorization)

@app.get("/api/v115/checkout/validate")
def v115_checkout_validate(authorization: str | None = Header(default=None)):
    u=current_user(authorization); require_role(u,"customer")
    with core_db_connect() as c:
        _,issues,subtotal=_v115_validate_cart_rows(c,u["customer_id"])
        return {"schema_version":"1.15","valid":not issues,"issues":issues,"subtotal_czk":subtotal}


@app.post("/api/v115/checkout/order")
def v115_checkout_order(authorization: str | None = Header(default=None)):
    """Create an order from the authoritative cart, including modifier snapshots."""
    u=current_user(authorization); require_role(u,"customer")
    with core_db_connect() as c:
        rows,issues,_=_v115_validate_cart_rows(c,u["customer_id"])
        if issues: raise HTTPException(409,detail={"message":"Košík není validní","issues":issues})
        if not rows: raise HTTPException(409,"Košík je prázdný")
        merchant_id=rows[0]["merchant_id"]
        address=c.execute("SELECT * FROM customer_addresses WHERE customer_id=? ORDER BY is_default DESC,created_at DESC LIMIT 1",(u["customer_id"],)).fetchone()
        if not address: raise HTTPException(409,"Nejprve nastavte doručovací adresu")
        snapshots=[]; subtotal=0.0
        for r in rows:
            mi=c.execute("SELECT id,merchant_id,name,price_czk,active FROM menu_items WHERE id=? AND merchant_id=? AND active=1",(r["menu_item_id"],merchant_id)).fetchone()
            if not mi or _v115_effective_availability(c,mi["id"])["state"]!="AVAILABLE":
                raise HTTPException(409,"Položka se mezitím stala nedostupná")
            mods=c.execute("""
                SELECT cm.modifier_id,cm.qty,mo.name,mo.price_czk,mo.active,mg.active group_active
                FROM cart_item_modifiers cm JOIN modifiers mo ON mo.id=cm.modifier_id
                JOIN modifier_groups mg ON mg.id=mo.group_id
                WHERE cm.cart_item_id=?
            """,(r["cart_item_id"],)).fetchall()
            unit=float(mi["price_czk"]); mod_snaps=[]
            for m in mods:
                if not m["active"] or not m["group_active"]: raise HTTPException(409,"Modifier se mezitím stal nedostupný")
                unit+=float(m["price_czk"])*int(m["qty"])
                mod_snaps.append((m["modifier_id"],m["name"],float(m["price_czk"]),int(m["qty"])))
            line=round(unit*int(r["qty"]),2); subtotal+=line
            snapshots.append((mi,r,mod_snaps,line))
        subtotal=round(subtotal,2)
        pricing=pricing_for_cart(c,u["customer_id"],merchant_id,subtotal,address["id"])
        oid="ord_"+uuid.uuid4().hex[:10]; t=now()
        address_text=f"{address['street']}, {address['city']} {address['postal_code'] or ''}".strip()
        merchant=c.execute("SELECT prep_minutes FROM merchants WHERE id=?",(merchant_id,)).fetchone()
        prep_eta=int(merchant["prep_minutes"] if merchant else 15)
        from datetime import timedelta
        promised=(datetime.now(timezone.utc)+timedelta(minutes=prep_eta+35)).isoformat()
        c.execute("""INSERT INTO orders
          (id,customer_id,merchant_id,status,subtotal_czk,service_fee_czk,delivery_fee_czk,total_czk,courier_id,address,address_id,delivery_distance_km,service_fee_before_discount_czk,pro_discount_czk,pricing_version,prep_eta_minutes,promised_delivery_at,delay_level,note,payment_method,created_at,updated_at)
          VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)""",
          (oid,u["customer_id"],merchant_id,"payment_pending",subtotal,pricing["service_fee_czk"],pricing["delivery_fee_czk"],pricing["total_czk"],None,address_text,address["id"],pricing["delivery_distance_km"],pricing["service_fee_before_discount_czk"],pricing["pro_discount_czk"],"v1.15_modifier_snapshot",prep_eta,promised,"NONE",None,"card_demo",t,t))
        for mi,r,mod_snaps,line in snapshots:
            oi="oi_"+uuid.uuid4().hex[:10]
            c.execute("INSERT INTO order_items(id,order_id,menu_item_id,qty,unit_price_czk) VALUES (?,?,?,?,?)",(oi,oid,mi["id"],int(r["qty"]),float(mi["price_czk"])))
            for mid,mname,mprice,mqty in mod_snaps:
                c.execute("INSERT INTO order_item_modifiers(order_item_id,modifier_id,name_snapshot,price_snapshot_czk,qty) VALUES (?,?,?,?,?)",(oi,mid,mname,mprice,mqty))
        emit(c,oid,"order_created",{"total_czk":pricing["total_czk"],"pricing_version":"v1.15_modifier_snapshot"},u["id"])
        c.execute("DELETE FROM cart_items WHERE customer_id=?",(u["customer_id"],)); c.commit()
        return {"order_id":oid,**pricing,"status":"payment_pending","pricing_version":"v1.15_modifier_snapshot"}

