        cp=_v173_payload(no,seq,head,count,prev); digest=_v173_hash(cp); sig,pub,keyid=_v173_sign_payload(cp)
        cid='tcp_'+uuid.uuid4().hex[:16]; created=now()
        c.execute('INSERT INTO production_release_transparency_checkpoints(id,checkpoint_no,sequence_no,head_sha256,entries_count,checkpoint_sha256,signer_key_id,public_key_b64,signature_b64,checkpoint_json,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?, ?,?)',(cid,no,seq,head,count,digest,keyid,base64.b64encode(pub).decode(),base64.b64encode(sig).decode(),json.dumps(cp,sort_keys=True,separators=(',',':'),ensure_ascii=False),'ISSUED',created,str(u.get('email') or u.get('id') or 'operator'))); c.commit()
        return {'schema_version':'1.73','checkpoint_id':cid,'checkpoint_no':no,'checkpoint_sha256':digest,'checkpoint':cp,'signer_key_id':keyid,'idempotent':False,'verification':_v173_verify(_v173_rows(c))}
@app.post('/api/v173/ops/transparency-checkpoint/verify')
def v173_verify_endpoint(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
