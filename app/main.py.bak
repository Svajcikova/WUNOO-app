# ---------------- WUNOO v1.86: Federation Epoch Finality ----------------
def migrate_v186(c):
    c.executescript("""CREATE TABLE IF NOT EXISTS production_federation_epoch_attestations(
        id TEXT PRIMARY KEY, epoch_id TEXT NOT NULL, epoch_no INTEGER NOT NULL,
        epoch_sha256 TEXT NOT NULL, witness_id TEXT NOT NULL, key_id TEXT NOT NULL,
        public_key_b64 TEXT NOT NULL, signature_b64 TEXT NOT NULL,
        attestation_json TEXT NOT NULL, attestation_sha256 TEXT NOT NULL UNIQUE,
        status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT,
        UNIQUE(epoch_id,witness_id)
    );
    CREATE TABLE IF NOT EXISTS production_federation_epoch_finality(
        id TEXT PRIMARY KEY, epoch_id TEXT NOT NULL UNIQUE, epoch_no INTEGER NOT NULL,
        epoch_sha256 TEXT NOT NULL, federation_id TEXT NOT NULL, federation_sha256 TEXT NOT NULL,
        quorum_required INTEGER NOT NULL, witness_count INTEGER NOT NULL,
        witness_ids_json TEXT NOT NULL, attestation_hashes_json TEXT NOT NULL,
        proof_json TEXT NOT NULL, proof_sha256 TEXT NOT NULL UNIQUE,
        algorithm TEXT NOT NULL, signer_key_id TEXT NOT NULL, public_key_b64 TEXT NOT NULL,
        signature_b64 TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT
    );
    CREATE INDEX IF NOT EXISTS idx_federation_epoch_attestations_epoch
      ON production_federation_epoch_attestations(epoch_id,created_at);
    CREATE INDEX IF NOT EXISTS idx_federation_epoch_finality_federation
      ON production_federation_epoch_finality(federation_id,epoch_no);
    """)

_V186_POLICY={'schema_version':'1.86','attestation_format':'wunoo.release.global.checkpoint.federation.epoch.attestation.v1',
 'finality_format':'wunoo.release.global.checkpoint.federation.epoch.finality.v1','hash':'SHA-256','algorithm':'Ed25519',
 'distinct_witnesses_required':True,'epoch_snapshot_key_required':True,'historical_key_validation':True,
 'quorum_from_federation':True,'append_only':True,'fail_closed':True,'no_automatic_release':True}
def _v186_hash(v): return hashlib.sha256(json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()).hexdigest()
def _v186_json(v): return json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False)
def _v186_attestation_payload(epoch,wid,kid):
    return {'format':_V186_POLICY['attestation_format'],'schema_version':'1.86','epoch_id':epoch['id'],
            'epoch_no':int(epoch['epoch_no']),'epoch_sha256':epoch['epoch_sha256'],'witness_id':wid,'key_id':kid}
def _v186_epoch(c,eid):
    return _v170_row(c,'production_checkpoint_federation_epochs',' WHERE id=?',(eid,),'epoch_no DESC')
def _v186_member(epoch,wid):
    for m in json.loads(epoch['member_snapshot_json'] or '[]'):
        if m.get('witness_id')==wid:return m
    return None
def _v186_verify_attestation(c,row):
    try:
        epoch=_v186_epoch(c,row['epoch_id'])
        if not epoch:return {'valid':False,'reason':'ATTESTATION_EPOCH_NOT_FOUND'}
        ev=_v185_verify_epoch(c,epoch)
        if not ev['valid']:return {'valid':False,'reason':'ATTESTATION_EPOCH_INVALID'}
        member=_v186_member(epoch,row['witness_id'])
        if not member:return {'valid':False,'reason':'ATTESTER_NOT_EPOCH_MEMBER'}
        if row['epoch_sha256']!=epoch['epoch_sha256'] or int(row['epoch_no'])!=int(epoch['epoch_no']):return {'valid':False,'reason':'ATTESTATION_EPOCH_BINDING_INVALID'}
        if row['key_id']!=member['key_id'] or row['public_key_b64']!=member['public_key_b64']:return {'valid':False,'reason':'ATTESTATION_KEY_SNAPSHOT_INVALID'}
        obj=json.loads(row['attestation_json'] or '{}');expected=_v186_attestation_payload(epoch,row['witness_id'],row['key_id'])
        if obj!=expected:return {'valid':False,'reason':'ATTESTATION_PAYLOAD_INVALID'}
        if _v186_hash(obj)!=row['attestation_sha256']:return {'valid':False,'reason':'ATTESTATION_HASH_INVALID'}
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto();Ed25519PublicKey.from_public_bytes(base64.b64decode(row['public_key_b64'],validate=True)).verify(base64.b64decode(row['signature_b64'],validate=True),_v186_json(obj).encode())
        hist=_v176_history(c,row['witness_id'],row['key_id'])
        if not hist:return {'valid':False,'reason':'ATTESTATION_KEY_UNKNOWN'}
        et=str(epoch['created_at']);
        if str(hist['valid_from'])>et or (hist['valid_until'] and str(hist['valid_until'])<et):return {'valid':False,'reason':'ATTESTATION_KEY_NOT_VALID_AT_EPOCH'}
        return {'valid':True,'reason':'ATTESTATION_VERIFIED'}
    except Exception:return {'valid':False,'reason':'ATTESTATION_INVALID'}
def _v186_collect(c,epoch):
    fed=_v170_row(c,'production_global_checkpoint_federations',' WHERE id=?',(epoch['federation_id'],),'created_at DESC')
    if not fed:return None,{'valid':False,'reason':'FEDERATION_NOT_FOUND'}
    fv=_v184_verify_federation(c,fed)
    if not fv['valid']:return None,{'valid':False,'reason':'FEDERATION_INVALID'}
    q=int(fed['quorum_required']);members=json.loads(epoch['member_snapshot_json'] or '[]')
    rows=c.execute('SELECT * FROM production_federation_epoch_attestations WHERE epoch_id=? ORDER BY witness_id ASC,attestation_sha256 ASC',(epoch['id'],)).fetchall()
    valid=[]
    for r in rows:
        vr=_v186_verify_attestation(c,r)
        if vr['valid']:valid.append(r)
    by={r['witness_id']:r for r in valid}
    if len(by)<q:return None,{'valid':False,'reason':'QUORUM_NOT_REACHED','quorum_required':q,'valid_attestations':len(by)}
    selected=sorted(by.values(),key=lambda r:(r['witness_id'],r['attestation_sha256']))[:q]
    return selected,{'valid':True,'quorum_required':q,'member_count':len(members)}
def _v186_proof_payload(epoch,fed,selected):
    return {'format':_V186_POLICY['finality_format'],'schema_version':'1.86','epoch_id':epoch['id'],'epoch_no':int(epoch['epoch_no']),
            'epoch_sha256':epoch['epoch_sha256'],'federation_id':fed['id'],'federation_sha256':fed['federation_sha256'],
            'quorum_required':int(fed['quorum_required']),'witness_ids':sorted(r['witness_id'] for r in selected),
            'attestation_hashes':sorted(r['attestation_sha256'] for r in selected)}
def _v186_verify_finality(c,row):
    try:
        epoch=_v186_epoch(c,row['epoch_id'])
        if not epoch:return {'valid':False,'reason':'FINALITY_EPOCH_NOT_FOUND'}
        ev=_v185_verify_epoch(c,epoch)
        if not ev['valid']:return {'valid':False,'reason':'FINALITY_EPOCH_INVALID'}
        fed=_v170_row(c,'production_global_checkpoint_federations',' WHERE id=?',(row['federation_id'],),'created_at DESC')
        if not fed:return {'valid':False,'reason':'FINALITY_FEDERATION_NOT_FOUND'}
        fv=_v184_verify_federation(c,fed)
        if not fv['valid']:return {'valid':False,'reason':'FINALITY_FEDERATION_INVALID'}
        if row['epoch_sha256']!=epoch['epoch_sha256'] or row['federation_sha256']!=fed['federation_sha256'] or int(row['epoch_no'])!=int(epoch['epoch_no']):return {'valid':False,'reason':'FINALITY_BINDING_INVALID'}
        ids=json.loads(row['witness_ids_json'] or '[]'); hashes=json.loads(row['attestation_hashes_json'] or '[]')
        if int(row['quorum_required'])!=int(fed['quorum_required']) or int(row['witness_count'])!=len(ids) or len(ids)!=len(set(ids)) or len(ids)!=len(hashes):return {'valid':False,'reason':'FINALITY_QUORUM_INVALID'}
        selected=[]
        for wid,ah in zip(ids,hashes):
            r=c.execute('SELECT * FROM production_federation_epoch_attestations WHERE epoch_id=? AND witness_id=? AND attestation_sha256=?',(epoch['id'],wid,ah)).fetchone()
            if not r or not _v186_verify_attestation(c,r)['valid']:return {'valid':False,'reason':'FINALITY_ATTESTATION_INVALID'}
            selected.append(r)
        obj=json.loads(row['proof_json'] or '{}');expected=_v186_proof_payload(epoch,fed,selected)
        if obj!=expected:return {'valid':False,'reason':'FINALITY_PROOF_INVALID'}
        if _v186_hash(obj)!=row['proof_sha256']:return {'valid':False,'reason':'FINALITY_HASH_INVALID'}
        _,Ed25519PublicKey,_,_,_,_=_v169_crypto();Ed25519PublicKey.from_public_bytes(base64.b64decode(row['public_key_b64'],validate=True)).verify(base64.b64decode(row['signature_b64'],validate=True),_v186_json(obj).encode())
        return {'valid':True,'reason':'FEDERATION_EPOCH_FINALITY_VERIFIED','witness_count':len(ids)}
    except Exception:return {'valid':False,'reason':'FINALITY_INVALID'}

# ---------------- WUNOO v1.88: Byzantine Witness Detection ----------------
def migrate_v188(c):
    c.executescript("""CREATE TABLE IF NOT EXISTS production_federation_byzantine_conflicts(
        id TEXT PRIMARY KEY, federation_id TEXT NOT NULL, epoch_id TEXT, witness_id TEXT NOT NULL,
        key_id TEXT NOT NULL, context_type TEXT NOT NULL, context_id TEXT NOT NULL,
        first_payload_json TEXT NOT NULL, first_signature_b64 TEXT NOT NULL, first_sha256 TEXT NOT NULL,
        second_payload_json TEXT NOT NULL, second_signature_b64 TEXT NOT NULL, second_sha256 TEXT NOT NULL,
        conflict_sha256 TEXT NOT NULL UNIQUE, status TEXT NOT NULL, recommended_action TEXT NOT NULL,
        detected_at TEXT NOT NULL, operator TEXT
    );
    CREATE INDEX IF NOT EXISTS idx_byzantine_conflicts_fed ON production_federation_byzantine_conflicts(federation_id,detected_at);
    CREATE INDEX IF NOT EXISTS idx_byzantine_conflicts_witness ON production_federation_byzantine_conflicts(witness_id,detected_at);
    """)

_V188_POLICY={'schema_version':'1.88','conflict_format':'wunoo.release.global.checkpoint.federation.byzantine.conflict.v1','hash':'SHA-256','algorithm':'Ed25519','requires_same_witness':True,'requires_same_key':True,'requires_same_context':True,'requires_distinct_signed_payloads':True,'historical_key_validation':True,'exclude_from_quorum':True,'automatic_suspension':False,'fail_closed':True,'no_automatic_release':True}
def _v188_hash(v): return hashlib.sha256(json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()).hexdigest()
def _v188_json(v): return json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False)
def _v188_verify_signed_payload(c,wid,kid,payload,sig_b64,at_time=None):
    try:
        reg=_v176_registry_row(c,wid); hist=_v176_history(c,wid,kid)
        if not reg or not hist:return False,'WITNESS_KEY_UNKNOWN'
        if at_time:
            if str(hist['valid_from'])>str(at_time) or (hist['valid_until'] and str(hist['valid_until'])<str(at_time)):return False,'WITNESS_KEY_NOT_VALID_AT_CONTEXT'
        pb=hist['public_key_b64']; _,Ed25519PublicKey,_,_,_,_=_v169_crypto()
        Ed25519PublicKey.from_public_bytes(base64.b64decode(pb,validate=True)).verify(base64.b64decode(sig_b64,validate=True),_v188_json(payload).encode())
        return True,'SIGNATURE_VERIFIED'
    except Exception:return False,'SIGNATURE_INVALID'
def _v188_conflicts(c,fid=None):
    if fid:return c.execute('SELECT * FROM production_federation_byzantine_conflicts WHERE federation_id=? ORDER BY detected_at ASC,id ASC',(fid,)).fetchall()
    return c.execute('SELECT * FROM production_federation_byzantine_conflicts ORDER BY detected_at ASC,id ASC').fetchall()
def _v188_verify_conflict(c,row):
    try:
        a=json.loads(row['first_payload_json'] or '{}'); b=json.loads(row['second_payload_json'] or '{}')
        if row['witness_id']!=str(a.get('witness_id')) or row['witness_id']!=str(b.get('witness_id')):return {'valid':False,'reason':'CONFLICT_WITNESS_BINDING_INVALID'}
        if row['key_id']!=str(a.get('key_id')) or row['key_id']!=str(b.get('key_id')):return {'valid':False,'reason':'CONFLICT_KEY_BINDING_INVALID'}
        if str(a.get('context_type'))!=row['context_type'] or str(b.get('context_type'))!=row['context_type'] or str(a.get('context_id'))!=row['context_id'] or str(b.get('context_id'))!=row['context_id']:return {'valid':False,'reason':'CONFLICT_CONTEXT_BINDING_INVALID'}
        ah=_v188_hash(a);bh=_v188_hash(b)
        if ah!=row['first_sha256'] or bh!=row['second_sha256']:return {'valid':False,'reason':'CONFLICT_PAYLOAD_HASH_INVALID'}
        if ah==bh:return {'valid':False,'reason':'CONFLICT_NOT_DISTINCT'}
        va,ra=_v188_verify_signed_payload(c,row['witness_id'],row['key_id'],a,row['first_signature_b64']); vb,rb=_v188_verify_signed_payload(c,row['witness_id'],row['key_id'],b,row['second_signature_b64'])
        if not va:return {'valid':False,'reason':'FIRST_'+ra}
        if not vb:return {'valid':False,'reason':'SECOND_'+rb}
        expected=_v188_hash({'format':_V188_POLICY['conflict_format'],'schema_version':'1.88','federation_id':row['federation_id'],'epoch_id':row['epoch_id'],'witness_id':row['witness_id'],'key_id':row['key_id'],'context_type':row['context_type'],'context_id':row['context_id'],'first_sha256':ah,'second_sha256':bh})
        if expected!=row['conflict_sha256']:return {'valid':False,'reason':'CONFLICT_HASH_INVALID'}
        return {'valid':True,'reason':'BYZANTINE_CONFLICT_VERIFIED'}
    except Exception:return {'valid':False,'reason':'CONFLICT_INVALID'}
def _v188_verify_all(c,fid=None):
    rows=_v188_conflicts(c,fid); checked=0
    for r in rows:
        vr=_v188_verify_conflict(c,r);checked+=1
        if not vr['valid']:return {'valid':False,'reason':vr['reason'],'checked':checked}
    return {'valid':True,'reason':'BYZANTINE_CONFLICTS_VERIFIED','count':len(rows),'checked':checked}

@app.get('/api/v188/ops/federation-byzantine/policy')
def v188_policy(authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'});return _V188_POLICY

@app.post('/api/v188/ops/federation-byzantine/report')
def v188_report(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin'});p=payload or {};operator=str(u.get('email') or u.get('id') or 'operator')
    with core_db_connect() as c:
        fid=str(p.get('federation_id') or '');wid=str(p.get('witness_id') or '');kid=str(p.get('key_id') or '')
        context_type=str(p.get('context_type') or '');context_id=str(p.get('context_id') or '')
        a=p.get('first_payload') or {};b=p.get('second_payload') or {};sa=str(p.get('first_signature_b64') or '');sb=str(p.get('second_signature_b64') or '')
        if not all([fid,wid,kid,context_type,context_id,sa,sb]):raise HTTPException(400,'CONFLICT_FIELDS_REQUIRED')
        fed=_v170_row(c,'production_global_checkpoint_federations',' WHERE id=?',(fid,),'created_at DESC')
        if not fed:raise HTTPException(404,'FEDERATION_NOT_FOUND')
        if wid not in json.loads(fed['member_witness_ids_json'] or '[]'):raise HTTPException(409,'WITNESS_NOT_FEDERATION_MEMBER')
        if str(a.get('witness_id'))!=wid or str(b.get('witness_id'))!=wid or str(a.get('key_id'))!=kid or str(b.get('key_id'))!=kid:raise HTTPException(409,'CONFLICT_IDENTITY_MISMATCH')
        if str(a.get('context_type'))!=context_type or str(b.get('context_type'))!=context_type or str(a.get('context_id'))!=context_id or str(b.get('context_id'))!=context_id:raise HTTPException(409,'CONFLICT_CONTEXT_MISMATCH')
        ah=_v188_hash(a);bh=_v188_hash(b)
        if ah==bh:raise HTTPException(409,'CONFLICT_PAYLOADS_IDENTICAL')
        ok,reason=_v188_verify_signed_payload(c,wid,kid,a,sa);
        if not ok:raise HTTPException(409,'FIRST_'+reason)
        ok,reason=_v188_verify_signed_payload(c,wid,kid,b,sb);
        if not ok:raise HTTPException(409,'SECOND_'+reason)
        ch=_v188_hash({'format':_V188_POLICY['conflict_format'],'schema_version':'1.88','federation_id':fid,'epoch_id':p.get('epoch_id'),'witness_id':wid,'key_id':kid,'context_type':context_type,'context_id':context_id,'first_sha256':ah,'second_sha256':bh})
        ex=c.execute('SELECT * FROM production_federation_byzantine_conflicts WHERE conflict_sha256=?',(ch,)).fetchone()
        if ex:return {'schema_version':'1.88','idempotent':True,'conflict':dict(ex),'verification':_v188_verify_conflict(c,ex)}
        cid='bzc_'+uuid.uuid4().hex[:16];t=now();c.execute('INSERT INTO production_federation_byzantine_conflicts(id,federation_id,epoch_id,witness_id,key_id,context_type,context_id,first_payload_json,first_signature_b64,first_sha256,second_payload_json,second_signature_b64,second_sha256,conflict_sha256,status,recommended_action,detected_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(cid,fid,p.get('epoch_id'),wid,kid,context_type,context_id,_v188_json(a),sa,ah,_v188_json(b),sb,bh,ch,'CONFIRMED','SUSPEND_WITNESS',t,operator));c.commit();r=c.execute('SELECT * FROM production_federation_byzantine_conflicts WHERE id=?',(cid,)).fetchone();return {'schema_version':'1.88','idempotent':False,'conflict':dict(r),'verification':_v188_verify_conflict(c,r)}

@app.post('/api/v188/ops/federation-byzantine/evaluate')
def v188_evaluate(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'});p=payload or {}
    with core_db_connect() as c:
        fid=str(p.get('federation_id') or '');fed=_v170_row(c,'production_global_checkpoint_federations',' WHERE id=?',(fid,),'created_at DESC')
        if not fed:raise HTTPException(404,'FEDERATION_NOT_FOUND')
        members=json.loads(fed['member_witness_ids_json'] or '[]');conflicts=_v188_conflicts(c,fid);excluded=sorted(set(r['witness_id'] for r in conflicts if _v188_verify_conflict(c,r)['valid']));eligible=[]
        for wid in members:
            trust=_v177_evaluate(c,wid)
            eligible.append({'witness_id':wid,'trusted':bool(trust['valid']),'byzantine_conflict':wid in excluded,'eligible_for_quorum':bool(trust['valid']) and wid not in excluded})
        available=sum(1 for x in eligible if x['eligible_for_quorum']);q=int(fed['quorum_required'])
        return {'schema_version':'1.88','federation_id':fid,'quorum_required':q,'eligible_count':available,'quorum_restored':available>=q,'excluded_witness_ids':excluded,'members':eligible,'conflict_verification':_v188_verify_all(c,fid)}

@app.get('/api/v188/ops/federation-byzantine/verify')
def v188_verify(authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        return {'schema_version':'1.88',**_v188_verify_all(c)}


# ---------------- WUNOO v1.89: Dynamic Quorum & Trust Rebalancing ----------------
def migrate_v189(c):
    c.executescript("""CREATE TABLE IF NOT EXISTS production_federation_quorum_assessments(
        id TEXT PRIMARY KEY, federation_id TEXT NOT NULL, epoch_id TEXT, assessment_no INTEGER NOT NULL,
        member_count INTEGER NOT NULL, trusted_count INTEGER NOT NULL, excluded_byzantine_count INTEGER NOT NULL,
        unavailable_count INTEGER NOT NULL, current_quorum INTEGER NOT NULL, recommended_quorum INTEGER,
        safety_state TEXT NOT NULL, eligible_witness_ids_json TEXT NOT NULL, excluded_witness_ids_json TEXT NOT NULL,
        assessment_json TEXT NOT NULL, assessment_sha256 TEXT NOT NULL UNIQUE, created_at TEXT NOT NULL, operator TEXT
    );
    CREATE INDEX IF NOT EXISTS idx_v189_assessment_fed ON production_federation_quorum_assessments(federation_id,assessment_no);
    CREATE TABLE IF NOT EXISTS production_federation_quorum_rebalance_proposals(
        id TEXT PRIMARY KEY, federation_id TEXT NOT NULL, epoch_id TEXT, from_quorum INTEGER NOT NULL,
        to_quorum INTEGER NOT NULL, reason TEXT NOT NULL, eligible_witness_ids_json TEXT NOT NULL,
        excluded_witness_ids_json TEXT NOT NULL, required_approvals INTEGER NOT NULL, status TEXT NOT NULL,
        proposal_json TEXT NOT NULL, proposal_sha256 TEXT NOT NULL UNIQUE, created_at TEXT NOT NULL,
        finalized_at TEXT, operator TEXT
    );
    CREATE INDEX IF NOT EXISTS idx_v189_proposals_fed ON production_federation_quorum_rebalance_proposals(federation_id,created_at);
    CREATE TABLE IF NOT EXISTS production_federation_quorum_rebalance_approvals(
        id TEXT PRIMARY KEY, proposal_id TEXT NOT NULL, federation_id TEXT NOT NULL, witness_id TEXT NOT NULL,
        key_id TEXT NOT NULL, public_key_b64 TEXT NOT NULL, signature_b64 TEXT NOT NULL,
        approval_json TEXT NOT NULL, approval_sha256 TEXT NOT NULL UNIQUE, status TEXT NOT NULL,
        created_at TEXT NOT NULL, operator TEXT, UNIQUE(proposal_id,witness_id)
    );
    CREATE INDEX IF NOT EXISTS idx_v189_approvals_proposal ON production_federation_quorum_rebalance_approvals(proposal_id,created_at);
    """)

_V189_POLICY={
    'schema_version':'1.89',
    'assessment_format':'wunoo.release.global.checkpoint.federation.quorum.assessment.v1',
    'proposal_format':'wunoo.release.global.checkpoint.federation.quorum.rebalance.proposal.v1',
    'approval_format':'wunoo.release.global.checkpoint.federation.quorum.rebalance.approval.v1',
    'hash':'SHA-256','algorithm':'Ed25519','bft_threshold':'2f+1',
    'minimum_quorum_rule':'floor(2N/3)+1',
    'exclude_confirmed_byzantine':True,'exclude_unavailable':True,
    'historical_federation_immutable':True,'automatic_quorum_mutation':False,
    'fail_closed':True,'no_automatic_release':True
}
def _v189_hash(v): return hashlib.sha256(json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()).hexdigest()
def _v189_json(v): return json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False)
def _v189_min_quorum(n): return (2*n)//3+1 if n else 0
def _v189_latest_failure(c,fid,wid):
    rows=c.execute('SELECT event_type FROM production_federation_recovery_events WHERE federation_id=? AND subject_witness_id=? ORDER BY created_at DESC,id DESC',(fid,wid)).fetchall()
    if not rows:return None
    return str(rows[0]['event_type'])
def _v189_assess(c,fid,epoch_id=None):
    fed=_v170_row(c,'production_global_checkpoint_federations',' WHERE id=?',(fid,),'created_at DESC')
    if not fed: raise HTTPException(404,'FEDERATION_NOT_FOUND')
    fv=_v184_verify_federation(c,fed)
    if not fv['valid']: raise HTTPException(409,'FEDERATION_INVALID')
    members=sorted(set(json.loads(fed['member_witness_ids_json'] or '[]')))
    conflicts=_v188_conflicts(c,fid)
    byz=sorted(set(r['witness_id'] for r in conflicts if _v188_verify_conflict(c,r)['valid']))
    eligible=[];excluded=[];trusted_count=0;unavailable=[];details=[]
    for wid in members:
        trust=_v177_evaluate(c,wid)
        trusted=bool(trust['valid'])
        if trusted: trusted_count+=1
        latest=_v189_latest_failure(c,fid,wid)
        unavailable_flag=latest in {'WITNESS_SUSPENDED','WITNESS_REVOKED','WITNESS_UNAVAILABLE'}
        if unavailable_flag: unavailable.append(wid)
        ok=trusted and wid not in byz and not unavailable_flag
        if ok: eligible.append(wid)
        else: excluded.append(wid)
        details.append({'witness_id':wid,'trusted':trusted,'byzantine_conflict':wid in byz,'latest_recovery_event':latest,'unavailable':unavailable_flag,'eligible_for_quorum':ok})
    n=len(members);q=int(fed['quorum_required']);minimum=_v189_min_quorum(n);eligible_count=len(eligible)
    safe=eligible_count>=q and q>=minimum
    state='SAFE' if safe and not excluded else ('DEGRADED' if eligible_count>=q and q>=minimum else 'UNSAFE')
    recommended=q if safe else (minimum if eligible_count>=minimum else None)
    if eligible_count>=minimum and q>minimum: recommended=minimum
    chain=_v187_chain(c,fid); conflict_verification=_v188_verify_all(c,fid)
    if not chain['valid']: raise HTTPException(409,chain['reason'])
    if not conflict_verification['valid']: raise HTTPException(409,conflict_verification['reason'])
    payload={'format':_V189_POLICY['assessment_format'],'schema_version':'1.89','federation_id':fid,'federation_sha256':fed['federation_sha256'],'epoch_id':epoch_id,'member_count':n,'trusted_count':trusted_count,'excluded_byzantine_count':len(byz),'unavailable_count':len(unavailable),'current_quorum':q,'minimum_quorum':minimum,'recommended_quorum':recommended,'safety_state':state,'eligible_witness_ids':eligible,'excluded_witness_ids':excluded,'recovery_head_sha256':chain['head_sha256'],'byzantine_conflict_count':len(conflicts)}
    return fed,payload,details

def _v189_verify_assessment(c,row):
    try:
        obj=json.loads(row['assessment_json'] or '{}');stored=dict(obj);stored.pop('assessment_no',None);expected=_v189_hash(stored)
        if expected!=row['assessment_sha256']:return {'valid':False,'reason':'ASSESSMENT_HASH_INVALID'}
        if str(obj.get('federation_id'))!=str(row['federation_id']):return {'valid':False,'reason':'ASSESSMENT_FEDERATION_BINDING_INVALID'}
        _,current,_details=_v189_assess(c,row['federation_id'],row['epoch_id'])
        if _v189_hash({k:v for k,v in obj.items() if k!='assessment_no'})!=row['assessment_sha256']:return {'valid':False,'reason':'ASSESSMENT_RECOMPUTE_INVALID'}
        if obj.get('federation_sha256')!=current['federation_sha256']:return {'valid':False,'reason':'ASSESSMENT_FEDERATION_CHANGED'}
        return {'valid':True,'reason':'QUORUM_ASSESSMENT_VERIFIED'}
    except HTTPException as e:return {'valid':False,'reason':str(e.detail)}
    except Exception:return {'valid':False,'reason':'ASSESSMENT_INVALID'}
def _v189_approval_payload(proposal,wid,kid):
    return {'format':_V189_POLICY['approval_format'],'schema_version':'1.89','proposal_id':proposal['id'],'federation_id':proposal['federation_id'],'proposal_sha256':proposal['proposal_sha256'],'approver_witness_id':wid,'approver_key_id':kid,'to_quorum':int(proposal['to_quorum'])}
def _v189_verify_approval(c,row):
    try:
        p=c.execute('SELECT * FROM production_federation_quorum_rebalance_proposals WHERE id=?',(row['proposal_id'],)).fetchone()
        if not p:return {'valid':False,'reason':'PROPOSAL_NOT_FOUND'}
        obj=json.loads(row['approval_json'] or '{}')
        if _v189_hash(obj)!=row['approval_sha256']:return {'valid':False,'reason':'APPROVAL_HASH_INVALID'}
        if obj!=_v189_approval_payload(p,row['witness_id'],row['key_id']):return {'valid':False,'reason':'APPROVAL_PAYLOAD_INVALID'}
        ok,reason=_v188_verify_signed_payload(c,row['witness_id'],row['key_id'],obj,row['signature_b64'])
        if not ok:return {'valid':False,'reason':'APPROVAL_'+reason}
        return {'valid':True,'reason':'QUORUM_APPROVAL_VERIFIED'}
    except Exception:return {'valid':False,'reason':'APPROVAL_INVALID'}

# ---------------- WUNOO v1.87: Federation Failure & Recovery Protocol ----------------
def migrate_v187(c):
    c.executescript("""CREATE TABLE IF NOT EXISTS production_federation_recovery_events(
        id TEXT PRIMARY KEY, federation_id TEXT NOT NULL, epoch_id TEXT, event_type TEXT NOT NULL,
        subject_witness_id TEXT, subject_key_id TEXT, reason TEXT NOT NULL, evidence_json TEXT NOT NULL,
        evidence_sha256 TEXT NOT NULL UNIQUE, previous_event_sha256 TEXT NOT NULL, event_sha256 TEXT NOT NULL UNIQUE,
        status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT
    );
    CREATE TABLE IF NOT EXISTS production_federation_recovery_decisions(
        id TEXT PRIMARY KEY, federation_id TEXT NOT NULL, epoch_id TEXT, decision_type TEXT NOT NULL,
        target_witness_id TEXT, target_key_id TEXT, required_quorum INTEGER NOT NULL,
        approving_witness_ids_json TEXT NOT NULL, event_hashes_json TEXT NOT NULL, decision_json TEXT NOT NULL,
        decision_sha256 TEXT NOT NULL UNIQUE, algorithm TEXT NOT NULL, signer_key_id TEXT NOT NULL,
        public_key_b64 TEXT NOT NULL, signature_b64 TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL, operator TEXT
    );
    CREATE INDEX IF NOT EXISTS idx_federation_recovery_events_fed ON production_federation_recovery_events(federation_id,created_at);
    CREATE INDEX IF NOT EXISTS idx_federation_recovery_decisions_fed ON production_federation_recovery_decisions(federation_id,created_at);""")

_V187_POLICY={'schema_version':'1.87','event_format':'wunoo.release.global.checkpoint.federation.recovery.event.v1','decision_format':'wunoo.release.global.checkpoint.federation.recovery.decision.v1','hash':'SHA-256','algorithm':'Ed25519','failure_events':['WITNESS_SUSPENDED','WITNESS_REVOKED','WITNESS_UNAVAILABLE','KEY_ROTATED'],'recovery_events':['WITNESS_REINSTATED','WITNESS_REPLACED','QUORUM_RESTORED'],'distinct_approvers_required':True,'quorum_from_federation':True,'historical_finality_preserved':True,'append_only_events':True,'fail_closed':True,'no_automatic_release':True}
def _v187_hash(v): return hashlib.sha256(json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()).hexdigest()
def _v187_json(v): return json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False)
def _v187_zero(): return '0'*64
def _v187_events(c,fid): return c.execute('SELECT * FROM production_federation_recovery_events WHERE federation_id=? ORDER BY created_at ASC,id ASC',(fid,)).fetchall()
def _v187_chain(c,fid):
    rows=_v187_events(c,fid); prev=_v187_zero()
    for i,r in enumerate(rows,1):
        if r['previous_event_sha256']!=prev:return {'valid':False,'reason':'RECOVERY_EVENT_PREDECESSOR_INVALID','checked':i-1}
        try: obj=json.loads(r['evidence_json'] or '{}')
        except Exception:return {'valid':False,'reason':'RECOVERY_EVENT_EVIDENCE_INVALID','checked':i-1}
        if _v187_hash({'federation_id':r['federation_id'],'epoch_id':r['epoch_id'],'event_type':r['event_type'],'subject_witness_id':r['subject_witness_id'],'subject_key_id':r['subject_key_id'],'reason':r['reason'],'evidence':obj})!=r['evidence_sha256']:return {'valid':False,'reason':'RECOVERY_EVENT_EVIDENCE_HASH_INVALID','checked':i-1}
        expected=_v187_hash({'format':_V187_POLICY['event_format'],'schema_version':'1.87','federation_id':r['federation_id'],'epoch_id':r['epoch_id'],'event_type':r['event_type'],'subject_witness_id':r['subject_witness_id'],'subject_key_id':r['subject_key_id'],'reason':r['reason'],'evidence_sha256':r['evidence_sha256'],'previous_event_sha256':r['previous_event_sha256']})
        if expected!=r['event_sha256']:return {'valid':False,'reason':'RECOVERY_EVENT_HASH_INVALID','checked':i-1}
        prev=r['event_sha256']
    return {'valid':True,'reason':'RECOVERY_EVENT_CHAIN_VERIFIED','count':len(rows),'head_sha256':prev}
def _v187_append_event(c,fed,eid,typ,wid,kid,reason,evidence,operator):
    chain=_v187_chain(c,fed['id'])
    if not chain['valid']: raise HTTPException(409,chain['reason'])
    prev=chain['head_sha256']; evh=_v187_hash({'federation_id':fed['id'],'epoch_id':eid,'event_type':typ,'subject_witness_id':wid,'subject_key_id':kid,'reason':reason,'evidence':evidence})
    eh=_v187_hash({'format':_V187_POLICY['event_format'],'schema_version':'1.87','federation_id':fed['id'],'epoch_id':eid,'event_type':typ,'subject_witness_id':wid,'subject_key_id':kid,'reason':reason,'evidence_sha256':evh,'previous_event_sha256':prev})
    existing=c.execute('SELECT * FROM production_federation_recovery_events WHERE federation_id=? AND COALESCE(epoch_id,"")=COALESCE(?,"") AND event_type=? AND COALESCE(subject_witness_id,"")=COALESCE(?,"") AND COALESCE(subject_key_id,"")=COALESCE(?,"") AND reason=? AND evidence_sha256=?',(fed['id'],eid,typ,wid,kid,reason,evh)).fetchone()
    if existing:return existing,True
    rid='fre_'+uuid.uuid4().hex[:16];t=now();c.execute('INSERT INTO production_federation_recovery_events(id,federation_id,epoch_id,event_type,subject_witness_id,subject_key_id,reason,evidence_json,evidence_sha256,previous_event_sha256,event_sha256,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(rid,fed['id'],eid,typ,wid,kid,reason,_v187_json(evidence),evh,prev,eh,'RECORDED',t,operator));return c.execute('SELECT * FROM production_federation_recovery_events WHERE id=?',(rid,)).fetchone(),False

@app.get('/api/v187/ops/federation-recovery/policy')
def v187_policy(authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'});return _V187_POLICY
@app.post('/api/v187/ops/federation-recovery/event')
def v187_event(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin'});p=payload or {};operator=str(u.get('email') or u.get('id') or 'operator')
    with core_db_connect() as c:
        fed=_v170_row(c,'production_global_checkpoint_federations',' WHERE id=?',(p.get('federation_id'),),'created_at DESC')
        if not fed:raise HTTPException(404,'FEDERATION_NOT_FOUND')
        if not _v184_verify_federation(c,fed)['valid']:raise HTTPException(409,'FEDERATION_INVALID')
        typ=str(p.get('event_type') or '')
        if typ not in _V187_POLICY['failure_events']+_V187_POLICY['recovery_events']:raise HTTPException(400,'EVENT_TYPE_INVALID')
        eid=p.get('epoch_id'); epoch=_v186_epoch(c,eid) if eid else None
        if eid and not epoch:raise HTTPException(404,'EPOCH_NOT_FOUND')
        row,idem=_v187_append_event(c,fed,eid,typ,p.get('witness_id'),p.get('key_id'),str(p.get('reason') or ''),p.get('evidence') or {},operator);c.commit()
        return {'schema_version':'1.87','idempotent':idem,'event':dict(row),'verification':_v187_chain(c,fed['id'])}
@app.get('/api/v187/ops/federation-recovery/verify')
def v187_verify(authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin','ops_agent'})
    with core_db_connect() as c:
        feds=c.execute('SELECT id FROM production_global_checkpoint_federations ORDER BY created_at ASC').fetchall(); out=[{'federation_id':f['id'],**_v187_chain(c,f['id'])} for f in feds];bad=next((x for x in out if not x['valid']),None)
        return {'schema_version':'1.87','valid':bad is None,'reason':'RECOVERY_CHAINS_VERIFIED' if bad is None else bad['reason'],'federations':out}
@app.post('/api/v187/ops/federation-recovery/decision')
def v187_decision(payload: dict[str,Any]|None=None,authorization: str|None=Header(default=None)):
    u=current_user(authorization);require_role(u,{'admin'});p=payload or {};operator=str(u.get('email') or u.get('id') or 'operator')
    with core_db_connect() as c:
        fed=_v170_row(c,'production_global_checkpoint_federations',' WHERE id=?',(p.get('federation_id'),),'created_at DESC')
        if not fed:raise HTTPException(404,'FEDERATION_NOT_FOUND')
        if not _v184_verify_federation(c,fed)['valid']:raise HTTPException(409,'FEDERATION_INVALID')
        chain=_v187_chain(c,fed['id'])
        if not chain['valid']:raise HTTPException(409,chain['reason'])
        approvers=sorted(set(str(x) for x in (p.get('approving_witness_ids') or [])));q=int(fed['quorum_required'])
        if len(approvers)<q:raise HTTPException(409,'RECOVERY_QUORUM_NOT_REACHED')
        members=json.loads(fed['member_witness_ids_json'] or '[]')
        for wid in approvers:
            if wid not in members:raise HTTPException(409,'APPROVER_NOT_FEDERATION_MEMBER')
            rr=c.execute('SELECT * FROM production_external_witness_registry WHERE witness_id=?',(wid,)).fetchone()
            if not rr or rr['status']!='ACTIVE':raise HTTPException(409,'APPROVER_NOT_ACTIVE')
            if not _v177_evaluate(c,wid)['valid']:raise HTTPException(409,'APPROVER_NOT_TRUSTED')
        dtype=str(p.get('decision_type') or '')
        if dtype not in ['WITNESS_REINSTATEMENT','WITNESS_REPLACEMENT','QUORUM_RESTORATION']:raise HTTPException(400,'DECISION_TYPE_INVALID')
        obj={'format':_V187_POLICY['decision_format'],'schema_version':'1.87','federation_id':fed['id'],'federation_sha256':fed['federation_sha256'],'decision_type':dtype,'target_witness_id':p.get('target_witness_id'),'target_key_id':p.get('target_key_id'),'required_quorum':q,'approving_witness_ids':approvers,'event_head_sha256':chain['head_sha256']}
        digest=_v187_hash(obj);existing=c.execute('SELECT * FROM production_federation_recovery_decisions WHERE decision_sha256=?',(digest,)).fetchone()
        if existing:return {'schema_version':'1.87','idempotent':True,'decision':dict(existing)}
        signer,pub,keyid=_v169_load_signer();sig=base64.b64encode(signer.sign(_v187_json(obj).encode())).decode();did='frd_'+uuid.uuid4().hex[:16];t=now();c.execute('INSERT INTO production_federation_recovery_decisions(id,federation_id,epoch_id,decision_type,target_witness_id,target_key_id,required_quorum,approving_witness_ids_json,event_hashes_json,decision_json,decision_sha256,algorithm,signer_key_id,public_key_b64,signature_b64,status,created_at,operator) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(did,fed['id'],p.get('epoch_id'),dtype,p.get('target_witness_id'),p.get('target_key_id'),q,_v187_json(approvers),_v187_json(p.get('event_hashes') or []),_v187_json(obj),digest,'Ed25519',keyid,base64.b64encode(pub).decode(),sig,'FINAL',t,operator));c.commit();r=c.execute('SELECT * FROM production_federation_recovery_decisions WHERE id=?',(did,)).fetchone();return {'schema_version':'1.87','idempotent':False,'decision':dict(r)}

