    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); payload=payload or {}
    with core_db_connect() as c: snap=_v166_collect(c,payload.get('revalidation_run_id'),payload.get('rollout_run_id'),payload.get('release_version'))
    ev=_v166_eval(snap); return {'schema_version':'1.66','snapshot':snap,'evaluation':ev}

@app.post('/api/v166/ops/safety-promotion/start')
def v166_start(payload: dict[str,Any]|None=None, authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); payload=payload or {}; operator=str(u.get('email') or u.get('id') or 'operator')
    with core_db_connect() as c: snap=_v166_collect(c,payload.get('revalidation_run_id'),payload.get('rollout_run_id'),payload.get('release_version'))
    ev=_v166_eval(snap)
    if not ev['promotion_allowed']: raise HTTPException(409,ev['reason'])
    rid='pspromo_'+uuid.uuid4().hex[:16]; body={'snapshot':snap,'evaluation':ev,'phase':'PRECHECK'}; digest=_v166_hash(body)
    with core_db_connect() as c:
        c.execute('INSERT INTO production_safety_promotion_runs(id,revalidation_run_id,release_version,rollout_run_id,phase,decision,promotion_percent,gate_snapshot_json,evidence_sha256,operator,created_at,updated_at) VALUES(?,?,?,?,?,?,?,?,?,?,?,?)',
                  (rid,snap.get('revalidation_run_id'),snap.get('release_version'),snap.get('rollout_run_id'),'PRECHECK','GO',0,json.dumps(snap,sort_keys=True),digest,operator,now(),now())); c.commit()
    return {'schema_version':'1.66','promotion_run_id':rid,'phase':'PRECHECK','decision':'GO','evidence_sha256':digest}

@app.post('/api/v166/ops/safety-promotion/{run_id}/advance')
def v166_advance(run_id: str, payload: dict[str,Any]|None=None, authorization: str|None=Header(default=None)):
    u=current_user(authorization); require_role(u,{'admin','ops_agent'}); payload=payload or {}; operator=str(u.get('email') or u.get('id') or 'operator')
    phases={'PRECHECK':('CANARY_PROMOTION',10.0),'CANARY_PROMOTION':('FULL_PROMOTION',100.0),'FULL_PROMOTION':('COMPLETE',100.0)}
    with core_db_connect() as c:
        row=c.execute('SELECT * FROM production_safety_promotion_runs WHERE id=?',(run_id,)).fetchone()
        if not row: raise HTTPException(404,'promotion run nenalezen')
        nxt=phases.get(row['phase'])
        if not nxt: raise HTTPException(409,'promotion workflow is not advanceable')
        snap=_v166_collect(c,row['revalidation_run_id'],row['rollout_run_id'],row['release_version']); ev=_v166_eval(snap)
        if not ev['promotion_allowed']: raise HTTPException(409,ev['reason'])
        confirmed=bool(payload.get('operator_confirmed',False))
        if not confirmed: raise HTTPException(409,'operator confirmation required')
        next_phase,pct=nxt; decision='GO' if next_phase!='COMPLETE' else 'GO'
        digest=_v166_hash({'run_id':run_id,'phase':next_phase,'decision':decision,'promotion_percent':pct,'snapshot':snap,'operator_confirmed':confirmed})
        c.execute('UPDATE production_safety_promotion_runs SET phase=?,decision=?,promotion_percent=?,gate_snapshot_json=?,evidence_sha256=?,operator=?,updated_at=? WHERE id=?',(next_phase,decision,pct,json.dumps(snap,sort_keys=True),digest,operator,now(),run_id)); c.commit()
    return {'schema_version':'1.66','promotion_run_id':run_id,'phase':next_phase,'decision':decision,'promotion_percent':pct,'evidence_sha256':digest}

